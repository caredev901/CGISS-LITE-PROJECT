                PCTLOSS = rs.fields("PCTLOSS")
                rs.Edit()

                If FLDID <> "" And VALUEID <> "" Then
                    TAmount = toval(rs.fields("TAmount"))

                    ' Compulsory
                    Amount = toval(rs.fields("CAMOUNT")) - toval(rs.fields("CCAMOUNT"))
                    If toval(rs.fields("CRegNo")) > 0 Then
                        RegNo = toval(GetAccRegAmount(REGID, FLDID, VALUEID, RYear, "C", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = 0 Then GoTo errmsg
                        rs.fields("CRegNo") = RegNo
                    End If

                    ' Excess Priority
                    Amount = toval(rs.fields("XPAMOUNT")) - toval(rs.fields("CXPAMOUNT"))
                    If toval(rs.fields("XPRegNo")) > 0 Then
                        RegNo = toval(GetAccRegAmount(REGID, FLDID, VALUEID, RYear, "XP", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = 0 Then GoTo errmsg
                        rs.fields("XPRegNo") = RegNo
                    End If

                    ' Decree
                    Amount = toval(rs.fields("DAMOUNT")) - toval(rs.fields("CDAMOUNT"))
                    If toval(rs.fields("DRegNo")) > 0 Then
                        RegNo = toval(GetAccRegAmount(REGID, FLDID, VALUEID, RYear, "D", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = 0 Then GoTo errmsg
                        rs.fields("DRegNo") = RegNo
                    End If

                    ' Quota Share
                    Amount = toval(rs.fields("QAMOUNT")) + toval(rs.fields("QSRAMOUNT")) - toval(rs.fields("CQSRAMOUNT"))
                    If toval(rs.fields("QRegNo")) > 0 Then
                        RegNo = toval(GetAccRegAmount(REGID, FLDID, VALUEID, RYear, "Q", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = 0 Then GoTo errmsg
                        rs.fields("QRegNo") = RegNo
                    End If

                    ' 1st Surplus
                    Amount = toval(rs.fields("SP1AMOUNT")) - toval(rs.fields("CSP1AMOUNT"))
                    If toval(rs.fields("SP1RegNo")) > 0 Then
                        RegNo = toval(GetAccRegAmount(REGID, FLDID, VALUEID, RYear, "S1", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = 0 Then GoTo errmsg
                        rs.fields("SP1RegNo") = RegNo
                    End If

                    ' 2nd Surplus
                    Amount = toval(rs.fields("SP2AMOUNT")) - toval(rs.fields("CSP2AMOUNT"))
                    If toval(rs.fields("SP2RegNo")) > 0 Then
                        RegNo = toval(GetAccRegAmount(REGID, FLDID, VALUEID, RYear, "S2", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = 0 Then GoTo errmsg
                        rs.fields("SP2RegNo") = RegNo
                    End If

                    ' 3rd Surplus
                    Amount = toval(rs.fields("SP3AMOUNT")) - toval(rs.fields("CSP3AMOUNT"))
                    If toval(rs.fields("SP3RegNo")) > 0 Then
                        RegNo = toval(GetAccRegAmount(REGID, FLDID, VALUEID, RYear, "S3", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = 0 Then GoTo errmsg
                        rs.fields("SP3RegNo") = RegNo
                    End If

                    ' Auto Facultative
                    Amount = toval(rs.fields("AAMOUNT")) + toval(rs.fields("AFRAMOUNT")) - toval(rs.fields("CAAMOUNT"))
                    If toval(rs.fields("ARegNo")) > 0 Then
                        RegNo = toval(GetAccRegAmount(REGID, FLDID, VALUEID, RYear, "A", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = 0 Then GoTo errmsg
                        rs.fields("ARegNo") = RegNo
                    End If
                End If
                rs.fields("Status") = "R"
                If Not rs.Update Then GoTo errmsg
                rs.CloseRemoteSet()

                ' Also Update Cover Limit
                'Set rs = db.OpenRemoteSet("select Cover.*, PCalc.Rate from Cover, Acceptance, PCALC where Cover.CNO=Acceptance.CNO and PCALC.ANO=Acceptance.ANO and Acceptance.ANO=" & ANO)
                'If Not rs.EOF Then
                '   TAmount = TAmount / toval(rs.fields("Rate"))
                'End If
            End If
        End If

        UnReleaseAccRegAmount = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UnReleaseAccRegAmount = False
    End Function
    Private Function Confirmed_Facultative(ByVal ANO As Long, ByVal FID As String) As Boolean
        Try

            Dim rs As RemoteSet
            Dim LANO As Long
            Dim SDate As Date
            Dim EDate As Date

            Dim FullCoverF As Boolean
            Dim Share As Double
            Dim Amount As Double
            Dim OurShare As Double
            Dim rsArr As RemoteSet
            Dim rsFac As RemoteSet
            Dim ErrMsg As String = ""

            rs = db.OpenRemoteSet("Select LANO, AStatus, SDate, EDate from Acceptance Where ANO=" & ANO)
            If rs.fields("AStatus") <> "W" Then
                ErrMsg = "Please Check Policy Data Status !"
                Throw New Exception(Errmsg)
            End If

            LANO = toval(rs.fields("LANO"))
            SDate = todate(rs.fields("SDate"))
            EDate = todate(rs.fields("EDate"))

            Dim SQL As String
            SQL = "Select FPart.ANO, FPart.FID, cast(coalesce(Max(Cast(LOB.SecuritiesF as Int)),0) as Bit) as SecuritiesF, coalesce(sum(FSecurity.Share),100) as TShare,sum(Case When coalesce(FSecurity.ANO,0)<>0 Then 1 else 0 end) as NumSecurities"
            SQL = SQL & " from FPart Left Join Profile on (Profile.ID=FPart.ID) Left Join LOB on (LOB.LOB=Profile.LOB) Left Join FSecurity on (FSecurity.ANO=FPart.ANO and FSecurity.FID=FPart.FID)"
            SQL = SQL & " Where FPart.ANO=" & ANO & " and FPart.FID='" & FID & "'"
            SQL = SQL & " Group By FPart.ANO, FPart.FID"
            rs = db.OpenRemoteSet(SQL)

            If toval(rs.fields("SecuritiesF")) AndAlso toval(rs.fields("NumSecurities")) = 0 Then
                ErrMsg = "Please Check Facultative Security !"
                Throw New Exception(ErrMsg)
            ElseIf toval(rs.fields("TShare")) <> 100 Then
                ErrMsg = "Please Check Total Security's Share (Should be 100%) !"
                Throw New Exception(ErrMsg)
            End If

            If ANO <> LANO Then
                rsArr = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
                If rsArr.Eof Then
                    ErrMsg = "Please Check Risk Arrangement Data !"
                    Throw New Exception(ErrMsg)
                End If
                OurShare = toval(rsArr.fields("TAmount"))
            Else
                OurShare = 0
            End If

            rsFac = db.OpenRemoteSet("Select * From RArrDet Where ANO=" & ANO & " and FID='" & FID & "'")
            If rsFac.Eof Then
                ErrMsg = "No Facultative Data !"
                Throw New Exception(ErrMsg)
            End If
            If rsFac.fields("Status") <> "O" And rsFac.fields("AType") <> "C" Then
                ErrMsg = "Facultative Already Processed !"
                Throw New Exception(ErrMsg)
            End If
            If DateDiff(DateInterval.Day, rsFac.fields("SDate"), SDate) > 0 Or DateDiff(DateInterval.Day, rsFac.fields("EDate"), EDate) < 0 Then
                ErrMsg = "Facultative Period Must Within Insurance Period !"
                Throw New Exception(ErrMsg)
            End If

            Dim CurrencyL As String
            Dim RateL As Double
            CurrencyL = rsFac.fields("CurrencyL")

            rs = db.OpenRemoteSet("Select SysTab.Currency, PCalc.Rate from SysTab Left join PCalc on (PCalc.ANO=" & ANO & " and PCalc.Currency='" & CurrencyL & "')")
            If CurrencyL = "" Then CurrencyL = rs.fields("Currency")
            RateL = toval(rs.fields("Rate"))
            If RateL = 0 Then RateL = 1

            Share = toval(rsFac.fields("Share")) - toval(rsFac.fields("JPShare"))
            FullCoverF = rsFac.fields("FullCoverF")
            If toval(rsFac.fields("Limit")) <> 0 Then
                Amount = Share / 100 * toval(rsFac.fields("Limit"))
            ElseIf OurShare <> 0 Then
                Amount = Share / 100 * (OurShare / RateL)
            Else
                Amount = toval(rsFac.fields("Amount"))
            End If
            rsFac.Edit()
            rsFac.fields("Status") = "R"
            rsFac.fields("CurrencyL") = CurrencyL
            rsFac.fields("RateL") = RateL
            rsFac.fields("Amount") = Amount
            rsFac.fields("AUserID") = db_user
            rsFac.fields("AUserDate") = Today.Date
            If Not rsFac.Update Then Throw New Exception(db.ErrDesc)

            Dim FShare As Double
            If toval(rsFac.fields("Limit")) <> 0 And OurShare <> 0 Then
                FShare = (toval(rsFac.fields("Limit"))) / (OurShare / RateL) * 100 * Share / 100
            Else
                FShare = Share
            End If

            Dim RShare As Double = 0
            rsFac = db.OpenRemoteSet("Select * from FPart Where ANO=" & ANO & " and FID='" & FID & "'")
            Do While Not rsFac.Eof
                If tostr(rsFac.fields("Code")) <> "" And tostr(rsFac.fields("Comm")) = 0 And tostr(rsFac.fields("NetRate")) = 0 Then
                    rsFac.Edit()
                    rsFac.fields("NetRate") = Get_RateCon(ANO, rsFac.fields("Code"), Amount, rsFac.fields("Unit"))
                    If rsFac.fields("Unit") = "" Then rsFac.fields("Unit") = "C"
                    If Not rsFac.Update Then Throw New Exception(db.ErrDesc)
                End If
                RShare = RShare + rsFac.fields("Share")
                rsFac.MoveNext()
            Loop

            FShare = FShare * RShare / 100

            If Not FullCoverF Then
                rsFac = db.OpenRemoteSet("Select * from FPartDet Where ANO=" & ANO & " and FID='" & FID & "'")
                Do While Not rsFac.Eof
                    If tostr(rsFac.fields("Code")) <> "" And tostr(rsFac.fields("Comm")) = 0 And tostr(rsFac.fields("NetRate")) = 0 Then
                        rsFac.Edit()
                        rsFac.fields("NetRate") = Get_RateCon(ANO, rsFac.fields("Code"), Amount, rsFac.fields("Unit"))
                        If rsFac.fields("Unit") = "" Then rsFac.fields("Unit") = "C"
                        If Not rsFac.Update Then Throw New Exception(db.ErrDesc)
                    End If
                    rsFac.MoveNext()
                Loop
                FullCoverF = Check_Facultative_Main_Coverage(ANO, FID)
            End If

            If FullCoverF AndAlso ANO <> LANO Then
                If Round(FShare, 13, MidpointRounding.AwayFromZero) - Round((100 - toval(rsArr.fields("MShare")) - toval(rsArr.fields("FShare"))), 13, MidpointRounding.AwayFromZero) > 0 Then
                    ErrMsg = "Facultative Placement exceeds sum insured amount !"
                    Throw New Exception(ErrMsg)
                End If

                rsArr.Edit()
                rsArr.fields("FShare") = toval(rsArr.fields("FShare")) + FShare
                rsArr.fields("FAmount") = Decimal.Add(toval(rsArr.fields("FAmount")), FShare * OurShare / 100)
                rsArr.fields("Retention") = toval(rsArr.fields("Retention")) - FShare
                rsArr.fields("RAmount") = Decimal.Add(toval(rsArr.fields("RAmount")), -FShare * OurShare / 100)
                If Not rsArr.Update Then Throw New Exception(db.ErrDesc)
            End If

            ' Update Security Amount if Limit=0
            Dim rsSec As RemoteSet
            rsSec = db.OpenRemoteSet("Select ANO, FID, ID, Share, Amount from FSecurity Where Limit=0 and ANO=" & ANO & " and FID='" & FID & "'")
            Do While Not rsSec.Eof
                rsSec.Edit()
                rsSec.fields("Amount") = Amount * toval(rsSec.fields("Share")) / 100
                If Not rsSec.Update Then Throw New Exception(rsSec.ErrDesc)
                rsSec.MoveNext()
            Loop

            If Not db.Execute("Update Acceptance Set AStatus='W', LDate='" & Format(Today.Date, "MM/DD/YYYY") & "', LTime='" & Time() & "' Where AStatus='W' and ANO=" & ANO) Then Throw New Exception(db.ErrDesc)
            If db.RecordsAffected = 0 Then
                ErrMsg = "Policy Already Processed !"
                Throw New Exception(ErrMsg)
            End If

            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function UnConfirmed_Facultative(ByVal ANO As Long, ByVal FID As String) As Boolean
        Try
            Dim FullCoverF As Boolean
            Dim Share As Double
            Dim Amount As Double
            Dim OurShare As Double
            Dim rsArr As RemoteSet
            Dim rsFac As RemoteSet
            Dim rs As RemoteSet
            Dim ErrMsg As String = ""

            rs = db.OpenRemoteSet("Select LANO, AStatus from Acceptance Where ANO=" & ANO)
            If rs.fields("AStatus") <> "W" Then
                ErrMsg = "Please Check Policy Data Status !"
                Throw New Exception(ErrMsg)
            End If

            Dim LANO As Long = toval(rs.fields("LANO"))
            If ANO <> LANO Then
                rsArr = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
                If rsArr.Eof Then
                    ErrMsg = "Please Check Risk Arrangement Data !"
                    Throw New Exception(ErrMsg)
                End If
                OurShare = toval(rsArr.fields("TAmount"))
            Else
                OurShare = 0
            End If

            rsFac = db.OpenRemoteSet("Select * from RArrDet Where Status='R' and ANO=" & ANO & " and FID='" & FID & "'")
            If rsFac.Eof Then
                ErrMsg = "No Facultative Data !"
                Throw New Exception(ErrMsg)
            End If
            FullCoverF = rsFac.fields("FullCoverF")
            Share = toval(rsFac.fields("Share")) - toval(rsFac.fields("JPShare"))
            Amount = rsFac.fields("Amount")
            rsFac.Edit()
            rsFac.fields("Status") = "O"
            rsFac.fields("AUserID") = ""
            rsFac.fields("AUserDate") = Today.Date
            If Not rsFac.Update Then Throw New Exception(rsFac.ErrDesc)

            Dim RateL As Double = toval(rsFac.fields("RateL"))

            Dim FShare As Double
            If toval(rsFac.fields("Limit")) <> 0 And OurShare <> 0 Then
                FShare = (toval(rsFac.fields("Limit"))) / (OurShare / RateL) * 100 * Share / 100
            Else
                FShare = Share
            End If

            Dim RShare As Double = 0
            rsFac = db.OpenRemoteSet("Select sum(Share) as RShare from FPart Where ANO=" & ANO & " and FID='" & FID & "'")
            RShare = rsFac.fields("RShare")

            FShare = FShare * RShare / 100

            If Not FullCoverF Then
                FullCoverF = Check_Facultative_Main_Coverage(ANO, FID)
            End If

            If FullCoverF AndAlso ANO <> LANO Then
                rsArr.Edit()
                rsArr.fields("FShare") = rsArr.fields("FShare") - FShare
                rsArr.fields("FAmount") = Decimal.Add(toval(rsArr.fields("FAmount")), -FShare * OurShare / 100)
                rsArr.fields("Retention") = rsArr.fields("Retention") + FShare
                rsArr.fields("RAmount") = Decimal.Add(toval(rsArr.fields("RAmount")), FShare * OurShare / 100)
                If Not rsArr.Update Then Throw New Exception(rsArr.ErrDesc)
            End If

            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function Check_Facultative_Main_Coverage(ByVal ANO As Long, ByVal FID As String) As Boolean
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select RCover.ANO from FPartDet, RCover Where RCover.ANO=FPartDet.ANO and RCover.Code=FPartDet.Code and RCover.Category='M' and FPartDet.ANO=" & ANO & " and FPartDet.FID='" & FID & "'", adOpenForwardonly)
        Check_Facultative_Main_Coverage = (Not rs.Eof())
    End Function
    Private Function Get_RateCon(ByVal ANO As Long, ByVal Code As String, ByVal TSI As Double, Optional ByVal Unit As String = "C", Optional ByRef Loading As Double = 0, Optional ByRef TExcess As Double = 0, Optional ByRef PCTLOSS As Double = 0, Optional ByRef PCALC As String = "", Optional ByRef HoldF As Boolean = False, Optional ByRef HoldMessage As String = "", Optional ByVal pSDate As Object = Nothing, Optional ByRef CID As String = "", Optional ByRef SRate As Double = 0, Optional ByRef RateConF As Boolean = True, Optional ByRef ScalePCT As Double = 0) As Double
        Dim rs As RemoteSet
        Dim RateLoadingF As Boolean
        Dim Rate As Double
        Dim SDate As Date
        If Unit = "" Then Unit = "C"
        If TSI = 0 Then TSI = 1
        If IsDate(pSDate) Then
            SDate = pSDate
        Else
            rs = db.OpenRemoteSet("Select SDate from Acceptance Where ANO=" & ANO)
            SDate = rs.fields("SDate")
        End If
        rs = db.OpenRemoteSet("Select Top 1 * from fn_RateCon(" & ANO & ",'" & Code & "'," & tovalSF(TSI) & ",'" & Format(SDate, "MM/DD/YYYY") & "') Where AllowedF=1")
        RateConF = (Not rs.Eof)
        Code = tostr(rs.fields("Code"))
        RateLoadingF = toval(rs.fields("RateLoadingF"))
        Rate = toval(rs.fields("Rate"))
        Loading = toval(rs.fields("Loading")) / 100
        TExcess = toval(rs.fields("TExcess"))
        PCTLOSS = toval(rs.fields("PCTLOSS"))
        PCALC = tostr(rs.fields("PCALC"))
        If TSI <> 0 And Unit = "F" Then
            ' To Flat Rate
            Rate = Round(TSI * Rate / 100, 2)
        ElseIf Unit = "M" Then
            ' To Mile
            Rate = Rate * 10
        End If
        If toval(rs.fields("ProgressiveF")) AndAlso TSI > toval(rs.fields("MaxTSI")) Then Rate = 0
        If Loading = 0 Then Loading = 1
        If RateLoadingF OrElse PCALC = "S" Then
            Loading = Loading * Get_RateLoading(ANO, Code, SDate, TSI, HoldF, HoldMessage, CID, , SRate, ScalePCT)
            If TSI <> 0 And Unit = "F" Then
                ' To Flat Rate
                SRate = Round(TSI * SRate / 100, 2)
            ElseIf Unit = "M" Then
                ' To Mile
                SRate = SRate * 10
            End If
        End If
        Get_RateCon = Rate
    End Function
    Private Function Get_RateLoading(ByVal ANO As Long, ByVal Code As String, ByVal PDate As Date, Optional ByVal TSI As Double = 0, Optional ByRef HoldF As Boolean = False, Optional ByRef HoldMessage As String = "", Optional ByRef CID As String = "", Optional ByRef AggregateTSI As Double = 0, Optional ByRef SRate As Double = 0, Optional ByRef ScalePCT As Double = 0) As Double
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select * from Get_RateLoading(" & ANO & ",'" & Code & "','" & Format(todate(PDate), "MM/DD/YYYY") & "'," & tovalSF(TSI) & ") RateCon")
        HoldF = toval(rs.fields("HoldF"))
        HoldMessage = tostr(rs.fields("HoldMessage"))
        CID = tostr(rs.fields("CID"))
        AggregateTSI = toval(rs.fields("AggregateTSI"))
        SRate = toval(rs.fields("SRate"))
        ScalePCT = toval(rs.fields("ScalePCT"))
        Get_RateLoading = toval(rs.fields("Loading"))
    End Function
    Private Function Verify_SC(ByVal param As Object, ByVal FIndex() As String, ByVal FBuffer() As String, Optional ByVal tPrefix As String = "") As Boolean

        Dim MapGroup As String = tostr(getInParamValue(param, 0))
        Dim dbUser As String = tostr(getInParamValue(param, 1))
        Dim MapCode As String = tostr(getInParamValue(param, 2))
        Dim BatchNo As String = tostr(getInParamValue(param, 3))
        Dim PartialF As Boolean = toval(getInParamValue(param, 4))
        Dim PDate As Date = todate(getInParamValue(param, 5))

        Try
            ' Record Identity
            Dim BID As Long = GetFieldValue(FBuffer(GetFieldIndex("BID", FIndex)))
            Dim PolicyNo As String = tostr(GetFieldValue(FBuffer(GetFieldIndex("PolicyNo", FIndex))))
            Dim SchemeNo As String = tostr(GetFieldValue(FBuffer(GetFieldIndex("SchemeNo", FIndex))))

            Dim PolicyNoSQL As String = ""
            Dim SchemeNoSQl As String = ""
            Dim PolicyNOTable As String = ""
            Dim SchemeNOTable As String = ""

            Dim FieldTo() As String = Nothing
            Dim FieldFrom() As String = Nothing
            Dim VariableT() As String = Nothing
            Dim CompulsoryF() As Boolean
            Dim SpaceF() As Boolean
            Dim UCaseF() As Boolean
            Dim MapValueF() As Boolean
            Dim DefValue() As String
            Dim Param1() As String
            Dim Param2() As String
            Dim Func() As String
            Dim StrictF() As Boolean
            Dim MatchLikeF() As Boolean
            Dim SysBatchExtension As Integer = toval(GetAppSetting("SysBatchExtension"))
            If SysBatchExtension = 0 Then SysBatchExtension = 1
            Dim SQL As String
            Dim rs As RemoteSet

            SQL = "Select * from map_field where mapcode = '" & MapCode & "' order by orderno "
            rs = db.OpenRemoteSet(SQL)

            Dim Idx As Integer
            Dim Z As Integer
            Dim rsTemp As RemoteSet
            Z = rs.RecordCount

            ReDim FieldTo(Z)
            ReDim FieldFrom(Z)
            ReDim VariableT(Z)
            ReDim CompulsoryF(Z)
            ReDim SpaceF(Z)
            ReDim UCaseF(Z)
            ReDim MapValueF(Z)
            ReDim DefValue(Z)
            ReDim Param1(Z)
            ReDim Param2(Z)
            ReDim Func(Z)
            ReDim StrictF(Z)
            ReDim MatchLikeF(Z)

            PolicyNoSQL = ""
            SchemeNoSQl = ""
            PolicyNOTable = ""
            SchemeNOTable = ""
            Idx = 1

            Do While Not rs.Eof
                FieldTo(Idx) = tostr(rs.fields("FieldTo"))
                FieldFrom(Idx) = Trim(tostr(rs.fields("FieldFrom")))
                VariableT(Idx) = tostr(rs.fields("FieldType"))
                CompulsoryF(Idx) = rs.fields("CompulsoryF")
                SpaceF(Idx) = rs.fields("SpaceF")
                UCaseF(Idx) = rs.fields("UCaseF")
                DefValue(Idx) = tostr(rs.fields("DefaultValue"))
                Param1(Idx) = tostr(rs.fields("Param1"))
                Param2(Idx) = tostr(rs.fields("Param2"))
                Func(Idx) = tostr(rs.fields("Func"))
                StrictF(Idx) = toval(rs.fields("StrictF"))
                MatchLikeF(Idx) = toval(rs.fields("MatchLikeF"))
                MapValueF(Idx) = toval(rs.fields("MapValueF"))

                Idx = Idx + 1
                rs.MoveNext()
            Loop
            rs.CloseRemoteSet()

            PolicyNoSQL = PolicyNoSQL + SQLBuilder(MapCode, PDate, "PolicyNO")
            SchemeNoSQl = SchemeNoSQl + SQLBuilder(MapCode, PDate, "SchemeNO")

            Dim ErrMsg As String
            If Not InsertSysBatch(MapGroup, MapCode, BID, PDate, FieldTo, FieldFrom, VariableT, CompulsoryF, SpaceF, UCaseF, MapValueF, DefValue, Param1, Param2, Func, StrictF, MatchLikeF, FIndex, FBuffer, ErrMsg, tPrefix) Then
                StrMsg = StrMsg & "Insert SysBatch : " & ErrMsg & vbCrLf
            End If

            SQL = "SELECT top 1 MR.Refno,Mr.PriorityF,MR.MapRefId,Mr.DumpProfileF,Mr.CreateProfileF,MR.InsuredF,Mr.DuplicateF FROM Map_Reference MR inner join " & tPrefix & "SysBatch" & MapGroup & " as t on (1=1) "
            SQL = SQL & " where t.Inception between Mr.Sdate and Mr.Edate "
            SQL = SQL & " and mr.MapCode='" & MapCode & "'"
            SQL = SQL & " and mr.MapType='PolicyNo'"
            SQL = SQL & " and mr.AllowedF=1"
            SQL = SQL & " and T.BID=" & BID
            If PolicyNoSQL <> "" Then
                SQL = SQL & " and exists (" & PolicyNoSQL & ")"
            End If
            SQL = SQL & " order by MR.PriorityF desc,Mr.MapRefID,Mr.REFNO"

            Dim DumpProfileF As Boolean = True
            Dim CreateProfileF As Boolean = True
            Dim InsuredF As Boolean = True
            Dim DuplicateF As Byte = 1
            rsTemp = db.OpenRemoteSet(SQL)
            If Not rsTemp.Eof Then
                If PolicyNo = "" Then PolicyNo = tostr(rsTemp.fields("refno"))
                DumpProfileF = toval(rsTemp.fields("DumpProfileF"))
                CreateProfileF = toval(rsTemp.fields("CreateProfileF"))
                InsuredF = toval(rsTemp.fields("InsuredF"))
                DuplicateF = toval(rsTemp.fields("DuplicateF"))
            Else
                StrMsg = StrMsg & "Policy No not found in table Map Reference !" & vbCrLf
            End If

            If SchemeNo = "" Then
                SQL = "SELECT top 1 MR.Refno,Mr.PriorityF,MR.MapRefId,Mr.DumpProfileF,Mr.CreateProfileF,MR.InsuredF FROM Map_Reference MR inner join " & tPrefix & "SysBatch" & MapGroup & " as t on (1=1) "
                SQL = SQL & " where t.Inception between Mr.Sdate and Mr.Edate "
                SQL = SQL & " and mr.MapCode='" & MapCode & "'"
                SQL = SQL & " and mr.MapType='SchemeNo'"
                SQL = SQL & " and mr.AllowedF=1"
                SQL = SQL & " and T.BID=" & BID
                If SchemeNoSQl <> "" Then
                    SQL = SQL & " and exists (" & SchemeNoSQl & ")"
                End If
                SQL = SQL & " order by MR.PriorityF desc,Mr.MapRefID,Mr.REFNO"
                rsTemp = db.OpenRemoteSet(SQL)
                If Not rsTemp.Eof Then
                    SchemeNo = rsTemp.fields("refno")
                Else
                    StrMsg = StrMsg & "SchemeNo not found in table Map Reference !" & vbCrLf
                End If
            End If

            Dim ANO As Long
            Dim TOC As String
            Dim SDate As Date
            Dim EDate As Date
            Dim CNO As Long
            Dim Segment As String
            Dim Branch As String
            SQL = "Select A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.SDate, A.EDate, A.TOC, C.CNO, C.Segment from Acceptance A, Cover C where A.AType not in ('A','C') and A.Policyno = '" & PolicyNo & "' and A.Astatus = 'I' and A.ANO = A.LANO and A.CNO = C.CNO"
            rsTemp = db.OpenRemoteSet(SQL)
            If Not rsTemp.Eof Then
                ANO = rsTemp.fields("ANO")
                TOC = rsTemp.fields("TOC")
                SDate = rsTemp.fields("SDate")
                EDate = rsTemp.fields("EDate")
                CNO = rsTemp.fields("CNO")
                Segment = rsTemp.fields("Segment")
                Branch = rsTemp.fields("Branch")
            Else
                StrMsg = StrMsg & "Inforced Policy Data Not Found (Policy No. " & PolicyNo & ")" & " !" & vbCrLf
            End If

            Dim EndorseF As Boolean
            Dim CertificateNo As String

            EndorseF = toval(GetFieldValue(FBuffer(GetFieldIndex("ENDORSEF", FIndex))))
            CertificateNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("CertificateNo", FIndex))))
            If EndorseF Then
                rsTemp = db.OpenRemoteSet("Select top 1 ANO, Branch, SDate, EDate, TOC from Acceptance Where LANO<>ANO and LANO=" & ANO & " and CertificateNo='" & CertificateNo & "'")
                If Not rsTemp.Eof Then
                    TOC = rsTemp.fields("TOC")
                    SDate = rsTemp.fields("SDate")
                    EDate = rsTemp.fields("EDate")
                    Branch = rsTemp.fields("Branch")
                Else
                    StrMsg = StrMsg & "Certificate Data Not Found (Policy No. " & PolicyNo & ", CertificateNo. " & CertificateNo & ")" & " !"
                End If
            End If

            If StrMsg = "" Then

                rs = db.OpenRemoteSet("Select SysBatch.* from " & tPrefix & "SysBatch" & MapGroup & " SysBatch Where BID=" & BID)
                rs.Edit()
                rs.fields("ANO") = ANO
                rs.fields("DumpProfileF") = DumpProfileF
                rs.fields("CreateProfileF") = CreateProfileF
                rs.fields("InsuredF") = InsuredF

                If rs.fields("TOC") = "" Then
                    rs.fields("TOC") = TOC
                End If

                If rs.fields("PolicyNo") = "" Then
                    rs.fields("PolicyNo") = PolicyNo
                End If

                If rs.fields("CertificateNo") = "" Then
                    rs.fields("CertificateNo") = CertificateNo
                End If

                If rs.fields("SchemeNo") = "" Then
                    rs.fields("SchemeNo") = SchemeNo
                End If

                If rs.fields("Segment") = "" Then
                    rs.fields("Segment") = Segment
                End If

                If rs.fields("Branch") = "" Then
                    rs.fields("Branch") = Branch
                End If

                If tostr(rs.fields("Expiry")) = "" Or Format(todate(rs.fields("Expiry")), "MM/DD/YYYY") = "01/01/1900" Then
                    rs.fields("Expiry") = EDate
                End If
                If tostr(rs.fields("Inception")) = "" Or Format(todate(rs.fields("Inception")), "MM/DD/YYYY") = "01/01/1900" Then
                    rs.fields("Inception") = SDate
                End If

                Dim Inparam(3) As Object
                Inparam(0) = DuplicateF
                Inparam(1) = SDate
                Inparam(2) = EDate
                Inparam(3) = TOC
                If Not Check_Entry_Object_SC(rs, Inparam, ErrMsg, tPrefix) Then
                    StrMsg = StrMsg & "Check Entry for Object Information : " & ErrMsg & vbCrLf
                End If
                If Not rs.Update Then Throw New Exception(rs.ErrDesc)

                Dim rsBatch As RemoteSet
                Dim FCount As Integer
                Dim fIndex_1() As String
                Dim FCount_1 As Integer

                SQL = "Select S1.* "
                rsBatch = db.OpenRemoteSet("Select * from sysBatch" & MapGroup & " Where 1<>1")
                FIndex = rsBatch.fields_index
                FCount = UBound(FIndex)

                If SysBatchExtension >= 1 Then
                    rsBatch = db.OpenRemoteSet("Select * from sysBatch" & MapGroup & "_Ext Where 1<>1")
                    fIndex_1 = rsBatch.fields_index
                    FCount_1 = UBound(fIndex_1)

                    For i = 0 To rsBatch.fields_Count - 1
                        If GetFieldIndex(rsBatch.fields_Name(i), FIndex) >= FCount Then
                            SQL = SQL & ", S2.[" & rsBatch.fields_Name(i) & "]"
                        End If
                    Next
                End If

                If SysBatchExtension >= 2 Then
                    rsBatch = db.OpenRemoteSet("Select * from sysBatch" & MapGroup & "_Ext_1 Where 1<>1")
                    For i = 0 To rsBatch.fields_Count - 1
                        If GetFieldIndex(rsBatch.fields_Name(i), FIndex) >= FCount AndAlso GetFieldIndex(rsBatch.fields_Name(i), fIndex_1) >= FCount_1 Then
                            SQL = SQL & ", S3.[" & rsBatch.fields_Name(i) & "]"
                        End If
                    Next
                End If

                SQL = SQL & " from sysBatch" & MapGroup & " S1 "
                SQL = SQL & " Left Join sysBatch" & MapGroup & "_Ext S2 on (S2.BID=S1.BID)"
                SQL = SQL & " Left Join sysBatch" & MapGroup & "_Ext_1 S3 on (S3.BID=S1.BID)"
                SQL = SQL & " Where S1.BID=" & BID
                rsBatch = db.OpenRemoteSet(SQL)

                If Not Check_Entry_SC(rsBatch, Inparam, ErrMsg) Then
                    StrMsg = StrMsg & "Check Entry : " & ErrMsg & vbCrLf
                Else
                    If Not db.Execute("Update SysBatch Set Status='W' from SysBatch" & MapGroup & " SysBatch Where BID=" & BID) Then Throw New Exception(db.ErrDesc)
                End If

            End If

            If StrMsg <> "" Then
                Return False
            Else
                Return True
            End If

        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try

    End Function
    Private Function Check_Entry_Object_SC(ByVal rsBatch As RemoteSet, ByVal InParam As Object, ByRef ErrMsg As String, Optional ByVal tPrefix As String = "") As Boolean
        Dim CheckDuplicateF As Byte = toval(InParam(0))
        Dim M_SDate As Date = todate(InParam(1))
        Dim M_EDate As Date = todate(InParam(2))
        Dim TOC As String = tostr(InParam(3))
        Dim rs As RemoteSet
        ErrMsg = ""
        Try
            Dim PolicyNo As String = tostr(rsBatch.fields("PolicyNo"))
            Dim Segment As String = tostr(rsBatch.fields("Segment"))

            Dim Inception As Date
            Dim Expiry As Date
            Inception = todate(rsBatch.fields("INCEPTION")).Date
            Expiry = todate(rsBatch.fields("EXPIRY")).Date

            'Check Object Information

            Dim j As Integer
            Dim PFLDID As String = ""
            Dim PVALUEID As String = ""
            Dim FLDID As String = ""
            Dim VALUEID As String = ""
            Dim VALUEDESC As String = ""
            Dim DEFVALUEID As String = ""
            Dim SFLDID As String = ""
            Dim SVALUEID As String = ""
            Dim REGID As String = ""
            Dim RFLDID As String = tostr(rsBatch.fields("RFLDID"))
            Dim RVALUEID As String = tostr(rsBatch.fields("RVALUEID"))
            Dim IAccReg As Long = 0
            Dim ExclusiveF As Boolean
            Dim UniqueRefNoF As Boolean
            Dim EachAccRegF As Boolean
            Dim rsTOC As RemoteSet
            rsTOC = db.OpenQueryDef("QTOC_GENHTAB", adOpenForwardonly, TOC)
            If Not rsTOC.Eof Then
                IAccReg = rsTOC.fields("IAccReg")
                REGID = rsTOC.fields("REGID")
                ExclusiveF = toval(rsTOC.fields("ExclusiveF"))
                UniqueRefNoF = toval(rsTOC.fields("UniqueRefNoF"))
                EachAccRegF = toval(rsTOC.fields("EachAccRegF"))

                For j = 1 To 15
                    FLDID = tostr(rsTOC.fields("FLDID" & j))
                    If FLDID <> "" Then
                        VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                        VALUEID = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                        DEFVALUEID = ""

                        If InStr(VALUEID, Chr(16)) > 0 Then
                            DEFVALUEID = Left(VALUEID, InStr(VALUEID, Chr(16)) - 1)
                            VALUEID = Right(VALUEID, Len(VALUEID) - InStrRev(VALUEID, Chr(16)))
                        End If

                        If VALUEDESC = "" Then VALUEDESC = VALUEID
                        If toval(rsTOC.fields("FLDTAB" & j)) Then
                            If (VALUEID <> "" Or VALUEDESC <> "") Then
                                If j > 1 AndAlso toval(rsTOC.fields("SUBLINKF" & j)) Then
                                    rs = db.OpenRemoteSet("select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and (fldid" & j - 1 & "<>'" & PFLDID & "' or valueid" & j - 1 & "='' or valueid" & j - 1 & "='" & PVALUEID & "') and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                                Else
                                    rs = db.OpenRemoteSet("Select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                                End If
                                If Not rs.Eof Then
                                    If VALUEID = VALUEDESC Then VALUEDESC = tostr(rs.fields("DESCRIPTION"))
                                    VALUEID = tostr(rs.fields("ValueID"))
                                Else
                                    If VALUEID = VALUEDESC Then
                                        VALUEID = DEFVALUEID
                                        VALUEDESC = ""
                                    Else
                                        VALUEID = DEFVALUEID
                                    End If
                                End If
                            End If
                        Else
                            If VALUEDESC <> "" Then
                                VALUEID = Get_ValueID(FLDID, VALUEDESC, Inception, TOC, Segment)
                            Else
                                VALUEID = ""
                            End If
                        End If

                        If AccRegisterFlag(IAccReg, j) Then


                            If SFLDID = "" Then
                                SFLDID = FLDID
                            Else
                                SFLDID = SFLDID + "|" + FLDID
                            End If
                            If SVALUEID = "" Then
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    SVALUEID = VALUEID
                                Else
                                    SVALUEID = VALUEDESC
                                End If
                            Else
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    SVALUEID = SVALUEID + "|" + VALUEID
                                Else
                                    SVALUEID = SVALUEID + "|" + VALUEDESC
                                End If
                            End If
                        End If

                        PFLDID = FLDID
                        PVALUEID = VALUEID

                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = VALUEID
                        rsBatch.fields("DESCRIPTION" & j) = VALUEDESC
                    Else
                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = ""
                        rsBatch.fields("DESCRIPTION" & j) = ""
                    End If
                Next

                For j = 1 To 15
                    If rsTOC.fields("FLDID" & j) <> "" Then
                        ' Spread Info
                        If toval(rsTOC.fields("SpreadInfoF" & j)) AndAlso toval(rsTOC.fields("FLDTAB" & j)) AndAlso rsBatch.fields("OBJ_INFO_" & Format(j, "00")) <> "" Then
                            rs = db.OpenQueryDef("QSpreadInfo", adOpenForwardonly, rsTOC.fields("FLDID" & j), rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                            If Not rs.Eof Then
                                For i = j + 1 To 15
                                    If rsTOC.fields("FLDID" & i) <> "" Then
                                        If rsBatch.fields("OBJ_INFO_" & Format(i, "00")) = "" Then
                                            For k = 1 To 15
                                                If rs.fields("FLDID" & k) <> "" Then
                                                    If rsTOC.fields("FLDID" & i) = rs.fields("FLDID" & k) Then
                                                        rsBatch.fields("OBJ_INFO_" & Format(i, "00")) = rs.fields("VALUEID" & k)
                                                        If rsBatch.fields("DESCRIPTION" & i) = "" Then
                                                            rsBatch.fields("DESCRIPTION" & i) = rs.fields("VALUEDESC" & k)
                                                        End If
                                                        Exit For
                                                    End If
                                                Else
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                    Else
                                        Exit For
                                    End If
                                Next
                            End If
                        End If

                        If toval(rsTOC.fields("FLDCOM" & j)) Then
                            If toval(rsTOC.fields("FLDTAB" & j)) Then
                                If rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = "" And (Not AccRegisterFlag(IAccReg, j) Or (RFLDID = "" Or RVALUEID = "" Or rsBatch.fields("DESCRIPTION" & j) = "")) Then
                                    ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsBatch.fields("DESCRIPTION" & j) & "', Please Check General Table For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                End If
                                If RFLDID <> "" And RVALUEID <> "" Then
                                    rs = db.OpenRemoteSet("Select top 1 FLDID, VALUEID from GendTab where AllowedF = 1 and FLDID = '" & RFLDID & "' and ValueID = '" & RVALUEID & "'")
                                    If rs.Eof Then ErrMsg = ErrMsg & "Incorrect ValueID for Generate Object Information ! " & vbCrLf
                                End If
                            Else
                                If rsBatch.fields("DESCRIPTION" & j) = "" Then
                                    ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                End If
                            End If
                        End If
                    Else
                        Exit For
                    End If
                Next
            Else
                ErrMsg = ErrMsg & "Invalid Type Of Cover !" & vbCrLf
            End If

            ' Extended Object Information
            rsTOC = db.OpenQueryDef("QTOC_EXT_GENHTAB", adOpenForwardonly, TOC)
            If Not rsTOC.Eof Then
                For j = 16 To 30
                    FLDID = tostr(rsTOC.fields("FLDID" & j))
                    VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                    VALUEID = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                    DEFVALUEID = ""

                    If InStr(VALUEID, Chr(16)) > 0 Then
                        DEFVALUEID = Left(VALUEID, InStr(VALUEID, Chr(16)) - 1)
                        VALUEID = Right(VALUEID, Len(VALUEID) - InStrRev(VALUEID, Chr(16)))
                    End If

                    If VALUEDESC = "" Then VALUEDESC = VALUEID

                    If FLDID <> "" Then
                        If (VALUEID <> "" Or VALUEDESC <> "") And toval(rsTOC.fields("FLDTAB" & j)) Then
                            If j > 1 AndAlso toval(rsTOC.fields("SUBLINKF" & j)) Then
                                rs = db.OpenRemoteSet("select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and (fldid" & j - 1 & "<>'" & PFLDID & "' or valueid" & j - 1 & "='' or valueid" & j - 1 & "='" & PVALUEID & "') and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                            Else
                                rs = db.OpenRemoteSet("Select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                            End If
                            If Not rs.Eof Then
                                If VALUEID = VALUEDESC Then VALUEDESC = tostr(rs.fields("DESCRIPTION"))
                                VALUEID = tostr(rs.fields("ValueID"))
                            Else
                                VALUEID = DEFVALUEID
                            End If
                        End If

                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = VALUEID
                        rsBatch.fields("DESCRIPTION" & j) = VALUEDESC

                        PFLDID = FLDID
                        PVALUEID = VALUEID

                        If toval(rsTOC.fields("FLDCOM" & j)) Then
                            If toval(rsTOC.fields("FLDTAB" & j)) Then
                                If rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = "" Then
                                    ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsBatch.fields("DESCRIPTION" & j) & "', Please Check General Table For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                End If
                            Else
                                If rsBatch.fields("DESCRIPTION" & j) = "" Then
                                    ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                End If
                            End If
                        End If
                    Else
                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = ""
                        rsBatch.fields("DESCRIPTION" & j) = ""
                    End If
                Next
            End If


            If tPrefix = "" AndAlso CheckDuplicateF > 0 AndAlso Not rsBatch.fields("ENDORSEF") Then
                ' Check Duplicate in Acceptance
                If ((REGID <> "" AndAlso SFLDID <> "" AndAlso SVALUEID <> "") Or (tostr(rsBatch.fields("ContractNo")) <> "") Or Not (tostr(rsBatch.fields("OrderNo")) = "" Or tostr(rsBatch.fields("DocNo")) = "")) Then
                    Dim LockedKey As String = ""
                    If UniqueRefNoF Then
                        If tostr(rsBatch.fields("ContractNo")) = "" Then
                            LockedKey = REGID & "_" & tostr(rsBatch.fields("OrderNo")) + tostr(rsBatch.fields("DocNo"))
                        Else
                            LockedKey = REGID & "_" & tostr(rsBatch.fields("ContractNo"))
                        End If
                    Else
                        LockedKey = REGID & "_" & SFLDID & "_" & SVALUEID
                    End If
                    If Not db.GetLockedObject("DUPL_OBJECT_" & LockedKey, True) Then Throw New Exception("Can't Acquire Locked Object!")

                    Dim AFLDID() As String
                    Dim AVALUEID() As String

                    If EachAccRegF Then
                        AFLDID = Convert_FLDID_Into_Array(SFLDID)
                        AVALUEID = Convert_FLDID_Into_Array(SVALUEID)
                    Else
                        ReDim AFLDID(0)
                        ReDim AVALUEID(0)
                        AFLDID(0) = SFLDID
                        AVALUEID(0) = SVALUEID
                    End If

                    For i = 0 To AFLDID.GetUpperBound(0)
                        If tostr(rsBatch.fields("ContractNo")) = "" Then
                            If CheckDuplicateF = 1 Then
                                rs = db.OpenQueryDef("QCheckObjectInsured_Upload", adOpenForwardonly, REGID, AFLDID(i), AVALUEID(i), Inception, Expiry, tostr(rsBatch.fields("OrderNo")) + tostr(rsBatch.fields("DocNo")), IIf(ExclusiveF, 1, 0), TOC)
                            Else
                                rs = db.OpenQueryDef("QCheckObjectInsured_Upload", adOpenForwardonly, "", "", "", Inception, Expiry, tostr(rsBatch.fields("OrderNo")) + tostr(rsBatch.fields("DocNo")), IIf(ExclusiveF, 1, 0), TOC)
                            End If
                        Else
                            If CheckDuplicateF = 1 Then
                                rs = db.OpenQueryDef("QCheckObjectInsured_Upload", adOpenForwardonly, REGID, AFLDID(i), AVALUEID(i), Inception, Expiry, tostr(rsBatch.fields("ContractNo")), IIf(ExclusiveF, 1, 0), TOC)
                            Else
                                rs = db.OpenQueryDef("QCheckObjectInsured_Upload", adOpenForwardonly, "", "", "", Inception, Expiry, tostr(rsBatch.fields("ContractNo")), IIf(ExclusiveF, 1, 0), TOC)
                            End If
                        End If
                        If Not rs.Eof Then
                            If toval(rs.fields("UniqueRefNoF")) Then
                                ErrMsg = ErrMsg & "Possible Duplicate Reference No (" & tostr(rsBatch.fields("ContractNo")) & ") !" & vbCrLf
                            Else
                                ErrMsg = ErrMsg & "Possible Duplicate Object (" & AFLDID(i) & "-" & AVALUEID(i) & ") !" & vbCrLf
                            End If
                            ErrMsg = ErrMsg & " in Quotation No. " & rs.fields("Quotation No") & " , CI No. " & rs.fields("CI No") & ", Policy No. " & rs.fields("Policy No") & vbCrLf
                            Exit For
                        End If
                    Next

                    ' Check Duplicate in Scheme_Transaction
                    If tostr(rsBatch.fields("ContractNo")) = "" Then
                        rs = db.OpenQueryDef("QCheck_ContractNo", adOpenForwardonly, tostr(rsBatch.fields("OrderNo")) + tostr(rsBatch.fields("DocNo")), PolicyNo)
                        If Not rs.Eof Then
                            ErrMsg = ErrMsg & "Duplicate in Scheme Transaction - ORDERNO. " & tostr(rsBatch.fields("OrderNo")) & " or DOCNO " & tostr(rsBatch.fields("DocNo")) & " in Policy No. " & PolicyNo & " ! " & vbCrLf
                        End If
                    Else
                        rs = db.OpenQueryDef("QCheck_ContractNo", adOpenForwardonly, tostr(rsBatch.fields("ContractNo")), PolicyNo)
                        If Not rs.Eof Then
                            ErrMsg = ErrMsg & "Duplicate in Scheme Transaction - Contract No. " & tostr(rsBatch.fields("ContractNo")) & " in Policy No. " & PolicyNo & " ! " & vbCrLf
                        End If
                    End If

                    ' Check Duplicate in SysBatchSC
                    rs = db.OpenQueryDef("QCheck_ContractNo_SysBatchSC", adOpenForwardonly, tostr(rsBatch.fields("ContractNo")), tostr(rsBatch.fields("OrderNo")), tostr(rsBatch.fields("DocNo")), PolicyNo)
                    If Not rs.Eof Then
                        ErrMsg = ErrMsg & "Duplicate in SysBatch - "
                        ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("ContractNo")) = "", "", " Contract No. " & tostr(rsBatch.fields("ContractNo"))) & " BID : " & tostr(rsBatch.fields("BID"))
                        ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("OrderNo")) = "", "", " Order No. " & tostr(rsBatch.fields("OrderNo")))
                        ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("DocNo")) = "", "", " DocNo " & tostr(rsBatch.fields("DocNo")))
                        ErrMsg = ErrMsg & vbCrLf
                    End If

                    ' Check Error in Link Batch No
                    If rsBatch.fields("LinkBatchNo") <> "" Then
                        rs = db.OpenQueryDef("QCheck_LinkBatchNo", adOpenForwardonly, tostr(rsBatch.fields("LinkBatchNo")), tostr(rsBatch.fields("ContractNo")), tostr(rsBatch.fields("OrderNo")), tostr(rsBatch.fields("DocNo")))
                        If Not rs.Eof Then
                            ErrMsg = ErrMsg & "Error in Link SysBatch - "
                            ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("LinkBatchNo")) = "", "", " Link Batch No. " & tostr(rsBatch.fields("LinkBatchNo")))
                            ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("ContractNo")) = "", "", " Contract No. " & tostr(rsBatch.fields("ContractNo")))
                            ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("OrderNo")) = "", "", " Order No. " & tostr(rsBatch.fields("OrderNo")))
                            ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("DocNo")) = "", "", " DocNo " & tostr(rsBatch.fields("DocNo")))
                            ErrMsg = ErrMsg & vbCrLf
                        End If
                    End If

                    If Not db.ReleaseLockedObject("DUPL_OBJECT_" & LockedKey) Then Throw New Exception("Can't Release Locked Object!")
                End If
            End If

            If ErrMsg <> "" Then
                Check_Entry_Object_SC = False
            Else
                Check_Entry_Object_SC = True
            End If
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function

    Private Function Check_Entry_SC(ByVal rsBatch As RemoteSet, ByVal InParam As Object, ByRef ErrMsg As String, Optional ByVal tPrefix As String = "") As Boolean
        Dim CheckDuplicateF As Byte = toval(InParam(0))
        Dim M_SDate As Date = todate(InParam(1))
        Dim M_EDate As Date = todate(InParam(2))
        Dim TOC As String = tostr(InParam(3))
        Dim pCoverage1 As String
        Dim pCoverage2 As String
        Dim NOOFMONTHS_1 As Integer
        Dim NOOFMONTHS_2 As Integer
        Dim PolicyNo As String
        Dim SchemeNo As String
        Dim Branch As String
        Dim MSCode As String
        Dim Segment As String
        Dim DailyBasisF As Boolean
        Dim rs As RemoteSet
        ErrMsg = ""
        Try
            PolicyNo = tostr(rsBatch.fields("PolicyNo"))
            SchemeNo = tostr(rsBatch.fields("SchemeNo"))
            Branch = tostr(rsBatch.fields("Branch"))
            MSCode = tostr(rsBatch.fields("MSCode"))
            Segment = tostr(rsBatch.fields("Segment"))

            rs = db.OpenRemoteSet("Select DailyBasisF from Scheme_Master Where AllowedF = 1 and SchemeNo='" & SchemeNo & "'")
            If Not rs.Eof Then
                DailyBasisF = toval(rs.fields("DailyBasisF"))
            Else
                ErrMsg = ErrMsg & "Incorrect Scheme Master (Does not Exist / Not Allowed) !" & vbCrLf
            End If

            If MSCode <> "" Then
                rs = db.OpenRemoteSet("Select MSCode from MSCode Where Post_Flag=1 and Branch in ('','" & Branch & "') and MSCode='" & MSCode & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Invalid MSCode : " & MSCode & " !" & vbCrLf
                End If
            End If

            pCoverage1 = tostr(rsBatch.fields("Coverage_1"))
            pCoverage2 = tostr(rsBatch.fields("Coverage_2"))

            NOOFMONTHS_1 = toval(rsBatch.fields("NOOFMONTHS_1"))
            NOOFMONTHS_2 = toval(rsBatch.fields("NOOFMONTHS_2"))

            If NOOFMONTHS_1 <> 0 And pCoverage1 = "" Then pCoverage1 = "Comprehensive"
            If NOOFMONTHS_2 <> 0 And pCoverage2 = "" Then pCoverage2 = "TLO"

            If pCoverage1 = "" Then
                pCoverage1 = pCoverage2
                NOOFMONTHS_1 = NOOFMONTHS_2
                pCoverage2 = ""
                NOOFMONTHS_2 = 0
            End If

            Dim Inception As Date
            Dim Expiry As Date
            Inception = todate(rsBatch.fields("INCEPTION")).Date
            Expiry = todate(rsBatch.fields("EXPIRY")).Date

            If DateDiff(DateInterval.Day, Inception, M_SDate) > 0 Then
                ErrMsg = ErrMsg & "Inception Date cannot be earlier than " & Format(M_SDate, "dd-mmm-yyyy") & " !" & vbCrLf
            End If
            If DateDiff(DateInterval.Day, Inception, M_EDate) < 0 Then
                ErrMsg = ErrMsg & "Inception Date cannot be later than " & Format(M_EDate, "dd-mmm-yyyy") & " !" & vbCrLf
            End If

            If DateDiff(DateInterval.Day, Inception, Expiry) <= 0 Then
                ErrMsg = ErrMsg & "Incorrect Coverage Period Please Check Inception and Expiry ! " & vbCrLf
            End If

            If Branch <> "" Then
                rs = db.OpenRemoteSet("Select Branch from FL_UserBranch('" & db_user & "','" & Branch & "') B Where B.Branch='" & Branch & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Invalid Branch : " & Branch & " !" & vbCrLf
                End If
            End If

            rs = db.OpenRemoteSet("Select Coverage from Scheme_CoverageType Where SchemeNo='" & SchemeNo & "' and Coverage='" & pCoverage1 & "'")
            If rs.Eof Then
                ErrMsg = ErrMsg & "Incorrect Coverage Type : " & pCoverage1 & " !" & vbCrLf
            End If

            If pCoverage2 <> "" Then
                rs = db.OpenRemoteSet("Select Coverage from Scheme_CoverageType Where SchemeNo='" & SchemeNo & "' and Coverage='" & pCoverage2 & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Incorrect Coverage Type : " & pCoverage2 & " !" & vbCrLf
                End If
            End If


            If toval(rsBatch.fields("Installment_Freq")) <> 0 Then
                If toval(rsBatch.fields("Installment_Duration")) = 0 Then ErrMsg = ErrMsg & "Invalid Installment Duration !" & vbCrLf
            End If

            If tostr(rsBatch.fields("ID")) <> "" Then
                rs = db.OpenRemoteSet("select Top 1 ID from profile where id = '" & tostr(rsBatch.fields("ID")) & "' or refid = '" & tostr(rsBatch.fields("ID")) & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Invalid Profile Id (" & tostr(rsBatch.fields("ID")) & ") !" & vbCrLf
                End If
            End If

            If tostr(rsBatch.fields("ContractNo")) = "" Then
                If tostr(rsBatch.fields("OrderNo")) = "" Or tostr(rsBatch.fields("DocNo")) = "" Then
                    ErrMsg = ErrMsg & " Invalid Order No or Doc No !" & vbCrLf
                End If
            End If

            ' Check Business Source
            Dim BSID As String
            Dim BSType As String

            BSID = rsBatch.fields("BSID")
            BSType = rsBatch.fields("BSType")

            If BSID <> "" AndAlso BSType = "P" Then
                rs = db.OpenRemoteSet("Select Profile.ID, Profile.RestrictedF from Profile Left Join LOB on (LOB.LOB=Profile.LOB) Where Profile.ID='" & BSID & "' and (coalesce(LOB.BSType,'')='' or LOB.BSType='" & BSType & "')")
                If rs.Eof OrElse toval(rs.fields("RestrictedF")) Then
                    ErrMsg = ErrMsg & "Invalid or Restricted Business Profile " & BSID & " !" & vbCrLf
                End If
            End If

            BSID = rsBatch.fields("BSID1")
            BSType = rsBatch.fields("BSType1")

            If BSID <> "" AndAlso BSType = "P" Then
                rs = db.OpenRemoteSet("Select Profile.ID, Profile.RestrictedF from Profile Left Join LOB on (LOB.LOB=Profile.LOB) Where Profile.ID='" & BSID & "' and (coalesce(LOB.BSType,'')='' or LOB.BSType='" & BSType & "')")
                If rs.Eof OrElse toval(rs.fields("RestrictedF")) Then
                    ErrMsg = ErrMsg & "Invalid or Restricted Business Profile " & BSID & " !" & vbCrLf
                End If
            End If

            If ErrMsg <> "" Then
                Check_Entry_SC = False
            Else
                Check_Entry_SC = True
            End If
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function

    Private Function Verify_BE(ByVal param As Object, ByVal FIndex() As String, ByVal FBuffer() As String) As Boolean

        Dim MapGroup As String = tostr(getInParamValue(param, 0))
        Dim dbUser As String = tostr(getInParamValue(param, 1))
        Dim MapCode As String = tostr(getInParamValue(param, 2))
        Dim BatchNo As String = tostr(getInParamValue(param, 3))
        Dim PartialF As Boolean = toval(getInParamValue(param, 4))
        Dim PDate As Date = todate(getInParamValue(param, 5))

        Try
            ' Record Identity
            Dim BID As Long = GetFieldValue(FBuffer(GetFieldIndex("BID", FIndex)))
            Dim AType As String = GetFieldValue(FBuffer(GetFieldIndex("AType", FIndex)))

            If AType = "" Then AType = "E" ' Default Endorsement

            Dim FieldTo() As String = Nothing
            Dim FieldFrom() As String = Nothing
            Dim VariableT() As String = Nothing
            Dim CompulsoryF() As Boolean
            Dim SpaceF() As Boolean
            Dim UCaseF() As Boolean
            Dim MapValueF() As Boolean
            Dim DefValue() As String
            Dim Param1() As String
            Dim Param2() As String
            Dim Func() As String
            Dim StrictF() As Boolean
            Dim MatchLikeF() As Boolean
            Dim SQL As String
            Dim rs As RemoteSet
            Dim MapReferenceF As Boolean
            Dim SysBatchExtension As Integer = toval(GetAppSetting("SysBatchExtension"))
            If SysBatchExtension = 0 Then SysBatchExtension = 1

            SQL = "Select M1.MapReferenceF from map_Header M1 where M1.MapCode='" & MapCode & "'"
            rs = db.OpenRemoteSet(SQL)
            MapReferenceF = toval(rs.fields("MapReferenceF"))

            SQL = "Select * from map_field where mapcode = '" & MapCode & "' order by orderno "
            rs = db.OpenRemoteSet(SQL)

            Dim Idx As Integer
            Dim Z As Integer
            Dim rsTemp As RemoteSet
            Z = rs.RecordCount

            ReDim FieldTo(Z)
            ReDim FieldFrom(Z)
            ReDim VariableT(Z)
            ReDim CompulsoryF(Z)
            ReDim SpaceF(Z)
            ReDim UCaseF(Z)
            ReDim MapValueF(Z)
            ReDim DefValue(Z)
            ReDim Param1(Z)
            ReDim Param2(Z)
            ReDim Func(Z)
            ReDim StrictF(Z)
            ReDim MatchLikeF(Z)

            Idx = 1
            Do While Not rs.Eof
                FieldTo(Idx) = tostr(rs.fields("FieldTo"))
                FieldFrom(Idx) = Trim(tostr(rs.fields("FieldFrom")))
                VariableT(Idx) = tostr(rs.fields("FieldType"))
                CompulsoryF(Idx) = rs.fields("CompulsoryF")
                SpaceF(Idx) = rs.fields("SpaceF")
                UCaseF(Idx) = rs.fields("UCaseF")
                DefValue(Idx) = tostr(rs.fields("DefaultValue"))
                Param1(Idx) = tostr(rs.fields("Param1"))
                Param2(Idx) = tostr(rs.fields("Param2"))
                Func(Idx) = tostr(rs.fields("Func"))
                StrictF(Idx) = toval(rs.fields("StrictF"))
                MatchLikeF(Idx) = toval(rs.fields("MatchLikeF"))
                MapValueF(Idx) = toval(rs.fields("MapValueF"))

                Idx = Idx + 1
                rs.MoveNext()
            Loop
            rs.CloseRemoteSet()

            Dim RefNoSQL As String = ""
            RefNoSQL = RefNoSQL + SQLBuilder(MapCode, PDate, "PolicyNo")

            Dim ErrMsg As String
            If Not InsertSysBatch(MapGroup, MapCode, BID, PDate, FieldTo, FieldFrom, VariableT, CompulsoryF, SpaceF, UCaseF, MapValueF, DefValue, Param1, Param2, Func, StrictF, MatchLikeF, FIndex, FBuffer, ErrMsg) Then
                StrMsg = StrMsg & "Insert SysBatch : " & ErrMsg & vbCrLf
            End If

            Dim ANO As Long = 0
            Dim RegNo As String = GetFieldValue(FBuffer(GetFieldIndex("RegNo", FIndex)))
            Dim A_PolicyNo As String = GetFieldValue(FBuffer(GetFieldIndex("A_PolicyNo", FIndex)))
            Dim PolicyNo As String = GetFieldValue(FBuffer(GetFieldIndex("PolicyNo", FIndex)))
            Dim CertificateNo As String = GetFieldValue(FBuffer(GetFieldIndex("CertificateNo", FIndex)))
            Dim OBJ_ID As String = GetFieldValue(FBuffer(GetFieldIndex("OBJ_ID", FIndex)))
            Dim RefNo As String = GetFieldValue(FBuffer(GetFieldIndex("RefNo", FIndex)))
            Dim TOC As String
            Dim SDate As Date
            Dim EDate As Date
            Dim Effective As Date
            Dim MasterF As Boolean = False
            Dim M_TOC As String = ""
            Dim M_PolicyType As String = ""

            If AType = "E" Then
                SQL = ""

                If A_PolicyNo <> "" Then
                    SQL = SQL & " Select Top 1 A.ANO, A.LANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RefNo, A.PDate, A.SDate, A.EDate, A.TOC, C.PolicyType from Cover C, Acceptance A Where ((A.AType in ('N','E','C') And A.AStatus in ('I')) or (A.AType in ('N','E') And A.AStatus in ('W'))) and C.CNO=A.CNO and (A.PolicyNo+case when A.CERTIFICATENO<>'' then '-'+A.CERTIFICATENO else '' end)='" & A_PolicyNo & "' Order by A.ANO Desc"
                ElseIf PolicyNo <> "" Then
