                    If ANO = LANO Then
                        If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCEMASTER", NewANO, AUserID, BackDatedF, ADate) Then
                            StrMsg = "Process Inforce Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    Else
                        If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCE", NewANO, AUserID, BackDatedF, ADate) Then
                            StrMsg = "Process Inforce Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    End If
                Else
                    StrMsg = "Process Inforce Failed !" & vbCrLf & StrMsg & vbCrLf
                    GoTo errmsg
                End If

