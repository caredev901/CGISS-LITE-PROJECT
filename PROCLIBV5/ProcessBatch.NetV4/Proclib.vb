        rsDst.fields("BSFEEAmount1") = toval(GetFieldValue(FBuffer(GetFieldIndex("BSFEEAmount1", FIndex))))
        rsDst.fields("BSUPFEE1") = toval(GetFieldValue(FBuffer(GetFieldIndex("BSUPFEE1", FIndex))))
