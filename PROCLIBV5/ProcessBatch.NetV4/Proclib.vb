        Else
            rsDst.fields("NCDate") = SDate
        End If

        Dim pCoverage1 As String = tostr(GetFieldValue(FBuffer(GetFieldIndex("COVERAGE_1", FIndex))))
        Dim pCoverage2 As String = tostr(GetFieldValue(FBuffer(GetFieldIndex("COVERAGE_2", FIndex))))
        NOFFYEARS_1 = toval(GetFieldValue(FBuffer(GetFieldIndex("NOOFMONTHS_1", FIndex))))
        If tostr(GetFieldValue(FBuffer(GetFieldIndex("COVERAGE_2", FIndex)))) <> "" Then
            NOFFYEARS_2 = toval(GetFieldValue(FBuffer(GetFieldIndex("NOOFMONTHS_2", FIndex))))
            If NOFFYEARS_2 = 0 AndAlso DateDiff(DateInterval.Month, SDate, EDate) - NOFFYEARS_1 > 0 Then
                NOFFYEARS_2 = DateDiff(DateInterval.Month, SDate, EDate) - NOFFYEARS_1
            End If
        Else
            NOFFYEARS_2 = 0
        End If
        NOFFYEARS = NOFFYEARS_1 + NOFFYEARS_2

        If NOFFYEARS = 0 Or DateDiff(DateInterval.Day, DateAdd(DateInterval.Month, NOFFYEARS, SDate), EDate) < 0 Then
            NOFFYEARS = DateDiff(DateInterval.Month, SDate, EDate)
        End If

        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Month, NOFFYEARS, SDate), EDate) > 0 Then
            NOFFYEARS = NOFFYEARS + 1
        End If

        If NOFFYEARS_1 = 0 OrElse NOFFYEARS_1 > NOFFYEARS Then NOFFYEARS_1 = NOFFYEARS
        NOFFYEARS_2 = NOFFYEARS - NOFFYEARS_1

        NOFFYEARS_1 = NOFFYEARS_1 / 12
        NOFFYEARS_2 = NOFFYEARS_2 / 12

        rsDst.fields("NOFYEARS") = NOFFYEARS_1 + NOFFYEARS_2
        rsDst.fields("NOFYEARS_1") = NOFFYEARS_1
        rsDst.fields("NOFYEARS_2") = NOFFYEARS_2
        rsDst.fields("COVERAGE_1") = pCoverage1
        If NOFFYEARS_2 <> 0 Then rsDst.fields("COVERAGE_2") = pCoverage2

        For i = 3 To 20
            rsDst.fields("COVERAGE_" & i) = tostr(GetFieldValue(FBuffer(GetFieldIndex("COVERAGE_" & i, FIndex))))
            If rsDst.fields("COVERAGE_" & i) <> "" Then
                If toval(GetFieldValue(FBuffer(GetFieldIndex("NOOFMONTHS_" & i, FIndex)))) <> 0 Then
                    rsDst.fields("NOFYEARS_" & i) = toval(GetFieldValue(FBuffer(GetFieldIndex("NOOFMONTHS_" & i, FIndex)))) / 12
                Else
                    rsDst.fields("NOFYEARS_" & i) = toval(GetFieldValue(FBuffer(GetFieldIndex("NOFYEARS_" & i, FIndex)))) / 12
                End If

                If toval(GetFieldValue(FBuffer(GetFieldIndex("SOOFMONTHS_" & i, FIndex)))) <> 0 Then
                    rsDst.fields("SOFYEARS_" & i) = toval(GetFieldValue(FBuffer(GetFieldIndex("SOOFMONTHS_" & i, FIndex)))) / 12
                Else
                    rsDst.fields("SOFYEARS_" & i) = toval(GetFieldValue(FBuffer(GetFieldIndex("SOFYEARS_" & i, FIndex)))) / 12
                End If
            Else
                ' Exit For
            End If
        Next

        For i = 1 To 100
            rsDst.fields("Rate_" & i) = toval(GetFieldValue(FBuffer(GetFieldIndex("Rate_" & i, FIndex))))
        Next i

        rsDst.fields("Rate") = toval(GetFieldValue(FBuffer(GetFieldIndex("Rate", FIndex))))
        rsDst.fields("REF_PREMIUM") = toval(GetFieldValue(FBuffer(GetFieldIndex("REF_PREMIUM", FIndex))))
        rsDst.fields("PREMIUM") = toval(GetFieldValue(FBuffer(GetFieldIndex("PREMIUM", FIndex))))
        rsDst.fields("FDAMOUNT_1") = toval(GetFieldValue(FBuffer(GetFieldIndex("FEE", FIndex))))
        rsDst.fields("FDAMOUNT_2") = toval(GetFieldValue(FBuffer(GetFieldIndex("DUTY", FIndex))))
        rsDst.fields("PMonth") = toval(GetFieldValue(FBuffer(GetFieldIndex("PMonth", FIndex))))

        rsDst.fields("STATUS") = "O"
        rsDst.fields("ANO") = -1
        rsDst.fields("CNO") = CNO
        rsDst.fields("LANO") = LANO

        If tostr(GetFieldValue(FBuffer(GetFieldIndex("BRANCH", FIndex)))) <> "" Then
            rsDst.fields("Branch") = tostr(GetFieldValue(FBuffer(GetFieldIndex("BRANCH", FIndex))))
        Else
            rsDst.fields("Branch") = Branch
        End If

        If tostr(GetFieldValue(FBuffer(GetFieldIndex("CT", FIndex)))) <> "" Then
            rsDst.fields("CT") = tostr(GetFieldValue(FBuffer(GetFieldIndex("CT", FIndex))))
        Else
            rsDst.fields("CT") = CT
        End If

        If tostr(GetFieldValue(FBuffer(GetFieldIndex("LOCATION", FIndex)))) <> "" Then
            rsDst.fields("LOCATION") = tostr(GetFieldValue(FBuffer(GetFieldIndex("LOCATION", FIndex))))
        Else
            rsDst.fields("LOCATION") = rsDst.fields("Branch")
        End If

        If tostr(GetFieldValue(FBuffer(GetFieldIndex("MSCode", FIndex)))) <> "" Then
            rsDst.fields("MSCode") = tostr(GetFieldValue(FBuffer(GetFieldIndex("MSCode", FIndex))))
        Else
            rsDst.fields("MSCode") = MSCode
        End If

        ' Start Object Information Value
        Dim FLDID As String
        Dim ValueID As String
        Dim ValueDesc As String
        Dim IAccReg As Long
        Dim RegID As String
        Dim sFLDID As String
        Dim sValueID As String
        Dim sValueDesc As String
        Dim RFLDID As String = tostr(GetFieldValue(FBuffer(GetFieldIndex("RFLDID", FIndex))))
        Dim RVALUEID As String = tostr(GetFieldValue(FBuffer(GetFieldIndex("RVALUEID", FIndex))))
        Dim rsTOC As RemoteSet

        rsTOC = db.OpenQueryDef("QTOC_GENHTAB", adOpenKeyset, TOC)
        IAccReg = toval(rsTOC.fields("IAccReg"))
        RegID = tostr(rsTOC.fields("RegID"))
        sFLDID = ""
        sValueID = ""
        sValueDesc = ""
        For j = 1 To 15
            FLDID = tostr(rsTOC.fields("FLDID" & j))
            If FLDID <> "" Then
                rsDst.fields("FLDID" & j) = FLDID
                ValueDesc = Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("DESCRIPTION" & j, FIndex)))))
                ValueID = Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("OBJ_INFO_" & Format(j, "00"), FIndex)))))
                rsDst.fields("VALUEID" & j) = ValueID
                rsDst.fields("VALUEDESC" & j) = ValueDesc

                If AccRegisterFlag(IAccReg, j) Then
                    If sFLDID = "" Then
                        sFLDID = FLDID
                    Else
                        sFLDID = sFLDID + "|" + FLDID
                    End If
                    If toval(rsTOC.fields("FLDTAB" & j)) Then
                        If sValueID = "" Then
                            sValueID = tostr(rsDst.fields("VALUEID" & j))
                        Else
                            sValueID = sValueID + "|" + tostr(rsDst.fields("VALUEID" & j))
                        End If
                    Else
                        If sValueID = "" Then
                            sValueID = tostr(rsDst.fields("VALUEDESC" & j))
                        Else
                            sValueID = sValueID + "|" + tostr(rsDst.fields("VALUEDESC" & j))
                        End If
                    End If
                    If sValueDesc = "" Then
                        sValueDesc = tostr(rsDst.fields("valuedesc" & j))
                    Else
                        sValueDesc = sValueDesc + "|" + tostr(rsDst.fields("valuedesc" & j))
                    End If
                End If
            Else
                Exit For
            End If
        Next j

        ' Extended Object Information
        rsTOC = db.OpenQueryDef("QTOC_EXT_GENHTAB", adOpenKeyset, TOC)
        If Not rsTOC.Eof Then
            For j = 16 To 30
                FLDID = tostr(rsTOC.fields("FLDID" & j))
                If FLDID <> "" Then
                    rsDst.fields("FLDID" & j) = FLDID
                    ValueDesc = Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("DESCRIPTION" & j, FIndex)))))
                    ValueID = Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("OBJ_INFO_" & Format(j, "00"), FIndex)))))
                    If toval(rsTOC.fields("FLDTAB" & j)) Then
                        rsDst.fields("VALUEID" & j) = ValueID
                        rsDst.fields("VALUEDESC" & j) = ValueDesc
                    Else
                        rsDst.fields("VALUEID" & j) = ""
                        rsDst.fields("VALUEDESC" & j) = ValueDesc
                    End If
                Else
                    Exit For
                End If
            Next j
        End If

        rsDst.fields("RegID") = RegID
        rsDst.fields("FLDID") = sFLDID
        rsDst.fields("ValueID") = sValueID
        rsDst.fields("ValueDesc") = sValueDesc
        rsDst.fields("LUserID") = UserID
        rsDst.fields("LDate") = Today.Date

        If Not rsDst.Update Then
            StrMsg = db.ErrDesc
            GoTo errmsg
        End If

        rsDst = db.OpenRemoteSet("Select * from " & tPrefix & "Scheme_TransactionDet Where 1<>1")
        For X = 0 To AddICoverDetCount - 1
            If tostr(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetTOI" & X + 1, FIndex)))) <> "" And tostr(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetDescription" & X + 1, FIndex)))) <> "" Then
                rsDst.AddNew()
                rsDst.fields("TrNo") = Trno
                rsDst.fields("TOI") = tostr(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetTOI" & X + 1, FIndex))))
                rsDst.fields("Description") = tostr(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetDescription" & X + 1, FIndex))))
                rsDst.fields("Qty") = toval(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetqty" & X + 1, FIndex))))
                rsDst.fields("Unit") = tostr(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetUnit" & X + 1, FIndex))))
                rsDst.fields("UValue") = toval(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetUValue" & X + 1, FIndex))))
                rsDst.fields("Amount") = toval(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetAmount" & X + 1, FIndex))))
                If Not rsDst.Update Then
                    StrMsg = db.ErrDesc
                    GoTo errmsg
                End If
            End If
        Next

        OverWritePayorF = toval(GetFieldValue(FBuffer(GetFieldIndex("OverwritePayorF", FIndex))))
        PayorID = tostr(GetFieldValue(FBuffer(GetFieldIndex("PayorID", FIndex))))
        Discount = toval(GetFieldValue(FBuffer(GetFieldIndex("Discount", FIndex))))
        Grace = toval(GetFieldValue(FBuffer(GetFieldIndex("Grace", FIndex))))
        WPC = toval(GetFieldValue(FBuffer(GetFieldIndex("WPC", FIndex))))
        Installment = toval(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_FREQ", FIndex))))
        Periode = toval(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_DURATION", FIndex))))
        PolicyYearF = toval(GetFieldValue(FBuffer(GetFieldIndex("PolicyYearF", FIndex))))
        PolicyYearInstallmentF = toval(GetFieldValue(FBuffer(GetFieldIndex("PolicyYearInstallmentF", FIndex))))
        AutoInstallmentPolicyYearF = toval(GetFieldValue(FBuffer(GetFieldIndex("AutoInstallmentPolicyYearF", FIndex))))

        AccountNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("AccountNo", FIndex))))
        BankAccount = tostr(GetFieldValue(FBuffer(GetFieldIndex("BankAccount", FIndex))))
        BankExpDate = todate(GetFieldValue(FBuffer(GetFieldIndex("BankExpDate", FIndex))))

        If tostr(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_FIRSTDUE", FIndex)))) = "" Or Format(todate(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_FIRSTDUE", FIndex)))).Date, "MM/DD/YYYY") = "01/01/1900" Then
            FirstDue = SDate
        Else
            FirstDue = todate(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_FIRSTDUE", FIndex)))).Date
        End If

        If tostr(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_LASTDUE", FIndex)))) = "" Or Format(todate(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_LASTDUE", FIndex)))).Date, "MM/DD/YYYY") = "01/01/1900" Then
            LastDue = EDate
        Else
            LastDue = todate(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_LASTDUE", FIndex)))).Date
        End If

        If OverWritePayorF Or PayorID <> "" Or (Installment > 0 And Installment <= 24) Or toval(Discount) <> 0 Or toval(Grace) <> 0 Or toval(WPC) <> 0 Or PolicyYearInstallmentF Or AccountNo <> "" Or BankAccount <> "" Or AutoInstallmentPolicyYearF Then
            If Not Create_Scheme_Payor(MasterAno, Trno, OverWritePayorF, PayorID, Installment, Periode, FirstDue, LastDue, Discount, Grace, WPC, PolicyYearF, PolicyYearInstallmentF, AccountNo, BankAccount, BankExpDate, AutoInstallmentPolicyYearF, tPrefix) Then
                StrMsg = "Failed Create Installment Periode"
                GoTo errmsg
            End If
        ElseIf Installment > 24 Then
            StrMsg = "Failed Create Installment Periode"
            GoTo errmsg
        End If

        Dim Correspondence_Name As String
        Dim Correspondence_Address As String
        Dim Correspondence_Phone As String
        Dim Correspondence_Email As String
        Dim Correspondence_Method As String

        Correspondence_Name = tostr(GetFieldValue(FBuffer(GetFieldIndex("Correspondence_Name", FIndex))))
        Correspondence_Address = tostr(GetFieldValue(FBuffer(GetFieldIndex("Correspondence_Address", FIndex))))
        Correspondence_Phone = tostr(GetFieldValue(FBuffer(GetFieldIndex("Correspondence_Phone", FIndex))))
        Correspondence_Email = tostr(GetFieldValue(FBuffer(GetFieldIndex("Correspondence_Email", FIndex))))
        Correspondence_Method = tostr(GetFieldValue(FBuffer(GetFieldIndex("Correspondence_Method", FIndex))))

        If Correspondence_Name <> "" Or Correspondence_Email <> "" Or Correspondence_Address <> "" Then
            If Correspondence_Name = "" Then Correspondence_Name = pName
            If Not Add_SchemeCorrespondenceAddress(Trno, Correspondence_Name, Correspondence_Address, Correspondence_Phone, Correspondence_Email, Correspondence_Method, tPrefix) Then
                StrMsg = StrMsg & "Process Update Correspondence Failed !" & vbCrLf
                GoTo errmsg
            End If
        End If


        Dim InParty_ID(InPartyCount - 1) As String
        Dim InParty_Name(InPartyCount - 1) As String
        Dim InParty_Address(InPartyCount - 1) As String
        Dim InParty_IType(InPartyCount - 1) As String
        Dim InParty_Remark(InPartyCount - 1) As String
        Dim InParty_Gender(InPartyCount - 1) As String
        Dim InParty_Relation(InPartyCount - 1) As String
        Dim InParty_ID_Type(InPartyCount - 1) As String
        Dim InParty_ID_No(InPartyCount - 1) As String
        Dim InParty_BirthDate(InPartyCount - 1) As String
        Dim InParty_BirthPlace(InPartyCount - 1) As String

        Dim InParty_Beneficiary_Name(InPartyCount - 1) As String
        Dim InParty_Beneficiary_Relation(InPartyCount - 1) As String
        Dim InParty_PassPortNo(InPartyCount - 1) As String
        Dim InParty_WNIF(InPartyCount - 1) As Boolean
        Dim InParty_Citizen(InPartyCount - 1) As String

        For X = 0 To InPartyCount - 1
            InParty_ID(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_ID" & X + 1, FIndex)))
            InParty_Name(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_Name" & X + 1, FIndex)))
            If InParty_ID(X) <> "" Or InParty_Name(X) <> "" Then
                InParty_Address(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_Address" & X + 1, FIndex)))
                InParty_IType(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_IType" & X + 1, FIndex)))
                InParty_Remark(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_Remark" & X + 1, FIndex)))
                InParty_Gender(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_Gender" & X + 1, FIndex)))
                InParty_Relation(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_Relation" & X + 1, FIndex)))
                InParty_ID_Type(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_ID_Type" & X + 1, FIndex)))
                InParty_ID_No(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_ID_No" & X + 1, FIndex)))
                InParty_BirthDate(X) = tostr(GetFieldValue(FBuffer(GetFieldIndex("InParty_BirthDate" & X + 1, FIndex))))

                InParty_Beneficiary_Name(X) = tostr(GetFieldValue(FBuffer(GetFieldIndex("InParty_Beneficiary_Name" & X + 1, FIndex))))
                InParty_Beneficiary_Relation(X) = tostr(GetFieldValue(FBuffer(GetFieldIndex("InParty_Beneficiary_Relation" & X + 1, FIndex))))
                InParty_PassPortNo(X) = tostr(GetFieldValue(FBuffer(GetFieldIndex("InParty_PassPortNo" & X + 1, FIndex))))
                InParty_WNIF(X) = toval(GetFieldValue(FBuffer(GetFieldIndex("InParty_WNIF" & X + 1, FIndex))))
                InParty_Citizen(X) = tostr(GetFieldValue(FBuffer(GetFieldIndex("InParty_Citizen" & X + 1, FIndex))))

                If InParty_BirthDate(X) <> "" And Not IsDate(InParty_BirthDate(X)) Then
                    InParty_BirthDate(X) = ""
                End If
                InParty_BirthPlace(X) = GetFieldValue(FBuffer(GetFieldIndex("InParty_BirthPlace" & X + 1, FIndex)))
                If Not Add_Scheme_InParty(Trno, InParty_ID(X), InParty_Name(X), InParty_Address(X), "", InParty_IType(X), InParty_Remark(X), InParty_Gender(X), InParty_Relation(X), InParty_ID_Type(X), InParty_ID_No(X), InParty_BirthDate(X), InParty_BirthPlace(X), InParty_Beneficiary_Name(X), InParty_Beneficiary_Relation(X), InParty_PassPortNo(X), InParty_WNIF(X), InParty_Citizen(X)) Then
                    StrMsg = StrMsg & "Process Add Interested Party Failed !" & vbCrLf
                    StrMsg = StrMsg & db.ErrDesc & vbCrLf
                    GoTo errmsg
                End If
            Else
                Exit For
            End If
        Next

        Dim beneficiaries_ID(BeneficiariesCount - 1) As String
        Dim beneficiaries_Name(BeneficiariesCount - 1) As String
        Dim beneficiaries_Address(BeneficiariesCount - 1) As String
        Dim beneficiaries_Address_2(BeneficiariesCount - 1) As String
        Dim beneficiaries_Relation(BeneficiariesCount - 1) As String
        Dim beneficiaries_PCTLOSS(BeneficiariesCount - 1) As Double
        Dim beneficiaries_BirthDate(BeneficiariesCount - 1) As String

        For X = 0 To BeneficiariesCount - 1
            beneficiaries_ID(X) = GetFieldValue(FBuffer(GetFieldIndex("ID" & X + 1, FIndex)))
            beneficiaries_Name(X) = GetFieldValue(FBuffer(GetFieldIndex("beneficiaries_Name" & X + 1, FIndex)))
            If beneficiaries_ID(X) <> "" OrElse beneficiaries_Name(X) <> "" Then
                beneficiaries_Address(X) = GetFieldValue(FBuffer(GetFieldIndex("beneficiaries_Address" & X + 1, FIndex)))
                beneficiaries_Address_2(X) = GetFieldValue(FBuffer(GetFieldIndex("beneficiaries_Address_2" & X + 1, FIndex)))
                beneficiaries_Relation(X) = GetFieldValue(FBuffer(GetFieldIndex("beneficiaries_Relation" & X + 1, FIndex)))
                beneficiaries_PCTLOSS(X) = toval(GetFieldValue(FBuffer(GetFieldIndex("beneficiaries_PCTLOSS" & X + 1, FIndex))))
                beneficiaries_BirthDate(X) = GetFieldValue(FBuffer(GetFieldIndex("beneficiaries_BirthDate" & X + 1, FIndex)))

                If Not Add_Scheme_Beneficiary(Trno, beneficiaries_ID(X), beneficiaries_Name(X), beneficiaries_Address(X), beneficiaries_Address_2(X), "", "", beneficiaries_Relation(X), beneficiaries_PCTLOSS(X), beneficiaries_BirthDate(X)) Then
                    StrMsg = StrMsg & "Process Add Beneficiaries Failed !" & vbCrLf
                    StrMsg = StrMsg & db.ErrDesc & vbCrLf
                    GoTo errmsg
                End If
            Else
                Exit For
            End If
        Next

        If Not SuspendSchemeVerifyF Then
            If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "Scheme_Verify", Trno, tPrefix, EndorseF, CertificateNo, Effective_Date, GetFieldValue(FBuffer(GetFieldIndex("MEMO", FIndex)))) Then
                StrMsg = "Process Scheme Verify Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                GoTo errmsg
            End If

            If Comment <> "" Then
                If Not db.Execute("Update Acceptance set Comment='" & Comment & "' from Acceptance Where BID=" & BID) Then
                    StrMsg = "Update Comment Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                    GoTo errmsg
                End If
            End If

            If tPrefix = "" Then
                ' Check Error in Link Batch No
                If GetFieldValue(FBuffer(GetFieldIndex("LinkBatchNo", FIndex))) <> "" Then
                    rs = db.OpenQueryDef("QCheck_LinkBatchNo", adOpenForwardonly, GetFieldValue(FBuffer(GetFieldIndex("LinkBatchNo", FIndex))), GetFieldValue(FBuffer(GetFieldIndex("ContractNo", FIndex))), GetFieldValue(FBuffer(GetFieldIndex("ORDERNO", FIndex))), GetFieldValue(FBuffer(GetFieldIndex("DocNo", FIndex))))
                    If Not rs.Eof Then
                        StrMsg = StrMsg & "Error in Link SysBatch - "
                        StrMsg = StrMsg & IIf(GetFieldValue(FBuffer(GetFieldIndex("LinkBatchNo", FIndex))) = "", "", " Link Batch No. " & GetFieldValue(FBuffer(GetFieldIndex("LinkBatchNo", FIndex))))
                        StrMsg = StrMsg & IIf(GetFieldValue(FBuffer(GetFieldIndex("ContractNo", FIndex))) = "", "", " Contract No. " & GetFieldValue(FBuffer(GetFieldIndex("ContractNo", FIndex))))
                        StrMsg = StrMsg & IIf(GetFieldValue(FBuffer(GetFieldIndex("ORDERNO", FIndex))) = "", "", " Order No. " & GetFieldValue(FBuffer(GetFieldIndex("ORDERNO", FIndex))))
                        StrMsg = StrMsg & IIf(GetFieldValue(FBuffer(GetFieldIndex("DocNo", FIndex))) = "", "", " DocNo " & GetFieldValue(FBuffer(GetFieldIndex("DocNo", FIndex))))
                        StrMsg = StrMsg & vbCrLf
                        GoTo errmsg
                    End If
                End If

                Dim ANO As Long = -1
                If ImmediateInforceF Then

                    Dim ADate As Date
                    If IsDate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                        ADate = todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex))))
                    Else
                        ADate = Today.Date
                    End If

                    Dim EndDate As Date
                    Dim LockedDate As Date
                    EndDate = GetEndDate(Branch)
                    LockedDate = GetLockedDate(Branch)
                    If DateDiff(DateInterval.Day, EndDate, ADate) <= 0 Then
                        ADate = DateAdd(DateInterval.Day, 1, EndDate)
                    End If

                    If DateDiff(DateInterval.Day, LockedDate, ADate) <= 0 Then
                        ADate = DateAdd(DateInterval.Day, 1, LockedDate)
                    End If

                    rs = db.OpenRemoteSet("Select ANO from Scheme_Transaction Where TRNO=" & Trno)
                    ANO = toval(rs.fields("ANO"))

                    db.Var_db_user = AUserID
                    db.Var_db_User_Type = IIf(db.GetPrivileges("ALLOWALLPRIVILEGESINFORCE"), "SUPERVISOR", db_user_type)
                    If PreInforceConditionsOK(ANO, ADate, "", False, True, False, False, StrMsg) Then
                        If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCE", ANO, AUserID, False, ADate, Voucher) Then
                            StrMsg = "Process Inforce Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    Else
                        StrMsg = "Process Inforce Failed !" & vbCrLf & StrMsg & vbCrLf
                        GoTo errmsg
                    End If
                    db.Var_db_user = db_user
                    db.Var_db_User_Type = db_user_type
                ElseIf InforceF Or InforceBulkF Then
                    rs = db.OpenRemoteSet("Select A.ANO, A.RegNo, A.CertificateNo from Scheme_Transaction S, Acceptance A Where A.ANO=S.ANO and S.TRNO=" & Trno)
                    ANO = toval(rs.fields("ANO"))
                    Dim RegNo As String = rs.fields("RegNo")
                    CertificateNo = rs.fields("CertificateNo")
                    BatchNo = rs.fields("BatchNo")

                    If InforceBulkF Then
                        rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='" & CertificateNo & "'")
                        If rs.Eof Then
                            rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='' and BatchNo='" & BatchNo & "'")
                        End If
                        CertificateNo = ""
                    Else
                        rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='" & CertificateNo & "'")
                    End If
                    If rs.Eof Then
                        rs.AddNew()
                    Else
                        rs.Edit()
                    End If
                    rs.fields("RegNo") = RegNo
                    rs.fields("CertificateNo") = CertificateNo
                    rs.fields("BatchNo") = BatchNo
                    rs.fields("Status") = "R"
                    rs.fields("Last_Opr") = AUserID
                    rs.fields("Last_Update") = Today.Date
                    If IsDate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                        rs.fields("ADate") = todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex))))
                    End If
                    If Not rs.Update Then
                        StrMsg = db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                End If
                If AutoPrintF Then
                    Insert_Policy_Auto_Print(ANO, "")
                End If
            End If
        End If

        Upload_SC = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Upload_SC = False
    End Function
    Private Function Endorse_Payor(ByVal LANO As Long, ByVal ANO As Long, ByVal ID As String, ByVal Installment As Integer, ByVal Period As Integer, ByVal FirstDue As Date, Optional ByVal Discount As Double = 0, Optional ByVal DiscAmount As Double = 0, Optional ByVal Grace As Integer = 0, Optional ByVal GDiscount As Double = 0, Optional ByVal NDiscount As Double = 0, Optional ByVal SLoading As Double = 0, Optional ByVal PolicyYearF As Boolean = False, Optional ByVal IDate_ As Object = Nothing, Optional ByVal IPCT_ As Object = Nothing, Optional ByVal RefType As String = "", Optional ByVal DiscDetailType_ As Object = Nothing, Optional ByVal DiscDetailPct_ As Object = Nothing, Optional ByVal Bank As String = "", Optional ByVal BankBranch As String = "", Optional ByVal AccountNo As String = "", Optional ByVal BankAccount As String = "", Optional ByVal BankName As String = "", Optional ByVal BillingGroup As String = "", Optional ByVal BillingDay As String = "", Optional ByVal MerchantCode As String = "", Optional ByVal WPC As Integer = 0, Optional ByVal PayorDetCode_ As Object = Nothing, Optional ByVal PayorDetPeriod_ As Object = Nothing, Optional ByVal PayorDetDiscount_ As Object = Nothing, Optional ByVal PayorDetDiscAmount_ As Object = Nothing, Optional ByVal IRate As Double = 0, Optional ByVal DecreaseF As Boolean = False, Optional ByVal SIScheduleF As Boolean = False, Optional ByVal NoDiscountRefundF As Boolean = False, Optional ByVal Overwrite_PayorF As Boolean = False, Optional ByVal FDInstallmentF As Boolean = False, Optional ByVal VATInstallmentF As Boolean = False) As Boolean
        Dim rs As RemoteSet
        Dim StrMsg As String = ""
        Dim Currrow As Integer
        Dim tPCT As Double
        Dim PCT As Double

        On Error GoTo errmsg

        If ANO = LANO Or LANO = -1 Then

            Dim TotalDisc As Double = 0
            If Not DiscDetailType_ Is Nothing Then
                If Not Delete_Records("Delete from AccDiscount Where ANO=" & ANO) Then
                    StrMsg = db.ErrDesc & vbCrLf
                    GoTo errmsg
                End If
                rs = db.OpenRemoteSet("Select * from AccDiscount Where 1<>1")
                For i = 0 To UBound(DiscDetailType_)
                    If tostr(DiscDetailType_(i)) <> "" Then
                        rs.AddNew()
                        rs.fields("ANO") = ANO
                        rs.fields("DType") = tostr(DiscDetailType_(i))
                        rs.fields("Discount") = toval(DiscDetailPct_(i))
                        TotalDisc = TotalDisc + toval(DiscDetailPct_(i))
                        If Not rs.UpdateRow Then
                            StrMsg = db.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    End If
                Next
                If Not rs.Eof Then
                    If Not rs.Update Then
                        StrMsg = db.ErrDesc
                        GoTo errmsg
                    End If
                End If
            End If

            Dim Address_1 As String
            Dim Address_2 As String
            Dim Address_3 As String
            If ID <> "" Then
                rs = db.OpenRemoteSet("Select top 1 ID, Address_1, Address_2, Address_3 from Profile Where Profile.ID='" & ID & "' or Profile.RefID='" & ID & "' or Profile.Name='" & ID & "'")
                If rs.Eof Then
                    StrMsg = "Payor ID not Found !"
                    GoTo errmsg
                End If
                ID = rs.fields("ID")
                Address_1 = rs.fields("Address_1")
                Address_2 = rs.fields("Address_2")
                Address_3 = rs.fields("Address_3")
                rs = db.OpenRemoteSet("Select * from Payor where ANO =" & ANO)
            Else
                rs = db.OpenRemoteSet("Select * from Payor where ANO =" & ANO)
                ID = rs.fields("ID")
                Address_1 = rs.fields("Address_1")
                Address_2 = rs.fields("Address_2")
                Address_3 = rs.fields("Address_3")
            End If
            If ID = "" Then
                StrMsg = "Payor ID not Found !"
                GoTo errmsg
            End If
            rs.Edit()
            rs.fields("ID") = ID
            rs.fields("Address_1") = Address_1
            rs.fields("Address_2") = Address_2
            rs.fields("Address_3") = Address_3
            rs.fields("DefaultPayorF") = 0

            rs.fields("Discount") = IIf(TotalDisc <> 0, TotalDisc, IIf(toval(Discount) = 0 And Not Overwrite_PayorF, toval(rs.fields("Discount")), toval(Discount)))
            rs.fields("DiscAmount") = IIf(toval(DiscAmount) = 0 And Not Overwrite_PayorF, toval(rs.fields("DiscAmount")), toval(DiscAmount))
            rs.fields("Grace") = IIf(toval(Grace) = 0 And Not Overwrite_PayorF, toval(rs.fields("Grace")), toval(Grace))
            rs.fields("WPC") = IIf(toval(WPC) = 0 And Not Overwrite_PayorF, toval(rs.fields("WPC")), toval(WPC))
            rs.fields("GDiscount") = IIf(toval(GDiscount) = 0 And Not Overwrite_PayorF, toval(rs.fields("GDiscount")), toval(GDiscount))
            rs.fields("NDiscount") = IIf(toval(NDiscount) = 0 And Not Overwrite_PayorF, toval(rs.fields("NDiscount")), toval(NDiscount))
            rs.fields("SLoading") = IIf(toval(SLoading) = 0 And Not Overwrite_PayorF, toval(rs.fields("SLoading")), toval(SLoading))
            rs.fields("PolicyYearF") = IIf(toval(PolicyYearF) = 0 And Not Overwrite_PayorF, toval(rs.fields("PolicyYearF")), toval(PolicyYearF))
            rs.fields("IRate") = IIf(toval(IRate) = 0 And Not Overwrite_PayorF, toval(rs.fields("IRate")), toval(IRate))
            rs.fields("DecreaseF") = IIf(toval(DecreaseF) = 0 And Not Overwrite_PayorF, toval(rs.fields("DecreaseF")), toval(DecreaseF))
            rs.fields("SIScheduleF") = IIf(toval(SIScheduleF) = 0 And Not Overwrite_PayorF, toval(rs.fields("SIScheduleF")), toval(SIScheduleF))
            rs.fields("NoRefundF") = IIf(toval(NoDiscountRefundF) = 0 And Not Overwrite_PayorF, toval(rs.fields("NoRefundF")), toval(NoDiscountRefundF))
            rs.fields("FDInstallmentF") = IIf(toval(FDInstallmentF) = 0 And Not Overwrite_PayorF, toval(rs.fields("FDInstallmentF")), toval(FDInstallmentF))
            rs.fields("VATInstallmentF") = IIf(toval(VATInstallmentF) = 0 And Not Overwrite_PayorF, toval(rs.fields("VATInstallmentF")), toval(VATInstallmentF))
            rs.fields("Installment") = IIf(toval(Installment) = 0 And Not Overwrite_PayorF, toval(rs.fields("Installment")), toval(Installment))
            rs.fields("Period") = IIf(Period = 0 And Not Overwrite_PayorF, toval(rs.fields("Period")), Period)


            rs.fields("LUserID") = db_user
            rs.fields("LDate") = Today.Date

            If RefType <> "" Then rs.fields("RefType") = RefType
            If Bank <> "" Then
                Dim rsB As RemoteSet
                rsB = db.OpenRemoteSet("Select Bank, Description From Bank Where Bank = '" & Bank & "'")
                Bank = tostr(rsB.fields("Bank"))
                If Not rsB.Eof Then
                    BankName = rsB.fields("Description")
                    If BankBranch <> "" Then
                        BankName = BankName & " " & BankBranch
                    End If
                End If
            End If
            If Bank <> "" Then rs.fields("Bank") = Bank
            If BankBranch <> "" Then rs.fields("BankBranch") = BankBranch
            If AccountNo <> "" Then rs.fields("AccountNo") = AccountNo
            If BankAccount <> "" Then rs.fields("BankAccount") = BankAccount
            If BankName <> "" Then rs.fields("BankName") = BankName
            If BillingGroup <> "" Then rs.fields("BillingGroup") = BillingGroup
            If BillingDay <> "" Then rs.fields("DDay") = toval(BillingDay)
            If MerchantCode <> "" Then rs.fields("MerchantCode") = MerchantCode

            Installment = toval(rs.fields("Installment"))

            If Installment > 0 Then
                tPCT = 0
                Currrow = 1
                Do While Currrow <= Installment
                    If tostr(IDate_(Currrow)) <> "" Then
                        rs.fields("IDate_" & Currrow) = todate(IDate_(Currrow))
                    Else
                        rs.fields("IDate_" & Currrow) = DateAdd(DateInterval.Month, (Currrow - 1) * Period, DateAdd(DateInterval.Day, toval(Grace), FirstDue))
                    End If
                    If Currrow < Installment Then
                        If toval(IPCT_(Currrow)) <> 0 Then
                            PCT = toval(IPCT_(Currrow))
                        Else
                            PCT = 100 / Installment
                        End If
                    Else
                        PCT = 100 - tPCT
                    End If
                    rs.fields("IPCT_" & Currrow) = PCT
                    Currrow = Currrow + 1
                    tPCT = tPCT + PCT
                Loop
            End If

            If Not db.GetPrivileges("ALLOWPASSSCANPAN") Then
                If isContainRestrictedPAN(rs.fields("AccountNo")) Then
                    Throw New Exception("Contain Restricted PAN (Payment Account Number) in field AccountNo!")
                End If
                If isContainRestrictedPAN(rs.fields("REFNO")) Then
                    Throw New Exception("Contain Restricted PAN (Payment Account Number) in field REFNO!")
                End If
                If isContainRestrictedPAN(rs.fields("REMARKS")) Then
                    Throw New Exception("Contain Restricted PAN (Payment Account Number) in field REMARKS!")
                End If
            End If

            If Not rs.Update Then
                StrMsg = db.ErrDesc
                GoTo errmsg
            End If


            If (AccountNo <> "" AndAlso BankAccount <> "" AndAlso (BankName <> "" OrElse Bank <> "")) AndAlso db.GetPrivileges("PROFILE_ACCOUNT") Then
                rs = db.OpenRemoteSet("Select top 1 coalesce(PCalc.Currency, SysTab.Currency) as Currency from SysTab Left Join PCalc on (PCalc.ANO=" & ANO & ")")
                If Not Create_ProAcc(ID, rs.fields("Currency"), AccountNo, BankAccount, BankName, Bank, BankBranch, "", 0, 0, "") Then GoTo errmsg
            End If
        Else
            If Not Create_Alternate_Payor(LANO, ANO, ID, Installment, Period, FirstDue, Discount, DiscAmount, Grace, GDiscount, NDiscount, SLoading, PolicyYearF, IDate_, IPCT_, DiscDetailType_, DiscDetailPct_, RefType, Bank, BankBranch, AccountNo, BankAccount, BankName, WPC, PayorDetCode_, PayorDetPeriod_, PayorDetDiscount_, PayorDetDiscAmount_, IRate, DecreaseF, SIScheduleF, NoDiscountRefundF, Overwrite_PayorF, FDInstallmentF, VATInstallmentF) Then GoTo errmsg
        End If

        Endorse_Payor = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Endorse_Payor = False
    End Function
    Private Function Create_Alternate_Payor(ByVal LANO As Long, ByVal ANO As Long, ByVal ID As String, ByVal Installment As Integer, ByVal Period As Integer, ByVal FirstDue As Date, Optional ByVal Discount As Double = 0, Optional ByVal DiscAmount As Double = 0, Optional ByVal Grace As Integer = 0, Optional ByVal GDiscount As Double = 0, Optional ByVal NDiscount As Double = 0, Optional ByVal SLoading As Double = 0, Optional ByVal PolicyYearF As Boolean = False, Optional ByVal IDate_ As Object = Nothing, Optional ByVal IPCT_ As Object = Nothing, Optional ByVal DiscDetailType_ As Object = Nothing, Optional ByVal DiscDetailPct_ As Object = Nothing, Optional ByVal RefType As String = "", Optional ByVal Bank As String = "", Optional ByVal BankBranch As String = "", Optional ByVal AccountNo As String = "", Optional ByVal BankAccount As String = "", Optional ByVal BankName As String = "", Optional ByVal WPC As Integer = 0, Optional ByVal PayorDetCode_ As Object = Nothing, Optional ByVal PayorDetPeriod_ As Object = Nothing, Optional ByVal PayorDetDiscount_ As Object = Nothing, Optional ByVal PayorDetDiscAmount_ As Object = Nothing, Optional ByVal IRate As Double = 0, Optional ByVal DecreaseF As Boolean = False, Optional ByVal SIScheduleF As Boolean = False, Optional ByVal NoDiscountRefundF As Boolean = False, Optional ByVal Overwrite_PayorF As Boolean = False, Optional ByVal FDInstallmentF As Boolean = False, Optional ByVal VATInstallmentF As Boolean = False) As Boolean
        Dim rsDst As RemoteSet
