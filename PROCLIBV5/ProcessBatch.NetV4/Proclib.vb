                            rsCL.fields("ShortDesc") = IIf(ShortDesc <> "", ShortDesc, rs.fields("ShortDesc"))
                            rsCL.fields("Description") = IIf(Description <> "", Description, rs.fields("Description"))
                            rsCL.fields("ShortDesc_1") = IIf(ShortDesc_1 <> "", ShortDesc_1, rs.fields("ShortDesc_1"))
