    Private Function Reinsurance_Rate(ByVal ANO As Long, ByRef CCY As String) As Double
        Dim rs As RemoteSet
        Dim CCYTo As String
        Dim BaseCCY As String
        Dim Rate As Double
        Rate = 1
        rs = db.OpenRemoteSet("Select Currency from SysTab", adOpenForwardonly)
        BaseCCY = rs.fields("Currency")
        If CCY = "" Then CCY = BaseCCY
        If CCY.ToUpper <> BaseCCY.ToUpper Then
            CCYTo = CCY
            Do
                CCY = CCYTo
                rs = db.OpenQueryDef("QReinsurance_Rate", adOpenForwardonly, ANO, CCY)
                CCYTo = tostr(rs.fields("CCYTO"))
                Rate = Rate * toval(rs.fields("Rate"))
            Loop While CCYTo.ToUpper <> CCY.ToUpper And CCYTo.ToUpper <> "" And CCYTo.ToUpper <> BaseCCY.ToUpper
        End If
        Reinsurance_Rate = Rate
    End Function
    Private Function PrevAccRegAmount(ByVal ANO As Long, ByVal RType As String) As Double
        Dim rs As RemoteSet
        ' Get Previous Accumulated Amount

        rs = db.OpenQueryDef("QACCREGAMOUNT_" & RType, adOpenForwardonly, ANO)
        PrevAccRegAmount = toval(rs.fields("Amount"))
        rs.CloseRemoteSet()
    End Function

    Private Function Get_Accumulation(ByVal RegID As String, ByVal FLDID As String, ByVal ValueID As String, ByVal RType As String, ByVal RYear As Integer) As Double
        Dim rs As RemoteSet

        rs = db.OpenQueryDef("QAccumulation", adOpenForwardonly, RegID, FLDID, ValueID, RType, RYear)
        Get_Accumulation = toval(rs.fields("Amount"))
    End Function
    Private Function ValidateRiskArrangement(ByVal ANO As Long, ByVal TOC As String, ByRef ErrMsg As String) As Boolean
        Try
            Dim rs As RemoteSet
            Dim RegID As String
            Dim FLDID As String
            Dim VALUEID As String
            Dim NoRiskAccumulationF As Boolean
            Dim RYear As Integer = 0

            Dim RiskAccumulationByTreatyYearF As Boolean

            rs = db.OpenRemoteSet("Select RiskAccumulationByTreatyYearF from SysTab")
            RiskAccumulationByTreatyYearF = toval(rs.fields("RiskAccumulationByTreatyYearF"))

            rs = db.OpenQueryDef("QACCREG", adOpenForwardonly, ANO)
            RegID = tostr(rs.fields("RegID"))
            FLDID = tostr(rs.fields("FLDID"))
            VALUEID = tostr(rs.fields("VALUEID"))
            NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
            If RiskAccumulationByTreatyYearF Then
                RYear = toval(rs.fields("RYear"))
            End If

            rs = db.OpenRemoteSet("Select * from RArrHeader Where ANO=" & ANO)
            Dim PCTLOSS As Double = toval(rs.fields("PCTLOSS"))
            If PCTLOSS = 0 Then PCTLOSS = 100
            Dim PCTSHARE As Double = toval(rs.fields("PCTSHARE"))
            Dim MSHARE = toval(rs.fields("MSHARE"))
            Dim TAmount As Double = toval(rs.fields("TAmount"))

            Dim TLimit As Double = 0
            Dim pLimit As Double = 0
            Dim Limit As Double = 0
            Dim Amount As Double = 0
            Dim QSAmount As Double = 0
            Dim QSLimit As Double = 0
            Dim DAmount As Double = 0
            Dim CAmount As Double = 0
            Dim XPAmount As Double = 0
            Dim PShare As Double = 0
            Dim rsR As RemoteSet
            Dim RType As String

            For Each RID In New String() {"CID", "XPID", "DID", "QID", "SP1ID", "SP2ID", "SP3ID", "AID"}
                rsR = db.OpenRemoteSet("Select R1.RType, R1.Currency, R1.RID, R1.PShare, R1.RShare, R2.Limit, R2.PLimit from Reinsurance R1, ReClass R2 Where R2.RNO=R1.RNO and R2.TOC='" & TOC & "' and R1.RID='" & rs.fields(RID) & "'")
                If Not rsR.Eof Then
                    Dim ReRate As Double = Reinsurance_Rate(ANO, rsR.fields("Currency"))
                    TLimit = toval(rsR.fields("Limit")) * ReRate
                    pLimit = toval(rsR.fields("PLimit")) * ReRate
                    RType = tostr(rsR.fields("RType"))
                    If NoRiskAccumulationF Then
                        Limit = TLimit
                    Else
                        If RType = "C" Or RType = "XP" Or RType = "D" Then
                            Limit = TLimit - Get_Accumulation(RegID, FLDID, VALUEID, RType, RYear) + PrevAccRegAmount(ANO, RType) / (PCTSHARE / 100 * PCTLOSS / 100 * (100 - MSHARE) / 100)
                        Else
                            Limit = TLimit - Get_Accumulation(RegID, FLDID, VALUEID, RType, RYear) + PrevAccRegAmount(ANO, RType)
                        End If
                    End If

                    RType = tostr(rsR.fields("RType"))
                    PShare = toval(rsR.fields("PShare"))
                    If PShare = 0 Then PShare = 100
                    Select Case RID
                        Case "CID"
                            Amount = toval(rs.fields("CAmount"))
                            CAmount = Amount
                        Case "XPID"
                            Amount = toval(rs.fields("XPAmount"))
                            XPAmount = Amount
                        Case "DID"
                            Amount = toval(rs.fields("DAmount"))
                            DAmount = Amount
                        Case "QID"
                            Amount = toval(rs.fields("QAmount")) + toval(rs.fields("QSRAmount"))
                            QSAmount = Amount
                            QSLimit = TLimit
                        Case "SP1ID"
                            Amount = toval(rs.fields("SP1Amount"))
                        Case "SP2ID"
                            Amount = toval(rs.fields("SP2Amount"))
                        Case "SP3ID"
                            Amount = toval(rs.fields("SP3Amount"))
                        Case "AID"
                            Amount = toval(rs.fields("AAmount")) + toval(rs.fields("AFRAmount"))
                    End Select

                    If (RType = "S1" Or RType = "S2" Or RType = "S3") Then
                        If QSLimit <> 0 AndAlso Amount > QSAmount * TLimit / QSLimit Then
                            If Abs(Amount - QSAmount * TLimit / QSLimit) > 0.01 Then
                                ErrMsg = "Cession Amount Exceeding Quota Share Limit for " & rsR.fields("RID") & " (Limit : " & Format(QSAmount * TLimit / QSLimit, "###,###,###") & ") !"
                                Throw New Exception(ErrMsg)
                            End If
                        End If
                    End If

                    If (RType = "Q" Or RType = "S1" Or RType = "S2" Or RType = "S3" Or RType = "A") Then
                        If (TAmount - CAmount - XPAmount - DAmount) * PShare / 100 < Amount Then
                            If Abs((TAmount - CAmount - XPAmount - DAmount) * PShare / 100 - Amount) > 0.01 Then
                                ErrMsg = "Cession Amount Exceeding Total Share Limit for " & rsR.fields("RID") & " !"
                                Throw New Exception(ErrMsg)
                            End If
                        End If
                    End If

                    If RType = "C" Or RType = "XP" Or RType = "D" Then
                        If Limit < Amount * (PCTSHARE / 100 * PCTLOSS / 100 * (100 - MSHARE) / 100) Then
                            If Abs(Limit - Amount * (PCTSHARE / 100 * PCTLOSS / 100 * (100 - MSHARE) / 100)) > 0.01 Then
                                ErrMsg = "Cession Amount Exceeding Treaty Limit for " & rsR.fields("RID") & " (Limit : " & Format(Limit, "###,###,###") & ") !"
                                Throw New Exception(ErrMsg)
                            End If
                        End If
                    Else
                        If Limit < Amount Then
                            If Abs(Limit - Amount) > 0.01 Then
                                ErrMsg = "Cession Amount Exceeding Treaty Limit for " & rsR.fields("RID") & " (Limit : " & Format(Limit, "###,###,###") & ") !"
                                Throw New Exception(ErrMsg)
                            End If
                        End If
                    End If

                    If pLimit <> 0 Then
                        If pLimit < Amount Then
                            If Abs(pLimit - Amount) > 0.01 Then
                                ErrMsg = "Cession Amount Exceeding Policy Limit for " & rsR.fields("RID") & " (Limit : " & Format(pLimit, "###,###,###") & ") !"
                                Throw New Exception(ErrMsg)
                            End If
                        End If
                    End If
                End If
            Next

            Return True
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function

