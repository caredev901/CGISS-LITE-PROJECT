                If Not rsDst.Update Then
                    StrMsg = db.ErrDesc
                    GoTo errmsg
                End If
            End If
        End If

        If ID <> "" Then
            rs = db.OpenRemoteSet("Select Top 1 ID, Address_1, Address_2, Address_3, Grace, WPC from Profile Where Profile.ID='" & ID & "' or Profile.RefID='" & ID & "' or Profile.Name='" & ID & "'")
        Else
