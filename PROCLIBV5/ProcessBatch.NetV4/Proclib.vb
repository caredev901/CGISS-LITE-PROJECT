                FeeParam(1) = Fee_ID_1
                FeeParam(2) = rs.fields("Currency")
                FeeParam(3) = Fee_Amount_1
                FeeParam(4) = Fee_AmountPCT_1
                FeeParam(5) = Fee_Remark_1
                FeeParam(6) = 0
