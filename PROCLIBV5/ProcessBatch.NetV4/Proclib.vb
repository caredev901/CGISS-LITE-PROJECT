                        TOC = rsTemp.fields("TOC")
                        SDate = rsTemp.fields("SDate")
                        EDate = rsTemp.fields("EDate")
                        Effective = rsTemp.fields("PDate")
                        PolicyNo = rsTemp.fields("PolicyNo")
                        CertificateNo = rsTemp.fields("CertificateNo")
                        M_TOC = rsTemp.fields("TOC")
                        M_PolicyType = rsTemp.fields("PolicyType")
                        If RefNo = "" Then
                            RefNo = rsTemp.fields("RefNo")
                        End If
                        MasterF = (toval(rsTemp.fields("ANO")) = toval(rsTemp.fields("LANO")))
                    Else
                        StrMsg = StrMsg & "Policy Data Not Found !" & vbCrLf
                    End If
                Else
                    StrMsg = StrMsg & "Policy Data Not Found !" & vbCrLf
                End If

                If StrMsg = "" Then

                    Dim DumpProfileF As Boolean = True
                    Dim CreateProfileF As Boolean = True

                    SQL = "SELECT top 1 MR.TOPRO, MR.Refno,Mr.PriorityF,MR.MapRefId,Mr.DumpProfileF,Mr.CreateProfileF,MR.InsuredF FROM Map_Reference MR inner join SysBatch" & MapGroup & " as t on (1=1) "
                    SQL = SQL & " where '" & Format(SDate, "MM/DD/YYYY") & "' between Mr.Sdate and Mr.Edate "
                    SQL = SQL & " and mr.MapCode='" & MapCode & "'"
                    SQL = SQL & " and mr.MapType='PolicyNo'"
                    SQL = SQL & " and mr.AllowedF=1"
                    SQL = SQL & " and T.BID=" & BID
                    If RefNoSQL <> "" Then
                        SQL = SQL & " and exists (" & RefNoSQL & ")"
                    End If
                    SQL = SQL & " order by MR.PriorityF desc,Mr.MapRefID,Mr.REFNO"
                    rsTemp = db.OpenRemoteSet(SQL)
                    If Not rsTemp.Eof Then
                        DumpProfileF = toval(rsTemp.fields("DumpProfileF"))
                        CreateProfileF = toval(rsTemp.fields("CreateProfileF"))
                    Else
                        If MapReferenceF Then
                            StrMsg = StrMsg & "Reference not found in table Map Reference !" & vbCrLf
                        End If
                    End If

                    rs = db.OpenRemoteSet("Select SysBatch.* from SysBatch" & MapGroup & " SysBatch Where BID=" & BID)
                    rs.Edit()
                    rs.fields("ANO") = ANO
                    rs.fields("DumpProfileF") = DumpProfileF
                    rs.fields("CreateProfileF") = CreateProfileF

                    If rs.fields("TOC") = "" Then
                        rs.fields("TOC") = TOC
                    End If

                    If rs.fields("PolicyNo") = "" Then
                        rs.fields("PolicyNo") = PolicyNo
                    End If

                    If rs.fields("CertificateNo") = "" Then
                        rs.fields("CertificateNo") = CertificateNo
                    End If

                    If rs.fields("RefNo") = "" Then
                        rs.fields("RefNo") = RefNo
                    End If

                    If tostr(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", FIndex)))) = "" Or Format(todate(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", FIndex)))), "MM/DD/YYYY") = "01/01/1900" Then
                        rs.fields("EFFECTIVE_DATE") = Effective
                    Else
                        rs.fields("EFFECTIVE_DATE") = todate(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", FIndex)))).Date
                    End If

                    If tostr(rs.fields("Expiry")) = "" Or Format(todate(rs.fields("Expiry")), "MM/DD/YYYY") = "01/01/1900" Then
                        rs.fields("Expiry") = EDate
                    End If
                    If tostr(rs.fields("Inception")) = "" Or Format(todate(rs.fields("Inception")), "MM/DD/YYYY") = "01/01/1900" Then
                        rs.fields("Inception") = SDate
                    End If
                    rs.fields("MasterF") = MasterF

                    Dim Inparam(7) As Object
                    Inparam(0) = False
                    Inparam(1) = rs.fields("Inception")
                    Inparam(2) = rs.fields("Expiry")
                    Inparam(3) = TOC
                    Inparam(6) = M_TOC
                    Inparam(7) = M_PolicyType

                    If Not Check_Entry_Object_BE(rs, Inparam, ErrMsg) Then
                        StrMsg = StrMsg & "Check Entry for Object Information : " & ErrMsg & vbCrLf
                    End If
                    If Not rs.Update Then Throw New Exception(rs.ErrDesc)

                    Dim rsBatch As RemoteSet
                    Dim FCount As Integer
                    Dim fIndex_1() As String
                    Dim FCount_1 As Integer

                    SQL = "Select S1.* "
                    rsBatch = db.OpenRemoteSet("Select * from sysBatch" & MapGroup & " Where 1<>1")
                    FIndex = rsBatch.fields_index
                    FCount = UBound(FIndex)

                    If SysBatchExtension >= 1 Then
                        rsBatch = db.OpenRemoteSet("Select * from sysBatch" & MapGroup & "_Ext Where 1<>1")
                        fIndex_1 = rsBatch.fields_index
                        FCount_1 = UBound(fIndex_1)

                        For i = 0 To rsBatch.fields_Count - 1
                            If GetFieldIndex(rsBatch.fields_Name(i), FIndex) >= FCount Then
                                SQL = SQL & ", S2.[" & rsBatch.fields_Name(i) & "]"
                            End If
                        Next
                    End If

                    If SysBatchExtension >= 2 Then
                        rsBatch = db.OpenRemoteSet("Select * from sysBatch" & MapGroup & "_Ext_1 Where 1<>1")
                        For i = 0 To rsBatch.fields_Count - 1
                            If GetFieldIndex(rsBatch.fields_Name(i), FIndex) >= FCount AndAlso GetFieldIndex(rsBatch.fields_Name(i), fIndex_1) >= FCount_1 Then
                                SQL = SQL & ", S3.[" & rsBatch.fields_Name(i) & "]"
                            End If
                        Next
                    End If

                    SQL = SQL & " from sysBatch" & MapGroup & " S1 "
                    SQL = SQL & " Left Join sysBatch" & MapGroup & "_Ext S2 on (S2.BID=S1.BID)"
                    SQL = SQL & " Left Join sysBatch" & MapGroup & "_Ext_1 S3 on (S3.BID=S1.BID)"
                    SQL = SQL & " Where S1.BID=" & BID
                    rsBatch = db.OpenRemoteSet(SQL)

                    If Not Check_Entry_BE(rsBatch, Inparam, ErrMsg) Then
                        StrMsg = StrMsg & "Check Entry : " & ErrMsg & vbCrLf
                    Else
                        If Not db.Execute("Update SysBatch Set Status='W' from SysBatch" & MapGroup & " SysBatch Where BID=" & BID) Then Throw New Exception(db.ErrDesc)
                    End If
                End If

            End If


            If StrMsg <> "" Then
                Return False
            Else
                Return True
            End If

        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try

    End Function
    Private Function Check_Entry_BE(ByVal rsBatch As RemoteSet, ByVal InParam As Object, ByRef ErrMsg As String, Optional ByVal AddCoverageCount As Integer = 70, Optional ByVal AddInterestCount As Integer = 30, Optional ByVal BusinessSourceCount As Integer = 25, Optional ByVal PayorDetCount As Integer = 25, Optional ByVal AddICoverDetCount As Integer = 18) As Boolean
        Dim Inception As Date = todate(InParam(1))
        Dim Expiry As Date = todate(InParam(2))
        Dim TOC As String = tostr(InParam(3))
        Dim M_TOC As String = tostr(InParam(6))
        Dim M_PolicyType As String = tostr(InParam(7))
        Dim rs As RemoteSet
        Dim PolicyNo As String
        Dim CertificateNo As String
        Dim Effective_Date As Date
        Dim Prorata As Double
        Dim Fee_ID As String
        Dim Duty_ID As String
        Dim Fee_Currency As String
        Dim Duty_Currency As String
        Dim App_Source As String
        Dim Reason As String
        Dim Wording As String
        Dim Branch As String
        Dim MSCode As String
        Dim Segment As String
        Dim NOREFUNDF As Integer
        Dim ENDORSEALLF As String
        Dim SQL As String
        Dim EMethod As String
        Dim ANO As Long
        Dim MasterF As Boolean
        Dim AType As String

        ErrMsg = ""
        Try
            ANO = toval(rsBatch.fields("ANO"))
            PolicyNo = tostr(rsBatch.fields("PolicyNo"))
            CertificateNo = tostr(rsBatch.fields("CertificateNo"))
            Effective_Date = todate(rsBatch.fields("Effective_Date")).Date
            AType = tostr(rsBatch.fields("AType"))
            If AType = "" Then AType = "E" ' Default Endorsement

            If AType = "E" Then
                App_Source = tostr(rsBatch.fields("App_Source"))
                NOREFUNDF = toval(rsBatch.fields("NoRefundF"))
                Prorata = toval(rsBatch.fields("Prorata"))
                Reason = tostr(rsBatch.fields("Reason"))
                Wording = tostr(rsBatch.fields("Wording"))
                Fee_Currency = tostr(rsBatch.fields("Fee_Currency"))
                Duty_Currency = tostr(rsBatch.fields("Duty_Currency"))
                Fee_ID = tostr(rsBatch.fields("Fee_ID"))
                Duty_ID = tostr(rsBatch.fields("Duty_ID"))
                ENDORSEALLF = toval(rsBatch.fields("EndorseAllF"))
                EMethod = tostr(rsBatch.fields("EMethod"))
                Branch = tostr(rsBatch.fields("Branch"))
                MSCode = tostr(rsBatch.fields("MSCode"))
                Segment = tostr(rsBatch.fields("Segment"))
                MasterF = toval(rsBatch.fields("MasterF"))

                ErrMsg = ""

                If tostr(Reason) <> "" Then
                    rs = db.OpenRemoteSet("Select top 1 Reason from Reason where Type='ENDORSEMENT' and REASON='" & Reason & "'")
                    If rs.Eof Then ErrMsg = ErrMsg & "Reason Code is not Found !" & vbCrLf
                End If

                If tostr(Wording) <> "" Then
                    rs = db.OpenRemoteSet("Select top 1 WordingID from Wording where AType='E' and WordingID='" & Wording & "'")
                    If rs.Eof Then ErrMsg = ErrMsg & "Wording Code is not Found !" & vbCrLf
                End If


                If Fee_ID <> "" Then
                    SQL = "Select top 1 F.FDID from FDTAB F "
                    If Fee_Currency <> "" Then
                        SQL = SQL & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Fee_Currency & "' AND CURRENCY.ALLOWEDF=1)"
                    End If
                    SQL = SQL & " Where F.ATYPE in ('E','ALL') and LEFT(F.FDType,1) = 'F' and F.FDID = '" & Fee_ID & "'"
                    rs = db.OpenRemoteSet(SQL)
                    If rs.Eof Then ErrMsg = ErrMsg & "FEE ID ('" & Fee_ID & "') Not Found !" & vbCrLf
                End If

                If Duty_ID <> "" Then
                    SQL = "Select top 1 F.FDID from FDTAB F "
                    If Duty_Currency <> "" Then
                        SQL = SQL & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Duty_Currency & "' AND CURRENCY.ALLOWEDF=1)"
                    End If
                    SQL = SQL & " Where F.ATYPE in ('E','ALL') and LEFT(F.FDType,1) = 'D' and F.FDID = '" & Duty_ID & "'"
                    rs = db.OpenRemoteSet(SQL)
                    If rs.Eof Then ErrMsg = ErrMsg & "Duty ID ('" & Duty_ID & "') Not Found !" & vbCrLf
                End If


                If tostr(rsBatch.fields("TOPRO")) <> "" Then
                    rs = db.OpenRemoteSet("Select top 1 TOPRO.TOPRO, TOC.TOC, COB.COB from TOPRO Left Join TOC on (TOC.TOC=TOPRO.TOC) Left Join COB on (COB.COB=TOPRO.TOC) Where TOPRO.TOPRO = '" & rsBatch.fields("TOPRO") & "'")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid TOPRO ID : " & rsBatch.fields("TOPRO") & " !" & vbCrLf
                    ElseIf UCase(rs.fields("TOC")) <> "" AndAlso UCase(rs.fields("TOC")) <> UCase(rsBatch.fields("TOC")) Then
                        ErrMsg = ErrMsg & "Invalid TOPRO ID : " & rsBatch.fields("TOPRO") & " for TOC : " & rsBatch.fields("TOC") & " !" & vbCrLf
                    ElseIf UCase(rs.fields("COB")) <> "" Then
                        rs = db.OpenRemoteSet("Select COB from TOC Where TOC='" & rsBatch.fields("TOC") & "' and COB='" & UCase(rs.fields("COB")) & "'")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid TOPRO ID : " & rsBatch.fields("TOPRO") & " for TOC : " & rsBatch.fields("TOC") & " !" & vbCrLf
                        End If
                    End If
                End If

                If Branch <> "" Then
                    rs = db.OpenRemoteSet("Select Branch from FL_UserBranch('" & db_user & "','" & Branch & "') B Where B.Branch='" & Branch & "'")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid Branch : " & Branch & " !" & vbCrLf
                    End If
                End If

                If MSCode <> "" Then
                    rs = db.OpenRemoteSet("Select MSCode from MSCode Where Post_Flag=1 and Branch in ('','" & Branch & "') and MSCode='" & MSCode & "'")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid MSCode : " & MSCode & " !" & vbCrLf
                    End If
                End If

                If InStr("1|2|3|6|7|8|9|10|11|12|13|14", tostr(toval(NOREFUNDF))) = 0 Then
                    ErrMsg = ErrMsg & "Incorrect No Refund Code !" & vbCrLf
                End If

                If Prorata < 0 Then
                    ErrMsg = ErrMsg & "Days Basis must be greater than or Equal to 0 !" & vbCrLf
                End If

                If tostr(App_Source) <> "" And tostr(App_Source) <> "UW" And tostr(App_Source) <> "MKT" And tostr(App_Source) <> "RI" Then
                    ErrMsg = ErrMsg & "Incorrect Endorsement Source (UW or MKT or RI) !" & vbCrLf
                End If

                Dim M_SDate As Date
                Dim M_EDate As Date
                Dim SType As String

                rs = db.OpenRemoteSet("Select Top 1 A.TOC, A.SDate, A.EDate, A.Branch, C.OpenFlag, C.ISType, C.MO, A.LANO, A.PDate, A.PPDate, A.AnnualTreatyF, R.PolicyTreatyF, R.RDate, R.NRDate from Acceptance A Inner Join Cover C on (C.CNO=A.CNO) Left Join RarrHeader R on (R.ANO=A.ANO) Where A.ANO = " & ANO)
                Dim LANO As Long = toval(rs.fields("LANO"))
                Dim MO As String = tostr(rs.fields("MO"))
                Dim AnnualTreatyF As Boolean = toval(rs.fields("AnnualTreatyF"))
                Dim OpenFlag As Boolean = toval(rs.fields("OpenFlag"))
                Dim PSDate As Date = rs.fields("SDate")
                Dim PEDate As Date = rs.fields("EDate")
                Dim SDate As Date = Inception
                Dim EDate As Date = Expiry
                Dim PolicyTreatyF As Boolean = toval(rs.fields("PolicyTreatyF"))
                 Dim RDate As Date = todate(rs.fields("RDate"))
                Dim NRDate As Date = todate(rs.fields("NRDate"))

                If Branch = "" Then Branch = tostr(rs.fields("Branch"))
                If LANO <> -1 Then
                    If OpenFlag Then
                        SType = "O"
                    Else
                        SType = "M"
                    End If
                Else
                    SType = "S"
                End If

                If tostr(rs.fields("ISType")) <> "I" And tostr(rs.fields("ISType")) <> "L" And tostr(rs.fields("ISType")) <> "C" And tostr(rs.fields("ISType")) <> "R" Then
                    ErrMsg = ErrMsg & "Only for Direct and Inward Reinsurance Policy !" & vbCrLf
                End If

                If DateDiff(DateInterval.Day, todate(rs.fields("PDate")), todate(Effective_Date)) < 0 Then
                    ErrMsg = ErrMsg & "Effective Date Can't be earlier than " & todate(rs.fields("Pdate")) & " !" & vbCrLf
                End If

                If ANO <> LANO Then
                    If SType = "M" Then
                        ' Check Master Policy
                        rs = db.OpenRemoteSet("Select Inception as SDate, Expiry as EDate from SysBatchBE S1 Where MasterF=1 and Status='W' and BatchNo='" & rsBatch.fields("BatchNo") & "' and PolicyNo='" & PolicyNo & "' and CertificateNo=''")
                        If rs.Eof Then
                            rs = db.OpenRemoteSet("Select top 1 SDate, EDate from Acceptance A where A.AStatus='W' and A.AType not in ('A','C') and A.PANO=" & LANO)
                            If rs.Eof Then
                                rs = db.OpenRemoteSet("Select top 1 SDate, EDate from Acceptance A where A.AStatus in ('I','W') and A.AType not in ('A','C') and A.ANO=" & LANO)
                                If rs.Eof Then
                                    ErrMsg = ErrMsg & "Process : 'Master Policy (" & PolicyNo & ")' is not Found !" & vbCrLf
                                End If
                            End If
                        End If
                        If Not rs.Eof Then
                            M_SDate = todate(rs.fields("SDate"))
                            M_EDate = todate(rs.fields("EDate"))

                            If DateDiff(DateInterval.Day, Inception, M_SDate) > 0 Then
                                ErrMsg = ErrMsg & "Insurance period cannot be earlier than " & Format(M_SDate, "dd-mmm-yyyy") & " !" & vbCrLf
                            End If
                            If DateDiff(DateInterval.Day, Expiry, M_EDate) < 0 Then
                                ErrMsg = ErrMsg & "Insurance period cannot be later than " & Format(M_EDate, "dd-mmm-yyyy") & " !" & vbCrLf
                            End If
                        End If
                    ElseIf SType = "O" Then
                        ' Check Master Policy
                        rs = db.OpenRemoteSet("Select top 1 SDate, EDate from Acceptance A where A.AStatus='I' and A.ANO=" & LANO)
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Process : 'Master Policy (" & PolicyNo & ")' is not Found !" & vbCrLf
                        End If

                        If Not rs.Eof Then
                            M_SDate = todate(rs.fields("SDate"))
                            M_EDate = todate(rs.fields("EDate"))

                            If DateDiff(DateInterval.Day, Inception, M_SDate) > 0 Then
                                ErrMsg = ErrMsg & "Inception Date cannot be earlier than " & Format(M_SDate, "dd-mmm-yyyy") & " !" & vbCrLf
                            End If
                            If DateDiff(DateInterval.Day, Inception, M_EDate) < 0 Then
                                ErrMsg = ErrMsg & "Inception Date cannot be later than " & Format(M_EDate, "dd-mmm-yyyy") & " !" & vbCrLf
                            End If
                        End If
                    End If
                End If

                If MasterF = False And (SType = "M" Or SType = "O") Then
                    rs = db.OpenRemoteSet("Select MultiTOCF from PolicyType Where PolicyType='" & M_PolicyType & "'")
                    If toval(rs.fields("MultiTOCF")) Then
                        rs = db.OpenRemoteSet("Select TOC.TOC from TOC, PTClass where TOC.AllowedF=1 and PTClass.PolicyType='" & M_PolicyType & "' and TOC.COB=PTClass.COB and TOC.TOC='" & UCase(rsBatch.fields("TOC")) & "'")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid TOC : " & UCase(rsBatch.fields("TOC"))
                        End If
                    ElseIf UCase(rsBatch.fields("TOC")) <> UCase(M_TOC) Then
                        ErrMsg = ErrMsg & "Invalid TOC : " & UCase(rsBatch.fields("TOC"))
                    End If
                End If

                If MasterF Or SType = "S" Then
                    If tostr(rsBatch.fields("Segment")) <> "" Then
                        rs = db.OpenRemoteSet("Select Segment From FN_UserSegment('" & MO & "') Segment Where AllowedF=1 and Segment='" & tostr(rsBatch.fields("Segment")) & "'")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid Segment : " & tostr(rsBatch.fields("Segment")) & " !" & vbCrLf
                        End If
                    End If
                End If

                If ANO = LANO Or SType = "S" Or SType = "O" Then
                    If tostr(rsBatch.fields("SysUserID")) <> "" Then
                        rs = db.OpenRemoteSet("Select ID from FL_Underwriter('" & Branch & "') S Where S.ID='" & rsBatch.fields("SysUserID") & "'")
                        If rs.Eof Then ErrMsg = ErrMsg & "Invalid Underwriter ID !" & vbCrLf
                    End If
                End If

                If tostr(rsBatch.fields("BankersID")) <> "" Then
                    rs = db.OpenRemoteSet("Select ID, Name from Profile Where ID='" & tostr(rsBatch.fields("BankersID")) & "'")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid Banker's ID !" & vbCrLf
                    End If
                    If tostr(rsBatch.fields("BankersClause")) = "" Then
                        rsBatch.fields("BankersClause") = rs.fields("Name")
                    End If
                End If

                If toval(rsBatch.fields("Premium")) <> 0 AndAlso (tostr(rsBatch.fields("PremiumDescription")).ToUpper = "MINIMUM PREMIUM" Or tostr(rsBatch.fields("PremiumDescription")).ToUpper = "POLICY MINIMUM PREMIUM") Then
                    ErrMsg = ErrMsg & "Invalid Premium Description ('MINIMUM PREMIUM','POLICY MINIMUM PREMIUM') !" & vbCrLf
                End If

                Dim Addcoverage(AddCoverageCount - 1) As String
                Dim Addunit(AddCoverageCount - 1) As String
                Dim Addrate(AddCoverageCount - 1) As Double

                Dim ADDINTERESTCODE(AddInterestCount - 1) As String
                Dim ADDCURRENCY(AddInterestCount - 1) As String
                Dim ADDINTERESTREMARK(AddInterestCount - 1) As String
                Dim ADDSUMINSURED(AddInterestCount - 1) As Double

                For i = 0 To AddCoverageCount - 1
                    Addcoverage(i) = tostr(rsBatch.fields("ADDCOVERAGE" & i + 1))
                    Addunit(i) = tostr(rsBatch.fields("ADDUNIT" & i + 1))
                    Addrate(i) = toval(rsBatch.fields("ADDRATE" & i + 1))

                    ' Check Coverage
                    If tostr(Addcoverage(i)) <> "" Then
                        rs = db.OpenRemoteSet("Select top 1 Code from ratetab where code='" & tostr(Addcoverage(i)) & "' and AllowedF=1")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid Additional Coverage " & i + 1 & " (Does not Exists / Not Allowed) !" & vbCrLf
                        End If
                        'ADD RATE
                        If toval(Addrate(i)) < 0 Then
                            ErrMsg = ErrMsg & "Invalid Additional Rate " & i + 1 & " !" & vbCrLf
                        End If

                        'ADD UNIT
                        If toval(Addrate(i)) <> 0 Then
                            If tostr(Addunit(i)) = "" Then
                                ErrMsg = ErrMsg & "Invalid Additional Unit" & i + 1 & " !" & vbCrLf
                            ElseIf tostr(Addunit(i)) <> "C" And tostr(Addunit(i)) <> "F" And tostr(Addunit(i)) <> "M" Then
                                ErrMsg = ErrMsg & "Invalid Unit Type For Additional Coverage " & i + 1 & " !" & vbCrLf
                            End If
                        End If
                    Else
                        ' Exit For
                    End If
                Next

                For i = 0 To AddInterestCount - 1
                    ADDINTERESTCODE(i) = tostr(rsBatch.fields("ADDINTERESTCODE" & i + 1))
                    ADDCURRENCY(i) = tostr(rsBatch.fields("ADDCURRENCY" & i + 1))
                    ADDINTERESTREMARK(i) = tostr(rsBatch.fields("ADDINTERESTREMARK" & i + 1))
                    ADDSUMINSURED(i) = toval(rsBatch.fields("ADDSUMINSURED" & i + 1))

                    ' Check Interest
                    If tostr(ADDINTERESTCODE(i)) <> "" Then
                        rs = db.OpenRemoteSet("Select top 1 TOI from TOI where TOI='" & tostr(ADDINTERESTCODE(i)) & "' and AllowedF=1")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid Additional Interest Code " & i + 1 & " (Does not Exists / Not Allowed) !" & vbCrLf
                        End If
                        'ADD INTEREST CURRENCY
                        If tostr(ADDCURRENCY(i)) <> "" Then
                            rs = db.OpenRemoteSet("SELECT CURRENCY FROM CURRENCY WHERE CURRENCY ='" & ADDCURRENCY(i) & "' OR DESCRIPTION ='" & ADDCURRENCY(i) & "'")
                            If rs.Eof Then ErrMsg = ErrMsg & "Invalid Additional Interest Currency " & i + 1 & " !" & vbCrLf

                            'ADD INTEREST REMARK
                            If tostr(ADDINTERESTREMARK(i)) = "" Then
                                ErrMsg = ErrMsg & "Invalid Additional Interest Remark " & i + 1 & " !" & vbCrLf
                            End If

                            'ADD INTEREST SUMINSURED
                            If tostr(ADDSUMINSURED(i)) = "" Then
                                ErrMsg = ErrMsg & "Invalid Additional Interest Sum Insured " & i + 1 & " !" & vbCrLf
                            Else
                                If Not IsNumeric(ADDSUMINSURED(i)) Then
                                    ErrMsg = ErrMsg & "Invalid Additional Interest Sum Insured " & i + 1 & " !" & vbCrLf
                                End If
                            End If
                        Else
                            'ADD INTEREST REMARK
                            If tostr(ADDINTERESTREMARK(i)) <> "" Then
                                ErrMsg = ErrMsg & "Invalid Additional Interest Remark (for Deletion) " & i + 1 & " !" & vbCrLf
                            End If

                            'ADD INTEREST SUMINSURED
                            If toval(ADDSUMINSURED(i)) <> 0 Then
                                ErrMsg = ErrMsg & "Invalid Additional Interest Sum Insured (for Deletion)" & i + 1 & " !" & vbCrLf
                            End If
                        End If
                    Else
                        ' Exit For
                    End If
                Next

                Dim DiscDetailType_(4) As String
                For X = 0 To 4
                    DiscDetailType_(X) = tostr(rsBatch.fields("DiscDetailType_" & X + 1))
                    If DiscDetailType_(X) <> "" Then
                        rs = db.OpenRemoteSet("Select DType from DType where DType = '" & DiscDetailType_(X) & "' and AllowedF = 1")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid Payor Detail Discount - ('" & DiscDetailType_(X) & "' !"
                        End If
                    End If
                Next

                If EMethod = "T" Then
                    Dim TShare As Double = 0

                    If MasterF = False Or SType = "S" Then
                        Dim DAnnualTreatyF As Boolean = AnnualTreatyF
                        If LANO <> -1 And OpenFlag Then
                            PolicyTreatyF = IIf(toval(rsBatch.fields("PolicyTreatyF")), True, False)
                        End If
                        If tostr(rsBatch.fields("AnnualTreatyF")) <> "" Then
                            AnnualTreatyF = toval(rsBatch.fields("AnnualTreatyF"))
                        End If

                        Dim ChangeOnRDateF As Boolean = False
                        Dim ChangeOnNRDateF As Boolean = False

                        If (tostr(rsBatch.fields("RDate")) <> "" AndAlso IsDate(rsBatch.fields("RDate")) AndAlso RDate <> todate(rsBatch.fields("RDate"))) Then
                            RDate = todate(rsBatch.fields("RDate"))
                            ChangeOnRDateF = True
                        End If
                        If (tostr(rsBatch.fields("NRDate")) <> "" AndAlso IsDate(rsBatch.fields("NRDate")) AndAlso NRDate <> todate(rsBatch.fields("NRDate"))) Then
                            NRDate = todate(rsBatch.fields("NRDate"))
                            ChangeOnNRDateF = True
                        End If

                        If AnnualTreatyF Then
                            If (OpenFlag And Not PolicyTreatyF) OrElse (SType = "S") Then
                                ' Check for Leap Year
                                If Month(DateSerial(Year(Effective_Date), Month(SDate), Day(SDate))) <> Month(SDate) Then
                                    RDate = DateAdd(DateInterval.Day, -1, DateSerial(Year(Effective_Date), Month(SDate), Day(SDate)))
                                Else
                                    RDate = DateSerial(Year(Effective_Date), Month(SDate), Day(SDate))
                                End If
                                If DateDiff(DateInterval.Day, Effective_Date, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)
                                If DateDiff(DateInterval.Day, Effective_Date, RDate) < 0 Then RDate = DateAdd(DateInterval.Month, 12, RDate)
                                If DateDiff(DateInterval.Day, Effective_Date, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)

                                If DateDiff(DateInterval.Day, SDate, RDate) < 0 Then RDate = SDate
                                NRDate = DateAdd(DateInterval.Month, 12, RDate)
                                If DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                            Else
                                ' Check for Leap Year
                                If Month(DateSerial(Year(Effective_Date), Month(M_SDate), Day(M_SDate))) <> Month(M_SDate) Then
                                    RDate = DateAdd(DateInterval.Day, -1, DateSerial(Year(Effective_Date), Month(M_SDate), Day(M_SDate)))
                                Else
                                    RDate = DateSerial(Year(Effective_Date), Month(M_SDate), Day(M_SDate))
                                End If
                                If DateDiff(DateInterval.Day, Effective_Date, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)
                                If DateDiff(DateInterval.Day, Effective_Date, RDate) < 0 Then RDate = DateAdd(DateInterval.Month, 12, RDate)
                                If DateDiff(DateInterval.Day, Effective_Date, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)

                                If DateDiff(DateInterval.Day, M_SDate, RDate) < 0 Then RDate = M_SDate
                                NRDate = DateAdd(DateInterval.Month, 12, RDate)
                                If DateDiff(DateInterval.Day, M_EDate, NRDate) > 0 Then NRDate = M_EDate
                            End If
                        Else
                            If DAnnualTreatyF <> AnnualTreatyF OrElse toval(rs.fields("PolicyTreatyF")) <> PolicyTreatyF OrElse ChangeOnRDateF OrElse ChangeOnNRDateF Then
                                If (OpenFlag And Not PolicyTreatyF) OrElse (SType = "S") Then
                                    If AType = "N" OrElse DateDiff(DateInterval.Day, PSDate, RDate) = 0 OrElse DateDiff(DateInterval.Day, SDate, RDate) < 0 Then RDate = SDate
                                    If DateDiff(DateInterval.Day, EDate, RDate) > 0 Then RDate = EDate

                                    If DateDiff(DateInterval.Day, SDate, NRDate) < 0 Then NRDate = SDate
                                    If DateDiff(DateInterval.Day, PEDate, NRDate) = 0 OrElse DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                                    If DateDiff(DateInterval.Day, RDate, NRDate) <= 0 Then
                                        RDate = SDate
                                        NRDate = EDate
                                    End If
                                Else
                                    If AType = "N" OrElse DateDiff(DateInterval.Day, M_SDate, RDate) = 0 OrElse DateDiff(DateInterval.Day, M_SDate, RDate) < 0 Then RDate = M_SDate
                                    If DateDiff(DateInterval.Day, M_EDate, RDate) > 0 Then RDate = M_EDate

                                    If DateDiff(DateInterval.Day, SDate, NRDate) < 0 Then NRDate = SDate
                                    If DateDiff(DateInterval.Day, PEDate, NRDate) = 0 OrElse DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                                    If DateDiff(DateInterval.Day, RDate, NRDate) <= 0 Then
                                        RDate = SDate
                                        NRDate = EDate
                                    End If
                                End If
                            End If
                        End If

                        Dim QID, AFID, SP1ID, SP2ID, SP3ID As String
                        Dim QShare, AFSHARE, SP1SHARE, SP2SHARE, SP3SHARE As Double

                        QID = tostr(rsBatch.fields("QID"))
                        QShare = toval(rsBatch.fields("QShare"))
                        SP1ID = tostr(rsBatch.fields("SP1ID"))
                        SP1SHARE = toval(rsBatch.fields("SP1Share"))
                        SP2ID = tostr(rsBatch.fields("SP2ID"))
                        SP2SHARE = toval(rsBatch.fields("SP2Share"))
                        SP3ID = tostr(rsBatch.fields("SP3ID"))
                        SP3SHARE = toval(rsBatch.fields("SP3Share"))
                        AFID = tostr(rsBatch.fields("AFID"))
                        AFSHARE = toval(rsBatch.fields("AFSHARE"))

                        If QID <> "" Then
                            rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(RDate, "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'Q' and R2.TOC = '" & TOC & "' and R1.RID = '" & QID & "'")
                            If rs.Eof Then ErrMsg = ErrMsg & "Invalid Quota Share ID !" & vbCrLf

                            If toval(QShare) < 0 Or toval(QShare) > 100 Then ErrMsg = ErrMsg & "Quota Share percentage must between 1 - 100 !" & vbCrLf
                            TShare = TShare + QShare
                        End If

                        If SP1ID <> "" Then
                            rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(RDate, "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'S1' and R2.TOC = '" & TOC & "' and R1.RID = '" & SP1ID & "'")
                            If rs.Eof Then ErrMsg = ErrMsg & "Invalid Surplus 1 ID !" & vbCrLf

                            If toval(SP1SHARE) < 0 Or toval(SP1SHARE) > 100 Then ErrMsg = ErrMsg & "Surplus 1 percentage must between 1 - 100 !" & vbCrLf
                            TShare = TShare + SP1SHARE
                        End If

                        If SP2ID <> "" Then
                            rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(RDate, "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'S2' and R2.TOC = '" & TOC & "' and R1.RID = '" & SP2ID & "'")
                            If rs.Eof Then ErrMsg = ErrMsg & "Invalid Surplus 2 ID !" & vbCrLf

                            If toval(SP2SHARE) < 0 Or toval(SP2SHARE) > 100 Then ErrMsg = ErrMsg & "Surplus 2 percentage must between 1 - 100 !" & vbCrLf
                            TShare = TShare + SP2SHARE
                        End If

                        If SP3ID <> "" Then
                            rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(RDate, "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'S3' and R2.TOC = '" & TOC & "' and R1.RID = '" & SP3ID & "'")
                            If rs.Eof Then ErrMsg = ErrMsg & "Invalid Surplus 3 ID !" & vbCrLf

                            If toval(SP2SHARE) < 0 Or toval(SP2SHARE) > 100 Then ErrMsg = ErrMsg & "Surplus 2 percentage must between 1 - 100 !" & vbCrLf
                            TShare = TShare + SP3SHARE
                        End If

                        If AFID <> "" Then
                            rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(RDate, "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'A' and R2.TOC = '" & TOC & "' and R1.RID = '" & AFID & "'")
                            If rs.Eof Then ErrMsg = ErrMsg & "Invalid Auto Facultative ID !" & vbCrLf

                            If toval(AFSHARE) < 0 Or toval(AFSHARE) > 100 Then ErrMsg = ErrMsg & "Auto Facultative Share percentage must between 1 - 100 !" & vbCrLf
                            TShare = TShare + AFSHARE
                        End If

                    End If

                    Dim FacOutID As String
                    Dim FacOutCurrency As String
                    Dim FacOutSysUserID As String
                    Dim FacOutShare As Double
                    Dim FullCoverF As Boolean
                    Dim FacOutSdate As Date
                    Dim FacOutEdate As Date
                    For i = 1 To 20
                        FullCoverF = True
                        FacOutID = tostr(rsBatch.fields("FacOut" & i & "ID"))
                        FacOutCurrency = tostr(rsBatch.fields("FacOut" & i & "CURRENCY"))
                        FacOutSysUserID = tostr(rsBatch.fields("FacOut" & i & "SysUserID"))
                        If tostr(rsBatch.fields("FacOut" & i & "SDate")) = "" Or Format(todate(rsBatch.fields("FacOut" & i & "SDate")).Date, "MM/DD/YYYY") = "01/01/1900" Then
                            FacOutSdate = Inception
                        Else
                            FacOutSdate = todate(rsBatch.fields("FacOut" & i & "SDate"))
                        End If

                        If tostr(rsBatch.fields("FacOut" & i & "EDate")) = "" Or Format(todate(rsBatch.fields("FacOut" & i & "EDate")).Date, "MM/DD/YYYY") = "01/01/1900" Then
                            FacOutEdate = Expiry
                        Else
                            FacOutEdate = todate(rsBatch.fields("FacOut" & i & "EDate"))
                        End If
                        If FacOutID <> "" Then
                            FacOutShare = toval(rsBatch.fields("FacOut" & i & "Share")) - toval(rsBatch.fields("FacOut" & i & "JPShare"))

                            rs = db.OpenRemoteSet("Select Top 1 ID from Profile Where DumpF=0 and (ID='" & FacOutID & "' or RefID='" & FacOutID & "')")
                            If rs.Eof Then ErrMsg = ErrMsg & "Invalid Facultative ID (" & FacOutID & ") !" & vbCrLf

                            If FacOutSysUserID <> "" Then
                                rs = db.OpenRemoteSet("Select Top 1 ID From FL_Underwriter('" & Branch & "') SysUser Where ID='" & FacOutSysUserID & "'")
                                If rs.Eof Then ErrMsg = ErrMsg & "Facultative Underwriter (" & FacOutSysUserID & ") Not Found !" & vbCrLf
                            End If

                            If FacOutCurrency <> "" Then
                                rs = db.OpenRemoteSet("Select Top 1 Currency from Currency Where AllowedF=1 and Currency='" & FacOutCurrency & "'")
                                If rs.Eof Then ErrMsg = ErrMsg & "Incorrect Currency (" & FacOutCurrency & ") !" & vbCrLf
                            End If

                            For y = 1 To 3
                                If tostr(rsBatch.fields("FacOutDet" & i & "Code" & y)) <> "" Then
                                    If tostr(rsBatch.fields("FacOutDet" & i & "Code" & y)).ToUpper = tostr(rsBatch.fields("MAINCOVERAGE")).ToUpper Then
                                        Exit For
                                    Else
                                        FullCoverF = False
                                    End If
                                End If
                            Next

                            If FacOutShare < 0 Or (FacOutShare <= 0 And Not MasterF) Then ErrMsg = ErrMsg & "Facultative " & i & " share percentage must between 1 - 100 !" & vbCrLf
                            If FacOutSdate < Inception Or FacOutEdate > Expiry OrElse FacOutSdate >= FacOutEdate Then
                                ErrMsg = ErrMsg & "Facultative " & i & " Invalid Facultative Period !" & vbCrLf
                            End If
                            If FullCoverF Then
                                TShare = TShare + FacOutShare
                            End If
                        Else
                            Exit For
                        End If
                    Next

                    If toval(TShare, 0) > 100 Then
                        ErrMsg = ErrMsg & "Total share percentage must be less than or equal to 100 % !" & vbCrLf
                    End If

                End If
            Else ' Adjustment
                Dim LANO As Long
                rs = db.OpenRemoteSet("Select A.LANO, A.OANO, SDate, EDate from Acceptance A Where A.ANO=" & ANO)
                LANO = toval(rs.fields("LANO"))

                If ANO <> LANO Then
                    Dim ICoverDetTOI As String
                    Dim SDate As Date
                    Dim EDate As Date
                    Dim OANO As Long
                    ICoverDetTOI = tostr(rsBatch.fields("ICoverDetTOI"))
                    OANO = rs.fields("OANO")
                    SDate = rs.fields("SDate")
                    EDate = rs.fields("EDate")

                    rs = db.OpenRemoteSet("Select Min(A1.PDate) as PDate from Acceptance A1 Where A1.PDate Between '" & Format(SDate, "MM/DD/YYYY") & "' and '" & Format(EDate, "MM/DD/YYYY") & "' and A1.AdjustableF=1 and A1.OANO=" & OANO)
                    SDate = todate(rs.fields("PDate"))

                    If ICoverDetTOI <> "" Then
                        rs = db.OpenRemoteSet("SELECT I.INO, I.TOI, I.RINO, I.Remark, TOI.AdjMethod FROM ICover I, TOI WHERE TOI.TOI=I.TOI and I.Adjustable=1 and I.ANO=" & ANO & " and I.TOI='" & ICoverDetTOI & "'")
                    Else
                        rs = db.OpenRemoteSet("SELECT I.INO, I.TOI, I.RINO, I.Remark, TOI.AdjMethod FROM ICover I, TOI WHERE TOI.TOI=I.TOI and I.Adjustable=1 and I.ANO=" & ANO)
                    End If
                    If rs.fields("AdjMethod") = "AVERAGE" Then
                        Dim MaxAmount As Double = toval(rs.fields("SI"))
                        Dim TOI As String = tostr(rs.fields("TOI"))
                        Dim RINO As Long = toval(rs.fields("RINO"))
                        Dim Remark As String = tostr(rs.fields("Remark"))
                        Dim TotalICoverDetAmount As Double = 0
                        Dim DPeriod As Integer = 0

                        Dim X As Integer = 0
                        Do While X <= AddICoverDetCount - 1
                            DPeriod = toval(rsBatch.fields("ICoverDetDPeriod" & X + 1))

                            Dim DDate As Date
                            DDate = Last_date_of_period(DateAdd(DateInterval.Month, DPeriod - 1, SDate), 1)
                            If DateDiff(DateInterval.Day, SDate, DDate) < 0 Then DDate = SDate
                            If DateDiff(DateInterval.Day, EDate, DDate) > 0 Then DDate = EDate

                            SQL = "Select top 1 A2.PDate, ICover.SI"
                            SQL = SQL & " from Acceptance A1, Acceptance a2, ICover"
                            SQL = SQL & " Where A1.ANO=" & ANO & " and A2.OANO=A1.OANO and A2.ANO<=A1.ANO and A2.AType not in ('A','C')"
                            SQL = SQL & " and ICover.ANO=A2.ANO and ICover.Adjustable=1 and ICover.TOI='" & TOI & "' and (ICover.Remark Like '" & Remark & "' and ICover.RINO=" & RINO & ")"
                            SQL = SQL & " and '" & Format(DDate, "MM/DD/YYYY") & "' between A2.PDate and A2.PPDate"
                            SQL = SQL & " order By A2.PDate, A2.ANO Desc"
                            rs = db.OpenRemoteSet(SQL)
                            MaxAmount = toval(rs.fields("SI"))

                            TotalICoverDetAmount = 0
                            Do While DPeriod = toval(rsBatch.fields("ICoverDetDPeriod" & X + 1)) AndAlso X <= AddICoverDetCount - 1
                                TotalICoverDetAmount = TotalICoverDetAmount + toval(rsBatch.fields("ICoverDetAmount" & X + 1))
                                X = X + 1
                            Loop
                            If MaxAmount <> 0 And MaxAmount < TotalICoverDetAmount Then
                                ErrMsg = ErrMsg & "Total Amount Can't be Greater than Declared Sum Insured !" & vbCrLf
                            End If
                        Loop
                    End If
                End If
            End If


            If ErrMsg <> "" Then
                Check_Entry_BE = False
            Else
                Check_Entry_BE = True
            End If
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function

    Private Function Check_Entry_Object_BE(ByVal rsBatch As RemoteSet, ByVal InParam As Object, ByRef ErrMsg As String, Optional ByVal AddCoverageCount As Integer = 70, Optional ByVal AddInterestCount As Integer = 30, Optional ByVal BusinessSourceCount As Integer = 25, Optional ByVal PayorDetCount As Integer = 25) As Boolean
        Dim TOC As String = tostr(InParam(3))

        Dim ANO As Long
        Dim Inception As Date
        Dim Expiry As Date

        Dim Segment As String
        Dim MasterF As Boolean
        Dim rs As RemoteSet

        ErrMsg = ""
        Try
            ANO = toval(rsBatch.fields("ANO"))
            Inception = todate(rsBatch.fields("Inception")).Date
            Expiry = todate(rsBatch.fields("Expiry")).Date
            MasterF = toval(rsBatch.fields("MasterF"))
            Segment = tostr(rsBatch.fields("Segment"))

            'Check Object Information
            Dim j As Integer
            Dim PFLDID As String = ""
            Dim PVALUEID As String = ""
            Dim FLDID As String = ""
            Dim VALUEID As String = ""
            Dim VALUEDESC As String = ""
            Dim DEFVALUEID As String = ""
            Dim SFLDID As String = ""
            Dim SVALUEID As String = ""
            Dim REGID As String = ""
            Dim RFLDID As String = tostr(rsBatch.fields("RFLDID"))
            Dim RVALUEID As String = tostr(rsBatch.fields("RVALUEID"))
            Dim IAccReg As Long = 0
            Dim ExclusiveF As Boolean

            Dim rsTOC As RemoteSet
            Dim rsAinfo As RemoteSet
            rsTOC = db.OpenQueryDef("QTOC_GENHTAB", adOpenForwardonly, TOC)
            If Not rsTOC.Eof Then
                rsAinfo = db.OpenRemoteSet("Select * from AInfo Where ANO=" & ANO)
                IAccReg = rsTOC.fields("IAccReg")
                REGID = rsTOC.fields("REGID")
                ExclusiveF = toval(rsTOC.fields("ExclusiveF"))
                For j = 1 To 15
                    FLDID = tostr(rsTOC.fields("FLDID" & j))
                    VALUEDESC = tostr(rsAinfo.fields("VALUEDESC" & j))
                    VALUEID = tostr(rsAinfo.fields("VALUEID" & j))

                    If Not toval(rsTOC.fields("FLDTAB" & j)) Then
                        If tostr(rsBatch.fields("DESCRIPTION" & j)) <> "" Then
                            VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                        Else
                            If tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00"))) <> "" Then
                                VALUEDESC = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                            End If
                        End If
                        VALUEID = ""
                    Else
                        If tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00"))) <> "" OrElse tostr(rsBatch.fields("DESCRIPTION" & j)) <> "" Then
                            VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                            VALUEID = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                        End If
                    End If

                    DEFVALUEID = ""

                    If InStr(VALUEID, Chr(16)) > 0 Then
                        DEFVALUEID = Left(VALUEID, InStr(VALUEID, Chr(16)) - 1)
                        VALUEID = Right(VALUEID, Len(VALUEID) - InStrRev(VALUEID, Chr(16)))
                    End If

                    If VALUEDESC = "" Then VALUEDESC = VALUEID

                    If FLDID <> "" Then
                        If toval(rsTOC.fields("FLDTAB" & j)) Then
                            If (VALUEID <> "" Or VALUEDESC <> "") Then
                                If j > 1 AndAlso toval(rsTOC.fields("SUBLINKF" & j)) Then
                                    rs = db.OpenRemoteSet("select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and (fldid" & j - 1 & "<>'" & PFLDID & "' or valueid" & j - 1 & "='' or valueid" & j - 1 & "='" & PVALUEID & "') and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                                Else
                                    rs = db.OpenRemoteSet("Select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                                End If
                                If Not rs.Eof Then
                                    If VALUEID = VALUEDESC Then VALUEDESC = tostr(rs.fields("DESCRIPTION"))
                                    VALUEID = tostr(rs.fields("ValueID"))
                                Else
                                    VALUEID = DEFVALUEID
                                End If
                            End If
                        Else
                            If VALUEDESC <> "" Then
                                VALUEID = Get_ValueID(FLDID, VALUEDESC, Inception, TOC, Segment)
                            Else
                                VALUEID = ""
                            End If
                        End If

                        If AccRegisterFlag(IAccReg, j) Then
                            Dim RISKLOCATIONREMARK As String
                            RISKLOCATIONREMARK = rsBatch.fields("RISKLOCATIONREMARK")

                            If RISKLOCATIONREMARK <> "" Then
                                VALUEDESC = RISKLOCATIONREMARK
                            End If

                           

                            If SFLDID = "" Then
                                SFLDID = FLDID
                            Else
                                SFLDID = SFLDID + "|" + FLDID
                            End If
                            If SVALUEID = "" Then
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    SVALUEID = VALUEID
                                Else
                                    SVALUEID = VALUEDESC
                                End If
                            Else
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    SVALUEID = SVALUEID + "|" + VALUEID
                                Else
                                    SVALUEID = SVALUEID + "|" + VALUEDESC
                                End If
                            End If
                        End If

                        If VALUEID = "" AndAlso VALUEDESC = "" Then
                            VALUEID = tostr(rsAinfo.fields("ValueID" & j))
                            VALUEDESC = tostr(rsAinfo.fields("ValueDesc" & j))
                        End If

                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = VALUEID
                        rsBatch.fields("DESCRIPTION" & j) = VALUEDESC

                        PFLDID = FLDID
                        PVALUEID = VALUEID
                    Else
                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = ""
                        rsBatch.fields("DESCRIPTION" & j) = ""
                    End If
                Next

                For j = 1 To 15
                    If rsTOC.fields("FLDID" & j) <> "" Then
                        ' Spread Info
                        If toval(rsTOC.fields("SpreadInfoF" & j)) AndAlso toval(rsTOC.fields("FLDTAB" & j)) AndAlso rsBatch.fields("OBJ_INFO_" & Format(j, "00")) <> "" Then
                            rs = db.OpenQueryDef("QSpreadInfo", adOpenForwardonly, rsTOC.fields("FLDID" & j), rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                            If Not rs.Eof Then
                                For i = j + 1 To 15
                                    If rsTOC.fields("FLDID" & i) <> "" Then
                                        If rsBatch.fields("OBJ_INFO_" & Format(i, "00")) = "" Then
                                            For k = 1 To 15
                                                If rs.fields("FLDID" & k) <> "" Then
                                                    If rsTOC.fields("FLDID" & i) = rs.fields("FLDID" & k) Then
                                                        rsBatch.fields("OBJ_INFO_" & Format(i, "00")) = rs.fields("VALUEID" & k)
                                                        If rsBatch.fields("DESCRIPTION" & i) = "" Then
                                                            rsBatch.fields("DESCRIPTION" & i) = rs.fields("VALUEDESC" & k)
                                                        End If
                                                        Exit For
                                                    End If
                                                Else
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                    Else
                                        Exit For
                                    End If
                                Next
                            End If
                        End If

                        If Not MasterF Then
                            If toval(rsTOC.fields("FLDCOM" & j)) Then
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    If rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = "" And (Not AccRegisterFlag(IAccReg, j) Or (RFLDID = "" Or RVALUEID = "" Or rsBatch.fields("DESCRIPTION" & j) = "")) Then
                                        ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsBatch.fields("DESCRIPTION" & j) & "', Please Check General Table For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                    End If
                                    If RFLDID <> "" And RVALUEID <> "" Then
                                        rs = db.OpenRemoteSet("Select FLDID, VALUEID from GendTab where AllowedF = 1 and FLDID = '" & RFLDID & "' and ValueID = '" & RVALUEID & "'")
                                        If rs.Eof Then ErrMsg = ErrMsg & "Incorrect ValueID for Generate Object Information ! " & vbCrLf
                                    End If
                                Else
                                    If rsBatch.fields("DESCRIPTION" & j) = "" Then
                                        ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                    End If
                                End If
                            End If
                        End If
                    Else
                        Exit For
                    End If
                Next
            Else
                ErrMsg = ErrMsg & "Invalid Type Of Cover !" & vbCrLf
            End If

            ' Extended Object Information
            rsTOC = db.OpenQueryDef("QTOC_EXT_GENHTAB", adOpenForwardonly, TOC)
            If Not rsTOC.Eof Then
                rsAinfo = db.OpenRemoteSet("Select * from AINFO_EXT Where ANO=" & ANO)
                For j = 16 To 30
                    FLDID = tostr(rsTOC.fields("FLDID" & j))
                    VALUEDESC = tostr(rsAinfo.fields("VALUEDESC" & j))
                    VALUEID = tostr(rsAinfo.fields("VALUEID" & j))

                    If Not toval(rsTOC.fields("FLDTAB" & j)) Then
                        If tostr(rsBatch.fields("DESCRIPTION" & j)) <> "" Then
                            VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                        Else
                            If tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00"))) <> "" Then
                                VALUEDESC = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                            End If
                        End If
                        VALUEID = ""
                    Else
                        If tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00"))) <> "" OrElse tostr(rsBatch.fields("DESCRIPTION" & j)) <> "" Then
                            VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                            VALUEID = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                        End If
                    End If

                    DEFVALUEID = ""

                    If InStr(VALUEID, Chr(16)) > 0 Then
                        DEFVALUEID = Left(VALUEID, InStr(VALUEID, Chr(16)) - 1)
                        VALUEID = Right(VALUEID, Len(VALUEID) - InStrRev(VALUEID, Chr(16)))
                    End If

                    If VALUEDESC = "" Then VALUEDESC = VALUEID

                    If FLDID <> "" Then
                        If (VALUEID <> "" Or VALUEDESC <> "") And toval(rsTOC.fields("FLDTAB" & j)) Then
                            If j > 1 AndAlso toval(rsTOC.fields("SUBLINKF" & j)) Then
                                rs = db.OpenRemoteSet("select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and (fldid" & j - 1 & "<>'" & PFLDID & "' or valueid" & j - 1 & "='' or valueid" & j - 1 & "='" & PVALUEID & "') and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                            Else
                                rs = db.OpenRemoteSet("Select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                            End If
                            If Not rs.Eof Then
                                If VALUEID = VALUEDESC Then VALUEDESC = tostr(rs.fields("DESCRIPTION"))
                                VALUEID = tostr(rs.fields("ValueID"))
                            Else
                                VALUEID = DEFVALUEID
                            End If
                        End If

                        If VALUEID = "" AndAlso VALUEDESC = "" Then
                            VALUEID = tostr(rsAinfo.fields("ValueID" & j))
                            VALUEDESC = tostr(rsAinfo.fields("ValueDesc" & j))
                        End If

                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = VALUEID
                        rsBatch.fields("DESCRIPTION" & j) = VALUEDESC

                        PFLDID = FLDID
                        PVALUEID = VALUEID

                        If Not MasterF Then
                            If toval(rsTOC.fields("FLDCOM" & j)) Then
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    If rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = "" Then
                                        ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsBatch.fields("DESCRIPTION" & j) & "', Please Check General Table For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                    End If
                                Else
                                    If rsBatch.fields("DESCRIPTION" & j) = "" Then
                                        ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                    End If
                                End If
                            End If
                        End If
                    Else
                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = ""
                        rsBatch.fields("DESCRIPTION" & j) = ""
                    End If
                Next
            End If

            If ErrMsg <> "" Then
                Check_Entry_Object_BE = False
            Else
                Check_Entry_Object_BE = True
            End If
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function Verify_BC(ByVal param As Object, ByVal FIndex() As String, ByVal FBuffer() As String) As Boolean

        Dim MapGroup As String = tostr(getInParamValue(param, 0))
        Dim dbUser As String = tostr(getInParamValue(param, 1))
        Dim MapCode As String = tostr(getInParamValue(param, 2))
        Dim BatchNo As String = tostr(getInParamValue(param, 3))
        Dim PartialF As Boolean = toval(getInParamValue(param, 4))
        Dim PDate As Date = todate(getInParamValue(param, 5))

        Try
            ' Record Identity
            Dim BID As Long = GetFieldValue(FBuffer(GetFieldIndex("BID", FIndex)))

            Dim FieldTo() As String = Nothing
            Dim FieldFrom() As String = Nothing
            Dim VariableT() As String = Nothing
            Dim CompulsoryF() As Boolean
            Dim SpaceF() As Boolean
            Dim UCaseF() As Boolean
            Dim MapValueF() As Boolean
            Dim DefValue() As String
            Dim Param1() As String
            Dim Param2() As String
            Dim Func() As String
            Dim StrictF() As Boolean
            Dim MatchLikeF() As Boolean
            Dim SQL As String
            Dim rs As RemoteSet

            SQL = "Select * from map_field where mapcode = '" & MapCode & "' order by orderno "
            rs = db.OpenRemoteSet(SQL)

            Dim Idx As Integer
            Dim Z As Integer
            Dim rsTemp As RemoteSet
            Z = rs.RecordCount

            ReDim FieldTo(Z)
            ReDim FieldFrom(Z)
            ReDim VariableT(Z)
            ReDim CompulsoryF(Z)
            ReDim SpaceF(Z)
            ReDim UCaseF(Z)
            ReDim MapValueF(Z)
            ReDim DefValue(Z)
            ReDim Param1(Z)
            ReDim Param2(Z)
            ReDim Func(Z)
            ReDim StrictF(Z)
            ReDim MatchLikeF(Z)

            Idx = 1
            Do While Not rs.Eof
                FieldTo(Idx) = tostr(rs.fields("FieldTo"))
                FieldFrom(Idx) = Trim(tostr(rs.fields("FieldFrom")))
                VariableT(Idx) = tostr(rs.fields("FieldType"))
                CompulsoryF(Idx) = rs.fields("CompulsoryF")
                SpaceF(Idx) = rs.fields("SpaceF")
                UCaseF(Idx) = rs.fields("UCaseF")
                DefValue(Idx) = tostr(rs.fields("DefaultValue"))
                Param1(Idx) = tostr(rs.fields("Param1"))
                Param2(Idx) = tostr(rs.fields("Param2"))
                Func(Idx) = tostr(rs.fields("Func"))
                StrictF(Idx) = toval(rs.fields("StrictF"))
                MatchLikeF(Idx) = toval(rs.fields("MatchLikeF"))
                MapValueF(Idx) = toval(rs.fields("MapValueF"))

                Idx = Idx + 1
                rs.MoveNext()
            Loop
            rs.CloseRemoteSet()

            Dim ErrMsg As String
            If Not InsertSysBatch(MapGroup, MapCode, BID, PDate, FieldTo, FieldFrom, VariableT, CompulsoryF, SpaceF, UCaseF, MapValueF, DefValue, Param1, Param2, Func, StrictF, MatchLikeF, FIndex, FBuffer, ErrMsg) Then
                StrMsg = StrMsg & "Insert SysBatch : " & ErrMsg & vbCrLf
            End If

            Dim ANO As Long = 0
            Dim PolicyNo As String = GetFieldValue(FBuffer(GetFieldIndex("PolicyNo", FIndex)))
            Dim CertificateNo As String = GetFieldValue(FBuffer(GetFieldIndex("CertificateNo", FIndex)))
            Dim OBJ_ID As String = GetFieldValue(FBuffer(GetFieldIndex("OBJ_ID", FIndex)))
            Dim RefNo As String = GetFieldValue(FBuffer(GetFieldIndex("RefNo", FIndex)))
            Dim TOC As String
            Dim SDate As Date
            Dim EDate As Date
            SQL = ""
            If PolicyNo <> "" Then
                If CertificateNo <> "" Then
                    SQL = SQL & " Select Top 1 A.ANO, A.AType, A.AStatus, A.Branch, A.PolicyNO, A.CertificateNo, A.PDate, A.SDate, A.EDate, A.TOC from Cover C, Acceptance A Where C.CNO=A.CNO and (A.ANO<>A.LANO or (C.OpenFlag=0 and A.ANO=A.LANO)) and A.AType in ('N','E','C') and A.PolicyNo='" & PolicyNo & "' and A.CertificateNo='" & CertificateNo & "' Order By A.ANO Desc"
                ElseIf OBJ_ID <> "" Then
                    SQL = SQL & " Select Top 1 A.ANO, A.AType, A.AStatus, A.Branch, A.PolicyNO, A.CertificateNo, A.PDate, A.SDate, A.EDate, A.TOC from Cover C, Acceptance A Where C.CNO=A.CNO and (A.ANO<>A.LANO or (C.OpenFlag=0 and A.ANO=A.LANO)) and A.AType in ('N','E','C') and A.PolicyNo='" & PolicyNo & "' and A.ValueID='" & OBJ_ID & "' Order By A.ANO Desc"
                ElseIf RefNo <> "" Then
                    SQL = SQL & " Select Top 1 A.ANO, A.AType, A.AStatus, A.Branch, A.PolicyNO, A.CertificateNo, A.PDate, A.SDate, A.EDate, A.TOC from Cover C, Acceptance A Where C.CNO=A.CNO and (A.ANO<>A.LANO or (C.OpenFlag=0 and A.ANO=A.LANO)) and A.AType in ('N','E','C') and A.PolicyNo='" & PolicyNo & "' and A.RefNo='" & RefNo & "' Order By A.ANO Desc"
                Else
                    SQL = SQL & " Select Top 1 A.ANO, A.AType, A.AStatus, A.Branch, A.PolicyNO, A.CertificateNo, A.PDate, A.SDate, A.EDate, A.TOC from Cover C, Acceptance A Where C.CNO=A.CNO and (A.ANO<>A.LANO or (C.OpenFlag=0 and A.ANO=A.LANO)) and A.AType in ('N','E','C') and A.PolicyNo='" & PolicyNo & "' and A.CertificateNo='" & CertificateNo & "' Order By A.ANO Desc"
                End If
            ElseIf RefNo <> "" Then
                SQL = SQL & " Select Top 1 A.ANO, A.AType, A.AStatus, A.Branch, A.PolicyNO, A.CertificateNo, A.PDate, A.SDate, A.EDate, A.TOC from Cover C, Acceptance A Where C.CNO=A.CNO and (A.ANO<>A.LANO or (C.OpenFlag=0 and A.ANO=A.LANO)) and A.AType in ('N','E','C') and A.RefNo='" & RefNo & "' Order By A.ANO Desc"
            End If
            If SQL <> "" Then
                rsTemp = db.OpenRemoteSet(SQL)
                If Not rsTemp.Eof AndAlso rsTemp.fields("AStatus") = "I" And (rsTemp.fields("AType") = "N" Or rsTemp.fields("AType") = "E") Then
                    ANO = rsTemp.fields("ANO")
                    TOC = rsTemp.fields("TOC")
                    SDate = rsTemp.fields("SDate")
                    EDate = rsTemp.fields("EDate")
                    PolicyNo = rsTemp.fields("PolicyNo")
                    CertificateNo = rsTemp.fields("CertificateNo")
                Else
                    If rsTemp.fields("AType") = "C" Then
                        If rsTemp.fields("AStatus") = "I" Then
                            StrMsg = StrMsg & "Policy Already Cancelled !" & vbCrLf
                        Else
                            StrMsg = StrMsg & "Policy being Cancelled !" & vbCrLf
                        End If
                    ElseIf rsTemp.fields("AStatus") = "C" Then
                        StrMsg = StrMsg & "Policy Already Expired !" & vbCrLf
                    ElseIf rsTemp.fields("AType") = "E" Then
                        StrMsg = StrMsg & "Policy being Endorsed !" & vbCrLf
                    Else
                        StrMsg = StrMsg & "Policy not yet inforced !" & vbCrLf
                    End If
                End If
            Else
                StrMsg = StrMsg & "Policy Data Not Found !" & vbCrLf
            End If

            If StrMsg = "" Then
                rs = db.OpenRemoteSet("Select SysBatch.* from SysBatch" & MapGroup & " SysBatch Where BID=" & BID)
                rs.Edit()
                rs.fields("ANO") = ANO

                If rs.fields("TOC") = "" Then
                    rs.fields("TOC") = TOC
                End If

                If rs.fields("PolicyNo") = "" Then
                    rs.fields("PolicyNo") = PolicyNo
                End If

                If rs.fields("CertificateNo") = "" Then
                    rs.fields("CertificateNo") = CertificateNo
                End If

                If tostr(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", FIndex)))) = "" Or Format(todate(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", FIndex)))), "MM/DD/YYYY") = "01/01/1900" Then
                    rs.fields("EFFECTIVE_DATE") = IIf(GetFieldValue(FBuffer(GetFieldIndex("CANCELTYPE", FIndex))) = "A", SDate, rsTemp.fields("PDate"))
                Else
                    rs.fields("EFFECTIVE_DATE") = todate(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", FIndex)))).Date
                End If
                If rs.fields("Branch") = "" Then
                    rs.fields("Branch") = rsTemp.fields("Branch")
                End If

                If tostr(rs.fields("Expiry")) = "" Or Format(todate(rs.fields("Expiry")), "MM/DD/YYYY") = "01/01/1900" Then
                    rs.fields("Expiry") = EDate
                End If
                If tostr(rs.fields("Inception")) = "" Or Format(todate(rs.fields("Inception")), "MM/DD/YYYY") = "01/01/1900" Then
                    rs.fields("Inception") = SDate
                End If

                Dim Inparam(3) As Object
                Inparam(0) = False
                Inparam(1) = SDate
                Inparam(2) = EDate
                Inparam(3) = TOC
                If Not Check_Entry_BC(rs, Inparam, ErrMsg) Then
                    StrMsg = StrMsg & "Check Entry : " & ErrMsg & vbCrLf
                End If

            End If

            If StrMsg <> "" Then
                Return False
            Else
                Return True
            End If

        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try

    End Function
    Private Function Check_Entry_BC(ByVal rsBatch As RemoteSet, ByVal InParam As Object, ByRef ErrMsg As String) As Boolean
        Dim rs As RemoteSet
        Dim PolicyNo As String
        Dim CertificateNo As String
        Dim Effective_Date As Date
        Dim Insured As String
        Dim Remarks As String
        Dim CancelType As String
        Dim Reason As String
        Dim Inception As Date
        Dim ANO As Long
        Dim CancelAllF As Boolean
        Dim CPCT As Double
        Dim Refund As Double

        Dim Fee_ID As String
        Dim Duty_ID As String
        Dim Fee_Currency As String
        Dim Duty_Currency As String

        ErrMsg = ""
        Try
            ANO = toval(rsBatch.fields("ANO"))
            Inception = todate(rsBatch.fields("INCEPTION")).Date
            PolicyNo = tostr(rsBatch.fields("PolicyNo"))
            CertificateNo = tostr(rsBatch.fields("CertificateNo"))
            Effective_Date = todate(rsBatch.fields("Effective_Date")).Date
            Insured = tostr(rsBatch.fields("Insured"))
            Remarks = toval(rsBatch.fields("Remarks"))
            Reason = tostr(rsBatch.fields("Reason"))
            CancelType = tostr(rsBatch.fields("CancelType"))
            CPCT = toval(rsBatch.fields("CPCT"))
            Refund = toval(rsBatch.fields("Refund"))
            Fee_Currency = tostr(rsBatch.fields("Fee_Currency"))
            Duty_Currency = tostr(rsBatch.fields("Duty_Currency"))
            Fee_ID = tostr(rsBatch.fields("Fee_ID"))
            Duty_ID = tostr(rsBatch.fields("Duty_ID"))

            ErrMsg = ""

            Select Case CancelType
                Case "A"
                    CancelAllF = True
                Case Else
                    CancelAllF = False
            End Select

            If Not CancelAllF Then
                Dim SQL As String
                If Fee_ID <> "" Then
                    Sql = "Select top 1 F.FDID from FDTAB F "
                    If Fee_Currency <> "" Then
                        Sql = Sql & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Fee_Currency & "' AND CURRENCY.ALLOWEDF=1)"
                    End If
                    SQL = SQL & " Where F.ATYPE in ('C','ALL') and LEFT(F.FDType,1) = 'F' and F.FDID = '" & Fee_ID & "'"
                    rs = db.OpenRemoteSet(Sql)
                    If rs.Eof Then ErrMsg = ErrMsg & "FEE ID ('" & Fee_ID & "') Not Found !" & vbCrLf
                End If

                If Duty_ID <> "" Then
                    Sql = "Select top 1 F.FDID from FDTAB F "
                    If Duty_Currency <> "" Then
                        Sql = Sql & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Duty_Currency & "' AND CURRENCY.ALLOWEDF=1)"
                    End If
                    SQL = SQL & " Where F.ATYPE in ('C','ALL') and LEFT(F.FDType,1) = 'D' and F.FDID = '" & Duty_ID & "'"
                    rs = db.OpenRemoteSet(Sql)
                    If rs.Eof Then ErrMsg = ErrMsg & "Duty ID ('" & Duty_ID & "') Not Found !" & vbCrLf
                End If
            End If

            If tostr(Remarks) = "" And tostr(Reason) = "" Then
                ErrMsg = ErrMsg & "Reason or Remarks must be filled !" & vbCrLf
            End If

            If CPCT < 0 OrElse CPCT > 100 Then
                ErrMsg = ErrMsg & "Prorata Cancellation must be greater than or equal to 0 and less than or equal to 100 !" & vbCrLf
            End If

            rs = db.OpenRemoteSet("Select top 1 Reason from Reason where Type='CANCELLATION' and REASON='" & Reason & "'")
            If rs.Eof Then ErrMsg = ErrMsg & "Reason Code is Not Found !" & vbCrLf

            rs = db.OpenRemoteSet("Select Top 1 C.OpenFlag, C.ISType, R.FShare, R.RDate, R.NRDate, A.LANO, A.ANO, A.PDate, A.PPDate from Cover C, Acceptance A, Rarrheader R Where C.CNO=A.CNO and R.ANO=A.ANO and A.ANO = " & ANO)
            If Not rs.Eof Then
                If tostr(rs.fields("ISType")) <> "I" And tostr(rs.fields("ISType")) <> "L" And tostr(rs.fields("ISType")) <> "C" And tostr(rs.fields("ISType")) <> "R" Then
                    ErrMsg = ErrMsg & "Only for Direct and Inward Reinsurance Policy !" & vbCrLf
                End If

                If Not CancelAllF Then
                    If DateDiff(DateInterval.Day, todate(rs.fields("PDate")), todate(Effective_Date)) < 0 Then
                        ErrMsg = ErrMsg & "Effective Date Can't be earlier than " & todate(rs.fields("Pdate")) & " !" & vbCrLf
                    End If

                    If DateDiff(DateInterval.Day, todate(rs.fields("PPDate")), todate(Effective_Date)) > 0 Then
                        ErrMsg = ErrMsg & "Effective Date Can't be greater than " & todate(rs.fields("PPdate")) & " !" & vbCrLf
                    End If

                    If DateDiff(DateInterval.Day, todate(rs.fields("RDate")), Effective_Date) < 0 Or DateDiff(DateInterval.Day, todate(rs.fields("NRDate")), Effective_Date) > 0 Then
                        ErrMsg = ErrMsg & "Effective Date Should Be Between Treaty Period On " & Format(todate(rs.fields("RDate")), "d") & " - " & Format(todate(rs.fields("NRDate")), "d") & " !" & vbCrLf
                    End If
                End If

            End If

            If CPCT = 0 And Refund <> 0 Then
                CPCT = Cancellation_Prorata_By_Refund(ANO, Effective_Date, Refund)
                If CPCT = 0 Then
                    ErrMsg = ErrMsg & "Incorrect Refund Premium Amount, Please Check Effective Date On " & Format(Effective_Date, "d") & " !" & vbCrLf
                End If
            End If

            If ErrMsg <> "" Then
                Check_Entry_BC = False
            Else
                rsBatch.fields("Status") = "W"
                If Not rsBatch.Update Then Throw New Exception(rsBatch.ErrDesc)
                Check_Entry_BC = True
            End If

        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function

    Private Function Verify_UP(ByVal param As Object, ByVal FIndex() As String, ByVal FBuffer() As String) As Boolean

        Dim MapGroup As String = tostr(getInParamValue(param, 0))
        Dim dbUser As String = tostr(getInParamValue(param, 1))
        Dim MapCode As String = tostr(getInParamValue(param, 2))
        Dim BatchNo As String = tostr(getInParamValue(param, 3))
        Dim PartialF As Boolean = toval(getInParamValue(param, 4))
        Dim PDate As Date = todate(getInParamValue(param, 5))

        Try
            ' Record Identity
            Dim BID As Long = GetFieldValue(FBuffer(GetFieldIndex("BID", FIndex)))

            Dim FieldTo() As String = Nothing
            Dim FieldFrom() As String = Nothing
            Dim VariableT() As String = Nothing
            Dim CompulsoryF() As Boolean
            Dim SpaceF() As Boolean
            Dim UCaseF() As Boolean
            Dim MapValueF() As Boolean
            Dim DefValue() As String
            Dim Param1() As String
            Dim Param2() As String
            Dim Func() As String
            Dim StrictF() As Boolean
            Dim MatchLikeF() As Boolean
            Dim SQL As String
            Dim rs As RemoteSet
            Dim MapReferenceF As Boolean
            Dim SysBatchExtension As Integer = toval(GetAppSetting("SysBatchExtension"))
            If SysBatchExtension = 0 Then SysBatchExtension = 1

            SQL = "Select M1.MapReferenceF from map_Header M1 where M1.MapCode='" & MapCode & "'"
            rs = db.OpenRemoteSet(SQL)
            MapReferenceF = toval(rs.fields("MapReferenceF"))

            SQL = "Select M2.* from map_field M2 where M2.MapCode='" & MapCode & "' order by M2.orderno "
            rs = db.OpenRemoteSet(SQL)

            Dim Idx As Integer
            Dim Z As Integer
            Dim rsTemp As RemoteSet
            Z = rs.RecordCount

            ReDim FieldTo(Z)
            ReDim FieldFrom(Z)
            ReDim VariableT(Z)
            ReDim CompulsoryF(Z)
            ReDim SpaceF(Z)
            ReDim UCaseF(Z)
            ReDim MapValueF(Z)
            ReDim DefValue(Z)
            ReDim Param1(Z)
            ReDim Param2(Z)
            ReDim Func(Z)
            ReDim StrictF(Z)
            ReDim MatchLikeF(Z)

            Dim RefNoSQL As String = ""
            Idx = 1
            Do While Not rs.Eof
                FieldTo(Idx) = tostr(rs.fields("FieldTo"))
                FieldFrom(Idx) = Trim(tostr(rs.fields("FieldFrom")))
                VariableT(Idx) = tostr(rs.fields("FieldType"))
                CompulsoryF(Idx) = rs.fields("CompulsoryF")
                SpaceF(Idx) = rs.fields("SpaceF")
                UCaseF(Idx) = rs.fields("UCaseF")
                DefValue(Idx) = tostr(rs.fields("DefaultValue"))
                Param1(Idx) = tostr(rs.fields("Param1"))
                Param2(Idx) = tostr(rs.fields("Param2"))
                Func(Idx) = tostr(rs.fields("Func"))
                StrictF(Idx) = toval(rs.fields("StrictF"))
                MatchLikeF(Idx) = toval(rs.fields("MatchLikeF"))
                MapValueF(Idx) = toval(rs.fields("MapValueF"))

                Idx = Idx + 1
                rs.MoveNext()
            Loop
            rs.CloseRemoteSet()

            Dim M_TOC As String = ""
            Dim M_PolicyType As String = ""
            Dim TOC As String = GetFieldValue(FBuffer(GetFieldIndex("TOC", FIndex)))
            Dim TOPRO As String = GetFieldValue(FBuffer(GetFieldIndex("TOPRO", FIndex)))
            Dim PolicyNo As String = GetFieldValue(FBuffer(GetFieldIndex("PolicyNo", FIndex)))
            Dim RegNo As String = GetFieldValue(FBuffer(GetFieldIndex("RegNo", FIndex)))
            Dim SType As String = GetFieldValue(FBuffer(GetFieldIndex("SType", FIndex)))
            Dim TType As String = GetFieldValue(FBuffer(GetFieldIndex("TType", FIndex)))
            Dim SDate As Date = todate(GetFieldValue(FBuffer(GetFieldIndex("Inception", FIndex))))
            Dim EDate As Date = todate(GetFieldValue(FBuffer(GetFieldIndex("Expiry", FIndex))))
            Dim RefDate As Date = todate(GetFieldValue(FBuffer(GetFieldIndex("RefDate", FIndex))))
            Dim MasterF As Boolean = toval(GetFieldValue(FBuffer(GetFieldIndex("MasterF", FIndex))))
            Dim Segment As String = GetFieldValue(FBuffer(GetFieldIndex("Segment", FIndex)))
            Dim QuotationF As Boolean = toval(GetFieldValue(FBuffer(GetFieldIndex("QuotationF", FIndex))))

            If SType = "O" And Not MasterF Then
                RefNoSQL = RefNoSQL + SQLBuilder(MapCode, PDate, "PolicyNo")
            ElseIf SType = "M" And Not MasterF Then
                RefNoSQL = RefNoSQL + SQLBuilder(MapCode, PDate, "CINo")
            Else
                RefNoSQL = RefNoSQL + SQLBuilder(MapCode, PDate, "General")
            End If

            Dim ErrMsg As String = ""
            If Not InsertSysBatch(MapGroup, MapCode, BID, PDate, FieldTo, FieldFrom, VariableT, CompulsoryF, SpaceF, UCaseF, MapValueF, DefValue, Param1, Param2, Func, StrictF, MatchLikeF, FIndex, FBuffer, ErrMsg) Then
                StrMsg = StrMsg & "Insert SysBatch : " & ErrMsg & vbCrLf
            End If

            Dim DumpProfileF As Boolean = True
            Dim CreateProfileF As Boolean = True
            Dim InsuredF As Boolean = True
            Dim DuplicateF As Byte = 1

            If SType = "O" And Not MasterF Then
                SQL = "SELECT top 1 MR.TOPRO, MR.Refno,Mr.PriorityF,MR.MapRefId,Mr.DumpProfileF,Mr.CreateProfileF,MR.InsuredF,Mr.DuplicateF FROM Map_Reference MR inner join SysBatch" & MapGroup & " as t on (1=1) "
                SQL = SQL & " where t.Inception between Mr.Sdate and Mr.Edate "
                SQL = SQL & " and mr.MapCode='" & MapCode & "'"
                SQL = SQL & " and mr.MapType='PolicyNo'"
                SQL = SQL & " and mr.AllowedF=1"
                SQL = SQL & " and T.BID=" & BID
                If RefNoSQL <> "" Then
                    SQL = SQL & " and exists (" & RefNoSQL & ")"
                End If
                SQL = SQL & " order by MR.PriorityF desc,Mr.MapRefID,Mr.REFNO"
                rsTemp = db.OpenRemoteSet(SQL)
                If Not rsTemp.Eof Then
                    If PolicyNo = "" Then PolicyNo = tostr(rsTemp.fields("RefNo")) ' Master Policy
                    If TOPRO = "" Then TOPRO = tostr(rsTemp.fields("TOPRO")) ' Type Of Product From Map Reference
                    DumpProfileF = toval(rsTemp.fields("DumpProfileF"))
                    CreateProfileF = toval(rsTemp.fields("CreateProfileF"))
                    InsuredF = toval(rsTemp.fields("InsuredF"))
                    DuplicateF = toval(rsTemp.fields("DuplicateF"))
                Else
                    If MapReferenceF Then
                        StrMsg = StrMsg & "Reference not found in table Map Reference !" & vbCrLf
                    End If
                End If
            ElseIf SType = "M" And Not MasterF Then
                SQL = "SELECT top 1 MR.TOPRO, MR.Refno,Mr.PriorityF,MR.MapRefId,Mr.DumpProfileF,Mr.CreateProfileF,MR.InsuredF,Mr.DuplicateF FROM Map_Reference MR inner join SysBatch" & MapGroup & " as t on (1=1) "
                SQL = SQL & " where t.Inception between Mr.Sdate and Mr.Edate "
                SQL = SQL & " and mr.MapCode='" & MapCode & "'"
                SQL = SQL & " and mr.MapType='CINo'"
                SQL = SQL & " and mr.AllowedF=1"
                SQL = SQL & " and T.BID=" & BID
                If RefNoSQL <> "" Then
                    SQL = SQL & " and exists (" & RefNoSQL & ")"
                End If
                SQL = SQL & " order by MR.PriorityF desc,Mr.MapRefID,Mr.REFNO"
                rsTemp = db.OpenRemoteSet(SQL)
                If Not rsTemp.Eof Then
                    If RegNo = "" Then RegNo = tostr(rsTemp.fields("RefNo")) ' Master CI NO
                    If TOPRO = "" Then TOPRO = tostr(rsTemp.fields("TOPRO")) ' Type Of Product From Map Reference
                    DumpProfileF = toval(rsTemp.fields("DumpProfileF"))
                    CreateProfileF = toval(rsTemp.fields("CreateProfileF"))
                    InsuredF = toval(rsTemp.fields("InsuredF"))
                    DuplicateF = toval(rsTemp.fields("DuplicateF"))
                Else
                    If MapReferenceF Then
                        StrMsg = StrMsg & "Reference not found in table Map Reference !" & vbCrLf
                    End If
                End If
            Else
                SQL = "SELECT top 1 MR.TOPRO, MR.Refno,Mr.PriorityF,MR.MapRefId,Mr.DumpProfileF,Mr.CreateProfileF,MR.InsuredF,Mr.DuplicateF FROM Map_Reference MR inner join SysBatch" & MapGroup & " as t on (1=1) "
                SQL = SQL & " where t.Inception between Mr.Sdate and Mr.Edate "
                SQL = SQL & " and mr.MapCode='" & MapCode & "'"
                SQL = SQL & " and mr.MapType='General'"
                SQL = SQL & " and mr.AllowedF=1"
                SQL = SQL & " and T.BID=" & BID
                If RefNoSQL <> "" Then
                    SQL = SQL & " and exists (" & RefNoSQL & ")"
                End If
                SQL = SQL & " order by MR.PriorityF desc,Mr.MapRefID,Mr.REFNO"
                rsTemp = db.OpenRemoteSet(SQL)
                If Not rsTemp.Eof Then
                    If PolicyNo = "" Then PolicyNo = tostr(rsTemp.fields("RefNo")) ' Template Policy
                    If TOPRO = "" Then TOPRO = tostr(rsTemp.fields("TOPRO")) ' Type Of Product From Map Reference
                    DumpProfileF = toval(rsTemp.fields("DumpProfileF"))
                    CreateProfileF = toval(rsTemp.fields("CreateProfileF"))
                    InsuredF = toval(rsTemp.fields("InsuredF"))
                    DuplicateF = toval(rsTemp.fields("DuplicateF"))
                Else
                    If MapReferenceF Then
                        StrMsg = StrMsg & "Reference not found in table Map Reference !" & vbCrLf
                    End If
                End If
            End If

            Dim ANO As Long = -1
            Dim OpenFlag As Boolean = False
            Dim Branch As String = ""
            SQL = ""
            If (MasterF = False AndAlso SType <> "S") Or (MasterF = True AndAlso SType = "M" AndAlso TType = "R") Then
                ' Check Master Policy
                If TType <> "R" Then
                    If PolicyNo <> "" Then
                        SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment, C.PolicyType from Acceptance A,Cover C where A.AType not in ('A','C') and A.Policyno = '" & PolicyNo & "' and ((A.AStatus='I' and C.openFlag=1) or (A.Astatus in ('W','I') and C.openFlag=0)) and A.ANO = A.LANO and A.CNO = C.CNO Order By A.ANO Desc"
                    ElseIf RegNo <> "" Then
                        SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment, C.PolicyType from Acceptance A,Cover C where A.AType not in ('A','C') and A.RegNo='" & RegNo & "' and ((A.AStatus='I' and C.openFlag=1) or (A.Astatus in ('W','I') and C.openFlag=0)) and A.ANO = A.LANO and A.CNO = C.CNO Order By A.ANO Desc"
                    End If
                Else    ' Renewal only for Master Policy
                    If SType = "M" Then
                        If MasterF = True Then
                            If PolicyNo <> "" Then
                                SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment, C.PolicyType from Acceptance A,Cover C where A.AType not in ('A','C') and A.Policyno = '" & PolicyNo & "' and ((A.Astatus in ('I') and C.openFlag=0)) and A.ANO = A.LANO and A.CNO = C.CNO Order By A.ANO Desc"
                            ElseIf RegNo <> "" Then
                                SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment, C.PolicyType from Acceptance A,Cover C where A.AType not in ('A','C') and A.RegNo='" & RegNo & "' and ((A.Astatus in ('I') and C.openFlag=0)) and A.ANO = A.LANO and A.CNO = C.CNO Order By A.ANO Desc"
                            End If
                        Else
                            If PolicyNo <> "" Then
                                SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment, C.PolicyType from Acceptance A,Cover C where A.AType not in ('A','C') and A.Policyno = '" & PolicyNo & "' and ((A.Astatus in ('W') and C.openFlag=0)) and A.ANO = A.LANO and A.CNO = C.CNO Order By A.ANO Desc"
                            ElseIf RegNo <> "" Then
                                SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment, C.PolicyType from Acceptance A,Cover C where A.AType not in ('A','C') and A.RegNo='" & RegNo & "' and ((A.Astatus in ('W') and C.openFlag=0)) and A.ANO = A.LANO and A.CNO = C.CNO Order By A.ANO Desc"
                            End If
                        End If
                    ElseIf SType = "O" Then
                        If PolicyNo <> "" Then
                            SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment, C.PolicyType from Acceptance A,Cover C where A.AType not in ('A','C') and A.Policyno = '" & PolicyNo & "' and ((A.Astatus in ('I') and C.openFlag=1)) and A.ANO = A.LANO and A.CNO = C.CNO Order By A.ANO Desc"
                        ElseIf RegNo <> "" Then
                            SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment, C.PolicyType from Acceptance A,Cover C where A.AType not in ('A','C') and A.RegNo='" & RegNo & "' and ((A.Astatus in ('I') and C.openFlag=1)) and A.ANO = A.LANO and A.CNO = C.CNO Order By A.ANO Desc"
                        End If
                    End If
                End If

                If SQL <> "" Then
                    rsTemp = db.OpenRemoteSet(SQL)
                    If Not rsTemp.Eof Then
                        ANO = rsTemp.fields("ANO")
                        Branch = rsTemp.fields("Branch")
                        M_TOC = rsTemp.fields("TOC")
                        M_PolicyType = rsTemp.fields("PolicyType")
                        If TOC = "" Then TOC = rsTemp.fields("TOC")
                        If MasterF = False Then
                            SDate = rsTemp.fields("SDate")
                            EDate = rsTemp.fields("EDate")
                            RefDate = rsTemp.fields("RefDate")
                        End If
                        PolicyNo = rsTemp.fields("PolicyNo")
                        RegNo = rsTemp.fields("RegNo")
                        OpenFlag = rsTemp.fields("OpenFlag")
                        Segment = rsTemp.fields("Segment")
                        If SType = "" Then
                            If OpenFlag Then
                                SType = "O"
                            Else
                                SType = "M"
                            End If
                        End If
                    Else
                        SQL = ""
                        If PolicyNo <> "" Then
                            SQL = "Select TOC, Segment, Inception, Expiry, RefDate, PolicyType from SysBatchUp S1 Where MasterF=1 and SType='M' and Status='W' and BatchNo='" & BatchNo & "' and PolicyNo='" & PolicyNo & "'"
                        ElseIf RegNo <> "" Then
                            SQL = "Select TOC, Segment, Inception, Expiry, RefDate, PolicyType from SysBatchUp S1 Where MasterF=1 and SType='M' and Status='W' and BatchNo='" & BatchNo & "' and RegNo='" & RegNo & "'"
                        End If
                        If SQL <> "" AndAlso SType = "M" Then
                            rsTemp = db.OpenRemoteSet(SQL)
                            If Not rsTemp.Eof Then
                                Branch = rsTemp.fields("Branch")
                                M_TOC = rsTemp.fields("TOC")
                                M_PolicyType = rsTemp.fields("PolicyType")
                                If TOC = "" Then TOC = rsTemp.fields("TOC")
                                SDate = rsTemp.fields("Inception")
                                EDate = rsTemp.fields("Expiry")
                                RefDate = rsTemp.fields("RefDate")
                                OpenFlag = False
                                Segment = rsTemp.fields("Segment")
                            Else
                                StrMsg = StrMsg & "Master Policy Data Not Found (Policy No. " & PolicyNo & " or Reg No. " & RegNo & ") !" & vbCrLf
                            End If
                        Else
                            StrMsg = StrMsg & "Master Policy Data Not Found (Policy No. " & PolicyNo & " or Reg No. " & RegNo & ") !" & vbCrLf
                        End If
                    End If
                Else
                    If SType = "" Then
                        SType = "S"
                    Else
                        StrMsg = StrMsg & "Master Policy Data Not Found !" & vbCrLf
                    End If
                End If
            ElseIf (SType = "S" AndAlso TType = "R") Then
                ' Check Policy
                If PolicyNo <> "" Then
                    SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment from Acceptance A,Cover C where A.AType not in ('A','C') and A.Policyno = '" & PolicyNo & "' and A.Astatus in ('I') and A.LANO=-1 and A.CNO = C.CNO Order By A.ANO Desc"
                ElseIf RegNo <> "" Then
                    SQL = "Select Top 1 A.ANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RegNo, A.SDate, A.EDate, A.RefDate, A.TOC, C.OpenFlag, C.Segment from Acceptance A,Cover C where A.AType not in ('A','C') and A.RegNo = '" & RegNo & "' and A.Astatus in ('I') and A.LANO=-1 and A.CNO = C.CNO Order By A.ANO Desc"
                End If

                If SQL <> "" Then
                    rsTemp = db.OpenRemoteSet(SQL)
                    If Not rsTemp.Eof Then
                        ANO = rsTemp.fields("ANO")
                        Branch = rsTemp.fields("Branch")
                        If TOC = "" Then TOC = rsTemp.fields("TOC")
                        SDate = rsTemp.fields("SDate")
                        EDate = rsTemp.fields("EDate")
                        RefDate = rsTemp.fields("RefDate")
                        PolicyNo = rsTemp.fields("PolicyNo")
                        RegNo = rsTemp.fields("RegNo")
                        OpenFlag = rsTemp.fields("OpenFlag")
                        Segment = rsTemp.fields("Segment")
                    Else
                        StrMsg = StrMsg & "Policy Data Not Found (Policy No. " & PolicyNo & " or Reg No. " & RegNo & ") !" & vbCrLf
                    End If
                Else
                    StrMsg = StrMsg & "Policy Data Not Found !" & vbCrLf
                End If
            Else
                ' Individual Policy or Master Policy, Check Template Policy
                If Not rsTemp.Eof AndAlso rsTemp.fields("RefNo") <> "" Then
                    If (SType = "S" Or (SType = "M" And MasterF)) AndAlso PolicyNo <> "" Then
                        SQL = "Select Top 1 A.ANO from Acceptance A, Cover C Where C.CNO=A.CNO and ((C.ProformaF=1 and A.LANO=-1) or (C.OpenFlag=1 and A.ANO=A.LANO)) and A.AStatus='I' and A.PolicyNo='" & PolicyNo & "'"
                        rsTemp = db.OpenRemoteSet(SQL)
                        If rsTemp.Eof Then
                            StrMsg = StrMsg & "Template Policy Data Not Found (Policy No. " & PolicyNo & ") !" & vbCrLf
                        End If
                    End If
                End If
            End If

            If StrMsg = "" Then
                rs = db.OpenRemoteSet("Select SysBatch.* from SysBatch" & MapGroup & " SysBatch Where BID=" & BID)
                rs.Edit()
                rs.fields("ANO") = ANO
                rs.fields("DumpProfileF") = DumpProfileF
                rs.fields("CreateProfileF") = CreateProfileF
                rs.fields("InsuredF") = InsuredF
                rs.fields("SType") = SType

                If rs.fields("TOC") = "" Then
                    rs.fields("TOC") = TOC
                End If

                If rs.fields("TOPRO") = "" Then
                    rs.fields("TOPRO") = TOPRO
                End If

                If rs.fields("PolicyNo") = "" Then
                    rs.fields("PolicyNo") = PolicyNo
                End If

                If rs.fields("RegNo") = "" Then
                    rs.fields("RegNo") = RegNo
                End If

                If rs.fields("Segment") = "" Then
                    rs.fields("Segment") = Segment
                End If

                If rs.fields("Branch") = "" Then
                    rs.fields("Branch") = Branch
                End If

                If tostr(rs.fields("Inception")) = "" Or Format(todate(rs.fields("Inception")), "MM/DD/YYYY") = "01/01/1900" Then
                    If TType <> "R" Then
                        rs.fields("Inception") = SDate
                    Else
                        rs.fields("Inception") = EDate
                    End If
                End If

                If tostr(rs.fields("Expiry")) = "" Or Format(todate(rs.fields("Expiry")), "MM/DD/YYYY") = "01/01/1900" Then
                    If TType <> "R" Then
                        rs.fields("Expiry") = EDate
                    Else
                        If Day(SDate) <> Day(EDate) Then
                            rs.fields("Expiry") = DateAdd(DateInterval.Day, DateDiff(DateInterval.Day, SDate, EDate), EDate)
                        Else
                            rs.fields("Expiry") = DateAdd(DateInterval.Month, DateDiff(DateInterval.Month, SDate, EDate), EDate)
                        End If
                    End If
                End If

                If tostr(rs.fields("RefDate")) = "" Or Format(todate(rs.fields("RefDate")), "MM/DD/YYYY") = "01/01/1900" Then
                    rs.fields("RefDate") = RefDate
                End If

                rs.fields("PDate") = todate(rs.fields("Inception")).Date
                rs.fields("ADate") = GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex)))

                Dim Inparam(7) As Object
                Inparam(0) = DuplicateF
                Inparam(1) = SDate
                Inparam(2) = EDate
                Inparam(3) = TOC
                Inparam(4) = OpenFlag
                Inparam(5) = QuotationF
                Inparam(6) = M_TOC
                Inparam(7) = M_PolicyType

                If Not rs.Update Then Throw New Exception(rs.ErrDesc)

                Dim rsBatch As RemoteSet
                Dim FCount As Integer
                Dim fIndex_1() As String
                Dim FCount_1 As Integer

                SQL = "Select S1.* "
                rsBatch = db.OpenRemoteSet("Select * from sysBatch" & MapGroup & " Where 1<>1")
                FIndex = rsBatch.fields_index
                FCount = UBound(FIndex)

                If SysBatchExtension >= 1 Then
                    rsBatch = db.OpenRemoteSet("Select * from sysBatch" & MapGroup & "_Ext Where 1<>1")
                    fIndex_1 = rsBatch.fields_index
                    FCount_1 = UBound(fIndex_1)

                    For i = 0 To rsBatch.fields_Count - 1
                        If GetFieldIndex(rsBatch.fields_Name(i), FIndex) >= FCount Then
                            SQL = SQL & ", S2.[" & rsBatch.fields_Name(i) & "]"
                        End If
                    Next
                End If

                If SysBatchExtension >= 2 Then
                    rsBatch = db.OpenRemoteSet("Select * from sysBatch" & MapGroup & "_Ext_1 Where 1<>1")
                    For i = 0 To rsBatch.fields_Count - 1
                        If GetFieldIndex(rsBatch.fields_Name(i), FIndex) >= FCount AndAlso GetFieldIndex(rsBatch.fields_Name(i), fIndex_1) >= FCount_1 Then
                            SQL = SQL & ", S3.[" & rsBatch.fields_Name(i) & "]"
                        End If
                    Next
                End If

                SQL = SQL & " from sysBatch" & MapGroup & " S1 "
                SQL = SQL & " Left Join sysBatch" & MapGroup & "_Ext S2 on (S2.BID=S1.BID)"
                SQL = SQL & " Left Join sysBatch" & MapGroup & "_Ext_1 S3 on (S3.BID=S1.BID)"
                SQL = SQL & " Where S1.BID=" & BID
                rsBatch = db.OpenRemoteSet(SQL)

                If Not Check_Entry_UP(rsBatch, Inparam, ErrMsg) Then
                    StrMsg = StrMsg & "Check Entry : " & ErrMsg & vbCrLf
                Else
                    If Not db.Execute("Update SysBatch Set Status='W' from SysBatch" & MapGroup & " SysBatch Where BID=" & BID) Then Throw New Exception(db.ErrDesc)
                End If
            End If

            If StrMsg <> "" Then
                Return False
            Else
                Return True
            End If

        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try

    End Function
    Private Function Check_Entry_UP(ByVal rsBatch As RemoteSet, ByVal InParam As Object, ByRef ErrMsg As String, Optional ByVal MemberCount As Integer = 25, Optional ByVal AddCoverageCount As Integer = 70, Optional ByVal AddInterestCount As Integer = 30, Optional ByVal AddICoverNOCCount As Integer = 10, Optional ByVal AddICoverDetCount As Integer = 18, Optional ByVal AddRCoverDetCount As Integer = 10, Optional ByVal DeductibleCount As Integer = 20, Optional ByVal BusinessSourceCount As Integer = 5, Optional ByVal InPartyCount As Integer = 5, Optional ByVal BeneficiariesCount As Integer = 5, Optional ByVal DutyCount As Integer = 4, Optional ByVal OPFeeCount As Integer = 2, Optional ByVal FacultativeCount As Integer = 20, Optional ByVal FacultativeDetCount As Integer = 3, Optional ByVal PayorDetCount As Integer = 4) As Boolean
        Dim CheckDuplicateF As Byte = toval(InParam(0))
        Dim M_SDate As Date = todate(InParam(1))
        Dim M_EDate As Date = todate(InParam(2))
        Dim TOC As String = tostr(InParam(3))
        Dim OpenFlag As Boolean = toval(InParam(4))
        Dim QuotationF As Boolean = toval(InParam(5))
        Dim M_TOC As String = tostr(InParam(6))
        Dim M_PolicyType As String = tostr(InParam(7))
        Dim Inception As Date
        Dim Expiry As Date
        Dim ANO As Long
        Dim PolicyNo As String
        Dim RegNo As String
        Dim Segment As String
        Dim MasterF As Boolean
        Dim rs As RemoteSet
        Dim SQL As String
        Dim CreateProfileF As Boolean
        Dim SType As String
        Dim TType As String
        Dim BatchNo As String
        Dim Branch As String
        Dim MSCode As String
        Dim MO As String
        Dim ExclusiveF As Boolean
        Dim STime As String
        Dim ETime As String
        Dim Fee_ID As String
        Dim Duty_ID As String
        Dim Fee_Currency As String
        Dim Duty_Currency As String

        ErrMsg = ""
        Try
            PolicyNo = tostr(rsBatch.fields("PolicyNo"))
            RegNo = tostr(rsBatch.fields("RegNo"))
            Inception = todate(rsBatch.fields("Inception")).Date
            Expiry = todate(rsBatch.fields("Expiry")).Date
            ANO = toval(rsBatch.fields("ANO"))
            MasterF = toval(rsBatch.fields("MasterF"))
            Segment = tostr(rsBatch.fields("Segment"))
            CreateProfileF = toval(rsBatch.fields("CreateProfileF"))
            TType = tostr(rsBatch.fields("TType"))
            SType = tostr(rsBatch.fields("SType"))
            BatchNo = tostr(rsBatch.fields("BatchNo"))
            Branch = tostr(rsBatch.fields("Branch"))
            ExclusiveF = toval(rsBatch.fields("ExclusiveF"))
            STime = tostr(rsBatch.fields("STime"))
            ETime = tostr(rsBatch.fields("ETime"))
            MSCode = tostr(rsBatch.fields("MSCode"))
            MO = tostr(rsBatch.fields("MO"))
            Fee_Currency = tostr(rsBatch.fields("Fee_Currency"))
            Duty_Currency = tostr(rsBatch.fields("Duty_Currency"))
            Fee_ID = tostr(rsBatch.fields("Fee_ID"))
            Duty_ID = tostr(rsBatch.fields("Duty_ID"))

            If Not ExclusiveF And STime < ETime Then
                If DateDiff(DateInterval.Day, todate(Inception), todate(Expiry)) < 0 Then
                    ErrMsg = ErrMsg & "Expiry Date Must Be Greater Than Or Equal To Inception Date !" & vbCrLf
                End If
            Else
                If DateDiff(DateInterval.Day, todate(Inception), todate(Expiry)) <= 0 Then
                    ErrMsg = ErrMsg & "Expiry Date Must Be Greater Than Inception Date !" & vbCrLf
                End If
            End If

            If toval(rsBatch.fields("QTY")) < 0 Then
                ErrMsg = ErrMsg & "Invalid Qty !" & vbCrLf
            End If

            If MasterF = True And (SType <> "M" And SType <> "O") Then
                ErrMsg = ErrMsg & "Invalid Master Policy Type !" & vbCrLf
            End If

            If tostr(rsBatch.fields("TOPRO")) <> "" Then
                rs = db.OpenRemoteSet("Select top 1 TOPRO.TOPRO, TOC.TOC, COB.COB from TOPRO Left Join TOC on (TOC.TOC=TOPRO.TOC) Left Join COB on (COB.COB=TOPRO.TOC) Where TOPRO.TOPRO = '" & rsBatch.fields("TOPRO") & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Invalid TOPRO ID : " & rsBatch.fields("TOPRO") & " !" & vbCrLf
                ElseIf UCase(rs.fields("TOC")) <> "" AndAlso UCase(rs.fields("TOC")) <> UCase(rsBatch.fields("TOC")) Then
                    ErrMsg = ErrMsg & "Invalid TOPRO ID : " & rsBatch.fields("TOPRO") & " for TOC : " & rsBatch.fields("TOC") & " !" & vbCrLf
                ElseIf UCase(rs.fields("COB")) <> "" Then
                    rs = db.OpenRemoteSet("Select COB from TOC Where TOC='" & rsBatch.fields("TOC") & "' and COB='" & UCase(rs.fields("COB")) & "'")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid TOPRO ID : " & rsBatch.fields("TOPRO") & " for TOC : " & rsBatch.fields("TOC") & " !" & vbCrLf
                    End If
                End If
            End If

            If MasterF = False And (SType = "M" Or SType = "O") Then
                rs = db.OpenRemoteSet("Select MultiTOCF from PolicyType Where PolicyType='" & M_PolicyType & "'")
                If toval(rs.fields("MultiTOCF")) Then
                    rs = db.OpenRemoteSet("Select TOC.TOC from TOC, PTClass where TOC.AllowedF=1 and PTClass.PolicyType='" & M_PolicyType & "' and TOC.COB=PTClass.COB and TOC.TOC='" & UCase(rsBatch.fields("TOC")) & "'")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid TOC : " & UCase(rsBatch.fields("TOC"))
                    End If
                ElseIf UCase(rsBatch.fields("TOC")) <> UCase(M_TOC) Then
                    ErrMsg = ErrMsg & "Invalid TOC : " & UCase(rsBatch.fields("TOC"))
                End If
            End If

            If MasterF Or SType = "S" Then
                If tostr(rsBatch.fields("MO")) = "" Then
                    If TType <> "R" Then
                        ErrMsg = ErrMsg & "Invalid Marketing Officer !" & vbCrLf
                    End If
                Else
                    rs = db.OpenRemoteSet("Select ID From FN_UserMO('" & db_user & "') sysUser Where (Role in ('MARKETING OFFICER','COMMON') or ARole in ('MARKETING OFFICER','COMMON')) and AllowedF=1 and ID='" & tostr(rsBatch.fields("MO")) & "'")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid Marketing Officer : " & tostr(rsBatch.fields("MO")) & " !" & vbCrLf
                    End If
                End If

                If tostr(rsBatch.fields("Segment")) = "" Then
                    If TType <> "R" Then
                        ErrMsg = ErrMsg & "Invalid Segment !" & vbCrLf
                    End If
                Else
                    rs = db.OpenRemoteSet("Select Segment From FN_UserSegment('" & tostr(rsBatch.fields("MO")) & "') Segment Where AllowedF=1 and Segment='" & tostr(rsBatch.fields("Segment")) & "'")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid Segment : " & tostr(rsBatch.fields("Segment")) & " !" & vbCrLf
                    End If
                End If

                If tostr(rsBatch.fields("HolderID")) = "" Then
                    If TType <> "R" Then
                        If Not ((CreateProfileF Or tostr(rsBatch.fields("InsuredID")) <> "") And tostr(rsBatch.fields("InsuredName")) <> "" And tostr(rsBatch.fields("Address_1")) + tostr(rsBatch.fields("Address_2")) + tostr(rsBatch.fields("Address_3")) <> "") Then
                            ErrMsg = ErrMsg & "Invalid Policy Holder !" & vbCrLf
                        End If
                    End If
                End If
            End If

            If tostr(rsBatch.fields("Insured")) = "" Then
                If TType <> "R" Then
                    ErrMsg = ErrMsg & "Invalid Insured Name !" & vbCrLf
                End If
            End If


            If Branch = "" Then
                If TType <> "R" Then
                    ErrMsg = ErrMsg & "Invalid Branch !" & vbCrLf
                End If
            Else
                rs = db.OpenRemoteSet("Select Branch from FL_UserBranch('" & db_user & "','" & Branch & "') B Where B.Branch='" & Branch & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Invalid Branch : " & Branch & " !" & vbCrLf
                End If
            End If

            If MSCode <> "" Then
                rs = db.OpenRemoteSet("Select MSCode from MSCode Where Post_Flag=1 and Branch in ('','" & Branch & "') and MSCode='" & MSCode & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Invalid MSCode : " & MSCode & " !" & vbCrLf
                End If
            End If

            If tostr(rsBatch.fields("BankersID")) <> "" Then
                rs = db.OpenRemoteSet("Select ID, Name from Profile Where ID='" & tostr(rsBatch.fields("BankersID")) & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Invalid Banker's ID !" & vbCrLf
                End If
                If tostr(rsBatch.fields("BankersClause")) = "" Then
                    rsBatch.fields("BankersClause") = rs.fields("Name")
                End If
            End If

            If tostr(rsBatch.fields("CT")) <> "" Then
                rs = db.OpenRemoteSet("Select CT from FN_UserCT('" & db_user & "','" & Branch & "','') C Where C.CT='" & tostr(rsBatch.fields("CT")) & "' and C.Post_Flag = 1 and C.AllowedF = 1")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Invalid Profit/Cost Centre !" & vbCrLf
                End If
            End If

            If toval(rsBatch.fields("Premium")) <> 0 AndAlso (tostr(rsBatch.fields("PremiumDescription")).ToUpper = "MINIMUM PREMIUM" Or tostr(rsBatch.fields("PremiumDescription")).ToUpper = "POLICY MINIMUM PREMIUM") Then
                ErrMsg = ErrMsg & "Invalid Premium Description ('MINIMUM PREMIUM','POLICY MINIMUM PREMIUM') !" & vbCrLf
            End If

            If MasterF = False Then
                If SType = "M" Then
                    If DateDiff(DateInterval.Day, Inception, M_SDate) > 0 Then
                        ErrMsg = ErrMsg & "Insurance period cannot be earlier than " & Format(M_SDate, "dd-mmm-yyyy") & " !" & vbCrLf
                    End If
                    If DateDiff(DateInterval.Day, Expiry, M_EDate) < 0 Then
                        ErrMsg = ErrMsg & "Insurance period cannot be later than " & Format(M_EDate, "dd-mmm-yyyy") & " !" & vbCrLf
                    End If
                ElseIf SType = "O" Then
                    If DateDiff(DateInterval.Day, Inception, M_SDate) > 0 Then
                        ErrMsg = ErrMsg & "Inception Date cannot be earlier than " & Format(M_SDate, "dd-mmm-yyyy") & " !" & vbCrLf
                    End If
                    If DateDiff(DateInterval.Day, Inception, M_EDate) < 0 Then
                        ErrMsg = ErrMsg & "Inception Date cannot be later than " & Format(M_EDate, "dd-mmm-yyyy") & " !" & vbCrLf
                    End If
                End If

                If tostr(rsBatch.fields("TOPRO")) = "" Then
                    If TType <> "R" Then
                        If toval(rsBatch.fields("MAINRATE")) < 0 Then
                            ErrMsg = ErrMsg & "Invalid Main Rate !" & vbCrLf
                        End If
                    End If

                    If tostr(rsBatch.fields("MAINCURRENCY")) = "" Then
                        If TType <> "R" Then
                            ErrMsg = ErrMsg & "Invalid Main Interest Currency !" & vbCrLf
                        End If
                    Else
                        rs = db.OpenRemoteSet("SELECT Currency FROM CURRENCY WHERE CURRENCY ='" & rsBatch.fields("MAINCURRENCY") & "' OR DESCRIPTION ='" & rsBatch.fields("MAINCURRENCY") & "'")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid Main Interest Currency !" & vbCrLf
                        End If
                    End If

                    If tostr(rsBatch.fields("MAINCOVERAGE")) = "" Then
                        If TType <> "R" Then
                            ErrMsg = ErrMsg & "Invalid Main Coverage !" & vbCrLf
                        End If
                    Else
                        rs = db.OpenRemoteSet("Select Code from ratetab where code='" & tostr(rsBatch.fields("MAINCOVERAGE")) & "' and AllowedF=1")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid Main Coverage (Does not Exist / Not Allowed) !" & vbCrLf
                        End If
                    End If

                    If tostr(rsBatch.fields("MAINUNIT")) = "" Then
                        If TType <> "R" Then
                            ErrMsg = ErrMsg & "Invalid Main Unit !" & vbCrLf
                        End If
                    ElseIf tostr(rsBatch.fields("MAINUNIT")) <> "C" And tostr(rsBatch.fields("MAINUNIT")) <> "F" And tostr(rsBatch.fields("MAINUNIT")) <> "M" And tostr(rsBatch.fields("MAINUNIT")) <> "L" Then
                        ErrMsg = ErrMsg & "Invalid Unit Type For Main Coverage !" & vbCrLf
                    End If

                    Dim DISPMODEL As String = ""
                    If tostr(rsBatch.fields("MAININTERESTCODE")) = "" Then
                        If TType <> "R" Then
                            ErrMsg = ErrMsg & "Invalid Main Interest Code !" & vbCrLf
                        End If
                    Else
                        rs = db.OpenRemoteSet("Select TOI, DISPMODEL from TOI where TOI='" & tostr(rsBatch.fields("MAININTERESTCODE")) & "' and AllowedF=1")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid Main Interest Code (Does not Exist / Not Allowed) !" & vbCrLf
                        End If
                        DISPMODEL = rs.fields("DISPMODEL")
                    End If

                    If DISPMODEL = "CIT" Or DISPMODEL = "CIS" Then
                        If toval(rsBatch.fields("MAININTERESTFLDVALUEF")) <= 0 Or toval(rsBatch.fields("MAININTERESTFLDVALUE1")) <= 0 Then
                            If toval(rsBatch.fields("MAINSUMINSURED")) <= 0 Then
                                ErrMsg = ErrMsg & "Invalid Main Interest Sum Insured (or Extended Interest Value) !" & vbCrLf
                            End If
                        End If
                    Else
                        If TType <> "R" Then
                            If toval(rsBatch.fields("MAINSUMINSURED")) <= 0 Then
                                ErrMsg = ErrMsg & "Invalid Main Interest Sum Insured !" & vbCrLf
                            End If
                        End If
                    End If
                End If
            End If



            If Fee_ID <> "" Then
                SQL = "Select top 1 F.FDID from FDTAB F "
                If Fee_Currency <> "" Then
                    SQL = SQL & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Fee_Currency & "' AND CURRENCY.ALLOWEDF=1)"
                End If
                SQL = SQL & " Where F.ATYPE in ('N','ALL') and LEFT(F.FDType,1) = 'F' and F.FDID = '" & Fee_ID & "'"
                rs = db.OpenRemoteSet(SQL)
                If rs.Eof Then ErrMsg = ErrMsg & "FEE ID ('" & Fee_ID & "') Not Found !" & vbCrLf
            End If

            If Duty_ID <> "" Then
                SQL = "Select top 1 F.FDID from FDTAB F "
                If Duty_Currency <> "" Then
                    SQL = SQL & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Duty_Currency & "' AND CURRENCY.ALLOWEDF=1)"
                End If
                SQL = SQL & " Where F.ATYPE in ('N','ALL') and LEFT(F.FDType,1) = 'D' and F.FDID = '" & Duty_ID & "'"
                rs = db.OpenRemoteSet(SQL)
                If rs.Eof Then ErrMsg = ErrMsg & "Duty ID ('" & Duty_ID & "') Not Found !" & vbCrLf
            End If

            If tostr(rsBatch.fields("PCALC")) <> "" Then
                If tostr(rsBatch.fields("PCALC")) <> "F" And tostr(rsBatch.fields("PCALC")) <> "P" And tostr(rsBatch.fields("PCALC")) <> "S" Then
                    ErrMsg = ErrMsg & "Invalid Calculation Method !" & vbCrLf
                End If
            End If

            If toval(rsBatch.fields("DISCOUNT")) < 0 Or toval(rsBatch.fields("DISCOUNT")) > 100 Then
                ErrMsg = ErrMsg & "Incorrect premium discount ! Must be between 0 and 100 !" & vbCrLf
            End If

            If toval(rsBatch.fields("IRate")) < 0 Or toval(rsBatch.fields("IRate")) > 100 Then
                ErrMsg = ErrMsg & "Incorrect Interest Rate ! Must be between 0 and 100 !" & vbCrLf
            End If

            If MasterF Or SType = "S" Or SType = "O" Then
                If tostr(rsBatch.fields("SysUserID")) <> "" Then
                    rs = db.OpenRemoteSet("Select ID from FL_Underwriter('" & Branch & "') S Where S.ID='" & rsBatch.fields("SysUserID") & "'")
                    If rs.Eof Then ErrMsg = ErrMsg & "Invalid Underwriter ID !" & vbCrLf
                End If
            End If

            Dim MainCoverageSDate As Date
            Dim MainCoverageEDate As Date
            If IsDate(rsBatch.fields("MAINCOVERAGESDATE")) And Format(todate(rsBatch.fields("MAINCOVERAGESDATE")), "MM/DD/YYYY") <> "01/01/1900" Then
                MainCoverageSDate = todate(rsBatch.fields("MAINCOVERAGESDATE"))
            Else
                MainCoverageSDate = Inception
            End If

            If IsDate(rsBatch.fields("MAINCOVERAGEEDATE")) And Format(todate(rsBatch.fields("MAINCOVERAGEEDATE")), "MM/DD/YYYY") <> "01/01/1900" Then
                MainCoverageEDate = todate(rsBatch.fields("MAINCOVERAGEEDATE"))
            Else
                MainCoverageEDate = Expiry
            End If

            If DateDiff(DateInterval.Day, MainCoverageSDate, Inception) > 0 Or DateDiff(DateInterval.Day, MainCoverageSDate, Expiry) < 0 Then
                ErrMsg = ErrMsg & "Incorrect Risk Coverage Period !" & vbCrLf
            End If

            If DateDiff(DateInterval.Day, MainCoverageEDate, Inception) > 0 Or DateDiff(DateInterval.Day, MainCoverageEDate, Expiry) < 0 Then
                ErrMsg = ErrMsg & "Incorrect Risk Coverage Period !" & vbCrLf
            End If

            If DateDiff(DateInterval.Day, MainCoverageSDate, MainCoverageEDate) < 0 Then
                ErrMsg = ErrMsg & "Incorrect Risk Coverage Period !" & vbCrLf
            End If

            'CHECK ADD COVERAGE AND INTEREST
            Dim i As Integer
            Dim Addcoverage(AddCoverageCount - 1) As String
            Dim Addunit(AddCoverageCount - 1) As String
            Dim Addrate(AddCoverageCount - 1) As Double
            Dim ADDCOVERAGESDATE(AddCoverageCount - 1) As Date
            Dim ADDCOVERAGEEDATE(AddCoverageCount - 1) As Date


            Dim ADDINTERESTCODE(AddInterestCount - 1) As String
            Dim ADDCURRENCY(AddInterestCount - 1) As String
            Dim ADDINTERESTREMARK(AddInterestCount - 1) As String
            Dim ADDSUMINSURED(AddInterestCount - 1) As Double

            For i = 0 To AddCoverageCount - 1
                Addcoverage(i) = tostr(rsBatch.fields("ADDCOVERAGE" & i + 1))
                ' Check Coverage
                If tostr(Addcoverage(i)) <> "" Then
                    Addunit(i) = tostr(rsBatch.fields("ADDUNIT" & i + 1))
                    Addrate(i) = toval(rsBatch.fields("ADDRATE" & i + 1))

                    If IsDate(rsBatch.fields("ADDCOVERAGESDATE" & i + 1)) And Format(todate(rsBatch.fields("ADDCOVERAGESDATE" & i + 1)), "MM/DD/YYYY") <> "01/01/1900" Then
                        ADDCOVERAGESDATE(i) = todate(rsBatch.fields("ADDCOVERAGESDATE" & i + 1))
                    Else
                        ADDCOVERAGESDATE(i) = Inception
                    End If

                    If IsDate(rsBatch.fields("ADDCOVERAGEEDATE" & i + 1)) And Format(todate(rsBatch.fields("ADDCOVERAGEEDATE" & i + 1)), "MM/DD/YYYY") <> "01/01/1900" Then
                        ADDCOVERAGEEDATE(i) = todate(rsBatch.fields("ADDCOVERAGEEDATE" & i + 1))
                    Else
                        ADDCOVERAGEEDATE(i) = Expiry
                    End If

                    If DateDiff(DateInterval.Day, ADDCOVERAGESDATE(i), Inception) > 0 Or DateDiff(DateInterval.Day, ADDCOVERAGESDATE(i), Expiry) < 0 Then
                        ErrMsg = ErrMsg & "Incorrect Risk Coverage Period !" & vbCrLf
                    End If

                    If DateDiff(DateInterval.Day, ADDCOVERAGEEDATE(i), Inception) > 0 Or DateDiff(DateInterval.Day, ADDCOVERAGEEDATE(i), Expiry) < 0 Then
                        ErrMsg = ErrMsg & "Incorrect Risk Coverage Period !" & vbCrLf
                    End If

                    If DateDiff(DateInterval.Day, ADDCOVERAGESDATE(i), ADDCOVERAGEEDATE(i)) < 0 Then
                        ErrMsg = ErrMsg & "Incorrect Risk Coverage Period !" & vbCrLf
                    End If


                    rs = db.OpenRemoteSet("Select Code from ratetab where code='" & tostr(Addcoverage(i)) & "' and AllowedF=1")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid Additional Coverage " & i + 1 & " (Does not Exists / Not Allowed) !" & vbCrLf
                    End If
                    'ADD RATE
                    If toval(Addrate(i)) < 0 Then
                        ErrMsg = ErrMsg & "Invalid Additional Rate " & i + 1 & " !" & vbCrLf
                    End If
                    'ADD UNIT
                    If toval(Addrate(i)) <> 0 Then
                        If tostr(Addunit(i)) = "" Then
                            ErrMsg = ErrMsg & "Invalid Additional Unit" & i + 1 & " !" & vbCrLf
                        ElseIf tostr(Addunit(i)) <> "C" And tostr(Addunit(i)) <> "F" And tostr(Addunit(i)) <> "M" And tostr(Addunit(i)) <> "L" Then
                            ErrMsg = ErrMsg & "Invalid Unit Type For Additional Coverage " & i + 1 & " !" & vbCrLf
                        End If
                    End If
                Else
                    ' Exit For
                End If
            Next

            For i = 0 To AddInterestCount - 1
                ADDINTERESTCODE(i) = tostr(rsBatch.fields("ADDINTERESTCODE" & i + 1))

                ' Check Interest
                If tostr(ADDINTERESTCODE(i)) <> "" Then
                    ADDCURRENCY(i) = tostr(rsBatch.fields("ADDCURRENCY" & i + 1))
                    ADDINTERESTREMARK(i) = tostr(rsBatch.fields("ADDINTERESTREMARK" & i + 1))
                    ADDSUMINSURED(i) = toval(rsBatch.fields("ADDSUMINSURED" & i + 1))

                    rs = db.OpenRemoteSet("Select TOI from TOI where TOI='" & tostr(ADDINTERESTCODE(i)) & "' and AllowedF=1")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid Additional Interest Code " & i + 1 & " (Does not Exists / Not Allowed) !" & vbCrLf
                    End If
                    'ADD INTEREST CURRENCY
                    If tostr(ADDCURRENCY(i)) = "" Then
                        ErrMsg = ErrMsg & "Invalid Additional Interest Currency " & i + 1 & " !" & vbCrLf
                    Else
                        rs = db.OpenRemoteSet("SELECT Currency FROM CURRENCY WHERE CURRENCY ='" & ADDCURRENCY(i) & "' OR DESCRIPTION ='" & ADDCURRENCY(i) & "'")
                        If rs.Eof Then ErrMsg = ErrMsg & "Invalid Additional Interest Currency " & i + 1 & " !" & vbCrLf
                    End If

                    'ADD INTEREST SUMINSURED
                    If tostr(ADDSUMINSURED(i)) = "" Then
                        ErrMsg = ErrMsg & "Invalid Additional Interest Sum Insured " & i + 1 & " !" & vbCrLf
                    Else
                        If Not IsNumeric(ADDSUMINSURED(i)) Then
                            ErrMsg = ErrMsg & "Invalid Additional Interest Sum Insured " & i + 1 & " !" & vbCrLf
                        End If
                    End If
                Else
                    ' Exit For
                End If
            Next

            ' Check Business Source
            If MasterF Or SType = "S" Then
                If Not db.GetPrivileges("RESTRICTEDPROFILE") Then
                    Dim BSID(BusinessSourceCount - 1) As String
                    For i = 0 To BusinessSourceCount - 1
                        BSID(i) = tostr(rsBatch.fields("BSID" & i + 1))
                        If BSID(i) <> "" Then
                            rs = db.OpenRemoteSet("Select ID, RestrictedF, RestrictedRemarks from fn_UserBusinessSource('" & rsBatch.fields("MO") & "','" & Format(Inception, "MM/DD/YYYY") & "') Profile Where Profile.ID='" & BSID(i) & "'")
                            If rs.Eof OrElse toval(rs.fields("RestrictedF")) Then
                                ErrMsg = ErrMsg & "Invalid or Restricted Business Profile " & BSID(i) & " !" & rs.fields("RestrictedRemarks") & vbCrLf
                            End If
                        Else
                            Exit For
                        End If
                    Next
                End If
            End If

            'check payor installment
            Dim SumPct As Double = 0
            If tostr(rsBatch.fields("PayorID")) <> "" And toval(rsBatch.fields("INSTALLMENT_FREQ")) > 0 Then
                For i = 1 To toval(rsBatch.fields("INSTALLMENT_FREQ"))
                    If IsDate(rsBatch.fields("IDATE_" & i)) Then
                        If i > 1 And DateDiff(DateInterval.Day, todate(rsBatch.fields("IDATE_" & i)), todate(rsBatch.fields("IDATE_" & i - 1))) > 0 Then
                            ErrMsg = ErrMsg & " Idate " & rsBatch.fields("IDATE_" & i) & "is smaller than the previous installment date " & vbCrLf
                        End If
                    End If
                    SumPct = SumPct + toval(rsBatch.fields("IPCT_" & i))
                Next

                If SumPct <> 0 AndAlso Math.Round(SumPct, 0, MidpointRounding.AwayFromZero) <> 100 Then
                    ErrMsg = ErrMsg & "Invalid IPCT Sum - Must be 100% " & vbCrLf
                End If
            End If

            Dim AccountNo As String = tostr(rsBatch.fields("AccountNo"))
            Dim BankAccount As String = tostr(rsBatch.fields("BankAccount"))
            Dim BankName As String = tostr(rsBatch.fields("BankName"))
            Dim Bank As String = tostr(rsBatch.fields("Bank"))

            If tostr(rsBatch.fields("PayorComAcc")) <> "" And tostr(rsBatch.fields("PayorID")) <> "" Then
                rs = db.OpenRemoteSet("Select ComAcc as AccountNo, Description as BankAccount, AccName_2 as BankName from FN_Payor_UserComAcc('" & db_user & "','" & Branch & "','" & tostr(rsBatch.fields("PayorID")) & "') ComAcc where BankF=1 and restrictedF=0 and ComAcc='" & tostr(rsBatch.fields("PayorComAcc")) & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "Invalid Payor " & tostr(rsBatch.fields("PayorID")) & " for Company Account " & tostr(rsBatch.fields("PayorComAcc")) & " !" & vbCrLf
                Else
                    AccountNo = rs.fields("AccountNo")
                    BankAccount = rs.fields("BankAccount")
                    BankName = rs.fields("BankName")
                End If
            End If

            If db.GetPrivileges("FORCECHECKBANKACCOUNT") And db.GetUserType <> "SUPERVISOR" Then
                If Not (AccountNo <> "" AndAlso BankAccount <> "" AndAlso (BankName <> "" Or Bank <> "")) Then
                    ErrMsg = ErrMsg & "Missing Bank Account Information !" & vbCrLf
                End If
            End If

            If toval(rsBatch.fields("Installment_Freq")) <> 0 Then
                If toval(rsBatch.fields("Installment_Duration")) = 0 Then ErrMsg = ErrMsg & "Invalid Installment Duration !" & vbCrLf
            End If

            If tostr(rsBatch.fields("BSType")) <> "" AndAlso tostr(rsBatch.fields("BSType")) <> "A" And tostr(rsBatch.fields("BSType")) <> "B" And tostr(rsBatch.fields("BSType")) <> "O" Then
                ErrMsg = ErrMsg & "Invalid Business Source Type !" & vbCrLf
            End If

            Dim ISType As String = UCase(tostr(rsBatch.fields("ISType")))
            Dim LeaderID As String
            Dim LeaderShare As String
            Dim TotalShare As Double

            If ISType = "" Then ISType = "I"
            If ISType <> "I" And ISType <> "L" And ISType <> "C" And ISType <> "R" And ISType <> "T" Then
                ErrMsg = ErrMsg & "Invalid Insurance Type !" & vbCrLf
            End If

            Dim MemberID(MemberCount - 1) As String
            Dim MemberShare(MemberCount - 1) As Double

            If ISType <> "I" And ISType <> "T" Then
                For X = 0 To MemberCount - 1
                    MemberID(X) = tostr(rsBatch.fields("MemberID" & X + 1))
                    If MemberID(X) <> "" Then
                        MemberShare(X) = toval(rsBatch.fields("MemberShare" & X + 1))
                        TotalShare = TotalShare + MemberShare(X)
                        rs = db.OpenRemoteSet("Select ID from Profile where ID = '" & MemberID(X) & "' or name = '" & MemberID(X) & "'")
                        If rs.Eof Then
                            ErrMsg = ErrMsg & "Invalid Coinsurance Member ID - ('" & MemberID(X) & "' !" & vbCrLf
                        End If
                    Else
                        Exit For
                    End If
                Next

                LeaderID = tostr(rsBatch.fields("LeaderID"))
                If LeaderID <> "" Then
                    LeaderShare = toval(rsBatch.fields("LeaderShare"))
                    TotalShare = TotalShare + LeaderShare
                    rs = db.OpenRemoteSet("Select ID from Profile where ID = '" & LeaderID & "' or name = '" & LeaderID & "'")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid Coinsurance Leader ID - ('" & LeaderID & "' !" & vbCrLf
                    End If
                End If

                If TotalShare < 0 Or TotalShare > 100 Then
                    ErrMsg = ErrMsg & "Total share for coinsurance must between 1 - 100 " & vbCrLf
                End If
            End If

            If rsBatch.fields("Branch") <> "" Then
                rs = db.OpenRemoteSet("Select Branch.ShariaF as BShariaF, TOC.ShariaF as TShariaF from Branch, TOC Where TOC.TOC='" & TOC & "' and Branch.Branch='" & rsBatch.fields("Branch") & "'")
                If toval(rs.fields("BShariaF")) <> toval(rs.fields("TShariaF")) Then
                    ErrMsg = ErrMsg & "Check Sharia or Non Sharia Flag for Branch and Sub Class Of Business !" & vbCrLf
                End If
            End If

            Dim DiscDetailType_(4) As String
            For X = 0 To 4
                DiscDetailType_(X) = tostr(rsBatch.fields("DiscDetailType_" & X + 1))
                If DiscDetailType_(X) <> "" Then
                    rs = db.OpenRemoteSet("Select DType from DType where DType = '" & DiscDetailType_(X) & "' and AllowedF = 1")
                    If rs.Eof Then
                        ErrMsg = ErrMsg & "Invalid Payor Detail Discount - ('" & DiscDetailType_(X) & "' !"
                    End If
                End If
            Next

            Dim EMethod As String = tostr(rsBatch.fields("EMethod"))
            If EMethod = "T" Then
                Dim TShare As Double = 0

                If MasterF = False Or SType = "S" Then
                    Dim QID, AFID, SP1ID, SP2ID, SP3ID As String
                    Dim QShare, AFSHARE, SP1SHARE, SP2SHARE, SP3SHARE As Double

                    QID = tostr(rsBatch.fields("QID"))
                    QShare = toval(rsBatch.fields("QShare"))
                    SP1ID = tostr(rsBatch.fields("SP1ID"))
                    SP1SHARE = toval(rsBatch.fields("SP1Share"))
                    SP2ID = tostr(rsBatch.fields("SP2ID"))
                    SP2SHARE = toval(rsBatch.fields("SP2Share"))
                    SP3ID = tostr(rsBatch.fields("SP3ID"))
                    SP3SHARE = toval(rsBatch.fields("SP3Share"))
                    AFID = tostr(rsBatch.fields("AFID"))
                    AFSHARE = toval(rsBatch.fields("AFSHARE"))

                    If QID <> "" Then
                        rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(IIf(SType = "M", M_SDate, Inception), "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'Q' and R2.TOC = '" & TOC & "' and R1.RID = '" & QID & "'")
                        If rs.Eof Then ErrMsg = ErrMsg & "Invalid Quota Share ID !" & vbCrLf

                        If toval(QShare) < 0 Or toval(QShare) > 100 Then ErrMsg = ErrMsg & "Quota Share percentage must between 1 - 100 !" & vbCrLf
                        TShare = TShare + QShare
                    End If

                    If SP1ID <> "" Then
                        rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(IIf(SType = "M", M_SDate, Inception), "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'S1' and R2.TOC = '" & TOC & "' and R1.RID = '" & SP1ID & "'")
                        If rs.Eof Then ErrMsg = ErrMsg & "Invalid Surplus 1 ID !" & vbCrLf

                        If toval(SP1SHARE) < 0 Or toval(SP1SHARE) > 100 Then ErrMsg = ErrMsg & "Surplus 1 percentage must between 1 - 100 !" & vbCrLf
                        TShare = TShare + SP1SHARE
                    End If

                    If SP2ID <> "" Then
                        rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(IIf(SType = "M", M_SDate, Inception), "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'S2' and R2.TOC = '" & TOC & "' and R1.RID = '" & SP2ID & "'")
                        If rs.Eof Then ErrMsg = ErrMsg & "Invalid Surplus 2 ID !" & vbCrLf

                        If toval(SP2SHARE) < 0 Or toval(SP2SHARE) > 100 Then ErrMsg = ErrMsg & "Surplus 2 percentage must between 1 - 100 !" & vbCrLf
                        TShare = TShare + SP2SHARE
                    End If

                    If SP3ID <> "" Then
                        rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(IIf(SType = "M", M_SDate, Inception), "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'S3' and R2.TOC = '" & TOC & "' and R1.RID = '" & SP3ID & "'")
                        If rs.Eof Then ErrMsg = ErrMsg & "Invalid Surplus 3 ID !" & vbCrLf

                        If toval(SP2SHARE) < 0 Or toval(SP2SHARE) > 100 Then ErrMsg = ErrMsg & "Surplus 2 percentage must between 1 - 100 !" & vbCrLf
                        TShare = TShare + SP3SHARE
                    End If

                    If AFID <> "" Then
                        rs = db.OpenRemoteSet("select R1.RID from REINSURANCE R1, RECLASS R2 where R1.RNO = R2.RNO and '" & Format(IIf(SType = "M", M_SDate, Inception), "MM/DD/YYYY") & "' Between R1.SDATE and R1.EDATE and R1.RTYPE = 'A' and R2.TOC = '" & TOC & "' and R1.RID = '" & AFID & "'")
                        If rs.Eof Then ErrMsg = ErrMsg & "Invalid Auto Facultative ID !" & vbCrLf

                        If toval(AFSHARE) < 0 Or toval(AFSHARE) > 100 Then ErrMsg = ErrMsg & "Auto Facultative Share percentage must between 1 - 100 !" & vbCrLf
                        TShare = TShare + AFSHARE
                    End If

                End If

                Dim FacOutID As String
                Dim FacOutShare As Double
                Dim FacOutCurrency As String
                Dim FacOutSysUserID As String
                Dim FacOutSdate As Date
                Dim FacOutEdate As Date
                Dim FullCoverF As Boolean
                For i = 1 To FacultativeCount
                    FullCoverF = True
                    FacOutID = tostr(rsBatch.fields("FacOut" & i & "ID"))
                    FacOutCurrency = tostr(rsBatch.fields("FacOut" & i & "CURRENCY"))
                    FacOutSysUserID = tostr(rsBatch.fields("FacOut" & i & "SysUserID"))
                    If tostr(rsBatch.fields("FacOut" & i & "SDate")) = "" Or Format(todate(rsBatch.fields("FacOut" & i & "SDate")).Date, "MM/DD/YYYY") = "01/01/1900" Then
                        FacOutSdate = Inception
                    Else
                        FacOutSdate = todate(rsBatch.fields("FacOut" & i & "SDate"))
                    End If

                    If tostr(rsBatch.fields("FacOut" & i & "EDate")) = "" Or Format(todate(rsBatch.fields("FacOut" & i & "EDate")).Date, "MM/DD/YYYY") = "01/01/1900" Then
                        FacOutEdate = Expiry
                    Else
                        FacOutEdate = todate(rsBatch.fields("FacOut" & i & "EDate"))
                    End If

                    If FacOutID <> "" Then
                        FacOutShare = toval(rsBatch.fields("FacOut" & i & "Share")) - toval(rsBatch.fields("FacOut" & i & "JPShare"))

                        rs = db.OpenRemoteSet("Select Top 1 ID from Profile Where DumpF=0 and (ID='" & FacOutID & "' or RefID='" & FacOutID & "')")
                        If rs.Eof Then ErrMsg = ErrMsg & "Invalid Facultative ID (" & FacOutID & ") !" & vbCrLf

                        If FacOutSysUserID <> "" Then
                            rs = db.OpenRemoteSet("Select Top 1 ID From FL_Underwriter('" & Branch & "') SysUser Where ID='" & FacOutSysUserID & "'")
                            If rs.Eof Then ErrMsg = ErrMsg & "Facultative Underwriter (" & FacOutSysUserID & ") Not Found !" & vbCrLf
                        End If

                        If FacOutCurrency <> "" Then
                            rs = db.OpenRemoteSet("Select Top 1 Currency from Currency Where AllowedF=1 and Currency='" & FacOutCurrency & "'")
                            If rs.Eof Then ErrMsg = ErrMsg & "Incorrect Currency (" & FacOutCurrency & ") !" & vbCrLf
                        End If

                        For y = 1 To FacultativeDetCount
                            If tostr(rsBatch.fields("FacOutDet" & i & "Code" & y)) <> "" Then
                                If tostr(rsBatch.fields("FacOutDet" & i & "Code" & y)).ToUpper = tostr(rsBatch.fields("MAINCOVERAGE")).ToUpper Then
                                    Exit For
                                Else
                                    FullCoverF = False
                                End If
                            End If
                        Next

                        If FacOutShare < 0 Or (FacOutShare <= 0 And Not MasterF) Then ErrMsg = ErrMsg & "Facultative " & i & " share percentage must between 1 - 100 !" & vbCrLf

                        If FacOutSdate < Inception Or FacOutEdate > Expiry OrElse FacOutSdate >= FacOutEdate Then
                            ErrMsg = ErrMsg & "Facultative " & i & " Invalid Facultative Period !" & vbCrLf
                        End If
                        If FullCoverF Then
                            TShare = TShare + FacOutShare
                        End If
                    Else
                        Exit For
                    End If
                Next

                If toval(TShare, 0) > 100 Then
                    ErrMsg = ErrMsg & "Total share percentage must be less than or equal to 100 % !" & vbCrLf
                End If
            End If

            Dim RequestName As String = tostr(rsBatch.fields("RequestName"))
            Dim ActionCode As String = tostr(rsBatch.fields("ActionCode"))

            If ActionCode <> "" Then
                rs = db.OpenRemoteSet("Select Top 1 ActionCode from ActionList where ActionStartF=1 and AllowedF=1 and ActionGroup='UND' and ActionCode='" & ActionCode & "'")
                If rs.Eof Then
                    ErrMsg = ErrMsg & "No Action Code - (" & ActionCode & ") !"
                End If
            End If

            If RequestName <> "" Then
                SQL = "Select S.ID, S.Name, S.Type from "
                SQL = SQL & "("
                SQL = SQL & "	Select S1.ID, S1.Name, 'U' as Type "
                SQL = SQL & "	from SysUser S1 "
                SQL = SQL & "	Where cast(convert(varchar(10), getdate(),1) as smalldatetime)<=S1.Expiry and S1.LockedF=0 and S1.AllowedF=1 "
                SQL = SQL & "	and Exists (Select SysUserBranch.ID from SysUserBranch Where SysUserBranch.ID=S1.ID and SysUserBranch.AllowedF=1 and SysUserBranch.Branch='" & Branch & "')"
                SQL = SQL & "   union all"
                SQL = SQL & "	Select Type as ID, Description as Name, 'T' as Type from SysUserType"
                SQL = SQL & ") S "
                SQL = SQL & "Left Join ActionList AL on (AL.ActionCode='" & ActionCode & "')"
                SQL = SQL & "Left Join ActionUser A on (A.ActionCode=AL.ActionCode and A.ActionUser=S.ID)"
                SQL = SQL & "Inner Join SysUser on (SysUser.ID='" & RequestName & "')"
                SQL = SQL & "Inner Join SysUsertype S1 on (S1.Type=SysUser.Type)"
                SQL = SQL & "Where (S1.ApplyActionCodeF=0 or coalesce(A.ActionCode,'')<>'') "
                SQL = SQL & "and coalesce(A.ActionCode,'')='" & ActionCode & "'"
                rs = db.OpenRemoteSet(SQL)
                If rs.Eof Then
                    ErrMsg = ErrMsg & "User Request Message Not Found - (" & RequestName & ") !"
                End If
            End If

            If ErrMsg <> "" Then
                Check_Entry_UP = False
            Else
                Check_Entry_UP = True
            End If
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function Check_Entry_Object_UP(ByVal rsBatch As RemoteSet, ByVal InParam As Object, ByRef ErrMsg As String, Optional ByVal MemberCount As Integer = 25, Optional ByVal AddCoverageCount As Integer = 70, Optional ByVal AddInterestCount As Integer = 30, Optional ByVal AddICoverNOCCount As Integer = 10, Optional ByVal AddICoverDetCount As Integer = 18, Optional ByVal AddRCoverDetCount As Integer = 10, Optional ByVal DeductibleCount As Integer = 20, Optional ByVal BusinessSourceCount As Integer = 5, Optional ByVal InPartyCount As Integer = 5, Optional ByVal BeneficiariesCount As Integer = 5, Optional ByVal DutyCount As Integer = 4, Optional ByVal OPFeeCount As Integer = 2, Optional ByVal FacultativeCount As Integer = 20, Optional ByVal FacultativeDetCount As Integer = 3, Optional ByVal PayorDetCount As Integer = 4) As Boolean
        Dim CheckDuplicateF As Byte = toval(InParam(0))
        Dim TOC As String = tostr(InParam(3))
        Dim QuotationF As Boolean = toval(InParam(5))

        Dim Inception As Date
        Dim Expiry As Date

        Dim ANO As Long
        Dim RegNo As String
        Dim Segment As String
        Dim MasterF As Boolean
        Dim rs As RemoteSet
        Dim SType As String
        Dim strFLDCOM As String

        If QuotationF Then
            strFLDCOM = "FLDCOMA"
        Else
            strFLDCOM = "FLDCOM"
        End If

        ErrMsg = ""
        Try
            ANO = toval(rsBatch.fields("ANO"))
            RegNo = tostr(rsBatch.fields("RegNo"))
            Inception = todate(rsBatch.fields("Inception")).Date
            Expiry = todate(rsBatch.fields("Expiry")).Date
            MasterF = toval(rsBatch.fields("MasterF"))
            Segment = tostr(rsBatch.fields("Segment"))
            SType = tostr(rsBatch.fields("SType"))

            'Check Object Information
            Dim j As Integer
            Dim PFLDID As String = ""
            Dim PVALUEID As String = ""
            Dim FLDID As String = ""
            Dim VALUEID As String = ""
            Dim VALUEDESC As String = ""
            Dim DEFVALUEID As String = ""
            Dim SFLDID As String = ""
            Dim SVALUEID As String = ""
            Dim REGID As String = ""
            Dim RFLDID As String = tostr(rsBatch.fields("RFLDID"))
            Dim RVALUEID As String = tostr(rsBatch.fields("RVALUEID"))
            Dim IAccReg As Long = 0
            Dim ExclusiveF As Boolean
            Dim UniqueRefNoF As Boolean
            Dim EachAccRegF As Boolean

            Dim rsAinfo As RemoteSet
            Dim rsTOC As RemoteSet
            Dim COB As String

            rs = db.OpenRemoteSet("Select TOC.COB from TOC Where TOC.TOC='" & TOC & "'")
            COB = tostr(rs.fields("COB"))

            rsTOC = db.OpenQueryDef("QTOC_GENHTAB", adOpenForwardonly, TOC)
            If Not rsTOC.Eof Then
                rsAinfo = db.OpenRemoteSet("Select * from AInfo Where ANO=" & ANO)
                IAccReg = rsTOC.fields("IAccReg")
                REGID = rsTOC.fields("REGID")
                ExclusiveF = toval(rsTOC.fields("ExclusiveF"))
                UniqueRefNoF = toval(rsTOC.fields("UniqueRefNoF"))
                EachAccRegF = toval(rsTOC.fields("EachAccRegF"))

                For j = 1 To 15
                    FLDID = tostr(rsTOC.fields("FLDID" & j))

                    If FLDID <> "" Then
                        VALUEDESC = tostr(rsAinfo.fields("VALUEDESC" & j))
                        VALUEID = tostr(rsAinfo.fields("VALUEID" & j))

                        If Not toval(rsTOC.fields("FLDTAB" & j)) Then
                            If tostr(rsBatch.fields("DESCRIPTION" & j)) <> "" Then
                                VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                            Else
                                If tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00"))) <> "" Then
                                    VALUEDESC = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                                End If
                            End If
                            VALUEID = ""
                        Else
                            If tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00"))) <> "" OrElse tostr(rsBatch.fields("DESCRIPTION" & j)) <> "" Then
                                VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                                VALUEID = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                            End If
                        End If

                        DEFVALUEID = ""

                        If InStr(VALUEID, Chr(16)) > 0 Then
                            DEFVALUEID = Left(VALUEID, InStr(VALUEID, Chr(16)) - 1)
                            VALUEID = Right(VALUEID, Len(VALUEID) - InStrRev(VALUEID, Chr(16)))
                        End If

                        If VALUEDESC = "" Then VALUEDESC = VALUEID

                        If toval(rsTOC.fields("FLDTAB" & j)) Then
                            If (VALUEID <> "" Or VALUEDESC <> "") Then
                                If j > 1 AndAlso toval(rsTOC.fields("SUBLINKF" & j)) Then
                                    Dim SQL As String
                                    SQL = "select Top 1 GenDTab.VALUEID, GenDTab.DESCRIPTION "
                                    SQL = SQL & " from GenDTab "
                                    If ANO > 0 Then
                                        SQL = SQL & " Left Join AINFODET on (AINFODET.ANO=" & ANO & " and AINFODET.ALLOWEDF=1 and AINFODET.FLDID=gendtab.FLDID and AINFODET.ValueID=gendtab.ValueID and AINFODET.Status='A') "
                                    End If
                                    SQL = SQL & " where GenDTab.AllowedF=1 "
                                    SQL = SQL & " and (GenDTab.fldid" & j - 1 & "<>'" & PFLDID & "' or GenDTab.valueid" & j - 1 & "='' or GenDTab.valueid" & j - 1 & "='" & PVALUEID & "') "
                                    SQL = SQL & " and GenDTab.fldid='" & FLDID & "' and (GenDTab.ValueID='" & VALUEID & "' or GenDTab.Description like '" & VALUEDESC & "%') "
                                    If ANO > 0 Then
                                        SQL = SQL & " and (coalesce(AINFODET.VALUEID,'')<>'' or Not Exists (SELECT AINFODET.VALUEID FROM AINFODET WHERE ANO=" & ANO & " AND FLDID=gendtab.FLDID AND VALUEID<>'<All>'))"
                                    End If
                                    SQL = SQL & " Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc"
                                    rs = db.OpenRemoteSet(SQL)
                                Else
                                    Dim SQL As String
                                    SQL = "select Top 1 GenDTab.VALUEID, GenDTab.DESCRIPTION "
                                    SQL = SQL & " from GenDTab "
                                    If ANO > 0 Then
                                        SQL = SQL & " Left Join AINFODET on (AINFODET.ANO=" & ANO & " and AINFODET.ALLOWEDF=1 and AINFODET.FLDID=gendtab.FLDID and AINFODET.ValueID=gendtab.ValueID and AINFODET.Status='A') "
                                    End If
                                    SQL = SQL & " where GenDTab.AllowedF=1 "
                                    SQL = SQL & " and GenDTab.fldid='" & FLDID & "' and (GenDTab.ValueID='" & VALUEID & "' or GenDTab.Description like '" & VALUEDESC & "%') "
                                    If ANO > 0 Then
                                        SQL = SQL & " and (coalesce(AINFODET.VALUEID,'')<>'' or Not Exists (SELECT AINFODET.VALUEID FROM AINFODET WHERE ANO=" & ANO & " AND FLDID=gendtab.FLDID AND VALUEID<>'<All>'))"
                                    End If
                                    SQL = SQL & " Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc"
                                    rs = db.OpenRemoteSet(SQL)
                                End If
                                If Not rs.Eof Then
                                    If VALUEID = VALUEDESC Then VALUEDESC = tostr(rs.fields("DESCRIPTION"))
                                    VALUEID = tostr(rs.fields("ValueID"))
                                Else
                                    If VALUEID = VALUEDESC Then
                                        VALUEID = DEFVALUEID
                                        VALUEDESC = ""
                                    Else
                                        VALUEID = DEFVALUEID
                                    End If
                                End If
                            End If
                        Else
                            If VALUEDESC <> "" Then
                                VALUEID = Get_ValueID(FLDID, VALUEDESC, Inception, TOC, Segment)
                            Else
                                VALUEID = ""
                            End If
                        End If

                        If AccRegisterFlag(IAccReg, j) Then
                            Dim RISKLOCATIONREMARK As String
                            RISKLOCATIONREMARK = rsBatch.fields("RISKLOCATIONREMARK")

                            If RISKLOCATIONREMARK <> "" Then
                                VALUEDESC = RISKLOCATIONREMARK
                            End If

                          

                            If SFLDID = "" Then
                                SFLDID = FLDID
                            Else
                                SFLDID = SFLDID + "|" + FLDID
                            End If
                            If SVALUEID = "" Then
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    SVALUEID = VALUEID
                                Else
                                    SVALUEID = VALUEDESC
                                End If
                            Else
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    SVALUEID = SVALUEID + "|" + VALUEID
                                Else
                                    SVALUEID = SVALUEID + "|" + VALUEDESC
                                End If
                            End If
                        End If

                        PFLDID = FLDID
                        PVALUEID = VALUEID
                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = VALUEID
                        rsBatch.fields("DESCRIPTION" & j) = VALUEDESC
                    Else
                        Exit For
                        'rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = ""
                        'rsBatch.fields("DESCRIPTION" & j) = ""
                    End If
                Next

                For j = 1 To 15
                    If rsTOC.fields("FLDID" & j) <> "" Then
                        ' Spread Info
                        If toval(rsTOC.fields("SpreadInfoF" & j)) AndAlso toval(rsTOC.fields("FLDTAB" & j)) AndAlso rsBatch.fields("OBJ_INFO_" & Format(j, "00")) <> "" Then
                            rs = db.OpenQueryDef("QSpreadInfo", adOpenForwardonly, rsTOC.fields("FLDID" & j), rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                            If Not rs.Eof Then
                                For i = j + 1 To 15
                                    If rsTOC.fields("FLDID" & i) <> "" Then
                                        If rsBatch.fields("OBJ_INFO_" & Format(i, "00")) = "" Then
                                            For k = 1 To 15
                                                If rs.fields("FLDID" & k) <> "" Then
                                                    If rsTOC.fields("FLDID" & i) = rs.fields("FLDID" & k) Then
                                                        rsBatch.fields("OBJ_INFO_" & Format(i, "00")) = rs.fields("VALUEID" & k)
                                                        If rsBatch.fields("DESCRIPTION" & i) = "" Then
                                                            rsBatch.fields("DESCRIPTION" & i) = rs.fields("VALUEDESC" & k)
                                                        End If
                                                        Exit For
                                                    End If
                                                Else
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                    Else
                                        Exit For
                                    End If
                                Next
                            End If
                        End If

                        If Not MasterF Then
                            If toval(rsTOC.fields(strFLDCOM & j)) Then
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    If rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = "" And (Not AccRegisterFlag(IAccReg, j) Or (RFLDID = "" Or RVALUEID = "" Or rsBatch.fields("DESCRIPTION" & j) = "")) Then
                                        ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsBatch.fields("DESCRIPTION" & j) & "', Please Check General Table For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                    End If
                                    If RFLDID <> "" And RVALUEID <> "" Then
                                        rs = db.OpenRemoteSet("Select FLDID, VALUEID from GendTab where AllowedF = 1 and FLDID = '" & RFLDID & "' and ValueID = '" & RVALUEID & "'")
                                        If rs.Eof Then ErrMsg = ErrMsg & "Incorrect ValueID for Generate Object Information ! " & vbCrLf
                                    End If
                                Else
                                    If rsBatch.fields("DESCRIPTION" & j) = "" Then
                                        ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                    End If
                                End If
                            End If
                        End If
                    Else
                        Exit For
                    End If
                Next
            Else
                ErrMsg = ErrMsg & "Invalid Type Of Cover !" & vbCrLf
            End If

            ' Extended Object Information

            PFLDID = ""
            PVALUEID = ""
            rsTOC = db.OpenQueryDef("QTOC_EXT_GENHTAB", adOpenForwardonly, TOC)
            If Not rsTOC.Eof Then
                rsAinfo = db.OpenRemoteSet("Select * from AINFO_EXT Where ANO=" & ANO)
                For j = 16 To 30
                    FLDID = tostr(rsTOC.fields("FLDID" & j))
                    VALUEDESC = tostr(rsAinfo.fields("VALUEDESC" & j))
                    VALUEID = tostr(rsAinfo.fields("VALUEID" & j))

                    If Not toval(rsTOC.fields("FLDTAB" & j)) Then
                        If tostr(rsBatch.fields("DESCRIPTION" & j)) <> "" Then
                            VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                        Else
                            If tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00"))) <> "" Then
                                VALUEDESC = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                            End If
                        End If
                        VALUEID = ""
                    Else
                        If tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00"))) <> "" OrElse tostr(rsBatch.fields("DESCRIPTION" & j)) <> "" Then
                            VALUEDESC = tostr(rsBatch.fields("DESCRIPTION" & j))
                            VALUEID = tostr(rsBatch.fields("OBJ_INFO_" & Format(j, "00")))
                        End If
                    End If

                    DEFVALUEID = ""

                    If InStr(VALUEID, Chr(16)) > 0 Then
                        DEFVALUEID = Left(VALUEID, InStr(VALUEID, Chr(16)) - 1)
                        VALUEID = Right(VALUEID, Len(VALUEID) - InStrRev(VALUEID, Chr(16)))
                    End If

                    If VALUEDESC = "" Then VALUEDESC = VALUEID

                    If FLDID <> "" Then
                        If (VALUEID <> "" Or VALUEDESC <> "") And toval(rsTOC.fields("FLDTAB" & j)) Then
                            If j > 1 AndAlso toval(rsTOC.fields("SUBLINKF" & j)) Then
                                rs = db.OpenRemoteSet("select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and (fldid" & j - 1 & "<>'" & PFLDID & "' or valueid" & j - 1 & "='' or valueid" & j - 1 & "='" & PVALUEID & "') and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                            Else
                                rs = db.OpenRemoteSet("Select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                            End If
                            If Not rs.Eof Then
                                If VALUEID = VALUEDESC Then VALUEDESC = tostr(rs.fields("DESCRIPTION"))
                                VALUEID = tostr(rs.fields("ValueID"))
                            Else
                                VALUEID = DEFVALUEID
                            End If
                        End If

                        rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = VALUEID
                        rsBatch.fields("DESCRIPTION" & j) = VALUEDESC

                        PFLDID = FLDID
                        PVALUEID = VALUEID

                        If Not MasterF Then
                            If toval(rsTOC.fields(strFLDCOM & j)) Then
                                If toval(rsTOC.fields("FLDTAB" & j)) Then
                                    If rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = "" Then
                                        ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsBatch.fields("DESCRIPTION" & j) & "', Please Check General Table For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                    End If
                                Else
                                    If rsBatch.fields("DESCRIPTION" & j) = "" Then
                                        ErrMsg = ErrMsg & "Incorrect Compulsory Object Information For '" & rsTOC.fields("FLDTAG" & j) & "(" & tostr(rsTOC.fields("FLDID" & j)) & ")' ! " & vbCrLf
                                    End If
                                End If
                            End If
                        End If
                    Else
                        Exit For
                        'rsBatch.fields("OBJ_INFO_" & Format(j, "00")) = ""
                        'rsBatch.fields("DESCRIPTION" & j) = ""
                    End If
                Next
            End If


            If MasterF = True OrElse SType = "S" Then
                ' Underwriting Information
                PFLDID = ""
                PVALUEID = ""
                rsTOC = db.OpenQueryDef("QCOB_GENHTAB", adOpenForwardonly, COB)
                If Not rsTOC.Eof Then
                    For j = 1 To 15
                        FLDID = tostr(rsTOC.fields("FLDID" & j))
                        VALUEDESC = ""
                        VALUEID = ""

                        If Not toval(rsTOC.fields("FLDTAB" & j)) Then
                            If tostr(rsBatch.fields("UW_DESCRIPTION" & j)) <> "" Then
                                VALUEDESC = tostr(rsBatch.fields("UW_DESCRIPTION" & j))
                            Else
                                VALUEDESC = tostr(rsBatch.fields("UW_INFO_" & Format(j, "00")))
                            End If
                            VALUEID = ""
                        Else
                            If tostr(rsBatch.fields("UW_INFO_" & Format(j, "00"))) <> "" OrElse tostr(rsBatch.fields("UW_DESCRIPTION" & j)) <> "" Then
                                VALUEDESC = tostr(rsBatch.fields("UW_DESCRIPTION" & j))
                                VALUEID = tostr(rsBatch.fields("UW_INFO_" & Format(j, "00")))
                            End If
                        End If

                        DEFVALUEID = ""

                        If InStr(VALUEID, Chr(16)) > 0 Then
                            DEFVALUEID = Left(VALUEID, InStr(VALUEID, Chr(16)) - 1)
                            VALUEID = Right(VALUEID, Len(VALUEID) - InStrRev(VALUEID, Chr(16)))
                        End If

                        If VALUEDESC = "" Then VALUEDESC = VALUEID

                        If FLDID <> "" Then
                            If (VALUEID <> "" Or VALUEDESC <> "") And toval(rsTOC.fields("FLDTAB" & j)) Then
                                If j > 1 AndAlso toval(rsTOC.fields("SUBLINKF" & j)) Then
                                    rs = db.OpenRemoteSet("select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and (fldid" & j - 1 & "<>'" & PFLDID & "' or valueid" & j - 1 & "='' or valueid" & j - 1 & "='" & PVALUEID & "') and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                                Else
                                    rs = db.OpenRemoteSet("Select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and fldid='" & FLDID & "' and (ValueID='" & VALUEID & "' or Description like '" & VALUEDESC & "%') Order By Case When GenDTab.ValueID='" & VALUEID & "' Then 1 else 0 end desc, difference('" & VALUEDESC & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                                End If
                                If Not rs.Eof Then
                                    If VALUEID = VALUEDESC Then VALUEDESC = tostr(rs.fields("DESCRIPTION"))
                                    VALUEID = tostr(rs.fields("ValueID"))
                                Else
                                    VALUEID = DEFVALUEID
                                End If
                            End If

                            rsBatch.fields("UW_INFO_" & Format(j, "00")) = VALUEID
                            rsBatch.fields("UW_DESCRIPTION" & j) = VALUEDESC

                            PFLDID = FLDID
                            PVALUEID = VALUEID
                        Else
                            Exit For
                            'rsBatch.fields("UW_INFO_" & Format(j, "00")) = ""
                            'rsBatch.fields("DESCRIPTION" & j) = ""
                        End If
                    Next
                End If
            End If


            ' Check Duplicate in Acceptance
            If CheckDuplicateF > 0 Then
                If ((REGID <> "" AndAlso SFLDID <> "" AndAlso SVALUEID <> "") Or (UniqueRefNoF AndAlso tostr(rsBatch.fields("RefNo")) <> "")) Then
                    Dim LockedKey As String = ""
                    If UniqueRefNoF Then
                        LockedKey = REGID & "_" & tostr(rsBatch.fields("RefNo"))
                    Else
                        LockedKey = REGID & "_" & SFLDID & "_" & SVALUEID
                    End If
                    If Not db.GetLockedObject("DUPL_OBJECT_" & LockedKey, True) Then Throw New Exception("Can't Acquire Locked Object!")

                    Dim AFLDID() As String
                    Dim AVALUEID() As String

                    If EachAccRegF Then
                        AFLDID = Convert_FLDID_Into_Array(SFLDID)
                        AVALUEID = Convert_FLDID_Into_Array(SVALUEID)
                    Else
                        ReDim AFLDID(0)
                        ReDim AVALUEID(0)
                        AFLDID(0) = SFLDID
                        AVALUEID(0) = SVALUEID
                    End If

                    For i = 0 To AFLDID.GetUpperBound(0)
                        If SType = "S" Then
                            If CheckDuplicateF = 1 Then
                                rs = db.OpenQueryDef("QCheckObjectInsured_Upload", adOpenForwardonly, REGID, AFLDID(i), AVALUEID(i), Inception, Expiry, tostr(rsBatch.fields("RefNo")), IIf(ExclusiveF, 1, 0), TOC, "")
                            Else
                                rs = db.OpenQueryDef("QCheckObjectInsured_Upload", adOpenForwardonly, "", "", "", Inception, Expiry, tostr(rsBatch.fields("RefNo")), IIf(ExclusiveF, 1, 0), TOC, "")
                            End If
                        Else
                            If CheckDuplicateF = 1 Then
                                rs = db.OpenQueryDef("QCheckObjectInsured_Upload", adOpenForwardonly, REGID, AFLDID(i), AVALUEID(i), Inception, Expiry, tostr(rsBatch.fields("RefNo")), IIf(ExclusiveF, 1, 0), TOC, IIf(MasterF, RegNo, ""), "", "", IIf(MasterF, 1, 0))
                            Else
                                rs = db.OpenQueryDef("QCheckObjectInsured_Upload", adOpenForwardonly, "", "", "", Inception, Expiry, tostr(rsBatch.fields("RefNo")), IIf(ExclusiveF, 1, 0), TOC, IIf(MasterF, RegNo, ""), "", "", IIf(MasterF, 1, 0))
                            End If
                        End If
                        If Not rs.Eof Then
                            If toval(rs.fields("UniqueRefNoF")) Then
                                ErrMsg = ErrMsg & "Possible Duplicate Reference No (" & tostr(rsBatch.fields("RefNo")) & ") !" & vbCrLf
                            Else
                                ErrMsg = ErrMsg & "Possible Duplicate Object (" & AFLDID(i) & "-" & AVALUEID(i) & ") !" & vbCrLf
                            End If
                            ErrMsg = ErrMsg & " in Quotation No. " & rs.fields("Quotation No") & " , CI No. " & rs.fields("CI No") & ", Policy No. " & rs.fields("Policy No") & vbCrLf
                            Exit For
                        End If
                    Next

                    ' Check Duplicate in SysBatchSC
                    rs = db.OpenQueryDef("QCheck_Object_SysBatchUp", adOpenForwardonly, tostr(rsBatch.fields("OBJ_INFO_01")), tostr(rsBatch.fields("OBJ_INFO_02")), tostr(rsBatch.fields("OBJ_INFO_03")), tostr(rsBatch.fields("OBJ_INFO_04")), tostr(rsBatch.fields("OBJ_INFO_05")), tostr(rsBatch.fields("OBJ_INFO_06")), tostr(rsBatch.fields("OBJ_INFO_07")), tostr(rsBatch.fields("OBJ_INFO_08")), tostr(rsBatch.fields("OBJ_INFO_09")), tostr(rsBatch.fields("OBJ_INFO_10")), tostr(rsBatch.fields("OBJ_INFO_11")), tostr(rsBatch.fields("OBJ_INFO_12")), tostr(rsBatch.fields("OBJ_INFO_13")), tostr(rsBatch.fields("OBJ_INFO_14")), tostr(rsBatch.fields("OBJ_INFO_15")), tostr(rsBatch.fields("DESCRIPTION1")), tostr(rsBatch.fields("DESCRIPTION2")), tostr(rsBatch.fields("DESCRIPTION3")), tostr(rsBatch.fields("DESCRIPTION4")), tostr(rsBatch.fields("DESCRIPTION5")), tostr(rsBatch.fields("DESCRIPTION6")), tostr(rsBatch.fields("DESCRIPTION7")), tostr(rsBatch.fields("DESCRIPTION8")), tostr(rsBatch.fields("DESCRIPTION9")), tostr(rsBatch.fields("DESCRIPTION10")), tostr(rsBatch.fields("DESCRIPTION11")), tostr(rsBatch.fields("DESCRIPTION12")), tostr(rsBatch.fields("DESCRIPTION13")), tostr(rsBatch.fields("DESCRIPTION14")), tostr(rsBatch.fields("DESCRIPTION15")))
                    If Not rs.Eof Then
                        ErrMsg = ErrMsg & "Duplicate in SysBatch - "
                        ErrMsg = ErrMsg & " BID : " & tostr(rsBatch.fields("BID"))
                        ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("RegNo")) = "", "", " RegNo. " & tostr(rsBatch.fields("RegNo")))
                        ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("PolicyNo")) = "", "", " PolicyNo. " & tostr(rsBatch.fields("PolicyNo")))
                        ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("CertificateNo")) = "", "", " CertificateNo. " & tostr(rsBatch.fields("CertificateNo")))
                        ErrMsg = ErrMsg & IIf(tostr(rsBatch.fields("RefNo")) = "", "", " Ref No." & tostr(rsBatch.fields("RefNo")))
                        ErrMsg = ErrMsg & vbCrLf
                    End If

                    If tostr(GetAppSetting("ShowInfoWhenDuplicate")) = "TSI" AndAlso InStr(ErrMsg, "Duplicate") <> 0 Then
                        rs = db.OpenRemoteSet("Select dbo.fn_GetTotalSumInsured('" & Format(Inception, "MM/DD/YYYY") & "','" & REGID & "','" & SFLDID & "','" & SVALUEID & "',-1) as TSI")
                        ErrMsg = ErrMsg & " (Total Accumulated SI : " & Format(toval(rs.fields("TSI")), "###,###,###,##0.00") & ")"
                    End If

                    If Not db.ReleaseLockedObject("DUPL_OBJECT_" & LockedKey) Then Throw New Exception("Can't Release Locked Object!")
                End If
            End If

            If ErrMsg <> "" Then
                Check_Entry_Object_UP = False
            Else
                Check_Entry_Object_UP = True
            End If
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function

    Private Function SearchMapValue(ByVal MapCode As String, ByVal ValueFrom As String, ByVal FieldTo As String, ByVal FieldFrom As String, ByVal StrictF As Boolean, ByVal MatchLikeF As Boolean) As String
        Dim rs As RemoteSet
        Dim sql As String = ""
        Try
            If tostr(ValueFrom) <> "" Then
                If MatchLikeF = False Then
                    sql = "select Top 1 VALUETO from Map_Value as MV where FIELDTO  = '" & FieldTo & "' and FieldFrom = '" & FieldFrom & "' and ValueFrom = '" & ValueFrom & "' and MapCode = '" & MapCode & "'"
                Else
                    sql = "select Top 1 VALUETO from Map_Value as MV where FIELDTO  = '" & FieldTo & "' and FieldFrom = '" & FieldFrom & "' and '" & ValueFrom & "' Like '%'+ValueFrom+'%' and MapCode = '" & MapCode & "'"
                    sql = sql & " Order By Case When ValueFrom='" & ValueFrom & "' Then 1 else 0 end desc, difference('" & ValueFrom & "',ValueFrom) Desc, len(ValueFrom) asc"
                End If
                rs = db.OpenRemoteSet(sql)
                If rs.Eof Then
                    If StrictF Then
                        SearchMapValue = "#ERROR#"
                        Exit Function
                    Else
                        SearchMapValue = ValueFrom
                        Exit Function
                    End If
                Else
                    SearchMapValue = tostr(rs.fields("VALUETO"))
                    Exit Function
                End If
            End If

            Return ValueFrom
        Catch ex As Exception
            SearchMapValue = "#ERROR#" & ex.Message
        End Try
    End Function
    Private Function InsertSysBatch(ByVal MapGroup As String, ByVal MapCode As String, ByVal BID As Long, ByVal PDate As Date, ByVal FieldTo() As Object, ByVal FieldFrom() As Object, ByVal VariableT() As Object, ByVal CompulsoryF() As Boolean, ByVal SpaceF() As Boolean, ByVal UCaseF() As Boolean, ByVal MapValueF() As Boolean, ByVal DefValue() As Object, ByVal Param1 As Object, ByVal Param2 As Object, ByVal Func As Object, ByVal StrictF As Object, ByVal MatchLikeF As Object, ByRef Findex() As Object, ByRef fbuffer() As Object, ByRef ErrMsg As String, Optional ByVal tPrefix As String = "") As Boolean
        ErrMsg = ""
        Try
            Dim Value As Object
            Dim rsto As RemoteSet
            Dim rstoExt As RemoteSet
            Dim rstoExt_1 As RemoteSet
            Dim i As Long
            Dim j As Long

            rsto = db.OpenRemoteSet("Select SysBatch.* from " & tPrefix & "SysBatch" & MapGroup & " SysBatch where BID=" & BID)
            If rsto Is Nothing Then Throw New Exception(db.ErrDesc)
            If rsto.Eof Then
                rsto.AddNew()
            Else
                rsto.Edit()
            End If

            rstoExt = db.OpenRemoteSet("Select SysBatch.* from " & tPrefix & "SysBatch" & MapGroup & "_Ext SysBatch where BID=" & BID)
            If rstoExt Is Nothing Then Throw New Exception(db.ErrDesc)
            If rstoExt.Eof Then
                rstoExt.AddNew()
            Else
                rstoExt.Edit()
            End If

            rstoExt_1 = db.OpenRemoteSet("Select SysBatch.* from " & tPrefix & "SysBatch" & MapGroup & "_Ext_1 SysBatch where BID=" & BID)
            If rstoExt_1 Is Nothing Then Throw New Exception(db.ErrDesc)
            If rstoExt_1.Eof Then
                rstoExt_1.AddNew()
            Else
                rstoExt_1.Edit()
            End If


            j = FieldTo.GetUpperBound(0)

            For i = 1 To j
                If FieldTo(i) <> "" Then
                    Value = tostr(GetFieldValue(fbuffer(GetFieldIndex(FieldTo(i), Findex))))

                    Select Case UCase(Func(i))
                        Case "MID"
                            Value = Mid(Value, toval(Param1(i)), toval(Param2(i)))
                        Case "LEFT"
                            Value = Left(Value, toval(Param1(i)))
                        Case "RIGHT"
                            Value = Right(Value, toval(Param1(i)))
                        Case "ADD"
                            ' see below
                    End Select

                    If MapValueF(i) Then
                        Value = SearchMapValue(MapCode, Value, tostr(FieldTo(i)), tostr(FieldFrom(i)), toval(StrictF(i)), toval(MatchLikeF(i)))
                        If Left(Value, 7) = "#ERROR#" Then
                            ErrMsg = ErrMsg & "Field " & FieldFrom(i) & " value " & GetFieldValue(fbuffer(GetFieldIndex(FieldTo(i), Findex))) & " not found in Map Value !" & vbCrLf
                            Throw New Exception(ErrMsg)
                        End If
                    End If

                    If Not SpaceF(i) Then
                        Value = Replace(Value, " ", "")
                    End If

                    Value = Trim(Value)

                    If UCaseF(i) Then
                        Value = UCase(Value)
                    End If

                    ' Default Value
                    If tostr(DefValue(i)) <> "" Then
                        If Value = "" Then
                            Value = tostr(DefValue(i))
                        ElseIf Left(UCase(FieldTo(i)), 9) = "OBJ_INFO_" Then
                            Value = tostr(DefValue(i)) & Chr(16) & Value
                        End If
                    End If

                    If CompulsoryF(i) Then
                        If Value = "" Then
                            ErrMsg = ErrMsg & FieldFrom(i) & " is Mandatory Field !" & vbCrLf
                        End If
                    End If

                    Select Case Trim(VariableT(i))
                        Case "N"
                            If tostr(Value) <> "" AndAlso Not IsNumeric(Value) Then
                                ErrMsg = ErrMsg & FieldFrom(i) & " Have Invalid Numeric Format !" & vbCrLf
                            Else
                                Value = toval(Value)
                            End If
                        Case "D"
                            If tostr(Value) <> "" AndAlso Not IsDate(Value) Then
                                ErrMsg = ErrMsg & FieldFrom(i) & " Have Invalid Date Format !" & vbCrLf
                            ElseIf IsDate(Value) Then
                                Value = todate(Value)
                            End If
                        Case "B"
                            If tostr(Value) <> "" AndAlso Not (CBool(toval(Value)) = True Or CBool(toval(Value)) = False) Then
                                ErrMsg = ErrMsg & FieldFrom(i) & " Have Invalid Boolean Format !" & vbCrLf
                            Else
                                Value = CBool(toval(Value))
                            End If
                        Case Else

                    End Select

                    Select Case UCase(Func(i))
                        Case "MID"
                            ' see above
                        Case "LEFT"
                            ' see above
                        Case "RIGHT"
                            ' see above
                        Case "ADD"
                            If IsDate(Value) Then
                                Value = DateAdd(DateInterval.Day, toval(Param1(i)), Value)
                            ElseIf IsNumeric(Value) Then
                                Value = Value + toval(Param1(i))
                            End If
                    End Select

                    If ErrMsg = "" And tostr(Value) <> "" Then
                        If rsto.fields_Name(FieldTo(i)) <> "" Then
                            rsto.fields(FieldTo(i)) = Value
                        ElseIf rstoExt.fields_Name(FieldTo(i)) <> "" Then
                            rstoExt.fields(FieldTo(i)) = Value
                        ElseIf rstoExt_1.fields_Name(FieldTo(i)) <> "" Then
                            rstoExt_1.fields(FieldTo(i)) = Value
                        End If
                    End If
                End If
            Next i

            If ErrMsg = "" Then
                rsto.fields("BID") = BID
                rstoExt.fields("BID") = BID
                rstoExt_1.fields("BID") = BID
                rsto.fields("TRDate") = PDate
                rsto.fields("LinkBatchNo") = tostr(GetFieldValue(fbuffer(GetFieldIndex("LinkBatchNo", Findex))))
                rsto.fields("BatchNo") = tostr(GetFieldValue(fbuffer(GetFieldIndex("BatchNo", Findex))))
                rsto.fields("ANO") = toval(GetFieldValue(fbuffer(GetFieldIndex("ANO", Findex))))
                rsto.fields("Status") = "N"
                rsto.fields("ErrMsg") = ""

                If tostr(rsto.fields("Expiry")) = "" And tostr(rsto.fields("Inception")) <> "" Then
                    rsto.fields("Expiry") = DateAdd(DateInterval.Month, toval(rsto.fields("NoOfMonths_1")) + toval(rsto.fields("NoOfMonths_2")), todate(rsto.fields("Inception")))
                End If
                If tostr(rsto.fields("CertificateNo")) = "" Then
                    rsto.fields("CertificateNo") = tostr(GetFieldValue(fbuffer(GetFieldIndex("CERTIFICATENO", Findex))))
                End If
                If Not toval(rsto.fields("EndorseF")) Then
                    rsto.fields("EndorseF") = toval(GetFieldValue(fbuffer(GetFieldIndex("EndorseF", Findex))))
                End If
                If tostr(rsto.fields("ASource")) = "" Then
                    rsto.fields("ASource") = tostr(GetFieldValue(fbuffer(GetFieldIndex("ASource", Findex))))
                End If
                If tostr(rsto.fields("ASource")) = "" Then
                    rsto.fields("Asource") = tostr("UPLOAD_" & MapGroup)
                End If
                If Not rsto.Update Then Throw New Exception(rsto.ErrDesc)
                If Not rstoExt.Update Then Throw New Exception(rstoExt.ErrDesc)
                If Not rstoExt_1.Update Then Throw New Exception(rstoExt.ErrDesc)
            Else
                Throw New Exception(ErrMsg)
            End If

            Return True
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function

    Private Function SQLBuilder(ByVal MapCode As String, ByVal PDate As Date, ByVal MapType As String) As String
        Dim rs As RemoteSet
        Dim ValueFrom As String
        Dim tFunc As String
        Dim sFunc As String
        Dim oFunc As String
        Dim Func As String
        Dim sSQL As String
        Dim TSql As String
        Dim sql As String
        Dim FieldTo As String
        Dim Opt As String
        Dim FieldType As String
        Dim MapRefID As Long = 0
        Dim tAgeFunc As String = ""
        Try
            TSql = ""
            sql = "select Mr.MapRefID, Mrc.FieldTo, MF.FieldType, Mrc.ValueFrom, isnull(Mrc.Operator,'Like') as Operator, Mrc.Func as Func, Mrc.Param1 as Param1, Mrc.Param2 as Param2 "
            sql = sql & " from Map_Reference MR Inner Join map_reference_constraint mrc on (MRC.MapRefId=MR.MapRefID) Inner Join map_field MF on (MF.MapCode=Mr.MapCode and MF.FieldFrom=mrc.FieldFrom and MF.FieldTo=mrc.FieldTo)"
            sql = sql & " where mr.mapcode = '" & MapCode & "' and Mr.MapType = '" & MapType & "' and Mr.AllowedF = 1 "
            sql = sql & " Order By Mr.MapRefID, Mrc.FieldTo, Mrc.Func, isnull(Mrc.Operator,'Like')"
            rs = db.OpenRemoteSet(sql)
            Do While Not rs.Eof
                sSQL = ""
                MapRefID = toval(rs.fields("MapRefID"))
                Do While Not rs.Eof AndAlso MapRefID = toval(rs.fields("MapRefID"))
                    sFunc = ""
                    FieldTo = rs.fields("FieldTo")
                    Func = rs.fields("Func")
                    FieldType = rs.fields("FieldType")
                    Do While Not rs.Eof AndAlso MapRefID = toval(rs.fields("MapRefID")) AndAlso FieldTo = tostr(rs.fields("FieldTo")) AndAlso Func = tostr(rs.fields("Func"))
                        oFunc = ""
                        Opt = tostr(rs.fields("Operator"))
                        Do While Not rs.Eof AndAlso MapRefID = toval(rs.fields("MapRefID")) AndAlso FieldTo = tostr(rs.fields("FieldTo")) AndAlso Func = tostr(rs.fields("Func")) AndAlso Opt = tostr(rs.fields("Operator"))
                            ValueFrom = rs.fields("ValueFrom")
                            If ValueFrom = "" And Trim(UCase(Opt)) = "LIKE" Then ValueFrom = "%"
                            Select Case UCase(Func)
                                Case "AGE"
                                    If UCase(FieldTo) = "INCEPTION" Or UCase(FieldTo) = "EXPIRY" Or UCase(FieldType) = "D" Then
                                        If tostr(rs.fields("Param1")) = "" Then
                                            tFunc = "cast(dbo.Fn_Age(t." & FieldTo & ",'" & Format(todate(Today.Date), "YYYY/MM/DD") & "', 2) as float)"
                                        Else
                                            tFunc = "cast(dbo.Fn_Age(t." & FieldTo & ",'" & Format(todate(Today.Date), "YYYY/MM/DD") & "'," & tovalSF(toval(rs.fields("Param1"))) & ") as float)"
                                        End If
                                        If tAgeFunc = "" OrElse tFunc = tAgeFunc Then
                                            tAgeFunc = tFunc
                                            tFunc = "Age.Age"
                                        End If
                                    Else
                                        tFunc = "(cast(" & tostr(Year(Today.Date)) & " as Float) - cast(t." & FieldTo & " as Float))"
                                    End If
                                Case "AGELAST"
                                    If UCase(FieldTo) = "INCEPTION" Or UCase(FieldTo) = "EXPIRY" Or UCase(FieldType) = "D" Then
                                        If tostr(rs.fields("Param1")) = "" Then
                                            tFunc = "cast(dbo.Fn_Age(t." & FieldTo & ",t.Expiry, 2) as float)"
                                        Else
                                            tFunc = "cast(dbo.Fn_Age(t." & FieldTo & ",t.Expiry," & tovalSF(toval(rs.fields("Param1"))) & ") as float)"
                                        End If
                                        If tAgeFunc = "" OrElse tFunc = tAgeFunc Then
                                            tAgeFunc = tFunc
                                            tFunc = "Age.Age"
                                        End If
                                    Else
                                        tFunc = "(cast(year(t.Expiry) as float) - cast(t." & FieldTo & " as Float))"
                                    End If
                                Case "AGESTART"
                                    If UCase(FieldTo) = "INCEPTION" Or UCase(FieldTo) = "EXPIRY" Or UCase(FieldType) = "D" Then
                                        If tostr(rs.fields("Param1")) = "" Then
                                            tFunc = "cast(dbo.Fn_Age(t." & FieldTo & ",t.Inception,2) as float)"
                                        Else
                                            tFunc = "cast(dbo.Fn_Age(t." & FieldTo & ",t.Inception," & tovalSF(toval(rs.fields("Param1"))) & ") as float)"
                                        End If
                                        If tAgeFunc = "" OrElse tFunc = tAgeFunc Then
                                            tAgeFunc = tFunc
                                            tFunc = "Age.Age"
                                        End If
                                    Else
                                        tFunc = "(cast(Year(t.Inception) as float) - cast(t." & FieldTo & " as Float))"
                                    End If
                                Case "LEFT"
                                    tFunc = "(left(t." & FieldTo & "," & tovalSF(rs.fields("Param1")) & "))"
                                Case "RIGHT"
                                    tFunc = "(Right(t." & FieldTo & "," & tovalSF(rs.fields("Param1")) & "))"
                                Case "MID"
                                    tFunc = "(substring(t." & FieldTo & "," & tovalSF(rs.fields("Param1")) & "," & tovalSF(rs.fields("Param2")) & "))"
                                Case "CONCAT"
                                    tFunc = "(cast(t." & FieldTo & " as varchar(255)) + cast('" & tostr(rs.fields("Param1")) & "' as varchar(255)) + cast('" & tostr(rs.fields("Param2")) & "' as varchar(255)))"
                                Case "ADD"
                                    tFunc = "(cast(t." & FieldTo & " as float) + cast('" & tovalSF(rs.fields("Param1")) & "' as float) + cast('" & tovalSF(rs.fields("Param2")) & "' as float))"
                                Case ""
                                    If UCase(FieldType) = "N" Then
                                        tFunc = "cast(t." & FieldTo & " as float)"
                                    Else
                                        tFunc = "t." & FieldTo
                                    End If
                                Case Else
                                    Throw New Exception("UnKnown Map-Reference Function !")
                            End Select
                            tFunc = "(" & tFunc & " " & Opt & " " & "'" & ValueFrom & "')"
                            If oFunc = "" Then
                                oFunc = tFunc
                            Else
                                oFunc = oFunc & " OR " & tFunc
                            End If
                            rs.MoveNext()
                        Loop
                        If sFunc = "" Then
                            sFunc = "(" & oFunc & ")"
                        Else
                            sFunc = sFunc & " AND " & "(" & oFunc & ")"
                        End If
                    Loop
                    If sSQL = "" Then
                        sSQL = "Select " & MapRefID & " as MapRefID Where MR.MapRefID=" & MapRefID
                    End If
                    sSQL = sSQL & " and (" & sFunc & ")"
                Loop
                If TSql = "" Then
                    TSql = sSQL
                Else
                    TSql = TSql & " Union All " & sSQL
                End If
            Loop

            If TSql <> "" Then
                If tAgeFunc = "" Then
                    TSql = "Select Top 1 Mr.* from (" & TSql & ") Mr"
                Else
                    TSql = "Select Top 1 Mr.* from (Select " & tAgeFunc & " as Age) Age Cross Apply (" & TSql & ") Mr"
                End If
            End If

            SQLBuilder = TSql
            Exit Function
        Catch ex As Exception
            SQLBuilder = ""
            StrMsg = ex.Message
        End Try
    End Function

    Private Function Generate_Accumulation_Register(ByVal FLDID As String, ByVal ValueID As String, ByVal Description As String, ByVal RFLDID As String, ByVal RVALUEID As String) As String
        Dim rs As RemoteSet
        Dim rsH As RemoteSet
        Dim rsD As RemoteSet
        Dim SAccReg As Integer
        Dim SFLDID As String
        Dim SVALUEID As String
        Dim i As Integer
        Dim j As Integer
        Dim k As Integer

        On Error GoTo ErrMsg
        rs = db.OpenRemoteSet("Select * from GenDTab Where FLDID='" & FLDID & "' and (ValueID='" & ValueID & "' or Description='" & Description & "')")
        If rs.Eof Then
            rsD = db.OpenRemoteSet("Select * from GenDTab Where FLDID='" & RFLDID & "' and ValueID='" & RVALUEID & "'")
            If Not rsD.Eof Then
                rs.AddNew()
                rsH = db.OpenQueryDef("QGENHTAB_GENHTAB", adOpenForwardonly, FLDID)
                SAccReg = toval(rsH.fields("SAccReg"))
                For i = 1 To 15
                    rs.fields("FLDID" & i) = tostr(rsH.fields("FLDID" & i))
                    rs.fields("ValueID" & i) = ""
                    rs.fields("ValueDesc" & i) = ""
                    If rs.fields("FLDID" & i) <> "" Then
                        If rs.fields("FLDID" & i) = RFLDID Then
                            rs.fields("VALUEID" & i) = rsD.fields("VALUEID")
                            rs.fields("VALUEDESC" & i) = rsD.fields("Description")
                            j = i - 1
                            Do While j >= 1
                                If rs.fields("FLDID" & j) <> "" AndAlso rs.fields("VALUEID" & j) = "" AndAlso rs.fields("VALUEDESC" & j) = "" Then
                                    For k = 1 To 15
                                        If rsD.fields("FLDID" & k) <> "" Then
                                            If rs.fields("FLDID" & j) = rsD.fields("FLDID" & k) Then
                                                rs.fields("VALUEID" & j) = rsD.fields("VALUEID" & k)
                                                rs.fields("VALUEDESC" & j) = rsD.fields("VALUEDESC" & k)
                                            End If
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                                j = j - 1
                            Loop

                            j = i + 1
                            Do While j <= 15
                                If rs.fields("FLDID" & j) <> "" AndAlso rs.fields("VALUEID" & j) = "" AndAlso rs.fields("VALUEDESC" & j) = "" Then
                                    For k = 1 To 15
                                        If rsD.fields("FLDID" & k) <> "" Then
                                            If rs.fields("FLDID" & j) = rsD.fields("FLDID" & k) Then
                                                rs.fields("VALUEID" & j) = rsD.fields("VALUEID" & k)
                                                rs.fields("VALUEDESC" & j) = rsD.fields("VALUEDESC" & k)
                                            End If
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                                j = j + 1
                            Loop
                            Exit For
                        End If
                    Else
                        Exit For
                    End If
                Next

                Dim rsDD As RemoteSet
                For i = 1 To 15
                    If rsD.fields("FLDID" & i) <> "" Then
                        If rsD.fields("FLDID" & i) <> "" And rsD.fields("VALUEID" & i) <> "" Then
                            rsDD = db.OpenRemoteSet("Select * from GenDTab Where FLDID='" & rsD.fields("FLDID" & i) & "' and ValueID='" & rsD.fields("VALUEID" & i) & "'")
                            If Not rsDD.Eof Then
                                For j = 1 To 15
                                    If rs.fields("FLDID" & j) <> "" Then
                                        If rs.fields("VALUEDESC" & j) = "" Then
                                            For k = 1 To 15
                                                If rsDD.fields("FLDID" & k) <> "" Then
                                                    If rs.fields("FLDID" & j) = rsDD.fields("FLDID" & k) Then
                                                        rs.fields("VALUEID" & j) = rsDD.fields("VALUEID" & k)
                                                        rs.fields("VALUEDESC" & j) = rsDD.fields("VALUEDESC" & k)
                                                    End If
                                                Else
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                    Else
                                        Exit For
                                    End If
                                Next
                            End If
                        End If
                    Else
                        Exit For
                    End If
                Next

                Dim ValueArr() As String = Nothing
                Dim Construct_Value As String
                SFLDID = ""
