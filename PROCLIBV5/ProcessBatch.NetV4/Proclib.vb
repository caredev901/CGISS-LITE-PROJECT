        If Installment >= 1 And Installment <= 24 Then
            For i = 1 To Installment
                If IsDate(GetFieldValue(FBuffer(GetFieldIndex("IDATE_" & i, Findex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("IDATE_" & i, Findex)))), "MM/DD/YYYY") <> "01/01/1900" Then
