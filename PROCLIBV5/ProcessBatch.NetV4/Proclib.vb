                    Else
                        StrMsg = StrMsg & "Policy Data Not Found !" & vbCrLf
                    End If
                Else
                    StrMsg = StrMsg & "Policy Data Not Found !" & vbCrLf
                End If

                If StrMsg = "" Then

                    Dim DumpProfileF As Boolean = True
                    Dim CreateProfileF As Boolean = True

                    SQL = "SELECT top 1 MR.TOPRO, MR.Refno,Mr.PriorityF,MR.MapRefId,Mr.DumpProfileF,Mr.CreateProfileF,MR.InsuredF FROM Map_Reference MR inner join SysBatch" & MapGroup & " as t on (1=1) "
