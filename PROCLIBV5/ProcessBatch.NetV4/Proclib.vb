    Private Function GetDefaultCountry() As String
        Dim rs As RemoteSet
        Dim Country As String
        rs = db.OpenRemoteSet("Select Top 1 Country from Country Where AllowedF=1 and DefaultF=1")
        Country = tostr(rs.fields("Country"))
        If Country = "" Then Country = "INA"
        GetDefaultCountry = Country
    End Function
    Private Function GetDefaultProfileVAT(ByVal LOB As String) As Double
        Dim rs As RemoteSet
        Dim VAT As Double
        rs = db.OpenRemoteSet("Select Top 1 VAT from Profile Where DumpF=0 and RestrictedF=0 and VATF=1 and VAT<>0 and LOB='" & LOB & "'")
        VAT = toval(rs.fields("VAT"))
        If VAT = 0 Then VAT = 10
        GetDefaultProfileVAT = VAT
    End Function
    Private Function Create_Profile(ByVal fName As String, ByVal mName As String, ByVal lName As String, ByVal pName As String, ByVal Address_1 As String, ByVal pBranch As String, ByVal pType As String, ByVal DumpF As Boolean, Optional ByVal RefID As String = "", Optional ByVal VatF As Boolean = False, Optional ByVal BVatF As Boolean = False, Optional ByVal TVatF As Boolean = False, Optional ByVal TaxF As Boolean = False, Optional ByVal TAXTYPE As String = "", Optional ByVal TAXID As String = "", Optional ByVal TAXNAME As String = "", Optional ByVal TAXADDRESS As String = "", Optional ByVal CORPORATEF As Boolean = False, Optional ByVal RELIGION As String = "", Optional ByVal PHONE_1 As String = "", Optional ByVal MOBILE_1 As String = "", Optional ByVal EMAIL As String = "", Optional ByVal BIRTHDATE As String = "", Optional ByVal Address_2 As String = "", Optional ByVal Address_3 As String = "", Optional ByVal Phone_2 As String = "", Optional ByVal Mobile_2 As String = "", Optional ByVal Gender As String = "", Optional ByVal ID_No As String = "", Optional ByVal ID_Name As String = "", Optional ByVal ID_Type As String = "", Optional ByVal City As String = "", Optional ByVal Country As String = "", Optional ByVal Area As String = "", Optional ByVal Fax_1 As String = "", Optional ByVal Employment As String = "", Optional ByVal LOB As String = "", Optional ByVal Purpose As String = "", Optional ByVal Income As String = "", Optional ByVal OtherIncome As String = "", Optional ByVal Zipcode As String = "", Optional ByVal Province As String = "", Optional ByVal BIRTHPLACE As String = "", Optional ByVal WNIF As Boolean = False, Optional ByVal Citizen As String = "", Optional ByVal PassPortNo As String = "", Optional ByVal CGroup As String = "", Optional ByVal Remark As String = "", Optional ByVal RedFlag As Boolean = False, Optional ByVal ConsentOnDataKeepByCompanyF As Boolean = False, Optional ByVal ConsentOnDataPrivacyToThirdPartyF As Boolean = False, Optional ByVal ConsentOnProductAndServiceOfferingF As Boolean = False, Optional ByVal CAddress As String = "", Optional ByVal CPhone_1 As String = "", Optional ByVal Marital As String = "", Optional ByVal MothersName As String = "", Optional ByVal xProfileID As String = "", Optional ByVal ConsentIDAgreed As Object = Nothing) As String

        Dim rs As RemoteSet
        Dim TStr As String
        Dim tpos As Integer
        Dim ID As String = ""
        Dim VerifiedF As Boolean = True

        If pName = "" AndAlso RefID = "" AndAlso xProfileID = "" Then
            Create_Profile = ""
            Exit Function
        End If

        On Error GoTo errmsg

        If pName <> "" AndAlso (fName = "") Then
            TStr = pName
            tpos = InStr(TStr, " ")
            If toval(tpos) <> 0 Then
                fName = Left(TStr, tpos - 1)
                TStr = Trim(Mid(TStr, tpos + 1, Len(TStr) - tpos))
                tpos = InStr(TStr, " ")
                If toval(tpos) <> 0 Then
                    mName = Left(TStr, tpos - 1)
                    TStr = Trim(Mid(TStr, tpos + 1, Len(TStr) - tpos))
                    lName = TStr
                Else
                    mName = TStr
                End If
            Else
                fName = TStr
            End If
        Else
            pName = fName & " " & mName & " " & lName
        End If

        If Country = "" Then Country = GetDefaultCountry()

        If Country <> "" Then
            rs = db.OpenRemoteSet("Select Country from Country Where Country='" & Country & "'")
            If rs.Eof Then
                StrMsg = "Country : '" & Country & "', not found !"
                GoTo errmsg
            End If
        End If

        If Area <> "" Then
            rs = db.OpenRemoteSet("Select Area from Area Where Area='" & Area & "'")
            If rs.Eof Then
                StrMsg = "Area : '" & Area & "', not found !"
                GoTo errmsg
            End If
        End If

        If City <> "" Then
            rs = db.OpenRemoteSet("Select City from City Where City='" & City & "'")
            If rs.Eof Then
                StrMsg = "City : '" & City & "', not found !"
                GoTo errmsg
            End If
        End If

        If Province <> "" Then
            rs = db.OpenRemoteSet("Select Province from Province Where Province='" & Province & "'")
            If rs.Eof Then
                StrMsg = "Province : '" & Province & "', not found !"
                GoTo errmsg
            End If
        End If

        If CGroup <> "" Then
            rs = db.OpenRemoteSet("Select CGroup from CGroup Where CGroup='" & CGroup & "'")
            If rs.Eof Then
                StrMsg = "Company Group : '" & CGroup & "', not found !"
                GoTo errmsg
            End If
        End If

        Dim pAddress As String = ""
        If Address_1 <> "" OrElse Address_2 <> "" OrElse Address_3 <> "" Then
            pAddress = Address_1 & vbCrLf & Address_2 & vbCrLf & Address_3
        End If

        If RefID <> "" Then
            rs = db.OpenRemoteSet("Select Top 1 ID from Profile Where ID='" & RefID & "'")
            If rs.Eof Then
                rs = db.OpenRemoteSet("Select Top 1 ID from Profile Where RefID='" & RefID & "'")
            End If
            If rs.Eof Then
                rs = db.OpenRemoteSet("Select Top 1 ID from PAlias Where MRefID='" & RefID & "'")
            End If
            ID = rs.fields("ID")
        ElseIf xProfileID <> "" Then
            rs = db.OpenRemoteSet("Select Top 1 ID from Profile Where xProfileID='" & xProfileID & "'")
            ID = rs.fields("ID")
        ElseIf pName <> "" And pAddress <> "" Then
            rs = db.OpenRemoteSet("Select Top 1 ID from PAlias Where (Name='" & pName & "' and Address Like '" & pAddress & "%')")
            ID = rs.fields("ID")
        End If

        If ID = "" Then
            Dim SQL As String = ""
            If CORPORATEF = False And ID_No <> "" Then
                SQL = "Select Top 1 P1.ID from Profile P1, Profile_ext P2 where P1.ID = P2.ID and P2.ID_No='" & ID_No & "'"
                If pName <> "" Then
                    SQL = SQL & " and P1.Name = '" & pName & "'"
                End If
            ElseIf CORPORATEF = True And TAXID <> "" Then
                SQL = "Select Top 1 P1.ID from Profile P1 where P1.TaxID = '" & TAXID & "'"
                If pName <> "" Then
                    SQL = SQL & " and P1.Name = '" & pName & "'"
                End If
            ElseIf pName <> "" And EMAIL <> "" Then
                SQL = "Select Top 1 P1.ID from Profile P1 where P1.Name = '" & pName & "' and P1.Email='" & EMAIL & "'"
            ElseIf pName <> "" And BIRTHDATE <> "" Then
                SQL = "Select Top 1 P1.ID from Profile P1, Profile_ext P2 where P1.ID = P2.ID and P1.name = '" & pName & "' and P2.BirthDate = '" & Format(todate(BIRTHDATE), "MM/DD/YYYY") & "' and P2.Gender Like '" & Gender & "%'"
            ElseIf pName <> "" And pAddress <> "" Then
                SQL = "Select Top 1 P1.ID from Profile P1 where P1.Name = '" & pName & "' and P1.Address_1+char(13)+char(10)+P1.Address_2+char(13)+char(10)+P1.Address_3 Like '" & pAddress & "%'"
            End If
            If SQL <> "" Then
                rs = db.OpenRemoteSet(SQL)
                ID = rs.fields("ID")
            End If
        End If

        Dim UpdateFlag As Boolean = False

        rs = db.OpenRemoteSet("select * from profile where ID='" & ID & "'")
        If rs.Eof Then
            Select Case pType
                Case "D", ""
                    pType = "D"     ' Direct
                    If TAXTYPE = "" Then
                        If CORPORATEF Then
                            TAXTYPE = GetTaxType("PASAL23")
                        Else
                            TAXTYPE = GetTaxType("PASAL21")
                        End If
                    End If
                Case "M"
                    pType = "M"     ' Intermediaries
                    If TAXTYPE = "" Then
                        If CORPORATEF Then
                            TAXTYPE = GetTaxType("PASAL23")
                        Else
                            TAXTYPE = GetTaxType("PASAL21")
                        End If
                    End If
                Case "I"
                    pType = "I"     ' Insurance
                    If TAXTYPE = "" Then TAXTYPE = GetTaxType("PASAL23")
                Case "O"
                    pType = "O"     ' Reinsurance
                    If TAXTYPE = "" Then TAXTYPE = GetTaxType("PASAL23")
                Case Else
                    pType = "T"     ' Others
                    If TAXTYPE = "" Then
                        If CORPORATEF Then
                            TAXTYPE = GetTaxType("PASAL23")
                        Else
                            TAXTYPE = GetTaxType("PASAL21")
                        End If
                    End If
            End Select

            UpdateFlag = True
            rs.AddNew()
            rs.fields("Name") = pName
            rs.fields("FirstName") = fName
            rs.fields("MidName") = mName
            rs.fields("LastName") = lName
            rs.fields("Address_1") = Address_1
            rs.fields("Address_2") = Address_2
            rs.fields("Address_3") = Address_3
            rs.fields("LOB") = LOB
            rs.fields("pType") = pType
            rs.fields("PHONE_1") = PHONE_1
            rs.fields("PHONE_2") = Phone_2
            rs.fields("MOBILE_1") = MOBILE_1
            rs.fields("MOBILE_2") = Mobile_2
            rs.fields("EMAIL") = EMAIL
            rs.fields("Fax_1") = Fax_1
            rs.fields("Address_1") = Address_1
            rs.fields("RELIGION") = RELIGION
            rs.fields("CorporateF") = CORPORATEF
            rs.fields("RefID") = RefID
            rs.fields("xProfileID") = xProfileID

            If Len(Get_Branch_Alias(pBranch)) > 2 Then
                ID = Trim(db.GetNextDocNo("Pro", Today.Date, Mid(Get_AlphaNum(pType), 1, 1) + Mid(Get_AlphaNum(fName), 1, 1) + IIf(Mid(Get_AlphaNum(mName), 1, 1) = "", Mid(Get_AlphaNum(fName), 2, 1), Mid(Get_AlphaNum(mName), 1, 1))))
            Else
                ID = Trim(db.GetNextDocNo("Pro", Today.Date, Mid(Get_AlphaNum(pType), 1, 1) + Get_Branch_Alias(pBranch) + Mid(Get_AlphaNum(fName), 1, 1) + IIf(Mid(Get_AlphaNum(mName), 1, 1) = "", Mid(Get_AlphaNum(fName), 2, 1), Mid(Get_AlphaNum(mName), 1, 1))))
            End If
            If ID = "" Then GoTo errmsg
            rs.fields("ID") = ID
            rs.fields("DumpF") = DumpF
            rs.fields("Owner") = GetUserOwner(db_user)
            rs.fields("CDate") = Today.Date
            rs.fields("UserID") = db_user
            rs.fields("VatF") = VatF
            rs.fields("BVatF") = BVatF
            rs.fields("TVatF") = TVatF
            rs.fields("TaxF") = TaxF
            rs.fields("TaxType") = TAXTYPE
            If toval(rs.fields("VatF")) And toval(rs.fields("Vat")) = 0 Then
                rs.fields("Vat") = GetDefaultProfileVAT(LOB)
            End If
            If toval(rs.fields("TaxF")) And toval(rs.fields("TAX")) = 0 Then
                rs.fields("TAX") = GetTaxRate(TAXTYPE)
            End If

            If Country <> "" Then
                If rs.fields("Country") <> Country Then
                    UpdateFlag = True
                    rs.fields("Country") = Country
                End If
            End If

            If Area <> "" Then
                If rs.fields("Area") <> Area Then
                    UpdateFlag = True
                    rs.fields("Area") = Area
                End If
            End If

            If City <> "" Then
                If rs.fields("City") <> City Then
                    UpdateFlag = True
                    rs.fields("City") = City
                End If
            End If
            If TAXID <> "" Then
                If rs.fields("TaxID") <> TAXID Then
                    UpdateFlag = True
                    rs.fields("TaxID") = TAXID
                End If
            End If
            If TAXNAME <> "" Then
                If rs.fields("TAXNAME") <> TAXNAME Then
                    UpdateFlag = True
                    rs.fields("TAXNAME") = TAXNAME
                End If
            End If
            If TAXADDRESS <> "" Then
                If rs.fields("TAXADDRESS") <> TAXADDRESS Then
                    UpdateFlag = True
                    rs.fields("TAXADDRESS") = TAXADDRESS
                End If
            End If
            If Zipcode <> "" Then
                If rs.fields("ZipCode") <> Zipcode Then
                    UpdateFlag = True
                    rs.fields("ZipCode") = Zipcode
                End If
            End If
            If Province <> "" Then
                If rs.fields("Province") <> Province Then
                    UpdateFlag = True
                    rs.fields("Province") = Province
                End If
            End If
            If CGroup <> "" Then
                If rs.fields("CGroup") <> CGroup Then
                    UpdateFlag = True
                    rs.fields("CGroup") = CGroup
                End If
            End If

            If Remark <> "" Then
                If rs.fields("Remark") <> Remark Then
                    UpdateFlag = True
                    rs.fields("Remark") = Remark
                End If
            End If

            If RedFlag Then
                If toval(rs.fields("RedFlag")) <> RedFlag Then
                    UpdateFlag = True
                    rs.fields("RedFlag") = RedFlag
                End If
            End If

            If Not ConsentOnDataKeepByCompanyF Then
                ConsentOnDataKeepByCompanyF = CBool(toval(GetAppSetting("Default_ConsentOnDataKeepByCompanyF")))
            End If

            If Not ConsentOnDataPrivacyToThirdPartyF Then
                ConsentOnDataPrivacyToThirdPartyF = CBool(toval(GetAppSetting("Default_ConsentOnDataPrivacyToThirdPartyF")))
            End If

            If Not ConsentOnProductAndServiceOfferingF Then
                ConsentOnProductAndServiceOfferingF = CBool(toval(GetAppSetting("Default_ConsentOnProductAndServiceOfferingF")))
            End If

            If ConsentOnDataKeepByCompanyF Then
                If toval(rs.fields("ConsentOnDataKeepByCompanyF")) <> ConsentOnDataKeepByCompanyF Then
                    UpdateFlag = True
                    rs.fields("ConsentOnDataKeepByCompanyF") = ConsentOnDataKeepByCompanyF
                End If
            End If

            If ConsentOnDataPrivacyToThirdPartyF Then
                If toval(rs.fields("ConsentOnDataPrivacyToThirdPartyF")) <> ConsentOnDataPrivacyToThirdPartyF Then
                    UpdateFlag = True
                    rs.fields("ConsentOnDataPrivacyToThirdPartyF") = ConsentOnDataPrivacyToThirdPartyF
                End If
            End If

            If ConsentOnProductAndServiceOfferingF Then
                If toval(rs.fields("ConsentOnProductAndServiceOfferingF")) <> ConsentOnProductAndServiceOfferingF Then
                    UpdateFlag = True
                    rs.fields("ConsentOnProductAndServiceOfferingF") = ConsentOnProductAndServiceOfferingF
                End If
            End If
        Else
            rs.Edit()

            CORPORATEF = toval(rs.fields("CorporateF"))
            If VatF = True AndAlso toval(rs.fields("VatF")) = False Then
                UpdateFlag = True
                If Not Save_Log_Object("Profile", "ID", ID, "", "", "", "", "", "", "VATF", rs.fields("VATF"), VatF, "Update") Then Throw New Exception("Can't Save to Log !")
                rs.fields("VatF") = VatF
                If toval(rs.fields("VatF")) And toval(rs.fields("Vat")) = 0 Then
                    Dim VAT As Double = GetDefaultProfileVAT(LOB)
                    If Not Save_Log_Object("Profile", "ID", ID, "", "", "", "", "", "", "VAT", rs.fields("VAT"), VAT, "Update") Then Throw New Exception("Can't Save to Log !")
                    rs.fields("Vat") = VAT
                End If
