        Delivery_Address = tostr(GetFieldValue(FBuffer(GetFieldIndex("Delivery_Address", Findex))))
        Delivery_Phone = tostr(GetFieldValue(FBuffer(GetFieldIndex("Delivery_Phone", Findex))))
        Delivery_Email = tostr(GetFieldValue(FBuffer(GetFieldIndex("Delivery_Email", Findex))))
        Delivery_Method = tostr(GetFieldValue(FBuffer(GetFieldIndex("Delivery_Method", Findex))))

        If Delivery_Name <> "" Or Delivery_Email <> "" Or Delivery_Address <> "" Then
            If Delivery_Name = "" Then Delivery_Name = InsuredName
            If Not Add_DeliveryAddress(NewANO, Delivery_Name, Delivery_Address, Delivery_Phone, Delivery_Email, Delivery_Method) Then
                StrMsg = StrMsg & "Process Update Delivery Failed !" & vbCrLf
                StrMsg = StrMsg & db.ErrDesc & vbCrLf
                GoTo errmsg
            End If
        End If

        If ImmediateInforceF Then
            Dim ADate As Date
            If BackDatedF Then
