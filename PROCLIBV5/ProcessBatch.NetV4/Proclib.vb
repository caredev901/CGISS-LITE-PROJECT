                    rs = db.OpenRemoteSet("Select BackDatedDate from Branch Where Branch='" & Branch & "'")
                    ADate = todate(rs.fields("BackDatedDate"))
                End If
            Else
                If IsDate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                    ADate = todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex))))
                Else
                    ADate = Today.Date
                End If

                Dim EndDate As Date
                Dim LockedDate As Date
                EndDate = GetEndDate(Branch)
                LockedDate = GetLockedDate(Branch)
                If DateDiff(DateInterval.Day, EndDate, ADate) <= 0 Then
                    ADate = DateAdd(DateInterval.Day, 1, EndDate)
                End If

                If DateDiff(DateInterval.Day, LockedDate, ADate) <= 0 Then
                    ADate = DateAdd(DateInterval.Day, 1, LockedDate)
                End If
            End If


            db.Var_db_user = AUserID
            db.Var_db_User_Type = IIf(db.GetPrivileges("ALLOWALLPRIVILEGESINFORCE"), "SUPERVISOR", db_user_type)
            If (LANO <> -1 And Not OpenFlag) Then
                If PreInforceConditionsOK(LANO, ADate, "", BackDatedF, True, False, False, StrMsg) Then
                    If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCEMASTER", LANO, AUserID, BackDatedF, ADate) Then
                        StrMsg = "Process Inforce Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                Else
                    StrMsg = "Process Inforce Failed !" & vbCrLf & StrMsg & vbCrLf
                    GoTo errmsg
                End If
                If RefType <> "" Then
                    SQL = "Update A2 Set RefType='" & RefType & "'"
                    SQL = SQL & " from (Select top 1 A3.AdmNo from Acceptance A1, Acceptance A2, AccAss A3 Where A3.ANO=A2.ANO and A2.ANO<>A2.LANO and A2.RegNo=A1.RegNo and A1.ANO=A1.LANO and A3.Type in ('DI','IC','IR','IT','IX') and A3.Code='P' and A2.LANO=" & LANO & ") A1"
                    SQL = SQL & " Inner Join Admlink A2 on (A2.AdmNo=A1.AdmNo)"
                    SQL = SQL & " Inner Join nVoucher V on (V.Voucher=A2.Voucher)"

                    If Not db.Execute(SQL) Then
                        StrMsg = "Update Payment Reference Type Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If

                    SQL = "Update V Set RefType='" & RefType & "'"
                    SQL = SQL & " from (Select top 1 A3.AdmNo from Acceptance A1, Acceptance A2, AccAss A3 Where A3.ANO=A2.ANO and A2.ANO<>A2.LANO and A2.RegNo=A1.RegNo and A1.ANO=A1.LANO and A3.Type in ('DI','IC','IR','IT','IX') and A3.Code='P' and A2.LANO=" & LANO & ") A1"
                    SQL = SQL & " Inner Join Admlink A2 on (A2.AdmNo=A1.AdmNo)"
                    SQL = SQL & " Inner Join nVoucher V on (V.Voucher=A2.Voucher)"

