                    rs = db.OpenRemoteSet(SQL)
                    Fee_ID_1 = rs.fields("FDID")

                    FeeParam(0) = IIf(tostr(Fee_ProfileID_1) = "", "<Payor>", tostr(Fee_ProfileID_1))
                    FeeParam(1) = Fee_ID_1
                    FeeParam(2) = rs.fields("Currency")
                    FeeParam(3) = Fee_Amount_1
                    FeeParam(4) = Fee_AmountPCT_1
                    FeeParam(5) = Fee_Remark_1
                    FeeParam(6) = 0
                    FeeParam(7) = False
                    FeeParam(8) = False
                    FeeParam(9) = toval(rs.fields("AmountPCTBased"))
                    If Not Add_Fee_Duty(NewANO, FeeParam) Then
                        StrMsg = "Add Fee Failed !" & vbCrLf
                        GoTo errmsg
                    End If
                End If

                If (Duty_Currency <> "" OrElse Duty_ID <> "") And (Duty_Amount <> 0 OrElse Duty_AmountPCT <> 0) Then

                    SQL = "Select top 1 F.FDID, Currency.Currency from FDTAB F "
                    If Duty_Currency <> "" Then
                        SQL = SQL & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Duty_Currency & "' AND CURRENCY.ALLOWEDF=1)"
                    Else
                        SQL = SQL & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY=F.Currency)"
                    End If
                    SQL = SQL & " Where F.ATYPE in ('E','ALL') and LEFT(F.FDType,1) = 'D' "
                    If Duty_ID <> "" Then
                        SQL = SQL & " and F.FDID = '" & Duty_ID & "'"
                    End If
                    rs = db.OpenRemoteSet(SQL)
                    Duty_ID = rs.fields("FDID")

                    FeeParam(0) = IIf(tostr(Duty_ProfileID) = "", "<Payor>", tostr(Duty_ProfileID))
                    FeeParam(1) = Duty_ID
                    FeeParam(2) = rs.fields("Currency")
                    FeeParam(3) = Duty_Amount
                    FeeParam(4) = Duty_AmountPCT
                    FeeParam(5) = Duty_Remark
                    FeeParam(6) = 0
                    FeeParam(7) = False
                    FeeParam(8) = False
                    FeeParam(9) = toval(rs.fields("AmountPCTBased"))
                    If Not Add_Fee_Duty(NewANO, FeeParam) Then
                        StrMsg = "Add Stamp Duty Failed !" & vbCrLf
                        GoTo errmsg
                    End If
                End If

                If (Duty_Currency_1 <> "" OrElse Duty_ID_1 <> "") And (Duty_Amount_1 <> 0 OrElse Duty_AmountPCT_1 <> 0) Then
                    SQL = "Select top 1 F.FDID, Currency.Currency from FDTAB F "
                    If Duty_Currency_1 <> "" Then
                        SQL = SQL & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Duty_Currency_1 & "' AND CURRENCY.ALLOWEDF=1)"
                    Else
                        SQL = SQL & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY=F.Currency)"
                    End If
                    SQL = SQL & " Where F.ATYPE in ('E','ALL') and LEFT(F.FDType,1) = 'D' "
                    If Duty_ID_1 <> "" Then
                        SQL = SQL & " and F.FDID = '" & Duty_ID_1 & "'"
                    End If
                    rs = db.OpenRemoteSet(SQL)
                    Duty_ID_1 = rs.fields("FDID")

                    FeeParam(0) = IIf(tostr(Duty_ProfileID_1) = "", "<Payor>", tostr(Duty_ProfileID_1))
                    FeeParam(1) = Duty_ID_1
                    FeeParam(2) = rs.fields("Currency")
                    FeeParam(3) = Duty_Amount_1
                    FeeParam(4) = Duty_AmountPCT_1
                    FeeParam(5) = Duty_Remark_1
                    FeeParam(6) = 0
                    FeeParam(7) = False
                    FeeParam(8) = False
                    FeeParam(9) = toval(rs.fields("AmountPCTBased"))
                    If Not Add_Fee_Duty(NewANO, FeeParam) Then
                        StrMsg = "Add Stamp Duty Failed !" & vbCrLf
                        GoTo errmsg
                    End If
                End If

                

                If Premium <> 0 Then ResetPremiumCalcF = True

                If ANO <> LANO AndAlso Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "PREMIUM_CALC", NewANO, , ResetPremiumCalcF, Premium, PremiumDescription) Then
                    StrMsg = "Process : Premium Calculation Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                    GoTo errmsg
                End If

                ' Overwrite Premium
                If EPremium <> 0 Then
                    rs = db.OpenRemoteSet("Select * from PCalc Where ANO=" & NewANO)
                    If rs.Eof OrElse toval(rs.fields("OGross")) = 0 OrElse rs.RecordCount > 1 Then
                        StrMsg = "Premium Can't Be Overwritten, Please Check Risk Covered for At Least Has a Non-Zero Premium Rate or only has single currency !"
                        GoTo errmsg
                    End If

                    Dim Gross As Double
                    Dim Factor As Double
                    Dim Constant As Double
                    Dim CCY As String

                    Gross = rs.fields("Gross")
                    CCY = rs.fields("Currency")

                    rsTemp = db.OpenRemoteSet("Select * from Premium_Calculation_Factor(" & NewANO & ") P Where P.Currency='" & CCY & "'")
                    Factor = toval(rsTemp.fields("Premium"))
                    rsTemp = db.OpenRemoteSet("Select * from Premium_Calculation_Constant(" & NewANO & ") P Where P.Currency='" & CCY & "'")
                    Constant = toval(rsTemp.fields("Premium"))

                    If Factor <> 0 Then
                        Gross = (EPremium - Constant) / Factor
                    Else
                        Gross = 0
                    End If

                    If Gross <> rs.fields("Gross") Then
                        rs.Edit()
                        rs.fields("Gross") = Gross
                        rs.fields("Description") = "Premium Overwritten"
                        If Not rs.Update Then
                            StrMsg = "Process : Overwriting Premium Failed !" & vbCrLf & rs.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    End If
                End If


                ' Save Term and Condition
                If Not SaveListTC(NewANO, TOC, TCCount, Findex, FBuffer, StrMsg) Then GoTo errmsg

                ' Update Banker Clause
                If (BankersClause <> "" Or NewBankersClause <> "") And BankersClause <> NewBankersClause Then
                    If Trim(BankersClause) <> "" Then
                        SQL = "Update AccCla Set Description=replace(cast(Description as VARCHAR(MAX)),'" & BankersClause & "','<<BANKERS CLAUSE>>'), Description_1=replace(cast(Description_1 as VARCHAR(MAX)),'" & BankersClause & "','<<BANKERS CLAUSE>>') from AccCla Where ANO=" & NewANO
                        If Not db.Execute(SQL) Then GoTo errmsg
                    End If
                    If Trim(NewBankersClause) <> "" Then
                        SQL = "Update AccCla Set Description=replace(cast(Description as VARCHAR(MAX)),'<<BANKERS CLAUSE>>','" & NewBankersClause & "'), Description_1=replace(cast(Description_1 as VARCHAR(MAX)),'<<BANKERS CLAUSE>>','" & NewBankersClause & "') from AccCla Where ANO=" & NewANO
                        If Not db.Execute(SQL) Then GoTo errmsg

                        SQL = "Update Acceptance Set AName = '" & NewBankersClause & "' +  ' QQ ' + AName from Acceptance Where ANO=" & NewANO
                        If Not db.Execute(SQL) Then GoTo errmsg
                    End If
                End If

                BlanketNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("BlanketNo", Findex))))
                If BlanketNo <> "" Then
                    Dim DeliveryNo As String
                    Dim DocNo As String

                    rs = db.OpenRemoteSet("Select PolicyNo, CertificateNo from Acceptance Where ANO='" & ANO & "'")
                    PolicyNo = tostr(rs.fields("PolicyNo"))
                    CertificateNo = tostr(rs.fields("CertificateNo"))

                    If LANO <> -1 Then
                        If OpenFlag And ANO <> LANO Then
                            DocNo = PolicyNo & "-" & CertificateNo
                        Else
                            DocNo = PolicyNo
                        End If
                    Else
                        DocNo = PolicyNo
                    End If

                    rs = db.OpenRemoteSet("Select BD.DeliveryNo, BD.Branch from Blanket_Delivery_Detail BDD, Blanket_Delivery BD Where BD.DeliveryNo=BDD.DeliveryNo and BDD.BlanketType='POLICY' and BDD.BlanketNo='" & BlanketNo & "' and BDD.BlanketTypeVer=" & BlanketTypeVer)
                    If rs.Eof Then
                        StrMsg = "Blanket Number : " & BlanketNo & ", Does not Exist !"
                        GoTo errmsg
                    ElseIf UCase(rs.fields("Branch")) <> Branch.ToUpper Then
                        StrMsg = "Blanket Number : " & BlanketNo & ", not Delivered for Branch : " & Branch & " !"
                        GoTo errmsg
                    Else
                        DeliveryNo = tostr(rs.fields("DeliveryNo"))
                    End If

                    rs = db.OpenRemoteSet("Select * from Blanket Where BlanketType='POLICY' and BlanketTypeVer=" & BlanketTypeVer & " and BlanketNo='" & BlanketNo & "'")
                    If rs.Eof Then
                        rs.AddNew()
                        rs.fields("BlanketType") = "POLICY"
                        rs.fields("BlanketTypeVer") = BlanketTypeVer
                        rs.fields("BlanketNo") = BlanketNo
                        rs.fields("UserID") = db_user
                        rs.fields("CDate") = Today.Date
                    Else
                        If rs.fields("Status") <> "0" And rs.fields("DocNo") <> DocNo Then
                            StrMsg = "Blanket Number Already Used by Another Policy/Certificate !"
                            GoTo errmsg
                        End If
                        rs.Edit()
                    End If
                    rs.fields("pStatus") = tostr(rs.fields("Status"))
                    rs.fields("Status") = 1  ' Allocated
                    rs.fields("DocNo") = DocNo
                    rs.fields("Remarks") = ""
                    rs.fields("LUserID") = db_user
                    rs.fields("LDate") = Today.Date
                    If Not rs.Update Then
                        StrMsg = db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If

                    If Not db.Execute("update Blanket_Delivery set BlanketGood = BlanketGood - 1, BlanketAllocated = BlanketAllocated + 1, LUserId = '" & db_user & "' , LDate = '" & Today.Date & "' Where DeliveryNo='" & DeliveryNo & "'") Then
                        StrMsg = "Process : Update Blanket_Delivery Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                End If

                ' Extended Object Information
                rsTOC = db.OpenQueryDef("QTOC_EXT_GENHTAB", adOpenForwardonly, TOC)
                If Not rsTOC.Eof Then
                    rs = db.OpenRemoteSet("Select * from AINFO_EXT Where ANO=" & ANO)
                    If rs.Eof Then
                        rs.AddNew()
                    Else
                        rs.Edit()
                    End If
                    rs.fields("ANO") = ANO
                    For X = 16 To 30
                        FLDID = rsTOC.fields("FLDID" & X)
                        ValueDesc = tostr(rs.fields("VALUEDESC" & X))
                        ValueID = tostr(rs.fields("VALUEID" & X))
                        If FLDID <> "" Then
                            rs.fields("FLDID" & X) = FLDID
                            If Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("DESCRIPTION" & X, Findex))))) <> "" Or Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("OBJ_INFO_" & Format(X, "00"), Findex))))) <> "" Then
                                ValueDesc = Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("DESCRIPTION" & X, Findex)))))
                                ValueID = Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("OBJ_INFO_" & Format(X, "00"), Findex)))))
                            End If

                            If toval(rsTOC.fields("FLDTAB" & X)) Then
                                rs.fields("VALUEID" & X) = ValueID
                                rs.fields("VALUEDESC" & X) = ValueDesc
                            Else
                                rs.fields("VALUEID" & X) = ""
                                rs.fields("VALUEDESC" & X) = ValueDesc
                            End If
                        Else
                            rs.fields("FLDID" & X) = ""
                            rs.fields("VALUEID" & X) = ""
                            rs.fields("VALUEDESC" & X) = ""
                        End If
                    Next
                    ' Update Extended Object Information
                    If Not rs.Update Then
                        StrMsg = "Process : Update Extended Object Information : " & rs.ErrDesc
                        GoTo errmsg
                    End If
                End If
            End If

            If EMethod = "T" Or EMethod = "U" Then
                Dim Share As Double
                Dim QAmount As Double
                Dim AAmount As Double
                Dim RID As String
                Dim RIComm As Double
                Dim NetRate As Double
                Dim FacOutAmount As Double
                Dim FacOutPremium As Double
                Dim FacOutJPShare As Double
                Dim FacOutJPComm As Double
                Dim FacOutDiscount As Double
                Dim FacOutDiscAmount As Double
                Dim FacOutProfitSharing As Double
                Dim FacOutOCommAmount As Double
                Dim FacOutUJROHREINS As Double
                Dim FacOutUJROHCEDANT As Double

                Dim FacOutRemarks As String
                Dim FacOutMemo As String

                Dim FacOutUnit As String
                Dim FacOutCurrency As String
                Dim FacOutPCalc As String
                Dim FacOutAcceptedBy As String
                Dim FacOutAcceptedDate As Date
                Dim FacOutSysUserID As String
                Dim FacOutSlipNo As String
                Dim FacOutDueDate As Date
                Dim FacOutPrecedeFacCessionF As Boolean
                Dim FacOutCLAIMBYSECURITYF As Boolean
                Dim FacOutBinderNo As String
                Dim FacOutBinderWarranty As Integer
                Dim FacOutCPDays As Integer
                Dim FacOutSDate As Date
                Dim FacOutEDate As Date

                Dim InParam(1) As Object

                Dim findex_facultative() As Object = Nothing
                Dim fbuffer_facultative() As Object = Nothing

                ' Facultative
                rsTemp = db.refresh_query("Datamaster", "QFacultative_Data", adOpenKeyset, -1, "")
                findex_facultative = rsTemp.fields_index
                fbuffer_facultative = rsTemp.GetRecord

                rsTemp = db.OpenRemoteSet("Select FID from RArrDet Where Status='R' and ANO=" & NewANO)
                Do While Not rsTemp.Eof
                    If Not UnConfirmed_Facultative(NewANO, rsTemp.fields("FID")) Then GoTo errmsg
                    rsTemp.MoveNext()
                Loop

                ' Delete first
                If Not Delete_Records("Delete from RArrDet Where Status='O' and AType='N' and ANO=" & NewANO) Then GoTo errmsg

                Dim FID As String
                Dim RType As String
                Dim WPC As Integer
                Dim Grace As Integer
                Dim CheckNetRateF As Boolean = Not db.GetPrivileges("ALLOWFACRATEGREATERTHANGROSS")
                For i = 1 To FacultativeCount
                    RID = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "ID", Findex))))
                    If RID <> "" Then
                        rs = db.OpenRemoteSet("Select Top 1 ID from Profile Where ID='" & RID & "' or RefID='" & RID & "'")
                        RID = tostr(rs.fields("ID"))
                        If RID = "" Then
                            StrMsg = "Facultative Profile ID Not Found !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If

                        Share = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "Share", Findex))))
                        RIComm = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "Comm", Findex))))
                        NetRate = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "Rate", Findex))))
                        WPC = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "WPC", Findex))))
                        Grace = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "GRACE", Findex))))
                        RType = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "RType", Findex))))
                        FacOutPremium = toval(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "Premium", Findex))))
                        FacOutAmount = toval(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "Amount", Findex))))
                        FacOutJPShare = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "JPShare", Findex))))
                        FacOutJPComm = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "JPComm", Findex))))
                        FacOutDiscount = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "Discount", Findex))))
                        FacOutDiscAmount = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "DiscAmount", Findex))))
                        FacOutProfitSharing = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "ProfitSharing", Findex))))
                        FacOutOCommAmount = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "OCommAmount", Findex))))
                        FacOutUJROHREINS = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "UJROHREINS", Findex))))
                        FacOutUJROHCEDANT = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "UJROHCEDANT", Findex))))
                        FacOutRemarks = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "REMARKS", Findex))))
                        FacOutMemo = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "MEMO", Findex))))
                        FacOutUnit = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "Unit", Findex))))
                        FacOutCurrency = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "CURRENCY", Findex))))
                        FacOutPCalc = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "PCALC", Findex))))
                        FacOutAcceptedBy = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "ACCEPTEDBY", Findex))))
                        FacOutAcceptedDate = todate(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "ACCEPTEDDATE", Findex))))
                        FacOutSysUserID = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "SysUserID", Findex))))
                        FacOutSlipNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "SLIPNO", Findex))))
                        FacOutPrecedeFacCessionF = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "PrecedeFacCessionF", Findex))))
                        FacOutCLAIMBYSECURITYF = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "CLAIMBYSECURITYF", Findex))))
                        FacOutBinderNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "BINDERNO", Findex))))
                        FacOutBinderWarranty = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "BINDERWARRANTY", Findex))))
                        FacOutCPDays = toval(GetFieldValue(FBuffer(GetFieldIndex("FACOUT" & i & "CPDays", Findex))))
                        If FacOutCPDays = 0 Then FacOutCPDays = toval(GetAppSetting("FacCPDays"))

                        If Grace = 0 Then
                            If tostr(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "DUEDATE", Findex)))) = "" Or Format(todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "DUEDATE", Findex)))).Date, "MM/DD/YYYY") = "01/01/1900" Then
                                FacOutDueDate = Effective_Date
                            Else
                                FacOutDueDate = todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "DUEDATE", Findex)))).Date
                            End If
                            Grace = DateDiff(DateInterval.Day, Effective_Date, FacOutDueDate)
                        End If

                        If tostr(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "SDATE", Findex)))) = "" Or Format(todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "SDATE", Findex)))).Date, "MM/DD/YYYY") = "01/01/1900" Then
                            FacOutSDate = SDate
                        Else
                            FacOutSDate = todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "SDATE", Findex))))
                        End If

                        If tostr(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "EDATE", Findex)))) = "" Or Format(todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "EDATE", Findex)))).Date, "MM/DD/YYYY") = "01/01/1900" Then
                            FacOutEDate = EDate
                        Else
                            FacOutEDate = todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "EDATE", Findex))))
                        End If

                        If FacOutUnit <> "" And FacOutUnit <> "C" And FacOutUnit <> "F" And FacOutUnit <> "M" Then
                            FacOutUnit = "C"
                        End If

                        If FacOutPCalc = "" Or (FacOutPCalc <> "" And FacOutPCalc <> "P" And FacOutPCalc <> "F") Then
                            FacOutPCalc = "F"
                        End If

                        If FacOutSysUserID <> "" Then
                            rs = db.OpenRemoteSet("Select ID From FL_Underwriter('" & Branch & "') SysUser Where ID='" & FacOutSysUserID & "'")
                            If rs.Eof Then
                                StrMsg = "Facultative Underwriter (" & FacOutSysUserID & ") Not Found !" & vbCrLf
                                GoTo errmsg
                            End If
                        End If

                        rs = db.OpenRemoteSet("Select TAmount from RArrHeader Where ANO=" & ANO)
                        If Share <> 0 Then
                            FacOutAmount = toval(rs.fields("TAmount")) * Share / 100
                        ElseIf FacOutAmount <> 0 Then
                            Share = FacOutAmount / toval(rs.fields("TAmount")) * Share * 100
                        End If


                        Dim FullCoverF As Boolean = True
                        Dim SlipNo As String

                        If FacOutSlipNo <> "" Then
                            rsTemp = db.OpenRemoteSet("Select F.FID, F.SlipNo from FPart F, RArrDet R Where R.FID = f.FID and r.ANO = f.ANO  and R.Status='O' and R.AType = 'E' and F.ID = '" & RID & "' and F.ANO=" & NewANO & " and F.SlipNo='" & FacOutSlipNo & "'")
                        Else
                            rsTemp = db.OpenRemoteSet("Select F.FID, F.SlipNo from FPart F, RArrDet R Where R.FID = f.FID and r.ANO = f.ANO  and R.Status='O' and R.AType = 'E' and F.ID = '" & RID & "' and F.ANO=" & NewANO)
                        End If
                        If Not rsTemp.Eof Then
                            FID = rsTemp.fields("FID")
                            SlipNo = rsTemp.fields("SlipNo")
                        Else
                            FID = ""
                            SlipNo = FacOutSlipNo
                        End If
                        fbuffer_facultative(GetFieldIndex("SlipNo", findex_facultative)) = SetFieldValue(SlipNo)
                        fbuffer_facultative(GetFieldIndex("ID", findex_facultative)) = SetFieldValue(RID)
                        fbuffer_facultative(GetFieldIndex("Share", findex_facultative)) = SetFieldValue(Share)
                        fbuffer_facultative(GetFieldIndex("RShare", findex_facultative)) = SetFieldValue(100)
                        fbuffer_facultative(GetFieldIndex("Comm", findex_facultative)) = SetFieldValue(RIComm)
                        fbuffer_facultative(GetFieldIndex("Currency", findex_facultative)) = SetFieldValue(FacOutCurrency)
                        fbuffer_facultative(GetFieldIndex("NetRate", findex_facultative)) = SetFieldValue(NetRate)
                        fbuffer_facultative(GetFieldIndex("Unit", findex_facultative)) = SetFieldValue(FacOutUnit)
                        fbuffer_facultative(GetFieldIndex("JPShare", findex_facultative)) = SetFieldValue(FacOutJPShare)
                        fbuffer_facultative(GetFieldIndex("JPComm", findex_facultative)) = SetFieldValue(FacOutJPComm)
                        fbuffer_facultative(GetFieldIndex("Discount", findex_facultative)) = SetFieldValue(FacOutDiscount)
                        fbuffer_facultative(GetFieldIndex("DiscAmount", findex_facultative)) = SetFieldValue(FacOutDiscAmount)
                        fbuffer_facultative(GetFieldIndex("ProfitSharing", findex_facultative)) = SetFieldValue(FacOutProfitSharing)
                        fbuffer_facultative(GetFieldIndex("OCommAmount", findex_facultative)) = SetFieldValue(FacOutOCommAmount)
                        fbuffer_facultative(GetFieldIndex("UJROHREINS", findex_facultative)) = SetFieldValue(FacOutUJROHREINS)
                        fbuffer_facultative(GetFieldIndex("UJROHCEDANT", findex_facultative)) = SetFieldValue(FacOutUJROHCEDANT)

                        fbuffer_facultative(GetFieldIndex("OriginalF", findex_facultative)) = SetFieldValue(True)
                        fbuffer_facultative(GetFieldIndex("RType", findex_facultative)) = SetFieldValue(IIf(RType = "", "F", RType))
                        fbuffer_facultative(GetFieldIndex("PCalc", findex_facultative)) = SetFieldValue(FacOutPCalc)
                        fbuffer_facultative(GetFieldIndex("CPCT", findex_facultative)) = SetFieldValue(0)
                        fbuffer_facultative(GetFieldIndex("FLPCT", findex_facultative)) = SetFieldValue(0)
                        fbuffer_facultative(GetFieldIndex("Amount", findex_facultative)) = SetFieldValue(0)
                        fbuffer_facultative(GetFieldIndex("Code", findex_facultative)) = SetFieldValue("")
                        fbuffer_facultative(GetFieldIndex("Remarks", findex_facultative)) = SetFieldValue("")
                        fbuffer_facultative(GetFieldIndex("Period", findex_facultative)) = SetFieldValue(0)
                        fbuffer_facultative(GetFieldIndex("Installment", findex_facultative)) = SetFieldValue(0)
                        fbuffer_facultative(GetFieldIndex("Grace", findex_facultative)) = SetFieldValue(Grace)
                        fbuffer_facultative(GetFieldIndex("SDate", findex_facultative)) = SetFieldValue(FacOutSDate)
                        fbuffer_facultative(GetFieldIndex("EDate", findex_facultative)) = SetFieldValue(FacOutEDate)
                        fbuffer_facultative(GetFieldIndex("WPC", findex_facultative)) = SetFieldValue(WPC)
                        fbuffer_facultative(GetFieldIndex("Remarks", findex_facultative)) = SetFieldValue(FacOutRemarks)
                        fbuffer_facultative(GetFieldIndex("Memo", findex_facultative)) = SetFieldValue(FacOutMemo)
                        If FacOutAcceptedBy <> "" Then
                            fbuffer_facultative(GetFieldIndex("AcceptedBy", findex_facultative)) = SetFieldValue(FacOutAcceptedBy)
                            fbuffer_facultative(GetFieldIndex("AcceptedDate", findex_facultative)) = SetFieldValue(FacOutAcceptedDate)
                        End If
                        fbuffer_facultative(GetFieldIndex("SysUserID", findex_facultative)) = SetFieldValue(FacOutSysUserID)
                        fbuffer_facultative(GetFieldIndex("PrecedeFacCessionF", findex_facultative)) = SetFieldValue(FacOutPrecedeFacCessionF)
                        fbuffer_facultative(GetFieldIndex("CLAIMBYSECURITYF", findex_facultative)) = SetFieldValue(FacOutCLAIMBYSECURITYF)
                        fbuffer_facultative(GetFieldIndex("BinderNo", findex_facultative)) = SetFieldValue(FacOutBinderNo)
                        fbuffer_facultative(GetFieldIndex("BinderWarranty", findex_facultative)) = SetFieldValue(FacOutBinderWarranty)
                        fbuffer_facultative(GetFieldIndex("CPDays", findex_facultative)) = SetFieldValue(FacOutCPDays)

                        Dim y As Integer
                        Dim BufferData(FacultativeDetCount - 1, 5) As Object
                        NetRate = 0
                        For y = 1 To FacultativeDetCount
                            If tostr(GetFieldValue(FBuffer(GetFieldIndex("FacOutDet" & i & "Code" & y, Findex)))) <> "" Then
                                FullCoverF = False
                                BufferData(y - 1, 0) = tostr(GetFieldValue(FBuffer(GetFieldIndex("FacOutDet" & i & "Code" & y, Findex))))
                                BufferData(y - 1, 1) = toval(GetFieldValue(FBuffer(GetFieldIndex("FacOutDet" & i & "Comm" & y, Findex))))
                                BufferData(y - 1, 2) = toval(GetFieldValue(FBuffer(GetFieldIndex("FacOutDet" & i & "OComm" & y, Findex))))
                                BufferData(y - 1, 3) = toval(GetFieldValue(FBuffer(GetFieldIndex("FacOutDet" & i & "NetRate" & y, Findex))))
                                BufferData(y - 1, 4) = tostr(GetFieldValue(FBuffer(GetFieldIndex("FacOutDet" & i & "Unit" & y, Findex))))
                                BufferData(y - 1, 5) = tostr(GetFieldValue(FBuffer(GetFieldIndex("FacOutDet" & i & "CoShare" & y, Findex))))

                                Dim Unit As String = BufferData(y - 1, 4)
                                Select Case Unit
                                    Case "", "C"
                                        NetRate = NetRate + toval(BufferData(y - 1, 3))
                                    Case "M"
                                        NetRate = NetRate + toval(BufferData(y - 1, 3)) / 10
                                    Case "F"
                                        NetRate = NetRate + toval(BufferData(y - 1, 3)) * Reinsurance_Rate(ANO, tostr(GetFieldValue(fbuffer_facultative(GetFieldIndex("Currency", findex_facultative))))) / (toval(GetFieldValue(fbuffer_facultative(GetFieldIndex("Amount", findex_facultative)))) * toval(GetFieldValue(fbuffer_facultative(GetFieldIndex("RShare", findex_facultative)))) / 100) * 100
                                End Select
                            End If
                        Next

                        If FullCoverF Then
                            Dim Unit As String = GetFieldValue(FBuffer(GetFieldIndex("Unit", Findex)))
                            Select Case Unit
                                Case "", "C"
                                    NetRate = NetRate + toval(GetFieldValue(fbuffer_facultative(GetFieldIndex("NetRate", findex_facultative))))
                                Case "M"
                                    NetRate = NetRate + toval(GetFieldValue(fbuffer_facultative(GetFieldIndex("NetRate", findex_facultative)))) / 10
                                Case "F"
                                    NetRate = NetRate + toval(GetFieldValue(fbuffer_facultative(GetFieldIndex("NetRate", findex_facultative)))) * Reinsurance_Rate(ANO, tostr(GetFieldValue(fbuffer_facultative(GetFieldIndex("Currency", findex_facultative))))) / (toval(GetFieldValue(fbuffer_facultative(GetFieldIndex("Amount", findex_facultative)))) * toval(GetFieldValue(fbuffer_facultative(GetFieldIndex("RShare", findex_facultative)))) / 100) * 100
                            End Select
                        End If


                        fbuffer_facultative(GetFieldIndex("FullCoverF", findex_facultative)) = SetFieldValue(FullCoverF)

                        If CheckNetRateF Then
                            If Check_FacultativeRate_GreaterThan_GrossRate(ANO, NetRate, "C", toval(GetFieldValue(fbuffer_facultative(GetFieldIndex("Share", findex_facultative)))) * toval(GetFieldValue(fbuffer_facultative(GetFieldIndex("RShare", findex_facultative)))) / 100) Then
                                Throw New Exception("Facultative Net Rate is Greater Than Gross Rate !")
                            End If
                        End If

                        ' Facultative Installment
                        Dim Installment As Integer
                        Dim Period As Integer
                        Dim FirstDue As Date
                        Installment = toval(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "INSTALLMENT_FREQ", Findex))))
                        Period = toval(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "INSTALLMENT_DURATION", Findex))))

                        fbuffer_facultative(GetFieldIndex("Installment", findex_facultative)) = SetFieldValue(Installment)
                        fbuffer_facultative(GetFieldIndex("Period", findex_facultative)) = SetFieldValue(Period)

                        If tostr(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "INSTALLMENT_FIRSTDUE", Findex)))) = "" Or Format(todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "INSTALLMENT_FIRSTDUE", Findex)))).Date, "MM/DD/YYYY") = "01/01/1900" Then
                            FirstDue = todate(GetFieldValue(FBuffer(GetFieldIndex("INCEPTION", Findex)))).Date
                        Else
                            FirstDue = todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "INSTALLMENT_FIRSTDUE", Findex)))).Date
                        End If

                        If Installment >= 1 And Installment <= 24 Then

                            Dim IDate_(24) As String
                            Dim IPCT_(24) As Double

                            For y = 1 To Installment
                                If IsDate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "IDATE_" & y, Findex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "IDATE_" & y, Findex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                                    IDate_(y) = todate(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "IDATE_" & y, Findex))))
                                Else
                                    IDate_(y) = ""
                                End If
                                IPCT_(y) = toval(GetFieldValue(FBuffer(GetFieldIndex("FacOut" & i & "IPCT_" & y, Findex))))
                            Next

                            Dim PCT As Double
                            Dim tPCT As Double

                            tPCT = 0
                            y = 1
                            Do While y <= Installment
                                If tostr(IDate_(y)) <> "" Then
                                    fbuffer_facultative(GetFieldIndex("IDate_" & y, findex_facultative)) = SetFieldValue(todate(IDate_(y)))
                                Else
                                    fbuffer_facultative(GetFieldIndex("IDate_" & y, findex_facultative)) = SetFieldValue(DateAdd(DateInterval.Month, (y - 1) * Period, FirstDue))
                                End If
                                If y < Installment Then
                                    If toval(IPCT_(y)) <> 0 Then
                                        PCT = toval(IPCT_(y))
                                    Else
                                        PCT = 100 / Installment
                                    End If
                                Else
                                    PCT = 100 - tPCT
                                End If
                                fbuffer_facultative(GetFieldIndex("IPCT_" & y, findex_facultative)) = SetFieldValue(PCT)
                                y = y + 1
                                tPCT = tPCT + PCT
                            Loop
                        End If

                        InParam(0) = NewANO
                        InParam(1) = FID

                        FID = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.Proclib", "Save_Facultative_Data", InParam, findex_facultative, fbuffer_facultative, TrimBuffer(BufferData))
                        If FID = "" Then
                            StrMsg = "Process : Save Facultative Data Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If

                        For y = 1 To FacultativeSecCount
                            If tostr(GetFieldValue(FBuffer(GetFieldIndex("FacoutSec" & i & "ID" & y, Findex)))) <> "" Then
                                rs = db.OpenRemoteSet("Select * from FSecurity Where ANO=" & NewANO & " and FID='" & FID & "' and ID='" & tostr(GetFieldValue(FBuffer(GetFieldIndex("FacoutSec" & i & "ID" & y, Findex)))) & "'")
                                If rs.Eof Then
                                    rs.AddNew()
                                    rs.fields("ANO") = NewANO
                                    rs.fields("FID") = FID
                                    rs.fields("ID") = tostr(GetFieldValue(FBuffer(GetFieldIndex("FacoutSec" & i & "ID" & y, Findex))))
                                Else
                                    rs.Edit()
                                End If
                                rs.fields("Share") = toval(GetFieldValue(FBuffer(GetFieldIndex("FacoutSec" & i & "Share" & y, Findex))))
                                rs.fields("Comm") = toval(GetFieldValue(FBuffer(GetFieldIndex("FacoutSec" & i & "Comm" & y, Findex))))
                                rs.fields("Remarks") = tostr(GetFieldValue(FBuffer(GetFieldIndex("FacoutSec" & i & "Remarks" & y, Findex))))
                                rs.fields("Limit") = toval(GetFieldValue(FBuffer(GetFieldIndex("FacoutSec" & i & "Limit" & y, Findex))))
                                rs.fields("Excess") = toval(GetFieldValue(FBuffer(GetFieldIndex("FacoutSec" & i & "Excess" & y, Findex))))
                                rs.fields("Amount") = toval(GetFieldValue(FBuffer(GetFieldIndex("FacoutSec" & i & "Amount" & y, Findex))))

                                If rs.fields("Limit") <> 0 Then
                                    If rs.fields("Share") <> 0 Then
                                        rs.fields("Amount") = toval(rs.fields("Limit")) * rs.fields("Share") / 100
                                    Else
                                        rs.fields("Share") = toval(rs.fields("Amount")) / toval(rs.fields("Limit")) * 100
                                    End If
                                Else
                                    If rs.fields("Share") <> 0 Then
                                        rs.fields("Amount") = FacOutAmount * rs.fields("Share") / 100
                                    Else
                                        rs.fields("Share") = toval(rs.fields("Amount")) / FacOutAmount * 100
                                    End If
                                End If
                                If Not rs.Update() Then GoTo errmsg
                            End If
                        Next

                        If Not Confirmed_Facultative(NewANO, FID) Then GoTo errmsg
                    Else
                        Exit For
                    End If
                Next

                If LANO <> ANO Then
                    rs = db.OpenQueryDef("QRArrHeader", adOpenKeyset, NewANO)
                    'Unbooked first
                    If rs.fields("Status") = "A" Then
                        If Not UnReleaseAccRegAmount(NewANO, True) Then GoTo ErrMsg
                        ' Re-Open Data
                        rs = db.OpenQueryDef("QRArrHeader", adOpenKeyset, NewANO)
                    End If

                    Dim PolicyTreatyF As Boolean = toval(rs.fields("PolicyTreatyF"))
                    If LANO <> -1 And OpenFlag Then
                        PolicyTreatyF = IIf(toval(GetFieldValue(FBuffer(GetFieldIndex("PolicyTreatyF", Findex)))), True, False)
                    End If
                    rs.Edit()
                    rs.fields("ManualF") = IIf(toval(GetFieldValue(FBuffer(GetFieldIndex("ManualF", Findex)))), True, False)
                    rs.fields("EXOLF") = IIf(toval(GetFieldValue(FBuffer(GetFieldIndex("EXOLF", Findex)))), True, False)

                    rs.fields("LOLBASED") = toval(GetFieldValue(FBuffer(GetFieldIndex("LOLBASED", Findex))))

                    Dim DAnnualTreatyF As Boolean = AnnualTreatyF
                    Dim DNoRiskAccumulationF As Boolean = NoRiskAccumulationF

                    If tostr(GetFieldValue(FBuffer(GetFieldIndex("AnnualTreatyF", Findex)))) <> "" Then
                        AnnualTreatyF = toval(GetFieldValue(FBuffer(GetFieldIndex("AnnualTreatyF", Findex))))
                    End If

                    If tostr(GetFieldValue(FBuffer(GetFieldIndex("NoRiskAccumulationF", Findex)))) <> "" Then
                        NoRiskAccumulationF = toval(GetFieldValue(FBuffer(GetFieldIndex("NoRiskAccumulationF", Findex))))
                    End If

                    Dim RDate As Date
                    Dim NRDate As Date
                    Dim ChangeOnRDateF As Boolean = False
                    Dim ChangeOnNRDateF As Boolean = False
                    RDate = rs.fields("RDate")
                    NRDate = rs.fields("NRDate")

                    If (tostr(GetFieldValue(FBuffer(GetFieldIndex("RDate", Findex)))) <> "" AndAlso IsDate(GetFieldValue(FBuffer(GetFieldIndex("RDate", Findex)))) AndAlso RDate <> todate(GetFieldValue(FBuffer(GetFieldIndex("RDate", Findex))))) Then
                        RDate = todate(GetFieldValue(FBuffer(GetFieldIndex("RDate", Findex))))
                        ChangeOnRDateF = True
                    End If
                    If (tostr(GetFieldValue(FBuffer(GetFieldIndex("NRDate", Findex)))) <> "" AndAlso IsDate(GetFieldValue(FBuffer(GetFieldIndex("NRDate", Findex)))) AndAlso NRDate <> todate(GetFieldValue(FBuffer(GetFieldIndex("NRDate", Findex))))) Then
                        NRDate = todate(GetFieldValue(FBuffer(GetFieldIndex("NRDate", Findex))))
                        ChangeOnNRDateF = True
                    End If

                    If AnnualTreatyF Then
                        If (OpenFlag And Not PolicyTreatyF) OrElse (SType = "S") Then
                            ' Check for Leap Year
                            If Month(DateSerial(Year(Effective_Date), Month(SDate), Day(SDate))) <> Month(SDate) Then
                                RDate = DateAdd(DateInterval.Day, -1, DateSerial(Year(Effective_Date), Month(SDate), Day(SDate)))
                            Else
                                RDate = DateSerial(Year(Effective_Date), Month(SDate), Day(SDate))
                            End If
                            If DateDiff(DateInterval.Day, Effective_Date, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)
                            If DateDiff(DateInterval.Day, Effective_Date, RDate) < 0 Then RDate = DateAdd(DateInterval.Month, 12, RDate)
                            If DateDiff(DateInterval.Day, Effective_Date, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)

                            If DateDiff(DateInterval.Day, SDate, RDate) < 0 Then RDate = SDate
                            NRDate = DateAdd(DateInterval.Month, 12, RDate)
                            If DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                        Else
                            ' Check for Leap Year
                            If Month(DateSerial(Year(Effective_Date), Month(M_SDate), Day(M_SDate))) <> Month(M_SDate) Then
                                RDate = DateAdd(DateInterval.Day, -1, DateSerial(Year(Effective_Date), Month(M_SDate), Day(M_SDate)))
                            Else
                                RDate = DateSerial(Year(Effective_Date), Month(M_SDate), Day(M_SDate))
                            End If
                            If DateDiff(DateInterval.Day, Effective_Date, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)
                            If DateDiff(DateInterval.Day, Effective_Date, RDate) < 0 Then RDate = DateAdd(DateInterval.Month, 12, RDate)
                            If DateDiff(DateInterval.Day, Effective_Date, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)

                            If DateDiff(DateInterval.Day, M_SDate, RDate) < 0 Then RDate = M_SDate
                            NRDate = DateAdd(DateInterval.Month, 12, RDate)
                            If DateDiff(DateInterval.Day, M_EDate, NRDate) > 0 Then NRDate = M_EDate
                        End If
                    Else
                        If DAnnualTreatyF <> AnnualTreatyF OrElse toval(rs.fields("PolicyTreatyF")) <> PolicyTreatyF OrElse ChangeOnRDateF OrElse ChangeOnNRDateF Then
                            If (OpenFlag And Not PolicyTreatyF) OrElse (SType = "S") Then
                                If AType = "N" OrElse DateDiff(DateInterval.Day, PSDate, RDate) = 0 OrElse DateDiff(DateInterval.Day, SDate, RDate) < 0 Then RDate = SDate
                                If DateDiff(DateInterval.Day, EDate, RDate) > 0 Then RDate = EDate

                                If DateDiff(DateInterval.Day, SDate, NRDate) < 0 Then NRDate = SDate
                                If DateDiff(DateInterval.Day, PEDate, NRDate) = 0 OrElse DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                                If DateDiff(DateInterval.Day, RDate, NRDate) <= 0 Then
                                    RDate = SDate
                                    NRDate = EDate
                                End If
                            Else
                                If AType = "N" OrElse DateDiff(DateInterval.Day, M_SDate, RDate) = 0 OrElse DateDiff(DateInterval.Day, M_SDate, RDate) < 0 Then RDate = M_SDate
                                If DateDiff(DateInterval.Day, M_EDate, RDate) > 0 Then RDate = M_EDate

                                If DateDiff(DateInterval.Day, SDate, NRDate) < 0 Then NRDate = SDate
                                If DateDiff(DateInterval.Day, PEDate, NRDate) = 0 OrElse DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                                If DateDiff(DateInterval.Day, RDate, NRDate) <= 0 Then
                                    RDate = SDate
                                    NRDate = EDate
                                End If
                            End If
                        End If
                    End If

                    rs.fields("RDate") = RDate
                    rs.fields("NRDate") = NRDate
                    rs.fields("PolicyTreatyF") = PolicyTreatyF

                    ' Compulsory BPPDAN
                    RID = GetFieldValue(FBuffer(GetFieldIndex("CID", Findex)))
                    Share = GetFieldValue(FBuffer(GetFieldIndex("CShare", Findex)))

                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID from Reinsurance Where '" & Format(RDate, "MM/DD/YYYY") & "' Between SDate and EDate and RType='C' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            GoTo errmsg
                        End If

                        rs.fields("CID") = RID
                        rs.fields("CSHARE") = Share
                        rs.fields("CAMOUNT") = rs.fields("TAmount") * Share / 100
                    End If

                    ' MAIPARK
                    RID = GetFieldValue(FBuffer(GetFieldIndex("XPID", Findex)))
                    Share = GetFieldValue(FBuffer(GetFieldIndex("XPShare", Findex)))

                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID from Reinsurance Where '" & Format(RDate, "MM/DD/YYYY") & "' Between SDate and EDate and RType='XP' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            GoTo errmsg
                        End If

                        rs.fields("XPID") = RID
                        rs.fields("XPShare") = Share
                        rs.fields("XPAmount") = rs.fields("TAmount") * Share / 100
                    End If

                    ' Decree
                    RID = GetFieldValue(FBuffer(GetFieldIndex("DID", Findex)))
                    Share = GetFieldValue(FBuffer(GetFieldIndex("DShare", Findex)))

                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID from Reinsurance Where '" & Format(RDate, "MM/DD/YYYY") & "' Between SDate and EDate and RType='D' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            GoTo errmsg
                        End If

                        rs.fields("DID") = RID
                        rs.fields("DShare") = Share
                        rs.fields("DAmount") = rs.fields("TAmount") * Share / 100
                    End If

                    ' Quota Share
                    RID = GetFieldValue(FBuffer(GetFieldIndex("QID", Findex)))
                    Share = GetFieldValue(FBuffer(GetFieldIndex("QShare", Findex)))
                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID, Share from Reinsurance Where '" & Format(RDate, "MM/DD/YYYY") & "' Between SDate and EDate and RType='Q' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            GoTo errmsg
                        End If

                        If rsTemp.fields("Share") = 0 Then
                            QAmount = rs.fields("TAmount") * Share / 100
                        Else
                            QAmount = rs.fields("TAmount") * Share / 100 * rsTemp.fields("Share") / 100
                        End If

                        rs.fields("QID") = RID
                        rs.fields("QSRet") = 100 - rsTemp.fields("Share")
                        rs.fields("QSRamount") = rs.fields("QSRet") / (100 - rs.fields("QSRet")) * QAmount
                        rs.fields("QShare") = Share * rsTemp.fields("Share") / 100
                        rs.fields("QAmount") = QAmount

                        If rsTemp.fields("Share") = 0 Then
                            rs.fields("QSRamount") = QAmount
                            rs.fields("QAmount") = 0
                        End If
                    End If

                    ' Surplus
                    For i = 1 To 3
                        RID = GetFieldValue(FBuffer(GetFieldIndex("SP" & i & "ID", Findex)))
                        Share = GetFieldValue(FBuffer(GetFieldIndex("SP" & i & "Share", Findex)))

                        If RID <> "" Then
                            rsTemp = db.OpenRemoteSet("Select RID from Reinsurance Where '" & Format(RDate, "MM/DD/YYYY") & "' Between SDate and EDate and RType='S" & i & "' and RID='" & RID & "'")
                            If rsTemp.Eof Then
                                StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                                GoTo errmsg
                            End If

                            rs.fields("SP" & i & "ID") = RID
                            rs.fields("SP" & i & "Share") = Share
                            rs.fields("SP" & i & "Amount") = rs.fields("TAmount") * Share / 100
                        End If
                    Next

                    ' Auto Facultative
                    RID = GetFieldValue(FBuffer(GetFieldIndex("AFID", Findex)))
                    Share = GetFieldValue(FBuffer(GetFieldIndex("AFShare", Findex)))
                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID, Share from Reinsurance Where '" & Format(RDate, "MM/DD/YYYY") & "' Between SDate and EDate and RType='A' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            GoTo errmsg
                        End If

                        If rsTemp.fields("Share") = 0 Then
                            AAmount = rs.fields("TAmount") * Share / 100
                        Else
                            AAmount = rs.fields("TAmount") * Share / 100 * rsTemp.fields("Share") / 100
                        End If

                        rs.fields("AID") = RID
                        rs.fields("AFRet") = 100 - rsTemp.fields("Share")
                        rs.fields("AFRamount") = rs.fields("AFRet") / (100 - rs.fields("AFRet")) * AAmount
                        rs.fields("AShare") = Share * rsTemp.fields("Share") / 100
                        rs.fields("AAmount") = AAmount

                        If rsTemp.fields("Share") = 0 Then
                            rs.fields("AFRamount") = AAmount
                            rs.fields("AAmount") = 0
                        End If
                    End If

                    rs.fields("ShortFall") = toval(GetFieldValue(FBuffer(GetFieldIndex("ShortFall", Findex))))
                    rs.fields("SAmount") = rs.fields("TAmount") * rs.fields("ShortFall") / 100
                    rs.fields("RAmount") = rs.fields("TAmount") - (rs.fields("MAMOUNT") + rs.fields("CAMOUNT") + rs.fields("XPAMOUNT") + rs.fields("DAMOUNT") + rs.fields("QAMOUNT") + rs.fields("QSRAmount") + rs.fields("SP1AMOUNT") + rs.fields("SP2AMOUNT") + rs.fields("SP3AMOUNT") + rs.fields("AAmount") + rs.fields("AFRAmount") + rs.fields("FAMOUNT") + rs.fields("SAMOUNT"))
                    rs.fields("Retention") = (rs.fields("RAmount") / rs.fields("TAmount")) * 100

                    If Not rs.Update Then
                        StrMsg = "Process : Update Risk Arrangement Failed !"
                        GoTo errmsg
                    End If

                    If toval(rs.fields("ManualF")) And Not db.GetPrivileges("ALLOWEXCEEDTLIMIT") Then
                        If Not ValidateRiskArrangement(ANO, TOC, StrMsg) Then
                            GoTo errmsg
                        End If
                    End If

                    If DAnnualTreatyF <> AnnualTreatyF OrElse DNoRiskAccumulationF <> NoRiskAccumulationF Then
                        If Not db.Execute("Update Acceptance Set AnnualTreatyF=" & IIf(AnnualTreatyF, 1, 0) & ", NoRiskAccumulationF=" & IIf(NoRiskAccumulationF, 1, 0) & " Where ANO=" & ANO) Then GoTo errmsg
                    End If

                    If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "Reinsurance_Cession", ANO) Then
                        StrMsg = "Process : Reinsurance Cession Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                End If
            End If

            If App_Source = "MKT" AndAlso (ImmediateInforceF Or InforceF) Then
                db.Var_db_user = AUserID

                ReDim tParam(3)
                tParam(0) = CNO
                tParam(1) = Today.Date
                tParam(2) = 0
                tParam(3) = ""
                If Me.Direct_Call_Process_Execute("ProcessExt.NetV3.PROCLIB", "ConfirmQuotation", ANO, tParam, True) = 0 Then
                    StrMsg = "Process : Confirm Quotation Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                    GoTo errmsg
                End If
                db.Var_db_user = db_user
            End If
        Else    ' Adjustment
            PolicyNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("POLICYNO", Findex))))
            CertificateNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("CERTIFICATENO", Findex))))
            Refno = tostr(GetFieldValue(FBuffer(GetFieldIndex("REFNO", Findex))))
            RefDate = todate(GetFieldValue(FBuffer(GetFieldIndex("REFDATE", Findex)))).Date

            BatchNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("BatchNo", Findex))))
            Effective_Date = todate(GetFieldValue(FBuffer(GetFieldIndex("Effective_Date", Findex)))).Date
            BookingDate = Today.Date
            CPercentage = toval(GetFieldValue(FBuffer(GetFieldIndex("CPCT", Findex))))
            Remarks = tostr(GetFieldValue(FBuffer(GetFieldIndex("REMARKS", Findex))))
            Memo = tostr(GetFieldValue(FBuffer(GetFieldIndex("MEMO", Findex))))
            Comment = tostr(GetFieldValue(FBuffer(GetFieldIndex("Comment", Findex))))
            Notes = tostr(GetFieldValue(FBuffer(GetFieldIndex("Notes", Findex))))

            rs = db.OpenRemoteSet("Select A.ANO, C.OpenFlag, A.AType, A.AStatus, A.TOC, A.LANO, C.CNO, A.SDate, A.Edate, A.Branch, A.OANO from Acceptance A, Cover C Where C.CNO=A.CNO and A.ANO=" & ANO & " and Not Exists (Select pA.ANO from Acceptance pA Where pA.AType='A' and pA.AStatus='W' and pA.pANO=A.ANO)")
            If rs.Eof Then
                rs = db.OpenRemoteSet("Select A.ANO, C.OpenFlag, A.AType, A.AStatus, A.TOC, A.LANO, C.CNO, A.SDate, A.Edate, A.Branch, A.OANO from Acceptance A, Cover C Where C.CNO=A.CNO and A.AType='A' and A.AStatus='W' and A.pANO=" & ANO)
            End If
            If rs.Eof Then
                StrMsg = "Policy (" & PolicyNo & ") is not Found !" & vbCrLf
                GoTo errmsg
            End If
            AType = rs.fields("AType")
            AStatus = rs.fields("AStatus")
            OpenFlag = rs.fields("OpenFlag")
            TOC = rs.fields("TOC")
            Branch = rs.fields("Branch")
            ANO = rs.fields("ANO")
            LANO = rs.fields("LANO")
            CNO = rs.fields("CNO")

            If AType <> "A" Then
                If tostr(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", Findex)))) <> "" Then
                    Effective_Date = todate(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", Findex))))
                Else
                    If ANO <> LANO Then
                        rs = db.OpenRemoteSet("Select Min(A1.PDate) as PDate from Acceptance A1 Where A1.PDate Between '" & Format(rs.fields("SDate"), "MM/DD/YYYY") & "' and '" & Format(rs.fields("EDate"), "MM/DD/YYYY") & "' and A1.AdjustableF=1 and A1.OANO=" & rs.fields("OANO"))
                    Else
                        rs = db.OpenRemoteSet("Select Min(A1.PDate) as PDate from Acceptance A1, Acceptance A2 Where A1.PDate Between '" & Format(rs.fields("SDate"), "MM/DD/YYYY") & "' and '" & Format(rs.fields("EDate"), "MM/DD/YYYY") & "' and A1.AdjustableF=1 and A1.LANO=A2.ANO and A2.OANO=" & rs.fields("OANO"))
                    End If
                    Effective_Date = rs.fields("PDate")
                End If

                Dim tParam() As Object

                ' Check Master Policy
                If ANO <> LANO And LANO <> -1 And Not OpenFlag Then
                    rsTemp = db.OpenRemoteSet("Select top 1 CNO, ANO, AStatus, Atype, RegNo, SDate, EDate, PDate from Acceptance A where A.AStatus in ('I','W') and A.AType not in ('A','C') and A.ANO=" & LANO & " and Not Exists (Select PANO from Acceptance pA Where pA.AType not in ('A') and pA.pANO=A.ANO)")
                    If rsTemp.Eof Then
                        rsTemp = db.OpenRemoteSet("Select top 1 CNO, ANO, AStatus, Atype, RegNo, SDate, EDate, PDate from Acceptance A where A.AStatus='W' and A.AType not in ('C') and A.PANO=" & LANO)
                        If rsTemp.Eof Then
                            StrMsg = "Master Policy (" & PolicyNo & ") is not Found !" & vbCrLf
                            GoTo errmsg
                        End If
                    End If
                    CNO = rsTemp.fields("CNO")
                    LANO = rsTemp.fields("ANO")
                    M_AStatus = rsTemp.fields("AStatus")
                    M_AType = rsTemp.fields("AType")
                    M_PDate = rsTemp.fields("PDate")
                    If M_AType <> "A" And M_AStatus = "I" Then
                        ReDim Preserve tParam(17)

                        tParam(0) = ""
                        tParam(1) = BookingDate
                        tParam(2) = M_PDate
                        tParam(3) = "U"
                        tParam(4) = LANO
                        tParam(5) = Remarks
                        tParam(6) = 0
                        tParam(7) = Memo
                        tParam(8) = False
                        tParam(9) = Refno
                        tParam(10) = RefDate
                        tParam(11) = False
                        tParam(12) = ""
                        tParam(13) = False
                        tParam(14) = "UW"
                        tParam(15) = ""
                        tParam(16) = ""
                        tParam(17) = False

                        LANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.PROCLIB", "EndorseMaster", LANO, tParam, , , )
                        If LANO = 0 Then
                            StrMsg = "Process : Endorse Master Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If

                        If Not db.Execute("Update Acceptance Set BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "' Where ANO=" & LANO) Then
                            StrMsg = "Process : Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    End If
                End If

                If ANO <> LANO And LANO <> -1 Then
                    ' Get Mmaster RegNo
                    rsTemp = db.OpenRemoteSet("Select RegNo from acceptance where ano = " & LANO)
                    If rsTemp.Eof Then
                        StrMsg = "Master Policy (" & PolicyNo & ") is not Found !" & vbCrLf
                        GoTo errmsg
                    End If
                    M_RegNo = rsTemp.fields("RegNo")
                Else
                    M_RegNo = ""
                End If

                ReDim Preserve tParam(12)
                tParam(0) = M_RegNo
                tParam(1) = BookingDate
                tParam(2) = Effective_Date
                tParam(3) = "U"
                tParam(4) = LANO
                tParam(5) = Remarks
                tParam(6) = CPercentage
                tParam(7) = Memo
                tParam(8) = ""
                tParam(9) = ""
                tParam(10) = ""
                tParam(11) = Branch
                tParam(12) = TOC

                If Not PreAdjustConditionsOK(ANO, Effective_Date, errmsg) Then
                    Throw New Exception(errmsg)
                End If

                If ANO = LANO And Not OpenFlag Then
                    NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.Proclib", "AdjustMaster", ANO, tParam)
                    If NewANO = 0 Then
                        StrMsg = "Process : Adjustment Master Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                    If Not db.Execute("Update Acceptance Set BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "' Where LANO=" & NewANO) Then
                        StrMsg = "Process : Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                Else
                    If ANO <> LANO Then
                        NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.Proclib", "Adjustment", ANO, tParam)
                        If NewANO = 0 Then
                            StrMsg = "Process : Adjustment Master Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                        If Not db.Execute("Update Acceptance Set BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "' Where ANO=" & NewANO) Then
                            StrMsg = "Process : Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    End If
                End If
            Else
                NewANO = ANO
            End If

            If ANO <> LANO Then
                Dim ICoverDetTOI As String
                Dim ICoverDetDPeriod(AddICoverDetCount - 1) As String
                Dim ICoverDetDescription(AddICoverDetCount - 1) As String
                Dim ICoverDetQty(AddICoverDetCount - 1) As String
                Dim ICoverDetUnit(AddICoverDetCount - 1) As String
                Dim ICoverDetUValue(AddICoverDetCount - 1) As String
                Dim ICoverDetAmount(AddICoverDetCount - 1) As String
                Dim ICoverDetMemo(AddICoverDetCount - 1) As String

                ICoverDetTOI = tostr(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetTOI", Findex))))
                For X = 0 To AddICoverDetCount - 1
                    ICoverDetDPeriod(X) = toval(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetDPeriod" & X + 1, Findex))))
                    If ICoverDetDPeriod(X) = 0 Then
                        If X = 0 Then
                            ICoverDetDPeriod(X) = 1
                        Else
                            ICoverDetDPeriod(X) = ICoverDetDPeriod(X - 1) + 1
                        End If
                    End If
                    ICoverDetDescription(X) = tostr(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetDescription" & X + 1, Findex))))
                    ICoverDetQty(X) = toval(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetQty" & X + 1, Findex))))
                    ICoverDetUnit(X) = tostr(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetUnit" & X + 1, Findex))))
                    ICoverDetUValue(X) = toval(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetUValue" & X + 1, Findex))))
                    ICoverDetAmount(X) = toval(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetAmount" & X + 1, Findex))))
                    ICoverDetMemo(X) = tostr(GetFieldValue(FBuffer(GetFieldIndex("ICoverDetMemo" & X + 1, Findex))))
                Next

                If Not AccIDeclaredValue(NewANO, ICoverDetTOI, ICoverDetDPeriod, ICoverDetDescription, ICoverDetQty, ICoverDetUnit, ICoverDetUValue, ICoverDetAmount, ICoverDetMemo) Then
                    StrMsg = "Process Add_Declared_Value Failed !" & vbCrLf
                    StrMsg = db.ErrDesc & vbCrLf
                    GoTo errmsg
                End If
            End If
        End If


        If ImmediateInforceF Then
            Dim ADate As Date
            If BackDatedF Then
                If IsDate(BackDatedDate) Then
                    ADate = BackDatedDate
                Else
                    rs = db.OpenRemoteSet("Select BackDatedDate from Branch Where Branch='" & Branch & "'")
                    ADate = todate(rs.fields("BackDatedDate"))
                End If
            Else
                If IsDate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                    ADate = todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex))))
                Else
                    ADate = Today.Date
                End If

                Dim EndDate As Date
                Dim LockedDate As Date
                EndDate = GetEndDate(Branch)
                LockedDate = GetLockedDate(Branch)
                If DateDiff(DateInterval.Day, EndDate, ADate) <= 0 Then
                    ADate = DateAdd(DateInterval.Day, 1, EndDate)
                End If

                If DateDiff(DateInterval.Day, LockedDate, ADate) <= 0 Then
                    ADate = DateAdd(DateInterval.Day, 1, LockedDate)
                End If
            End If

            db.Var_db_user = AUserID
            db.Var_db_User_Type = IIf(db.GetPrivileges("ALLOWALLPRIVILEGESINFORCE"), "SUPERVISOR", db_user_type)
            If (LANO <> -1 And Not OpenFlag) Then
                If PreInforceConditionsOK(LANO, ADate, "", BackDatedF, True, False, False, StrMsg) Then
                    If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCEMASTER", LANO, AUserID, BackDatedF, ADate) Then
                        StrMsg = "Process : Inforce Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                Else
                    StrMsg = "Process : Inforce Failed !" & vbCrLf & StrMsg & vbCrLf
                    GoTo errmsg
                End If
            Else
                If PreInforceConditionsOK(NewANO, ADate, "", BackDatedF, True, False, False, StrMsg) Then
                    If ANO = LANO Then
                        If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCEMASTER", NewANO, AUserID, BackDatedF, ADate) Then
                            StrMsg = "Process : Inforce Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    Else
                        If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCE", NewANO, AUserID, BackDatedF, ADate) Then
                            StrMsg = "Process : Inforce Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    End If
                Else
                    StrMsg = "Process : Inforce Failed !" & vbCrLf & StrMsg & vbCrLf
                    GoTo errmsg
                End If
            End If
            db.Var_db_user = db_user
            db.Var_db_User_Type = db_user_type

            If Not BackDatedF AndAlso SMSRULE <> "" Then
                Dim inparam(0) As Object
                Dim OutParam As Object = Nothing
                Dim Dataset As DataSet = Nothing
                Dim Datatable As New DataTable
                Dim NewRow As DataRow
                Dim Message As String = ""

                SQL = "Select * from SysbatchBE where 1 <> 1"
                rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
                Dataset = rs.GetDataSet

                Datatable.Columns.Add("MobileNo", Type.GetType("System.String"))
                Datatable.Columns.Add("TrxID", Type.GetType("System.String"))
                Datatable.Columns.Add("Message", Type.GetType("System.String"))
                Datatable.Columns.Add("Product", Type.GetType("System.String"))
                Datatable.Columns.Add("Name", Type.GetType("System.String"))
                Datatable.Columns.Add("SDate", Type.GetType("System.String"))
                Datatable.Columns.Add("EDate", Type.GetType("System.String"))
                Datatable.Columns.Add("Param1", Type.GetType("System.String"))
                Datatable.Columns.Add("Param2", Type.GetType("System.String"))
                Datatable.Columns.Add("Param3", Type.GetType("System.String"))
                Datatable.Columns.Add("Param4", Type.GetType("System.String"))
                Datatable.Columns.Add("Param5", Type.GetType("System.String"))

                NewRow = Datatable.NewRow
                NewRow("Product") = TOC_Description
                NewRow("Name") = GetFieldValue(FBuffer(GetFieldIndex("INSURED", Findex)))
                If ExclusiveF Then
                    NewRow("SDate") = Format(todate(Effective_Date), "dd MMMMM yyyy") & " jam 00:01"
                    NewRow("EDate") = Format(DateAdd(DateInterval.Day, -1, todate(Expiry)), "dd MMMMM yyyy") & " jam 24:00"
                Else
                    NewRow("SDate") = Effective_Date
                    NewRow("EDate") = Expiry
                End If

                Datatable.Rows.Add(NewRow)
                Dataset.Tables.Clear()
                Dataset.Tables.Add(Datatable)

                Message = SetMessage(Dataset, SMSRULE, errmsg)

                Datatable.Rows.Clear()

                NewRow = Datatable.NewRow
                NewRow("Message") = Message
                NewRow("MobileNo") = GetFieldValue(FBuffer(GetFieldIndex("DESCRIPTION3", Findex)))
                NewRow("Param1") = TOC_Description
                NewRow("Param2") = GetFieldValue(FBuffer(GetFieldIndex("INSURED", Findex)))
                NewRow("Param3") = Format(Today.Date, "dd MMMMM yyyy")
                NewRow("Param4") = NewANO
                Datatable.Rows.Add(NewRow)
                Dataset.Tables.Clear()
                Dataset.Tables.Add(Datatable)

                inparam(0) = UCase(SMSRULE)
                If Not SendMessageViaURL(db_user, db_password, inparam, OutParam, Dataset, errmsg) Then
                    StrMsg = errmsg
                    GoTo errmsg
                End If
            End If
        ElseIf (InforceF Or InforceBulkF) Then
            rs = db.OpenRemoteSet("Select RegNo, CertificateNo, BatchNo from acceptance where ANO = " & NewANO)
            RegNo = rs.fields("RegNo")
            CertificateNo = rs.fields("CertificateNo")
            BatchNo = rs.fields("BatchNo")

            If InforceBulkF Then
                rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='" & CertificateNo & "'")
                If rs.Eof Then
                    rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='' and BatchNo='" & BatchNo & "'")
                End If
                CertificateNo = ""
            Else
                If LANO <> -1 And Not OpenFlag Then
                    rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo=''")
                Else
                    rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='" & CertificateNo & "'")
                End If
            End If
            If rs.Eof Then
                rs.AddNew()
            Else
                rs.Edit()
            End If
            rs.fields("RegNo") = RegNo
            rs.fields("CertificateNo") = CertificateNo
            rs.fields("BatchNo") = BatchNo
            rs.fields("Status") = "R"
            rs.fields("Last_Opr") = AUserID
            rs.fields("Last_Update") = Today.Date
            If IsDate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                rs.fields("ADate") = todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex))))
            End If

            If Not rs.Update Then
                StrMsg = db.ErrDesc & vbCrLf
                GoTo errmsg
            End If
        End If

        If AutoPrintF Then
            If LANO <> -1 And Not OpenFlag Then
                Insert_Policy_Auto_Print(LANO, "")
            Else
                Insert_Policy_Auto_Print(NewANO, "")
            End If
        End If

        If Not db.ReleaseLockedObject("Policy" & LockedKey) Then GoTo errmsg
        Upload_BE = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Upload_BE = False
    End Function
    Private Function CheckRequestingActivities(ByVal FName As String, ByVal SType As String, ByVal AppNo As Object, ByVal PDate As Date, ByVal PTime As String, ByRef RequestingUser As String) As Boolean
        Dim SQL As String
        On Error GoTo errmsg

        SQL = "Select Top 1 UserID, RequestingUser "
        SQL = SQL & " from SysRequest"
        If SType = "UND" Or SType = "UND-MW" Then
            SQL = SQL & " Where Param1='SEND' and Param2 in ('UND','UND-MW') and Status='P' and ApprovedFName='" & FName & "' and ApprovedStatus='A' and ((LUserDate>'" & Format(PDate, "MM/DD/YYYY") & "') or (LUserDate='" & Format(PDate, "MM/DD/YYYY") & "' and LUserTime>='" & PTime & "'))"
        ElseIf SType = "CLM" Or SType = "CLM-MW" Then
            SQL = SQL & " Where Param1='SEND' and Param2 in ('CLM','CLM-MW') and Status='P' and ApprovedFName='" & FName & "' and ApprovedStatus='A' and ((LUserDate>'" & Format(PDate, "MM/DD/YYYY") & "') or (LUserDate='" & Format(PDate, "MM/DD/YYYY") & "' and LUserTime>='" & PTime & "'))"
        Else
            SQL = SQL & " Where Param1='SEND' and Param2='" & SType & "' and Status='P' and ApprovedFName='" & FName & "' and ApprovedStatus='A' and ((LUserDate>'" & Format(PDate, "MM/DD/YYYY") & "') or (LUserDate='" & Format(PDate, "MM/DD/YYYY") & "' and LUserTime>='" & PTime & "'))"
        End If
        Select Case SType
            Case "UND", "UND-MW", "IT", "MAR", "SVC", "POLH"
                SQL = SQL & " and Param3='" & AppNo & "'"
            Case "UND-OBJ"
                SQL = SQL & " and Param6='" & AppNo & "'"
            Case "CLM-EXP"
                SQL = SQL & " and Param6='" & AppNo & "'"
            Case "FA", "RQ"
                SQL = SQL & " and Param6='" & AppNo & "'"
            Case Else
                SQL = SQL & " and Param4='" & AppNo & "'"
        End Select
        SQL = SQL & " Order by ID Desc"

        Dim rs As RemoteSet
        rs = db.OpenRemoteSet(SQL)
        RequestingUser = tostr(rs.fields("RequestingUser"))
        If RequestingUser = "" Then
            RequestingUser = tostr(rs.fields("UserID"))
        End If
        CheckRequestingActivities = Not (rs.Eof)
        Exit Function
errmsg:
        CheckRequestingActivities = False
    End Function
    Private Function isNotPremiumPaid(ByVal ANO As Long, ByVal PDate As Date) As Boolean
        Dim rs As RemoteSet
        Dim PremiumOutstanding As Double
        rs = db.OpenQueryDef("QPremiumAmount", adOpenForwardonly, ANO, PDate)
        PremiumOutstanding = toval(rs.fields("PremiumOutstanding"))
        isNotPremiumPaid = ((PremiumOutstanding) > toval(GetAppSetting("NominalPaidTolerance")))
    End Function
    Private Function isPremiumPaid(ByVal ANO As Long, ByVal PDate As Date) As Boolean
        Dim rs As RemoteSet
        Dim PremiumAmount As Double
        Dim PremiumPaid As Double
        rs = db.OpenQueryDef("QPremiumAmount", adOpenForwardonly, ANO, PDate)
        PremiumAmount = toval(rs.fields("PremiumAmount"))
        PremiumPaid = toval(rs.fields("PremiumPaid"))

        If tostr(rs.fields("DueDate")) <> "" AndAlso IsDate(rs.fields("DueDate")) Then
            If DateDiff(DateInterval.Day, rs.fields("DueDate"), PDate) >= 0 Then
                isPremiumPaid = ((PremiumAmount - PremiumPaid) <= toval(GetAppSetting("NominalPaidTolerance")))
            Else
                isPremiumPaid = True
            End If
        Else
            isPremiumPaid = True
        End If
    End Function
    Private Function PreEndorseConditionsOK(ByVal ANO As Long, ByVal NewPDate As Date, ByVal EndorseAllF As Boolean, ByVal AppSource As String, ByVal ExternalF As Boolean, ByRef ErrMsg As String) As Boolean
        Dim rs As RemoteSet
        Dim AType As String
        Dim EMethod As String
        Dim SDate As Date
        Dim EDate As Date
        Dim PDate As Date
        Dim Remarks As String
        Dim LANO As Long
        Dim pAType As String
        Dim AStatus As String
        Dim MAStatus As String

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select A.AStatus, mA.AStatus as MAStatus, A.EMethod, A.AType, A.PDate, A.SDate, A.EDate, A.LANO, A.Remarks, pA.AType as pAType from Acceptance A Left Join Acceptance mA on (mA.ANO=A.LANO and mA.ANO=mA.LANO) Left Join Acceptance pA on (pA.ANO=A.pANO) Where A.ANO=" & ANO)
        If rs.Eof Then
            ErrMsg = "Policy/Certificate Data Not Found !"
            GoTo errmsg
        End If
        EMethod = tostr(rs.fields("EMethod"))
        AType = tostr(rs.fields("AType"))
        PDate = todate(rs.fields("PDate"))
        SDate = todate(rs.fields("SDate"))
        EDate = todate(rs.fields("EDate"))
        LANO = toval(rs.fields("LANO"))
        Remarks = tostr(rs.fields("Remarks"))
        pAType = tostr(rs.fields("pAType"))
        AStatus = tostr(rs.fields("AStatus"))
        MAStatus = tostr(rs.fields("MAStatus"))

        If AType = "A" Or pAType = "A" Then
            ErrMsg = "Endorsement not for Adjustment !"
            GoTo errmsg
        End If

        If AStatus <> "I" Then
            ErrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        If LANO <> -1 AndAlso ANO <> LANO AndAlso MAStatus <> "I" Then
            ErrMsg = "Please Check Master Policy Data Status !"
            GoTo errmsg
        End If

        If DateDiff(DateInterval.Day, PDate, NewPDate) < 0 Then
            Select Case AType
                Case "N"
                    ErrMsg = "Effective Date for this endorsement can't be earlier than current policy."
                Case "E"
                    ErrMsg = "Effective Date for this endorsement can't be earlier than current endorsement."
                Case "C"
                    ErrMsg = "Effective Date for this endorsement can't be earlier than current cancellation."
            End Select
            GoTo errmsg
        End If

        If AType = "C" Then ' Endorsement Over Cancellation
            If Not db.GetPrivileges("EndorseCancellation") Then
                ErrMsg = "Not Authorized Endorse Over Cancellation !"
                GoTo errmsg
            End If
            If Remarks.ToUpper = "AUTO LAPSING" Then
                If Not db.GetPrivileges("ALLOWENDORSEALPOLICY") Then
                    ErrMsg = "Not Authorized Endorse Auto Lapse Policy !"
                    GoTo errmsg
                End If
            End If
        End If

        If AType <> "A" And EMethod <> "A" Then
            If DateDiff(DateInterval.Day, SDate, NewPDate) < 0 Then
                ErrMsg = "Effective Date can't be earlier than Start Date"
                GoTo errmsg
            End If

            If DateDiff(DateInterval.Day, EDate, NewPDate) > 0 Then
                ErrMsg = "Effective Date can't be greater than Expiry Date"
                GoTo errmsg
            End If
        End If

        If AType = "C" And EMethod <> "A" Then    ' Endorse Over Cancellation
            If DateDiff(DateInterval.Day, PDate, NewPDate) <> 0 Then
                ErrMsg = "Effective Date must be the Same with Cancellation Date"
                GoTo errmsg
            End If
        End If
        rs.CloseRemoteSet()

        ' Check Existing Claim Incurred (Move to PreInforceConditions)
        If Not db.GetPrivileges("ALLOWENDORSEWITHCLAIMINCURRED") Then
            If EndorseAllF Then
                rs = db.OpenRemoteSet("Select Top 1 C.LossDate from Claim C, Acceptance A1, Acceptance A2 Where A1.AType in ('N','E','C') and A1.AStatus='I' and A1.ANO<>A1.LANO and A1.PPDate>='" & Format(NewPDate, "MM/DD/YYYY") & "' and A1.LANO=" & ANO & " and A2.OANO=A1.OANO and C.ANO=A2.ANO and C.CType<>'C' and (C.CStatus<>'C' or C.PCstatus='A') and not exists (Select pCNO from Claim Where Claim.pCNO=C.CNO and Claim.CStatus<>'R') order By C.LossDate Desc")
            Else
                rs = db.OpenRemoteSet("Select Top 1 C.LossDate from Claim C, Acceptance A1, Acceptance A2 Where A1.ANO=" & ANO & " and A2.OANO=A1.OANO and C.ANO=A2.ANO and C.CType<>'C' and (C.CStatus<>'C' or C.PCstatus='A') and not exists (Select pCNO from Claim Where Claim.pCNO=C.CNO and Claim.CStatus<>'R') order By C.LossDate Desc")
            End If

            If Not rs.Eof Then
                If IsDate(rs.fields("LossDate")) Then
                    If DateDiff(DateInterval.Day, rs.fields("LossDate"), NewPDate) < 0 Then
                        ErrMsg = "Claim Already Incurred on " & Format(rs.fields("LossDate"), "d")
                        GoTo errmsg
                    End If
                End If
            End If
        End If

        ' Check Total Loss
        rs = db.OpenQueryDef("QCLACC_6", adOpenForwardonly, ANO)
        If Not rs.Eof Then
            ErrMsg = "Already Has Claim Total Loss (ClaimNo : " & rs.fields("ClaimNo") & ") on " & Format(rs.fields("LossDate"), "d") & " !"
            GoTo errmsg
        End If

        If EMethod <> "A" Then
            rs = db.OpenRemoteSet("Select R.PDate as R_PDate, R.PPDate as R_PPDate, R.RDate, R.NRDate from RArrHeader R Where R.ANO=" & ANO)
            If Not rs.Eof Then
                ' Not Clean Cut
                If (DateDiff(DateInterval.Day, rs.fields("R_PDate"), rs.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rs.fields("R_PPDate"), rs.fields("NRDate")) = 0) And (DateDiff(DateInterval.Day, todate(rs.fields("RDate")), NewPDate) < 0 Or DateDiff(DateInterval.Day, todate(rs.fields("NRDate")), NewPDate) > 0) Then
                    ErrMsg = "Effective Date Should Be Between Treaty Period On " & Format(todate(rs.fields("RDate")), "d") & " - " & Format(todate(rs.fields("NRDate")), "d")
                    GoTo errmsg
                End If

                ' Clean Cut
                If Not (DateDiff(DateInterval.Day, rs.fields("R_PDate"), rs.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rs.fields("R_PPDate"), rs.fields("NRDate")) = 0) And DateDiff(DateInterval.Day, NewPDate, rs.fields("R_PPDate")) < 0 Then
                    ErrMsg = "Policy Needs Annual Treaty Reallocation, Please Review The Reinsurance Date on " & Format(rs.fields("R_PPDate"), "d") & " !"
                    GoTo errmsg
                End If
            End If
        End If

        If CBool(toval(GetAppSetting("CheckUnPaidPremiumWhenEndorseF"))) Then
            If ExternalF Then
                If Not db.GetPrivileges("UNPAIDPREMIUM") Then
                    Dim PremiumAmount As Double
                    Dim PremiumPaid As Double
                    If Not isPremiumPaid(ANO, Today.Date) Then
                        Dim RequestingUser As String = ""
                        If Not (CheckRequestingActivities("UNPAIDPREMIUM", "UND", ANO, NewPDate, "", RequestingUser) AndAlso RequestingUser.ToUpper = db_user.ToUpper) Then
                            ErrMsg = "Can't Endorse The Policy which is Not Yet Paid !"
                            GoTo errmsg
                        End If
                    End If
                End If
            End If
        End If

        If ANO = LANO Then
            rs = db.OpenRemoteSet("Select top 1 CertificateNo from Acceptance Where LANO=" & LANO & " and AStatus in ('W','T')")
            If Not rs.Eof Then
                ErrMsg = "Policy Has a Detail with Waiting Status (Ex. Certificate No. " & rs.fields("CertificateNo") & ") !"
                GoTo errmsg
            End If
        End If

        rs = db.OpenRemoteSet("Select A1.RegNo from Acceptance A1 Where ((AType in ('A') and AStatus<>'C') or AType not in ('A')) and PANO=" & ANO)
        If Not rs.Eof Then
            ErrMsg = "Already Endorsed (Cancelled) ! Referred to The Policy Data. (Reg No. " & rs.fields("RegNo") & ")"
            GoTo errmsg
        End If

        If AppSource = "MKT" Then
            If Not db.GetPrivileges("ALLOWENDORSEMKT") Then
                ErrMsg = "Not Allowed To Endorse The Marketing Data"
                GoTo errmsg
            End If
        End If

        PreEndorseConditionsOK = True
        Exit Function
errmsg:
        ErrMsg = StrError(ErrMsg)
        PNotes(ANO, "POLICY", "Policy Endorse : " & ErrMsg)
        PreEndorseConditionsOK = False
    End Function

    Private Function SaveListTC(ByVal ANO As Long, ByVal TOC As String, ByVal TCCount As Integer, ByRef findex() As Object, ByRef fbuffer() As Object, ByRef ErrMsg As String) As Boolean
