                        GoTo errmsg
                    End If

                    SQL = "Update V Set RefType='" & RefType & "'"
                    SQL = SQL & " from (Select top 1 AdmNo from AccAss Where Type in ('DI','IC','IR','IT','IX') and Code='P' and AccAss.ANO=" & NewANO & ") A1"
                    SQL = SQL & " Inner Join Admlink A2 on (A2.AdmNo=A1.AdmNo)"
                    SQL = SQL & " Inner Join nVoucher V on (V.Voucher=A2.Voucher)"

                    If Not db.Execute(SQL) Then
                        StrMsg = "Update Payment Reference Type Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                End If


            End If
            db.Var_db_user = db_user
            db.Var_db_User_Type = db_user_type
        ElseIf (InforceF Or InforceBulkF) Then
            Dim RegNo As String
            rs = db.OpenRemoteSet("Select RegNo, CertificateNo, BatchNo from acceptance where ANO = " & NewANO)
            RegNo = rs.fields("RegNo")
            CertificateNo = rs.fields("CertificateNo")
            BatchNo = rs.fields("BatchNo")

            If InforceBulkF Then
                rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='" & CertificateNo & "'")
                If rs.Eof Then
                    rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='' and BatchNo='" & BatchNo & "'")
                End If
                CertificateNo = ""
            Else
                If LANO <> -1 And Not OpenFlag Then
                    rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo=''")
                Else
                    rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='" & CertificateNo & "'")
                End If
            End If
            If rs.Eof Then
                rs.AddNew()
            Else
                rs.Edit()
            End If
            rs.fields("RegNo") = RegNo
            rs.fields("CertificateNo") = CertificateNo
            rs.fields("BatchNo") = BatchNo
            rs.fields("Status") = "R"
            rs.fields("Last_Opr") = AUserID
            rs.fields("Last_Update") = Today.Date
            If IsDate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                rs.fields("ADate") = todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", Findex))))
            End If

            If Not rs.Update Then
                StrMsg = db.ErrDesc & vbCrLf
                GoTo errmsg
            End If
        End If

        If AutoPrintF Then
            If LANO <> -1 And Not OpenFlag Then
                Insert_Policy_Auto_Print(LANO, "")
            Else
                Insert_Policy_Auto_Print(NewANO, "")
            End If
        End If

        If Not db.ReleaseLockedObject("Policy" & LockedKey) Then GoTo errmsg
        Upload_BC = True
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Upload_BC = False
    End Function

    Private Function Add_Fee_Duty(ByVal ANO As Long, ByVal Param As Object) As Boolean
        Try

            Dim rs As RemoteSet

            rs = db.OpenRemoteSet("Select * from AccFd where ANO = " & ANO & " and ID = '" & getInParamValue(Param, 0) & "' and FDID = '" & getInParamValue(Param, 1) & "' and PolicyYear=" & toval(getInParamValue(Param, 6)))
            If rs.Eof Then
                rs.AddNew()
            Else
                rs.Edit()
            End If
            rs.fields("ANO") = ANO
            rs.fields("ID") = getInParamValue(Param, 0)
            rs.fields("FDID") = getInParamValue(Param, 1)
            rs.fields("Currency") = UCase(getInParamValue(Param, 2))
            rs.fields("Amount") = getInParamValue(Param, 3)
            rs.fields("AmountPCT") = getInParamValue(Param, 4)
            rs.fields("Remark") = getInParamValue(Param, 5)
            rs.fields("PolicyYear") = toval(getInParamValue(Param, 6))
            rs.fields("ContributionF") = toval(getInParamValue(Param, 7))
            rs.fields("CessionF") = toval(getInParamValue(Param, 8))
            rs.fields("AmountPCTBased") = toval(getInParamValue(Param, 9))
            rs.fields("LUserID") = db_user
            rs.fields("LDate") = Today.Date
            rs.fields("AutoGeneratedF") = False
            If Not rs.Update Then Throw New Exception(rs.ErrDesc)
            rs.CloseRemoteSet()
            Add_Fee_Duty = True
        Catch ex As Exception
            StrMsg = ex.Message
            Add_Fee_Duty = False
        End Try
    End Function
    Private Function Add_Deductible(ByVal ANO As Long, ByVal DCODE As String, ByVal SECTION As String, ByVal TOR As String, ByVal REMARKS As String, ByVal REMARKS_1 As String, ByVal PCTTSI As Double, ByVal PCTCL As Double, ByVal FIXEDMIN As Double, ByVal FIXEDMAX As Double, ByVal CURRENCY As String, ByVal SDate As Date, ByVal EDate As Date, ByVal IUnit As String) As Boolean
        Try
            Dim rs As RemoteSet
            If SECTION <> "" Then
                rs = db.OpenRemoteSet("Select Section from AccSection Where ANO=" & ANO & " and Section='" & SECTION & "'")
                If rs.Eof Then
                    Throw New Exception("No Deductible Section (" & SECTION & ") !")
                End If
            End If
            rs = db.OpenRemoteSet("Select * from AccDed where ANO=" & ANO & " and TOR='" & TOR & "' and DCode='" & DCODE & "' and SECTION='" & SECTION & "'")
            If rs.Eof Then
                rs.AddNew()
                rs.fields("ANO") = ANO
                rs.fields("TOR") = TOR
                rs.fields("DCODE") = DCODE
                rs.fields("SECTION") = SECTION
            Else
                rs.Edit()
            End If
            rs.fields("REMARKS") = REMARKS
            rs.fields("REMARKS_1") = REMARKS_1
            rs.fields("PCTTSI") = PCTTSI
            rs.fields("PCTCL") = PCTCL
            rs.fields("FIXEDMIN") = FIXEDMIN
            rs.fields("FIXEDMAX") = FIXEDMAX
            rs.fields("CURRENCY") = CURRENCY
            rs.fields("IUNIT") = IUnit
            rs.fields("METHOD") = ""
            rs.fields("FIXEDMIN_AOE") = 0
            rs.fields("FIXEDMAX_AOE") = 0
            rs.fields("PolicyYear") = 0
            rs.fields("SDate") = SDate
            rs.fields("EDate") = EDate
            rs.fields("STRTSI") = "TSI"
            rs.fields("LUserID") = db_user
            rs.fields("LDate") = Today.Date
            If Not rs.Update Then Throw New Exception(rs.ErrDesc)
            rs.CloseRemoteSet()
            Add_Deductible = True
        Catch ex As Exception
            StrMsg = ex.Message
            Add_Deductible = False
        End Try
    End Function
