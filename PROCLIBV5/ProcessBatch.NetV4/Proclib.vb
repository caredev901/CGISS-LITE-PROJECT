    Private Function Endorse_BusinessSource(ByVal PDate As Date, ByVal LANO As Long, ByVal ANO As Long, ByVal ID As String, Optional ByVal Fee As Object = Nothing, Optional ByVal BSType As String = "", Optional ByVal OBSType As String = "", Optional ByVal BSPeriod As Integer = 0, Optional ByVal BSCode As String = "", Optional ByVal BSFeeAmount As Object = Nothing, Optional ByVal GrossF As Object = Nothing, Optional ByVal GrossBLF As Object = Nothing, Optional ByVal NoRefundF As Object = Nothing, Optional ByVal CommPoolF As Object = Nothing, Optional ByVal GrossUpF As Object = Nothing, Optional ByVal TreatyOverridingF As Object = Nothing, Optional ByVal MemberF As Object = Nothing, Optional ByVal UpFee As Object = Nothing, Optional ByVal UpFeeAmount As Object = Nothing, Optional ByVal PreferredF As Object = Nothing, Optional ByVal MemberFeeF As Object = Nothing, Optional ByVal NetF As Object = Nothing, Optional ByVal NetGroupF As Object = Nothing, Optional ByVal UseCurrTypeF As Object = Nothing, Optional ByVal Installment As Integer = 0) As Boolean
        Dim rs As RemoteSet
        Dim rsDst As RemoteSet
        Dim StrMsg As String = ""
        Dim MTaxType As String

        On Error GoTo errmsg

        If ANO = LANO Or LANO = -1 Then
            rs = db.OpenRemoteSet("Select Top 1 Profile.ID, TaxType.MTaxType, LOB.BSType from Profile Left Join LOB on (LOB.LOB=Profile.LOB) Left Join TaxType on (TaxType.TaxType=Profile.TaxType) Where Profile.ID='" & ID & "' or Profile.RefID='" & ID & "' or Profile.Name='" & ID & "'")
            If rs.Eof Then
                StrMsg = "Business Source ID not Found !"
                GoTo errmsg
            End If
            MTaxType = rs.fields("MTaxType")

            If BSType = "" Then BSType = rs.fields("BSType")
            ID = tostr(rs.fields("ID"))

            Dim BSID As String = ID
            rs = db.OpenQueryDef("GetBusinessSourcePaidTo", adOpenKeyset, ID, PDate)
            If Not rs.Eof AndAlso rs.fields("ID") <> ID Then
                BSID = rs.fields("ID")
            End If

            If OBSType <> "" Then
                rsDst = db.OpenRemoteSet("Select * from AccBS where ANO =" & ANO & " and ID='" & ID & "' and OBSType = '" & OBSType & "'")
            ElseIf BSType <> "" Then
                rsDst = db.OpenRemoteSet("Select * from AccBS where ANO =" & ANO & " and ID='" & ID & "' and BSType = '" & BSType & "'")
            Else
                rsDst = db.OpenRemoteSet("Select * from AccBS where ANO =" & ANO & " and ID='" & ID & "'")
            End If
            If rsDst.Eof Then
                rsDst.AddNew()
                rsDst.fields("ANO") = ANO
                rsDst.fields("ID") = ID
                rsDst.fields("BSType") = IIf(BSType = "", IIf(MTaxType = "PASAL23", "B", "A"), BSType)
                If rsDst.fields("OBSType") = "" Then rsDst.fields("OBSType") = rsDst.fields("BSType")
            Else
                rsDst.Edit()
                rsDst.fields("BSType") = IIf(BSType = "", rsDst.fields("BSType"), BSType)
            End If
            If BSCode = "" Then
                rsDst.fields("Fee") = toval(Fee)
                rsDst.fields("FeeAmount") = IIf(BSFeeAmount Is Nothing, toval(rsDst.fields("FeeAmount")), toval(BSFeeAmount))
            End If
            rsDst.fields("BSID") = BSID
            rsDst.fields("UpFee") = toval(UpFee)
            rsDst.fields("UpFeeAmount") = IIf(UpFeeAmount Is Nothing, toval(rsDst.fields("UpFeeAmount")), toval(UpFeeAmount))
            rsDst.fields("GrossF") = IIf(GrossF Is Nothing, toval(rsDst.fields("GrossF")), toval(GrossF))
            rsDst.fields("GrossBLF") = IIf(GrossBLF Is Nothing, toval(rsDst.fields("GrossBLF")), toval(GrossBLF))
            rsDst.fields("NoRefundF") = IIf(NoRefundF Is Nothing, toval(rsDst.fields("NoRefundF")), toval(NoRefundF))
            rsDst.fields("CommPoolF") = IIf(CommPoolF Is Nothing, toval(rsDst.fields("CommPoolF")), toval(CommPoolF))
            rsDst.fields("GrossUpF") = IIf(GrossUpF Is Nothing, toval(rsDst.fields("GrossUpF")), toval(GrossUpF))
            rsDst.fields("TreatyOverridingF") = IIf(TreatyOverridingF Is Nothing, toval(rsDst.fields("TreatyOverridingF")), toval(TreatyOverridingF))
            rsDst.fields("MemberF") = IIf(MemberF Is Nothing, toval(rsDst.fields("MemberF")), toval(MemberF))
            rsDst.fields("MemberFeeF") = IIf(MemberFeeF Is Nothing, toval(rsDst.fields("MemberFeeF")), toval(MemberFeeF))
            rsDst.fields("PreferredF") = IIf(PreferredF Is Nothing, toval(rsDst.fields("PreferredF")), toval(PreferredF))
            rsDst.fields("NetF") = IIf(NetF Is Nothing, toval(rsDst.fields("NetF")), toval(NetF))
            rsDst.fields("NetGroupF") = IIf(NetGroupF Is Nothing, toval(rsDst.fields("NetGroupF")), toval(NetGroupF))
            rsDst.fields("UseCurrTypeF") = IIf(UseCurrTypeF Is Nothing, toval(rsDst.fields("UseCurrTypeF")), toval(UseCurrTypeF))
            rsDst.fields("Installment") = IIf(Installment = 0, toval(rsDst.fields("Installment")), Installment)
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            If Not rsDst.Update Then
                StrMsg = db.ErrDesc
                GoTo errmsg
            End If

        Else
            If Not Create_Alternate_BusinessSource(PDate, LANO, ANO, ID, Fee, BSType, OBSType, BSPeriod, BSCode, BSFeeAmount, GrossF, GrossBLF, NoRefundF, CommPoolF, GrossUpF, TreatyOverridingF, MemberF, UpFee, UpFeeAmount, PreferredF, MemberFeeF, NetF, NetGroupF, UseCurrTypeF, Installment) Then GoTo errmsg
        End If

        Endorse_BusinessSource = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Endorse_BusinessSource = False
    End Function
    Private Function Create_Alternate_BusinessSource(ByVal PDate As Date, ByVal LANO As Long, ByVal ANO As Long, ByVal ID As String, Optional ByVal Fee As Object = Nothing, Optional ByVal BSType As String = "", Optional ByVal OBSType As String = "", Optional ByVal BSPeriod As Integer = 0, Optional ByVal BSCode As String = "", Optional ByVal BSFeeAmount As Object = Nothing, Optional ByVal GrossF As Object = Nothing, Optional ByVal GrossBLF As Object = Nothing, Optional ByVal NoRefundF As Object = Nothing, Optional ByVal CommPoolF As Object = Nothing, Optional ByVal GrossUpF As Object = Nothing, Optional ByVal TreatyOverridingF As Object = Nothing, Optional ByVal MemberF As Object = Nothing, Optional ByVal UpFee As Object = Nothing, Optional ByVal UpFeeAmount As Object = Nothing, Optional ByVal PreferredF As Object = Nothing, Optional ByVal MemberFeeF As Object = Nothing, Optional ByVal NetF As Object = Nothing, Optional ByVal NetGroupF As Object = Nothing, Optional ByVal UseCurrTypeF As Object = Nothing, Optional ByVal Installment As Integer = 0) As Boolean
        Dim rs As RemoteSet
        Dim rsDst As RemoteSet
        Dim StrMsg As String = ""
        Dim MTaxType As String

        rs = db.OpenRemoteSet("Select Top 1 Profile.ID, TaxType.MTaxType, LOB.BSType from Profile Left Join LOB on (LOB.LOB=Profile.LOB) Left Join TaxType on (TaxType.TaxType=Profile.TaxType) Where Profile.ID='" & ID & "' or Profile.RefID='" & ID & "' or Profile.Name='" & ID & "'")
        If rs.Eof Then
            StrMsg = "Business Source ID not Found !"
            GoTo errmsg
        End If

        MTaxType = rs.fields("MTaxType")
        If BSType = "" Then BSType = rs.fields("BSType")

        If OBSType <> "" Then
            rsDst = db.OpenRemoteSet("Select * from AAccBS where ANO =" & ANO & " and ID='" & ID & "' and OBSType = '" & OBSType & "'")
        ElseIf BSType <> "" Then
            rsDst = db.OpenRemoteSet("Select * from AAccBS where ANO =" & ANO & " and ID='" & ID & "' and BSType = '" & BSType & "'")
        Else
            rsDst = db.OpenRemoteSet("Select * from AAccBS where ANO =" & ANO & " and ID='" & ID & "'")
        End If

        Dim BSID As String = ID
        rs = db.OpenQueryDef("GetBusinessSourcePaidTo", adOpenKeyset, ID, PDate)
        If Not rs.Eof AndAlso rs.fields("ID") <> ID Then
            BSID = rs.fields("ID")
        End If

        If rsDst.Eof Then
            rsDst.AddNew()
            rsDst.fields("ANO") = ANO
            rsDst.fields("ID") = ID
            rsDst.fields("BSType") = IIf(BSType = "", IIf(MTaxType = "PASAL23", "B", "A"), BSType)
            If rsDst.fields("OBSType") = "" Then rsDst.fields("OBSType") = rsDst.fields("BSType")
        Else
            rsDst.Edit()
        End If
        If BSCode = "" Then
            rsDst.fields("Fee") = toval(Fee)
            rsDst.fields("FeeAmount") = IIf(BSFeeAmount Is Nothing, toval(rsDst.fields("FeeAmount")), toval(BSFeeAmount))
        End If
        rsDst.fields("BSID") = BSID
        rsDst.fields("UpFee") = toval(UpFee)
        rsDst.fields("UpFeeAmount") = IIf(UpFeeAmount Is Nothing, toval(rsDst.fields("UpFeeAmount")), toval(UpFeeAmount))
        rsDst.fields("GrossF") = IIf(GrossF Is Nothing, toval(rsDst.fields("GrossF")), toval(GrossF))
        rsDst.fields("GrossBLF") = IIf(GrossBLF Is Nothing, toval(rsDst.fields("GrossBLF")), toval(GrossBLF))
        rsDst.fields("NoRefundF") = IIf(NoRefundF Is Nothing, toval(rsDst.fields("NoRefundF")), toval(NoRefundF))
        rsDst.fields("CommPoolF") = IIf(CommPoolF Is Nothing, toval(rsDst.fields("CommPoolF")), toval(CommPoolF))
        rsDst.fields("GrossUpF") = IIf(GrossUpF Is Nothing, toval(rsDst.fields("GrossUpF")), toval(GrossUpF))
        rsDst.fields("TreatyOverridingF") = IIf(TreatyOverridingF Is Nothing, toval(rsDst.fields("TreatyOverridingF")), toval(TreatyOverridingF))
        rsDst.fields("MemberF") = IIf(MemberF Is Nothing, toval(rsDst.fields("MemberF")), toval(MemberF))
        rsDst.fields("MemberFeeF") = IIf(MemberFeeF Is Nothing, toval(rsDst.fields("MemberFeeF")), toval(MemberFeeF))
        rsDst.fields("PreferredF") = IIf(PreferredF Is Nothing, toval(rsDst.fields("PreferredF")), toval(PreferredF))
        rsDst.fields("NetF") = IIf(NetF Is Nothing, toval(rsDst.fields("NetF")), toval(NetF))
        rsDst.fields("NetGroupF") = IIf(NetGroupF Is Nothing, toval(rsDst.fields("NetGroupF")), toval(NetGroupF))
        rsDst.fields("UseCurrTypeF") = IIf(UseCurrTypeF Is Nothing, toval(rsDst.fields("UseCurrTypeF")), toval(UseCurrTypeF))
        rsDst.fields("Installment") = IIf(Installment = 0, toval(rsDst.fields("Installment")), Installment)
        rsDst.fields("LUserID") = db_user
        rsDst.fields("LDate") = Today.Date
        If Not rsDst.Update Then
            StrMsg = db.ErrDesc
            GoTo errmsg
        End If



        Create_Alternate_BusinessSource = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Create_Alternate_BusinessSource = False
    End Function
    Private Function Create_Scheme_Payor(ByVal MasterANO As Long, ByVal TrNO As Long, ByVal OverwritePayorF As Boolean, ByVal ID As String, ByVal Installment As Integer, ByVal Period As Integer, ByVal FirstDue As Date, ByVal LastDue As Date, ByVal Discount As Double, ByVal Grace As Integer, ByVal WPC As Integer, ByVal PolicyYearF As Boolean, ByVal PolicyYearInstallmentF As Boolean, ByVal AccountNo As String, ByVal BankAccount As String, ByVal ExpDate As Date, ByVal AutoInstallmentPolicyYearF As Boolean, Optional ByVal tPrefix As String = "") As Boolean
        Dim Currrow As Integer
        Dim tPCT As Double
        Dim PCT As Double
        Dim rsDst As RemoteSet
        Dim StrMsg As String = ""
        Dim rsSource As RemoteSet
        rsSource = db.OpenRemoteSet("Select * from Payor where ANO =" & MasterANO)
        If rsSource.Eof Then GoTo errmsg

        rsDst = db.OpenRemoteSet("Select * from " & tPrefix & "Scheme_Payor Where 1<>1")
        rsDst.AddNew()

        On Error GoTo errmsg
        If Not OverwritePayorF Then
            If Discount = 0 Then Discount = rsSource.fields("Discount")
            If Grace = 0 Then Grace = rsSource.fields("Grace")
            If WPC = 0 Then WPC = rsSource.fields("WPC")
            If Installment = 0 Then Installment = rsSource.fields("Installment")
            If Period = 0 Then Period = rsSource.fields("Period")
            If PolicyYearF = 0 Then PolicyYearF = rsSource.fields("PolicyYearF")
        End If

        rsDst.fields("TRNO") = TrNO
        rsDst.fields("ID") = IIf(ID <> "", ID, rsSource.fields("ID"))
        rsDst.fields("REFTYPE") = rsSource.fields("REFTYPE")
        rsDst.fields("BANK") = rsSource.fields("BANK")
        rsDst.fields("BANKNAME") = rsSource.fields("BANKNAME")
        rsDst.fields("BANKBRANCH") = rsSource.fields("BANKBRANCH")
        rsDst.fields("AccountNo") = IIf(AccountNo <> "", AccountNo, rsSource.fields("AccountNo"))
        rsDst.fields("BANKACCOUNT") = IIf(BankAccount <> "", BankAccount, rsSource.fields("BANKACCOUNT"))
        rsDst.fields("EXPDATE") = ExpDate
        rsDst.fields("ADDRESS_1") = rsSource.fields("ADDRESS_1")
        rsDst.fields("ADDRESS_2") = rsSource.fields("ADDRESS_2")
        rsDst.fields("ADDRESS_3") = rsSource.fields("ADDRESS_3")
        rsDst.fields("WPC") = WPC
        rsDst.fields("PolicyYearF") = PolicyYearF
        rsDst.fields("Discount") = Discount
        rsDst.fields("Grace") = Grace
        rsDst.fields("Period") = Period
        rsDst.fields("AutoInstallmentPolicyYearF") = AutoInstallmentPolicyYearF

        If Not PolicyYearInstallmentF Then
            FirstDue = DateAdd(DateInterval.Day, Grace, FirstDue)

            If Installment > 0 Then
                PCT = 100 / Installment

                tPCT = 0
                Currrow = 1
                Do While Currrow <= Installment
                    rsDst.fields("IDate_" & Currrow) = DateAdd(DateInterval.Month, (Currrow - 1) * Period, FirstDue)
                    If Currrow < Installment Then
                        rsDst.fields("IPCT_" & Currrow) = PCT
                    Else
                        rsDst.fields("IPCT_" & Currrow) = 100 - tPCT
                    End If
                    Currrow = Currrow + 1
                    tPCT = tPCT + PCT
                Loop
            End If
        Else
            Dim NumOfMonths = DateDiff(DateInterval.Month, FirstDue, LastDue)

            Installment = NumOfMonths \ 12
            If NumOfMonths Mod 12 <> 0 Then
                Installment = Installment + 1
            End If

            FirstDue = DateAdd(DateInterval.Day, Grace, FirstDue)

            tPCT = 0
            Currrow = 1
            Do While Currrow <= Installment
                rsDst.fields("IDate_" & Currrow) = DateAdd(DateInterval.Year, (Currrow - 1), FirstDue)
                If Currrow < Installment Then
                    PCT = 12 / NumOfMonths * 100
                    rsDst.fields("IPCT_" & Currrow) = PCT
                Else
                    rsDst.fields("IPCT_" & Currrow) = 100 - tPCT
                End If
                Currrow = Currrow + 1
                tPCT = tPCT + PCT
            Loop
        End If

        rsDst.fields("Installment") = Installment
        rsSource.CloseRemoteSet()
        If Not rsDst.Update Then
            StrMsg = db.ErrDesc
            GoTo errmsg
        End If

        Create_Scheme_Payor = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Create_Scheme_Payor = False
    End Function
