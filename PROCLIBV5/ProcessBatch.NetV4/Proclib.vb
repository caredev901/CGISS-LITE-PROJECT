    Public Function SendMessageViaURL(ByVal dbUser As String, ByVal dbPassword As String, ByVal InParam() As Object, ByRef OutParam As Object, ByVal Dataset As DataSet, ByRef ErrMsg As String) As Boolean
        Try
            Dim rsSMSRule As RemoteSet, rsLog As RemoteSet
            Dim SMSRule As String = ""
            Dim GateWayURL As String = ""
            Dim MobileNoQS As String = ""
            Dim MessageQS As String = ""
            Dim WebProxy As String = ""
            Dim CID As String = ""
            Dim CPwd As String = ""

            SMSRule = getInParamValue(InParam, 0)
            rsLog = db.OpenRemoteSet("Select * From HSMS_Log Where 1<>1")
            rsSMSRule = db.OpenRemoteSet("Select * from HSMS_Rule where SMSRule='" & SMSRule & "'", adOpenForwardonly)
            GateWayURL = tostr(rsSMSRule.fields("GatewayURL"))
            CID = tostr(rsSMSRule.fields("CID"))
            CPwd = tostr(rsSMSRule.fields("CPwd"))
            MobileNoQS = tostr(rsSMSRule.fields("MobileNoQS"))
            MessageQS = tostr(rsSMSRule.fields("MessageQS"))
            WebProxy = GetAppSetting("WebProxy")
            For i As Integer = 0 To Dataset.Tables(0).Rows.Count - 1
                Dim TrxID As String = ""
                Dim Status As String = ""
                Dim req As System.Net.WebRequest
                Dim res As System.Net.WebResponse = Nothing
                Dim rd As System.IO.StreamReader = Nothing
                Try
                    Dim urlMessage As String
                    urlMessage = GateWayURL & "&" & MobileNoQS & "=" & tostr(Dataset.Tables(0).Rows(i)("MobileNo")) & "&" & MessageQS & "=" & tostr(Dataset.Tables(0).Rows(i)("Message")) & ""
                    req = System.Net.WebRequest.Create(urlMessage)
                    If WebProxy <> "" Then
                        req.Proxy = New System.Net.WebProxy(WebProxy, True)
                    End If

                    Select Case toval(GetAppSetting("SMSProvider"))
                        Case 1      ' Jatis
                            If CID <> "" Then
                                req.Credentials = New System.Net.NetworkCredential(CID, CPwd)
                            End If
                        Case Else   ' ABDA
                            Dim bytes As Byte() = Encoding.UTF8.GetBytes(String.Format("{0}:{1}", CID, CPwd))
                            req.Headers.Add("Authorization", String.Format("Basic {0}", Convert.ToBase64String(bytes)))
                            req.ContentType = "application/x-www-form-urlencoded"
                    End Select

                    'Get Response
                    res = req.GetResponse()
                    rd = New System.IO.StreamReader(res.GetResponseStream())
                    Dim Result As String = rd.ReadToEnd()

                    Select Case toval(GetAppSetting("SMSProvider"))
                        Case 1 'JATIS
                            Select Case Mid(Result, 8, 1)
                                Case "1" 'Success
                                    Status = "SENT"
                                    TrxID = Left(Result, 50)
                                Case Else
                                    Status = Result
                            End Select
                        Case Else 'ABDA
                            If InStr(Result.ToUpper, "SUCCESS") <> 0 Then
                                Status = "SENT"
                                TrxID = Result
                            Else
                                Status = Result
                            End If
                    End Select

                Catch ex As Exception
                    Status = ex.Message
                Finally
                    If Not IsNothing(res) Then
                        res.Close()
                    End If
                    If Not IsNothing(rd) Then
                        rd.Dispose()
                    End If
                    rsLog.AddNew()
                    rsLog.fields("ID") = db.GetIdentity("HSMS_Log") + 1
                    rsLog.fields("TrDate") = Date.Now
                    rsLog.fields("SMSRule") = SMSRule
                    rsLog.fields("Param1") = tostr(Dataset.Tables(0).Rows(i)("Param1"))
                    rsLog.fields("Param2") = tostr(Dataset.Tables(0).Rows(i)("Param2"))
                    rsLog.fields("Param3") = tostr(Dataset.Tables(0).Rows(i)("Param3"))
                    rsLog.fields("Param4") = tostr(Dataset.Tables(0).Rows(i)("Param4"))
                    rsLog.fields("Param5") = tostr(Dataset.Tables(0).Rows(i)("Param5"))
                    rsLog.fields("TrxID") = TrxID
                    rsLog.fields("Message") = tostr(Dataset.Tables(0).Rows(i)("Message"))
                    rsLog.fields("MobileNo") = tostr(Dataset.Tables(0).Rows(i)("MobileNo"))
                    If Status = "SENT" Then
                        rsLog.fields("Status") = "SENT"
                        rsLog.fields("TrxErrMsg") = ""
                    Else
                        rsLog.fields("Status") = "FAILED"
                        rsLog.fields("TrxErrMsg") = Status
                    End If
                    If Not rsLog.Update Then Throw New Exception("Failed to write sms log " & db.ErrDesc)
                End Try
            Next

            Return True
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        Finally
        End Try
    End Function
    Private Function SetMessage(ByVal Dataset As DataSet, ByVal SMSRULE As String, ByRef ErrMsg As String) As String
        Dim dsRule As DataSet = Nothing
        Dim param(9) As String
        Dim Message As String = ""
        Dim rs As RemoteSet
        Try

            rs = db.OpenRemoteSet("Select * From HSMS_Rule Where SMSRule='" & SMSRULE & "'", adOpenForwardonly)
            dsRule = rs.GetDataSet
            If dsRule.Tables(0).Rows.Count = 0 Then
                Throw New Exception("Cannot find sms rule UPLOAD`")
            End If

            For j As Integer = 0 To Dataset.Tables(0).Rows.Count - 1
                For i As Integer = 1 To 10
                    Try
                        If i = 10 Then
                            If Dataset.Tables(0).Columns(tostr(dsRule.Tables(0).Rows(0)("Param10"))).DataType.Name = "Date" Then
                                If IsDate(Dataset.Tables(0).Rows(j)(tostr(dsRule.Tables(0).Rows(0)("Param10")))) Then
                                    Param(i - 1) = Format(Dataset.Tables(0).Rows(j)(todate(dsRule.Tables(0).Rows(0)("Param10"))), "DD/MM/YY")
                                Else
                                    Param(i - 1) = tostr(Dataset.Tables(0).Rows(j)(tostr(dsRule.Tables(0).Rows(0)("Param10"))))
                                End If
                            Else
                                Param(i - 1) = tostr(Dataset.Tables(0).Rows(j)(tostr(dsRule.Tables(0).Rows(0)("Param10"))))
                            End If
                        Else
                            If Dataset.Tables(0).Columns(tostr(dsRule.Tables(0).Rows(0)("Param0" & i))).DataType.Name = "DateTime" Then
                                If IsDate(Dataset.Tables(0).Rows(j)(tostr(dsRule.Tables(0).Rows(0)("Param0" & i)))) Then
                                    Param(i - 1) = Format(Dataset.Tables(0).Rows(j)(todate(dsRule.Tables(0).Rows(0)("Param0" & i))), "DD/MM/YY")
                                Else
                                    Param(i - 1) = tostr(Dataset.Tables(0).Rows(j)(tostr(dsRule.Tables(0).Rows(0)("Param0" & i))))
                                End If
                            Else
                                Param(i - 1) = tostr(Dataset.Tables(0).Rows(j)(tostr(dsRule.Tables(0).Rows(0)("Param0" & i))))
                            End If
                        End If
                    Catch ex As Exception
                        Param(i - 1) = ""
                    End Try
                Next
                Message = tostr(dsRule.Tables(0).Rows(0)("Message")).Replace("@PARAM01", getInParamValue(param, 0)).Replace("@PARAM02", getInParamValue(param, 1)).Replace("@PARAM03", getInParamValue(param, 2)).Replace("@PARAM04", getInParamValue(param, 3)).Replace("@PARAM05", getInParamValue(param, 4)).Replace("@PARAM06", getInParamValue(param, 5)).Replace("@PARAM07", getInParamValue(param, 6)).Replace("@PARAM08", getInParamValue(param, 7)).Replace("@PARAM09", getInParamValue(param, 8)).Replace("@PARAM10", getInParamValue(param, 9))
                Dataset.Tables(0).Rows(j)("Message") = Message
            Next

            SetMessage = Message
            Return SetMessage
        Catch ex As Exception
            ErrMsg = ex.Message
            Return ""
        End Try
    End Function

    Private Function FacPremium_Constant(ByVal ANO As Long, ByVal FID As String) As Double
        Dim rs As Remoteset
        Dim rsPC As Remoteset
        Dim PctShare As Double
        Dim Gross As Double
        Dim SDate As Date
        Dim EDate As Date
        Dim Premium As Double
        Dim rsR As Remoteset
        Dim rsAcc As Remoteset
        Dim VoyageF As Boolean
        Dim PPeriod As Integer
        Dim Prorata As Integer
        Dim PProrata As Double
        Dim TPremium As Double
        Dim pANO As Long
        Dim CPCT As Double
        Dim CProrata As Double
        Dim NoRefundF As Integer
        Dim pNoRefundF As Boolean
        Dim P_SDate As Date
        Dim P_EDate As Date
        Dim PDate As Date
        Dim PSDate As Date
        Dim PEDate As Date
        Dim Qty As Integer
        Dim AType As String
        Dim EMethod As String
        Dim ExclusiveF As Boolean
        Dim P_STime As String
        Dim P_ETime As String

        rs = db.OpenRemoteSet("Select PANO, CPCT, PDate, SDate, EDate, NoRefundF, AType, EMethod from Acceptance Where ANO=" & ANO)
        pANO = toval(rs.fields("PANO"))
        CPCT = toval(rs.fields("CPCT"))
        PDate = todate(rs.fields("PDate"))
        PSDate = todate(rs.fields("SDate"))
        PEDate = todate(rs.fields("EDate"))
        NoRefundF = toval(rs.fields("NoRefundF"))
        AType = tostr(rs.fields("AType"))
        EMethod = tostr(rs.fields("EMethod"))

        TPremium = 0

        ' Looking for Endorsement
        If pANO <> -1 Then
            If AType <> "A" And EMethod <> "A" Then ' Not for Adjustment and Not Cancel All from Beginning
                If Not (AType = "E" And EMethod = "S") Then ' Not for Restructuring
                    rsAcc = db.OpenRemoteSet("Select NA.ANO as NANO, A.ANO, A.ExclusiveF, A.STime, A.ETime, A.SDate, A.EDate, A.Qty, C.CNO, C.Voyage, C.Prorata, C.PPeriod, I.Share, I.Fee from RArrHeader R, Acceptance A INNER JOIN ACCEPTANCE NA ON (NA.PANO=A.ANO AND NA.AType<>'A'), Cover C Left Join ISource I on (I.CNO=C.CNO) Where A.AType<>'C' and C.CNO=A.CNO and R.ANO=A.ANO and A.ANO<>A.LANO and (A.ANO=" & pANO & " or A.LANO=" & pANO & ")")
                    Do While Not rsAcc.Eof
                        PctShare = IIf(toval(rsAcc.fields("Share")) = 0, 100, toval(rsAcc.fields("Share")))
                        VoyageF = rsAcc.fields("Voyage")
                        PPeriod = rsAcc.fields("PPeriod")
                        Prorata = rsAcc.fields("Prorata")
                        P_SDate = rsAcc.fields("SDate")
                        P_EDate = rsAcc.fields("EDate")
                        Qty = IIf(rsAcc.fields("Qty") = 0, 1, rsAcc.fields("Qty"))
                        ExclusiveF = toval(rsAcc.fields("EXCLUSIVEF"))
                        P_STime = tostr(rsAcc.fields("STime"))
                        P_ETime = tostr(rsAcc.fields("ETime"))


                        rsPC = db.OpenQueryDef("qPCalc_AccAss", adOpenForwardonly, rsAcc.fields("ANO"))
                        Do While Not rsPC.Eof
                            Gross = toval(rsPC.fields("Gross")) * toval(rsPC.fields("Rate"))
                            SDate = todate(rsPC.fields("SDate"))
                            EDate = todate(rsPC.fields("EDate"))
                            PProrata = toval(rsPC.fields("PProrata"))

                            CProrata = CPCT / 100
                            If VoyageF And CProrata = 0 Then
                                CProrata = 1
                            End If

                            ' Facultative Out
                            Dim FacProrata As Double
                            Dim fsDate As Date
                            Dim feDate As Date
                            Dim NetRateF As Boolean
                            Dim CPRefund As Double

                            rsR = db.OpenQueryDef("QFacOutDet", adOpenForwardonly, rsAcc.fields("ANO"), rsPC.fields("Code"))
                            Do While Not rsR.Eof
                                If AType = "C" And EMethod <> "A" Then
                                    CPRefund = toval(rsR.fields("CPRefund"))
                                Else
                                    CPRefund = 0
                                End If
                                If CPRefund = 0 Then CPRefund = 100
                                If rsR.fields("FID") = FID And (UCase(tostr(rsR.fields("Status"))) = "R" Or UCase(tostr(rsR.fields("Status"))) = "A") Then
                                    If toval(rsR.fields("NetRate")) = 0 Then
                                        Premium = PctShare / 100 * (Gross / PProrata) * Qty
                                        If toval(rsR.fields("OnGrossAfterCommF")) Then
                                            Premium = Premium * (100 - Get_Premium_Facultative_Commission(rsAcc.fields("ANO"), rsPC.fields("Code"), 0, False)) / 100
                                        End If
                                        NetRateF = False
                                    Else
                                        rs = db.OpenQueryDef("Facultative_Premium", adOpenForwardonly, rsAcc.fields("ANO"), rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, rsR.fields("FID"), rsPC.fields("AdjustableF"))
                                        Premium = PctShare / 100 * toval(rs.fields("Premium")) * Qty
                                        NetRateF = True
                                    End If
                                    ' Check for First Loss
                                    If rsR.fields("FLPct") = 0 And rsR.fields("Unit") <> "F" Then
                                        Premium = Premium * toval(rsR.fields("Share")) / 100 * toval(rsR.fields("RShare")) / 100
                                    End If

                                    If DateDiff(DateInterval.Day, SDate, rsR.fields("SDate")) >= 0 Then
                                        fsDate = rsR.fields("SDate")
                                    Else
                                        fsDate = SDate
                                    End If

                                    If DateDiff(DateInterval.Day, rsR.fields("EDate"), EDate) >= 0 Then
                                        feDate = rsR.fields("EDate")
                                    Else
                                        feDate = EDate
                                    End If

                                    ' FEDate + 1
                                    feDate = IIf(Not ExclusiveF AndAlso P_STime < P_ETime AndAlso feDate = rsR.fields("EDate"), DateAdd(DateInterval.Day, 1, feDate), feDate)
                                    EDate = IIf(Not ExclusiveF AndAlso P_STime < P_ETime AndAlso EDate = P_EDate, DateAdd(DateInterval.Day, 1, EDate), EDate)

                                    If DateDiff(DateInterval.Day, fsDate, feDate) > 0 Then   ' In Period Cover
                                        If VoyageF Then
                                            FacProrata = PProrata
                                        ElseIf rsR.fields("PCalc") = "F" And Not NetRateF Then
                                            FacProrata = PProrata
                                        ElseIf rsR.fields("PCalc") = "P" And rsR.fields("CPCT") <> 0 Then
                                            FacProrata = rsR.fields("CPCT") / 100
                                        Else
                                            If DateDiff(DateInterval.Month, SDate, EDate) <> 0 Then
                                                If rsR.fields("PCalc") = "F" Then
                                                    FacProrata = DateDiff(DateInterval.Month, fsDate, feDate) / 12
                                                Else

                                                    If Not NetRateF Then
                                                        If rsR.fields("PCalc") = "P" Then
                                                            If Day(fsDate) = Day(feDate) And Day(SDate) = Day(EDate) And PPeriod <> 1 Then
                                                                FacProrata = DateDiff(DateInterval.Month, fsDate, feDate) / 12
                                                            Else
                                                                FacProrata = DateDiff(DateInterval.Day, fsDate, feDate) / Prorata
                                                            End If
                                                        Else
                                                            If Day(fsDate) = Day(feDate) And Day(SDate) = Day(EDate) And PPeriod <> 1 Then
                                                                FacProrata = DateDiff(DateInterval.Month, fsDate, feDate) / DateDiff(DateInterval.Month, SDate, EDate)
                                                            Else
                                                                FacProrata = DateDiff(DateInterval.Day, fsDate, feDate) / DateDiff(DateInterval.Day, SDate, EDate)
                                                            End If
                                                        End If
                                                    Else
                                                        If Day(fsDate) = Day(feDate) And Day(SDate) = Day(EDate) And PPeriod <> 1 Then
                                                            FacProrata = DateDiff(DateInterval.Month, fsDate, feDate) / 12
                                                        Else
                                                            FacProrata = DateDiff(DateInterval.Day, fsDate, feDate) / Prorata
                                                        End If
                                                    End If
                                                End If
                                            Else
                                                If rsR.fields("PCalc") = "P" Then
                                                    FacProrata = DateDiff(DateInterval.Day, fsDate, feDate) / Prorata
                                                Else
                                                    FacProrata = PProrata
                                                End If
                                            End If
                                        End If

                                        rs = db.OpenRemoteSet("Select NoRefundF from RCover Where ANO=" & rsAcc.fields("NANO") & " and Code='" & rsPC.fields("Code") & "' and ((SDate='" & Format(PSDate, "MM/DD/YYYY") & "' and EDate='" & Format(PEDate, "MM/DD/YYYY") & "' and '" & Format(SDate, "MM/DD/YYYY") & "'='" & Format(P_SDate, "MM/DD/YYYY") & "' and '" & Format(EDate, "MM/DD/YYYY") & "'='" & Format(P_EDate, "MM/DD/YYYY") & "') or (SDate='" & Format(SDate, "MM/DD/YYYY") & "'))")
                                        pNoRefundF = toval(rs.fields("NoRefundF"))
                                        If Not pNoRefundF Then
                                            rs = db.OpenRemoteSet("Select NoRefundF from RArrDet Where ANO=" & rsAcc.fields("NANO") & " and FID='" & FID & "'")
                                            pNoRefundF = toval(rs.fields("NoRefundF"))
                                        End If

                                        If DateDiff(DateInterval.Day, PDate, fsDate) > 0 And DateDiff(DateInterval.Day, PDate, P_SDate) <= 0 And DateDiff(DateInterval.Day, PDate, P_EDate) >= 0 Then
                                            CProrata = 1
                                        ElseIf DateDiff(DateInterval.Day, feDate, PDate) >= 0 And DateDiff(DateInterval.Day, PDate, P_SDate) <= 0 And DateDiff(DateInterval.Day, PDate, P_EDate) >= 0 Then
                                            CProrata = 0
                                        Else
                                            If CProrata = 0 Then
                                                If PSDate <> PDate Or NoRefundF = 6 Then
                                                    If Day(PDate) = Day(feDate) And Day(fsDate) = Day(feDate) And PPeriod <> 1 And DateDiff(DateInterval.Month, fsDate, feDate) <> 0 Then
                                                        CProrata = DateDiff(DateInterval.Month, PDate, feDate) / DateDiff(DateInterval.Month, fsDate, feDate)
                                                    Else
                                                        CProrata = DateDiff(DateInterval.Day, PDate, feDate) / DateDiff(DateInterval.Day, fsDate, feDate)
                                                    End If
                                                Else
                                                    ' Endorsement Period
                                                    CProrata = 1
                                                End If
                                            End If
                                            If NoRefundF = 1 Then CProrata = 0
                                        End If
                                        If NoRefundF = 2 Then CProrata = 0
                                        If pNoRefundF Then CProrata = 0
                                    Else
                                        FacProrata = 0
                                    End If

                                    If rsR.fields("Prorata") <> 0 Then
                                        Premium = Premium * FacProrata * rsR.fields("Prorata")
                                    Else
                                        Premium = Premium * FacProrata
                                    End If

                                    TPremium = TPremium + Premium * CProrata * CPRefund / 100
                                End If

                                rsR.MoveNext()
                            Loop

                            rsPC.MoveNext()
                        Loop
                        rsAcc.MoveNext()
                    Loop
                End If
            Else
                rs = db.OpenRemoteSet("Select sum(P1.Premium*P2.Rate) as Premium from Facultative_Premium_Calculation_Constant_Adjustment(" & ANO & ",'" & FID & "') P1, PCalc P2 Where P2.ANO=P1.ANO and P2.Currency=P2.Currency")
                TPremium = toval(rs.fields("Premium"))
            End If
        End If
        FacPremium_Constant = TPremium
    End Function

    Private Function FacPremium_Factor(ByVal ANO As Long, ByVal FID As String) As Double
        Dim rs As Remoteset
        Dim rsPC As Remoteset
        Dim PctShare As Double
        Dim Gross As Double
        Dim SDate As Date
        Dim EDate As Date
        Dim Premium As Double
        Dim rsR As Remoteset
        Dim rsAcc As Remoteset
        Dim VoyageF As Boolean
        Dim PPeriod As Integer
        Dim Prorata As Integer
        Dim PProrata As Double
        Dim BProrata As Double
        Dim TPremium As Double
        Dim Qty As Integer
        Dim PDate As Date
        Dim NoRefundF As Integer
        Dim pNoRefundF As Boolean
        Dim CPCT As Double
        Dim SANO As Long
        Dim ExclusiveF As Boolean
        Dim PEDate As Date
        Dim P_STime As String
        Dim P_ETime As String

        TPremium = 0
        rsAcc = db.OpenRemoteSet("Select A.ANO, A.ExclusiveF, A.STime, A.ETime, A.EDate, A.CPCT, A.NoRefundF, A.PDate, A.AType, A.SDate, A.EDate, A.Qty, C.CNO, C.Voyage, C.Prorata, C.PPeriod, I.Share, I.Fee from RArrHeader R, Acceptance A, Cover C Left Join ISource I on (I.CNO=C.CNO) Where A.AType<>'C' and C.CNO=A.CNO and R.ANO=A.ANO and A.ANO<>A.LANO and (A.ANO=" & ANO & " or A.LANO=" & ANO & ")")
        Do While Not rsAcc.Eof
            PctShare = IIf(toval(rsAcc.fields("Share")) = 0, 100, toval(rsAcc.fields("Share")))
            VoyageF = rsAcc.fields("Voyage")
            Prorata = rsAcc.fields("Prorata")
            PPeriod = rsAcc.fields("PPeriod")
            ANO = rsAcc.fields("ANO")
            PDate = rsAcc.fields("PDate")
            NoRefundF = rsAcc.fields("NoRefundF")
            Qty = IIf(rsAcc.fields("Qty") = 0, 1, rsAcc.fields("Qty"))
            CPCT = rsAcc.fields("CPCT")
            PEDate = rsAcc.fields("EDate")
            ExclusiveF = toval(rsAcc.fields("EXCLUSIVEF"))
            P_STime = tostr(rsAcc.fields("STime"))
            P_ETime = tostr(rsAcc.fields("ETime"))

            rsPC = db.OpenQueryDef("qPCalc_AccAss", adOpenForwardonly, ANO)
            Do While Not rsPC.Eof
                Gross = toval(rsPC.fields("Gross")) * toval(rsPC.fields("Rate"))
                SDate = todate(rsPC.fields("SDate"))
                EDate = todate(rsPC.fields("EDate"))
                PProrata = toval(rsPC.fields("PProrata"))
                SANO = toval(rsPC.fields("SANO"))
                pNoRefundF = toval(rsPC.fields("NoRefundF"))

                ' Facultative Out
                Dim FacProrata As Double
                Dim fsDate As Date
                Dim feDate As Date
                Dim NetRateF As Boolean

                rsR = db.OpenQueryDef("QFacOutDet", adOpenForwardonly, SANO, rsPC.fields("Code"))
                Do While Not rsR.Eof
                    If rsR.fields("FID") = FID Then
                        If Not pNoRefundF Then pNoRefundF = rsR.fields("NoRefundF")
                        If toval(rsR.fields("NetRate")) = 0 Then
                            Premium = PctShare / 100 * (Gross / PProrata) * Qty
                            If toval(rsR.fields("OnGrossAfterCommF")) Then
                                Premium = Premium * (100 - Get_Premium_Facultative_Commission(SANO, rsPC.fields("Code"), 0, False)) / 100
                            End If
                            NetRateF = False
                        Else
                            rs = db.OpenQueryDef("Facultative_Premium", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, rsR.fields("FID"), rsPC.fields("AdjustableF"))
                            Premium = PctShare / 100 * toval(rs.fields("Premium")) * Qty
                            NetRateF = True
                        End If
                        ' Check for First Loss
                        If rsR.fields("FLPct") = 0 And rsR.fields("Unit") <> "F" Then
                            Premium = Premium * toval(rsR.fields("Share")) / 100 * toval(rsR.fields("RShare")) / 100
                        End If

                        If DateDiff(DateInterval.Day, SDate, rsR.fields("SDate")) >= 0 Then
                            fsDate = rsR.fields("SDate")
                        Else
                            fsDate = SDate
                        End If

                        If DateDiff(DateInterval.Day, rsR.fields("EDate"), EDate) >= 0 Then
                            feDate = rsR.fields("EDate")
                        Else
                            feDate = EDate
                        End If

                        ' FEDate + 1
                        feDate = IIf(Not ExclusiveF AndAlso P_STime < P_ETime AndAlso feDate = rsR.fields("EDate"), DateAdd(DateInterval.Day, 1, feDate), feDate)
                        EDate = IIf(Not ExclusiveF AndAlso P_STime < P_ETime AndAlso EDate = PEDate, DateAdd(DateInterval.Day, 1, EDate), EDate)

                        If DateDiff(DateInterval.Day, fsDate, feDate) > 0 Then   ' In Period Cover
                            If VoyageF Then
                                FacProrata = PProrata
                            ElseIf rsR.fields("PCalc") = "F" And Not NetRateF Then
                                FacProrata = PProrata
                            ElseIf rsR.fields("PCalc") = "P" And rsR.fields("CPCT") <> 0 Then
                                FacProrata = rsR.fields("CPCT") / 100
                            Else
                                If DateDiff(DateInterval.Month, SDate, EDate) <> 0 Then
                                    If rsR.fields("PCalc") = "F" Then
                                        FacProrata = DateDiff(DateInterval.Month, fsDate, feDate) / 12
                                    Else
                                        If Not NetRateF Then
                                            If rsR.fields("PCalc") = "P" Then
                                                If Day(fsDate) = Day(feDate) And Day(SDate) = Day(EDate) And PPeriod <> 1 Then
                                                    FacProrata = DateDiff(DateInterval.Month, fsDate, feDate) / 12
                                                Else
                                                    FacProrata = DateDiff(DateInterval.Day, fsDate, feDate) / Prorata
                                                End If
                                            Else
                                                If Day(fsDate) = Day(feDate) And Day(SDate) = Day(EDate) And PPeriod <> 1 Then
                                                    FacProrata = DateDiff(DateInterval.Month, fsDate, feDate) / DateDiff(DateInterval.Month, SDate, EDate)
                                                Else
                                                    FacProrata = DateDiff(DateInterval.Day, fsDate, feDate) / DateDiff(DateInterval.Day, SDate, EDate)
                                                End If
                                            End If
                                        Else
                                            If Day(fsDate) = Day(feDate) And Day(SDate) = Day(EDate) And PPeriod <> 1 Then
                                                FacProrata = DateDiff(DateInterval.Month, fsDate, feDate) / 12
                                            Else
                                                FacProrata = DateDiff(DateInterval.Day, fsDate, feDate) / Prorata
                                            End If
                                        End If
                                    End If
                                Else
                                    If rsR.fields("PCalc") = "P" Then
                                        FacProrata = DateDiff(DateInterval.Day, fsDate, feDate) / Prorata
                                    Else
                                        FacProrata = PProrata
                                    End If
                                End If
                            End If
                        Else
                            FacProrata = 0
                        End If

                        If rsR.fields("AType") <> "N" Then
                            ' Make Balance Prorata
                            BProrata = CPCT / 100
                            If VoyageF And BProrata = 0 Then
                                BProrata = 1
                            End If
                            If DateDiff(DateInterval.Day, PDate, fsDate) > 0 Then
                                BProrata = 1
                            ElseIf DateDiff(DateInterval.Day, feDate, PDate) >= 0 Then
                                BProrata = 0
                            Else
                                If BProrata = 0 Then
                                    If Day(PDate) = Day(feDate) And Day(fsDate) = Day(feDate) And PPeriod <> 1 And DateDiff(DateInterval.Month, fsDate, feDate) <> 0 Then
                                        BProrata = DateDiff(DateInterval.Month, PDate, feDate) / DateDiff(DateInterval.Month, fsDate, feDate)
                                    Else
                                        BProrata = DateDiff(DateInterval.Day, PDate, feDate) / DateDiff(DateInterval.Day, fsDate, feDate)
                                    End If
                                End If
                                If NoRefundF = 1 Then BProrata = 0
                            End If
                            If NoRefundF = 2 Then BProrata = 0
                            If pNoRefundF Then BProrata = 0
                        Else
                            BProrata = 1
                        End If

                        TPremium = TPremium + Premium * FacProrata * BProrata
                    End If
                    rsR.MoveNext()
                Loop

                rsPC.MoveNext()
            Loop
            rsAcc.MoveNext()
        Loop
        FacPremium_Factor = TPremium
    End Function
    Private Function Get_Premium_Commission(ByVal ANO As Long, ByVal Code As String, ByVal PeriodYear As Integer, ByVal MinimumPremiumF As Boolean) As Double
