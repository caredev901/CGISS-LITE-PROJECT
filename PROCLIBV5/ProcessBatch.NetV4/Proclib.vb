                    Dim DAnnualTreatyF As Boolean = AnnualTreatyF
                    Dim DNoRiskAccumulationF As Boolean = NoRiskAccumulationF

                    If tostr(GetFieldValue(FBuffer(GetFieldIndex("AnnualTreatyF", FIndex)))) <> "" Then
                        AnnualTreatyF = toval(GetFieldValue(FBuffer(GetFieldIndex("AnnualTreatyF", FIndex))))
                    End If

                    If tostr(GetFieldValue(FBuffer(GetFieldIndex("NoRiskAccumulationF", FIndex)))) <> "" Then
                        NoRiskAccumulationF = toval(GetFieldValue(FBuffer(GetFieldIndex("NoRiskAccumulationF", FIndex))))
                    End If

                    Dim RDate As Date
                    Dim NRDate As Date
                    Dim ChangeOnRDateF As Boolean = False
                    Dim ChangeOnNRDateF As Boolean = False
                    RDate = rs.fields("RDate")
                    NRDate = rs.fields("NRDate")

                    If (tostr(GetFieldValue(FBuffer(GetFieldIndex("RDate", FIndex)))) <> "" AndAlso IsDate(GetFieldValue(FBuffer(GetFieldIndex("RDate", FIndex)))) AndAlso RDate <> todate(GetFieldValue(FBuffer(GetFieldIndex("RDate", FIndex))))) Then
                        RDate = todate(GetFieldValue(FBuffer(GetFieldIndex("RDate", FIndex))))
                        ChangeOnRDateF = True
                    End If
                    If (tostr(GetFieldValue(FBuffer(GetFieldIndex("NRDate", FIndex)))) <> "" AndAlso IsDate(GetFieldValue(FBuffer(GetFieldIndex("NRDate", FIndex)))) AndAlso NRDate <> todate(GetFieldValue(FBuffer(GetFieldIndex("NRDate", FIndex))))) Then
                        NRDate = todate(GetFieldValue(FBuffer(GetFieldIndex("NRDate", FIndex))))
                        ChangeOnNRDateF = True
                    End If

                    If AnnualTreatyF Then
                        If (OpenFlag And Not PolicyTreatyF) OrElse (SType = "S") Then
                            ' Check for Leap Year
                            If Month(DateSerial(Year(PDate), Month(SDate), Day(SDate))) <> Month(SDate) Then
                                RDate = DateAdd(DateInterval.Day, -1, DateSerial(Year(PDate), Month(SDate), Day(SDate)))
                            Else
                                RDate = DateSerial(Year(PDate), Month(SDate), Day(SDate))
                            End If
                            If DateDiff(DateInterval.Day, PDate, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)
                            If DateDiff(DateInterval.Day, PDate, RDate) < 0 Then RDate = DateAdd(DateInterval.Month, 12, RDate)
                            If DateDiff(DateInterval.Day, PDate, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)

                            If DateDiff(DateInterval.Day, SDate, RDate) < 0 Then RDate = SDate
                            NRDate = DateAdd(DateInterval.Month, 12, RDate)
                            If DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                        Else
                            ' Check for Leap Year
                            If Month(DateSerial(Year(PDate), Month(M_SDate), Day(M_SDate))) <> Month(M_SDate) Then
                                RDate = DateAdd(DateInterval.Day, -1, DateSerial(Year(PDate), Month(M_SDate), Day(M_SDate)))
                            Else
                                RDate = DateSerial(Year(PDate), Month(M_SDate), Day(M_SDate))
                            End If
                            If DateDiff(DateInterval.Day, PDate, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)
                            If DateDiff(DateInterval.Day, PDate, RDate) < 0 Then RDate = DateAdd(DateInterval.Month, 12, RDate)
                            If DateDiff(DateInterval.Day, PDate, RDate) > 0 Then RDate = DateAdd(DateInterval.Month, -12, RDate)

                            If DateDiff(DateInterval.Day, M_SDate, RDate) < 0 Then RDate = M_SDate
                            NRDate = DateAdd(DateInterval.Month, 12, RDate)
                            If DateDiff(DateInterval.Day, M_EDate, NRDate) > 0 Then NRDate = M_EDate
                        End If
                    Else
                        If DAnnualTreatyF <> AnnualTreatyF OrElse toval(rs.fields("PolicyTreatyF")) <> PolicyTreatyF OrElse ChangeOnRDateF OrElse ChangeOnNRDateF Then
                            If (OpenFlag And Not PolicyTreatyF) OrElse (SType = "S") Then
                                If AType = "N" OrElse DateDiff(DateInterval.Day, SDate, RDate) = 0 OrElse DateDiff(DateInterval.Day, SDate, RDate) < 0 Then RDate = SDate
                                If DateDiff(DateInterval.Day, EDate, RDate) > 0 Then RDate = EDate

                                If DateDiff(DateInterval.Day, SDate, NRDate) < 0 Then NRDate = SDate
                                If DateDiff(DateInterval.Day, EDate, NRDate) = 0 OrElse DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                                If DateDiff(DateInterval.Day, RDate, NRDate) <= 0 Then
                                    RDate = SDate
                                    NRDate = EDate
                                End If
                            Else
                                If AType = "N" OrElse DateDiff(DateInterval.Day, M_SDate, RDate) = 0 OrElse DateDiff(DateInterval.Day, M_SDate, RDate) < 0 Then RDate = M_SDate
                                If DateDiff(DateInterval.Day, M_EDate, RDate) > 0 Then RDate = M_EDate

                                If DateDiff(DateInterval.Day, SDate, NRDate) < 0 Then NRDate = SDate
                                If DateDiff(DateInterval.Day, EDate, NRDate) = 0 OrElse DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                                If DateDiff(DateInterval.Day, RDate, NRDate) <= 0 Then
                                    RDate = SDate
                                    NRDate = EDate
                                End If
                            End If
                        End If
                    End If


                    rs.fields("RDate") = RDate
                    rs.fields("NRDate") = NRDate
                    rs.fields("PolicyTreatyF") = PolicyTreatyF

                    ' Compulsory BPPDAN
                    RID = GetFieldValue(FBuffer(GetFieldIndex("CID", FIndex)))
                    Share = GetFieldValue(FBuffer(GetFieldIndex("CShare", FIndex)))

                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID from Reinsurance Where RType='C' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            Throw New Exception(StrMsg)
                        End If

                        rs.fields("CID") = RID
                        rs.fields("CSHARE") = Share
                        rs.fields("CAMOUNT") = rs.fields("TAmount") * Share / 100
                    End If

                    ' MAIPARK
                    RID = GetFieldValue(FBuffer(GetFieldIndex("XPID", FIndex)))
                    Share = GetFieldValue(FBuffer(GetFieldIndex("XPShare", FIndex)))

                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID from Reinsurance Where RType='XP' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            Throw New Exception(StrMsg)
                        End If

                        rs.fields("XPID") = RID
                        rs.fields("XPShare") = Share
                        rs.fields("XPAmount") = rs.fields("TAmount") * Share / 100
                    End If

                    ' Decree
                    RID = GetFieldValue(FBuffer(GetFieldIndex("DID", FIndex)))
                    Share = GetFieldValue(FBuffer(GetFieldIndex("DShare", FIndex)))

                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID from Reinsurance Where RType='D' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            Throw New Exception(StrMsg)
                        End If

                        rs.fields("DID") = RID
                        rs.fields("DShare") = Share
                        rs.fields("DAmount") = rs.fields("TAmount") * Share / 100
                    End If

                    ' Quota Share
                    RID = GetFieldValue(FBuffer(GetFieldIndex("QID", FIndex)))
                    Share = GetFieldValue(FBuffer(GetFieldIndex("QShare", FIndex)))
                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID, Share from Reinsurance Where RType='Q' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            Throw New Exception(StrMsg)
                        End If

                        If rsTemp.fields("Share") = 0 Then
                            QAmount = rs.fields("TAmount") * Share / 100
                        Else
                            QAmount = rs.fields("TAmount") * Share / 100 * rsTemp.fields("Share") / 100
                        End If

                        rs.fields("QID") = RID
                        rs.fields("QSRet") = 100 - rsTemp.fields("Share")
                        rs.fields("QSRamount") = rs.fields("QSRet") / (100 - rs.fields("QSRet")) * QAmount
                        rs.fields("QShare") = Share * rsTemp.fields("Share") / 100
                        rs.fields("QAmount") = QAmount

                        If rsTemp.fields("Share") = 0 Then
                            rs.fields("QSRamount") = QAmount
                            rs.fields("QAmount") = 0
                        End If
                    End If

                    ' Surplus
                    For i = 1 To 3
                        RID = GetFieldValue(FBuffer(GetFieldIndex("SP" & i & "ID", FIndex)))
                        Share = GetFieldValue(FBuffer(GetFieldIndex("SP" & i & "Share", FIndex)))

                        If RID <> "" Then
                            rsTemp = db.OpenRemoteSet("Select RID from Reinsurance Where RType='S" & i & "' and RID='" & RID & "'")
                            If rsTemp.Eof Then
                                StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                                Throw New Exception(StrMsg)
                            End If

                            rs.fields("SP" & i & "ID") = RID
                            rs.fields("SP" & i & "Share") = Share
                            rs.fields("SP" & i & "Amount") = rs.fields("TAmount") * Share / 100
                        End If
                    Next

                    ' Auto Facultative
                    RID = GetFieldValue(FBuffer(GetFieldIndex("AFID", FIndex)))
                    Share = toval(GetFieldValue(FBuffer(GetFieldIndex("AFShare", FIndex))))
                    If RID <> "" Then
                        rsTemp = db.OpenRemoteSet("Select RID, Share from Reinsurance Where RType='A' and RID='" & RID & "'")
                        If rsTemp.Eof Then
                            StrMsg = "Reinsurance Treaty (" & RID & ") not Found !"
                            Throw New Exception(StrMsg)
                        End If

                        If rsTemp.fields("Share") = 0 Then
                            AAmount = rs.fields("TAmount") * Share / 100
                        Else
                            AAmount = rs.fields("TAmount") * Share / 100 * rsTemp.fields("Share") / 100
                        End If

                        rs.fields("AID") = RID
                        rs.fields("AFRet") = 100 - rsTemp.fields("Share")
                        rs.fields("AFRamount") = rs.fields("AFRet") / (100 - rs.fields("AFRet")) * AAmount
                        rs.fields("AShare") = Share * rsTemp.fields("Share") / 100
                        rs.fields("AAmount") = AAmount

                        If rsTemp.fields("Share") = 0 Then
                            rs.fields("AFRamount") = AAmount
                            rs.fields("AAmount") = 0
                        End If
                    End If

                    rs.fields("ShortFall") = toval(GetFieldValue(FBuffer(GetFieldIndex("ShortFall", FIndex))))
                    rs.fields("SAmount") = rs.fields("TAmount") * rs.fields("ShortFall") / 100
                    rs.fields("RAmount") = rs.fields("TAmount") - (rs.fields("MAMOUNT") + rs.fields("CAMOUNT") + rs.fields("XPAMOUNT") + rs.fields("DAMOUNT") + rs.fields("QAMOUNT") + rs.fields("QSRAmount") + rs.fields("SP1AMOUNT") + rs.fields("SP2AMOUNT") + rs.fields("SP3AMOUNT") + rs.fields("AAmount") + rs.fields("AFRAmount") + rs.fields("FAMOUNT") + rs.fields("SAMOUNT"))
                    rs.fields("Retention") = (rs.fields("RAmount") / rs.fields("TAmount")) * 100

                    If Not rs.Update Then
                        StrMsg = "Update Risk Arrangement Failed !" & db.ErrDesc & vbCrLf
                        Throw New Exception(StrMsg)
                    End If


                    If DAnnualTreatyF <> AnnualTreatyF OrElse DNoRiskAccumulationF <> NoRiskAccumulationF Then
                        If Not db.Execute("Update Acceptance Set AnnualTreatyF=" & IIf(AnnualTreatyF, 1, 0) & ", NoRiskAccumulationF=" & IIf(NoRiskAccumulationF, 1, 0) & " Where ANO=" & ANO) Then
                            StrMsg = "Update Policy Data Failed !" & db.ErrDesc & vbCrLf
                            Throw New Exception(StrMsg)
                        End If
                    End If

                    If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "Reinsurance_Cession", ANO) Then
                        StrMsg = "Process Reinsurance Cession Failed !" & Me.ErrDesc & vbCrLf
                        Throw New Exception(StrMsg)
                    End If

                End If

            End If

            If ImmediateInforceF Then
                If (SType = "S") Or (SType = "O") Or (SType = "M" And MasterF = False) Then
                    If QuotationF Then
                        Dim tParam(3) As Object
                        tParam(0) = CNO
                        tParam(1) = Today.Date
                        tParam(2) = 0
                        tParam(3) = ""

                        db.Var_db_user = AUserID
                        If PreConfirmConditionsOK(IIf(SType = "M" And Not MasterF, LANO, ANO), StrMsg) Then

                            ' Release Quotation First
                            rs = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
                            If Not (rs.fields("CStatus") = "R") Then
                                StrMsg = "Quotation Data Already Released !"
                                Throw New Exception(StrMsg)
                            End If
                            rs.Edit()
                            rs.fields("CStatus") = "P"
                            rs.fields("PUserID") = db_user
                            rs.fields("PUSerDate") = Today.Date
                            rs.fields("PUserTime") = Time()
                            rs.fields("Validation") = 0
                            If Not rs.Update Then Throw New Exception(db.ErrDesc)


                        Else
                            StrMsg = "Process Confirm Quotation Failed !" & vbCrLf & StrMsg & vbCrLf
                            Throw New Exception(StrMsg)
                        End If
                        db.Var_db_user = db_user
                    Else
                        Dim ADate As Date
                        If BackDatedF Then
                            If IsDate(BackDatedDate) Then
                                ADate = BackDatedDate
                            Else
                                rs = db.OpenRemoteSet("Select BackDatedDate from Branch Where Branch='" & Branch & "'")
                                ADate = todate(rs.fields("BackDatedDate"))
                            End If
                        Else
                            If IsDate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                                ADate = todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex))))
                            Else
                                ADate = Today.Date
                            End If

                            Dim EndDate As Date
                            Dim LockedDate As Date
                            EndDate = GetEndDate(Branch)
                            LockedDate = GetLockedDate(Branch)
                            If DateDiff(DateInterval.Day, EndDate, ADate) <= 0 Then
                                ADate = DateAdd(DateInterval.Day, 1, EndDate)
                            End If
                            If DateDiff(DateInterval.Day, LockedDate, ADate) <= 0 Then
                                ADate = DateAdd(DateInterval.Day, 1, LockedDate)
                            End If
                        End If



                        db.Var_db_user = AUserID
                        db.Var_db_User_Type = IIf(db.GetPrivileges("ALLOWALLPRIVILEGESINFORCE"), "SUPERVISOR", db_user_type)



                        If MasterF Or SType = "M" Then
                            If MasterF Then
                                If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCEMASTER", ANO, AUserID, BackDatedF, ADate, Voucher) Then
                                    StrMsg = "Process Inforce Failed !" & Me.ErrDesc & vbCrLf
                                    Throw New Exception(StrMsg)
                                End If
                            Else
                                If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCEMASTER", LANO, AUserID, BackDatedF, ADate, Voucher) Then
                                    StrMsg = "Process Inforce Failed !" & Me.ErrDesc & vbCrLf
                                    Throw New Exception(StrMsg)
                                End If
                            End If
                        Else
                            If Not Me.Direct_Call_Process_Execute("Process.NetV3.PROCLIB", "INFORCE", ANO, AUserID, BackDatedF, ADate, Voucher) Then
                                StrMsg = "Process Inforce Failed !" & Me.ErrDesc & vbCrLf
                                Throw New Exception(StrMsg)
                            End If
                        End If

                        db.Var_db_user = db_user
                        db.Var_db_User_Type = db_user_type


                    End If
                End If
            ElseIf Not QuotationF And (InforceF Or InforceBulkF) Then
                If (SType = "S") Or (MasterF = False) Or (MasterF = True And SType = "O") Then
                    rs = db.OpenRemoteSet("Select RegNo, CertificateNo, BatchNo from acceptance where ANO = " & ANO)
                    RegNo = rs.fields("RegNo")
                    CertificateNo = rs.fields("CertificateNo")
                    BatchNo = rs.fields("BatchNo")

                    If InforceBulkF Then
                        rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='" & CertificateNo & "'")
                        If rs.Eof Then
                            rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='' and BatchNo='" & BatchNo & "'")
                        End If
                        CertificateNo = ""
                    Else
                        If SType = "M" Then
                            rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo=''")
                        Else
                            rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='" & CertificateNo & "'")
                        End If
                    End If

                    If rs.Eof Then
                        rs.AddNew()
                    Else
                        rs.Edit()
                    End If

                    rs.fields("RegNo") = RegNo
                    rs.fields("CertificateNo") = CertificateNo
                    rs.fields("BatchNo") = BatchNo
                    rs.fields("Status") = "R"
                    rs.fields("Last_Opr") = AUserID
                    rs.fields("Last_Update") = Today.Date
                    If IsDate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                        rs.fields("ADate") = todate(GetFieldValue(FBuffer(GetFieldIndex("ADate", FIndex))))
                    End If

                    If Not rs.Update Then
                        StrMsg = "Insert Auto Inforce Bucket Failed !" & db.ErrDesc & vbCrLf
                        Throw New Exception(StrMsg)
                    End If
                End If
            End If



            rs.CloseRemoteSet()
            Upload_UP = True

        Catch ex As Exception
            StrMsg = ex.Message
            Upload_UP = False
        End Try
    End Function
    Private Function Check_FacultativeRate_GreaterThan_GrossRate(ByVal ANO As Long, ByVal NetRate As Double, ByVal Unit As String, ByVal Share As Double) As Boolean
        Dim rs As RemoteSet
        Dim Rate As Double
        Dim FacRate As Double

        Check_FacultativeRate_GreaterThan_GrossRate = False
        If NetRate <> 0 Then
            rs = db.OpenRemoteSet("Select Gross, TSI from fn_Icalc(" & ANO & ")")
            If Not rs.Eof Then
                Rate = toval(rs.fields("Gross")) / toval(rs.fields("TSI")) * 100
                Select Case Unit.ToUpper
                    Case "", "C"
                        FacRate = NetRate
                    Case "M"
                        FacRate = NetRate / 10
                    Case "F"
                        FacRate = NetRate / (toval(rs.fields("TSI")) * Share / 100) * 100
                End Select
                If Rate < FacRate Then
                    Check_FacultativeRate_GreaterThan_GrossRate = True
                End If
            End If
        End If
    End Function
    Private Function DelRCover(ByVal ANO As Long, ByVal MAINCOVERAGE As String) As Boolean

        Dim Code As String
        Dim rs As RemoteSet

        'risk code
        rs = db.OpenQueryDef("QRATECODE", adOpenKeyset, ANO, MAINCOVERAGE, 1)
        If Not rs.Eof Then
            Code = tostr(rs.fields("CODE"))
        Else
            Code = MAINCOVERAGE
        End If
        If Not Delete_Records("Delete from RCover Where ANO=" & ANO & " and Code='" & Code & "'") Then GoTo errmsg

        If Not db.Execute("Delete A from RateTabCla R, AccCla A Where A.OrderNo=R.OrderNo and A.ANO=" & ANO & " and R.Code='" & Code & "'") Then Throw New Exception(db.ErrDesc)
        If Not db.Execute("Delete A from RateTabCon R, AccCon A Where A.OrderNo=R.OrderNo and A.ANO=" & ANO & " and R.Code='" & Code & "'") Then Throw New Exception(db.ErrDesc)
        If Not db.Execute("Delete A from RateTabEx R, AccEx A Where A.OrderNo=R.OrderNo and A.ANO=" & ANO & " and R.Code='" & Code & "'") Then Throw New Exception(db.ErrDesc)

        If Not db.Execute("Delete AccDed from AccDed Where AccDed.ANO=" & ANO & " and Not Exists (Select R1.TOR from RateCov R1, RCover R2 where R1.TOR=AccDed.TOR and R1.Code=R2.Code and R2.ANO=AccDed.ANO)") Then Throw New Exception(db.ErrDesc)

        DelRCover = True
        Exit Function
errmsg:
        DelRCover = False
    End Function
    Private Function AccRCover(ByVal ANO As Long, ByVal PDate As Date, ByVal TOC As String, ByVal Voyage As Boolean, ByVal PTerm As Integer, ByVal FLDID As String, ByVal VALUEID As String, ByVal VALUEDESC As String, ByVal MAINCOVERAGE As String, ByVal MAINCOVERAGEREMARK As String, ByRef MAINRATE As Double, ByVal MAINUNIT As String, ByRef pSDate As Date, ByRef pEDate As Date, ByVal pctloss As Double, ByVal TRANSHIPMENT As Boolean, ByVal ATANDFROM As String, ByVal TRANSTO As String, ByVal CONVEYANCE As String, ByVal VOYAGEFROM As String, ByVal VOYAGETO As String, ByVal PORTFROM As String, ByVal PORTTO As String, ByVal CONSIGNEE As String, ByVal CADDRESS As String, ByVal TRANSDATE As Date, ByVal DEPARTDATE As Date, ByVal ARRIVALDATE As Date, ByVal PCALC As String, ByVal PPRORATA As Double, ByVal Loading As Double, ByVal AutoCalcAdditionF As Boolean, Optional ByVal DNO As String = "", Optional ByVal Discount As Double = 0, Optional ByVal DiscUnit As String = "", Optional ByVal DNO_Ext As String = "", Optional ByVal Discount_Ext As Double = 0, Optional ByVal CPREFUND As Double = 0, Optional ByVal PVessel As String = "", Optional ByVal RCoverDetTRANSDATE As Object = Nothing, Optional ByVal RCoverDetVOYAGE As Object = Nothing, Optional ByVal RCoverDetVessel As Object = Nothing, Optional ByVal RCoverDetCONVEYANCE As Object = Nothing, Optional ByVal RCoverDetATANDFROM As Object = Nothing, Optional ByVal RCoverDetTRANSTO As Object = Nothing, Optional ByVal COSHARE As Double = 0, Optional ByVal PAddition As Double = 0, Optional ByVal PCTEscalation As Double = 0, Optional ByVal PIndemnity As Integer = 0, Optional ByVal TExcess As Integer = 0, Optional ByVal VOYAGEFROMID As String = "", Optional ByVal VOYAGETOID As String = "", Optional ByVal PORTFROMID As String = "", Optional ByVal PORTTOID As String = "") As Boolean

        Dim Portion As Double
        Dim Scaling As Double
        Dim Code As String
        Dim Vessel As String = ""
        Dim Description As String
        Dim Category As String
        Dim RATE As Double
        Dim UNIT As String
        Dim NOREFUNDF As Boolean
        Dim PML As Double
        Dim PRatePCT As Double

        Dim FBuffer() As String
        Dim FIndex() As String

        Dim rs As RemoteSet
        If pctloss = 0 Then pctloss = 100

        If AutoCalcAdditionF Then
            PAddition = 100 - pctloss
        End If

        If Voyage Then
            Vessel = PVessel
            If Vessel = "" Then
                Dim AValueID As Object
                Dim AValueDesc As Object
                AValueID = Convert_FLDID_Into_Array(VALUEID)
                AValueDesc = Convert_FLDID_Into_Array(VALUEDESC)

                For i = 0 To UBound(AValueID)
                    If AValueID(i) <> AValueDesc(i) Then
                        Vessel = AValueDesc(i)
                        Exit For
                    End If
                Next
                If Vessel = "" Then Vessel = "-"
            End If
        End If

        'risk code
        rs = db.OpenQueryDef("QRATECODE", adOpenKeyset, ANO, "" & MAINCOVERAGE & "", 1)
        If rs.Eof Then GoTo errmsg
        Code = tostr(rs.fields("CODE"))
        Description = tostr(rs.fields("DESCRIPTION"))
        Portion = tostr(rs.fields("PORTION"))
        Category = tostr(rs.fields("CATEGORY"))
        RATE = tostr(MAINRATE)
        UNIT = tostr(MAINUNIT)
        NOREFUNDF = rs.fields("NOREFUNDF")
        PML = toval(rs.fields("PML"))
        PRatePCT = toval(rs.fields("PRatePCT"))
        If Loading = 0 Then Loading = toval(rs.fields("LOADING"))
        If Loading = 0 Then Loading = 1

        'initialize

        rs = db.OpenRemoteSet("Select * from RCover Where ANO=" & ANO & " and Code='" & Code & "' and SDate='" & Format(pSDate, "MM/DD/YYYY") & "'")
        If rs.Eof Then
            rs = db.OpenRemoteSet("Select * from RCover Where ANO=" & ANO & " and Code='" & Code & "' and EDate='" & Format(pEDate, "MM/DD/YYYY") & "'")
        End If
        FIndex = rs.fields_index
        FBuffer = rs.GetRecord

        If rs.Eof Then
            'PREMIUM CALC
            If PCALC = "" Then
                If Voyage Then ' Just Voyage
                    PCALC = "F"
                    PPRORATA = 0
                ElseIf DateDiff(DateInterval.Day, pSDate, PDate) <> 0 Then
                    PCALC = "P"
                    PPRORATA = 0
                Else
                    Select Case DateDiff(DateInterval.Month, todate(pSDate), todate(pEDate))
                        Case Is < PTerm
                            Scaling = Short_Period_Calc(TOC, todate(pSDate), todate(pEDate), todate(pEDate))
                            If Scaling <> 0 And Scaling <> 100 Then
                                PCALC = "S"
                                PPRORATA = Scaling
                            Else
                                PCALC = "P"
                                PPRORATA = 0
                            End If
                        Case PTerm
                            If toval(PPRORATA) = 0 Or toval(PAddition) = 0 Then
                                If DateAdd(DateInterval.Month, PTerm, todate(pSDate)) <> todate(pEDate) Then
                                    PCALC = "P"
                                Else
                                    PCALC = "F"
                                End If
                                PPRORATA = 0
                            End If
                        Case Is > PTerm
                            PCALC = "P"
                            PPRORATA = 0
                    End Select
                End If
            Else
                If Voyage Then ' Voyage or Flat Premium
                    PCALC = "F"
                    PPRORATA = 0
                End If
            End If

            'fbuffer rCover
            FBuffer(GetFieldIndex("ANO", FIndex)) = SetFieldValue(ANO)
            FBuffer(GetFieldIndex("CODE", FIndex)) = SetFieldValue(Code)
            FBuffer(GetFieldIndex("RATE", FIndex)) = SetFieldValue(RATE)
            FBuffer(GetFieldIndex("PORTION", FIndex)) = SetFieldValue(Portion)
            FBuffer(GetFieldIndex("UNIT", FIndex)) = SetFieldValue(UNIT)
            FBuffer(GetFieldIndex("TOR", FIndex)) = SetFieldValue("")
            FBuffer(GetFieldIndex("DNO", FIndex)) = SetFieldValue(DNO)
            FBuffer(GetFieldIndex("DISCOUNT", FIndex)) = SetFieldValue(Discount)
            FBuffer(GetFieldIndex("DiscUnit", FIndex)) = SetFieldValue(DiscUnit)
            FBuffer(GetFieldIndex("DNO_Ext", FIndex)) = SetFieldValue(DNO_Ext)
            FBuffer(GetFieldIndex("Discount_Ext", FIndex)) = SetFieldValue(Discount_Ext)
            FBuffer(GetFieldIndex("REMARK", FIndex)) = IIf(tostr(MAINCOVERAGEREMARK) = "", SetFieldValue(Description), SetFieldValue(MAINCOVERAGEREMARK))
            FBuffer(GetFieldIndex("SDATE", FIndex)) = SetFieldValue(pSDate)
            FBuffer(GetFieldIndex("EDATE", FIndex)) = SetFieldValue(pEDate)
            FBuffer(GetFieldIndex("PCTLOSS", FIndex)) = SetFieldValue(pctloss)
            FBuffer(GetFieldIndex("PADDITION", FIndex)) = SetFieldValue(PAddition)
            FBuffer(GetFieldIndex("PCTEscalation", FIndex)) = SetFieldValue(PCTEscalation)
            FBuffer(GetFieldIndex("LOADING", FIndex)) = SetFieldValue(Loading)
            FBuffer(GetFieldIndex("PCALC", FIndex)) = SetFieldValue(PCALC)
            FBuffer(GetFieldIndex("CATEGORY", FIndex)) = SetFieldValue(Category)

            If Voyage Then
                FBuffer(GetFieldIndex("TRANSHIPMENT", FIndex)) = SetFieldValue(TRANSHIPMENT)
                FBuffer(GetFieldIndex("VOYAGEFROM", FIndex)) = SetFieldValue(VOYAGEFROM)
                FBuffer(GetFieldIndex("VOYAGETO", FIndex)) = SetFieldValue(VOYAGETO)
                FBuffer(GetFieldIndex("PORTFROM", FIndex)) = SetFieldValue(PORTFROM)
                FBuffer(GetFieldIndex("PORTTO", FIndex)) = SetFieldValue(PORTTO)
                FBuffer(GetFieldIndex("VOYAGEFROMID", FIndex)) = SetFieldValue(VOYAGEFROMID)
                FBuffer(GetFieldIndex("VOYAGETOID", FIndex)) = SetFieldValue(VOYAGETOID)
                FBuffer(GetFieldIndex("PORTFROMID", FIndex)) = SetFieldValue(PORTFROMID)
                FBuffer(GetFieldIndex("PORTTOID", FIndex)) = SetFieldValue(PORTTOID)
                FBuffer(GetFieldIndex("CONSIGNEE", FIndex)) = SetFieldValue(CONSIGNEE)
                FBuffer(GetFieldIndex("CADDRESS", FIndex)) = SetFieldValue(CADDRESS)
                If TRANSHIPMENT = True Then
                    FBuffer(GetFieldIndex("ATANDFROM", FIndex)) = SetFieldValue(ATANDFROM)
                    FBuffer(GetFieldIndex("TRANSTO", FIndex)) = SetFieldValue(TRANSTO)
                    FBuffer(GetFieldIndex("CONVEYANCE", FIndex)) = SetFieldValue(CONVEYANCE)
                    FBuffer(GetFieldIndex("TRANSDATE", FIndex)) = SetFieldValue(TRANSDATE)
                End If

                FBuffer(GetFieldIndex("DEPARTDATE", FIndex)) = SetFieldValue(DEPARTDATE)
                FBuffer(GetFieldIndex("ARRIVALDATE", FIndex)) = SetFieldValue(ARRIVALDATE)
                FBuffer(GetFieldIndex("CPERIOD", FIndex)) = SetFieldValue(0)
                FBuffer(GetFieldIndex("VESSEL", FIndex)) = SetFieldValue(Vessel)
            End If

            FBuffer(GetFieldIndex("PPRORATA", FIndex)) = SetFieldValue(PPRORATA)

            FBuffer(GetFieldIndex("COSHARE", FIndex)) = SetFieldValue(0)
            FBuffer(GetFieldIndex("NOREFUNDF", FIndex)) = SetFieldValue(NOREFUNDF)
            FBuffer(GetFieldIndex("PIndemnity", FIndex)) = SetFieldValue(PIndemnity)
            FBuffer(GetFieldIndex("TExcess", FIndex)) = SetFieldValue(TExcess)
            FBuffer(GetFieldIndex("NETRATEF", FIndex)) = SetFieldValue(0)
            FBuffer(GetFieldIndex("CPREFUND", FIndex)) = SetFieldValue(CPREFUND)
            FBuffer(GetFieldIndex("COSHARE", FIndex)) = SetFieldValue(COSHARE)
            FBuffer(GetFieldIndex("PML", FIndex)) = SetFieldValue(PML)
            FBuffer(GetFieldIndex("PRatePCT", FIndex)) = SetFieldValue(PRatePCT)
        Else
            'fbuffer rCover

            If FBuffer(GetFieldIndex("SDate", FIndex)) <> SetFieldValue(pSDate) Or FBuffer(GetFieldIndex("EDATE", FIndex)) <> SetFieldValue(pEDate) Then
                If PCALC = "" Then
                    Select Case DateDiff(DateInterval.Month, todate(pSDate), todate(pEDate))
                        Case Is < PTerm
                            Scaling = Short_Period_Calc(TOC, todate(pSDate), todate(pEDate), todate(pEDate))
                            If Scaling <> 0 And Scaling <> 100 Then
                                PCALC = "S"
                                PPRORATA = Scaling
                            Else
                                PCALC = "P"
                                PPRORATA = 0
                            End If
                        Case PTerm
                            If toval(PPRORATA) = 0 Or toval(PAddition) = 0 Then
                                If DateAdd(DateInterval.Month, PTerm, todate(pSDate)) <> todate(pEDate) Then
                                    PCALC = "P"
                                Else
                                    PCALC = "F"
                                End If
                                PPRORATA = 0
                            End If
                        Case Is > PTerm
                            PCALC = "P"
                            PPRORATA = 0
                    End Select
                End If
                FBuffer(GetFieldIndex("EDATE", FIndex)) = SetFieldValue(pEDate)
            End If

            If toval(RATE) <> 0 Then
                FBuffer(GetFieldIndex("RATE", FIndex)) = SetFieldValue(RATE)
            End If

            If tostr(UNIT) <> "" Then
                FBuffer(GetFieldIndex("UNIT", FIndex)) = SetFieldValue(UNIT)
            End If
            If tostr(DNO) <> "" Then
                FBuffer(GetFieldIndex("DNO", FIndex)) = SetFieldValue(DNO)
            End If
            If toval(Discount) <> 0 Then
                FBuffer(GetFieldIndex("DISCOUNT", FIndex)) = SetFieldValue(Discount)
            End If
            If DiscUnit <> "" Then
                FBuffer(GetFieldIndex("DiscUnit", FIndex)) = SetFieldValue(DiscUnit)
            End If
            If tostr(DNO_Ext) <> "" Then
                FBuffer(GetFieldIndex("DNO_Ext", FIndex)) = SetFieldValue(DNO_Ext)
            End If
            If toval(Discount_Ext) <> 0 Then
                FBuffer(GetFieldIndex("Discount_Ext", FIndex)) = SetFieldValue(Discount_Ext)
            End If

            If tostr(MAINCOVERAGEREMARK) <> "" Then
                FBuffer(GetFieldIndex("REMARK", FIndex)) = IIf(tostr(MAINCOVERAGEREMARK) = "", SetFieldValue(Description), SetFieldValue(MAINCOVERAGEREMARK))
            End If

            If toval(pctloss) <> 0 Then
                FBuffer(GetFieldIndex("PCTLOSS", FIndex)) = SetFieldValue(pctloss)
            End If

            If toval(PAddition) <> 0 Then
                FBuffer(GetFieldIndex("PADDITION", FIndex)) = SetFieldValue(PAddition)
            End If

            If toval(PCTEscalation) <> 0 Then
                FBuffer(GetFieldIndex("PCTEscalation", FIndex)) = SetFieldValue(PCTEscalation)
            End If

            If toval(Loading) <> 0 Then
                FBuffer(GetFieldIndex("LOADING", FIndex)) = SetFieldValue(Loading)
            End If

            If toval(PIndemnity) <> 0 Then
                FBuffer(GetFieldIndex("PIndemnity", FIndex)) = SetFieldValue(PIndemnity)
            End If

            If toval(TExcess) <> 0 Then
                FBuffer(GetFieldIndex("TExcess", FIndex)) = SetFieldValue(TExcess)
            End If

            If Voyage Then
                If tostr(VOYAGEFROM) <> "" Then
                    FBuffer(GetFieldIndex("VOYAGEFROM", FIndex)) = SetFieldValue(VOYAGEFROM)
                End If

                If tostr(VOYAGETO) <> "" Then
                    FBuffer(GetFieldIndex("VOYAGETO", FIndex)) = SetFieldValue(VOYAGETO)
                End If

                If tostr(PORTFROM) <> "" Then
                    FBuffer(GetFieldIndex("PORTFROM", FIndex)) = SetFieldValue(PORTFROM)
                End If

                If tostr(PORTTO) <> "" Then
                    FBuffer(GetFieldIndex("PORTTO", FIndex)) = SetFieldValue(PORTTO)
                End If

                If tostr(VOYAGEFROMID) <> "" Then
                    FBuffer(GetFieldIndex("VOYAGEFROMID", FIndex)) = SetFieldValue(VOYAGEFROMID)
                End If

                If tostr(VOYAGETOID) <> "" Then
                    FBuffer(GetFieldIndex("VOYAGETOID", FIndex)) = SetFieldValue(VOYAGETOID)
                End If

                If tostr(PORTFROMID) <> "" Then
                    FBuffer(GetFieldIndex("PORTFROMID", FIndex)) = SetFieldValue(PORTFROMID)
                End If

                If tostr(PORTTOID) <> "" Then
                    FBuffer(GetFieldIndex("PORTTOID", FIndex)) = SetFieldValue(PORTTOID)
                End If

                If tostr(CONSIGNEE) <> "" Then
                    FBuffer(GetFieldIndex("CONSIGNEE", FIndex)) = SetFieldValue(CONSIGNEE)
                End If

                If tostr(CADDRESS) <> "" Then
                    FBuffer(GetFieldIndex("CADDRESS", FIndex)) = SetFieldValue(CADDRESS)
                End If

                If TRANSHIPMENT = True Then
                    FBuffer(GetFieldIndex("TRANSHIPMENT", FIndex)) = SetFieldValue(TRANSHIPMENT)
                    FBuffer(GetFieldIndex("ATANDFROM", FIndex)) = SetFieldValue(ATANDFROM)
                    FBuffer(GetFieldIndex("TRANSTO", FIndex)) = SetFieldValue(TRANSTO)
                    FBuffer(GetFieldIndex("CONVEYANCE", FIndex)) = SetFieldValue(CONVEYANCE)
                    FBuffer(GetFieldIndex("TRANSDATE", FIndex)) = SetFieldValue(TRANSDATE)
                End If

                FBuffer(GetFieldIndex("DEPARTDATE", FIndex)) = SetFieldValue(DEPARTDATE)
                FBuffer(GetFieldIndex("ARRIVALDATE", FIndex)) = SetFieldValue(ARRIVALDATE)

                If tostr(Vessel) <> "" Then
                    FBuffer(GetFieldIndex("VESSEL", FIndex)) = SetFieldValue(Vessel)
                End If
            End If

            If PCALC <> "" Then
                FBuffer(GetFieldIndex("PCALC", FIndex)) = SetFieldValue(PCALC)
            End If

            If toval(PPRORATA) <> 0 Then
                FBuffer(GetFieldIndex("PPRORATA", FIndex)) = SetFieldValue(PPRORATA)
            End If

            If toval(CPREFUND) <> 0 Then
                FBuffer(GetFieldIndex("CPREFUND", FIndex)) = SetFieldValue(CPREFUND)
            End If

            If toval(COSHARE) <> 0 Then
                FBuffer(GetFieldIndex("COSHARE", FIndex)) = SetFieldValue(COSHARE)
            End If

        End If


        Const MaxCols = 6
        Dim bufferdata(0, MaxCols - 1) As Object

        If Not RCoverDetVOYAGE Is Nothing Then
            ReDim bufferdata(UBound(RCoverDetVOYAGE), MaxCols - 1)
            For i = 0 To UBound(RCoverDetVOYAGE)
                If tostr(RCoverDetVOYAGE(i)) <> "" Then
                    bufferdata(i, 0) = todate(RCoverDetTRANSDATE(i))
                    bufferdata(i, 1) = tostr(RCoverDetVOYAGE(i))
                    bufferdata(i, 2) = tostr(RCoverDetVessel(i))
                    bufferdata(i, 3) = tostr(RCoverDetCONVEYANCE(i))
                    bufferdata(i, 4) = tostr(RCoverDetATANDFROM(i))
                    bufferdata(i, 5) = tostr(RCoverDetTRANSTO(i))
                End If
            Next
        End If

        'save records
        Dim param(3) As Object
        param(0) = ANO
        param(1) = Code
        param(2) = pSDate
        param(3) = Portion
        If Not Me.Direct_Call_Process_Execute("ProcessExt.NetV3.Proclib", "save_coverage", param, FIndex, FBuffer, TrimBuffer(bufferdata, 1)) Then
            StrMsg = "Process Save Coverage Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
            GoTo errmsg
        End If

        AccRCover = True
        Exit Function
errmsg:
        AccRCover = False
    End Function
    Private Function DelICover(ByVal ANO As Long, ByVal MAININTERESTCODE As String) As Boolean

        If Not Delete_Records("Delete from ICover Where ANO=" & ANO & " and TOI='" & MAININTERESTCODE & "'") Then GoTo errmsg

        DelICover = True
        Exit Function
errmsg:
        DelICover = False
    End Function
    Private Function AccICover(ByVal ANO As Long, ByVal MAINCURRENCY As String, ByVal MAININTERESTCODE As String, ByVal MAININTERESTREMARK As String, ByVal MAINSUMINSURED As Double, ByVal MAINLIABILITY As Double, ByVal MAINMAXLIABILITY As Double, ByVal MAINEML As Double, ByVal TOTAL As Double, ByVal PCTADJ As Double, Optional ByRef ICoverDetTOI As String = "", Optional ByRef ICoverDetDescription As Object = Nothing, Optional ByRef ICoverDetQty As Object = "", Optional ByRef ICoverDetUnit As Object = Nothing, Optional ByRef ICoverDetUValue As Object = Nothing, Optional ByRef ICoverDetAmount As Object = Nothing, Optional ByRef ICoverDetMemo As Object = Nothing, Optional ByRef ICoverNOCTOI As Object = Nothing, Optional ByRef ICoverNOC As Object = Nothing, Optional ByRef ICoverNOCDescription As Object = Nothing, Optional ByRef ICoverNOCMAXFREQ As Object = Nothing, Optional ByRef ICoverNOCMAXQTY As Object = Nothing, Optional ByRef ICoverNOCPCT As Object = Nothing, Optional ByRef ICoverNOCAmount As Object = Nothing, Optional ByRef ICoverNOCLimit As Object = Nothing, Optional ByRef MAINCURRENCY_OC As Object = Nothing, Optional ByVal MAINSUMINSURED_OC As Object = Nothing, Optional ByVal MAINLIABILITY_OC As Object = Nothing, Optional ByVal MAINMAXLIABILITY_OC As Object = Nothing, Optional ByVal MAINEML_OC As Object = Nothing, Optional ByVal Rate_OC As Object = Nothing, Optional ByVal IINFOTOI As Object = Nothing, Optional ByVal IINFOFLDID As Object = Nothing, Optional ByVal IINFOVALUEID As Object = Nothing, Optional ByVal IINFOVALUEDESC As Object = Nothing, Optional ByVal RefNo As String = "", Optional ByVal RefDate As Object = Nothing, Optional ByVal DocNo As String = "", Optional ByVal DocDate As Object = Nothing, Optional ByVal FLDValueF As Object = Nothing, Optional ByVal FLDVALUE1 As Object = Nothing, Optional ByVal FLDVALUE2 As Object = Nothing, Optional ByVal FLDVALUE3 As Object = Nothing, Optional ByVal Section As String = "", Optional ByVal SectionShortDesc As String = "", Optional ByVal SectionDescription As String = "") As Boolean
        Dim rs As RemoteSet
        Dim rsTemp As RemoteSet
        Dim TOC As String
        Dim AType As String
        Dim TOI As String
        Dim Remark As String
        Dim Adjustable As Boolean
        Dim Category As String
        Dim SI As Double
        Dim Amount As Double
        Dim Amount_AOE As Double
        Dim FLDID(15) As String
        Dim VALUEID(15) As String
        Dim VALUEDESC(15) As String
        Dim INO As Long
        Dim ICoverEXTF As Boolean
        Dim ICoverDETF As Boolean
        Dim i As Integer
        Dim j As Integer
        Dim FBuffer() As String
        Dim FIndex() As String
        Dim DispModel As String

        On Error GoTo errmsg

        INO = -1
        ICoverEXTF = False
        ICoverDETF = True

        'interest code
        rs = db.OpenRemoteSet("Select TOI.TOI, TOI.Description, TOI.Adjustable, TOI.PCTADJ, TOI.DispModel, PCLASS.CATEGORY from TOI INNER JOIN RCOVER ON (RCOVER.ANO=" & ANO & ") INNER JOIN RATECOV ON (RATECOV.CODE=RCOVER.CODE) INNER JOIN PCLASS ON (TOI.TOI=PCLASS.TOI AND RATECOV.TOR=PCLASS.TOR) WHERE TOI.TOI='" & MAININTERESTCODE & "'")
        TOI = tostr(rs.fields("TOI"))
        Remark = IIf(tostr(MAININTERESTREMARK) = "", tostr(rs.fields("Description")), tostr(MAININTERESTREMARK))
        Adjustable = toval(rs.fields("Adjustable"))
        DispModel = tostr(rs.fields("DispModel"))
        Category = tostr(rs.fields("Category"))
        If PCTADJ = 0 Then PCTADJ = toval(rs.fields("PCTADJ"))
        If Category = "" Then Category = "M"

        'Interest Covered and Section
        rs = db.OpenRemoteSet("SELECT INO, Category, SECTION FROM ICover WHERE ANO=" & ANO & " and TOI='" & TOI & "' and (Amount=0 or CURRENCY='" & MAINCURRENCY & "') Order by Case When CURRENCY='" & MAINCURRENCY & "' then 0 else 1 end")
        If Not rs.Eof Then
            INO = toval(rs.fields("INO"))
            Category = tostr(rs.fields("Category"))
        End If
        If Section = "" Then Section = tostr(rs.fields("Section"))

        If Section <> "" Then
            rs = db.OpenRemoteSet("Select * from AccSection Where ANO=" & ANO & " and Section='" & Section & "'")
            If rs.Eof AndAlso SectionShortDesc <> "" Then
                rs.AddNew()
                rs.fields("ANO") = ANO
                rs.fields("Section") = Section
                rs.fields("ShortDesc") = SectionShortDesc
                rs.fields("Description") = SectionDescription
                If Not rs.Update Then
                    StrMsg = "Process Save Section Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                    GoTo errmsg
                End If
            End If
            Section = tostr(rs.fields("Section"))
        End If

        Dim bufferdata(0, 5) As Object
        If ICoverDetTOI = MAININTERESTCODE AndAlso Not ICoverDetDescription Is Nothing Then
            ReDim bufferdata(UBound(ICoverDetDescription), 5)
            For i = 0 To UBound(ICoverDetDescription)
                If tostr(ICoverDetDescription(i)) <> "" Then
                    bufferdata(i, 0) = tostr(ICoverDetDescription(i))
                    bufferdata(i, 1) = tostr(ICoverDetQty(i))
                    bufferdata(i, 2) = tostr(ICoverDetUnit(i))
                    bufferdata(i, 3) = tostr(ICoverDetUValue(i))
                    bufferdata(i, 4) = tostr(ICoverDetAmount(i))
                    bufferdata(i, 5) = tostr(ICoverDetMemo(i))
                End If
            Next
        End If

        Dim bufferdata_2 As Object = Nothing
        If Not ICoverNOCTOI Is Nothing Then
            For j = 0 To UBound(ICoverNOCTOI)
                If UCase(ICoverNOCTOI(j)) = UCase(MAININTERESTCODE) Then
                    ReDim bufferdata_2(UBound(ICoverNOC, 1), 8)
                    For i = 0 To UBound(ICoverNOC, 1)
                        If tostr(ICoverNOC(i, j)) <> "" Then
                            rsTemp = db.OpenRemoteSet("Select Description from NOC Where NOC = '" & ICoverNOC(i, j) & "' and TOI = '" & MAININTERESTCODE & "'")
                            If Not rsTemp.Eof Then
                                If ICoverNOCDescription(i, j) = "" Then ICoverNOCDescription(i, j) = rsTemp.fields("Description")
                                bufferdata_2(i, 0) = tostr(ICoverNOC(i, j))
                                bufferdata_2(i, 1) = tostr(ICoverNOCDescription(i, j))
                                bufferdata_2(i, 2) = toval(ICoverNOCMAXFREQ(i, j))
                                bufferdata_2(i, 3) = toval(ICoverNOCMAXQTY(i, j))
                                bufferdata_2(i, 4) = tostr(MAINCURRENCY)
                                bufferdata_2(i, 5) = toval(ICoverNOCPCT(i, j))
                                bufferdata_2(i, 6) = toval(ICoverNOCAmount(i, j))
                                bufferdata_2(i, 7) = toval(ICoverNOCLimit(i, j))
                                bufferdata_2(i, 8) = 0
                            End If
                        End If
                    Next
                End If
            Next
        End If

        'initialize
        rs = db.OpenQueryDef("QInterest_Data", adOpenKeyset, INO)
        FIndex = rs.fields_index
        FBuffer = rs.GetRecord

        If toval(MAINLIABILITY) = 0 Then MAINLIABILITY = MAINSUMINSURED
        If toval(MAINMAXLIABILITY) = 0 Then MAINMAXLIABILITY = MAINSUMINSURED

        If toval(FLDVALUE1) <> 0 Then
            Select Case UCase(DispModel)
                Case "CIT"
                    ICoverEXTF = True
                    FBuffer(GetFieldIndex("FLDVALUEF", FIndex)) = SetFieldValue(toval(FLDValueF))
                    FBuffer(GetFieldIndex("FLDTAG1", FIndex)) = SetFieldValue("Maximum Carrying")
                    FBuffer(GetFieldIndex("FLDOP1", FIndex)) = SetFieldValue("x")
                    FBuffer(GetFieldIndex("FLDVALUE1", FIndex)) = SetFieldValue(toval(FLDVALUE1))
                    FBuffer(GetFieldIndex("FLDVALUEL", FIndex)) = SetFieldValue(toval(FLDValueF) * toval(FLDVALUE1))
                    MAINLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINSUMINSURED = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINMAXLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                Case "CIS"
                    ICoverEXTF = True
                    FBuffer(GetFieldIndex("FLDVALUEF", FIndex)) = SetFieldValue(toval(FLDValueF))
                    FBuffer(GetFieldIndex("FLDTAG1", FIndex)) = SetFieldValue("Total Days")
                    FBuffer(GetFieldIndex("FLDOP1", FIndex)) = SetFieldValue("/")
                    FBuffer(GetFieldIndex("FLDVALUE1", FIndex)) = SetFieldValue(toval(FLDVALUE1))
                    FBuffer(GetFieldIndex("FLDVALUEL", FIndex)) = SetFieldValue(toval(FLDValueF) / toval(FLDVALUE1))
                    MAINLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINSUMINSURED = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINMAXLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                Case "MC"
                    ICoverEXTF = True
                    FBuffer(GetFieldIndex("FLDVALUEF", FIndex)) = SetFieldValue(toval(FLDValueF))
                    FBuffer(GetFieldIndex("FLDTAG1", FIndex)) = "VALUE ADDED TAX"
                    FBuffer(GetFieldIndex("FLDOP1", FIndex)) = "%"
                    FBuffer(GetFieldIndex("FLDVALUE1", FIndex)) = SetFieldValue(toval(FLDVALUE1))
                    FBuffer(GetFieldIndex("FLDTAG2", FIndex)) = "IMAGINARY PROFIT"
                    FBuffer(GetFieldIndex("FLDOP2", FIndex)) = "%"
                    FBuffer(GetFieldIndex("FLDVALUE2", FIndex)) = SetFieldValue(toval(FLDValue2))
                    FBuffer(GetFieldIndex("FLDTAG3", FIndex)) = "CIF (COST,INS, FREIGHT)"
                    FBuffer(GetFieldIndex("FLDOP3", FIndex)) = "%"
                    FBuffer(GetFieldIndex("FLDVALUE3", FIndex)) = SetFieldValue(toval(FLDValue3))
                    FBuffer(GetFieldIndex("FLDTAG4", FIndex)) = ""
                    FBuffer(GetFieldIndex("FLDTAG5", FIndex)) = ""
                    FBuffer(GetFieldIndex("FLDOP4", FIndex)) = "+"
                    FBuffer(GetFieldIndex("FLDOP5", FIndex)) = "+"
                    FBuffer(GetFieldIndex("FLDVALUE4", FIndex)) = 0
                    FBuffer(GetFieldIndex("FLDVALUE5", FIndex)) = 0
                    FBuffer(GetFieldIndex("FLDVALUEL", FIndex)) = SetFieldValue(toval(FLDValueF) + toval(FLDVALUE1) / 100 * toval(FLDValueF) + toval(FLDVALUE2) / 100 * toval(FLDValueF) + toval(FLDVALUE3) / 100 * toval(FLDValueF))
                    MAINLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINSUMINSURED = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINMAXLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))

                Case "PD"
                    ICoverEXTF = True
                    FBuffer(GetFieldIndex("FLDTAG1", FIndex)) = "NUMBER OF DRIVER"
                    FBuffer(GetFieldIndex("FLDOP1", FIndex)) = "+"
                    FBuffer(GetFieldIndex("FLDVALUE1", FIndex)) = SetFieldValue(toval(FLDVALUE1))
                    FBuffer(GetFieldIndex("FLDTAG2", FIndex)) = "NUMBER OF PASSENGER"
                    FBuffer(GetFieldIndex("FLDOP2", FIndex)) = "+"
                    FBuffer(GetFieldIndex("FLDVALUE2", FIndex)) = SetFieldValue(toval(FLDVALUE2))
                    FBuffer(GetFieldIndex("FLDTAG3", FIndex)) = "LIMIT OF LIABILITY"
                    FBuffer(GetFieldIndex("FLDOP3", FIndex)) = "x"
                    FBuffer(GetFieldIndex("FLDVALUE3", FIndex)) = SetFieldValue(toval(FLDVALUE3))
                    FBuffer(GetFieldIndex("FLDVALUEL", FIndex)) = SetFieldValue((toval(FLDVALUE1) + toval(FLDVALUE2)) * toval(FLDVALUE3))
                    MAINLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINSUMINSURED = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINMAXLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                Case "TCI"
                    ICoverEXTF = True
                    FBuffer(GetFieldIndex("FLDVALUEF", FIndex)) = SetFieldValue(toval(FLDValueF))
                    FBuffer(GetFieldIndex("FLDTAG1", FIndex)) = "Maximum Liability (%)"
                    FBuffer(GetFieldIndex("FLDOP1", FIndex)) = "x"
                    FBuffer(GetFieldIndex("FLDVALUE1", FIndex)) = SetFieldValue(toval(FLDVALUE1))
                    FBuffer(GetFieldIndex("FLDTAG2", FIndex)) = ""
                    FBuffer(GetFieldIndex("FLDOP2", FIndex)) = ""
                    FBuffer(GetFieldIndex("FLDVALUE2", FIndex)) = 0
                    FBuffer(GetFieldIndex("FLDTAG3", FIndex)) = """"
                    FBuffer(GetFieldIndex("FLDOP3", FIndex)) = ""
                    FBuffer(GetFieldIndex("FLDVALUE3", FIndex)) = 0
                    FBuffer(GetFieldIndex("FLDVALUEL", FIndex)) = SetFieldValue(toval(FLDValueF) * toval(FLDVALUE1) / 100)
                    MAINLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINSUMINSURED = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
                    MAINMAXLIABILITY = toval(GetFieldValue(FBuffer(GetFieldIndex("FLDVALUEL", FIndex))))
            End Select
        End If

        'fbuffer
        FBuffer(GetFieldIndex("ANO", FIndex)) = SetFieldValue(ANO)
        FBuffer(GetFieldIndex("INO", FIndex)) = SetFieldValue(INO)
        FBuffer(GetFieldIndex("TOI", FIndex)) = SetFieldValue(TOI)
        FBuffer(GetFieldIndex("REMARK", FIndex)) = SetFieldValue(Remark)
        FBuffer(GetFieldIndex("ADJUSTABLE", FIndex)) = SetFieldValue(Adjustable)
        FBuffer(GetFieldIndex("CURRENCY", FIndex)) = SetFieldValue(MAINCURRENCY)
        FBuffer(GetFieldIndex("AMOUNT", FIndex)) = SetFieldValue(MAINLIABILITY)
        FBuffer(GetFieldIndex("IUNIT", FIndex)) = SetFieldValue("")
        FBuffer(GetFieldIndex("SI", FIndex)) = SetFieldValue(MAINSUMINSURED)
        FBuffer(GetFieldIndex("TOTAL", FIndex)) = SetFieldValue(TOTAL)
        FBuffer(GetFieldIndex("CATEGORY", FIndex)) = SetFieldValue(Category)
        FBuffer(GetFieldIndex("SURVEYF", FIndex)) = SetFieldValue(0)
        FBuffer(GetFieldIndex("RINO", FIndex)) = SetFieldValue(0)
        FBuffer(GetFieldIndex("SECTION", FIndex)) = SetFieldValue(Section)
        FBuffer(GetFieldIndex("AMOUNT_AOE", FIndex)) = SetFieldValue(MAINMAXLIABILITY)
        FBuffer(GetFieldIndex("EML", FIndex)) = SetFieldValue(MAINEML)
        FBuffer(GetFieldIndex("INDEMNITY", FIndex)) = SetFieldValue(0)
        FBuffer(GetFieldIndex("BINO", FIndex)) = SetFieldValue(0)
        FBuffer(GetFieldIndex("NOTDECRF", FIndex)) = SetFieldValue(False)

        FBuffer(GetFieldIndex("CURRENCY_OC", FIndex)) = SetFieldValue(IIf(tostr(MAINCURRENCY_OC) <> "", MAINCURRENCY_OC, MAINCURRENCY))
        FBuffer(GetFieldIndex("AMOUNT_OC", FIndex)) = SetFieldValue(IIf(toval(MAINLIABILITY_OC) <> 0, MAINLIABILITY_OC, MAINLIABILITY))
        FBuffer(GetFieldIndex("AMOUNT_AOE_OC", FIndex)) = SetFieldValue(IIf(toval(MAINMAXLIABILITY_OC) <> 0, MAINMAXLIABILITY_OC, MAINMAXLIABILITY))
        FBuffer(GetFieldIndex("SI_OC", FIndex)) = SetFieldValue(IIf(toval(MAINSUMINSURED_OC) <> 0, MAINSUMINSURED_OC, MAINSUMINSURED))
        FBuffer(GetFieldIndex("EML_OC", FIndex)) = SetFieldValue(IIf(toval(MAINEML_OC) <> 0, MAINEML_OC, MAINEML))
        FBuffer(GetFieldIndex("Rate_OC", FIndex)) = SetFieldValue(IIf(toval(Rate_OC) <> 0, Rate_OC, 1))
        If Adjustable And PCTADJ <> 0 Then FBuffer(GetFieldIndex("PCTADJ", FIndex)) = SetFieldValue(PCTADJ)

        FBuffer(GetFieldIndex("RefNo", FIndex)) = SetFieldValue(RefNo)
        If Not IsNothing(RefDate) Then
            FBuffer(GetFieldIndex("RefDate", FIndex)) = SetFieldValue(todate(RefDate))
        End If
        FBuffer(GetFieldIndex("DocNo", FIndex)) = SetFieldValue(DocNo)
        If Not IsNothing(DocDate) Then
            FBuffer(GetFieldIndex("DocDate", FIndex)) = SetFieldValue(todate(DocDate))
        End If

        rsTemp = db.OpenQueryDef("QTOI_GenHTab", adOpenKeyset, TOI)

        ' Default IINFO dari AINFO
        rs = db.OpenRemoteSet("Select * from AInfo Where ANO = " & ANO)
        If Not rsTemp.Eof Then
            For X = 0 To 14
                If rsTemp.fields("FLDID" & X + 1) <> "" Then
                    FBuffer(GetFieldIndex("FLDID" & X + 1, FIndex)) = SetFieldValue(rsTemp.fields("FLDID" & X + 1))
                    If Not rs.Eof Then
                        For j = 0 To 14
                            If rs.fields("FLDID" & j + 1) <> "" Then
                                If rs.fields("FLDID" & j + 1) = rsTemp.fields("FLDID" & X + 1) Then
                                    FBuffer(GetFieldIndex("VALUEID" & X + 1, FIndex)) = SetFieldValue(rs.fields("VALUEID" & j + 1))
                                    FBuffer(GetFieldIndex("VALUEDESC" & X + 1, FIndex)) = SetFieldValue(rs.fields("VALUEDESC" & j + 1))
                                    Exit For
                                End If
                            Else
                                Exit For
                            End If
                        Next
                    End If
                Else
                    Exit For
                End If
            Next
        End If

        If Not IINFOTOI Is Nothing Then
            For L = 0 To UBound(IINFOTOI)
                If (IINFOTOI(L) = MAININTERESTCODE) And IINFOFLDID(L) <> "" And IINFOVALUEID(L) <> "" Then
                    For j = 1 To 15
                        If rsTemp.fields("FLDID" & j) <> "" Then
                            If rsTemp.fields("FLDID" & j) = IINFOFLDID(L) Then
                                FBuffer(GetFieldIndex("VALUEID" & j, FIndex)) = SetFieldValue(IINFOVALUEID(L))
                                FBuffer(GetFieldIndex("VALUEDESC" & j, FIndex)) = SetFieldValue(IINFOVALUEDESC(L))

                                ' Spread Info
                                If toval(rsTemp.fields("SpreadInfoF" & j)) AndAlso toval(rsTemp.fields("FLDTAB" & j)) AndAlso IINFOVALUEID(L) <> "" Then
                                    rs = db.OpenQueryDef("QSpreadInfo", adOpenForwardonly, rsTemp.fields("FLDID" & j), IINFOVALUEID(L))
                                    If Not rs.Eof Then
                                        For i = j + 1 To 15
                                            If rsTemp.fields("FLDID" & i) <> "" Then
                                                If GetFieldValue(FBuffer(GetFieldIndex("VALUEID" & i, FIndex))) = "" Then
                                                    For k = 1 To 15
                                                        If rs.fields("FLDID" & k) <> "" Then
                                                            If rsTemp.fields("FLDID" & i) = rs.fields("FLDID" & k) Then
                                                                FBuffer(GetFieldIndex("VALUEID" & i, FIndex)) = SetFieldValue(rs.fields("VALUEID" & k))
                                                                If GetFieldValue(FBuffer(GetFieldIndex("VALUEDESC" & i, FIndex))) = "" Then
                                                                    FBuffer(GetFieldIndex("VALUEDESC" & i, FIndex)) = SetFieldValue(rs.fields("VALUEDESC" & k))
                                                                End If
                                                                Exit For
                                                            End If
                                                        Else
                                                            Exit For
                                                        End If
                                                    Next
                                                End If
                                            Else
                                                Exit For
                                            End If
                                        Next
                                    End If
                                End If

                                Exit For
                            End If

                        Else
                            Exit For
                        End If
                    Next
                End If
            Next

        End If

        Dim param(3) As Object
        param(0) = INO
        param(1) = ANO
        param(2) = ICoverDETF
        param(3) = ICoverEXTF

        INO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.Proclib", "Save_Interest", param, FIndex, FBuffer, TrimBuffer(bufferdata), TrimBuffer(bufferdata_2))
        If INO = 0 Then
            'Restore Value
            INO = getInParamValue(param, 0)
            StrMsg = "Process Save Interest Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
            GoTo errmsg
        End If
        AccICover = True
        Exit Function
errmsg:
        AccICover = False
    End Function
    Private Function AccIDeclaredValue(ByVal ANO As Long, Optional ByRef ICoverDetTOI As String = "", Optional ByRef ICoverDetDPeriod As Object = Nothing, Optional ByRef ICoverDetDescription As Object = Nothing, Optional ByRef ICoverDetQty As Object = "", Optional ByRef ICoverDetUnit As Object = Nothing, Optional ByRef ICoverDetUValue As Object = Nothing, Optional ByRef ICoverDetAmount As Object = Nothing, Optional ByRef ICoverDetMemo As Object = Nothing) As Boolean
        Dim rs As RemoteSet


        On Error GoTo errmsg

        'Interest Covered and Section
        If ICoverDetTOI <> "" Then
            rs = db.OpenRemoteSet("SELECT INO, TOI, SI FROM ICover WHERE Adjustable=1 and ANO=" & ANO & " and TOI='" & ICoverDetTOI & "'")
        Else
            rs = db.OpenRemoteSet("SELECT INO, TOI, SI FROM ICover WHERE Adjustable=1 and ANO=" & ANO & "")
        End If
        If rs.Eof Then GoTo errmsg

        Dim INO As Long = toval(rs.fields("INO"))
        Dim TOI As String = rs.fields("TOI")
        Dim MaxAmount As Double = toval(rs.fields("SI"))

        Dim SDate As Date
        Dim EDate As Date
        Dim AType As String
        Dim Method As String

        rs = db.OpenRemoteSet("Select PDate, PPDate, AType from Acceptance Where ANO=" & ANO)
        SDate = todate(rs.fields("PDate"))
        EDate = todate(rs.fields("PPDate"))
        AType = tostr(rs.fields("AType"))

        rs = db.OpenRemoteSet("Select AdjMethod from TOI Where TOI='" & TOI & "'")
        Method = tostr(rs.fields("AdjMethod"))

        If Not db.Execute("Delete from ICoverDet Where INO=" & INO & " and DPeriod<>0") Then Throw New Exception(db.ErrDesc)

        Dim i As Integer
        Dim j As Integer
        Dim DPeriod As Integer = 0

        j = 0
        rs = db.OpenRemoteSet("Select * from ICoverDet Where 1<>1")

        For i = 0 To UBound(ICoverDetDescription)
            If tostr(ICoverDetDescription(i)) <> "" Then
                rs.AddNew()
                rs.fields("INO") = INO
                If DPeriod <> toval(ICoverDetDPeriod(i)) Then
                    j = 0
                    DPeriod = toval(ICoverDetDPeriod(i))
                End If
                rs.fields("DPeriod") = DPeriod
                rs.fields("OrderNo") = j + 1
                rs.fields("Description") = tostr(ICoverDetDescription(i))
                rs.fields("Qty") = toval(ICoverDetQty(i))
                rs.fields("Unit") = tostr(ICoverDetUnit(i))
                rs.fields("UValue") = toval(ICoverDetUValue(i))
                rs.fields("Amount") = toval(ICoverDetAmount(i))
                rs.fields("Memo") = tostr(ICoverDetMemo(i))
                rs.fields("ANO") = ANO
                If Not rs.UpdateRow Then Throw New Exception(db.ErrDesc)
            End If
        Next

        If Not rs.Eof Then
            If Not rs.Update Then Throw New Exception(db.ErrDesc)
        End If

        Dim Limit As Double
        Dim Amount As Double
        Dim rsI As RemoteSet

        If Method = "OVERLIMIT" Then
            Limit = MaxAmount
        Else
            Limit = 0
        End If

        If Method = "AVERAGE" AndAlso tostr(GetAppSetting("AdjustableStockCalculationMethod")) = "" Then
            Dim SQL As String
            Dim rsA As RemoteSet
            Dim pDate As Date
            Dim pPDate As Date

            SQL = "Select ICover.SI, b.pDate, b.PPDate"
            SQL = SQL & " from acceptance a"
            SQL = SQL & " Inner Join acceptance b on (b.OANO=a.OANO and b.ANO<a.ANO and b.pDate<b.PPdate)"
            SQL = SQL & " Cross Apply (Select sum(SI) as SI from ICover Where ICover.ANO=b.ANO and ICover.Adjustable=1 and ICover.TOI='" & TOI & "') ICover"
            SQL = SQL & " where a.ANO=" & ANO
            SQL = SQL & " and b.ANO>coalesce((Select c.ANO from Acceptance c Left join acceptance d on (d.pANO=c.ANO and d.AType='C') Where coalesce(d.ANO,0)=0 and c.AType='A' and c.OANO=a.OANO and c.ANO<a.ANO),0)"
            SQL = SQL & " Order By b.pDate, b.PPDate"

            Dim SI As Double = 0
            rsA = db.OpenRemoteSet(SQL)
            If Not rsA.Eof Then
                i = 1
                pDate = rsA.fields("PDate")
                Dim NumMonth As Integer = 0
                Do While Not rsA.Eof

                    Do While True
                        SI = toval(rsA.fields("SI"))
                        pPDate = rsA.fields("pPDate")
                        rsA.MoveNext()
                        If rsA.Eof OrElse SI <> toval(rsA.fields("SI")) Then Exit Do
                    Loop

                    j = DateDiff(DateInterval.Month, SDate, pPDate)
                    If DateDiff(DateInterval.Day, DateAdd(DateInterval.Month, j, SDate), pPDate) > 0 Then
                        j = j + 1
                    End If
                    j = j - NumMonth
                    If j > 0 Then
                        Dim Amt As Double
                        Amt = 0
                        Dim k As Integer
                        For k = 1 To j
                            rs = db.OpenQueryDef("QICoverDet", adOpenForwardonly, INO, i)
                            If Not rs.Eof Then
                                Do While Not rs.Eof
                                    If toval(rs.fields("UValue")) > Limit Then
                                        Amt = Amt + (toval(rs.fields("UValue")) - Limit) * toval(rs.fields("Qty"))
                                    End If
                                    rs.MoveNext()
                                Loop
                            Else
                                Amt = Amt + SI
                            End If
                            i = i + 1
                        Next k
                        Amount = Amount + Amt / j * DateDiff(DateInterval.Day, pDate, pPDate) / DateDiff(DateInterval.Day, SDate, EDate)

                        pDate = pPDate
                    End If
                    NumMonth = NumMonth + j
                Loop
            End If
        Else
            Amount = 0
            j = DateDiff(DateInterval.Month, SDate, EDate)
            If DateDiff(DateInterval.Day, DateAdd(DateInterval.Month, j, SDate), EDate) > 0 Then
                j = j + 1
            End If
            For i = 1 To j
                rs = db.OpenQueryDef("QICoverDet", adOpenForwardonly, INO, i)
                If Not rs.Eof Then
                    Do While Not rs.Eof
                        If toval(rs.fields("UValue")) > Limit Then
                            Amount = Amount + (toval(rs.fields("UValue")) - Limit) * toval(rs.fields("Qty"))
                        End If
                        rs.MoveNext()
                    Loop
                Else
                    If Method = "TOTAL" Then
                        Amount = Amount + toval(MaxAmount) / j
                    ElseIf Method = "AVERAGE" Then
                        Amount = Amount + toval(MaxAmount)
                    Else    ' Overlimit
                        ' Nothing
                    End If
                End If
            Next i
            If Method = "AVERAGE" Then Amount = Amount / j
        End If

        rsI = db.OpenQueryDef("QICover", adOpenKeyset, INO)
        If rsI.Eof Then Throw New Exception(db.ErrDesc)
        rsI.Edit()
        If Method = "TOTAL" Then
            rsI.fields("SI") = Amount
        ElseIf Method = "AVERAGE" Then
            rsI.fields("SI") = Amount
        Else    ' OverLimit
            rs = db.OpenQueryDef("QICoverExt", adOpenForwardonly, INO)
            If tostr(rs.fields("FLDTAG1")) = "Maximum Carrying" Then
                rsI.fields("SI") = Limit * toval(rs.fields("FLDVALUE1")) + Amount
            Else
                rsI.fields("SI") = Limit + Amount
            End If
        End If
        rsI.fields("SI_OC") = rsI.fields("SI") / rsI.fields("Rate_OC")
        If Not rsI.Update Then Throw New Exception(db.ErrDesc)

        AccIDeclaredValue = True
        Exit Function
errmsg:
        AccIDeclaredValue = False
    End Function
    Private Function Convert_FLDID_Into_Array(ByVal FLDID As String) As String()
        Dim SFLDID() As String
        Dim Separator As String

        If InStr(FLDID, "|") <> 0 Then
            Separator = "|"
        ElseIf InStr(FLDID, "/") <> 0 Then
            Separator = "/"
        Else
            Separator = ""
        End If
        Dim i As Integer
        i = 0
        Do While Separator <> ""
            ReDim Preserve SFLDID(i)

            SFLDID(i) = Trim(Mid(FLDID, 1, InStr(FLDID, Separator) - 1))

            FLDID = Mid(FLDID, InStr(FLDID, Separator) + 1, Len(FLDID))
            If InStr(FLDID, "|") <> 0 Then
                Separator = "|"
            ElseIf InStr(FLDID, "/") <> 0 Then
                Separator = "/"
            Else
                Separator = ""
            End If
            i = i + 1
        Loop
        ReDim Preserve SFLDID(i)
        SFLDID(i) = FLDID
        Convert_FLDID_Into_Array = SFLDID
    End Function

    Private Function Short_Period_Calc(ByVal TOC As String, ByVal SDate As Date, ByVal EDate As Date, ByVal PDate As Date) As Double
        If DateDiff(DateInterval.Month, SDate, DateAdd(DateInterval.Day, -1, EDate)) < 1 Then
            ' Short Period Policy
            Short_Period_Calc = Short_Period_Prorata(TOC, SDate, PDate, "D")
        Else
            Short_Period_Calc = Short_Period_Prorata(TOC, SDate, PDate, "M")
        End If
    End Function
    Private Function Short_Period_Prorata(ByVal TOC As String, ByVal SDate As Date, ByVal EDate As Date, ByVal Basis As String) As Double
        Dim rsP As RemoteSet
        Dim NOP As Double
        Dim Diff As Integer
        'M
        If Basis = "M" Then
            NOP = DateDiff(DateInterval.Month, SDate, EDate)

            Diff = DateDiff(DateInterval.Day, DateAdd(DateInterval.Month, NOP, SDate), EDate)
            NOP = NOP + Diff / 30
            rsP = db.OpenQueryDef("QPREMIUM_SCALE", adOpenForwardonly, TOC, "M", NOP)
            If Not rsP.Eof Then
                Short_Period_Prorata = rsP.fields("PCT")
            Else
                Short_Period_Prorata = 100
            End If
        Else
            NOP = DateDiff(DateInterval.Day, SDate, EDate)
            rsP = db.OpenQueryDef("QPREMIUM_SCALE", adOpenForwardonly, TOC, "D", NOP)
            If Not rsP.Eof Then
                Short_Period_Prorata = rsP.fields("PCT")
            Else
                Short_Period_Prorata = 100
            End If
        End If
    End Function
    Private Function Get_ValueID(ByVal FLDID As String, ByVal ValueDesc As String, ByVal PDate As Date, ByVal TOC As String, ByVal SEGMENT As String) As String
        Dim rs As RemoteSet
        Dim SQL As String
        On Error GoTo errmsg
        Dim AgeMethod As Integer
        Dim SubClassF As Boolean
        Dim SegmentF As Boolean
        Dim Formula As String
        rs = db.OpenRemoteSet("Select AgeMethod from TOC Where TOC='" & TOC & "'")
        AgeMethod = toval(rs.fields("AgeMethod"))
        rs = db.OpenRemoteSet("Select AgeMethod, SubClassF, SegmentF from GenHTab where FLDID='" & FLDID & "'")
        If Not rs.Eof Then
            If AgeMethod = -1 Then
                AgeMethod = rs.fields("AgeMethod")
            End If
            SubClassF = rs.fields("SubClassF")
            SegmentF = rs.fields("SegmentF")

            rs = db.OpenRemoteSet("Select Top 1 Formula from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "'")
            Formula = UCase(rs.fields("Formula"))
            Select Case Formula
                Case "AGE", "AGESTART"
                    ' First Formula
                    If IsDate(ValueDesc) Then
                        Dim age As Integer
                        age = get_Age(todate(ValueDesc), todate(PDate), AgeMethod)
                        SQL = "Select TOP 1 ValueID from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "' and Formula='" & Formula & "' and right(replicate('0',10)+'" & age & "',10) between right(replicate('0',10)+FLOWER,10) AND right(replicate('0',10)+FUPPER,10)"
                    Else
                        SQL = "Select TOP 1 ValueID from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "' and Formula='" & Formula & "' and right(replicate('0',10)+'" & Year(PDate) - toval(ValueDesc) & "',10) between right(replicate('0',10)+FLOWER,10) AND right(replicate('0',10)+FUPPER,10)"
                    End If
                    If SubClassF And TOC <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDTOC Where GenDTOC.FLDID='" & FLDID & "' and GenDTOC.ValueID=GenDTab.ValueID and (GenDTOC.TOC='<All>' or GenDTOC.TOC='" & TOC & "'))"
                    End If
                    If SegmentF And SEGMENT <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDSegment Where GenDSegment.FLDID='" & FLDID & "' and GenDSegment.ValueID=GenDTab.ValueID and (GenDSegment.Segment='<All>' or GenDSegment.Segment='" & SEGMENT & "'))"
                    End If
                    SQL = SQL & " Order By right(replicate('0',10)+FLOWER,10) Desc"
                    rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
                    Get_ValueID = tostr(rs.fields("ValueID"))
                Case "VALUE"
                    SQL = "Select TOP 1 ValueID from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "' and Formula='" & Formula & "' and cast('" & tovalSF(ValueDesc) & "' as Float) between Cast(FLOWER as Float) AND Cast(FUPPER as Float)"
                    If SubClassF And TOC <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDTOC Where GenDTOC.FLDID='" & FLDID & "' and GenDTOC.ValueID=GenDTab.ValueID and (GenDTOC.TOC='<All>' or GenDTOC.TOC='" & TOC & "'))"
                    End If
                    If SegmentF And SEGMENT <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDSegment Where GenDSegment.FLDID='" & FLDID & "' and GenDSegment.ValueID=GenDTab.ValueID and (GenDSegment.Segment='<All>' or GenDSegment.Segment='" & SEGMENT & "'))"
                    End If
                    SQL = SQL & " Order By Cast(FLOWER as Float) Desc"
                    rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
                    Get_ValueID = tostr(rs.fields("ValueID"))
                Case "VALUE$"
                    SQL = "Select TOP 1 ValueID from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "' and Formula='" & Formula & "' and '" & Trim(ValueDesc) & "' BETWEEN FLower and FUpper"
                    If SubClassF And TOC <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDTOC Where GenDTOC.FLDID='" & FLDID & "' and GenDTOC.ValueID=GenDTab.ValueID and (GenDTOC.TOC='<All>' or GenDTOC.TOC='" & TOC & "'))"
                    End If
                    If SegmentF And SEGMENT <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDSegment Where GenDSegment.FLDID='" & FLDID & "' and GenDSegment.ValueID=GenDTab.ValueID and (GenDSegment.Segment='<All>' or GenDSegment.Segment='" & SEGMENT & "'))"
                    End If
                    SQL = SQL & " Order By FLower Desc"
                    rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
                    Get_ValueID = tostr(rs.fields("ValueID"))
                Case Else
                    Get_ValueID = ""
            End Select
        Else
            Get_ValueID = ""
        End If
        Exit Function
errmsg:
        Get_ValueID = ""
    End Function

    Private Function get_Age(ByVal Birthdate As Date, ByVal ComparisonDate As Date, ByVal AgeMethod As Integer) As Integer
        Dim Temp As Integer = 0
        Try
            If ComparisonDate <= Birthdate Then
                Temp = 0
            Else
                Temp = DateDiff(DateInterval.Year, Birthdate, ComparisonDate)
                Select Case AgeMethod
                    Case 4  ' Nearest Birth Date by Month-Day
                        If DateAdd(DateInterval.Year, Temp, Birthdate) > ComparisonDate Then
                            Temp = Temp - 1
                        End If

                        If DateDiff(DateInterval.Month, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) = DateDiff(DateInterval.Month, ComparisonDate, DateAdd(DateInterval.Year, Temp + 1, Birthdate)) Then
                            If DateAdd(DateInterval.Month, DateDiff(DateInterval.Month, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate), DateAdd(DateInterval.Year, Temp, Birthdate)) < ComparisonDate Then
                                Temp = Temp + 1
                            End If
                        Else
                            If DateDiff(DateInterval.Month, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) > DateDiff(DateInterval.Month, ComparisonDate, DateAdd(DateInterval.Year, Temp + 1, Birthdate)) Then
                                Temp = Temp + 1
                            End If
                        End If
                    Case 3  ' Next Birth Day
                        If DateAdd(DateInterval.Year, Temp, Birthdate) > ComparisonDate Then
                            Temp = Temp - 1
                        End If
                        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) > 0 Then
                            Temp = Temp + 1
                        End If
                    Case 2  ' Nearest Birth Date by Day
                        If DateAdd(DateInterval.Year, Temp, Birthdate) > ComparisonDate Then
                            Temp = Temp - 1
                        End If
                        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) > DateDiff(DateInterval.Day, ComparisonDate, DateAdd(DateInterval.Year, Temp + 1, Birthdate)) Then
                            Temp = Temp + 1
                        End If
                    Case 1  ' Nearest Birth Date by Month
                        If DateAdd(DateInterval.Year, Temp, Birthdate) > ComparisonDate Then
                            Temp = Temp - 1
                        End If
                        If DateDiff(DateInterval.Month, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) > DateDiff(DateInterval.Month, ComparisonDate, DateAdd(DateInterval.Year, Temp + 1, Birthdate)) Then
                            Temp = Temp + 1
                        End If
                    Case Else   ' Years Lapse
                        If Temp > 0 Then
                            If Month(ComparisonDate) < Month(Birthdate) Or (Month(Birthdate) = Month(ComparisonDate) And ComparisonDate.Day < Birthdate.Day) Then
                                Temp = Temp - 1
                            End If
                        End If
                End Select

            End If

            Return Temp
        Catch ex As Exception
            Throw
        End Try
    End Function
