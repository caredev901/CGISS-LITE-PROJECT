                    End If
                ElseIf RefNo <> "" Then
                    SQL = SQL & " Select Top 1 A.ANO, A.LANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RefNo, A.PDate, A.SDate, A.EDate, A.TOC, C.PolicyType from Cover C, Acceptance A Where ((A.AType in ('N','E','C') And A.AStatus in ('I')) or (A.AType in ('N','E') And A.AStatus in ('W'))) and C.CNO=A.CNO and A.RefNo='" & RefNo & "' Order by A.ANO Desc"
                End If
                If SQL <> "" Then
                    rsTemp = db.OpenRemoteSet(SQL)
                    If Not rsTemp.Eof Then
                        ANO = rsTemp.fields("ANO")
                        TOC = rsTemp.fields("TOC")
                        SDate = rsTemp.fields("SDate")
                        EDate = rsTemp.fields("EDate")
                        Effective = rsTemp.fields("PDate")
                        PolicyNo = rsTemp.fields("PolicyNo")
                        CertificateNo = rsTemp.fields("CertificateNo")
                        M_TOC = rsTemp.fields("TOC")
                        M_PolicyType = rsTemp.fields("PolicyType")
