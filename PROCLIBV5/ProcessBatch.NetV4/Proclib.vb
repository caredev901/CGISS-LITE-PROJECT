        Period = toval(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_DURATION", Findex))))
        If tostr(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_FIRSTDUE", Findex)))) = "" Or Format(todate(GetFieldValue(FBuffer(GetFieldIndex("INSTALLMENT_FIRSTDUE", Findex)))).Date, "MM/DD/YYYY") = "01/01/1900" Then
