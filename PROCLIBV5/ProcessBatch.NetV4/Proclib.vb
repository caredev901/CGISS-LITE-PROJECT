            If (Fee_Currency_1 <> "" OrElse Fee_ID_1 <> "") And (Fee_Amount_1 <> 0 OrElse Fee_AmountPCT_1 <> 0) Then
                SQL = "Select top 1 F.FDID, Currency.Currency from FDTAB F "
                If Fee_Currency_1 <> "" Then
                    SQL = SQL & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Fee_Currency_1 & "' AND CURRENCY.ALLOWEDF=1)"
