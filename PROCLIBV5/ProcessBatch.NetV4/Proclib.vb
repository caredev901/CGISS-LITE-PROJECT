    Private Function Cancellation_Prorata_By_Refund(ByVal ANO As Long, ByRef PDate As Date, ByRef Refund As Double, Optional ByVal Prorata As Double = 0) As Double
        Dim rs As RemoteSet
        Dim PremiumTotal As Double
        Dim PremiumInforced As Double
        Dim PremiumNotYetInforced As Double
        Dim NumCCY As Integer
        Dim CCY As String

        Dim TOC As String
        Dim Branch As String
        Dim BizMapID As String
        Dim SDate As Date
        Dim SQL As String = ""

        rs = db.OpenRemoteSet("Select TOC, Branch, BizMapID from Acceptance Where ANO=" & ANO)
        TOC = rs.fields("TOC")
        Branch = rs.fields("Branch")
        BizMapID = rs.fields("BizMapID")

        NumCCY = 0
        CCY = ""

        SQL = ""
        SQL = SQL & "Declare @AsAt as smalldatetime"
        SQL = SQL & " Declare @ANO as Int"

        SQL = SQL & " Select @ANO=" & ANO
        SQL = SQL & " Select @Asat='" & Format(PDate, "MM/DD/YYYY") & "'"

        SQL = SQL & " Select Max(P.Currency) as Currency, "
        SQL = SQL & " Count (Distinct P.Currency) as NumCCY,"
        SQL = SQL & " sum(R.Gross/P.OGross*P.Gross) as PremiumTotal, "
        SQL = SQL & " sum(R.Gross/P.OGross*P.Gross*P.Rate) as PremiumTotalInBased, "
        SQL = SQL & " sum(case When Not ((DateDiff(Day, R.EDate, @AsAt) >= 0 or DateDiff(Day, @AsAt, R.SDate) > 0) and datediff(day,@AsAt,A.SDate)<=0 and datediff(day,@AsAt,A.EDate)>=0) then R.Gross/P.OGross*P.Gross else 0 end) as PremiumInforced,"
        SQL = SQL & " sum(case When Not ((DateDiff(Day, R.EDate, @AsAt) >= 0 or DateDiff(Day, @AsAt, R.SDate) > 0) and datediff(day,@AsAt,A.SDate)<=0 and datediff(day,@AsAt,A.EDate)>=0) then R.Gross/P.OGross*P.Gross*P.Rate else 0 end) as PremiumInforcedInBased,"
        SQL = SQL & " min(case When (DateDiff(Day, @AsAt, R.SDate) > 0 and datediff(day,@AsAt,A.SDate)<=0 and datediff(day,@AsAt,A.EDate)>=0) then R.SDate else Null end) as SDate,"
        SQL = SQL & " sum(case When (DateDiff(Day, @AsAt, R.SDate) > 0 and datediff(day,@AsAt,A.SDate)<=0 and datediff(day,@AsAt,A.EDate)>=0) then R.Gross/P.OGross*P.Gross else 0 end) as PremiumNotYetInforced,"
        SQL = SQL & " sum(case When (DateDiff(Day, @AsAt, R.SDate) > 0 and datediff(day,@AsAt,A.SDate)<=0 and datediff(day,@AsAt,A.EDate)>=0) then R.Gross/P.OGross*P.Gross*P.Rate else 0 end) as PremiumNotYetInforcedInBased"
        SQL = SQL & " from RCalc R, PCalc P, Acceptance A "
        SQL = SQL & " Where P.ANO = R.ANO and A.ANO=R.ANO And P.Currency = R.Currency and R.ANO=@ANO"

        rs = db.OpenRemoteSet(SQL)
        If NumCCY = 0 Then NumCCY = toval(rs.fields("NumCCY"))
        If NumCCY <= 1 Then
            PremiumTotal = toval(rs.fields("PremiumTotal"))
            PremiumInforced = toval(rs.fields("PremiumInforced"))
            PremiumNotYetInforced = toval(rs.fields("PremiumNotYetInforced"))
        Else
            PremiumTotal = toval(rs.fields("PremiumTotalInBased"))
            PremiumInforced = toval(rs.fields("PremiumInforcedInBased"))
            PremiumNotYetInforced = toval(rs.fields("PremiumNotYetInforcedInBased"))
        End If
        If CCY = "" Then CCY = tostr(rs.fields("Currency"))
        SDate = todate(rs.fields("SDate"))

        ' Minimum Retained Premium
        Dim MRPremium As Double
        If NumCCY <= 1 Then
            rs = db.OpenRemoteSet("Select Top 1 B.MRPremium from BRRuleMin B, SysTab S Where B.TOC='" & TOC & "' and (B.Branch='<All>' or B.Branch='" & Branch & "') and (B.BizMapID='<All>' or B.BizMapID='" & BizMapID & "') and B.Currency='" & CCY & "' Order By B.MRPremium")
            MRPremium = toval(rs.fields("MRPremium"))
        Else
            rs = db.OpenRemoteSet("Select Top 1 B.MRPremium from BRRuleMin B, SysTab S Where B.TOC='" & TOC & "' and (B.Branch='<All>' or B.Branch='" & Branch & "') and (B.BizMapID='<All>' or B.BizMapID='" & BizMapID & "') and B.Currency=S.Currency Order By B.MRPremium")
            MRPremium = toval(rs.fields("MRPremium"))
        End If

        If PremiumInforced <> 0 Then

            If Prorata <> 0 AndAlso Refund = 0 Then
                Refund = Prorata / 100 * PremiumInforced + PremiumNotYetInforced
            End If

            ' Compare with Minimum Retained Premium and Premium Total
            If PremiumTotal - MRPremium < Refund Then
                Refund = PremiumTotal - MRPremium
            End If

            'If (Refund - PremiumNotYetInforced) < 0 Then
            '    Refund = PremiumNotYetInforced
            'End If

            Prorata = (Refund - PremiumNotYetInforced) / PremiumInforced * 100
        Else
            Refund = 0
            Prorata = 0
        End If
        If Prorata = 0 Then PDate = SDate
        Cancellation_Prorata_By_Refund = Prorata
    End Function

    Private Function PutAccRegAmount(ByVal REGID As String, ByVal FLDID As String, ByVal VALUEID As String, ByVal RYear As Integer, ByVal RType As String, ByVal Amount As Double, ByVal TSI As Double) As Long
        Dim rs As RemoteSet

        On Error GoTo errmsg
        rs = db.OpenQueryDef("QACCREGDET", adOpenKeyset, REGID, FLDID, VALUEID, RYear, RType)
        If rs.Eof Then
            rs.AddNew()
            rs.fields("REGID") = REGID
            rs.fields("FLDID") = FLDID
            rs.fields("VALUEID") = VALUEID
            rs.fields("RTYPE") = RType
            rs.fields("RYear") = RYear
            rs.fields("RegNo") = db.GetIdentity("ACCREGDET") + 1
        Else
            rs.Edit()
        End If
        rs.fields("AMOUNT") = toval(rs.fields("AMOUNT")) + Amount
        rs.fields("TSI") = toval(rs.fields("TSI")) + TSI
        rs.fields("NRisk") = toval(rs.fields("NRisk")) + 1
        If toval(rs.fields("NRisk")) > 1 Then
            rs.fields("ReAllocF") = True
        Else
            rs.fields("ReAllocF") = False
        End If
        If Not rs.Update Then GoTo errmsg
        PutAccRegAmount = toval(rs.fields("RegNo"))
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        PutAccRegAmount = -1
    End Function
    Private Function GetAccRegAmount(ByVal REGID As String, ByVal FLDID As String, ByVal VALUEID As String, ByVal RYear As Integer, ByVal RType As String, ByVal Amount As Double, ByVal TSI As Double) As Long
        Dim rs As RemoteSet
        On Error GoTo errmsg
        rs = db.OpenQueryDef("QACCREGDET", adOpenKeyset, REGID, FLDID, VALUEID, RYear, RType)
        If Not rs.Eof Then
            rs.Edit()
            rs.fields("AMOUNT") = toval(rs.fields("AMOUNT")) - Amount
            rs.fields("TSI") = toval(rs.fields("TSI")) - TSI
            rs.fields("NRisk") = toval(rs.fields("NRisk")) - 1
            If toval(rs.fields("NRisk")) > 0 Then
                rs.fields("ReAllocF") = True
            Else
                rs.fields("ReAllocF") = False
            End If
            If Not rs.Update Then GoTo errmsg
        End If
        GetAccRegAmount = -1
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        GetAccRegAmount = 0
    End Function
    Private Function ReleaseAccRegAmount(ByVal ANO As Long, ByVal PreviousF As Boolean) As Boolean
        Dim rs As RemoteSet
        Dim Amount As Double
        Dim TAmount As Double
        Dim REGID As String
        Dim FLDID As String
        Dim VALUEID As String
        Dim AType As String
        Dim AStatus As String
        Dim pANO As Long
        Dim RegNo As Long
        Dim RYear As Integer

        On Error GoTo errmsg
        Dim NoRiskAccumulationF As Boolean

        rs = db.OpenQueryDef("QACCREG", adOpenForwardonly, ANO)
        REGID = tostr(rs.fields("REGID"))
        FLDID = tostr(rs.fields("FLDID"))
        VALUEID = tostr(rs.fields("ValueID"))
        AType = tostr(rs.fields("AType"))
        AStatus = tostr(rs.fields("AStatus"))
        pANO = toval(rs.fields("pANO"))
        RYear = toval(rs.fields("RYEAR"))

        NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
        rs.CloseRemoteSet()

        If (AStatus = "W" Or AStatus = "T") And pANO <> -1 And PreviousF Then
            If Not UnReleaseAccRegAmount(pANO, False) Then GoTo errmsg
        End If

        If Not NoRiskAccumulationF Then
            Dim PctShare As Double
            Dim MShare As Double
            Dim PCTLOSS As Double

            rs = db.OpenQueryDef("QRARRHEADER", adOpenKeyset, ANO)
            If tostr(rs.fields("Status")) = "R" And AType <> "C" And AType <> "A" Then
                PctShare = rs.fields("PCTShare")
                MShare = rs.fields("MShare")
                PCTLOSS = rs.fields("PCTLOSS")
                rs.Edit()
                If FLDID <> "" And VALUEID <> "" Then
                    TAmount = toval(rs.fields("TAmount"))

                    ' Compulsory
                    Amount = toval(rs.fields("CAMOUNT") - toval(rs.fields("CCAMOUNT")))
                    If tostr(rs.fields("CID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "C", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("CRegNo") = RegNo
                    End If

                    ' Excess Priority/MaiPark
                    Amount = toval(rs.fields("XPAMOUNT")) - toval(rs.fields("CXPAMOUNT"))
                    If tostr(rs.fields("XPID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "XP", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("XPRegNo") = RegNo
                    End If

                    ' Decree
                    Amount = toval(rs.fields("DAMOUNT") - toval(rs.fields("CDAMOUNT")))
                    If tostr(rs.fields("DID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "D", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("DRegNo") = RegNo
                    End If

                    ' Quota Share
                    Amount = toval(rs.fields("QAMOUNT") + toval(rs.fields("QSRAMOUNT")) - toval(rs.fields("CQAMOUNT")))
                    If rs.fields("QID") <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "Q", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("QRegNo") = RegNo
                    End If

                    ' 1st Surplus
                    Amount = toval(rs.fields("SP1AMOUNT")) - toval(rs.fields("CSP1AMOUNT"))
                    If tostr(rs.fields("SP1ID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "S1", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("SP1RegNo") = RegNo
                    End If

                    ' 2nd Surplus
                    Amount = toval(rs.fields("SP2AMOUNT")) - toval(rs.fields("CSP2AMOUNT"))
                    If tostr(rs.fields("SP2ID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "S2", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("SP2RegNo") = RegNo
                    End If

                    ' 3rd Surplus
                    Amount = toval(rs.fields("SP3AMOUNT")) - toval(rs.fields("CSP3AMOUNT"))
                    If tostr(rs.fields("SP3ID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "S3", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("SP3RegNo") = RegNo
                    End If

                    ' Auto Facultative
                    Amount = toval(rs.fields("AAMOUNT") + toval(rs.fields("AFRAMOUNT")) - toval(rs.fields("CAAMOUNT")))
                    If tostr(rs.fields("AID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "A", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("ARegNo") = RegNo
                    End If
                End If

                rs.fields("Status") = "A"
                If Not rs.Update Then GoTo errmsg

                rs.CloseRemoteSet()

                ' Also Update Cover Limit
                'Set rs = db.OpenRemoteSet("select Cover.*, PCalc.Rate from Cover, Acceptance, PCALC where Cover.CNO=Acceptance.CNO and PCALC.ANO=Acceptance.ANO and Acceptance.ANO=" & ANO)
                'If Not rs.EOF Then
                '   TAmount = TAmount / toval(rs.fields("Rate"))
                'End If
            End If
        End If

        ReleaseAccRegAmount = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        ReleaseAccRegAmount = False
    End Function

    Private Function UnReleaseAccRegAmount(ByVal ANO As Long, ByVal PreviousF As Boolean) As Boolean
        Dim rs As RemoteSet
        Dim Amount As Double
        Dim TAmount As Double
        Dim REGID As String
        Dim FLDID As String
        Dim VALUEID As String
        Dim AType As String
        Dim AStatus As String
        Dim pANO As Long
