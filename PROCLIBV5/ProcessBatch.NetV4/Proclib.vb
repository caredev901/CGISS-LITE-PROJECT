                If Not PreEndorseConditionsOK(ANO, Effective_Date, EndorseAllF, App_Source, ExternalF, StrMsg) Then
                    GoTo errmsg
                End If
            End If
            Dim tParam(17) As Object
            tParam(0) = ""
            tParam(1) = BookingDate
            tParam(2) = Effective_Date
            tParam(3) = IIf(EMethod = "", "U", EMethod)
            tParam(4) = LANO
            tParam(5) = Remarks
            tParam(6) = CPercentage
            tParam(7) = Memo
            tParam(8) = ExternalF
            tParam(9) = Refno
            tParam(10) = RefDate
            tParam(11) = NoAddRefundF
            tParam(12) = Wording
            tParam(13) = EndorseAllF
            tParam(14) = App_Source
            tParam(15) = ""
            tParam(16) = Reason
            tParam(17) = AdjustFacultativePeriodF

            If ANO = LANO Then  ' Master Policy
                If AStatus = "I" Then
                    NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.PROCLIB", "EndorseMaster", ANO, tParam, , , )
                    If NewANO = 0 Then
                        StrMsg = "Process : Endorse Master Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                Else
                    NewANO = ANO
                End If

                If EndorseAllF Then
                    If Not db.Execute("Update Acceptance Set BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "'  Where LANO=" & NewANO) Then
                        StrMsg = "Process : Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                Else
                    If Not db.Execute("Update Acceptance Set BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "'  Where ANO=" & NewANO) Then
                        StrMsg = "Process : Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                End If
            ElseIf ANO <> LANO And Not OpenFlag And LANO <> -1 Then ' Detail Fleet
                ' Check Master Policy
                rsTemp = db.OpenRemoteSet("Select top 1 CNO, ANO, AStatus, Atype, RegNo, SDate, EDate, PDate from Acceptance A where A.AStatus in ('I','W') and A.AType not in ('A','C') and A.ANO=" & LANO & " and Not Exists (Select PANO from Acceptance pA Where pA.AType not in ('A') and pA.pANO=A.ANO)")
                If rsTemp.Eof Then
                    rsTemp = db.OpenRemoteSet("Select top 1 CNO, ANO, AStatus, Atype, RegNo, SDate, EDate, PDate from Acceptance A where A.AStatus='W' and A.AType not in ('A','C') and A.PANO=" & LANO)
                    If rsTemp.Eof Then
                        StrMsg = "Master Policy (" & PolicyNo & ") is not Found !" & vbCrLf
                        GoTo errmsg
                    End If
                End If
                CNO = rsTemp.fields("CNO")
                LANO = rsTemp.fields("ANO")
                M_AStatus = rsTemp.fields("AStatus")
                M_AType = rsTemp.fields("AType")
                M_RegNo = rsTemp.fields("RegNo")
                M_SDate = rsTemp.fields("SDate")
                M_EDate = rsTemp.fields("EDate")
                M_PDate = rsTemp.fields("PDate")
                If M_AType <> "A" And M_AStatus = "I" Then
                    tParam(2) = M_PDate
                    tParam(13) = False
                    NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.PROCLIB", "EndorseMaster", LANO, tParam, , , )
                    If NewANO = 0 Then
                        StrMsg = "Process : Endorse Master Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If

                    ' Get New master RegNo, AType, and Status
                    rsTemp = db.OpenRemoteSet("Select AType, AStatus, RegNo from acceptance where ano = " & NewANO)
                    If Not rsTemp.Eof Then
                        M_AStatus = rsTemp.fields("AStatus")
                        M_AType = rsTemp.fields("AType")
                        M_RegNo = rsTemp.fields("RegNo")
                        tParam(0) = M_RegNo
                    End If

                    If Not db.Execute("Update Acceptance Set BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "' Where ANO=" & NewANO) Then
                        StrMsg = "Process : Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If

                    tParam(2) = Effective_Date
                    tParam(4) = NewANO

                    If AStatus = "I" Then
                        NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.PROCLIB", "Endorsement", ANO, tParam)
                        If NewANO = 0 Then
                            StrMsg = "Process : Endorse Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    Else
                        NewANO = ANO
                    End If

                    If Not db.Execute("Update Acceptance Set COCNO='" & COCNO & "', SecurityNo='" & SecurityNo & "', BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "'  Where ANO=" & NewANO) Then
                        StrMsg = "Process : Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                Else
                    tParam(0) = M_RegNo
                    tParam(4) = LANO

                    If AStatus = "I" Then
                        NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.PROCLIB", "Endorsement", ANO, tParam)
                        If NewANO = 0 Then
                            StrMsg = "Process : Endorse Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                            GoTo errmsg
                        End If
                    Else
                        NewANO = ANO
                    End If

                    If Not db.Execute("Update Acceptance Set COCNO='" & COCNO & "', SecurityNo='" & SecurityNo & "', BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "'  Where ANO=" & NewANO) Then
                        StrMsg = "Process : Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                End If
            Else    ' Individual or Detail Open Cover
                ' Check Master Policy
                If LANO <> -1 Then
                    rsTemp = db.OpenRemoteSet("Select top 1 CNO, ANO, AStatus, Atype, RegNo, SDate, EDate, PDate from Acceptance A where A.AStatus='I' and A.ANO=" & LANO)
                    If rsTemp.Eof Then
                        StrMsg = "Master Policy (" & PolicyNo & ") is not Found !" & vbCrLf
                        GoTo errmsg
                    End If
                    CNO = rsTemp.fields("CNO")
                    LANO = rsTemp.fields("ANO")
                    M_AStatus = rsTemp.fields("AStatus")
                    M_AType = rsTemp.fields("AType")
                    M_RegNo = rsTemp.fields("RegNo")
                    M_SDate = rsTemp.fields("SDate")
                    M_EDate = rsTemp.fields("EDate")
                    M_PDate = rsTemp.fields("PDate")
                    tParam(0) = M_RegNo
                End If

                If AStatus = "I" Then
                    NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.PROCLIB", "Endorsement", ANO, tParam)
                    If NewANO = 0 Then
                        StrMsg = "Process : Endorse Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If
                Else
                    NewANO = ANO
                End If

                If Not db.Execute("Update Acceptance Set COCNO='" & COCNO & "', SecurityNo='" & SecurityNo & "', BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "'  Where ANO=" & NewANO) Then
                    StrMsg = "Process : Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                    GoTo errmsg
                End If
            End If

            If ANO <> LANO And LANO <> -1 Then
                rs = db.OpenQueryDef("QCertificate_Data", adOpenKeyset, NewANO)
            Else
                rs = db.OpenQueryDef("QPolicy_Data", adOpenKeyset, NewANO)
            End If
            If rs.Eof Then
                StrMsg = "Policy (" & PolicyNo & ") is not Found !" & vbCrLf
                GoTo errmsg
            End If

            ANO = rs.fields("ANO")
            LANO = rs.fields("LANO")
            CNO = rs.fields("CNO")
            OANO = rs.fields("OANO")
            NCDate = rs.fields("NCDate")
            SysUserID = rs.fields("SysUserID")
            ExclusiveF = toval(rs.fields("ExclusiveF"))
            ISType = rs.fields("ISType")
            PolicyType = rs.fields("PolicyType")
            CT = rs.fields("CT")

            If (ANO = LANO Or LANO = -1) Then
                If App_Source = "MKT" OrElse (AStatus = "W" AndAlso AType = "N") Then
                    If PPeriod = 0 Then PPeriod = rs.fields("PPeriod")
                    If Prorata = 0 Then Prorata = rs.fields("Prorata")

                    Dim HolderAddress As String
                    HolderAddress = HolderAddress_1 & vbCrLf & HolderAddress_2 & vbCrLf & HolderAddress_3

                    If HolderID <> "" And HolderName = "" Then
                        SQL = "Select ID from Profile P1 where ID = '" & HolderID & "' or name = '" & HolderID & "'"
                    ElseIf HolderID <> "" Then
                        SQL = "Select ID from Profile P1 where ID = '" & HolderID & "'"
                    ElseIf HolderName <> "" Then
                        SQL = "Select ID from Profile P1 where Name= '" & HolderName & "' and P1.Address_1+char(13)+char(10)+P1.Address_2+char(13)+char(10)+P1.Address_3 Like '" & HolderAddress & "%' order by ID Desc"
                    Else
                        SQL = ""
                    End If

                    If SQL <> "" Then
                        rsTemp = db.OpenRemoteSet(SQL, adOpenForwardonly)
                        HolderID = rsTemp.fields("ID")
                    Else
                        HolderID = ""
                    End If

                Else
                    PPeriod = rs.fields("PPeriod")
                    Prorata = rs.fields("Prorata")
                    HolderID = ""
                End If
            End If

            findex_policy = rs.fields_index()
            fbuffer_policy = rs.GetRecord()

            ' Get Information
            Dim SDate As Date
            Dim EDate As Date
            Dim PSDate As Date
            Dim PEDate As Date

            RegNo = tostr(GetFieldValue(fbuffer_policy(GetFieldIndex("RegNo", findex_policy))))
            PSDate = todate(GetFieldValue(fbuffer_policy(GetFieldIndex("SDate", findex_policy))))
            PEDate = todate(GetFieldValue(fbuffer_policy(GetFieldIndex("EDate", findex_policy))))
            SDate = Inception
            EDate = Expiry
            BankersID = tostr(GetFieldValue(fbuffer_policy(GetFieldIndex("BankersID", findex_policy))))
            BankersClause = tostr(GetFieldValue(fbuffer_policy(GetFieldIndex("BankersClause", findex_policy))))
            If NewBankersClause = "" Then
                NewBankersClause = BankersClause
            End If
            If NewBankersID = "" Then
                NewBankersID = BankersID
            End If
            If Branch = "" Then
                Branch = tostr(GetFieldValue(fbuffer_policy(GetFieldIndex("Branch", findex_policy))))
            End If
            If MSCode = "" Then
                MSCode = tostr(GetFieldValue(fbuffer_policy(GetFieldIndex("MSCode", findex_policy))))
            End If
            If BizMapID = "" Then
                BizMapID = tostr(GetFieldValue(fbuffer_policy(GetFieldIndex("BizMapID", findex_policy))))
            End If

            If EMethod = "" Or EMethod = "U" Or EMethod = "S" Then
                Dim rsTOC As RemoteSet
                Dim FLDID As String
                Dim ValueID As String = ""
                Dim ValueDesc As String = ""
                Dim IAccReg As Long
                Dim REGID As String = ""
                Dim sFLDID As String = ""
                Dim sValueID As String = ""
                Dim sValueDesc As String = ""

                Dim ResetPremiumCalcF As Boolean = False

                Dim pAddress As String = ""
                If Address_1 <> "" OrElse Address_2 <> "" OrElse Address_3 <> "" Then
                    pAddress = Address_1 & vbCrLf & Address_2 & vbCrLf & Address_3
                End If

                If ID_No <> "" Then
                    SQL = "Select Top 1 P1.ID from Profile P1 Left Join Profile_Ext P2 on (P2.ID=P1.ID) where (P2.ID_No='" & ID_No & "')"
                ElseIf EMAIL <> "" Then
                    SQL = "Select Top 1 P1.ID from Profile P1 Left Join Profile_Ext P2 on (P2.ID=P1.ID) where (P1.Name = '" & InsuredName & "' and P1.Email='" & EMAIL & "')"
                ElseIf BirthDate <> "" Then
                    SQL = "Select Top 1 P1.ID from Profile P1 Left Join Profile_Ext P2 on (P2.ID=P1.ID) where (P1.Name = '" & InsuredName & "' and P2.BirthDate = '" & Format(todate(BirthDate), "MM/DD/YYYY") & "' and P2.Gender Like '" & Gender & "%')"
                ElseIf InsuredID <> "" And InsuredName = "" Then
                    SQL = "Select Top 1 P1.ID from Profile P1 Left Join Profile_Ext P2 on (P2.ID=P1.ID) where (P1.ID = '" & InsuredID & "' or P1.name = '" & InsuredID & "')"
                ElseIf InsuredID <> "" Then
                    SQL = "Select Top 1 P1.ID from Profile P1 Left Join Profile_Ext P2 on (P2.ID=P1.ID) where (P1.ID = '" & InsuredID & "')"
                ElseIf InsuredName <> "" And pAddress <> "" Then
                    SQL = "Select Top 1 P1.ID from Profile P1 Left Join Profile_Ext P2 on (P2.ID=P1.ID) where (P1.Name= '" & InsuredName & "' and P1.Address_1+char(13)+char(10)+P1.Address_2+char(13)+char(10)+P1.Address_3 Like '" & pAddress & "%')"
                Else
                    SQL = ""
                End If

                If SQL <> "" Then
                    rsTemp = db.OpenRemoteSet(SQL, adOpenForwardonly)
                    If Not rsTemp.Eof Then InsuredID = rsTemp.fields("ID")

                    Dim ConsentIDAgreeD(ConsentIDAgreedCount - 1) As String
                    For X = 0 To ConsentIDAgreedCount - 1
                        ConsentIDAgreeD(X) = GetFieldValue(FBuffer(GetFieldIndex("ConsentID" & X + 1, Findex)))
                    Next

                    If (CreateProfileF Or InsuredID <> "") And InsuredName <> "" And pAddress <> "" Then
                        InsuredID = Create_Profile(InsuredfName, InsuredmName, InsuredlName, InsuredName, Address_1, Branch, "D", DumpProfileF, InsuredID, False, False, "", TAXID, TAXNAME, TAXADDRESS, CorporateF, "", Phone_1, Mobile_1, EMAIL, BirthDate, Address_2, Address_3, "", "", Gender, ID_No, ID_Name, ID_Type, City, Country, Area, Fax_1, Employment, LOB, Purpose, Income, OtherIncome, ZipCode, Province, BirthPlace, WNIF, Citizen, PassPortNo, CGroup, ProfileRemark, ProfileRedFlag, ProfileConsentOnDataKeepByCompanyF, ProfileConsentOnDataPrivacyToThirdPartyF, ProfileConsentOnDataKeepByCompanyF, ProfileConsentOnDataPrivacyToThirdPartyF, ProfileConsentOnProductAndServiceOfferingF, ProfileCAddress, ProfileCPhone_1, ProfileMarital, ProfileMothersName, xProfileID, ConsentIDAgreeD)
                    End If
                    If InsuredID = "" Then
                        StrMsg = "Can't Find Insured Profile !"
                        GoTo errmsg
                    End If
                Else
                    InsuredID = rs.fields("AID")
                    InsuredName = rs.fields("AName")
                End If

                rsTemp = db.OpenRemoteSet("Select PolicyType, Description, SType, Prefix from PolicyType where PolicyType = '" & PolicyType & "'")
                If Not rsTemp.Eof Then SType = rsTemp.fields("SType")

                Dim BlanketTypeVer As Integer
                ' Object Info and Accumulation Register
                rsTOC = db.OpenQueryDef("QTOC_GENHTAB", adOpenKeyset, TOC)
                TOC_Description = tostr(rsTOC.fields("Description"))
                IAccReg = toval(rsTOC.fields("IAccReg"))
                REGID = tostr(rsTOC.fields("RegID"))
                BlanketTypeVer = toval(rsTOC.fields("BlanketTypeVer"))
                sFLDID = ""
                sValueID = ""
                sValueDesc = ""

                For X = 1 To 15
                    FLDID = rsTOC.fields("FLDID" & X)
                    If FLDID <> "" Then
                        fbuffer_policy(GetFieldIndex("FLDID" & X, findex_policy)) = SetFieldValue(FLDID)
                        fbuffer_policy(GetFieldIndex("FLDSEARCH" & X, findex_policy)) = SetFieldValue(toval(rsTOC.fields("FLDSEARCH" & X)))
                        ValueDesc = Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("DESCRIPTION" & X, Findex)))))
                        ValueID = Trim(tostr(GetFieldValue(FBuffer(GetFieldIndex("OBJ_INFO_" & Format(X, "00"), Findex)))))
                        fbuffer_policy(GetFieldIndex("VALUEID" & X, findex_policy)) = SetFieldValue(ValueID)
                        fbuffer_policy(GetFieldIndex("VALUEDESC" & X, findex_policy)) = SetFieldValue(ValueDesc)

                        If AccRegisterFlag(IAccReg, X) Then
                            If sFLDID = "" Then
                                sFLDID = FLDID
                                sValueDesc = GetFieldValue(fbuffer_policy(GetFieldIndex("VALUEDESC" & X, findex_policy)))
                                If toval(rsTOC.fields("FLDTAB" & X)) Then
                                    sValueID = GetFieldValue(fbuffer_policy(GetFieldIndex("VALUEID" & X, findex_policy)))
                                Else
                                    sValueID = GetFieldValue(fbuffer_policy(GetFieldIndex("VALUEDESC" & X, findex_policy)))
                                End If
                            Else
                                sFLDID = sFLDID + "|" + FLDID
                                sValueDesc = sValueDesc + "|" + GetFieldValue(fbuffer_policy(GetFieldIndex("VALUEDESC" & X, findex_policy)))
                                If toval(rsTOC.fields("FLDTAB" & X)) Then
                                    sValueID = sValueID + "|" + GetFieldValue(fbuffer_policy(GetFieldIndex("VALUEID" & X, findex_policy)))
                                Else
                                    sValueID = sValueID + "|" + GetFieldValue(fbuffer_policy(GetFieldIndex("VALUEDESC" & X, findex_policy)))
                                End If
                            End If
                        End If
                    Else
                        fbuffer_policy(GetFieldIndex("FLDID" & X, findex_policy)) = SetFieldValue("")
                        fbuffer_policy(GetFieldIndex("VALUEID" & X, findex_policy)) = SetFieldValue("")
                        fbuffer_policy(GetFieldIndex("VALUEDESC" & X, findex_policy)) = SetFieldValue("")
                        fbuffer_policy(GetFieldIndex("FLDSEARCH" & X, findex_policy)) = SetFieldValue(False)
                    End If
                Next

                If ANO = LANO Or LANO = -1 Then
                    fbuffer_policy(GetFieldIndex("Branch", findex_policy)) = SetFieldValue(Branch)
                    fbuffer_policy(GetFieldIndex("SDate", findex_policy)) = SetFieldValue(todate(Inception))
                    fbuffer_policy(GetFieldIndex("EDate", findex_policy)) = SetFieldValue(todate(Expiry))
                    fbuffer_policy(GetFieldIndex("ExtPeriod", findex_policy)) = SetFieldValue(ExtPeriod)
                    fbuffer_policy(GetFieldIndex("EXTPERIODINDAYSF", findex_policy)) = SetFieldValue(EXTPERIODINDAYSF)
                    fbuffer_policy(GetFieldIndex("AID", findex_policy)) = SetFieldValue(tostr(InsuredID))
                    fbuffer_policy(GetFieldIndex("AName", findex_policy)) = SetFieldValue(tostr(InsuredName))
                    fbuffer_policy(GetFieldIndex("Ujroh", findex_policy)) = IIf(Ujroh = 0, SetFieldValue(toval(rs.fields("Ujroh"))), SetFieldValue(Ujroh))
                    fbuffer_policy(GetFieldIndex("BatchNo", findex_policy)) = SetFieldValue(BatchNo)
                    fbuffer_policy(GetFieldIndex("BankersID", findex_policy)) = SetFieldValue(NewBankersID)
                    fbuffer_policy(GetFieldIndex("BankersClause", findex_policy)) = SetFieldValue(NewBankersClause)
                    fbuffer_policy(GetFieldIndex("MSCode", findex_policy)) = SetFieldValue(MSCode)
                    fbuffer_policy(GetFieldIndex("BizMapID", findex_policy)) = SetFieldValue(BizMapID)
                    fbuffer_policy(GetFieldIndex("BID", findex_policy)) = SetFieldValue(BID)
                    fbuffer_policy(GetFieldIndex("PPeriod", findex_policy)) = SetFieldValue(PPeriod)
                    fbuffer_policy(GetFieldIndex("Prorata", findex_policy)) = SetFieldValue(Prorata)

                    If App_Source = "MKT" OrElse (AStatus = "W" AndAlso AType = "N") Then
                        If HolderID <> "" Then
                            fbuffer_policy(GetFieldIndex("PHolder", findex_policy)) = SetFieldValue(HolderID)
                        End If
                        If Segment <> "" Then
                            fbuffer_policy(GetFieldIndex("Segment", findex_policy)) = SetFieldValue(Segment)
                        End If
                        If MO <> "" Then
                            fbuffer_policy(GetFieldIndex("MO", findex_policy)) = SetFieldValue(MO)
                        End If
                        If CRefNo <> "" Then
                            fbuffer_policy(GetFieldIndex("CRefNo", findex_policy)) = SetFieldValue(CRefNo)
                        End If
                    End If

                    Dim InParam(25) As Object
                    InParam(0) = CNO
                    InParam(1) = ANO
                    InParam(2) = toval(rs.fields("CANO"))
                    InParam(3) = LANO
                    InParam(4) = -1
                    InParam(5) = PolicyType
                    InParam(6) = tostr(rs.fields("TOC"))
                    InParam(7) = toval(rs.fields("Voyage"))
                    InParam(8) = ISType
                    InParam(9) = toval(rs.fields("ReinstatementF"))
                    InParam(10) = SType
                    InParam(11) = False
                    InParam(12) = toval(rs.fields("PPeriod"))
                    InParam(13) = IIf(OverWrite_RenewableF, RenewableF, toval(rs.fields("RENEWABLEF")))
                    InParam(14) = toval(rs.fields("WPC"))
                    InParam(15) = False
                    InParam(16) = False
                    InParam(17) = False
                    InParam(18) = tostr(REGID)
                    InParam(19) = tostr(sFLDID)
                    InParam(20) = tostr(sValueID)
                    InParam(21) = tostr(sValueDesc)
                    InParam(22) = -1
                    InParam(23) = AdjustFacultativePeriodF
                    InParam(25) = KeepExistingF

                    NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.Proclib", "SAVE_POLICY_DATA", InParam, findex_policy, fbuffer_policy)
                    If NewANO = 0 Then
                        StrMsg = "Process : Save Policy Data Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                        GoTo errmsg
                    End If

                    If IsDate(GetFieldValue(FBuffer(GetFieldIndex("NCDate", Findex)))) And Format(todate(GetFieldValue(FBuffer(GetFieldIndex("NCDate", Findex)))), "MM/DD/YYYY") <> "01/01/1900" Then
                        NCDate = todate(GetFieldValue(FBuffer(GetFieldIndex("NCDate", Findex))))
                    End If

                    If tostr(GetFieldValue(FBuffer(GetFieldIndex("SysUserID", Findex)))) <> "" Then
                        SysUserID = tostr(GetFieldValue(FBuffer(GetFieldIndex("SysUserID", Findex))))
                    End If

                    If Not db.Execute("Update Acceptance Set NCDate = '" & Format(NCDate, "MM/DD/YYYY") & "', SysUserID = '" & SysUserID & "' Where ANO=" & NewANO) Then GoTo errmsg

                Else
                    fbuffer_policy(GetFieldIndex("Branch", findex_policy)) = SetFieldValue(Branch)
                    fbuffer_policy(GetFieldIndex("SDate", findex_policy)) = SetFieldValue(todate(Inception))
                    fbuffer_policy(GetFieldIndex("EDate", findex_policy)) = SetFieldValue(todate(Expiry))
                    fbuffer_policy(GetFieldIndex("ExtPeriod", findex_policy)) = SetFieldValue(ExtPeriod)
                    fbuffer_policy(GetFieldIndex("EXTPERIODINDAYSF", findex_policy)) = SetFieldValue(EXTPERIODINDAYSF)
                    fbuffer_policy(GetFieldIndex("AID", findex_policy)) = SetFieldValue(tostr(InsuredID))
                    fbuffer_policy(GetFieldIndex("AName", findex_policy)) = SetFieldValue(tostr(InsuredName))
                    fbuffer_policy(GetFieldIndex("Ujroh", findex_policy)) = IIf(Ujroh = 0, SetFieldValue(toval(rs.fields("Ujroh"))), SetFieldValue(Ujroh))
                    fbuffer_policy(GetFieldIndex("BatchNo", findex_policy)) = SetFieldValue(BatchNo)
                    fbuffer_policy(GetFieldIndex("BankersID", findex_policy)) = SetFieldValue(NewBankersID)
                    fbuffer_policy(GetFieldIndex("BankersClause", findex_policy)) = SetFieldValue(NewBankersClause)
                    fbuffer_policy(GetFieldIndex("MSCode", findex_policy)) = SetFieldValue(MSCode)
                    fbuffer_policy(GetFieldIndex("BizMapID", findex_policy)) = SetFieldValue(BizMapID)
                    fbuffer_policy(GetFieldIndex("BID", findex_policy)) = SetFieldValue(BID)

                    Dim InParam(18) As Object
                    InParam(0) = CNO
                    InParam(1) = ANO
                    InParam(2) = toval(rs.fields("CANO"))
                    InParam(3) = LANO
                    InParam(4) = toval(rs.fields("RENEWABLEF"))
                    InParam(5) = toval(rs.fields("Voyage"))
                    InParam(6) = toval(OpenFlag)
                    InParam(7) = M_SDate
                    InParam(8) = M_EDate
                    InParam(9) = M_PDate
                    InParam(10) = False             'cbxOverWriteCAF.Checked
                    InParam(11) = tostr(REGID)
                    InParam(12) = tostr(sFLDID)
                    InParam(13) = tostr(sValueID)
                    InParam(14) = tostr(sValueDesc)
                    InParam(15) = False             'Apply Master Facultative
                    InParam(16) = -1
                    InParam(17) = AdjustFacultativePeriodF
                    InParam(18) = KeepExistingF

                    NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.Proclib", "SAVE_CERTIFICATE_DATA", InParam, findex_policy, fbuffer_policy)
                    If NewANO = 0 Then
                        StrMsg = "Process : Save Certificate Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                        GoTo errmsg
