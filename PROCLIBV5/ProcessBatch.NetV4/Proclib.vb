        Next i

        SDate = todate(GetFieldValue(FBuffer(GetFieldIndex("INCEPTION", FIndex)))).Date
        EDate = todate(GetFieldValue(FBuffer(GetFieldIndex("EXPIRY", FIndex)))).Date

        rsDst.fields("SDATE") = SDate
