                    ElseIf OBJ_ID <> "" Then
                        SQL = SQL & " Select Top 1 A.ANO, A.LANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RefNo, A.PDate, A.SDate, A.EDate, A.TOC, C.PolicyType from Cover C, Acceptance A Where ((A.AType in ('C') And A.AStatus in ('I')) or (A.AType in ('N','E') And A.AStatus in ('C'))) and C.CNO=A.CNO and A.RegNo='" & RegNo & "' and A.ValueID='" & OBJ_ID & "' Order by A.ANO Desc"
                    ElseIf RefNo <> "" Then
                        SQL = SQL & " Select Top 1 A.ANO, A.LANO, A.Branch, A.PolicyNO, A.CertificateNo, A.RefNo, A.PDate, A.SDate, A.EDate, A.TOC, C.PolicyType from Cover C, Acceptance A Where ((A.AType in ('C') And A.AStatus in ('I')) or (A.AType in ('N','E') And A.AStatus in ('C'))) and C.CNO=A.CNO and A.RegNo='" & RegNo & "' and A.RefNo='" & RefNo & "' Order by A.ANO Desc"
                    Else
