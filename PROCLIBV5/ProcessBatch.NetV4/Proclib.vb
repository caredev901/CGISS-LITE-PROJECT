    Private Function Add_Employee_Contribution(ByVal ANO As Long, ByVal ID As String, ByVal ECUType As String, ByVal Remarks As String, ByVal PCT As Double) As Boolean
        Try
            Dim rs As RemoteSet

            rs = db.OpenRemoteSet("Select * from ACCEMPCONTH Where ANO=" & ANO)
            If rs.Eof Then
                rs.AddNew()
                rs.fields("ANO") = ANO
                rs.fields("TOTALPCT") = 0
                rs.fields("Remarks") = ""
                rs.fields("Status") = "A"
                rs.fields("UserID") = db_user
                rs.fields("CDate") = Today.Date
                rs.fields("LUserID") = db_user
                rs.fields("LDate") = Today.Date
                rs.fields("PUserID") = db_user
                rs.fields("PUserDate") = Today.Date
                rs.fields("AUserID") = db_user
                rs.fields("AUserDate") = Today.Date
            Else
                rs.Edit()
            End If
            rs.fields("TOTALPCT") = toval(rs.fields("TOTALPCT")) + PCT
            If Not rs.Update Then Throw New Exception(db.ErrDesc)

            Dim rsDet As RemoteSet
            rsDet = db.OpenRemoteSet("Select * from ACCEMPCONTD Where 1<>1")
            rsDet.AddNew()
            rsDet.fields("ANO") = ANO
            rsDet.fields("ID") = ID
            rsDet.fields("Remarks") = Remarks
            rsDet.fields("PCT") = PCT
            rsDet.fields("ECUTYPE") = ECUType
            If Not rsDet.Update Then Throw New Exception(db.ErrDesc)
            Add_Employee_Contribution = True
        Catch ex As Exception
            StrMsg = ex.Message
            Add_Employee_Contribution = False
        End Try
