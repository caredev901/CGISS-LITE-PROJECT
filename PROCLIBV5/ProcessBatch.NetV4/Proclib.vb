    Public Delegate Function Call_Process_delegate(ByVal SName As String, ByVal ProcName As String, ByVal Param1 As Object, ByVal Param2 As Object, ByVal Param3 As Object, ByVal Param4 As Object, ByVal Param5 As Object, ByVal Param6 As Object, ByVal NewSessionFlag As Boolean) As Object

    Private Sub CallBackFunction(ByVal Result As IAsyncResult)
        Dim ProcessInfo As Process_Info
        ProcessInfo = CType(Result.AsyncState, Process_Info)
        ' Insert into Queue Process
        Dim db As New ClassLib
        If db.OpenConnection(ServiceName, db_Name, db_Server, db_sysuser, db_syspassword, db_TimeOut, db_Trusted) Then
            db.Var_db_user = db_user
            db.Var_db_Password = db_password
            db.Var_db_User_Type = db_user_type
            db.Var_db_User_CCode = db_User_CCode
            With ProcessInfo
                If StrMsg = "" Then
                    db.Call_Queued_Process(.Proclib, .ProcName, .Param1, .Param2, .Param3, .Param4, .Param5, .Param6, StrMsg, False, "C")
                Else
                    db.Call_Queued_Process(.Proclib, .ProcName, .Param1, .Param2, .Param3, .Param4, .Param5, .Param6, StrMsg, False, "P")
                End If
            End With
            db.CloseSession()
        End If
    End Sub
    Private Function Determine_Process_Timeout(ByVal ProcName As String) As Long
        Dim TimeOut As Long
        Dim rs As RemoteSet
        Dim db As New ClassLib
        db.Var_ObjSession = ObjSession
        rs = db.OpenRemoteSet("Select TimeOut from SysProcess Where ProcName='" & ProcName & "'")
        TimeOut = toval(rs.fields("TimeOut"))
        Determine_Process_Timeout = TimeOut
    End Function
    Private Function Check_Process_Execution(ByVal ProcName As String) As Boolean
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select StartTime, EndTime, Startday, EndDay from Sysprocess where ProcName='" & ProcName & "'")
        If Not rs.Eof Then
            If toval(rs.fields("StartDay")) <> 0 Or toval(rs.fields("EndDay")) <> 0 Then
                If Not (Today.Date.Day >= toval(rs.fields("StartDay")) And Today.Date.Day <= toval(rs.fields("EndDay"))) Then
                    Check_Process_Execution = False
                    Exit Function
                End If
            End If
            If tostr(rs.fields("StartTime")) <> "00:00" Or tostr(rs.fields("EndTime")) <> "00:00" Then
                If Not (tostr(Time()) >= tostr(rs.fields("StartTime")) And tostr(Time()) <= tostr(rs.fields("EndTime"))) Then
                    Check_Process_Execution = False
                    Exit Function
                End If
            End If
        End If
        Check_Process_Execution = True
    End Function
    Public Function Call_Process(ByVal SName As String, ByVal ProcName As String, Optional ByVal Param1 As Object = Nothing, Optional ByVal Param2 As Object = Nothing, Optional ByVal Param3 As Object = Nothing, Optional ByVal Param4 As Object = Nothing, Optional ByVal Param5 As Object = Nothing, Optional ByVal Param6 As Object = Nothing) As Object
        Dim caller As New Call_Process_delegate(AddressOf Call_Process_Execute)
        Dim callBack As AsyncCallback = AddressOf CallBackFunction
        Dim ProcessInfo As New Process_Info

        ServiceName = SName
        ProcessInfo.Proclib = "ProcessBatch.NetV4.Proclib"
        ProcessInfo.ProcName = ProcName
        ProcessInfo.Param1 = SetParamValue(Param1)
        ProcessInfo.Param2 = SetParamValue(Param2)
        ProcessInfo.Param3 = SetParamValue(Param3)
        ProcessInfo.Param4 = SetParamValue(Param4)
        ProcessInfo.Param5 = SetParamValue(Param5)
        ProcessInfo.Param6 = SetParamValue(Param6)
        ProcessInfo.IsCompleted = False

        Dim Timeout As Long
        Timeout = Determine_Process_Timeout(ProcName)
        ' For Debug Purposes only
        If Timeout = 0 Then
            Call_Process = Call_Process_Execute(SName, ProcName, Param1, Param2, Param3, Param4, Param5, Param6, True)
        Else
            ' Insert into Queue Process
            Dim db As New ClassLib
            If db.OpenConnection(ServiceName, db_Name, db_Server, db_sysuser, db_syspassword, db_TimeOut, db_Trusted) Then
                db.Var_db_user = db_user
                db.Var_db_Password = db_password
                db.Var_db_User_Type = db_user_type
                db.Var_db_User_CCode = db_User_CCode
                With ProcessInfo
                    db.Call_Queued_Process(.Proclib, .ProcName, .Param1, .Param2, .Param3, .Param4, .Param5, .Param6, "Asynchronous Process (Working...)", False, "P")
                End With
                db.CloseSession()
            End If

            Dim result As IAsyncResult = caller.BeginInvoke(SName, ProcName, Param1, Param2, Param3, Param4, Param5, Param6, True, callBack, ProcessInfo)
            result.AsyncWaitHandle.WaitOne(Timeout, False)
            ProcessInfo.IsCompleted = result.IsCompleted
            If ProcessInfo.IsCompleted Then
                Call_Process = caller.EndInvoke(result)
                If db.OpenConnection(ServiceName, db_Name, db_Server, db_sysuser, db_syspassword, db_TimeOut, db_Trusted) Then
                    db.Var_db_user = db_user
                    db.Var_db_Password = db_password
                    db.Var_db_User_Type = db_user_type
                    db.Var_db_User_CCode = db_User_CCode
                    With ProcessInfo
                        If Call_Process Then
                            db.Call_Queued_Process(.Proclib, .ProcName, .Param1, .Param2, .Param3, .Param4, .Param5, .Param6, StrMsg, False, "C")
                        Else
                            db.Call_Queued_Process(.Proclib, .ProcName, .Param1, .Param2, .Param3, .Param4, .Param5, .Param6, StrMsg, False, "P")
                        End If
                    End With
                    db.CloseSession()
                End If
            Else
                Call_Process = Nothing
            End If
        End If
    End Function

    Public Function Call_Process_Execute(ByVal SName As String, ByVal ProcName As String, Optional ByVal Param1 As Object = Nothing, Optional ByVal Param2 As Object = Nothing, Optional ByVal Param3 As Object = Nothing, Optional ByVal Param4 As Object = Nothing, Optional ByVal Param5 As Object = Nothing, Optional ByVal Param6 As Object = Nothing, Optional ByVal NewSessionFlag As Boolean = False) As Object
        Dim Process_OK As Boolean
        StrMsg = ""
        Process_OK = False
        'Get Class Library
        db = New ClassLib
        If NewSessionFlag Then
            If Not db.OpenConnection(SName, db_Name, db_Server, db_sysuser, db_syspassword, db_TimeOut, db_Trusted) Then
                StrMsg = "Opening Session Failed !"
                db = Nothing
                Call_Process_Execute = False
                Exit Function
            End If
        Else
            db.Var_ObjSession = ObjSession
        End If
        db.Var_db_user = db_user
        db.Var_db_Password = db_password
        db.Var_db_User_Type = db_user_type
        db.Var_db_User_CCode = db_user_CCode

        On Error GoTo errmsg
        If NewSessionFlag Then db.Begintrans()
        Select Case UCase(ProcName)
            Case "UPLOAD_UP"
                Process_OK = Upload_UP(Param1, Param2, Param3)
            Case "UPLOAD_SC"
                Process_OK = Upload_SC(Param1, Param2, Param3, Param4)
            Case "UPLOAD_BC"
                Process_OK = Upload_BC(Param1, Param2, Param3)
            Case "UPLOAD_BE"
                Process_OK = Upload_BE(Param1, Param2, Param3)
            Case "VERIFY_UP"
                Process_OK = Verify_UP(Param1, Param2, Param3)
            Case "VERIFY_SC"
                Process_OK = Verify_SC(Param1, Param2, Param3, Param4)
            Case "VERIFY_BE"
                Process_OK = Verify_BE(Param1, Param2, Param3)
            Case "VERIFY_BC"
                Process_OK = Verify_BC(Param1, Param2, Param3)
        End Select

        If Process_OK Then
            If NewSessionFlag Then db.Committrans()
        Else
            If NewSessionFlag Then db.RollBack()
        End If
        If NewSessionFlag Then db.CloseSession()
        db = Nothing
        Call_Process_Execute = Process_OK
        Exit Function
errmsg:
        If NewSessionFlag Then db.RollBack()
        If NewSessionFlag Then db.CloseSession()
        db = Nothing
        Call_Process_Execute = Process_OK
    End Function
    Private Function PreCancelConditionsOK(ByVal ANO As Long, ByVal NewPDate As Date, ByVal OpenFlag As Boolean, ByVal CancelAllF As Boolean, ByVal TOC As String, ByVal NoRefundF As Integer, ByVal ExternalF As Boolean, ByRef ErrMsg As String) As Boolean
        Dim rs As RemoteSet
        Dim AType As String
        Dim EMethod As String
        Dim SDate As Date
        Dim EDate As Date
        Dim PDate As Date
        Dim LANO As Long
        Dim OANO As Long
        Dim PolicyNo As String
        Dim CertificateNo As String
        Dim AStatus As String
        Dim MAStatus As String

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select A.PolicyNo, A.CertificateNo, A.OANO, A.AStatus, mA.AStatus as MAStatus, A.EMethod, A.AType, A.PDate, A.SDate, A.EDate, A.LANO, A.Remarks, pA.AType as pAType from Acceptance A Left Join Acceptance mA on (mA.ANO=A.LANO and mA.ANO=mA.LANO) Left Join Acceptance pA on (pA.ANO=A.pANO) Where A.ANO=" & ANO)
        If rs.Eof Then
            ErrMsg = "Policy/Certificate Data Not Found !"
            GoTo errmsg
        End If
        EMethod = tostr(rs.fields("EMethod"))
        AType = tostr(rs.fields("AType"))
        PDate = todate(rs.fields("PDate"))
        SDate = todate(rs.fields("SDate"))
        EDate = todate(rs.fields("EDate"))
        LANO = toval(rs.fields("LANO"))
        OANO = toval(rs.fields("OANO"))
        PolicyNo = tostr(rs.fields("PolicyNo"))
        CertificateNo = tostr(rs.fields("CertificateNo"))
        AStatus = tostr(rs.fields("AStatus"))
        MAStatus = tostr(rs.fields("MAStatus"))

        If AType = "C" Then
            ErrMsg = "Cancellation not for Cancellation !"
            GoTo errmsg
        End If

        If AStatus <> "I" Then
            ErrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        If LANO <> -1 AndAlso ANO <> LANO AndAlso MAStatus <> "I" Then
            ErrMsg = "Please Check Master Policy Data Status !"
            GoTo errmsg
        End If

        rs = db.OpenRemoteSet("Select NOCANCELF from TOC Where TOC='" & TOC & "'")
        If toval(rs.fields("NOCANCELF")) Then
            If Not db.GetPrivileges("ALLOWCANCELDATA") Then
                ErrMsg = "Not Allowed to Cancel Data !"
                GoTo errmsg
            End If
        End If

        If Not CancelAllF Then
            If DateDiff(DateInterval.Day, SDate, NewPDate) < 0 Then
                ErrMsg = "Effective Date can't be earlier than Start Date"
                GoTo errmsg
            End If

            If DateDiff(DateInterval.Day, EDate, NewPDate) > 0 Then
                ErrMsg = "Effective Date can't be greater than Expiry Date"
                GoTo errmsg
            End If
            If DateDiff(DateInterval.Day, PDate, NewPDate) < 0 Then
                Select Case AType
                    Case "N"
                        ErrMsg = "Effective Date for this cancellation can't be earlier than current policy."
                    Case "E"
                        ErrMsg = "Effective Date for this cancellation can't be earlier than current endorsement."
                    Case "A"
                        ErrMsg = "Effective Date for this cancellation can't be earlier than current Adjustment."
                    Case Else
                        ErrMsg = "Effective Date for this cancellation can't be earlier than previous transaction."
                End Select
                GoTo errmsg
            End If
        End If

        If AType <> "A" Then

            If ANO = LANO And Not OpenFlag Then
                ' Check Detail Acceptance for Conjunction Policies
                rs = db.OpenRemoteSet("Select Top 1 A2.ANO, C.CoverNo, A2.PolicyNo, A2.CertificateNo from Acceptance A1, Acceptance A2, Cover C, RArrHeader R Where (R.Status='A' or A2.AStatus='W') and R.ANO=A2.ANO and C.CNO=A2.CNO and A2.CANO=A1.ANO and A1.ANO<>A1.LANO and A1.AType in ('N','E') and A1.LANO=" & ANO)
                If Not rs.Eof Then
                    ErrMsg = "Must Cancel the Co. Quotation (" & rs.fields("CoverNo") & "), Policy (" & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & ") !"
                    GoTo errmsg
                End If
            Else
                rs = db.OpenRemoteSet("Select Top 1 A2.ANO, C.CoverNo, A2.PolicyNo, A2.CertificateNo from Acceptance A1, Acceptance A2, Cover C, RArrHeader R Where (R.Status='A' or A2.AStatus='W') and R.ANO=A2.ANO and C.CNO=A2.CNO and A2.CANO=A1.ANO and A1.AType in ('N','E') and A1.ANO=" & ANO)
                If Not rs.Eof Then
                    ErrMsg = "Must Cancel the Co. Quotation (" & rs.fields("CoverNo") & "), Policy (" & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & ") !"
                    GoTo errmsg
                End If
            End If

            ' Check Existing Claim Incurred
            If ANO = LANO And Not OpenFlag Then
                Dim rsDet As RemoteSet
                rsDet = db.OpenRemoteSet("Select ANO from Acceptance Where AType in ('N','E') and AStatus='I' and LANO=" & LANO)
                Do While Not rsDet.Eof
                    ' Check Existing Claim Incurred
                    rs = db.OpenRemoteSet("Select Top 1 C.LossDate, C.CStatus, C.pCStatus, C1.CTLF from Claim C Left Join CLLOSS C1 on (C1.CNO=C.CNO and C1.CTLF=1), Acceptance A1, Acceptance A2 Where A1.ANO=" & rsDet.fields("ANO") & " and A2.OANO=A1.OANO and C.ANO=A2.ANO and C.CType<>'C' and (C.CStatus<>'C' or C.PCstatus='A') and not exists (Select pCNO from Claim Where Claim.pCNO=C.CNO and Claim.CStatus<>'R') order By C.LossDate Desc")
                    If IsDate(rs.fields("LossDate")) Then
                        If DateDiff(DateInterval.Day, rs.fields("LossDate"), NewPDate) < 0 Then
                            ErrMsg = "Claim Already Incurred on " & Format(rs.fields("LossDate"), "d")
                            GoTo errmsg
                        ElseIf DateDiff(DateInterval.Day, rs.fields("LossDate"), NewPDate) = 0 Then
                            If Not ((rs.fields("CStatus") = "A" Or rs.fields("pCStatus") = "A") And toval(rs.fields("CTLF")) And (NoRefundF = 1 Or NoRefundF = 2 Or NoRefundF = 4)) Then
                                ErrMsg = "Claim Already Incurred on " & Format(rs.fields("LossDate"), "d")
                                GoTo errmsg
                            End If
                        End If
                    End If

                    ' Check Total Loss
                    If Not (NoRefundF = 1 Or NoRefundF = 2 Or NoRefundF = 4) Then
                        rs = db.OpenQueryDef("QCLACC_6", adOpenForwardonly, rsDet.fields("ANO"))
                        If Not rs.Eof Then
                            If (DateDiff(DateInterval.Month, todate(SDate), rs.fields("LossDate")) \ 12) >= (DateDiff(DateInterval.Month, todate(SDate), NewPDate) \ 12) Then
                                ErrMsg = "Already Has Claim Total Loss (ClaimNo : " & rs.fields("ClaimNo") & ") on " & Format(rs.fields("LossDate"), "d") & " !"
                                GoTo errmsg
                            End If
                        End If
                    End If

                    If Not CancelAllF Then
                        ' Not Check If Cancel All
                        rs = db.OpenRemoteSet("Select R.PDate as R_PDate, R.PPDate as R_PPDate, R.RDate, R.NRDate from RArrHeader R Where R.ANO=" & rsDet.fields("ANO"))
                        If Not rs.Eof Then
                            ' Not Clean Cut
                            If (DateDiff(DateInterval.Day, rs.fields("R_PDate"), rs.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rs.fields("R_PPDate"), rs.fields("NRDate")) = 0) And (DateDiff(DateInterval.Day, todate(rs.fields("RDate")), NewPDate) < 0 Or DateDiff(DateInterval.Day, todate(rs.fields("NRDate")), NewPDate) > 0) Then
                                ErrMsg = "Effective Date Should Be Between Treaty Period On " & Format(todate(rs.fields("RDate")), "d") & " - " & Format(todate(rs.fields("NRDate")), "d")
                                GoTo errmsg
                            End If

                            ' Clean Cut
                            If Not (DateDiff(DateInterval.Day, rs.fields("R_PDate"), rs.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rs.fields("R_PPDate"), rs.fields("NRDate")) = 0) And DateDiff(DateInterval.Day, NewPDate, rs.fields("R_PPDate")) < 0 Then
                                ErrMsg = "Policy Needs Annual Treaty Reallocation, Please Review The Reinsurance Date on " & Format(rs.fields("R_PPDate"), "d") & " !"
                                GoTo errmsg
                            End If
                        End If
                    End If
                    rsDet.MoveNext()
                Loop
            Else
                ' Check Existing Claim Incurred
                rs = db.OpenRemoteSet("Select Top 1 C.LossDate, C.CStatus, C.pCStatus, C1.CTLF from Claim C Left Join CLLOSS C1 on (C1.CNO=C.CNO and C1.CTLF=1), Acceptance A1, Acceptance A2 Where A1.ANO=" & ANO & " and A2.OANO=A1.OANO and C.ANO=A2.ANO and C.CType<>'C' and (C.CStatus<>'C' or C.PCstatus='A') and not exists (Select pCNO from Claim Where Claim.pCNO=C.CNO and Claim.CStatus<>'R') order By C.LossDate Desc")
                If IsDate(rs.fields("LossDate")) Then
                    If DateDiff(DateInterval.Day, rs.fields("LossDate"), NewPDate) < 0 Then
                        ErrMsg = "Claim Already Incurred on " & Format(rs.fields("LossDate"), "d")
                        GoTo errmsg
                    ElseIf DateDiff(DateInterval.Day, rs.fields("LossDate"), NewPDate) = 0 Then
                        If Not ((rs.fields("CStatus") = "A" Or rs.fields("pCStatus") = "A") And toval(rs.fields("CTLF")) And (NoRefundF = 1 Or NoRefundF = 2 Or NoRefundF = 4)) Then
                            ErrMsg = "Claim Already Incurred on " & Format(rs.fields("LossDate"), "d")
                            GoTo errmsg
                        End If
                    End If
                End If

                ' Check Total Loss
                If Not (NoRefundF = 1 Or NoRefundF = 2 Or NoRefundF = 4) Then
                    rs = db.OpenQueryDef("QCLACC_6", adOpenForwardonly, ANO)
                    If Not rs.Eof Then
                        If (DateDiff(DateInterval.Month, todate(SDate), rs.fields("LossDate")) \ 12) >= (DateDiff(DateInterval.Month, todate(SDate), NewPDate) \ 12) Then
                            ErrMsg = "Already Has Claim Total Loss (ClaimNo : " & rs.fields("ClaimNo") & ") on " & Format(rs.fields("LossDate"), "d") & " !"
                            GoTo errmsg
                        End If
                    End If
                End If

                If NoRefundF = 0 Then
                    Dim ClaimOnCancelF As Boolean
                    rs = db.OpenRemoteSet("Select ClaimOnCancelF from TOC Where TOC='" & TOC & "'")
                    ClaimOnCancelF = toval(rs.fields("ClaimOnCancelF"))
                    If ClaimOnCancelF Then
                        Dim Claim_Paid As Double
                        Dim Gross_Premium As Double
                        Dim OS_Claim As Double

                        rs = db.OpenQueryDef("CLAIM_PAID_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
                        Claim_Paid = -toval(rs.fields("Claim_Paid"))
                        rs = db.OpenQueryDef("GROSS_PREMIUM_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
                        Gross_Premium = toval(rs.fields("Gross_Premium"))
                        rs = db.OpenQueryDef("OS_CLAIM_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
                        OS_Claim = toval(rs.fields("OS_Claim"))

                        If Gross_Premium <> 0 AndAlso (Claim_Paid + OS_Claim) <> 0 AndAlso (Claim_Paid + OS_Claim) > Gross_Premium Then
                            ErrMsg = "Amount Claim Exceeding Premium Amount !"
                            GoTo errmsg
                        End If
                    End If
                End If

                If Not CancelAllF Then
                    ' Not Check If Cancel All
                    rs = db.OpenRemoteSet("Select R.PDate as R_PDate, R.PPDate as R_PPDate, R.RDate, R.NRDate from RArrHeader R Where R.ANO=" & ANO)
                    If Not rs.Eof Then
                        ' Not Clean Cut
                        If (DateDiff(DateInterval.Day, rs.fields("R_PDate"), rs.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rs.fields("R_PPDate"), rs.fields("NRDate")) = 0) And (DateDiff(DateInterval.Day, todate(rs.fields("RDate")), NewPDate) < 0 Or DateDiff(DateInterval.Day, todate(rs.fields("NRDate")), NewPDate) > 0) Then
                            ErrMsg = "Effective Date Should Be Between Treaty Period On " & Format(todate(rs.fields("RDate")), "d") & " - " & Format(todate(rs.fields("NRDate")), "d")
                            GoTo errmsg
                        End If

                        ' Clean Cut
                        If Not (DateDiff(DateInterval.Day, rs.fields("R_PDate"), rs.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rs.fields("R_PPDate"), rs.fields("NRDate")) = 0) And DateDiff(DateInterval.Day, NewPDate, rs.fields("R_PPDate")) < 0 Then
                            ErrMsg = "Policy Needs Annual Treaty Reallocation, Please Review The Reinsurance Date on " & Format(rs.fields("R_PPDate"), "d") & " !"
                            GoTo errmsg
                        End If
                    End If
                End If
            End If

            If CancelAllF Then
                rs = db.OpenRemoteSet("Select Top 1 A1.RegNo from Acceptance A1 Where AType='A' and AStatus<>'C' and OANO=" & OANO)
                If Not rs.Eof Then
                    ErrMsg = "Policy Already Has Adjustment (Reg No. " & rs.fields("RegNo") & ")"
                    GoTo errmsg
                End If
            End If


            Dim SQL As String = ""
            SQL = SQL & " Declare @ANO Int"
            SQL = SQL & " Select @ANO=" & ANO
            SQL = SQL & " Select top 1 A1.RegNo, A1.PANO"
            SQL = SQL & " from Acceptance A1 "
            SQL = SQL & " Where ((A1.AType in ('A') and A1.AStatus<>'C') or A1.AType not in ('A')) and A1.pANO=@ANO"

            SQL = SQL & " Union all"

            SQL = SQL & " Select top 1 A1.RegNo, A1.PANO"
            SQL = SQL & " from Acceptance A1 "
            SQL = SQL & " Where not (A1.AType in ('C') and A1.EMethod='A' and A1.AStatus='I') and A1.RANO=@ANO"
            SQL = SQL & " and not exists (Select A2.pANO from acceptance A2 Where A2.pANO=A1.ANO)"

            rs = db.OpenRemoteSet(SQL)
            If Not rs.Eof Then
                If rs.fields("PANO") = ANO Then
                    ErrMsg = "Already Endorsed (Cancelled) ! Referred to The Policy Data. (Reg No. " & rs.fields("RegNo") & ")"
                Else
                    ErrMsg = "Already Renewed ! Referred to The Policy Data. (Reg No. " & rs.fields("RegNo") & ")"
                End If
                GoTo errmsg
            End If

            Dim CANCELONPAIDPREMIUMF As Boolean = db.GetPrivileges("CANCELONPAIDPREMIUM")
            Dim CANCELONUNPAIDPREMIUMF As Boolean = db.GetPrivileges("CANCELONUNPAIDPREMIUM")
            Dim isNotPremiumPaidF As Boolean = False

            If Not CANCELONPAIDPREMIUMF Or Not CANCELONUNPAIDPREMIUMF Then
                isNotPremiumPaidF = isNotPremiumPaid(ANO, Today.Date)
            End If

            If Not CANCELONPAIDPREMIUMF Then
                If Not isNotPremiumPaidF Then
                    ErrMsg = "Can't Cancel The Policy which is Already Paid !"
                    GoTo errmsg
                End If
            End If

            If Not CANCELONUNPAIDPREMIUMF Then
                If isNotPremiumPaidF Then
                    ErrMsg = "Can't Cancel The Policy which is Not Yet Paid !"
                    GoTo errmsg
                End If
            End If
        Else
            ' Adjustment Cancel
            rs = db.OpenRemoteSet("Select A1.RegNo, A1.PANO from Acceptance A1 Where A1.AType='C' and A1.PANO=" & ANO)
            If Not rs.Eof Then
                ErrMsg = "Already Endorsed (Cancelled) ! Referred to The Policy Data. (Reg No. " & rs.fields("RegNo") & ")"
                GoTo errmsg
            End If
        End If

        If ANO = LANO Then
            rs = db.OpenRemoteSet("Select top 1 CertificateNo from Acceptance Where LANO=" & LANO & " and AStatus in ('W','T')")
            If Not rs.Eof Then
                ErrMsg = "Policy Has a Detail with Waiting Status (Ex. Certificate No. " & rs.fields("CertificateNo") & ") !"
                GoTo errmsg
            End If
        End If

        PreCancelConditionsOK = True
        Exit Function
errmsg:
        ErrMsg = StrError(ErrMsg)
        PNotes(ANO, "POLICY", "Policy Cancel : " & ErrMsg)
        PreCancelConditionsOK = False
    End Function
    Private Function Create_ProAcc(ByVal ID As String, ByVal CCY As String, ByVal AccountNo As String, ByVal BankAccount As String, ByVal BankName As String, ByVal Bank As String, ByVal BankBranch As String, ByVal RefType As String, ByVal BCTransferby As Integer, ByVal PRDays As Integer, ByVal Remarks As String) As Boolean
        On Error GoTo errmsg

        Dim rs As RemoteSet
        Dim Description As String

        If Bank <> "" Then
            rs = db.OpenRemoteSet("Select Bank, Description From Bank Where Bank = '" & Bank & "'")
            Bank = tostr(rs.fields("Bank"))
            If Not rs.Eof Then
                BankName = rs.fields("Description")
                If BankBranch <> "" Then
                    BankName = BankName & " " & BankBranch
                End If
            End If
        End If

        rs = db.OpenRemoteSet("Select Name from Profile Where ID='" & ID & "'")
        Description = rs.fields("Name")

        Dim rsP As RemoteSet
        Dim RestrictedF As Boolean = False
        rsP = db.OpenRemoteSet("Select * from ProAcc Where ID='" & ID & "' and Currency='" & CCY & "'")
        If rsP.Eof Then
            rsP.AddNew()
            rsP.fields("ID") = ID
            rsP.fields("Currency") = CCY
            rsP.fields("ProAcc") = ID + "-" + Left(CCY, 3)
            rsP.fields("Description") = Description
            rsP.fields("UserID") = db_user
            rsP.fields("CDate") = Today.Date
        Else
            rsP.Edit()
        End If
        Dim EditMode As Integer
        EditMode = rsP.editmode

        If DecryptByPassPhrase(GetAppSetting("EncryptionPassPhrase"), rsP.fields("AccountNo"), 1) <> AccountNo Then
            If EditMode = AdEditInProgress AndAlso Not Save_Log_Object("PROACC", "PROACC", rsP.fields("ProAcc"), "", "", "", "", "", "", "AccountNo", DecryptByPassPhrase(GetAppSetting("EncryptionPassPhrase"), rsP.fields("AccountNo"), 1), AccountNo, "Update") Then Throw New Exception("Error Save Log Object")
            rsP.fields("AccountNo") = EncryptByPassPhrase(GetAppSetting("EncryptionPassPhrase"), AccountNo)
            RestrictedF = True
        End If

        If DecryptByPassPhrase(GetAppSetting("EncryptionPassPhrase"), rsP.fields("BankAccount"), 1) <> BankAccount Then
            If EditMode = AdEditInProgress AndAlso Not Save_Log_Object("PROACC", "PROACC", rsP.fields("ProAcc"), "", "", "", "", "", "", "BankAccount", DecryptByPassPhrase(GetAppSetting("EncryptionPassPhrase"), rsP.fields("BankAccount"), 1), BankAccount, "Update") Then Throw New Exception("Error Save Log Object")
            rsP.fields("BankAccount") = EncryptByPassPhrase(GetAppSetting("EncryptionPassPhrase"), BankAccount)
            RestrictedF = True
        End If

        If rsP.fields("BankName") <> BankName Then
            If EditMode = AdEditInProgress AndAlso Not Save_Log_Object("PROACC", "PROACC", rsP.fields("PROACC"), "", "", "", "", "", "", "BankName", rs.fields("BankName"), BankName, "Update") Then Throw New Exception("Error Save Log Object")
            rsP.fields("BankName") = BankName
            RestrictedF = True
        End If
        If rsP.fields("Bank") <> Bank Then
            If EditMode = AdEditInProgress AndAlso Not Save_Log_Object("PROACC", "PROACC", rsP.fields("PROACC"), "", "", "", "", "", "", "Bank", rs.fields("Bank"), Bank, "Update") Then Throw New Exception("Error Save Log Object")
            rsP.fields("Bank") = Bank
            RestrictedF = True
        End If
        If rsP.fields("BankBranch") <> BankBranch Then
            If EditMode = AdEditInProgress AndAlso Not Save_Log_Object("PROACC", "PROACC", rsP.fields("PROACC"), "", "", "", "", "", "", "BankBranch", rs.fields("BankBranch"), BankBranch, "Update") Then Throw New Exception("Error Save Log Object")
            rsP.fields("BankBranch") = BankBranch
            RestrictedF = True
        End If
        If rsP.fields("RefType") <> RefType Then
            If EditMode = AdEditInProgress AndAlso Not Save_Log_Object("PROACC", "PROACC", rsP.fields("PROACC"), "", "", "", "", "", "", "RefType", rs.fields("RefType"), RefType, "Update") Then Throw New Exception("Error Save Log Object")
            rsP.fields("RefType") = RefType
            RestrictedF = True
        End If
        If toval(rsP.fields("BCTransferby")) <> BCTransferby Then
            If EditMode = AdEditInProgress AndAlso Not Save_Log_Object("PROACC", "PROACC", rsP.fields("PROACC"), "", "", "", "", "", "", "BCTransferby", rs.fields("BCTransferby"), BCTransferby, "Update") Then Throw New Exception("Error Save Log Object")
            rsP.fields("BCTransferby") = BCTransferby
            RestrictedF = True
        End If
        If toval(rsP.fields("PRDays")) <> PRDays Then
            If EditMode = AdEditInProgress AndAlso Not Save_Log_Object("PROACC", "PROACC", rsP.fields("PROACC"), "", "", "", "", "", "", "PRDays", rs.fields("PRDays"), PRDays, "Update") Then Throw New Exception("Error Save Log Object")
            rsP.fields("PRDays") = PRDays
            RestrictedF = True
        End If
        If rsP.fields("Remarks") <> Remarks Then
            If EditMode = AdEditInProgress AndAlso Not Save_Log_Object("PROACC", "PROACC", rsP.fields("PROACC"), "", "", "", "", "", "", "Remarks", rs.fields("Remarks"), Remarks, "Update") Then Throw New Exception("Error Save Log Object")
            rsP.fields("Remarks") = Remarks
            RestrictedF = True
        End If

        If Not db.GetPrivileges("UNRESTRICTPROACC") Then
            rsP.fields("RestrictedF") = RestrictedF
            rsP.fields("PUserDate") = Today.Date
            rsP.fields("PUserID") = db_user
        Else
            rsP.fields("RestrictedF") = False
            rsP.fields("PUserDate") = Today.Date
            rsP.fields("PUserID") = db_user
        End If
        rsP.fields("Last_Opr") = db_user
        rsP.fields("Last_Update") = Today.Date
        ''rsP.fields("Last_Time") = Time()
        If Not rsP.Update Then GoTo errmsg

        Create_ProAcc = True
        Exit Function
errmsg:
        Create_ProAcc = False
    End Function
    Private Function Upload_BC(ByVal param As Object, ByVal Findex() As String, ByVal FBuffer() As String) As Boolean
        Dim i As Integer
        Dim ANO As Long
        Dim rs As RemoteSet
        Dim rsTemp As RemoteSet
        Dim POLICYNO As String
        Dim CertificateNo As String
        Dim Insured As String
        Dim ExternalF As Boolean
        Dim Refno As String
        Dim RefDate As Date
        Dim BookingDate As Date
        Dim Effective_Date As Date
        Dim Remarks As String
        Dim Memo As String
        Dim Description As String
        Dim CPCT As Double
        Dim Refund As Double
        Dim CancelAllF As Boolean
        Dim CancelType As String
        Dim REFUNDTYPE As String
        Dim NoAddRefundF As Integer
        Dim Reason As String
        Dim Wording As String
        Dim ImmediateInforceF As Boolean
        Dim AutoInforceF As Boolean
        Dim InforceF As Boolean
        Dim InforceBulkF As Boolean
        Dim OpenFlag As Boolean
        Dim LANO As Long
        Dim Branch As String
        Dim TOC As String
        Dim BatchNo As String
        Dim Fee, Fee_AmountPCT, Duty, Duty_AmountPCT As Double
        Dim FYear, DYear As Double
        Dim FeeRemark As String = ""

        Dim Grace As Integer
        Dim WPC As Integer
        Dim AccountNo As String
        Dim BankAccount As String
        Dim BankName As String
        Dim Bank As String
        Dim BankBranch As String

        Dim Fee_ProfileID As String = ""
        Dim Fee_ID As String = ""
        Dim Fee_Currency As String = ""
        Dim Fee_Remark As String = ""
        Dim Fee_Amount As Double

        Dim Fee_ProfileID_1 As String = ""
        Dim Fee_ID_1 As String = ""
        Dim Fee_Currency_1 As String = ""
        Dim Fee_Remark_1 As String = ""
        Dim Fee_Amount_1, Fee_AmountPCT_1 As Double

        Dim Duty_ProfileID As String = ""
        Dim Duty_ID As String = ""
        Dim Duty_Currency As String = ""
        Dim Duty_Remark As String = ""
        Dim Duty_Amount As Double

        Dim Duty_ProfileID_1 As String = ""
        Dim Duty_ID_1 As String = ""
        Dim Duty_Currency_1 As String = ""
        Dim Duty_Remark_1 As String = ""
        Dim Duty_Amount_1, Duty_AmountPCT_1 As Double

        Dim F_ID, D_ID As String
        Dim FeeCode As String
        Dim DutyCode As String
        Dim Comment As String = ""
        Dim Notes As String
        Dim NewANO As Long
        Dim BackDatedF As Boolean
        Dim BackDatedDate As String
        Dim ASource As String
        Dim UserID As String
        Dim AUserID As String
        Dim BID As Long
        Dim M_RegNo As String
        Dim InsuredName As String

        On Error GoTo errmsg


        Dim LockedKey As String

        ANO = tostr(GetFieldValue(FBuffer(GetFieldIndex("ANO", Findex))))
        LockedKey = ANO

        If Not db.GetLockedObject("Policy" & LockedKey) Then GoTo errmsg

        UserID = tostr(getInParamValue(param, 1))
        AUserID = tostr(GetFieldValue(FBuffer(GetFieldIndex("AUserID", Findex))))
        If AUserID = "" Then AUserID = UserId

        BID = toval(GetFieldValue(FBuffer(GetFieldIndex("BID", Findex))))
        POLICYNO = tostr(GetFieldValue(FBuffer(GetFieldIndex("POLICYNO", Findex))))
        CertificateNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("CERTIFICATENO", Findex))))
        Insured = tostr(GetFieldValue(FBuffer(GetFieldIndex("INSURED", Findex))))
        ExternalF = toval(GetFieldValue(FBuffer(GetFieldIndex("EXTERNALF", Findex))))
        Remarks = tostr(GetFieldValue(FBuffer(GetFieldIndex("REMARKS", Findex))))
        Memo = tostr(GetFieldValue(FBuffer(GetFieldIndex("MEMO", Findex))))
        CPCT = toval(GetFieldValue(FBuffer(GetFieldIndex("CPCT", Findex))))
        Refund = toval(GetFieldValue(FBuffer(GetFieldIndex("REFUND", Findex))))
        CancelType = tostr(GetFieldValue(FBuffer(GetFieldIndex("CANCELTYPE", Findex))))
        REFUNDTYPE = tostr(GetFieldValue(FBuffer(GetFieldIndex("REFUNDTYPE", Findex))))
        Reason = tostr(GetFieldValue(FBuffer(GetFieldIndex("REASON", Findex))))
        Wording = tostr(GetFieldValue(FBuffer(GetFieldIndex("WORDING", Findex))))
        ImmediateInforceF = toval(GetFieldValue(FBuffer(GetFieldIndex("ImmediateInforceF", Findex))))
        AutoInforceF = toval(GetFieldValue(FBuffer(GetFieldIndex("AutoInforceF", Findex))))
        InforceF = toval(GetFieldValue(FBuffer(GetFieldIndex("InforceF", Findex))))
        ' Compatibility
        If AutoInforceF Then InforceF = AutoInforceF

        InforceBulkF = toval(GetFieldValue(FBuffer(GetFieldIndex("InforceBulkF", Findex))))

        BatchNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("BatchNo", Findex))))
        Comment = tostr(GetFieldValue(FBuffer(GetFieldIndex("Comment", Findex))))
        Notes = tostr(GetFieldValue(FBuffer(GetFieldIndex("Notes", Findex))))
        ASource = tostr(GetFieldValue(FBuffer(GetFieldIndex("ASource", Findex))))
        RefDate = Today.Date
        BookingDate = Today.Date
        Description = ""
        BackDatedF = toval(GetFieldValue(FBuffer(GetFieldIndex("BackDatedF", Findex))))
        BackDatedDate = tostr(GetFieldValue(FBuffer(GetFieldIndex("BackDatedDate", Findex))))
        Grace = toval(GetFieldValue(FBuffer(GetFieldIndex("Grace", Findex))))
        WPC = toval(GetFieldValue(FBuffer(GetFieldIndex("WPC", Findex))))
        AccountNo = tostr(GetFieldValue(FBuffer(GetFieldIndex("AccountNo", Findex))))
        BankAccount = tostr(GetFieldValue(FBuffer(GetFieldIndex("BankAccount", Findex))))
        BankName = tostr(GetFieldValue(FBuffer(GetFieldIndex("BankName", Findex))))
        Bank = tostr(GetFieldValue(FBuffer(GetFieldIndex("Bank", Findex))))
        BankBranch = tostr(GetFieldValue(FBuffer(GetFieldIndex("BankBranch", Findex))))

        Dim AutoPrintF As Boolean = toval(GetFieldValue(FBuffer(GetFieldIndex("AutoPrintF", Findex))))
        Dim RefType As String = tostr(GetFieldValue(FBuffer(GetFieldIndex("RefType", Findex))))
        If BackDatedDate <> "" And Not IsDate(BackDatedDate) Then BackDatedDate = ""

        If Wording <> "" Then
            rs = db.OpenRemoteSet("Select WordingID, Description from Wording where AType='C' and WordingID='" & Wording & "'")
            If rs.Eof Then
                StrMsg = StrMsg & "Wording Code not found !" & vbCrLf
                GoTo errmsg
            End If
            If Description = "" Then Description = rs.fields("Description")
        End If

        If Reason <> "" Then
            rs = db.OpenRemoteSet("Select Reason, Description from REASON where Type='CANCELLATION' and REASON='" & Reason & "'")
            If rs.Eof Then
                StrMsg = StrMsg & "Reason Code not found !" & vbCrLf
                GoTo errmsg
            End If
            If Remarks = "" Then Remarks = rs.fields("Description")
        End If

        If Memo <> "" Then Description = Memo

        rs = db.OpenRemoteSet("Select A.TOC, A.AName, C.OpenFlag, C.ISType,  A.LANO, A.Branch, A.RefNo, A.SDate from Cover C, Acceptance A Where A.AStatus='I' and C.CNO=A.CNO and A.ANO = " & ANO)
        If rs.Eof Then GoTo errmsg
        OpenFlag = rs.fields("OpenFlag")
        LANO = rs.fields("LANO")
        Branch = rs.fields("Branch")
        TOC = rs.fields("TOC")
        Refno = rs.fields("Refno")
        InsuredName = rs.fields("AName")

        If CancelType = "A" And tostr(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", Findex)))) <> "" Then
            Effective_Date = todate(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", Findex))))
        ElseIf CancelType <> "A" And tostr(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", Findex)))) <> "" Then
            Effective_Date = todate(GetFieldValue(FBuffer(GetFieldIndex("EFFECTIVE_DATE", Findex))))
        Else
            Effective_Date = rs.fields("SDate")
        End If

        Select Case Left(CancelType, 1)
            Case "A"
                NoAddRefundF = 0
                CancelAllF = True
            Case "R"
                NoAddRefundF = 1
                CancelAllF = False
            Case "N"
                NoAddRefundF = 2
                CancelAllF = False
            Case "U"
                NoAddRefundF = 3
                CancelAllF = False
            Case "T"
                NoAddRefundF = 4
                CancelAllF = False
            Case "F"
                NoAddRefundF = 5
                CancelAllF = False
            Case "E"
                NoAddRefundF = 7
                CancelAllF = False
            Case "C"
                NoAddRefundF = 12
                CancelAllF = False
            Case "V"
                Select Case CancelType
                    Case "V1"   ' No Add/Refund VAT
                        NoAddRefundF = 8
                    Case "V2"   ' No Add/Refund TAX
                        NoAddRefundF = 9
                    Case "V3"   ' No Add/Refund VAT & TAX
                        NoAddRefundF = 10
                    Case "V4"   ' No Add/Refund Other VAT
                        NoAddRefundF = 11
                    Case "V5"   ' Conditional Refund Type
                        NoAddRefundF = 13
                    Case Else   ' No Add/Refund ALL VAT
                        NoAddRefundF = 14
                End Select
                CancelAllF = False
            Case Else
                NoAddRefundF = 0
                CancelAllF = False
        End Select

        If CPCT = 0 And Refund <> 0 Then CPCT = Cancellation_Prorata_By_Refund(ANO, Effective_Date, Refund)

        Dim tParam(17) As Object
        tParam(0) = ""  'C/I Number
        tParam(1) = BookingDate
        tParam(2) = Effective_Date
        tParam(3) = OpenFlag
        tParam(4) = LANO
        tParam(5) = Remarks
        tParam(6) = CPCT
        tParam(7) = Description
        tParam(8) = ExternalF
        tParam(9) = Refno
        tParam(10) = RefDate
        tParam(11) = Branch
        tParam(12) = TOC
        tParam(13) = NoAddRefundF
        tParam(14) = Wording
        tParam(15) = IIf(CancelAllF, "A", "")
        tParam(16) = Reason
        tParam(17) = REFUNDTYPE

        If Not PreCancelConditionsOK(ANO, Effective_Date, OpenFlag, CancelAllF, TOC, NoAddRefundF, ExternalF, StrMsg) Then
            GoTo errmsg
        End If

        If Not CancelAllF Then
            Fee_ProfileID = tostr(GetFieldValue(FBuffer(GetFieldIndex("Fee_ProfileID", Findex))))
            Fee_ID = tostr(GetFieldValue(FBuffer(GetFieldIndex("FEE_ID", Findex))))
            Fee_Currency = tostr(GetFieldValue(FBuffer(GetFieldIndex("FEE_CURRENCY", Findex))))
            Fee_Remark = tostr(GetFieldValue(FBuffer(GetFieldIndex("FEE_REMARK", Findex))))
            Fee_Amount = toval(GetFieldValue(FBuffer(GetFieldIndex("FEE_AMOUNT", Findex))))
            Fee_AmountPCT = toval(GetFieldValue(FBuffer(GetFieldIndex("FEE_AMOUNTPCT", Findex))))

            Duty_ProfileID = tostr(GetFieldValue(FBuffer(GetFieldIndex("Duty_ProfileID", Findex))))
            Duty_ID = tostr(GetFieldValue(FBuffer(GetFieldIndex("DUTY_ID", Findex))))
            Duty_Currency = tostr(GetFieldValue(FBuffer(GetFieldIndex("Duty_Currency", Findex))))
            Duty_Remark = tostr(GetFieldValue(FBuffer(GetFieldIndex("Duty_Remark", Findex))))
            Duty_Amount = toval(GetFieldValue(FBuffer(GetFieldIndex("Duty_Amount", Findex))))
            Duty_AmountPCT = toval(GetFieldValue(FBuffer(GetFieldIndex("Duty_AmountPCT", Findex))))

            Fee_ProfileID_1 = tostr(GetFieldValue(FBuffer(GetFieldIndex("Fee_ProfileID_1", Findex))))
            Fee_ID_1 = tostr(GetFieldValue(FBuffer(GetFieldIndex("FEE_ID_1", Findex))))
            Fee_Currency_1 = tostr(GetFieldValue(FBuffer(GetFieldIndex("FEE_CURRENCY_1", Findex))))
            Fee_Remark_1 = tostr(GetFieldValue(FBuffer(GetFieldIndex("FEE_REMARK_1", Findex))))
            Fee_Amount_1 = toval(GetFieldValue(FBuffer(GetFieldIndex("FEE_AMOUNT_1", Findex))))
            Fee_AmountPCT_1 = toval(GetFieldValue(FBuffer(GetFieldIndex("FEE_AMOUNTPCT_1", Findex))))

            Duty_ProfileID_1 = tostr(GetFieldValue(FBuffer(GetFieldIndex("Duty_ProfileID_1", Findex))))
            Duty_ID_1 = tostr(GetFieldValue(FBuffer(GetFieldIndex("DUTY_ID_1", Findex))))
            Duty_Currency_1 = tostr(GetFieldValue(FBuffer(GetFieldIndex("Duty_Currency_1", Findex))))
            Duty_Remark_1 = tostr(GetFieldValue(FBuffer(GetFieldIndex("Duty_Remark_1", Findex))))
            Duty_Amount_1 = toval(GetFieldValue(FBuffer(GetFieldIndex("Duty_Amount_1", Findex))))
            Duty_AmountPCT_1 = toval(GetFieldValue(FBuffer(GetFieldIndex("Duty_AmountPCT_1", Findex))))
        End If

        Dim FeeParam(9) As Object
        Dim SQL As String

        If ANO = LANO And Not OpenFlag Then
            NewANO = Me.Direct_Call_Process_Execute("ProcessExt.NetV3.PROCLIB", "CancelMaster", ANO, tParam, , , )
            If NewANO = 0 Then
                StrMsg = "Process Cancel Master Failed !" & vbCrLf & Me.ErrDesc & vbCrLf
                GoTo errmsg
            End If

            ANO = NewANO
            LANO = NewANO

            If Not db.Execute("Update Acceptance Set BID=" & BID & ", ASource='" & ASource & "', BatchNo='" & BatchNo & "', Comment='" & Comment & "', Notes='" & Notes & "' Where LANO=" & NewANO) Then
                StrMsg = "Process Update Batch No Failed !" & vbCrLf & db.ErrDesc & vbCrLf
                GoTo errmsg
            End If

            If (Fee_Currency <> "" OrElse Fee_ID <> "") And (Fee_Amount <> 0 OrElse Fee_AmountPCT <> 0) Then

                Sql = "Select top 1 F.FDID, Currency.Currency from FDTAB F "
                If Fee_Currency <> "" Then
                    Sql = Sql & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Fee_Currency & "' AND CURRENCY.ALLOWEDF=1)"
                Else
                    Sql = Sql & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY=F.Currency)"
                End If
                Sql = Sql & " Where F.ATYPE in ('C','ALL') and LEFT(F.FDType,1) = 'F' "
                If Fee_ID <> "" Then
                    Sql = Sql & " and F.FDID = '" & Fee_ID & "'"
                End If
                rs = db.OpenRemoteSet(Sql)
                Fee_ID = rs.fields("FDID")

                FeeParam(0) = IIf(tostr(Fee_ProfileID) = "", "<Payor>", tostr(Fee_ProfileID))
                FeeParam(1) = Fee_ID
                FeeParam(2) = rs.fields("Currency")
                FeeParam(3) = Fee_Amount
                FeeParam(4) = Fee_AmountPCT
                FeeParam(5) = Fee_Remark
                FeeParam(6) = 0
                FeeParam(7) = False
                FeeParam(8) = False
                FeeParam(9) = toval(rs.fields("AmountPCTBased"))
                If Not Add_Fee_Duty(NewANO, FeeParam) Then
                    StrMsg = StrMsg & "Add Fee Failed !" & vbCrLf
                    GoTo errmsg
                End If
            End If

            If (Fee_Currency_1 <> "" OrElse Fee_ID_1 <> "") And (Fee_Amount_1 <> 0 OrElse Fee_AmountPCT_1 <> 0) Then
                Sql = "Select top 1 F.FDID, Currency.Currency from FDTAB F "
                If Fee_Currency_1 <> "" Then
                    Sql = Sql & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY='" & Fee_Currency_1 & "' AND CURRENCY.ALLOWEDF=1)"
                Else
                    Sql = Sql & " INNER JOIN CURRENCY ON (CURRENCY.CURRENCY=F.Currency)"
                End If
                Sql = Sql & " Where F.ATYPE in ('C','ALL') and LEFT(F.FDType,1) = 'F' "
                If Fee_ID_1 <> "" Then
                    Sql = Sql & " and F.FDID = '" & Fee_ID_1 & "'"
                End If
                rs = db.OpenRemoteSet(Sql)
                Fee_ID_1 = rs.fields("FDID")

                FeeParam(0) = IIf(tostr(Fee_ProfileID_1) = "", "<Payor>", tostr(Fee_ProfileID_1))
                FeeParam(1) = Fee_ID_1
                FeeParam(2) = rs.fields("Currency")
                FeeParam(3) = Fee_Amount_1
                FeeParam(4) = Fee_AmountPCT_1
                FeeParam(5) = Fee_Remark_1
                FeeParam(6) = 0
                FeeParam(7) = False
                FeeParam(8) = False
                FeeParam(9) = toval(rs.fields("AmountPCTBased"))
                If Not Add_Fee_Duty(NewANO, FeeParam) Then
                    StrMsg = StrMsg & "Add Fee Failed !" & vbCrLf
                    GoTo errmsg
                End If
            End If


