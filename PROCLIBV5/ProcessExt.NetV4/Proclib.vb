    Private Function Short_Period_Prorata(ByVal TOC As String, ByVal SDate As Date, ByVal EDate As Date, ByVal Basis As String) As Double
        Dim rsP As RemoteSet
        Dim NOP As Double
        Dim Diff As Integer

        'M
        If Basis = "M" Then
            NOP = DateDiff(DateInterval.Month, SDate, EDate)

            Diff = DateDiff(DateInterval.Day, DateAdd(DateInterval.Month, NOP, SDate), EDate)
            NOP = NOP + Diff / 30
            rsP = db.OpenQueryDef("QPREMIUM_SCALE", adOpenForwardonly, TOC, "M", NOP)
            If Not rsP.Eof Then
                Short_Period_Prorata = rsP.fields("PCT")
            Else
                Short_Period_Prorata = 100
            End If
        Else
            NOP = DateDiff(DateInterval.Day, SDate, EDate)
            rsP = db.OpenQueryDef("QPREMIUM_SCALE", adOpenForwardonly, TOC, "D", NOP)
            If Not rsP.Eof Then
                Short_Period_Prorata = rsP.fields("PCT")
            Else
                Short_Period_Prorata = 100
            End If
        End If
    End Function
    Private Function Short_Period_Calc(ByVal TOC As String, ByVal SDate As Date, ByVal EDate As Date, ByVal PDate As Date) As Double
        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Day, -1, EDate), DateAdd(DateInterval.Month, 1, SDate)) > 0 Then
            ' Short Period Policy
            Short_Period_Calc = Short_Period_Prorata(TOC, SDate, PDate, "D")
        Else
            Short_Period_Calc = Short_Period_Prorata(TOC, SDate, PDate, "M")
        End If
    End Function

    Private Function Save_Object_Info(ByVal ANO As Long, ByVal findex() As String, ByVal fbuffer() As String, ByVal PDate As Date, ByVal TOC As String, ByVal Segment As String) As Boolean
        Dim i As Integer
        Dim rs As RemoteSet

        On Error GoTo ErrMsg

        rs = db.OpenRemoteSet("Select * from AInfo Where ANO=" & ANO)
        If rs.Eof Then
            rs.AddNew()
            rs.fields("ANO") = ANO
        Else
            If Not db.Execute("Delete from AccSearch Where ANO=" & ANO) Then GoTo ErrMsg
            rs.Edit()
        End If

        For i = 1 To 15
            rs.fields("FLDID" & i) = GetFieldValue(fbuffer(GetFieldIndex("FLDID" & i, findex)))
            rs.fields("ValueID" & i) = GetFieldValue(fbuffer(GetFieldIndex("ValueID" & i, findex)))
            rs.fields("ValueDesc" & i) = GetFieldValue(fbuffer(GetFieldIndex("ValueDesc" & i, findex)))
            If rs.fields("ValueID" & i) = "" And rs.fields("ValueDesc" & i) <> "" Then
                rs.fields("ValueID" & i) = Get_ValueID(rs.fields("FLDID" & i), rs.fields("ValueDesc" & i), PDate, TOC, Segment)
            End If
            ' Setting Acceptance Search Field
            If toval(GetFieldValue(fbuffer(GetFieldIndex("FLDSEARCH" & i, findex)))) And tostr(rs.fields("FLDID" & i)) <> "" And tostr(rs.fields("ValueID" & i)) <> "" Then
                If Not Set_AccSearch(ANO, rs.fields("FLDID" & i), rs.fields("ValueID" & i)) Then GoTo ErrMsg
            End If
        Next i

        If Not rs.Update Then GoTo ErrMsg
        Save_Object_Info = True
        Exit Function
ErrMsg:
        StrMsg = StrError(StrMsg)
        Save_Object_Info = False
    End Function

    Private Function Save_Interest_Info_from_Object_Info(ByVal ANO As Long, ByVal findex() As String, ByVal fbuffer() As String, ByVal PDate As Date, ByVal TOC As String, ByVal Segment As String) As Boolean
        Try
            Dim i As Integer
            Dim j As Integer
            Dim rs As RemoteSet

            ' Save in Interest Info
            rs = db.OpenRemoteSet("Select * from IInfo Where Exists (Select INO from ICover Where ICover.INO=IInfo.INO and ICover.ANO=" & ANO & ")")
            Do While Not rs.Eof
                rs.Edit()
                For i = 1 To 15
                    If rs.fields("FLDID" & i) <> "" Then
                        For j = 1 To 15
                            If GetFieldValue(fbuffer(GetFieldIndex("FLDID" & j, findex))) <> "" Then
                                If rs.fields("FLDID" & i) = GetFieldValue(fbuffer(GetFieldIndex("FLDID" & j, findex))) Then
                                    rs.fields("ValueID" & i) = GetFieldValue(fbuffer(GetFieldIndex("ValueID" & j, findex)))
                                    rs.fields("ValueDesc" & i) = GetFieldValue(fbuffer(GetFieldIndex("ValueDesc" & j, findex)))
                                    Exit For
                                End If
                            Else
                                Exit For
                            End If
                        Next
                    Else
                        Exit For
                    End If
                Next i
                If Not rs.Update Then Throw New Exception(rs.ErrDesc)
                rs.MoveNext()
            Loop
            Save_Interest_Info_from_Object_Info = True
        Catch ex As Exception
            StrMsg = ex.Message
            Save_Interest_Info_from_Object_Info = True
        End Try
    End Function
