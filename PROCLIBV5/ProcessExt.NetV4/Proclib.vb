        Dim CT As String
        Dim PolicyType As String
        Dim CoverNo As String
        Dim NewCoverNo As String
        Dim NewRegNo As String
        Dim NewRefNo As String
        Dim RenewableF As Boolean

        On Error GoTo errmsg

        rsSrc = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        rsDst = db.OpenRemoteSet("Select * from Cover Where 1<>1")
        If Not rsSrc.Eof Then
            CoverNo = rsSrc.fields("CoverNo")
            PolicyType = rsSrc.fields("PolicyType")

            rs = db.OpenRemoteSet("Select Branch, TOC, CT from Acceptance Where ANO=" & ANO)
            Branch = rs.fields("Branch")
            TOC = rs.fields("TOC")
            CT = rs.fields("CT")

            Dim NoRiskAccumulationF As Boolean
            Dim AnnualTreatyF As Boolean
            rs = db.OpenRemoteSet("Select NoRiskAccumulationF, AnnualTreatyF, RenewableF from TOC Where TOC='" & TOC & "'")
            NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
            AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))
            RenewableF = toval(rs.fields("RenewableF"))

            rs = db.OpenRemoteSet("Select P2.RenewableF from PolicyType P1, PTClass P2, TOC Where P1.PolicyType=P2.PolicyType and P1.PolicyType='" & PolicyType & "' and (P1.ISType in ('A') or (P1.ISType in ('D') and '" & ISType & "' in ('I','C','L')) or (P1.ISType in ('I') and '" & ISType & "' in ('R','T'))) and P2.COB=TOC.COB and (P2.TOC='<All>' or P2.TOC=TOC.TOC) and TOC.TOC='" & TOC & "'")
            If rs.Eof Then
                StrMsg = "Policy Type Not Setup for ISType : " & ISType & " !"
                GoTo errmsg
            End If
            RenewableF = RenewableF And toval(rs.fields("RenewableF"))

            NewCoverNo = GetDocumentNumbering("COV", PolicyType, ISType, rsSrc.fields("CoverDate"), Branch, TOC, CT)
            If NewCoverNo = "" Then
                StrMsg = "Generate Cover No./Quotation No. Failed !"
                GoTo errmsg
            End If

            'Copy Cover & Related Information
            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("CoverNo") = NewCoverNo
            rsDst.fields("ASource") = "UW"          ' Underwriting Application Source
            rsDst.fields("CStatus") = "A"           ' Request Status
            rsDst.fields("ISType") = ISType
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("CTime") = Time()
            rsDst.fields("UserId") = db_user
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("VSeqNo") = 0
            rsDst.fields("ANO") = -1
            rsDst.fields("pCNO") = -1
            rsDst.fields("FOLLOWUP") = ""
            rsDst.fields("Memo") = ""
            rsDst.fields("Comment") = ""
            NewCNO = db.GetIdentity("Cover") + 1
            rsDst.fields("CNO") = NewCNO
            rsDst.fields("OCNO") = NewCNO
            rsDst.fields("CertNum") = 0
            rsDst.fields("PUserID") = db_user
            rsDst.fields("PUSerDate") = Today.Date
            rsDst.fields("PUSerTime") = Time()
            rsDst.fields("CUserID") = ""
            rsDst.fields("CLoseDate") = ""
            rsDst.fields("CLoseTime") = ""
            rsDst.fields("AUserID") = db_user
            rsDst.fields("AUSerDate") = Today.Date
            rsDst.fields("AUserTime") = Time()
            If Not rsDst.Update Then GoTo errmsg
            If Not CopyCover(CNO, NewCNO, rsDst.fields("ISType")) Then GoTo errmsg

            rsSrc.CloseRemoteSet()
            rsDst.CloseRemoteSet()

            'Copy Acceptance & Related Information
            rsDst = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
            rsSrc = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
            If Not rsSrc.Eof Then
                NewRegNo = GetDocumentNumbering("REG", PolicyType, ISType, Today.Date, Branch, TOC, CT)
                If NewRegNo = "" Then
                    StrMsg = "Generate Register No./Closing Instruction No. Failed !"
                    GoTo errmsg
                End If
                rsDst.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
                If rsDst.fields("RefNo") = CoverNo Then
                    NewRefNo = NewCoverNo
                    rsDst.fields("RefNo") = NewRefNo
                Else
                    If rsDst.fields("RefNo") = "" Then
                        If Not CBool(toval(GetAppSetting("GenerateRefNoF"))) Then
                            NewRefNo = NewCoverNo
                            rsDst.fields("RefNo") = NewRefNo
                        Else
                            NewRefNo = GetDocumentNumbering("REF", PolicyType, ISType, Today.Date, Branch, TOC, CT)
                            rsDst.fields("RefNo") = NewRefNo
                        End If
                    Else
                        NewRefNo = rsDst.fields("RefNo")
                    End If
                End If
                rsDst.fields("RegNo") = NewRegNo
                rsDst.fields("RegDate") = Today.Date
                rsDst.fields("AType") = "N"             ' New Policy
                rsDst.fields("AStatus") = "W"           ' Waiting Policy
                rsDst.fields("pAStatus") = ""           ' Previous Acceptance Status (AStatus)
                rsDst.fields("PStatus") = "I"           ' Inconsistent
                rsDst.fields("RANO") = -1               ' Renewal Acceptance
                rsDst.fields("PANO") = -1               ' Previous ANO
                rsDst.fields("LANO") = -1               ' Link to Master Acceptance
                rsDst.fields("CANO") = -1               ' Conjunction Reference ANO
                rsDst.fields("SNO") = -1                ' Servicing Reference No
                rsDst.fields("BANO") = -1               ' Branch Reference NO
                rsDst.fields("BatchNo") = ""
                rsDst.fields("BID") = 0
                rsDst.fields("ASource") = ""
                rsDst.fields("CPolicyNo") = ""
                rsDst.fields("PolicyNo") = ""
                rsDst.fields("CertificateNo") = ""
                rsDst.fields("PDate") = rsDst.fields("SDate")
                rsDst.fields("PPDate") = rsDst.fields("EDate")
                rsDst.fields("Remarks") = ""
                rsDst.fields("Memo") = ""
                rsDst.fields("Comment") = ""
                rsDst.fields("ConjunctionF") = 0
                rsDst.fields("BackDatedF") = 0
                rsDst.fields("CNO") = NewCNO
                rsDst.fields("UserID") = db_user
                rsDst.fields("CDate") = Today.Date
                rsDst.fields("CTime") = Time()
                rsDst.fields("LUserID") = db_user
                rsDst.fields("LDate") = Today.Date
                rsDst.fields("LTime") = Time()
                rsDst.fields("ESeqNo") = 0
                rsDst.fields("EESeqNo") = 0
                rsDst.fields("ERSeqNo") = 0
                rsDst.fields("EMethod") = ""
                rsDst.fields("CPCT") = 0
                rsDst.fields("Renewal") = 0
                rsDst.fields("BackDatedF") = 0
                rsDst.fields("RequestF") = False
                rsDst.fields("RequestMessage") = ""
                rsDst.fields("RequestName") = ""
                rsDst.fields("Reason") = ""
                rsDst.fields("Matters") = ""
                rsDst.fields("Notes") = ""
                rsDst.fields("CUserID") = ""
                rsDst.fields("CLoseDate") = ""
                rsDst.fields("CloseTime") = ""
                rsDst.fields("RUserID") = ""
                rsDst.fields("RUSerDate") = ""
                rsDst.fields("RUSerTime") = ""
                rsDst.fields("AUserID") = ""
                rsDst.fields("AUSerDate") = ""
                rsDst.fields("AUSerTime") = ""
                NewANO = db.GetIdentity("Acceptance") + 1
                rsDst.fields("SplitDNCNF") = False
                rsDst.fields("ANO") = NewANO
                rsDst.fields("OANO") = NewANO
                rsDst.fields("NoRefundF") = 0
                rsDst.fields("NoRiskAccumulationF") = NoRiskAccumulationF
                rsDst.fields("AnnualTreatyF") = AnnualTreatyF
                rsDst.fields("SecurityNo") = ""
                rsDst.fields("RenewableF") = RenewableF
                rsDst.fields("BVATPCT") = 0
                rsDst.fields("TVATPCT") = 0
                rsDst.fields("COCNO") = ""
                rsDst.fields("ExtRSDate") = ""
                rsDst.fields("ExtREDate") = ""
                rsDst.fields("ExtRPeriod") = 0
                rsDst.fields("SysuserID") = ""
                If Not rsDst.Update Then GoTo errmsg
                If Not CopyPolicyAcceptance(ANO, NewANO, False) Then GoTo errmsg
            Else
                StrMsg = "No Policy Data !"
                GoTo errmsg
            End If
            rsSrc.CloseRemoteSet()
            rsDst.CloseRemoteSet()

            CopyPolicy = NewANO
            Exit Function
        Else
            StrMsg = "No Policy Data !"
            GoTo errmsg
        End If
errmsg:
        StrMsg = StrError(StrMsg)
        CopyPolicy = 0
    End Function
    Private Function CopyCover(ByVal CNO As Long, ByVal NewCNO As Long, Optional ByVal ISType As String = "") As Boolean
        If ISType = "C" Or ISType = "R" Or ISType = "T" Or ISType = "" Then ' Coinsurance Member or Inward Facultative
            If Not CopyCovDetail("Isource", CNO, NewCNO) Then GoTo errmsg
        End If

        If ISType = "L" Or ISType = "C" Or ISType = "" Then  ' Coinsurance
            If Not CopyCovDetail("Coinsurance", CNO, NewCNO) Then GoTo errmsg

        End If
        If Not CopyCovDetail("UInfo", CNO, NewCNO) Then GoTo errmsg
        CopyCover = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyCover = False
    End Function

    Private Function CopyCovDetail(ByVal TName As String, ByVal CNO As Long, ByVal NewCNO As Long) As Boolean
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet

        rsDst = db.OpenRemoteSet("Select * from " & TName & " Where 1<>1", adOpenKeyset)
        rsSrc = db.OpenRemoteSet("Select * from " & TName & " Where CNO=" & CNO, adOpenForwardonly)
        Do While Not rsSrc.Eof
            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("CNO") = NewCNO
            If Not rsDst.UpdateRow Then GoTo errmsg
            rsSrc.MoveNext()
        Loop
        If Not rsDst.Eof Then
            If Not rsDst.Update Then GoTo errmsg
        End If
        rsDst.CloseRemoteSet()
        rsSrc.CloseRemoteSet()

        CopyCovDetail = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyCovDetail = False
    End Function
    Private Function CopyPolicyAcceptance(ByVal ANO As Long, ByVal NewANO As Long, ByVal MasterF As Boolean) As Boolean
        Dim rs As RemoteSet

        If Not CopyInterest(ANO, NewANO, , True) Then GoTo errmsg

        If Not CopyAccDetail("RCover", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("RCoverDet", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccDed", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccDA", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccCA", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("RArrHeader", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("PCalc", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("RCalc", ANO, NewANO) Then GoTo errmsg
        If Not db.Execute("Update RCalc Set SANO=ANO Where ANO=" & NewANO) Then GoTo errmsg
        If Not db.Execute("Update ICalc Set SANO=ANO Where ANO=" & NewANO) Then GoTo errmsg

        If Not CopyAccDetail("AccSection", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AInfo", ANO, NewANO) Then GoTo errmsg

        If Not CopyAccDetail("AccCla", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccCon", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccEx", ANO, NewANO) Then GoTo errmsg
        If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & NewANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

        If Not CopyAccDetail("AccBS", ANO, NewANO, "(Select ANO,ID,BSTYPE,Fee,FeeAmount,FeeRate,Discount,NetF,NetGroupF,MemberF,GrossF,MemberFeeF,PreferredF,NotMinimumPremiumF,GrossUpF,CommPoolF,UpFee,UpFeeAmount,UpFeeRate,LUserID,LDate,NetFee,NetUpF,TreatyOverridingF,CommAfterMinPremiumF,NoRefundF,BSID,GrossBLF,AgentType,NoProrataF,UseCurrTypeF, BSType as OBSType, Installment, PICName, PICPhone, PICMobile, PICEmail from ACCBS Where ANO=" & ANO & ")") Then GoTo errmsg

        If Not CopyAccDetail("AAccBS", ANO, NewANO, "(Select ANO,ID,BSTYPE,Fee,FeeAmount,FeeRate,Discount,NetF,NetGroupF,MemberF,GrossF,MemberFeeF,PreferredF,NotMinimumPremiumF,GrossUpF,CommPoolF,UpFee,UpFeeAmount,UpFeeRate,LUserID,LDate,NetFee,NetUpF,TreatyOverridingF,CommAfterMinPremiumF,NoRefundF,BSID,GrossBLF,AgentType,NoProrataF,UseCurrTypeF, BSType as OBSType, Installment, PICName, PICPhone, PICMobile, PICEmail from AAccBS Where ANO=" & ANO & ")") Then GoTo errmsg

        If Not CopyAccDetail("AccSearch", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("Payor", ANO, NewANO) Then GoTo errmsg

        If Not CopyAccDetail("APayor", ANO, NewANO) Then GoTo errmsg

        If Not CopyAccDetail("AccFD", ANO, NewANO) Then GoTo errmsg


        ' Set Payor to Default only if SysTab.DefaultPayorF=1
        If Not db.Execute("Update Payor Set DefaultPayorF=1, Grace=0, WPC=0 from Payor Inner Join SysTab on (1=1) Where Systab.DefaultPayorF=1 and Payor.ANO=" & NewANO) Then GoTo errmsg
        If Not MasterF Then
            If Not db.Execute("Update APayor Set Grace=0, WPC=0 Where ANO=" & NewANO) Then GoTo errmsg
        End If

        If Not MasterF Then
            Dim AnnualTreatyF As Boolean

            Dim SDate As Date
            Dim EDate As Date

            Dim M_SDate As Date
            Dim M_EDate As Date
            Dim OpenFlag As Boolean

            rs = db.OpenRemoteSet("Select C.OpenFlag, A.SDate, A.EDate, coalesce(mA.SDate,A.SDate) as M_SDate, coalesce(mA.EDate,A.EDate) as M_EDate, A.AnnualTreatyF from Acceptance A Left Join Acceptance mA on (mA.ANO=A.LANO) inner Join Cover C on (C.CNO=A.CNO) Where A.ANO=" & NewANO)
            OpenFlag = toval(rs.fields("OpenFlag"))
            SDate = todate(rs.fields("SDate"))
            EDate = todate(rs.fields("EDate"))
            M_SDate = todate(rs.fields("M_SDate"))
            M_EDate = todate(rs.fields("M_EDate"))
            AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))

            rs = db.OpenQueryDef("QRArrHeader", adOpenKeyset, NewANO)
            Dim PolicyTreatyF As Boolean = toval(rs.fields("PolicyTreatyF"))
            Dim RDate As Date
            Dim NRDate As Date

            If AnnualTreatyF Then
                If OpenFlag And Not PolicyTreatyF Then
                    RDate = SDate
                    NRDate = DateAdd(DateInterval.Month, 12, RDate)
                    If DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                Else
                    RDate = M_SDate
                    NRDate = DateAdd(DateInterval.Month, 12, RDate)
                    If DateDiff(DateInterval.Day, M_EDate, NRDate) > 0 Then NRDate = M_EDate
                End If
            Else
                If OpenFlag And Not PolicyTreatyF Then
                    RDate = SDate
                    NRDate = EDate
                Else
                    RDate = M_SDate
                    NRDate = IIf(M_EDate <= EDate, EDate, M_EDate)
                End If
            End If

            rs.Edit()
            rs.fields("ManualF") = False
            rs.fields("Status") = "R"
            rs.fields("PDate") = RDate
            rs.fields("PPDate") = NRDate
            rs.fields("LDate") = Today.Date
            rs.fields("LUserID") = db_user
            rs.fields("NCDate") = RDate
            rs.fields("RDate") = RDate
            rs.fields("NRDate") = NRDate
            rs.fields("RAmount") = rs.fields("RAmount") + rs.fields("FAmount")
            rs.fields("Retention") = rs.fields("Retention") + rs.fields("FShare")
            rs.fields("FAmount") = 0
            rs.fields("FShare") = 0
            If Not rs.Update Then GoTo errmsg
        End If

        rs = db.OpenRemoteSet("Select * from RArrDet Where ANO=" & ANO)
        Do While Not rs.Eof
            If Copy_Facultative(ANO, NewANO, rs.fields("FID")) = "" Then GoTo errmsg
            rs.MoveNext()
        Loop

        CopyPolicyAcceptance = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyPolicyAcceptance = False
    End Function
    Private Function Copy_Facultative(ByVal ANO As Long, ByVal NewANO As Long, ByVal FID As String) As String
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet

        Dim rsSrc1 As RemoteSet
        Dim rsDst1 As RemoteSet

        Dim rs As RemoteSet
        Dim Branch As String
        Dim TOC As String
        Dim CT As String
        Dim PolicyType As String
        Dim ISType As String
        Dim OANO As Long

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select A1.OANO, A1.SDate, A1.EDate, A1.Branch, A1.CT, A1.TOC, C1.PolicyType, C1.ISType, A1.AStatus from Acceptance A1, Cover C1 Where C1.CNO=A1.CNO and A1.ANO=" & NewANO)
        Branch = tostr(rs.fields("Branch"))
        TOC = tostr(rs.fields("TOC"))
        CT = tostr(rs.fields("CT"))
        PolicyType = tostr(rs.fields("PolicyType"))
        ISType = tostr(rs.fields("ISType"))
        OANO = toval(rs.fields("OANO"))
        If tostr(rs.fields("AStatus")) <> "W" Then
            StrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        rsSrc = db.OpenRemoteSet("Select * from RArrDet Where ANO=" & ANO & " and FID='" & FID & "'")
        rsDst = db.OpenRemoteSet("Select * from RArrDet Where 1<>1")
        Do While Not rsSrc.Eof
            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("ANO") = NewANO
            FID = GetDocumentNumbering("FS", PolicyType, ISType, Today.Date, Branch, TOC, CT)
            If FID = "" Then
                StrMsg = "Generate Facultative ID Failed !"
                GoTo errmsg
            End If

            rsDst.fields("FID") = FID
            rsDst.fields("AType") = "N"
            rsDst.fields("Status") = "O"
            rsDst.fields("ESeqNo") = 0
            rsDst.fields("UserID") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            If Not rsDst.Update Then GoTo errmsg

            rsSrc1 = db.OpenRemoteSet("Select * from FPart Where ANO=" & ANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FPart Where 1<>1")
            Do While Not rsSrc1.Eof
                Dim SlipNo As String = rsSrc1.fields("SlipNo")
                Dim DocNo As String = rsSrc1.fields("DocNo")

                If DocNo <> "" Then
                    SlipNo = DocNo & "-" & Format(db.GetIdentity(Format(OANO, "0000000000") + "-" + DocNo) + 1, "000")
                Else
                    SlipNo = FID
                End If

                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = NewANO
                rsDst1.fields("FID") = FID
                rsDst1.fields("SLIPNO") = SlipNo
                rsDst1.fields("DocNo") = DocNo
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FPartDet Where ANO=" & ANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FPartDet Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = NewANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FSecurity Where ANO=" & ANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FSecurity Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = NewANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FDeductible Where ANO=" & ANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FDeductible Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = NewANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FACCla Where ANO=" & ANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FACCla Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = NewANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FACCon Where ANO=" & ANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FACCon Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = NewANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FACEx Where ANO=" & ANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FACEx Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = NewANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FInfo Where ANO=" & ANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FInfo Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = NewANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc.MoveNext()
        Loop
        Copy_Facultative = FID
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Copy_Facultative = ""
    End Function

    Private Function Save_Facultative_Data(ByVal Param As Object, ByVal findex() As String, ByVal fbuffer() As String, ByVal bufferdata As Object) As String
        Dim i As Integer
        Dim rs As RemoteSet

        On Error GoTo errmsg

        Dim ANO As Long = Param(0)
        Dim FID As String = Param(1)

        Dim MaxRows As Integer
        Dim MaxCols As Integer

        Dim SlipNo As String
        Dim JPSlipNo As String
        Dim SDate As Date
        Dim AType As String
        Dim FullCoverF As Boolean
        Dim ID As String
        Dim DocNo As String

        DocNo = GetFieldValue(fbuffer(GetFieldIndex("DocNo", findex)))
        JPSlipNo = GetFieldValue(fbuffer(GetFieldIndex("JPSlipNo", findex)))
        SlipNo = GetFieldValue(fbuffer(GetFieldIndex("SLIPNO", findex)))
        SDate = GetFieldValue(fbuffer(GetFieldIndex("SDATE", findex)))
        FullCoverF = GetFieldValue(fbuffer(GetFieldIndex("FullCoverF", findex)))
        ID = GetFieldValue(fbuffer(GetFieldIndex("ID", findex)))
        rs = db.OpenQueryDef("QRArrDet", adOpenKeyset, ANO, FID)
        If rs.Eof Then
            rs = db.OpenRemoteSet("Select Acceptance.OANO, Acceptance.TOC, Cover.PolicyType, Cover.ISType, Acceptance.Branch, Acceptance.CT from Cover,Acceptance where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
            If Not rs.Eof Then
                FID = GetDocumentNumbering("FS", tostr(rs.fields("PolicyType")), tostr(rs.fields("ISType")), Today.Date, tostr(rs.fields("Branch")), tostr(rs.fields("TOC")), tostr(rs.fields("CT")))
                If FID = "" Then
                    StrMsg = "Generate Facultative ID Failed !"
                    GoTo errmsg
                End If
                If SlipNo = "" Then
                    If DocNo <> "" Then
                        SlipNo = DocNo & "-" & Format(db.GetIdentity(Format(rs.fields("OANO"), "0000000000") + "-" + DocNo) + 1, "000")
                    Else
                        SlipNo = FID
                    End If
                End If
                If JPSlipNo = "" Then JPSlipNo = SlipNo
            End If
            rs = db.OpenRemoteSet("Select * from RArrDet Where 1<>1")
            rs.AddNew()
            rs.fields("ANO") = ANO
            rs.fields("FID") = FID
            rs.fields("AType") = "N"
            rs.fields("UserID") = db_user
            rs.fields("CDate") = Today.Date
        Else
            rs.Edit()
        End If
        AType = tostr(rs.fields("AType"))
        FID = tostr(rs.fields("FID"))
        rs.fields("Status") = "O"
        rs.fields("SDate") = GetFieldValue(fbuffer(GetFieldIndex("SDate", findex)))
        rs.fields("EDate") = GetFieldValue(fbuffer(GetFieldIndex("EDate", findex)))
        rs.fields("RType") = GetFieldValue(fbuffer(GetFieldIndex("RType", findex)))
        rs.fields("Share") = GetFieldValue(fbuffer(GetFieldIndex("Share", findex)))
        rs.fields("FLPCT") = GetFieldValue(fbuffer(GetFieldIndex("FLPCT", findex)))
        rs.fields("CurrencyL") = GetFieldValue(fbuffer(GetFieldIndex("CurrencyL", findex)))
        rs.fields("RateL") = GetFieldValue(fbuffer(GetFieldIndex("RateL", findex)))
        rs.fields("Amount") = GetFieldValue(fbuffer(GetFieldIndex("Amount", findex)))
        rs.fields("Limit") = GetFieldValue(fbuffer(GetFieldIndex("Limit", findex)))
        rs.fields("Excess") = GetFieldValue(fbuffer(GetFieldIndex("Excess", findex)))
        rs.fields("Retention") = GetFieldValue(fbuffer(GetFieldIndex("Retention", findex)))
        rs.fields("PCalc") = GetFieldValue(fbuffer(GetFieldIndex("PCalc", findex)))
        rs.fields("CPCT") = GetFieldValue(fbuffer(GetFieldIndex("CPCT", findex)))
        rs.fields("CPRefund") = GetFieldValue(fbuffer(GetFieldIndex("CPRefund", findex)))
        rs.fields("FullCoverF") = FullCoverF
        rs.fields("OriginalF") = GetFieldValue(fbuffer(GetFieldIndex("OriginalF", findex)))
        rs.fields("OnGrossAfterCommF") = GetFieldValue(fbuffer(GetFieldIndex("OnGrossAfterCommF", findex)))
        rs.fields("OnNetRateF") = GetFieldValue(fbuffer(GetFieldIndex("OnNetRateF", findex)))
        rs.fields("UJROHREINS") = GetFieldValue(fbuffer(GetFieldIndex("UJROHREINS", findex)))
        rs.fields("UJROHCEDANT") = GetFieldValue(fbuffer(GetFieldIndex("UJROHCEDANT", findex)))
        rs.fields("Memo") = GetFieldValue(fbuffer(GetFieldIndex("Memo", findex)))
        rs.fields("AcceptedBy") = GetFieldValue(fbuffer(GetFieldIndex("AcceptedBy", findex)))
        rs.fields("AcceptedDate") = GetFieldValue(fbuffer(GetFieldIndex("AcceptedDate", findex)))
        rs.fields("ClaimCoop") = GetFieldValue(fbuffer(GetFieldIndex("ClaimCoop", findex)))
        rs.fields("PrecedeFacCessionF") = GetFieldValue(fbuffer(GetFieldIndex("PrecedeFacCessionF", findex)))
        rs.fields("NoRefundF") = GetFieldValue(fbuffer(GetFieldIndex("NoRefundF", findex)))
        rs.fields("LUserID") = db_user
        rs.fields("LDate") = Today.Date
        rs.fields("JPSlipNo") = JPSlipNo
        rs.fields("JPShare") = GetFieldValue(fbuffer(GetFieldIndex("JPShare", findex)))
        rs.fields("JPComm") = GetFieldValue(fbuffer(GetFieldIndex("JPComm", findex)))
        rs.fields("SysUserID") = GetFieldValue(fbuffer(GetFieldIndex("SysUserID", findex)))
        rs.fields("NotApplyDiscountCFF") = GetFieldValue(fbuffer(GetFieldIndex("NotApplyDiscountCFF", findex)))
        If Not rs.Update Then GoTo errmsg


        rs = db.OpenRemoteSet("Select * from FPart Where ANO=" & ANO & " and FID='" & FID & "'")
        If rs.Eof Then
            rs.AddNew()
        Else
            rs.Edit()
        End If
        rs.fields("ANO") = ANO
        rs.fields("FID") = FID
        rs.fields("SLIPNO") = SlipNo
        rs.fields("DocNo") = DocNo
        rs.fields("ID") = ID
        rs.fields("Code") = GetFieldValue(fbuffer(GetFieldIndex("Code", findex)))
        rs.fields("Comm") = GetFieldValue(fbuffer(GetFieldIndex("Comm", findex)))
        rs.fields("OComm") = GetFieldValue(fbuffer(GetFieldIndex("OComm", findex)))
        rs.fields("ACQCOST") = GetFieldValue(fbuffer(GetFieldIndex("ACQCOST", findex)))
        rs.fields("Currency") = GetFieldValue(fbuffer(GetFieldIndex("Currency", findex)))
        rs.fields("NetRate") = GetFieldValue(fbuffer(GetFieldIndex("NetRate", findex)))
        rs.fields("Unit") = GetFieldValue(fbuffer(GetFieldIndex("Unit", findex)))
        rs.fields("Remarks") = GetFieldValue(fbuffer(GetFieldIndex("Remarks", findex)))
        rs.fields("WPC") = GetFieldValue(fbuffer(GetFieldIndex("WPC", findex)))
        rs.fields("BinderNo") = GetFieldValue(fbuffer(GetFieldIndex("BinderNo", findex)))
        rs.fields("BinderWarranty") = GetFieldValue(fbuffer(GetFieldIndex("BinderWarranty", findex)))
        rs.fields("Share") = GetFieldValue(fbuffer(GetFieldIndex("RShare", findex)))
        If toval(rs.fields("Share")) = 0 Then rs.fields("Share") = 100
        rs.fields("Period") = GetFieldValue(fbuffer(GetFieldIndex("Period", findex)))
        rs.fields("Installment") = GetFieldValue(fbuffer(GetFieldIndex("Installment", findex)))
        rs.fields("Grace") = GetFieldValue(fbuffer(GetFieldIndex("Grace", findex)))
        rs.fields("CommAmount") = GetFieldValue(fbuffer(GetFieldIndex("CommAmount", findex)))
        rs.fields("OCommAmount") = GetFieldValue(fbuffer(GetFieldIndex("OCommAmount", findex)))
        rs.fields("ProfitSharing") = GetFieldValue(fbuffer(GetFieldIndex("ProfitSharing", findex)))
        rs.fields("Discount") = GetFieldValue(fbuffer(GetFieldIndex("Discount", findex)))
        rs.fields("DiscAmount") = GetFieldValue(fbuffer(GetFieldIndex("DiscAmount", findex)))
        rs.fields("BRID") = GetFieldValue(fbuffer(GetFieldIndex("BRID", findex)))
        rs.fields("BRComm") = GetFieldValue(fbuffer(GetFieldIndex("BRComm", findex)))
        For i = 1 To 24
            rs.fields("IDate_" & i) = GetFieldValue(fbuffer(GetFieldIndex("IDate_" & i, findex)))
            rs.fields("IPCT_" & i) = GetFieldValue(fbuffer(GetFieldIndex("IPCT_" & i, findex)))
        Next i
        rs.fields("CPDays") = GetFieldValue(fbuffer(GetFieldIndex("CPDays", findex)))
        rs.fields("CLAIMBYSECURITYF") = GetFieldValue(fbuffer(GetFieldIndex("CLAIMBYSECURITYF", findex)))
        If Not rs.Update Then GoTo errmsg


        If Not FullCoverF Then
            MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1
            MaxCols = CType(bufferdata, Object(,)).GetUpperBound(1) + 1
            If Not db.Execute("Delete from FPartDet where ANO=" & ANO & " and FID='" & FID & "'") Then GoTo errmsg
            rs = db.OpenRemoteSet("Select * from FPArtDet Where 1<>1")
            For i = 0 To MaxRows - 1
                If Trim(bufferdata(i, 0)) <> "" Then
                    rs.AddNew()
                    rs.fields("ANO") = ANO
                    rs.fields("FID") = FID
                    rs.fields("ID") = ID
                    rs.fields("Code") = bufferdata(i, 0)
                    rs.fields("Comm") = toval(bufferdata(i, 1))
                    rs.fields("OComm") = toval(bufferdata(i, 2))
                    rs.fields("NetRate") = toval(bufferdata(i, 3))
                    rs.fields("Unit") = tostr(bufferdata(i, 4))
                    rs.fields("COShare") = toval(bufferdata(i, 5))
                    If Not rs.Update Then GoTo errmsg
                End If
            Next i
            rs.CloseRemoteSet()
        End If

        Save_Facultative_Data = FID
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Facultative_Data = ""
    End Function
    Private Function Save_TC_Data(ByVal Param As Object, ByVal bufferdata1 As Object, ByVal bufferdata2 As Object, ByVal bufferdata3 As Object) As Boolean
        Dim index As Integer
        Dim i As Integer
        Dim rs As RemoteSet
        Dim MaxRows As Integer
        Dim MaxCols As Integer
        Dim bufferdata As Object

        On Error GoTo errmsg

        Dim ANO As Long = Param(0)
        Dim Section As String = Param(1)
        Dim TOPRO As String = Param(2)
        Dim DefaultF As Boolean = Param(3)
        Dim SaveAllF As Boolean = Param(4)
        Dim OrderNo As String

        For index = 0 To 2
            Select Case index
                Case 0
                    bufferdata = bufferdata1
                Case 1
                    bufferdata = bufferdata2
                Case 2
                    bufferdata = bufferdata3
            End Select
            MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1
            MaxCols = CType(bufferdata, Object(,)).GetUpperBound(1) + 1
            For i = 0 To MaxRows - 1
                OrderNo = bufferdata(i, 0)
                If toval(bufferdata(i, 5)) = False Then
                    ' Load TC First
                    Select Case index
                        Case 0
                            If DefaultF Then
                                If TOPRO = "" Then
                                    rs = db.OpenRemoteSet("select D.OrderNo, D.ShortDesc, D.ShortDesc_1, D.Description, D.Description_1, D.Section, D.CompulsoryF from Acceptance A2 inner join Cover C1 on (C1.CNO=A2.CNO) inner Join DefCla D On (D.TOC=A2.TOC) where D.Section='" & Section & "' and A2.ANO=" & ANO & " and D.OrderNo='" & OrderNo & "' Order by D.OrderNo", adOpenForwardonly)
                                Else
                                    rs = db.OpenRemoteSet("select D.OrderNo, D.ShortDesc, D.ShortDesc_1, D.Description, D.Description_1, D.Section, D.CompulsoryF from Acceptance A2 inner join Cover C1 on (C1.CNO=A2.CNO) inner Join TOP_CLA D On (D.TOPRO='" & TOPRO & "') where D.Section='" & Section & "' and A2.ANO=" & ANO & " and D.OrderNo='" & OrderNo & "' Order by D.OrderNo", adOpenForwardonly)
                                End If
                            Else
                                rs = db.OpenRemoteSet("select A1.OrderNo, A1.ShortDesc, A1.ShortDesc_1, A1.Description, A1.Description_1, A1.Section, D.CompulsoryF from AccCla A1 inner Join Acceptance A2 On (A2.ANO=A1.ANO) inner join Cover C1 on (C1.CNO=A2.CNO) Left Join DefCla D On (D.TOC=A2.TOC and D.OrderNo=A1.OrderNo and D.Section=A1.Section) where A1.Section='" & Section & "' and A1.ANO=" & ANO & " and A1.OrderNo='" & OrderNo & "' Order by A1.OrderNo", adOpenForwardonly)
                            End If
                            If rs.Eof Then
                                rs = db.OpenRemoteSet("select G.OrderNo, G.ShortDesc, G.ShortDesc_1, G.Description, G.Description_1 from GenCla G, Acceptance, Cover, TOC where TOC.TOC=Acceptance.TOC and Cover.CNO=Acceptance.CNO and G.COB=TOC.COB and Acceptance.ANO=" & ANO & " and G.OrderNo='" & OrderNo & "' Order by G.OrderNo", adOpenForwardonly)
                            End If
                        Case 1
                            If DefaultF Then
                                If TOPRO = "" Then
                                    rs = db.OpenRemoteSet("select D.OrderNo, D.ShortDesc, D.ShortDesc_1, D.Description, D.Description_1, D.Section, D.CompulsoryF from Acceptance A2 inner join Cover C1 on (C1.CNO=A2.CNO) inner Join DefCon D On (D.TOC=A2.TOC) where D.Section='" & Section & "' and A2.ANO=" & ANO & " and D.OrderNo='" & OrderNo & "' Order by D.OrderNo", adOpenForwardonly)
                                Else
                                    rs = db.OpenRemoteSet("select D.OrderNo, D.ShortDesc, D.ShortDesc_1, D.Description, D.Description_1, D.Section, D.CompulsoryF from Acceptance A2 inner join Cover C1 on (C1.CNO=A2.CNO) inner Join TOP_CON D On (D.TOPRO='" & TOPRO & "') where D.Section='" & Section & "' and A2.ANO=" & ANO & " and D.OrderNo='" & OrderNo & "' Order by D.OrderNo", adOpenForwardonly)
                                End If
                            Else
                                rs = db.OpenRemoteSet("select A1.OrderNo, A1.ShortDesc, A1.ShortDesc_1, A1.Description, A1.Description_1, A1.Section, D.CompulsoryF from AccCon A1 inner Join Acceptance A2 On (A2.ANO=A1.ANO) inner join Cover C1 on (C1.CNO=A2.CNO) Left Join DefCon D On (D.TOC=A2.TOC and D.OrderNo=A1.OrderNo and D.Section=A1.Section) where A1.Section='" & Section & "' and A1.ANO=" & ANO & " and A1.OrderNo='" & OrderNo & "' Order by A1.OrderNo", adOpenForwardonly)
                            End If
                            If rs.Eof Then
                                rs = db.OpenRemoteSet("select G.OrderNo, G.ShortDesc, G.ShortDesc_1, G.Description, G.Description_1 from GenCon G, Acceptance, Cover, TOC where TOC.TOC=Acceptance.TOC and Cover.CNO=Acceptance.CNO and G.COB=TOC.COB and Acceptance.ANO=" & ANO & " and G.OrderNo='" & OrderNo & "' Order by G.OrderNo", adOpenForwardonly)
                            End If
                        Case 2
                            If DefaultF Then
                                If TOPRO = "" Then
                                    rs = db.OpenRemoteSet("select D.OrderNo, D.ShortDesc, D.ShortDesc_1, D.Description, D.Description_1, D.Section, D.CompulsoryF from Acceptance A2 inner join Cover C1 on (C1.CNO=A2.CNO) inner Join DefEx D On (D.TOC=A2.TOC) where D.Section='" & Section & "' and A2.ANO=" & ANO & " and D.OrderNo='" & OrderNo & "' Order by D.OrderNo", adOpenForwardonly)
                                Else
                                    rs = db.OpenRemoteSet("select D.OrderNo, D.ShortDesc, D.ShortDesc_1, D.Description, D.Description_1, D.Section, D.CompulsoryF from Acceptance A2 inner join Cover C1 on (C1.CNO=A2.CNO) inner Join TOP_EX D On (D.TOPRO='" & TOPRO & "') where D.Section='" & Section & "' and A2.ANO=" & ANO & " and D.OrderNo='" & OrderNo & "' Order by D.OrderNo", adOpenForwardonly)
                                End If
                            Else
                                rs = db.OpenRemoteSet("select A1.OrderNo, A1.ShortDesc, A1.ShortDesc_1, A1.Description, A1.Description_1, A1.Section, D.CompulsoryF from AccEx A1 inner Join Acceptance A2 On (A2.ANO=A1.ANO) inner join Cover C1 on (C1.CNO=A2.CNO) Left Join DefEx D On (D.TOC=A2.TOC and D.OrderNo=A1.OrderNo and D.Section=A1.Section) where A1.Section='" & Section & "' and A1.ANO=" & ANO & " and A1.OrderNo='" & OrderNo & "' Order by A1.OrderNo", adOpenForwardonly)
                            End If
                            If rs.Eof Then
                                rs = db.OpenRemoteSet("select G.OrderNo, G.ShortDesc, G.ShortDesc_1, G.Description, G.Description_1 from GenEx G, Acceptance, Cover, TOC where TOC.TOC=Acceptance.TOC and Cover.CNO=Acceptance.CNO and G.COB=TOC.COB and Acceptance.ANO=" & ANO & " and G.OrderNo='" & OrderNo & "' Order by G.OrderNo", adOpenForwardonly)
                            End If
                    End Select
                    bufferdata(i, 2) = tostr(rs.fields("Description"))
                    bufferdata(i, 4) = tostr(rs.fields("Description_1"))
                    bufferdata(i, 5) = True
                End If
            Next

            Select Case index
                Case 0
                    If Not db.Execute("Delete from AccCla where ANO=" & ANO & " and Section='" & Section & "'") Then GoTo errmsg
                    rs = db.OpenRemoteSet("Select * from AccCla Where 1<>1")
                Case 1
                    If Not db.Execute("Delete from AccCon where ANO=" & ANO & " and Section='" & Section & "'") Then GoTo errmsg
                    rs = db.OpenRemoteSet("Select * from AccCon Where 1<>1")
                Case 2
                    If Not db.Execute("Delete from AccEx where ANO=" & ANO & " and Section='" & Section & "'") Then GoTo errmsg
                    rs = db.OpenRemoteSet("Select * from AccEx Where 1<>1")
            End Select

            For i = 0 To MaxRows - 1
                If tostr(bufferdata(i, 0)) <> "" Then
                    rs.AddNew()
                    rs.fields("ANO") = ANO
                    rs.fields("OrderNo") = tostr(bufferdata(i, 0))
                    rs.fields("ShortDesc") = tostr(bufferdata(i, 1))
                    rs.fields("Description") = tostr(bufferdata(i, 2))
                    rs.fields("Section") = Section
                    rs.fields("ShortDesc_1") = tostr(bufferdata(i, 3))
                    rs.fields("Description_1") = tostr(bufferdata(i, 4))
                    If MaxCols > 6 Then
                        rs.fields("Last_Opr") = tostr(bufferdata(i, 6))
                    End If
                    If MaxCols > 7 Then
                        rs.fields("Last_Update") = todate(bufferdata(i, 7))
                    End If
                    If Not rs.UpdateRow Then GoTo errmsg
                End If
            Next
            If Not rs.Eof Then
                If Not rs.Update Then GoTo errmsg
            End If

        Next

        If SaveAllF Then
            rs = db.OpenRemoteSet("Select ANO from Acceptance Where AType in ('N','E') and AStatus='W' and ANO<>LANO and LANO=" & ANO)
            Do While Not rs.Eof
                If Not db.Execute("Delete from AccCla Where ANO=" & rs.fields("ANO")) Then GoTo errmsg
                If Not db.Execute("Delete from AccCon Where ANO=" & rs.fields("ANO")) Then GoTo errmsg
                If Not db.Execute("Delete from AccEx Where ANO=" & rs.fields("ANO")) Then GoTo errmsg
                If Not db.Execute("Insert Into AccCla(ANO,OrderNo,ShortDesc,ShortDesc_1, Description,Description_1, Section, Last_Opr, Last_Update) Select " & rs.fields("ANO") & ", OrderNo,ShortDesc,ShortDesc_1, Description, Description_1, Section, '" & db_user & "','" & Format(Today.Date, "MM/DD/YYYY") & "' from AccCla Where ANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Insert Into AccCon(ANO,OrderNo,ShortDesc,ShortDesc_1, Description,Description_1, Section, Last_Opr, Last_Update) Select " & rs.fields("ANO") & ", OrderNo,ShortDesc,ShortDesc_1, Description, Description_1, Section, '" & db_user & "','" & Format(Today.Date, "MM/DD/YYYY") & "' from AccCon Where ANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Insert Into AccEx(ANO,OrderNo,ShortDesc,ShortDesc_1, Description,Description_1, Section, Last_Opr, Last_Update) Select " & rs.fields("ANO") & ", OrderNo,ShortDesc,ShortDesc_1, Description, Description_1, Section, '" & db_user & "','" & Format(Today.Date, "MM/DD/YYYY") & "' from AccEx Where ANO=" & ANO) Then GoTo errmsg
                rs.MoveNext()
            Loop
        End If
        Save_TC_Data = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_TC_Data = False
    End Function

