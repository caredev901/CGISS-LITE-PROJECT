        RegNo = tostr(rs.fields("RegNo"))
        PolicyNo = tostr(rs.fields("PolicyNo"))
        CertificateNo = tostr(rs.fields("CertificateNo"))
        AType = tostr(rs.fields("AType"))
        ADate = todate(rs.fields("ADate"))
        SDate = todate(rs.fields("SDate"))
        EDate = todate(rs.fields("EDate"))
        PDate = todate(rs.fields("PDate"))
        RANO = toval(rs.fields("RANO"))
        AID = tostr(rs.fields("AID"))
        Source = tostr(rs.fields("Source"))
        CNO = toval(rs.fields("CNO"))
        LANO = toval(rs.fields("LANO"))
        OANO = toval(rs.fields("OANO"))
        pANO = toval(rs.fields("PANO"))
        TOPRO = tostr(rs.fields("TOPRO"))
        ConjunctionF = toval(rs.fields("ConjunctionF"))
        Ujroh = toval(rs.fields("Ujroh"))
        TOC = tostr(rs.fields("TOC"))
        Segment = tostr(rs.fields("Segment"))
        ISType = tostr(rs.fields("ISType"))
        COCNO = tostr(rs.fields("COCNO"))
        MO = tostr(rs.fields("MO"))
        OpenFlag = toval(rs.fields("OpenFlag"))
        PHolder = tostr(rs.fields("PHolder"))
        AStatus = rs.fields("AStatus")
        TOCShariaF = toval(rs.fields("TOCShariaF"))
        TOCConjunctionF = toval(rs.fields("TOCConjunctionF"))
        TOCReallocationF = toval(rs.fields("TOCReallocationF"))
        TOCAutoClaimPaymentF = toval(rs.fields("TOCAutoClaimPaymentF"))
        TOCObjectRestrictionF = toval(rs.fields("TOCObjectRestrictionF"))
        TOCAutoParsingFieldF = toval(rs.fields("TOCAutoParsingFieldF"))
        TOCMinLapseFacDue = toval(rs.fields("TOCMinLapseFacDue"))
        TOCCBCF = toval(rs.fields("TOCCBCF"))
        RDate = todate(rs.fields("RDate"))

        StrMsg = ""

        Dim AFLDID As Object
        Dim AValueID As Object
        Dim AValueDesc As Object
        Dim i As Integer
        Dim SFLDID As String
        Dim SVALUEID As String
        Dim SVALUEDESC As String
        Dim FLDID As String
        Dim ValueID As String
        SFLDID = rs.fields("FLDID")
        SVALUEID = rs.fields("VALUEID")
        SVALUEDESC = rs.fields("VALUEDESC")

        AFLDID = Convert_FLDID_Into_Array(SFLDID)
        AValueID = Convert_FLDID_Into_Array(SVALUEID)
        AValueDesc = Convert_FLDID_Into_Array(SVALUEDESC)

        For i = 0 To UBound(AValueID)
            If AValueID(i) <> AValueDesc(i) Then
                FLDID = AFLDID(i)
                ValueID = AValueID(i)
                Exit For
            End If
        Next

        If AStatus = "I" Then
            StrMsg = StrMsg & "Already Inforced !"
            GoTo AssignError
        End If

        If AType = "A" Then
            PreInforceConditions = True
            Exit Function
        End If

        If AType <> "C" Then
            If ANO <> LANO Then
                If rs.fields("PStatus") = "I" Then
                    StrMsg = StrMsg & "Inconsistent Data !"
                    GoTo AssignError
                End If
            End If

            If Source = "" Then
                StrMsg = StrMsg & "No Business Source !" & vbCrLf
            End If

           

           

            

            If ANO <> LANO Then
                

                If Not BackDatedF Then
                   

                    ' Check Total Limit Of Liability Not Exceeding Policy Limit
                    

                    ' Check Total Limit Of Liability Not Exceeding Credit Limit
                    

                    ' Check Total Limit Of Liability Not Exceeding Product Limit (by Insured and/or PHolder)
                    

                    ' Check Limit Of Liability Not Exceeding Master Limit Of Liability
                    

                    ' Check Limit Of Liability Not Exceeding Master Object Valuation
                    

                    

                    ' Check Policy Holder Limit
                   
                End If

                'Check Rarrheader
                rs = db.OpenRemoteSet("Select R.TShare, R.RAmount, R.SAmount, R.Shortfall, R.HoldF, R.Message, R.ManualF, R.CID, R.CAmount, R.XPID, R.XPAmount, R.QID, R.QAmount, R.QSRAmount, R.SP1Amount, R.SP2Amount, R.SP3Amount from RArrHeader R Where R.ANO=" & ANO)
                If Not rs.Eof Then
                    If toval(rs.fields("TShare"), 0) <> 100 Or toval(rs.fields("RAmount"), 0) <> 0 Or toval(rs.fields("SAmount"), 0) < 0 Or toval(rs.fields("Shortfall")) > 100 Then
                        StrMsg = StrMsg & "Incomplete Cession !" & vbCrLf
                    End If

                    If (db.GetPrivileges("FORCECHECKHOLDCESSION") And db_user_type <> "SUPERVISOR") OrElse (Not BackDatedF AndAlso Not db.GetPrivileges("ALLOWPASSHOLDCESSION")) Then
                        If rs.fields("HoldF") Then
                            StrMsg = StrMsg & "Hold Cession ! " & vbCrLf
                            StrMsg = StrMsg & "=> " & tostr(rs.fields("Message")) & " <=" & vbCrLf
                        End If
                    End If

                    'If Round(rs.fields("FShare") * rs.fields("TAmount") / 100, 2) <> Round(rs.fields("FAmount"), 2) Then
                    '    StrMsg = StrMsg & "Check Sum Insured Facultative Placement !" & vbCrLf
                    'End If

                    If toval(rs.fields("ManualF")) = 0 Then
                        If (toval(rs.fields("QAmount")) + toval(rs.fields("QSRAmount"))) = 0 AndAlso Not db.GetPrivileges("ALLOWNOQSCESSION") Then
                            If (toval(rs.fields("SP1Amount")) + toval(rs.fields("SP2Amount")) + toval(rs.fields("SP3Amount"))) > 0 Then
                                StrMsg = StrMsg & "Check Policy Risk Arrangement for " & GetTreatyDescription(tostr(rs.fields("QID"))) & ", No Amount Ceded. " & vbCrLf
                            ElseIf tostr(rs.fields("QID")) <> "" Then
                                StrMsg = StrMsg & "Check Policy Risk Arrangement for " & GetTreatyDescription(tostr(rs.fields("QID"))) & ", No Amount Ceded. " & vbCrLf
                            End If
                        End If
                    Else
                        ' Move to Reinsurance_Cession
                        'If (toval(rs.fields("QAmount")) + toval(rs.fields("QSRAmount"))) = 0 AndAlso TOCORCessionF AndAlso Not db.GetPrivileges("ALLOWNOORCESSION") Then
                        '    StrMsg = StrMsg & "Check Policy Risk Arrangement for " & GetTreatyDescription(tostr(rs.fields("QID"))) & ", No Amount Ceded. " & vbCrLf
                        'End If
                    End If

                    
                End If

                ' Check Conjunction Policy
                

                rs = db.OpenRemoteSet("Select AccDed.DCode from AccDed, Acceptance Where Acceptance.ANO=" & ANO & " and AccDed.ANO=Acceptance.ANO and Not Exists (Select R1.TOR from RateCov R1, RCover R2 where R1.TOR=AccDed.TOR and R1.Code=R2.Code and R2.ANO=" & ANO & ") and Not Exists (Select DCode from AccDed A Where A.DCode=AccDed.DCode and (A.ANO=Acceptance.pANO or A.ANO=Acceptance.RANO))")
                Do While Not rs.Eof
                    StrMsg = StrMsg & "Check Deductible (" & tostr(rs.fields("DCode")) & ") Not in Risk Coverage. " & vbCrLf
                    rs.MoveNext()
                Loop

                ' Check Max Indemnity Limit Of Additional Interest
                

                rs = db.OpenRemoteSet("Select Branch.Active_Flag, Branch.ShariaF from Acceptance Left Join Acceptance pAcceptance on (pAcceptance.ANO=Acceptance.pANO) Inner Join Branch on (Branch.Branch=Acceptance.Branch) Where coalesce(pAcceptance.Branch,'')<>Acceptance.Branch and Acceptance.ANO=" & ANO)
                If Not rs.Eof Then
                    If Not toval(rs.fields("Active_Flag")) Then
                        StrMsg = StrMsg & "Check for Branch Allow Selection Status. " & vbCrLf
                    End If

                    If TOCShariaF And Not toval(rs.fields("ShariaF")) Then
                        StrMsg = StrMsg & "Check for Branch Sharia Status. " & vbCrLf
                    End If
                End If

                

                If AdjustmentPolicyDepositF AndAlso LANO <> -1 And OpenFlag Then
                    ' Get Check Short Fall Flag from the Latest Deposit Parameter
                    SQL = "Select Top 1 A3.CheckShortFallF "
                    SQL = SQL & " from Acceptance A1 "
                    SQL = SQL & " Inner Join Acceptance A2 on (A2.OANO=A1.OANO and A2.ANO<=A1.ANO) "
                    SQL = SQL & " Inner join AccDeposit A3 on (A3.ANO=A2.ANO)"
                    SQL = SQL & " Where A1.ANO = " & LANO
                    SQL = SQL & " Order by A3.ANO Desc"
                    rs = db.OpenRemoteSet(SQL)
                    If Not rs.Eof Then

                        If toval(rs.fields("CheckShortFallF")) Then
                            rs = db.OpenQueryDef("QPOLICY_DEPOSIT", adOpenForwardonly, LANO)
                            Do While Not rs.Eof
                                Dim Total_Deposit As Double = toval(rs.fields("Total_Deposit"))
                                Dim Currency As String = tostr(rs.fields("Currency"))
                                If Total_Deposit > 0 Then
                                    Dim Total_Premium As Double
                                    Dim Deposit_Usage As Double
                                    Dim Deposit_Remaining As Double
                                    Dim rsDetail As RemoteSet

                                    rsDetail = db.OpenQueryDef("QPOLICY_DEPOSIT_USAGE", adOpenForwardonly, ANO, Currency)
                                    Deposit_Usage = toval(rsDetail.fields("Deposit_Usage"))
                                    Deposit_Remaining = Total_Deposit - Deposit_Usage

                                    Total_Premium = 0
                                    rsDetail = db.OpenQueryDef("QPOLICY_DEPOSIT_CURRENT", adOpenForwardonly, ANO, Currency)
                                    Do While Not rsDetail.Eof
                                        Dim ExcRate As Double
                                        If Currency.ToUpper <> rsDetail.fields("Currency").ToString.ToUpper Then
                                            ExcRate = exchange_rate(rsDetail.fields("Currency"), PDate)
                                        Else
                                            ExcRate = 1
                                        End If
                                        Total_Premium = Total_Premium + ExcRate * toval(rsDetail.fields("Total_Premium"))
                                        rsDetail.MoveNext()
                                    Loop

                                    If Deposit_Remaining < Total_Premium Then
                                        StrMsg = StrMsg & "Check Deposit, Deposit Remaining is " & Currency & " " & Format(Deposit_Remaining, "###,##0.00") & ", Total Premium is " & Format(Total_Premium, "###,##0.00") & vbCrLf
                                    End If
                                End If
                                rs.MoveNext()
                            Loop
                        End If

                        ' Check Deposit Payment
                        If db.GetPrivileges("FORCECHECKPAYMENTDEPOSIT") And db_user_type <> "SUPERVISOR" Then
                            SQL = " Select Top 1 A1.ANO"
                            SQL = SQL & " from Acceptance A1"
                            SQL = SQL & " Inner Join Acceptance A2 on (A2.OANO=A1.OANO and A2.ANO=A2.LANO)"
                            SQL = SQL & " Inner Join AccAss A3 on (A3.ANO=A2.ANO and A3.Type in ('DI','PD') and A3.Code='J')"
                            SQL = SQL & " Inner Join Admlink A4 on (A4.AdmNo=A3.AdmNo)"
                            SQL = SQL & " Inner Join nVoucher V on (V.Voucher=A4.Voucher)"
                            SQL = SQL & " Where A1.ANO = " & LANO & " And Round(V.Nominal_CC - V.Diff_CC - (V.Payment_CC + V.Payment_OC), 4) > 0"
                            rs = db.OpenRemoteSet(SQL)
                            If Not rs.Eof Then
                                StrMsg = StrMsg & "Deposit Not Yet Paid !" & vbCrLf
                            End If
                        End If
                    End If
                End If
            Else
                ' Check Credit Limit
                rs = db.OpenRemoteSet("Select Top 1 AINFODET.ANO from ACCEPTANCE A INNER JOIN COVER C ON (C.CNO=A.CNO) INNER JOIN TOC ON (TOC.TOC=A.TOC) LEFT JOIN AINFODET on (AINFODET.ANO=A.ANO and AINFODET.Status='A') WHERE A.ANO=" & ANO & " and coalesce(AINFODET.LIMIT, 0) = 0 And TOC.CREDITLIMITF = 1")
                If Not rs.Eof Then
                    StrMsg = StrMsg & "No Object Register or Object Register Without Credit Limit. " & vbCrLf
                End If
            End If

            

           

            If LANO = ANO Or LANO = -1 Then
              

                SQL = "Select Cover.TBAF, Cover.Segment, pCover.Segment as pSegment, Segment.AllowedF as Segment_AllowedF, "
                SQL = SQL & " Cover.MO, pCover.MO as pMO, SysUser.AllowedF as SysUser_AllowedF, "
                SQL = SQL & " Acceptance.TOC, pAcceptance.TOC as pTOC, TOC.AllowedF as TOC_AllowedF "
                SQL = SQL & " from Acceptance"
                SQL = SQL & " Inner Join Cover on (Cover.CNO=Acceptance.CNO)"
                SQL = SQL & " Left Join Acceptance pAcceptance on (pAcceptance.ANO=Acceptance.pANO)"
                SQL = SQL & " Left Join Cover pCover on (pCover.CNO=pAcceptance.CNO)"
                SQL = SQL & " Inner Join TOC on (TOC.TOC=Acceptance.TOC)"
                SQL = SQL & " Inner Join Segment on (Segment.Segment=Cover.Segment)"
                SQL = SQL & " Inner Join SysUser on (SysUser.ID=Cover.MO)"
                SQL = SQL & " Where Acceptance.ANO=" & ANO
                rs = db.OpenRemoteSet(SQL)
                If tostr(rs.fields("Segment")) <> tostr(rs.fields("pSegment")) AndAlso Not rs.fields("Segment_AllowedF") Then
                    StrMsg = StrMsg & "Check for Segment Allow Selection Status. " & vbCrLf
                End If
                If tostr(rs.fields("MO")) <> tostr(rs.fields("pMO")) AndAlso Not rs.fields("SysUser_AllowedF") Then
                    StrMsg = StrMsg & "Check for Marketing Officer Allow Selection Status. " & vbCrLf
                End If
                If tostr(rs.fields("TOC")) <> tostr(rs.fields("pTOC")) AndAlso Not rs.fields("TOC_AllowedF") Then
                    StrMsg = StrMsg & "Check for Sub-Class Allow Selection Status. " & vbCrLf
                End If
                If rs.fields("TBAF") AndAlso Not QuotationF Then
                    StrMsg = StrMsg & "Check Policy for TBA Condition. " & vbCrLf
                End If
            End If

            ' Master Policy, Certificate Open Cover or Individual Policy
            If Not BackDatedF AndAlso ((ANO = LANO And Not OpenFlag) Or (ANO <> LANO And OpenFlag) Or (LANO = -1)) Then
                Dim ErrMsg As String = ""
                ' Check Mandatory Document 
               

            End If

          
        Else
            ' Cancellation
            If ANO <> LANO Then
                'Check Rarrheader
                rs = db.OpenRemoteSet("Select R.HoldF, R.Message from RArrHeader R Where R.ANO=" & ANO)
                If Not rs.Eof Then
                    If (db.GetPrivileges("FORCECHECKHOLDCESSION") And db_user_type <> "SUPERVISOR") OrElse (Not BackDatedF AndAlso Not db.GetPrivileges("ALLOWPASSHOLDCESSION")) Then
                        If rs.fields("HoldF") Then
                            StrMsg = StrMsg & "Hold Cession ! " & vbCrLf
                            StrMsg = StrMsg & "=> " & tostr(rs.fields("Message")) & " <=" & vbCrLf
                        End If
                    End If
                End If
            End If
        End If


        If StrMsg <> "" Then GoTo AssignError

        PreInforceConditions = True
        Exit Function
AssignError:

        If StrMsg <> "" Then
            If AType = "N" Then
                StrMsg = "Policy Register No. " & RegNo & ", " & "Policy No. " & PolicyNo & ", Certificate No." & CertificateNo & "--> " & vbCrLf & StrMsg
            Else
                StrMsg = "Policy Register No. " & RegNo & ", " & "Policy No. " & PolicyNo & ", Certificate No." & CertificateNo & "--> " & vbCrLf & StrMsg
            End If
        End If
        PreInforceConditions = False
        Exit Function

errmsg:
        StrMsg = StrError(StrMsg)
        PreInforceConditions = False
    End Function    
