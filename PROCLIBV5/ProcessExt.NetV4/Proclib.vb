    Private Function CopyPolicyMaster(ByVal CNO As Long, ByVal ANO As Long, ByVal ISType As String) As String
        Dim rs As RemoteSet
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim rsSrc1 As RemoteSet
        Dim rsDst1 As RemoteSet
        Dim rsSrc2 As RemoteSet
        Dim rsDst2 As RemoteSet
        Dim NewCNO As Long
        Dim NewANO As Long
        Dim Branch As String
        Dim TOC As String
        Dim CT As String
        Dim PolicyType As String
        Dim CoverNo As String
        Dim NewRefNo As String
        Dim NewCoverNo As String
        Dim NewRegNo As String
        Dim OpenFlag As Boolean
        Dim LANO As Long
        Dim RenewableF As Boolean

        On Error GoTo errmsg

        rsSrc = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        rsDst = db.OpenRemoteSet("Select * from Cover Where 1<>1")
        If Not rsSrc.Eof Then
            CoverNo = rsSrc.fields("CoverNo")
            PolicyType = rsSrc.fields("PolicyType")
            OpenFlag = rsSrc.fields("OpenFlag")

            rs = db.OpenRemoteSet("Select Branch, LANO, TOC, CT from Acceptance Where ANO=" & ANO)
            Branch = rs.fields("Branch")
            LANO = rs.fields("LANO")
            TOC = rs.fields("TOC")
            CT = rs.fields("CT")

            Dim NoRiskAccumulationF As Boolean
            Dim AnnualTreatyF As Boolean
            rs = db.OpenRemoteSet("Select NoRiskAccumulationF, AnnualTreatyF, RenewableF from TOC Where TOC='" & TOC & "'")
            NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
            AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))
            RenewableF = toval(rs.fields("RenewableF"))

            rs = db.OpenRemoteSet("Select P2.RenewableF from PolicyType P1, PTClass P2, TOC Where P1.PolicyType=P2.PolicyType and P1.PolicyType='" & PolicyType & "' and (P1.ISType in ('A') or (P1.ISType in ('D') and '" & ISType & "' in ('I','C','L')) or (P1.ISType in ('I') and '" & ISType & "' in ('R','T'))) and P2.COB=TOC.COB and (P2.TOC='<All>' or P2.TOC=TOC.TOC) and TOC.TOC='" & TOC & "'")
            If rs.Eof Then
                StrMsg = "Policy Type Not Setup for ISType : " & ISType & " !"
                GoTo errmsg
            End If
            RenewableF = RenewableF And toval(rs.fields("RenewableF"))

            NewCoverNo = GetDocumentNumbering("COV", PolicyType, ISType, rsSrc.fields("CoverDate"), Branch, TOC, CT)
            If NewCoverNo = "" Then
                StrMsg = "Generate Cover No./Quotation No. Failed !"
                GoTo errmsg
            End If

            'Copy Cover & Related Information
            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("CoverNo") = NewCoverNo
            rsDst.fields("ASource") = "UW"          ' Underwriting Application Source
            rsDst.fields("CStatus") = "A"           ' Request Status
            rsDst.fields("UserId") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("CTime") = Time()
            rsDst.fields("LUserId") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("ISType") = ISType
            rsDst.fields("VSeqNo") = 0
            rsDst.fields("ANO") = -1
            rsDst.fields("pCNO") = -1
            rsDst.fields("FOLLOWUP") = ""
            rsDst.fields("Memo") = ""
            rsDst.fields("Comment") = ""
            NewCNO = db.GetIdentity("Cover") + 1
            rsDst.fields("CNO") = NewCNO
            rsDst.fields("OCNO") = NewCNO
            rsDst.fields("CertNum") = 0
            rsDst.fields("PUserID") = db_user
            rsDst.fields("PUSerDate") = Today.Date
            rsDst.fields("PUSerTime") = Time()
            rsDst.fields("CUserID") = ""
            rsDst.fields("CLoseDate") = ""
            rsDst.fields("CLoseTime") = ""
            rsDst.fields("AUserID") = db_user
            rsDst.fields("AUSerDate") = Today.Date
            rsDst.fields("AUserTime") = Time()
            If Not rsDst.Update Then GoTo errmsg
            If Not CopyCover(rsSrc.fields("CNO"), NewCNO, rsDst.fields("ISType")) Then GoTo errmsg

            rsSrc.CloseRemoteSet()
            rsDst.CloseRemoteSet()

            'Copy Acceptance & Related Information
            rsDst = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
            rsSrc = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
            If Not rsSrc.Eof Then
                NewRegNo = GetDocumentNumbering("REG", PolicyType, ISType, Today.Date, Branch, TOC, CT)
                If NewRegNo = "" Then
                    StrMsg = "Generate Register No./Closing Instruction No. Failed !"
                    GoTo errmsg
                End If
                rsDst.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
                If rsDst.fields("RefNo") = CoverNo Then
                    NewRefNo = NewCoverNo
                    rsDst.fields("RefNo") = NewRefNo
                Else
                    If rsDst.fields("RefNo") = "" Then
                        If Not CBool(toval(GetAppSetting("GenerateRefNoF"))) Then
                            NewRefNo = NewCoverNo
                            rsDst.fields("RefNo") = NewRefNo
                        Else
                            NewRefNo = GetDocumentNumbering("REF", PolicyType, ISType, Today.Date, Branch, TOC, CT)
                            rsDst.fields("RefNo") = NewRefNo
                        End If
                    Else
                        NewRefNo = rsDst.fields("RefNo")
                    End If
                End If
                rsDst.fields("RegNo") = NewRegNo
                rsDst.fields("RegDate") = Today.Date
                rsDst.fields("AType") = "N"             ' New Policy
                rsDst.fields("AStatus") = "W"           ' Waiting Policy
                rsDst.fields("pAStatus") = ""           ' Previous Acceptance Status (AStatus)
                rsDst.fields("PStatus") = "I"           ' Inconsistent
                rsDst.fields("RANO") = -1               ' Renewal Acceptance
                rsDst.fields("PANO") = -1               ' Previous ANO
                rsDst.fields("LANO") = -1               ' Link to Master Acceptance
                rsDst.fields("CANO") = -1               ' Conjunction Reference ANO
                rsDst.fields("SNO") = -1                ' Servicing Reference No
                rsDst.fields("BANO") = -1               ' Branch Reference NO
                rsDst.fields("BatchNo") = ""
                rsDst.fields("BID") = 0
                rsDst.fields("ASource") = ""
                rsDst.fields("CPolicyNo") = ""
                rsDst.fields("PolicyNo") = ""
                rsDst.fields("CertificateNo") = ""
                rsDst.fields("PDate") = rsDst.fields("SDate")
                rsDst.fields("PPDate") = rsDst.fields("EDate")
                rsDst.fields("Remarks") = ""
                rsDst.fields("Memo") = ""
                rsDst.fields("Comment") = ""
                rsDst.fields("BackDatedF") = 0
                rsDst.fields("ConjunctionF") = 0
                rsDst.fields("CNO") = NewCNO
                rsDst.fields("UserID") = db_user
                rsDst.fields("CDate") = Today.Date
                rsDst.fields("CTime") = Time()
                rsDst.fields("LUserID") = db_user
                rsDst.fields("LDate") = Today.Date
                rsDst.fields("LTime") = Time()
                rsDst.fields("ESeqNo") = 0
                rsDst.fields("EESeqNo") = 0
                rsDst.fields("ERSeqNo") = 0
                rsDst.fields("EMethod") = ""
                rsDst.fields("CPCT") = 0
                rsDst.fields("Renewal") = 0
                rsDst.fields("BackDatedF") = 0
                rsDst.fields("RequestF") = False
                rsDst.fields("RequestMessage") = ""
                rsDst.fields("RequestName") = ""
                rsDst.fields("Reason") = ""
                rsDst.fields("Matters") = ""
                rsDst.fields("Notes") = ""
                rsDst.fields("CUserID") = ""
                rsDst.fields("CLoseDate") = ""
                rsDst.fields("CloseTime") = ""
                rsDst.fields("RUserID") = ""
                rsDst.fields("RUSerDate") = ""
                rsDst.fields("RUSerTime") = ""
                rsDst.fields("AUserID") = ""
                rsDst.fields("AUSerDate") = ""
                rsDst.fields("AUSerTime") = ""
                NewANO = db.GetIdentity("Acceptance") + 1
                rsDst.fields("SplitDNCNF") = False
                rsDst.fields("ANO") = NewANO
                rsDst.fields("OANO") = NewANO
                rsDst.fields("LANO") = NewANO
                rsDst.fields("NoRefundF") = 0
                rsDst.fields("NoRiskAccumulationF") = NoRiskAccumulationF
                rsDst.fields("AnnualTreatyF") = AnnualTreatyF
                rsDst.fields("SecurityNo") = ""
                rsDst.fields("RenewableF") = RenewableF
                rsDst.fields("BVATPCT") = 0
                rsDst.fields("TVATPCT") = 0
                rsDst.fields("COCNO") = ""
                rsDst.fields("ExtRSDate") = ""
                rsDst.fields("ExtREDate") = ""
                rsDst.fields("ExtRPeriod") = 0
                rsDst.fields("SysuserID") = ""
                If Not rsDst.Update Then GoTo errmsg

                If Not CopyPolicyAcceptance(ANO, NewANO, True) Then GoTo errmsg

                'Detail Of Master Policy
                If Not OpenFlag And LANO <> -1 Then
                    rs = db.OpenQueryDef("QDetailAcceptance", adOpenKeyset, ANO)
                    Do While Not rs.Eof
                        If Not CopyPolicyDetail(rs.fields("ANO"), NewANO, NewCNO, NewRegNo, NewRefNo, TOC) Then GoTo errmsg
                        rs.MoveNext()
                    Loop
                    rs.CloseRemoteSet()
                End If
            Else
                StrMsg = "No Policy Data !"
                GoTo errmsg
            End If
            rsSrc.CloseRemoteSet()
            rsDst.CloseRemoteSet()

            CopyPolicyMaster = NewANO
            Exit Function
        Else
            StrMsg = "No Policy Data !"
            GoTo errmsg
        End If
errmsg:
        StrMsg = StrError(StrMsg)
        CopyPolicyMaster = 0
    End Function

    Private Function GetCertificateNo(ByVal CNO As Long, Optional ByVal CertNum As Long = 0, Optional ByVal TransactionF As Boolean = False) As Long
        Dim dbCr As ClassLib = Nothing
        Try
            If CertNum = 0 And Not TransactionF Then
                dbCr = db
            Else
                dbCr = New ClassLib
                If Not dbCr.OpenConnection(ServiceName, db_Name, db_Server, db_sysuser, db_syspassword, db_TimeOut, db_Trusted) Then
                    Throw New Exception(dbCr.ErrDesc)
                End If
                TransactionF = True
            End If
            If TransactionF Then dbCr.Begintrans()

            Try
                Dim rs As RemoteSet
                Dim rsAcc As RemoteSet
                Dim CertificateF As Boolean

                If Not dbCr.GetLockedObject("CERTNUM" & CNO, True) Then Throw New Exception(dbCr.ErrDesc)
                rs = dbCr.OpenRemoteSet("Select CertNum from Cover Where CNO=" & CNO)
                If CertNum = 0 Or CertNum > toval(rs.fields("CertNum")) Then
                    CertificateF = True
                Else
                    rsAcc = dbCr.OpenRemoteSet("Select Top 1 CertificateNo from Acceptance Where CertificateNo='" & GetCertificateNumber(CertNum) & "' and CNO=" & CNO)
                    If Not rsAcc.Eof Then ' Already Used
                        Throw New Exception("Duplicate Certificate No !")
                    Else
                        CertificateF = False
                    End If
                End If
                ' Get Certificate Number
                If CertificateF Then
                    If CertNum <= toval(rs.fields("CertNum")) Then
                        CertNum = toval(rs.fields("CertNum")) + 1
                    End If

                    If Not dbCr.Execute("Update Cover Set CertNum=" & CertNum & " Where CNO=" & CNO) Then Throw New Exception(dbCr.ErrDesc)
                End If
                If Not dbCr.ReleaseLockedObject("CERTNUM" & CNO) Then Throw New Exception(dbCr.ErrDesc)
                GetCertificateNo = CertNum

            Catch ex As Exception
                StrMsg = ex.Message
                GetCertificateNo = 0
            Finally
                If dbCr.CheckLockedObject("CERTNUM" & CNO) Then dbCr.ReleaseLockedObject("CERTNUM" & CNO)
            End Try

            If TransactionF Then dbCr.Committrans()
        Catch ex As Exception
            StrMsg = ex.Message
            GetCertificateNo = 0
            If TransactionF Then dbCr.RollBack()
        End Try
    End Function
