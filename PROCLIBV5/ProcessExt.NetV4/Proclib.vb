    Private Function Get_ValueID(ByVal FLDID As String, ByVal ValueDesc As String, ByVal PDate As Date, ByVal TOC As String, ByVal SEGMENT As String) As String
        Dim rs As RemoteSet
        Dim SQL As String
        On Error GoTo errmsg
        Dim AgeMethod As Integer
        Dim SubClassF As Boolean
        Dim SegmentF As Boolean
        Dim Formula As String
        rs = db.OpenRemoteSet("Select AgeMethod from TOC Where TOC='" & TOC & "'")
        AgeMethod = toval(rs.fields("AgeMethod"))
        rs = db.OpenRemoteSet("Select AgeMethod, SubClassF, SegmentF from GenHTab where FLDID='" & FLDID & "'")
        If Not rs.Eof Then
            If AgeMethod = -1 Then
                AgeMethod = rs.fields("AgeMethod")
            End If
            SubClassF = rs.fields("SubClassF")
            SegmentF = rs.fields("SegmentF")

            rs = db.OpenRemoteSet("Select Top 1 Formula from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "'")
            Formula = UCase(rs.fields("Formula"))
            Select Case Formula
                Case "AGE", "AGESTART"
                    ' First Formula
                    If IsDate(ValueDesc) Then
                        Dim age As Integer
                        age = get_Age(todate(ValueDesc), todate(PDate), AgeMethod)
                        SQL = "Select TOP 1 ValueID from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "' and Formula='" & Formula & "' and right(replicate('0',10)+'" & age & "',10) between right(replicate('0',10)+FLOWER,10) AND right(replicate('0',10)+FUPPER,10)"
                    Else
                        SQL = "Select TOP 1 ValueID from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "' and Formula='" & Formula & "' and right(replicate('0',10)+'" & Year(PDate) - toval(ValueDesc) & "',10) between right(replicate('0',10)+FLOWER,10) AND right(replicate('0',10)+FUPPER,10)"
                    End If
                    If SubClassF And TOC <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDTOC Where GenDTOC.FLDID='" & FLDID & "' and GenDTOC.ValueID=GenDTab.ValueID and (GenDTOC.TOC='<All>' or GenDTOC.TOC='" & TOC & "'))"
                    End If
                    If SegmentF And SEGMENT <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDSegment Where GenDSegment.FLDID='" & FLDID & "' and GenDSegment.ValueID=GenDTab.ValueID and (GenDSegment.Segment='<All>' or GenDSegment.Segment='" & SEGMENT & "'))"
                    End If
                    SQL = SQL & " Order By right(replicate('0',10)+FLOWER,10) Desc"
                    rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
                    Get_ValueID = tostr(rs.fields("ValueID"))
                Case "VALUE"
                    SQL = "Select TOP 1 ValueID from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "' and Formula='" & Formula & "' and cast('" & tovalSF(ValueDesc) & "' as Float) between Cast(FLOWER as Float) AND Cast(FUPPER as Float)"
                    If SubClassF And TOC <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDTOC Where GenDTOC.FLDID='" & FLDID & "' and GenDTOC.ValueID=GenDTab.ValueID and (GenDTOC.TOC='<All>' or GenDTOC.TOC='" & TOC & "'))"
                    End If
                    If SegmentF And SEGMENT <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDSegment Where GenDSegment.FLDID='" & FLDID & "' and GenDSegment.ValueID=GenDTab.ValueID and (GenDSegment.Segment='<All>' or GenDSegment.Segment='" & SEGMENT & "'))"
                    End If
                    SQL = SQL & " Order By Cast(FLOWER as Float) Desc"
                    rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
                    Get_ValueID = tostr(rs.fields("ValueID"))
                Case "VALUE$"
                    SQL = "Select TOP 1 ValueID from GenDTab Where AllowedF=1 and FLDID='" & FLDID & "' and Formula='" & Formula & "' and '" & Trim(ValueDesc) & "' BETWEEN FLower and FUpper"
                    If SubClassF And TOC <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDTOC Where GenDTOC.FLDID='" & FLDID & "' and GenDTOC.ValueID=GenDTab.ValueID and (GenDTOC.TOC='<All>' or GenDTOC.TOC='" & TOC & "'))"
                    End If
                    If SegmentF And SEGMENT <> "" Then
                        SQL = SQL & " and Exists (Select Top 1 ValueID from GenDSegment Where GenDSegment.FLDID='" & FLDID & "' and GenDSegment.ValueID=GenDTab.ValueID and (GenDSegment.Segment='<All>' or GenDSegment.Segment='" & SEGMENT & "'))"
                    End If
                    SQL = SQL & " Order By FLower Desc"
                    rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
                    Get_ValueID = tostr(rs.fields("ValueID"))
                Case Else
                    Get_ValueID = ""
            End Select
        Else
            Get_ValueID = ""
        End If
        Exit Function
errmsg:
        Get_ValueID = ""
    End Function
    Private Function get_Age(ByVal Birthdate As Date, ByVal ComparisonDate As Date, ByVal AgeMethod As Integer) As Integer
        Dim Temp As Integer = 0
        Try
            If ComparisonDate <= Birthdate Then
                Temp = 0
            Else
                Temp = DateDiff(DateInterval.Year, Birthdate, ComparisonDate)
                Select Case AgeMethod
                    Case 4  ' Nearest Birth Date by Month-Day
                        If DateAdd(DateInterval.Year, Temp, Birthdate) > ComparisonDate Then
                            Temp = Temp - 1
                        End If

                        If DateDiff(DateInterval.Month, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) = DateDiff(DateInterval.Month, ComparisonDate, DateAdd(DateInterval.Year, Temp + 1, Birthdate)) Then
                            If DateAdd(DateInterval.Month, DateDiff(DateInterval.Month, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate), DateAdd(DateInterval.Year, Temp, Birthdate)) < ComparisonDate Then
                                Temp = Temp + 1
                            End If
                        Else
                            If DateDiff(DateInterval.Month, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) > DateDiff(DateInterval.Month, ComparisonDate, DateAdd(DateInterval.Year, Temp + 1, Birthdate)) Then
                                Temp = Temp + 1
                            End If
                        End If
                    Case 3  ' Next Birth Day
                        If DateAdd(DateInterval.Year, Temp, Birthdate) > ComparisonDate Then
                            Temp = Temp - 1
                        End If
                        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) > 0 Then
                            Temp = Temp + 1
                        End If
                    Case 2  ' Nearest Birth Date by Day
                        If DateAdd(DateInterval.Year, Temp, Birthdate) > ComparisonDate Then
                            Temp = Temp - 1
                        End If
                        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) > DateDiff(DateInterval.Day, ComparisonDate, DateAdd(DateInterval.Year, Temp + 1, Birthdate)) Then
                            Temp = Temp + 1
                        End If
                    Case 1  ' Nearest Birth Date by Month
                        If DateAdd(DateInterval.Year, Temp, Birthdate) > ComparisonDate Then
                            Temp = Temp - 1
                        End If
                        If DateDiff(DateInterval.Month, DateAdd(DateInterval.Year, Temp, Birthdate), ComparisonDate) > DateDiff(DateInterval.Month, ComparisonDate, DateAdd(DateInterval.Year, Temp + 1, Birthdate)) Then
                            Temp = Temp + 1
                        End If
                    Case Else   ' Years Lapse
                        If Temp > 0 Then
                            If Month(ComparisonDate) < Month(Birthdate) Or (Month(Birthdate) = Month(ComparisonDate) And ComparisonDate.Day < Birthdate.Day) Then
                                Temp = Temp - 1
                            End If
                        End If
                End Select

            End If

            Return Temp
        Catch ex As Exception
            Throw
        End Try
    End Function
    Private Function isNotPremiumPaid(ByVal ANO As Long, ByVal PDate As Date) As Boolean
        Dim rs As RemoteSet
        Dim PremiumOutstanding As Double
        rs = db.OpenQueryDef("QPremiumAmount", adOpenForwardonly, ANO, PDate)
        PremiumOutstanding = toval(rs.fields("PremiumOutstanding"))
        isNotPremiumPaid = ((PremiumOutstanding) > toval(GetAppSetting("NominalPaidTolerance")))
    End Function
    Private Function isPremiumPaid(ByVal ANO As Long, ByVal PDate As Date) As Boolean
        Dim rs As RemoteSet
        Dim PremiumAmount As Double
        Dim PremiumPaid As Double
        rs = db.OpenQueryDef("QPremiumAmount", adOpenForwardonly, ANO, PDate)
        PremiumAmount = toval(rs.fields("PremiumAmount"))
        PremiumPaid = toval(rs.fields("PremiumPaid"))

        If (tostr(rs.fields("DueDate")) <> "" AndAlso IsDate(rs.fields("DueDate")) AndAlso DateDiff(DateInterval.Day, rs.fields("DueDate"), PDate) >= 0) Then
            isPremiumPaid = ((PremiumAmount - PremiumPaid) <= toval(GetAppSetting("NominalPaidTolerance")))
        Else
            isPremiumPaid = True
        End If
    End Function
    Private Function Generate_Renewal_Data(ByVal PSDate As Date, ByVal PEDate As Date, ByVal TOC As String, ByVal Branch As String, ByVal ANO As Long, ByVal Segment_OR_NumMonth As String) As Boolean
        Dim rs As RemoteSet
        Dim rsr As RemoteSet
        Dim rsRR As RemoteSet
        Dim SEGMENT As String
        Dim NumMonth As Integer = 0
        Dim SQL As String

        On Error GoTo errmsg
        SQL = "Select Acceptance.ANO, Acceptance.LANO, Acceptance.CNO, Acceptance.RegDate, Acceptance.PolicyNo, Acceptance.CertificateNo, Acceptance.RefNo, Acceptance.SDate, Acceptance.EDate, Acceptance.AName, MAcceptance.SDate as MSDate, MAcceptance.EDate as MEDate, Cover.PHolder, Cover.PolicyType, Cover.Segment, Acceptance.TOC, Cover.OpenFlag, Cover.ASource "
        SQL = SQL & " from Acceptance "
        SQL = SQL & " Left Join RArrHeader on (RArrHeader.ANO=Acceptance.ANO) "
        SQL = SQL & " Left Join Acceptance MAcceptance on (MAcceptance.ANO=Acceptance.LANO)"
        SQL = SQL & " Inner Join Cover on (Cover.CNO=Acceptance.CNO) "
        SQL = SQL & " Where Cover.ISType in ('I','L','C','R') and Acceptance.RenewableF=1 and Acceptance.AStatus in ('I','C') and Cover.CStatus<>'C' and Acceptance.AType not in ('C','A') "
        SQL = SQL & " and Not Exists (Select PANO from Acceptance A Where A.AStatus in ('I','C') and A.AType not in ('A') and A.PANO=Acceptance.ANO)"
        If ANO = 0 Then
            SEGMENT = tostr(Segment_OR_NumMonth)
            SQL = SQL & " and Not Exists (Select ANO from Renewal, TOC Where TOC.TOC=Renewal.TOC and (Renewal.Status<>'O' or not (TOC.RenewalDataF=1 and Renewal.PStatus='I')) and Renewal.ANO=Acceptance.ANO)"
            SQL = SQL & " and Acceptance.EDate Between '" & Format(PSDate, "MM/DD/YYYY") & "' and '" & Format(PEDate, "MM/DD/YYYY") & "'"
            If TOC <> "<All>" AndAlso TOC <> "" Then
                SQL = SQL & " and Acceptance.TOC like '" & TOC & "%'"
            End If
            If Branch <> "<All>" AndAlso Branch <> "" Then
                SQL = SQL & " and Acceptance.Branch like '" & Branch & "%'"
            Else
                SQL = SQL & " and ('" & db_user_type & "'='SUPERVISOR' or Exists (Select Branch from SysUserBranch Where SysUserBranch.Branch=Acceptance.Branch and ID='" & db_user & "'))"
            End If
            If SEGMENT <> "<All>" AndAlso SEGMENT <> "" Then
                SQL = SQL & " and Cover.SEGMENT like '" & SEGMENT & "%'"
            End If
        Else
            NumMonth = toval(Segment_OR_NumMonth)
            SQL = SQL & " and Acceptance.ANO=" & ANO
        End If
        SQL = SQL & " Order by Acceptance.TOC"

        rsr = db.OpenRemoteSet(SQL)

        Dim PolicyNo As String
        Dim CertificateNo As String
        Dim PolicyType As String
        Dim PHolder As String
        Dim SDate As Date
        Dim EDate As Date
        Dim Claim_Paid As Double
        Dim Gross_Premium As Double
        Dim OS_Claim As Double
        Dim Loading As Double

        Dim LossRatio As Double
        Dim ClaimFreq As Double
        Dim OwnFault As Double
        Dim InsPeriod As Double
        Dim SumInsured As Double
        Dim OutGo As Double
        Dim FacOpt As Integer
        Dim Code As String
        Dim CTLF As Boolean
        Dim PaidPremiumF As Boolean
        Dim RenewalF As Boolean
        Dim RenewalRuleF As Boolean
        Dim Message As String
        Dim AutoEmailRenewalNoticeF As Boolean
        Dim AutoPrintRenewalNoticeF As Boolean

        Dim LANO As Long
        Dim OpenFlag As Boolean
        Dim RegDate As Date

        TOC = ""
        RenewalRuleF = False
        Do While Not rsr.Eof
            Message = ""
            PolicyNo = tostr(rsr.fields("PolicyNo"))
            CertificateNo = tostr(rsr.fields("CertificateNo"))
            PolicyType = tostr(rsr.fields("PolicyType"))
            PHolder = tostr(rsr.fields("PHolder"))
            SEGMENT = tostr(rsr.fields("Segment"))
            ANO = toval(rsr.fields("ANO"))
            LANO = toval(rsr.fields("LANO"))
            OpenFlag = toval(rsr.fields("OpenFlag"))
            RegDate = todate(rsr.fields("RegDate"))

            If TOC <> tostr(rsr.fields("TOC")) Then
                TOC = tostr(rsr.fields("TOC"))
                rs = db.OpenRemoteSet("Select Top 1 TOC from RenewalRule Where TOC='" & TOC & "'")
                RenewalRuleF = Not rs.Eof
            End If

            If LANO <> -1 And Not OpenFlag Then
                SDate = rsr.fields("MSDate")
                EDate = rsr.fields("MEDate")
            Else
                SDate = rsr.fields("SDate")
                EDate = rsr.fields("EDate")
            End If
            InsPeriod = DateDiff(DateInterval.Month, rsr.fields("SDate"), rsr.fields("EDate"))

            SumInsured = 0
            If RenewalRuleF Then
                Dim SI As Double
                rs = db.OpenRemoteSet("Select INO, SI from ICover Where Category='M' and ANO=" & ANO)
                Do While Not rs.Eof
                    SI = rs.fields("SI")
                    If Not Get_Object_Valuation(rs.fields("INO"), SI, EDate) Then GoTo errmsg
                    SumInsured = SumInsured + SI
                    rs.MoveNext()
                Loop
            End If

            ' for Individual
            rs = db.OpenQueryDef("CLAIM_PAID_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
            Claim_Paid = -toval(rs.fields("Claim_Paid"))
            rs = db.OpenQueryDef("GROSS_PREMIUM_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
            Gross_Premium = toval(rs.fields("Gross_Premium"))
            rs = db.OpenQueryDef("OS_CLAIM_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
            OS_Claim = toval(rs.fields("OS_Claim"))

            If Gross_Premium <> 0 Then
                LossRatio = (Claim_Paid + OS_Claim) / Gross_Premium * 100
            Else
                LossRatio = 0
            End If

            rs = db.OpenRemoteSet("Select R.Code, Max(RArr.FShare) as FShare, Max(dbo.Premium_MaxOutGo(A.ANO, R.Code,0)) as OutGo from Acceptance A, RCover R, RArrHeader RArr Where RArr.ANO=A.ANO and R.Unit<>'F' and R.Category='M' and R.ANO=A.ANO and A.ANO=" & ANO & " Group By R.Code Order By Max(Case When R.Unit='C' Then R.Rate else R.Rate/10 end) Desc")
            Code = tostr(rs.fields("Code"))
            OutGo = toval(rs.fields("OutGo"))
            FacOpt = IIf(toval(rs.fields("FShare")) <> 0, 1, 2)

            rs = db.OpenQueryDef("CLAIM_FREQ_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
            ClaimFreq = toval(rs.fields("Claim_Freq"))

            rs = db.OpenQueryDef("OWN_FAULT_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
            OwnFault = toval(rs.fields("OWN_FAULT"))

            rs = db.OpenRemoteSet("Select Claim.ANO, Claim.ClaimNo from Claim, CLLoss Where Claim.CType<>'C' and (Claim.CStatus='A' or Claim.pCStatus='A') and Claim.ANO=" & ANO & " and CLLoss.CNO=Claim.CNO and CLLoss.CTLF=1")
            CTLF = (Not rs.Eof)
            If CTLF Then
                Message = Message & "Has Claim Total Loss, Claim No. : " & rs.fields("ClaimNo") & " " & vbCrLf
            End If

            PaidPremiumF = True
            If LANO = -1 Or (LANO <> -1 And ANO = LANO And Not OpenFlag) Or (ANO <> LANO And OpenFlag) Then
                If Not db.GetPrivileges("UNPAIDPREMIUM") Then
                    If isNotPremiumPaid(ANO, Today.Date) Then
                        Dim RequestingUser As String = ""
                        If Not (CheckRequestingActivities("UNPAIDPREMIUM", "UND", ANO, RegDate, "", RequestingUser) AndAlso RequestingUser.ToUpper = db_user.ToUpper) Then
                            PaidPremiumF = False
                            Message = Message & "Unpaid Premium " & vbCrLf
                        End If
                    End If
                End If
            End If


            rs = db.OpenQueryDef("QRiskAssLimit", adOpenForwardonly, ANO)
            Loading = toval(rs.fields("Loading"))

            Dim RFLDID1 As String = ""
            Dim RFLDID2 As String = ""
            Dim RFLDID3 As String = ""
            Dim RFLDID4 As String = ""
            Dim RFLDID5 As String = ""

            Dim ValueID1 As String = ""
            Dim ValueID2 As String = ""
            Dim ValueID3 As String = ""
            Dim ValueID4 As String = ""
            Dim ValueID5 As String = ""
            Dim ValueID As String = ""

            rs = db.OpenRemoteSet("Select TOC.AutoEmailRenewalNoticeF, TOC.AutoPrintRenewalNoticeF, TOC.RFLDID1, TOC.RFLDID2, TOC.RFLDID3, TOC.RFLDID4, TOC.RFLDID5 from TOC Where TOC='" & TOC & "'")
            AutoEmailRenewalNoticeF = toval(rs.fields("AutoEmailRenewalNoticeF"))
            AutoPrintRenewalNoticeF = toval(rs.fields("AutoPrintRenewalNoticeF"))
            RFLDID1 = rs.fields("RFLDID1")
            RFLDID2 = rs.fields("RFLDID2")
            RFLDID3 = rs.fields("RFLDID3")
            RFLDID4 = rs.fields("RFLDID4")
            RFLDID5 = rs.fields("RFLDID5")

            rs = db.OpenRemoteSet("Select AccSearch.FLDID, AccSearch.ValueID, GenHTab.AgeMethod, GenDTab.Formula, GenDTab.NewValueID from AccSearch, GenDTab, GenHTab Where GenHTab.FLDID=GenDTab.FLDID and GenDTab.FLDID=AccSearch.FLDID and GenDTab.ValueID=AccSearch.ValueID and AccSearch.ANO=" & ANO & " and AccSearch.FLDID in ('" & RFLDID1 & "','" & RFLDID2 & "','" & RFLDID3 & "','" & RFLDID4 & "','" & RFLDID5 & "')")
            Do While Not rs.Eof
                ValueID = IIf(rs.fields("NewValueID") <> "", rs.fields("NewValueID"), rs.fields("ValueID"))
                If rs.fields("Formula") = "AGE" AndAlso get_Age(rsr.fields("SDate"), rsr.fields("EDate"), rs.fields("AgeMethod")) > 0 Then
                    ValueID = tostr(toval(ValueID) + get_Age(rsr.fields("SDate"), rsr.fields("EDate"), rs.fields("AgeMethod")))
                End If
                Select Case rs.fields("FLDID")
                    Case RFLDID1
                        ValueID1 = ValueID
                    Case RFLDID2
                        ValueID2 = ValueID
                    Case RFLDID3
                        ValueID3 = ValueID
                    Case RFLDID4
                        ValueID4 = ValueID
                    Case RFLDID5
                        ValueID5 = ValueID
                End Select
                rs.MoveNext()
            Loop

            If RenewalRuleF Then
                rs = db.OpenQueryDef("QRenewalRule", adOpenForwardonly, TOC, PolicyType, SEGMENT, ValueID1, ValueID2, ValueID3, ValueID4, ValueID5, Code, LossRatio, ClaimFreq, OwnFault, InsPeriod, SumInsured, OutGo, FacOpt, PHolder)
                If rs.Eof Then
                    RenewalF = True
                    Message = Message & "No Renewal Rule  " & vbCrLf
                Else
                    RenewalF = toval(rs.fields("RenewalF"))
                    If Not RenewalF Then
                        If Not (toval(rs.fields("LossRatioL")) = 0 And toval(rs.fields("LossRatioU")) = 0) Then
                            Message = Message & "Loss Ratio Between " & Format(toval(rs.fields("LossRatioL")), "##0.00") & " - " & Format(toval(rs.fields("LossRatioU")), "##0.00") & " " & vbCrLf
                        End If
                        If Not (toval(rs.fields("CLAIMFREQL")) = 0 And toval(rs.fields("CLAIMFREQU")) = 0) Then
                            Message = Message & "Claim Frequency Between " & Format(toval(rs.fields("CLAIMFREQL")), "##0.00") & " - " & Format(toval(rs.fields("CLAIMFREQU")), "##0.00") & " " & vbCrLf
                        End If
                        If Not (toval(rs.fields("OWNFAULTL")) = 0 And toval(rs.fields("OWNFAULTU")) = 0) Then
                            Message = Message & "Claim Own Fault Between " & Format(toval(rs.fields("OWNFAULTL")), "##0.00") & " - " & Format(toval(rs.fields("OWNFAULTU")), "##0.00") & " " & vbCrLf
                        End If
                        If Not (toval(rs.fields("INSPERIODL")) = 0 And toval(rs.fields("INSPERIODU")) = 0) Then
                            Message = Message & "Insurance Period Between " & Format(toval(rs.fields("INSPERIODL")), "##0") & " - " & Format(toval(rs.fields("INSPERIODU")), "##0") & " " & vbCrLf
                        End If
                        If Not (toval(rs.fields("SUMINSUREDL")) = 0 And toval(rs.fields("SUMINSUREDU")) = 0) Then
                            Message = Message & "Amount Sum Insured Between " & Format(toval(rs.fields("SUMINSUREDL")), "###,###,###,##0") & " - " & Format(toval(rs.fields("SUMINSUREDU")), "###,###,###,##0") & " " & vbCrLf
                        End If
                        If Not (toval(rs.fields("OUTGOL")) = 0 And toval(rs.fields("OUTGOU")) = 0) Then
                            Message = Message & "Policy Out Go Between " & Format(toval(rs.fields("OUTGOL")), "##0.00") & " - " & Format(toval(rs.fields("OUTGOU")), "##0.00") & " " & vbCrLf
                        End If
                    End If
                End If
            Else
                RenewalF = True
                Message = Message & "No Renewal Rule  " & vbCrLf
            End If

            rsRR = db.OpenRemoteSet("Select * from Renewal Where ANO=" & toval(rsr.fields("ANO")))
            If rsRR.Eof Then
                rsRR.AddNew()
                rsRR.fields("Status") = "O"
                rsRR.fields("ASource") = tostr(rsr.fields("ASource"))
                rsRR.fields("UserID") = db_user
                rsRR.fields("CDate") = Today.Date
                If RenewalRuleF Then
                    rsRR.fields("Notes") = tostr(rs.fields("Notes"))
                    rsRR.fields("RCode") = tostr(rs.fields("RCode"))
                    rsRR.fields("OtherVar1") = tostr(rs.fields("OtherVar1"))
                    rsRR.fields("OtherVar2") = tostr(rs.fields("OtherVar2"))
                    rsRR.fields("OtherVar3") = tostr(rs.fields("OtherVar3"))
                    rsRR.fields("Message") = Message
                End If
            Else
                rsRR.Edit()
            End If
            rsRR.fields("LUserID") = db_user
            rsRR.fields("LDate") = Today.Date
            rsRR.fields("ANO") = ANO
            rsRR.fields("LANO") = LANO
            rsRR.fields("CNO") = toval(rsr.fields("CNO"))
            rsRR.fields("NEWANO") = -1
            rsRR.fields("OpenFlag") = OpenFlag
            rsRR.fields("PolicyNo") = PolicyNo
            rsRR.fields("CertificateNo") = CertificateNo
            rsRR.fields("ExpDate") = todate(rsr.fields("EDate"))
            rsRR.fields("RefNo") = tostr(rsr.fields("RefNo"))
            rsRR.fields("SDate") = EDate
            If NumMonth = 0 Then  'Default
                If Day(SDate) <> Day(EDate) Then
                    rsRR.fields("EDate") = DateAdd(DateInterval.Day, DateDiff(DateInterval.Day, SDate, EDate), EDate)
                Else
                    rsRR.fields("EDate") = DateAdd(DateInterval.Month, DateDiff(DateInterval.Month, SDate, EDate), EDate)
                End If
            Else
                rsRR.fields("EDate") = DateAdd(DateInterval.Month, NumMonth, EDate)
            End If
            rsRR.fields("AName") = tostr(rsr.fields("AName"))
            rsRR.fields("TOC") = TOC
            rsRR.fields("Loading") = Loading
            rsRR.fields("PolicyType") = PolicyType
            rsRR.fields("Segment") = SEGMENT
            rsRR.fields("Code") = Code
            rsRR.fields("LossRatio") = LossRatio
            rsRR.fields("ClaimFreq") = ClaimFreq
            rsRR.fields("OwnFault") = OwnFault
            rsRR.fields("OutGo") = OutGo
            rsRR.fields("RenewalF") = (toval(Not CTLF) AndAlso RenewalF AndAlso PaidPremiumF)
            rsRR.fields("PStatus") = "C"    
            If Not rsRR.Update Then
                StrMsg = "Process Fail !; Policy No : " & PolicyNo & "-" & CertificateNo & " !"
                GoTo errmsg
            End If
            If toval(rsRR.fields("RenewalF")) AndAlso (toval(rsr.fields("ANO")) = toval(rsr.fields("LANO")) Or toval(rsr.fields("LANO")) = -1 Or toval(rsr.fields("OpenFlag"))) Then
                If AutoEmailRenewalNoticeF Then
                    Insert_Event_Notification(toval(rsr.fields("ANO")), "POLICY", "POL", "RENEWAL")
                End If
                If AutoPrintRenewalNoticeF Then
                    Insert_Policy_Auto_Print(toval(rsr.fields("ANO")))
                End If
            End If
            rsr.MoveNext()
        Loop
        Generate_Renewal_Data = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Generate_Renewal_Data = False
    End Function
    Private Function Insert_Event_Notification(ByVal APPID As String, ByVal APPTYPE As String, ByVal Category As String, ByVal ERule As String) As Boolean
        On Error GoTo ErrMsg
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select * from AEBucket Where APPID='" & APPID & "' and APPTYPE='" & APPTYPE & "' and Category='" & Category & "' and ERule='" & ERule & "' and Status='R'")
