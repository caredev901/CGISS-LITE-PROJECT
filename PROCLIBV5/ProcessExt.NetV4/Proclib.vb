                    If Not ManualF AndAlso MShare <> 100 Then
                        PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                        If ISType <> "R" And ISType <> "T" Then
                            ' Direct Business
                            rs.fields("XPID") = tostr(rsR.fields("RID"))

                            ' Risk Limit by Reinsurance Type
                            RCLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1)
                            TLimit = RCLimit
                            If Saldo <> 0 Then
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = RCLimit * RiskAssLimit(ANO, "XP", Holdf, Message, RShare, PLimit, PShare)
                                End If
                            Else
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = RCLimit * RLimit
                                End If
                            End If
                            ' Overwrite MaiPark no Table of limit
                            RCLimit = 1
                            TLimit = 1
                        Else
                            ' In-Direct Business
                            rs.fields("XPID") = ""
                            RCLimit = 0
                            TLimit = 0
                        End If

                        If ProformaF OrElse NoRiskAccumulationF Then
                            Share = rsR.fields("Limit") * TLimit
                        Else
                            Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "XP", RYear) + PrevAccRegAmount(ANO, "XP") / (PrevPCTShare / 100 * PrevPCTLOSS / 100 * (100 - PrevMShare) / 100)
                        End If
                        Share = IIf(Share < 0, 0, Share)

                        ' Policy Cession Limit Applicable
                        If PLimit <> 0 Then
                            If toval(rsR.fields("PLimit")) <> 0 Then
                                If Share > PLimit * RCLimit * toval(rsR.fields("PLimit")) Then
                                    Share = PLimit * RCLimit * toval(rsR.fields("PLimit"))
                                End If
                            End If
                        End If

                        If RShare <> 0 Then
                            If Share > OurShare / (PctShare / 100 * PCTLOSS / 100) * RShare / 100 Then
                                Share = OurShare / (PctShare / 100 * PCTLOSS / 100) * RShare / 100
                            End If
