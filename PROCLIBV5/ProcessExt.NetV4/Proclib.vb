    Private Function Apply_Master_RiskCoverage(ByVal LANO As Long, ByVal sFilterCode As String) As Boolean
        Dim rs As RemoteSet
        Dim ANO As Long
        On Error GoTo errmsg

        Dim filterCode As String
        filterCode = Trim(Replace(Replace(Replace(Replace(sFilterCode, "`", ""), "'", ""), ")", ""), "(", ""))
        sFilterCode = ""
        If filterCode <> "" Then
            Dim aFilterCode() As String = filterCode.Split(",")

            For j = LBound(aFilterCode) To UBound(aFilterCode)
                If sFilterCode = "" Then
                    sFilterCode = "'" & aFilterCode(j) & "'"
                Else
                    sFilterCode = sFilterCode & "," & "'" & aFilterCode(j) & "'"
                End If
            Next
            If sFilterCode <> "" Then
                sFilterCode = "(" & sFilterCode & ")"
            End If
        End If

        Dim PTerm As Integer
        rs = db.OpenRemoteSet("Select A.ANO, A.SDate, A.EDate, A.TOC, C.Voyage, TOC.PTERM from Acceptance A, Cover C, TOC Where TOC.TOC=A.TOC and C.CNO=A.CNO and A.AType not in ('A','C') and A.AStatus='W' and A.ANO<>A.LANO and A.LANO=" & LANO)
        Do While Not rs.Eof
            ANO = rs.fields("ANO")
            PTerm = toval(rs.fields("PTerm"))
            If PTerm = 0 Then PTerm = 12
            If sFilterCode <> "" Then
                If Not db.Execute("Delete from RCover Where ANO=" & ANO & " and Code in " & sFilterCode) Then GoTo errmsg
                If Not CopyAccDetail("RCover", LANO, ANO, "(Select * from RCover Where ANO=" & LANO & " and Code in " & sFilterCode & ")") Then GoTo errmsg
                If Not Adjust_RCover(ANO, rs.fields("SDate"), rs.fields("EDate"), rs.fields("SDate"), rs.fields("EDate"), rs.fields("Voyage"), PTerm, rs.fields("TOC"), sFilterCode) Then GoTo errmsg
            Else
                If Not db.Execute("Delete from RCover Where ANO=" & ANO) Then GoTo errmsg
                If Not CopyAccDetail("RCover", LANO, ANO) Then GoTo errmsg
                If Not Adjust_RCover(ANO, rs.fields("SDate"), rs.fields("EDate"), rs.fields("SDate"), rs.fields("EDate"), rs.fields("Voyage"), PTerm, rs.fields("TOC")) Then GoTo errmsg
            End If

            If Not db.Execute("Update Acceptance Set PStatus='I' from Acceptance Where AStatus='W' and ANO=" & ANO) Then GoTo errmsg
            If db.RecordsAffected = 0 Then GoTo errmsg
            rs.MoveNext()
        Loop

        ' Match previous db.begintrans from Calling Function
        db.Committrans()

        ' Premium Calculation
        rs = db.OpenRemoteSet("Select A.ANO from Acceptance A Where A.AType not in ('A','C') and A.PStatus='I' and A.AStatus='W' and A.ANO<>A.LANO and A.LANO=" & LANO)
        Do While Not rs.Eof
            ANO = rs.fields("ANO")
            If Not Me.Direct_Call_Ext_Process("Process.NetV3.Proclib", "Premium_Calc", ANO) Then GoTo ErrMsg
            rs.MoveNext()
        Loop

        db.Begintrans()

        Apply_Master_RiskCoverage = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Apply_Master_RiskCoverage = False
    End Function
    Private Function Apply_Master_Deductible(ByVal LANO As Long) As Boolean
        Dim rs As RemoteSet
        Dim ANO As Long
        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select A.ANO, A.SDate, A.EDate, C.Voyage from Acceptance A, Cover C Where C.CNO=A.CNO and A.AType not in ('A','C') and A.AStatus='W' and A.ANO<>A.LANO and A.LANO=" & LANO)
        Do While Not rs.Eof
            ANO = rs.fields("ANO")
            If Not db.Execute("Delete from AccDed Where ANO=" & ANO) Then GoTo errmsg
            If Not CopyAccDetail("AccDed", LANO, ANO) Then GoTo errmsg
            If Not Adjust_Deductible(ANO, rs.fields("SDate"), rs.fields("EDate")) Then GoTo errmsg
            If Not Adjust_ICover(ANO, rs.fields("SDate"), rs.fields("EDate")) Then GoTo errmsg
            rs.MoveNext()
        Loop
        Apply_Master_Deductible = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Apply_Master_Deductible = False
    End Function
    Private Function Apply_Master_Interest(ByVal LANO As Long) As Boolean
        Dim rs As RemoteSet
        Dim ANO As Long
        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select A.ANO, A.SDate, A.EDate, C.Voyage, TOC.PTERM from Acceptance A, Cover C, TOC Where TOC.TOC=A.TOC and C.CNO=A.CNO and A.AType not in ('A','C') and A.AStatus='W' and A.ANO<>A.LANO and A.LANO=" & LANO)
        Do While Not rs.Eof
            ANO = rs.fields("ANO")
            If Not db.Execute("Delete from ICover Where ANO=" & ANO) Then GoTo errmsg
            If Not CopyInterest(LANO, ANO) Then GoTo errmsg
            If Not Adjust_ICover(ANO, rs.fields("SDate"), rs.fields("EDate")) Then GoTo errmsg
            If Not db.Execute("Update Acceptance Set PStatus='I' from Acceptance Where AStatus='W' and ANO=" & ANO) Then GoTo errmsg
            If db.RecordsAffected = 0 Then GoTo errmsg
            rs.MoveNext()
        Loop

        ' Match previous db.begintrans from Calling Function
        db.Committrans()

        ' Premium Calculation
        rs = db.OpenRemoteSet("Select A.ANO from Acceptance A Where A.AType not in ('A','C') and A.PStatus='I' and A.AStatus='W' and A.ANO<>A.LANO and A.LANO=" & LANO)
        Do While Not rs.Eof
            ANO = rs.fields("ANO")
            If Not Me.Direct_Call_Ext_Process("Process.NetV3.Proclib", "Premium_Calc", ANO) Then GoTo ErrMsg
            rs.MoveNext()
        Loop

        db.Begintrans()

        Apply_Master_Interest = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Apply_Master_Interest = False
    End Function

    Private Function Copy_Facultative_Master(ByVal LANO As Long, ByVal ANO As Long) As Boolean
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet

        Dim rsSrc1 As RemoteSet
        Dim rsDst1 As RemoteSet

        Dim rs As RemoteSet
        Dim FID As String
        Dim SDate As Date
        Dim EDate As Date
        Dim Branch As String
        Dim TOC As String
        Dim CT As String
        Dim AType As String
        Dim PolicyType As String
        Dim ISType As String

        On Error GoTo errmsg


        rs = db.OpenRemoteSet("Select * from RArrDet Where Status='R' and ANO=" & ANO)
        Do While Not rs.Eof
            If Not UnConfirmed_Facultative(ANO, rs.fields("FID")) Then GoTo errmsg
            rs.MoveNext()
        Loop

        ' Delete first
        If Not db.Execute("Delete from RArrDet Where Status='O' and AType='N' and ANO=" & ANO) Then GoTo errmsg

        Dim OurShare As Double
        rs = db.OpenRemoteSet("Select A1.SDate, A1.EDate, A1.Branch, A1.CT, A1.TOC, C1.PolicyType, C1.ISType, R.TAmount as OurShare from Acceptance A1 Left Join RArrHeader R on (R.ANO=A1.ANO), Cover C1 Where C1.CNO=A1.CNO and A1.ANO=" & ANO)
        OurShare = toval(rs.fields("OurShare"))

        Branch = tostr(rs.fields("Branch"))
        TOC = tostr(rs.fields("TOC"))
        CT = tostr(rs.fields("CT"))
        SDate = todate(rs.fields("SDate"))
        EDate = todate(rs.fields("EDate"))
        PolicyType = tostr(rs.fields("PolicyType"))
        ISType = tostr(rs.fields("ISType"))

        rsSrc = db.OpenRemoteSet("Select RArrDet.*,FPart.ID, FPart.SlipNo, Acceptance.SDate as MSDate, Acceptance.EDate as MEDate from RArrDet, FPart, Acceptance Where FPart.ANO=Acceptance.ANO and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.Status in ('R','A') and ('" & Format(SDate, "MM/DD/YYYY") & "' Between RArrDet.SDate and RArrDet.EDate or '" & Format(EDate, "MM/DD/YYYY") & "' Between RArrDet.SDate and RArrDet.EDate) and Acceptance.ANO=" & LANO)
        Do While Not rsSrc.Eof
            rsDst = db.OpenRemoteSet("Select RArrDet.* from RArrDet Where Exists (Select FPart.ANO from FPart Where FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and FPart.ANO=" & ANO & " and FPart.ID='" & rsSrc.fields("ID") & "' and FPart.SlipNo='" & rsSrc.fields("SlipNo") & "')")
            If rsDst.Eof Then
                rsDst.AddNew()
                AType = "N"
                FID = ""
            Else
                rsDst.Edit()
                AType = rsDst.fields("AType")
                FID = rsDst.fields("FID")
            End If

            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("ANO") = ANO
            If FID = "" Then
                FID = GetDocumentNumbering("FS", PolicyType, ISType, Today.Date, Branch, TOC, CT)
            End If
            If FID = "" Then
                StrMsg = "Generate Facultative ID Failed !"
                GoTo errmsg
            End If
            rsDst.fields("AType") = AType
            rsDst.fields("FID") = FID
            If DateDiff(DateInterval.Day, rsSrc.fields("SDate"), SDate) >= 0 Then
                rsDst.fields("SDate") = SDate
            Else
                rsDst.fields("SDate") = rsSrc.fields("SDate")
            End If
            If DateDiff(DateInterval.Day, EDate, rsSrc.fields("EDate")) >= 0 Or DateDiff(DateInterval.Day, rsSrc.fields("MEDate"), rsSrc.fields("EDate")) = 0 Then
                rsDst.fields("EDate") = EDate
            Else
                rsDst.fields("EDate") = rsSrc.fields("EDate")
            End If
            rsDst.fields("Status") = "O"
            rsDst.fields("UserID") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date

            ' Adjust Here
            Dim Amount As Double = 0
            If OurShare <> 0 Then
                If toval(rsDst.fields("Limit")) <> 0 AndAlso toval(rsDst.fields("Limit")) > OurShare Then
                    rsDst.fields("Limit") = 0
                End If

                If toval(rsDst.fields("Amount")) <> 0 Then
                    If toval(rsDst.fields("Limit")) <> 0 Then
                        Amount = toval(rsDst.fields("Share")) / 100 * toval(rsDst.fields("Limit"))
                    Else
                        Amount = toval(rsDst.fields("Share")) / 100 * OurShare
                    End If

                    If Amount > toval(rsDst.fields("Amount")) Then
                        Amount = toval(rsDst.fields("Amount"))
                        If toval(rsDst.fields("Limit")) <> 0 Then
                            rsDst.fields("Share") = Amount / toval(rsDst.fields("Limit")) * 100
                        Else
                            rsDst.fields("Share") = Amount / OurShare * 100
                        End If
                    End If
                    rsDst.fields("Amount") = Amount
                End If
            End If
            If Not rsDst.Update Then GoTo errmsg

            rsSrc1 = db.OpenRemoteSet("Select * from FPart Where ANO=" & LANO & " and FID='" & rsSrc.fields("FID") & "'")
            Do While Not rsSrc1.Eof
                rsDst1 = db.OpenRemoteSet("Select * from FPart Where ANO=" & ANO & " and ID='" & rsSrc1.fields("ID") & "' and SlipNo='" & rsSrc1.fields("SlipNo") & "'")
                If rsDst1.Eof Then
                    rsDst1.AddNew()
                Else
                    rsDst1.Edit()
                End If
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = ANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg

                If Not db.Execute("Delete from FPartDet Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
                If Not db.Execute("Delete from FSecurity Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
                If Not db.Execute("Delete from FDeductible Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
                If Not db.Execute("Delete from FACCla Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
                If Not db.Execute("Delete from FACCon Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
                If Not db.Execute("Delete from FACEx Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
                If Not db.Execute("Delete from FInfo Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FPartDet Where ANO=" & LANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FPartDet Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = ANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FSecurity Where ANO=" & LANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FSecurity Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = ANO
                rsDst1.fields("FID") = FID
                rsDst1.fields("Amount") = toval(rsDst1.fields("Share")) / 100 * Amount
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FDeductible Where ANO=" & LANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FDeductible Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = ANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FACCla Where ANO=" & LANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FACCla Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = ANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FACCon Where ANO=" & LANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FACCon Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = ANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FACEx Where ANO=" & LANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FACEx Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = ANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop

            rsSrc1 = db.OpenRemoteSet("Select * from FInfo Where ANO=" & LANO & " and FID='" & rsSrc.fields("FID") & "'")
            rsDst1 = db.OpenRemoteSet("Select * from FInfo Where 1<>1")
            Do While Not rsSrc1.Eof
                rsDst1.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
                rsDst1.fields("ANO") = ANO
                rsDst1.fields("FID") = FID
                If Not rsDst1.Update Then GoTo errmsg
                rsSrc1.MoveNext()
            Loop
            rsSrc.MoveNext()

            If Not Confirmed_Facultative(ANO, FID) Then GoTo errmsg
        Loop
        Copy_Facultative_Master = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Copy_Facultative_Master = False
    End Function
    Private Function TOP_Process(ByVal Param As Object, Optional ByVal AdjustInterestF As Boolean = False, Optional ByVal AdjustRiskF As Boolean = False, Optional ByVal AdjustTCF As Boolean = False) As Boolean
        Dim rs As RemoteSet
