            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("CNO") = NewCNO
            rsDst.fields("UserId") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("CTime") = Time()
            rsDst.fields("LUserId") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("PANO") = -1
            rsDst.fields("LANO") = NewLANO
            rsDst.fields("ESeqNo") = 0
            rsDst.fields("EESeqNo") = 0
            rsDst.fields("ERSeqNo") = 0
            rsDst.fields("RegDate") = Today.Date
            NewANO = db.GetIdentity("Acceptance") + 1
            rsDst.fields("SplitDNCNF") = False
            rsDst.fields("ANO") = NewANO
            rsDst.fields("BatchNo") = ""
            rsDst.fields("BID") = 0
            rsDst.fields("ASource") = ""
            rsDst.fields("OANO") = NewANO
            rsDst.fields("BackDatedF") = 0
            rsDst.fields("RequestF") = False
            rsDst.fields("RequestMessage") = ""
            rsDst.fields("RequestName") = ""
            rsDst.fields("CUserID") = ""
            rsDst.fields("CLoseDate") = ""
            rsDst.fields("CloseTime") = ""
            rsDst.fields("RUserID") = ""
            rsDst.fields("RUSerDate") = ""
            rsDst.fields("RUSerTime") = ""
            rsDst.fields("AUserID") = ""
            rsDst.fields("AUSerDate") = ""
            rsDst.fields("AUSerTime") = ""
            rsDst.fields("PStatus") = pStatus
            If Not rsDst.Update Then GoTo errmsg
            If Not CopyAcceptance(ANO, NewANO, "N", False, "Q") Then GoTo errmsg

        End If
        rsSrc.CloseRemoteSet()
        rsDst.CloseRemoteSet()

        RevisionDetail = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        RevisionDetail = False
    End Function
    Private Function RevisionMaster(ByVal ANO As Long, ByVal Param As Object) As String
        Dim rs As RemoteSet
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim NewCNO As Long
        Dim NewANO As Long

        On Error GoTo errmsg

        Dim CNO As Long
        Dim RevDate As Date
        Dim Remarks As String
        Dim ISType As String

        CNO = toval(getInParamValue(Param, 0))
        RevDate = todate(getInParamValue(Param, 1))
        Remarks = tostr(getInParamValue(Param, 2))
        ISType = tostr(getInParamValue(Param, 3))

        rsSrc = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        If Not (tostr(rsSrc.fields("CStatus")) = "P") Then
            StrMsg = "Please Check Quotation Status !"
            GoTo errmsg
        End If
        rsDst = db.OpenRemoteSet("Select * from Cover Where 1<>1")
        'Copy Cover & Related Information
        rsDst.AddNew()
        ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
        If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
        rsDst.fields("CStatus") = "R" ' First Register
        rsDst.fields("UserId") = db_user
        rsDst.fields("CDate") = RevDate
        rsDst.fields("CTime") = Time()
        rsDst.fields("LUserId") = db_user
        rsDst.fields("LDate") = Today.Date
        rsDst.fields("LTime") = Time()

        rsDst.fields("PUserID") = ""
        rsDst.fields("PUSerDate") = ""
        rsDst.fields("PUserTime") = ""
        rsDst.fields("CUserID") = ""
        rsDst.fields("CLoseDate") = ""
        rsDst.fields("CLoseTime") = ""
