    Private Function RiskAssLimit(ByVal ANO As Long, ByVal RType As String, ByRef Holdf As Boolean, ByRef Message As String, ByRef RShare As Double, ByRef PLimit As Double, ByRef PShare As Double) As Double
        Dim rs As RemoteSet
        Dim Limit As Double
        Dim i As Integer
        Dim StrMsg As String

        PLimit = 0
        Limit = 0
        RShare = 0
        StrMsg = ""
        rs = db.OpenQueryDef("QRISKASSLIMIT", adOpenForwardonly, ANO, RType)
        If Not rs.Eof Then
            Limit = toval(rs.fields("Limit")) / 100
            PLimit = toval(rs.fields("PLimit")) / 100
            RShare = toval(rs.fields("Share"))
            PShare = toval(rs.fields("PShare"))
            If toval(rs.fields("HoldF")) Then
                Holdf = True
                If tostr(rs.fields("HoldMessage")) <> "" Then
                    If Message <> "" Then Message = Message & Chr(13) & Chr(10)
                    Message = Message & tostr(rs.fields("HoldMessage"))
                End If

                rs = db.OpenRemoteSet("Select R.*, TOC.FLDTAG1, TOC.FLDTAG2, TOC.FLDTAG3, TOC.FLDTAG4, TOC.FLDTAG5, TOC.FLDTAG6, TOC.FLDTAG7, TOC.FLDTAG8, TOC.FLDTAG9, TOC.FLDTAG10, TOC.FLDTAG11, TOC.FLDTAG12, TOC.FLDTAG13, TOC.FLDTAG14, TOC.FLDTAG15 from RiskAss R, TOC Where TOC.TOC=R.TOC and R.RiskAss=" & toval(rs.fields("Riskass")))
                For i = 1 To 15
                    If tostr(rs.fields("FLDID" & i)) <> "" And (tostr(rs.fields("VALUEID" & i)) <> "" Or tostr(rs.fields("VALUEDESC" & i)) <> "") Then
                        If tostr(rs.fields("VALUEID" & i)) <> "" Then
                            StrMsg = StrMsg & tostr(rs.fields("FLDTAG" & i)) & "(" & tostr(rs.fields("FLDID" & i)) & ") : " & tostr(rs.fields("VALUEID" & i)) & "-" & tostr(rs.fields("VALUEDESC" & i))
                        Else
                            StrMsg = StrMsg & tostr(rs.fields("FLDTAG" & i)) & "(" & tostr(rs.fields("FLDID" & i)) & ") : " & tostr(rs.fields("VALUEDESC" & i))
                        End If
                        StrMsg = StrMsg & Chr(13) & Chr(10)
                    End If
                Next
                If StrMsg <> "" Then
                    If Message <> "" Then Message = Message & Chr(13) & Chr(10)
                    Message = Message & StrMsg
                End If
            End If
        End If
        RiskAssLimit = Limit
        rs.CloseRemoteSet()
    End Function
    Private Function CessionLimit(ByVal ANO As Long, ByRef Holdf As Boolean, ByRef Message As String, ByVal PctOurShare As Double, ByVal TSI As Double) As Double
        Dim NCoys As Integer
        Dim ISType As String
        Dim rs As RemoteSet

        rs = db.OpenRemoteSet("Select Cover.ISType from Cover, Acceptance Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        ISType = tostr(rs.fields("ISType"))
        If ISType <> "I" Then

            rs = db.OpenQueryDef("Member_Coys", adOpenForwardonly, ANO)
            NCoys = toval(rs.fields("NCoys")) + 1
            If Not rs.Eof Then If ISType = "C" Then NCoys = NCoys + 1

            rs = db.OpenQueryDef("Treaty_Limit", adOpenForwardonly, ANO, PctOurShare, NCoys, TSI)
            CessionLimit = toval(rs.fields("Limit"))
            If toval(rs.fields("HoldF")) Then
                Holdf = True
                If Message <> "" Then Message = Message & Chr(13) & Chr(10)
                Select Case ISType
                    Case "I"
                        Message = Message & "Inward Facultative Cession."
                    Case "C"
                        Message = Message & "Inward Co Cession."
                    Case "L", "I"
                        Message = Message & "Direct Insured Cession"
                End Select
            End If
        Else
            CessionLimit = 100
        End If
        rs.CloseRemoteSet()
    End Function
