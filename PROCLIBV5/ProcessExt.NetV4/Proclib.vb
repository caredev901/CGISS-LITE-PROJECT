    End Function

    Private Function Save_InwardTreaty_Data(ByVal Param As Object, ByVal findex() As String, ByVal fbuffer() As String) As String

        On Error GoTo errmsg

        ' InParam Variable
        Dim ANO As Long = Param(0)
        Dim rs As RemoteSet
        Dim CNO As Long
        Dim RegNo As String
        Dim CoverDate As Date
        Dim ExpDate As Date
        Dim Branch As String
        Dim CT As String
        Dim TOC As String
        Dim RefNo As String
        Dim RefDate As Date
        Dim ID As String
        Dim EditMode As Integer

        RegNo = GetFieldValue(fbuffer(GetFieldIndex("RegNo", findex)))
        CoverDate = GetFieldValue(fbuffer(GetFieldIndex("CoverDate", findex)))
        ExpDate = GetFieldValue(fbuffer(GetFieldIndex("ExpDate", findex)))
        Branch = GetFieldValue(fbuffer(GetFieldIndex("Branch", findex)))
        CT = GetFieldValue(fbuffer(GetFieldIndex("CT", findex)))
        TOC = GetFieldValue(fbuffer(GetFieldIndex("TOC", findex)))
        RefNo = GetFieldValue(fbuffer(GetFieldIndex("RefNo", findex)))
        RefDate = GetFieldValue(fbuffer(GetFieldIndex("RefDate", findex)))
        ID = GetFieldValue(fbuffer(GetFieldIndex("ID", findex)))

        Dim Voyage As Boolean
        rs = db.OpenRemoteSet("Select Voyage from TOC Where TOC='" & TOC & "'")
        Voyage = rs.fields("Voyage")

        rs = db.OpenRemoteSet("Select * From Acceptance Where ANO=" & ANO)
        If rs.Eof Then
            EditMode = AdEditAdd
        Else
            EditMode = AdEditInProgress
            CNO = toval(rs.fields("CNO"))
        End If

        If EditMode = AdEditAdd Then
            RegNo = GetDocumentNumbering("REG", "", "T", CoverDate, Branch, TOC, CT)
            If RegNo = "" Then
                StrMsg = "Can't Create Inward Treaty Register No. !"
                GoTo errmsg
            End If

            If RefNo = "" Then RefNo = RegNo

            'Creating Cover
            rs = db.OpenRemoteSet("Select * from Cover Where 1<>1")
            rs.AddNew()
            rs.fields("CoverNo") = RegNo
            rs.fields("ISType") = "T"  ' Inward Treaty
            rs.fields("CStatus") = "R"  ' Request
        Else
            rs = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
            rs.Edit()
        End If
        rs.fields("PHolder") = ID
        rs.fields("Insured") = GetFieldValue(fbuffer(GetFieldIndex("Insured", findex)))     ' Ceding Name
        ' Default for Days Basis
        rs.fields("Prorata") = Calc_Prorata(12, CoverDate, ExpDate)
        rs.fields("Voyage") = toval(Voyage)
        rs.fields("PCNO") = -1
        rs.fields("ANO") = -1

        rs.fields("CoverDate") = CoverDate
        rs.fields("ExpDate") = ExpDate
        rs.fields("TOC") = TOC
        rs.fields("RefNo") = RefNo
        rs.fields("RefDate") = RefDate
        rs.fields("MO") = GetFieldValue(fbuffer(GetFieldIndex("MO", findex)))
        rs.fields("Segment") = GetFieldValue(fbuffer(GetFieldIndex("Segment", findex)))
        If EditMode = AdEditAdd Then
            CNO = db.GetIdentity("Cover") + 1
            rs.fields("CNO") = CNO
            rs.fields("UserID") = db_user
            rs.fields("CDate") = Today.Date
            rs.fields("CTime") = Time()
        End If
        rs.fields("LUserID") = db_user
        rs.fields("LDate") = Today.Date
        rs.fields("LTime") = Time()

        If Not rs.Update Then GoTo errmsg

        ' Creating Insurance Source
        If EditMode = AdEditAdd Then
            rs = db.OpenRemoteSet("Select * from ISource Where 1<>1")
            rs.AddNew()
        Else
            rs = db.OpenQueryDef("QISource", adOpenKeyset, CNO)
            rs.Edit()
        End If
        rs.fields("CNO") = CNO
        rs.fields("RType") = GetFieldValue(fbuffer(GetFieldIndex("RType", findex)))
        rs.fields("ID") = ID
        rs.fields("CedingID") = GetFieldValue(fbuffer(GetFieldIndex("CedingID", findex)))
        rs.fields("Share") = GetFieldValue(fbuffer(GetFieldIndex("Share", findex)))
        rs.fields("Fee") = GetFieldValue(fbuffer(GetFieldIndex("RIComm", findex)))
        rs.fields("UjrohCedant") = GetFieldValue(fbuffer(GetFieldIndex("UjrohCedant", findex)))
        rs.fields("UJrohReins") = GetFieldValue(fbuffer(GetFieldIndex("UJrohReins", findex)))
        If Not rs.Update Then GoTo errmsg
        rs.CloseRemoteSet()

        Dim Payor As String
        Payor = ID

        ' Creating Acceptance
        If EditMode = AdEditAdd Then
            rs = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
            rs.AddNew()
            rs.fields("PolicyNo") = GetDocumentNumbering("POL", "", "T", CoverDate, Branch, TOC, CT, True)
            If rs.fields("PolicyNo") = "" Then
                StrMsg = "Generate Policy No. Failed !"
                GoTo errmsg
            End If
            rs.fields("AType") = "N"    ' New Policy
            rs.fields("AStatus") = "W"  ' Waiting
        Else
            rs = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
            rs.Edit()
        End If
        If rs.fields("AStatus") <> "W" Then
            StrMsg = "Inward Policy Already Processed !"
            GoTo errmsg
        End If
        rs.fields("TOC") = TOC
        rs.fields("RegNo") = RegNo
        rs.fields("Branch") = Branch
        rs.fields("CT") = GetFieldValue(fbuffer(GetFieldIndex("CT", findex)))
        rs.fields("NCDate") = GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex)))
        rs.fields("AName") = GetFieldValue(fbuffer(GetFieldIndex("Insured", findex)))     ' Ceding Name
        rs.fields("AID") = ID
        rs.fields("CNO") = CNO
        rs.fields("SDate") = CoverDate
        rs.fields("Edate") = ExpDate
        rs.fields("PDate") = CoverDate
        rs.fields("PPDate") = ExpDate
        rs.fields("PStatus") = "I"
        rs.fields("CertificateNo") = ""
        rs.fields("pANO") = -1     ' Previous ANO
        rs.fields("RefNo") = RefNo
        rs.fields("RefDate") = RefDate
        If EditMode = AdEditAdd Then
            ANO = db.GetIdentity("Acceptance") + 1
            rs.fields("UserID") = db_user
            rs.fields("CDate") = Today.Date
            rs.fields("CTime") = Time()
        Else
            ANO = toval(rs.fields("ANO"))
        End If
        rs.fields("ANO") = ANO
        rs.fields("LANO") = ANO
        rs.fields("OANO") = ANO
        rs.fields("RANO") = -1
        rs.fields("BANO") = -1
        rs.fields("BizMapID") = Get_BizMap(ANO)
        rs.fields("LUserID") = db_user
        rs.fields("LDate") = Today.Date
        rs.fields("LTime") = Time()
        If Not rs.Update Then GoTo errmsg

        If tostr(GetFieldValue(fbuffer(GetFieldIndex("BSID", findex)))) <> "" Then
            rs = db.OpenRemoteSet("Select * from AccBS Where ANO=" & ANO & " and BSType='B'")
            If rs.Eof Then
                rs.AddNew()
            Else
                rs.Edit()
            End If
            rs.fields("ANO") = ANO
            rs.fields("ID") = GetFieldValue(fbuffer(GetFieldIndex("BSID", findex)))
            rs.fields("Fee") = GetFieldValue(fbuffer(GetFieldIndex("BSFee", findex)))
            rs.fields("BSType") = "B"
            If rs.fields("OBSType") = "" Then rs.fields("OBSType") = rs.fields("BSType")
            If Not rs.Update Then GoTo errmsg
            rs.CloseRemoteSet()
            Payor = GetFieldValue(fbuffer(GetFieldIndex("BSID", findex)))
        Else
            If Not db.Execute("Delete from AccBS Where ANO=" & ANO & " and BSType='B'") Then GoTo errmsg
        End If

        If tostr(GetFieldValue(fbuffer(GetFieldIndex("OtherID", findex)))) <> "" Then
            rs = db.OpenRemoteSet("Select * from AccBS Where ANO=" & ANO & " and BSType='O'")
            If rs.Eof Then
                rs.AddNew()
            Else
                rs.Edit()
            End If
            rs.fields("ANO") = ANO
            rs.fields("ID") = GetFieldValue(fbuffer(GetFieldIndex("OtherID", findex)))
            rs.fields("Fee") = GetFieldValue(fbuffer(GetFieldIndex("OtherFee", findex)))
            rs.fields("BSType") = "O"
            If rs.fields("OBSType") = "" Then rs.fields("OBSType") = rs.fields("BSType")
            If Not rs.Update Then GoTo errmsg
            rs.CloseRemoteSet()
        Else
            If Not db.Execute("Delete from AccBS Where ANO=" & ANO & " and BSType='O'") Then GoTo errmsg
        End If

        If tostr(GetFieldValue(fbuffer(GetFieldIndex("Code", findex)))) <> "" Then
            rs = db.OpenRemoteSet("Select * from RCover Where ANO=" & ANO)
            If rs.Eof Then
                rs.AddNew()
            Else
                rs.Edit()
            End If
            rs.fields("ANO") = ANO
            rs.fields("Code") = GetFieldValue(fbuffer(GetFieldIndex("Code", findex)))
            rs.fields("SDate") = CoverDate
            rs.fields("EDate") = ExpDate
            If Not rs.Update Then GoTo errmsg
            rs.CloseRemoteSet()
        Else
            If Not db.Execute("Delete from RCover Where ANO=" & ANO) Then GoTo errmsg
        End If

        Dim rsProfile As RemoteSet
        rsProfile = db.OpenRemoteSet("Select * from Profile where ID='" & Payor & "'", adOpenKeyset)
        If EditMode = AdEditAdd Then
            rs = db.OpenRemoteSet("Select * from Payor where 1<>1")
            rs.AddNew()
        Else
            rs = db.OpenQueryDef("QPayor", adOpenKeyset, ANO)
            rs.Edit()
        End If
        rs.fields("ANO") = ANO
        rs.fields("ID") = tostr(rsProfile.fields("ID"))
        rs.fields("Address_1") = tostr(rsProfile.fields("Address_1"))
        rs.fields("Address_2") = tostr(rsProfile.fields("Address_2"))
        rs.fields("Address_3") = tostr(rsProfile.fields("Address_3"))
        If Not rs.Update Then GoTo errmsg
        rs.CloseRemoteSet()
        rsProfile.CloseRemoteSet()

        If Not Save_Object_Info(ANO, findex, fbuffer, CoverDate, TOC, "") Then GoTo errmsg

        Save_InwardTreaty_Data = ANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_InwardTreaty_Data = 0
    End Function

    Private Function Save_Policy_Data(ByVal Param As Object, ByVal findex() As String, ByVal fbuffer() As String) As String
        Dim rs As RemoteSet
        Dim rss As RemoteSet
        Dim rsd As RemoteSet
        Dim i As Integer
        Dim PSDate As Date
        Dim PEDate As Date
        Dim SDate As Date
        Dim EDate As Date
        Dim PDate As Date
        Dim PHolder As String
        Dim PPHolder As String
        Dim PayorID As String
        Dim PRefNo As String
        Dim RefNo As String
        Dim pBranch As String
        Dim Branch As String
        Dim CT As String
        Dim pCT As String
        Dim pAID As String
        Dim OldCANO As Long = -1

        On Error GoTo errmsg

        ' InParam Variable
