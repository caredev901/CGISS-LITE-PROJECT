    Private Function Convert_To_Master(ByVal ANO As Long, ByVal LANO As Long, ByVal CNO As Long, ByVal PolicyType As String, ByVal ISType As String, ByVal TOC As String) As String
        Dim rsCover As RemoteSet
        Dim rsDst As RemoteSet
        Dim rsSrc As RemoteSet
        Dim NewANO As Long
        Dim CertNum As Long
        On Error GoTo errmsg

        NewANO = 0

        If Not db.GetLockedObject("CERTNUM" & CNO) Then GoTo errmsg
        rsCover = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        rsCover.Edit()
        rsCover.fields("PolicyType") = PolicyType
        rsCover.fields("ISType") = ISType
        CertNum = 1 ' Always One
        rsCover.fields("CertNum") = CertNum
        If TOC <> "" Then
            rsCover.fields("TOC") = TOC
        End If
        If Not rsCover.Update Then GoTo errmsg
        If Not db.ReleaseLockedObject("CERTNUM" & CNO) Then GoTo errmsg

        rsSrc = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
        If Not rsSrc.Eof Then
            If TOC <> "" AndAlso rsSrc.fields("TOC") <> TOC Then
                Dim rs1 As RemoteSet
                Dim rs2 As RemoteSet
                Dim rsTOC As RemoteSet
                rsTOC = db.OpenRemoteSet("Select * from TOC Where TOC='" & TOC & "'")

                Dim ValueID(30) As String
                Dim ValueDesc(30) As String

                rs1 = db.OpenRemoteSet("Select * from AInfo Where ANO=" & ANO)

                If rs1.Eof Then
                    rs1.AddNew()
                    rs1.fields("ANO") = ANO
                Else
                    rs1.Edit()
                End If


                For i = 1 To 30
                    For j = 1 To 30
                        If j <= 15 Then
                            If rsTOC.fields("FLDID" & i) = rs1.fields("FLDID" & j) Then
                                ValueID(i - 1) = rs1.fields("ValueID" & j)
                                ValueDesc(i - 1) = rs1.fields("ValueDesc" & j)
                                Exit For
                            End If
                        Else
                            If rsTOC.fields("FLDID" & i) = rs2.fields("FLDID" & j) Then
                                ValueID(i - 1) = rs2.fields("ValueID" & j)
                                ValueDesc(i - 1) = rs2.fields("ValueDesc" & j)
                                Exit For
                            End If
                        End If
                    Next
                Next

                For i = 1 To 30
                    If i <= 15 Then
                        rs1.fields("FLDID" & i) = rsTOC.fields("FLDID" & i)
                        rs1.fields("ValueID" & i) = tostr(ValueID(i - 1))
                        rs1.fields("ValueDesc" & i) = tostr(ValueDesc(i - 1))
                    Else
                        rs2.fields("FLDID" & i) = rsTOC.fields("FLDID" & i)
                        rs2.fields("ValueID" & i) = tostr(ValueID(i - 1))
                        rs2.fields("ValueDesc" & i) = tostr(ValueDesc(i - 1))
                    End If
                Next

                If Not rs1.Update Then GoTo errmsg
                If Not rs2.Update Then GoTo errmsg

                ' Cleansing
                If Not db.Execute("Delete from RCover Where RCover.ANO=" & ANO & " and Not exists (Select R1.Code from RateTab R1, RateCov R2, RClass R3 Where R1.Code=RCover.COde and R2.Code=R1.Code and R3.TOR=R2.TOR and R1.TOC=substring('" & TOC & "',1,len(R1.TOC)) and R3.TOC='" & TOC & "')") Then GoTo errmsg
                If Not db.Execute("Delete from AccDed Where AccDed.ANO=" & ANO & " and Not Exists (Select R3.TOR from RCover R1, RateCov R2, RClass R3 Where R1.ANO=AccDed.ANO and R3.TOR=AccDed.TOR and R2.Code=R1.Code and R3.TOR=R2.TOR and R3.TOC='" & TOC & "')") Then GoTo errmsg
                If Not db.Execute("Delete from ICover Where ICover.ANO=" & ANO & " and Not Exists (Select R3.TOR from RCover R1, RateCov R2, RClass R3, PClass R4 Where R1.ANO=ICover.ANO and R2.Code=R1.Code and R3.TOR=R2.TOR and R4.TOR=R3.TOR and R4.TOI=ICover.TOI and R3.TOC='" & TOC & "')") Then GoTo errmsg

                rsSrc.Edit()

                ' Update Wording
                Dim pWordingID = rsSrc.fields("pWordingID")
                Dim rs As RemoteSet
                If pWordingID <> "" Then
                    rs = db.OpenRemoteSet("Select WordingID from WordingTOC Where WordingID='" & pWordingID & "' and TOC='" & TOC & "'")
                    pWordingID = rs.fields("WordingID")
                End If
                rsSrc.fields("pWordingID") = pWordingID
                rsSrc.fields("PStatus") = "I"
                rsSrc.fields("TOC") = TOC
                If Not rsSrc.Update Then GoTo errmsg
            End If

            ' Creating Master Policy
            rsDst = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            NewANO = db.GetIdentity("Acceptance") + 1
            rsDst.fields("OANO") = NewANO
            rsDst.fields("ANO") = NewANO
            rsDst.fields("LANO") = NewANO
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("ValueID") = ""
            rsDst.fields("ValueDesc") = ""
            rsDst.fields("FLDID") = ""
            rsDst.fields("PStatus") = "I"   ' In-Consistent
            rsDst.fields("PANO") = -1
            rsDst.fields("AdjustableF") = False
            If Not rsDst.Update Then GoTo errmsg
        Else
            GoTo errmsg
        End If
        rsDst.CloseRemoteSet()
        rsSrc.CloseRemoteSet()

        If Not CopyAccDetail("RCover", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("RCoverDet", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccDed", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccDA", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccCA", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccSection", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AInfo", ANO, NewANO) Then GoTo errmsg

        If Not CopyAccDetail("AccCla", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccCon", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccEx", ANO, NewANO) Then GoTo errmsg
        If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & NewANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

        ' Update Detail Policy
        If Not db.Execute("Update Acceptance Set CertificateNo='" & GetCertificateNumber(CertNum) & "', Qty=1, LANO=" & NewANO & " Where ANO=" & ANO) Then GoTo errmsg

        If Not db.Execute("Update Payor Set ANO=" & NewANO & " Where ANO=" & ANO) Then GoTo errmsg
        If Not db.Execute("Update AccBS Set ANO=" & NewANO & " Where ANO=" & ANO) Then GoTo errmsg
        If Not db.Execute("Update AccFD Set ANO=" & NewANO & " Where ANO=" & ANO) Then GoTo errmsg

        Select Case ISType
            Case "C"    ' Coinsurance Member
                If Not db.Execute("Delete ACCFD from ACCFD Where Not Exists (Select FDTYPE from FDTAB Where FDTAB.FDID=ACCFD.FDID and (FDType Like 'O%' or FDType Like 'D%')) and ACCFD.ANO=" & NewANO) Then GoTo errmsg
            Case "L"
                If Not db.Execute("Delete from ISource Where CNO=" & CNO) Then GoTo errmsg
            Case "I"    ' Direct
                If Not db.Execute("Delete from ISource Where CNO=" & CNO) Then GoTo errmsg
                If Not db.Execute("Delete from Coinsurance Where CNO=" & CNO) Then GoTo errmsg
            Case "R"    ' Inward Facultative
                If Not db.Execute("Delete ACCFD from ACCFD Where Not Exists (Select FDTYPE from FDTAB Where FDTAB.FDID=ACCFD.FDID and (FDType Like 'O%')) and ACCFD.ANO=" & NewANO) Then GoTo errmsg
                If Not db.Execute("Delete from Coinsurance Where CNO=" & CNO) Then GoTo errmsg
            Case "T"    ' Inward Treaty
                If Not db.Execute("Delete ACCFD from ACCFD Where Not Exists (Select FDTYPE from FDTAB Where FDTAB.FDID=ACCFD.FDID and (FDType Like 'O%')) and ACCFD.ANO=" & NewANO) Then GoTo errmsg
                If Not db.Execute("Delete from Coinsurance Where CNO=" & CNO) Then GoTo errmsg
        End Select

        Convert_To_Master = NewANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Convert_To_Master = 0
    End Function

    Private Function Convert_PolicyType(ByVal ANO As Long, ByVal LANO As Long, ByVal CNO As Long, ByVal PolicyType As String, ByVal ISType As String, ByVal TOC As String) As String
        Dim rsSrc As RemoteSet
        Dim rs As RemoteSet
        On Error GoTo errmsg
        Dim SType As String

        rs = db.OpenRemoteSet("Select SType from PolicyType Where PolicyType='" & PolicyType & "'")
        SType = rs.fields("SType")

        rsSrc = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        rsSrc.Edit()
        rsSrc.fields("PolicyType") = PolicyType
        rsSrc.fields("ISType") = ISType
        Select Case SType
            Case "S", "M"
                rsSrc.fields("OpenFlag") = False
            Case Else
                rsSrc.fields("OpenFlag") = True
        End Select
        If TOC <> "" Then
            rsSrc.fields("TOC") = TOC
        End If
        If Not rsSrc.Update Then GoTo errmsg

        If ANO = LANO Then
            rsSrc = db.OpenRemoteSet("Select * from Acceptance Where LANO=" & ANO)
        Else
            rsSrc = db.OpenRemoteSet("Select * from Acceptance Where ANO=" & ANO)
        End If

        Dim tANO As Long
        If Not rsSrc.Eof Then
            Do While Not rsSrc.Eof
                tANO = rsSrc.fields("ANO")
                rsSrc.Edit()
                If TOC <> "" AndAlso rsSrc.fields("TOC") <> TOC Then

                    Dim rs1 As RemoteSet
                    Dim rs2 As RemoteSet
                    Dim rsTOC As RemoteSet
                    rsTOC = db.OpenRemoteSet("Select * from TOC Where TOC='" & TOC & "'")

                    Dim ValueID(30) As String
                    Dim ValueDesc(30) As String

                    rs1 = db.OpenRemoteSet("Select * from AInfo Where ANO=" & tANO)

                    If rs1.Eof Then
                        rs1.AddNew()
                        rs1.fields("ANO") = tANO
                    Else
                        rs1.Edit()
                    End If


                    For i = 1 To 30
                        For j = 1 To 30
                            If j <= 15 Then
                                If rsTOC.fields("FLDID" & i) = rs1.fields("FLDID" & j) Then
                                    ValueID(i - 1) = rs1.fields("ValueID" & j)
                                    ValueDesc(i - 1) = rs1.fields("ValueDesc" & j)
                                    Exit For
                                End If
                            Else
                                If rsTOC.fields("FLDID" & i) = rs2.fields("FLDID" & j) Then
                                    ValueID(i - 1) = rs2.fields("ValueID" & j)
                                    ValueDesc(i - 1) = rs2.fields("ValueDesc" & j)
                                    Exit For
                                End If
                            End If
                        Next
                    Next

                    For i = 1 To 30
                        If i <= 15 Then
                            rs1.fields("FLDID" & i) = rsTOC.fields("FLDID" & i)
                            rs1.fields("ValueID" & i) = tostr(ValueID(i - 1))
                            rs1.fields("ValueDesc" & i) = tostr(ValueDesc(i - 1))
                        Else
                            rs2.fields("FLDID" & i) = rsTOC.fields("FLDID" & i)
                            rs2.fields("ValueID" & i) = tostr(ValueID(i - 1))
                            rs2.fields("ValueDesc" & i) = tostr(ValueDesc(i - 1))
                        End If
                    Next

                    If Not rs1.Update Then GoTo errmsg
                    If Not rs2.Update Then GoTo errmsg

                    ' Cleansing
                    If Not db.Execute("Delete from RCover Where RCover.ANO=" & tANO & " and Not exists (Select R1.Code from RateTab R1, RateCov R2, RClass R3 Where R1.Code=RCover.COde and R2.Code=R1.Code and R3.TOR=R2.TOR and R1.TOC=substring('" & TOC & "',1,len(R1.TOC)) and R3.TOC='" & TOC & "')") Then GoTo errmsg
                    If Not db.Execute("Delete from AccDed Where AccDed.ANO=" & tANO & " and Not Exists (Select R3.TOR from RCover R1, RateCov R2, RClass R3 Where R1.ANO=AccDed.ANO and R3.TOR=AccDed.TOR and R2.Code=R1.Code and R3.TOR=R2.TOR and R3.TOC='" & TOC & "')") Then GoTo errmsg
                    If Not db.Execute("Delete from ICover Where ICover.ANO=" & tANO & " and Not Exists (Select R3.TOR from RCover R1, RateCov R2, RClass R3, PClass R4 Where R1.ANO=ICover.ANO and R2.Code=R1.Code and R3.TOR=R2.TOR and R4.TOR=R3.TOR and R4.TOI=ICover.TOI and R3.TOC='" & TOC & "')") Then GoTo errmsg

                    ' Update Wording
                    Dim pWordingID = rsSrc.fields("pWordingID")
                    If pWordingID <> "" Then
                        rs = db.OpenRemoteSet("Select WordingID from WordingTOC Where WordingID='" & pWordingID & "' and TOC='" & TOC & "'")
                        pWordingID = rs.fields("WordingID")
                    End If
                    rsSrc.fields("pWordingID") = pWordingID
                    rsSrc.fields("PStatus") = "I"
                    rsSrc.fields("TOC") = TOC
                End If
                If Not rsSrc.UpdateRow Then GoTo errmsg
                rsSrc.MoveNext()
            Loop
            rsSrc.MoveFirst()
            If Not rsSrc.Update Then GoTo errmsg
        End If

        Select Case ISType
            Case "C"    ' Coinsurance Member
                If Not db.Execute("Delete ACCFD from ACCFD Where Not Exists (Select FDTYPE from FDTAB Where FDTAB.FDID=ACCFD.FDID and (FDType Like 'O%' or FDType Like 'D%')) and ACCFD.ANO=" & ANO) Then GoTo errmsg
            Case "L"
                If Not db.Execute("Delete from ISource Where CNO=" & CNO) Then GoTo errmsg
            Case "I"    ' Direct
                If Not db.Execute("Delete from ISource Where CNO=" & CNO) Then GoTo errmsg
                If Not db.Execute("Delete from Coinsurance Where CNO=" & CNO) Then GoTo errmsg
            Case "R"    ' Inward Facultative
                If Not db.Execute("Delete ACCFD from ACCFD Where Not Exists (Select FDTYPE from FDTAB Where FDTAB.FDID=ACCFD.FDID and (FDType Like 'O%')) and ACCFD.ANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Delete from Coinsurance Where CNO=" & CNO) Then GoTo errmsg
            Case "T"    ' Inward Treaty
                If Not db.Execute("Delete ACCFD from ACCFD Where Not Exists (Select FDTYPE from FDTAB Where FDTAB.FDID=ACCFD.FDID and (FDType Like 'O%')) and ACCFD.ANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Delete from Coinsurance Where CNO=" & CNO) Then GoTo errmsg
        End Select

        Convert_PolicyType = ANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Convert_PolicyType = 0
    End Function

    Private Function Convert_To_Individual(ByVal ANO As Long, ByVal LANO As Long, ByVal CNO As Long, ByVal PolicyType As String, ByVal ISType As String, ByVal TOC As String) As String
        Dim rsDst As RemoteSet
        Dim rsSrc As RemoteSet
        Dim NewCNO As Long
        Dim CertNum As Long
        On Error GoTo errmsg

        NewCNO = 0

        rsSrc = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        rsDst = db.OpenRemoteSet("Select * from Cover Where 1<>1")
        rsDst.AddNew()
        ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
        If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
        NewCNO = db.GetIdentity("Cover") + 1
        rsDst.fields("CNO") = NewCNO
        rsDst.fields("PolicyType") = PolicyType
        rsDst.fields("ISType") = ISType
        rsDst.fields("CertNum") = 0
        If TOC <> "" Then
            rsDst.fields("TOC") = TOC
        End If
        If Not rsDst.Update Then GoTo errmsg
        If Not CopyCover(CNO, NewCNO, ISType) Then GoTo errmsg

        rsSrc = db.OpenRemoteSet("Select * from AACCBS Where ANO=" & ANO)
        If rsSrc.Eof Then
            rsSrc = db.OpenRemoteSet("Select * from ACCBS Where ANO=" & LANO)
        End If
        If Not rsSrc.Eof Then
            rsDst = db.OpenRemoteSet("Select * from AccBS Where 1<>1")
            rsDst.AddNew()
            If Not db.backup_record(rsSrc, rsDst) Then GoTo errmsg
            rsDst.fields("ANO") = ANO
            If Not rsDst.Update Then GoTo errmsg
        End If



        rsSrc = db.OpenRemoteSet("Select * from APayor Where ANO=" & ANO)
        If rsSrc.Eof Then
            rsSrc = db.OpenRemoteSet("Select * from Payor Where ANO=" & LANO)
        End If
        If Not rsSrc.Eof Then
            rsDst = db.OpenRemoteSet("Select * from Payor Where 1<>1")
            rsDst.AddNew()
            If Not db.backup_record(rsSrc, rsDst) Then GoTo errmsg
            rsDst.fields("ANO") = ANO
            If Not rsDst.Update Then GoTo errmsg
        End If



        ' Update Detail Policy
        Dim PDate As Date
        Dim SDate As Date
        Dim EDate As Date
        Dim AType As String
        Dim AnnualTreatyF As Boolean
        rsSrc = db.OpenRemoteSet("Select * from Acceptance Where ANO=" & ANO)
        If Not rsSrc.Eof Then
            PDate = todate(rsSrc.fields("PDate"))
            SDate = todate(rsSrc.fields("SDate"))
            EDate = todate(rsSrc.fields("EDate"))
            AType = tostr(rsSrc.fields("AType"))
            AnnualTreatyF = toval(rsSrc.fields("AnnualTreatyF"))
            rsSrc.Edit()
            rsSrc.fields("CNO") = NewCNO
            rsSrc.fields("LANO") = -1
            rsSrc.fields("CertificateNo") = ""
            If rsSrc.fields("RegNo") <> "" Then
                ' Create New RegNo
                Dim rs As RemoteSet
                Dim RegNo As String
                RegNo = GetDocumentNumbering("REG", PolicyType, ISType, PDate, rsSrc.fields("Branch"), TOC, rsSrc.fields("CT"))
                If RegNo = "" Then
                    StrMsg = "Generate Register Number Failed !"
                    GoTo errmsg
                End If
                rsSrc.fields("RegNo") = RegNo
            End If

            If TOC <> "" AndAlso rsSrc.fields("TOC") <> TOC Then
                Dim rs1 As RemoteSet
                Dim rs2 As RemoteSet
                Dim rsTOC As RemoteSet
                rsTOC = db.OpenRemoteSet("Select * from TOC Where TOC='" & TOC & "'")

                Dim ValueID(30) As String
                Dim ValueDesc(30) As String

                rs1 = db.OpenRemoteSet("Select * from AInfo Where ANO=" & ANO)

                If rs1.Eof Then
                    rs1.AddNew()
                    rs1.fields("ANO") = ANO
                Else
                    rs1.Edit()
                End If


                For i = 1 To 30
                    For j = 1 To 30
                        If j <= 15 Then
                            If rsTOC.fields("FLDID" & i) = rs1.fields("FLDID" & j) Then
                                ValueID(i - 1) = rs1.fields("ValueID" & j)
                                ValueDesc(i - 1) = rs1.fields("ValueDesc" & j)
                                Exit For
                            End If
                        Else
                            If rsTOC.fields("FLDID" & i) = rs2.fields("FLDID" & j) Then
                                ValueID(i - 1) = rs2.fields("ValueID" & j)
                                ValueDesc(i - 1) = rs2.fields("ValueDesc" & j)
                                Exit For
                            End If
                        End If
                    Next
                Next

                For i = 1 To 30
                    If i <= 15 Then
                        rs1.fields("FLDID" & i) = rsTOC.fields("FLDID" & i)
                        rs1.fields("ValueID" & i) = tostr(ValueID(i - 1))
                        rs1.fields("ValueDesc" & i) = tostr(ValueDesc(i - 1))
                    Else

                    End If
                Next

                If Not rs1.Update Then GoTo errmsg
                If Not rs2.Update Then GoTo errmsg

                ' Cleansing
                If Not db.Execute("Delete from RCover Where RCover.ANO=" & ANO & " and Not exists (Select R1.Code from RateTab R1, RateCov R2, RClass R3 Where R1.Code=RCover.COde and R2.Code=R1.Code and R3.TOR=R2.TOR and R1.TOC=substring('" & TOC & "',1,len(R1.TOC)) and R3.TOC='" & TOC & "')") Then GoTo errmsg
                If Not db.Execute("Delete from AccDed Where AccDed.ANO=" & ANO & " and Not Exists (Select R3.TOR from RCover R1, RateCov R2, RClass R3 Where R1.ANO=AccDed.ANO and R3.TOR=AccDed.TOR and R2.Code=R1.Code and R3.TOR=R2.TOR and R3.TOC='" & TOC & "')") Then GoTo errmsg
                If Not db.Execute("Delete from ICover Where ICover.ANO=" & ANO & " and Not Exists (Select R3.TOR from RCover R1, RateCov R2, RClass R3, PClass R4 Where R1.ANO=ICover.ANO and R2.Code=R1.Code and R3.TOR=R2.TOR and R4.TOR=R3.TOR and R4.TOI=ICover.TOI and R3.TOC='" & TOC & "')") Then GoTo errmsg

                ' Update Wording
                Dim pWordingID = rsSrc.fields("pWordingID")
                Dim rs As RemoteSet
                If pWordingID <> "" Then
                    rs = db.OpenRemoteSet("Select WordingID from WordingTOC Where WordingID='" & pWordingID & "' and TOC='" & TOC & "'")
                    pWordingID = rs.fields("WordingID")
                End If
                rsSrc.fields("pWordingID") = pWordingID
                rsSrc.fields("PStatus") = "I"
                rsSrc.fields("TOC") = TOC
            End If
            If Not rsSrc.Update Then GoTo errmsg
        End If

        rsSrc = db.OpenRemoteSet("Select * from RArrHeader Where ANO=" & ANO)
        If Not rsSrc.Eof Then
            Dim RDATE As Date
            Dim NRDATE As Date
            RDATE = todate(rsSrc.fields("RDate"))
            NRDATE = todate(rsSrc.fields("NRDate"))

            If AnnualTreatyF Then
                ' Check for Leap Year
                If Month(DateSerial(Year(PDate), Month(SDate), Day(SDate))) <> Month(SDate) Then
                    RDATE = DateAdd(DateInterval.Day, -1, DateSerial(Year(PDate), Month(SDate), Day(SDate)))
                Else
                    RDATE = DateSerial(Year(PDate), Month(SDate), Day(SDate))
                End If
                If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)
                If DateDiff(DateInterval.Day, PDate, RDATE) < 0 Then RDATE = DateAdd(DateInterval.Month, 12, RDATE)
                If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)

                If DateDiff(DateInterval.Day, SDate, RDATE) < 0 Then RDATE = SDate
                NRDATE = DateAdd(DateInterval.Month, 12, RDATE)
                If DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
            Else
                If AType = "N" Then RDATE = SDate
                If DateDiff(DateInterval.Day, SDate, RDATE) < 0 Then RDATE = SDate
                If DateDiff(DateInterval.Day, EDate, RDATE) > 0 Then RDATE = EDate
                If DateDiff(DateInterval.Day, SDate, NRDATE) < 0 Then NRDATE = SDate
                If DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
                If DateDiff(DateInterval.Day, RDATE, NRDATE) <= 0 Then
                    RDATE = SDate
                    NRDATE = EDate
                End If
            End If

            If AType = "N" Then
                rsSrc.fields("PDate") = RDATE
                rsSrc.fields("PPDate") = NRDATE
            Else
                ' Clean Cut
                If Not (DateDiff(DateInterval.Day, rsSrc.fields("PDate"), rsSrc.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rsSrc.fields("PPDate"), rsSrc.fields("NRDate")) = 0) Then
                    If DateDiff(DateInterval.Day, rsSrc.fields("PPDate"), PDate) >= 0 Then
                        RDATE = rsSrc.fields("PPDate")
                    End If

                    If DateDiff(DateInterval.Day, RDATE, rsSrc.fields("PDate")) >= 0 Then
                        RDATE = rsSrc.fields("PDate")
                    End If
                Else
                    rsSrc.fields("PDate") = RDATE
                    rsSrc.fields("PPDate") = NRDATE
                End If
            End If

            rsSrc.fields("LDate") = Today.Date
            rsSrc.fields("LUserID") = db_user
            rsSrc.fields("NCDate") = RDATE
            rsSrc.fields("RDate") = RDATE
            rsSrc.fields("NRDate") = NRDATE
            If Not rsSrc.Update Then GoTo errmsg
        End If

        Convert_To_Individual = ANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Convert_To_Individual = 0
    End Function


    Private Function Scheme_Undo_Verify(ByVal TrNo As Long) As Boolean
        Dim ANO As Long
        Dim rsTr As RemoteSet

        On Error GoTo errmsg
        rsTr = db.OpenRemoteSet("Select ANO from Scheme_Transaction Where TrNo=" & TrNo)
        If rsTr.Eof Then GoTo errmsg
        ANO = toval(rsTr.fields("ANO"))
        If Not DropAcceptanceDetail(ANO) Then GoTo errmsg

