        Dim DCode As String = Param(2)
        Dim Section As String = Param(3)
        Dim PolicyYear As Integer = Param(4)
        Dim SDate As Date = Param(5)
        Dim EDate As Date = Param(6)

        Dim PTOR As String
        Dim PDCode As String
        Dim PSection As String
