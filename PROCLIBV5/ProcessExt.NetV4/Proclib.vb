            rs.fields("BRID") = rsSrc.fields("BRID")
            rs.fields("BRComm") = toval(rsSrc.fields("BRComm"))

            For i = 1 To 24
                rs.fields("IDate_" & i) = rsSrc.fields("IDate_" & i)
                rs.fields("IPCT_" & i) = toval(rsSrc.fields("IPCT_" & i))
            Next i
            rs.fields("CPDays") = toval(rsSrc.fields("CPDays"))
            If Not rs.Update Then GoTo errmsg

            Dim rsSrcDet As RemoteSet
            rsSrcDet = db.OpenRemoteSet("Select * from SFSecurity Where SNO=" & SNO & " and FID='" & FID & "'")
            If Not rsSrcDet.Eof Then
