    Private Function PutAccRegAmount(ByVal REGID As String, ByVal FLDID As String, ByVal VALUEID As String, ByVal RYear As Integer, ByVal RType As String, ByVal Amount As Double, ByVal TSI As Double) As Long
        Dim rs As RemoteSet

        On Error GoTo errmsg
        rs = db.OpenQueryDef("QACCREGDET", adOpenKeyset, REGID, FLDID, VALUEID, RYear, RType)
        If rs.Eof Then
            rs.AddNew()
            rs.fields("REGID") = REGID
            rs.fields("FLDID") = FLDID
            rs.fields("VALUEID") = VALUEID
            rs.fields("RTYPE") = RType
            rs.fields("RYear") = RYear
            rs.fields("RegNo") = db.GetIdentity("ACCREGDET") + 1
        Else
            rs.Edit()
        End If
        rs.fields("AMOUNT") = toval(rs.fields("AMOUNT")) + Amount
        rs.fields("TSI") = toval(rs.fields("TSI")) + TSI
        rs.fields("NRisk") = toval(rs.fields("NRisk")) + 1
        If toval(rs.fields("NRisk")) > 1 Then
            rs.fields("ReAllocF") = True
        Else
            rs.fields("ReAllocF") = False
        End If
        If Not rs.Update Then GoTo errmsg
        PutAccRegAmount = toval(rs.fields("RegNo"))
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        PutAccRegAmount = -1
    End Function

    Private Function GetAccRegAmount(ByVal REGID As String, ByVal FLDID As String, ByVal VALUEID As String, ByVal RYear As Integer, ByVal RType As String, ByVal Amount As Double, ByVal TSI As Double) As Long
        Dim rs As RemoteSet
        On Error GoTo errmsg
        rs = db.OpenQueryDef("QACCREGDET", adOpenKeyset, REGID, FLDID, VALUEID, RYear, RType)
        If Not rs.Eof Then
            rs.Edit()
            rs.fields("AMOUNT") = toval(rs.fields("AMOUNT")) - Amount
            rs.fields("TSI") = toval(rs.fields("TSI")) - TSI
            rs.fields("NRisk") = toval(rs.fields("NRisk")) - 1
            If toval(rs.fields("NRisk")) > 0 Then
                rs.fields("ReAllocF") = True
            Else
                rs.fields("ReAllocF") = False
            End If
            If Not rs.Update Then GoTo errmsg
        End If
        GetAccRegAmount = -1
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        GetAccRegAmount = 0
    End Function

    Private Function PrevAccRegAmount(ByVal ANO As Long, ByVal RType As String) As Double
        Dim rs As RemoteSet
        ' Get Previous Accumulated Amount

        rs = db.OpenQueryDef("QACCREGAMOUNT_" & RType, adOpenForwardonly, ANO)
        PrevAccRegAmount = toval(rs.fields("Amount"))
        rs.CloseRemoteSet()
    End Function
    Private Function Get_Accumulation(ByVal RegID As String, ByVal FLDID As String, ByVal ValueID As String, ByVal RType As String, ByVal RYear As Integer) As Double
        Dim rs As RemoteSet

