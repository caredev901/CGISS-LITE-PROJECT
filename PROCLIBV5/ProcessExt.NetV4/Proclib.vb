                                Share = rsR.fields("Limit") * TLimit
                            Else
                                Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "S3", RYear) + PrevAccRegAmount(ANO, "S3")
                            End If

                            Share = IIf(Share < 0, 0, Share)

                            ' Policy Cession Limit Applicable
                            If PLimit <> 0 Then
                                If toval(rsR.fields("PLimit")) <> 0 Then
                                    If Share > PLimit * RCLimit * toval(rsR.fields("PLimit")) Then
                                        Share = PLimit * RCLimit * toval(rsR.fields("PLimit"))
                                    End If
                                End If
                            End If

                            If Not (Not ConjunctionF And ReLimitRTypeF And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF)) Then
                                PShare = toval(rsR.fields("PShare"))
                            End If

                            If IIf(PShare = 0, 100, PShare) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount")) < Share Then
                                Share = IIf(PShare = 0, 100, PShare) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount"))
                            End If

                            If Share > Saldo Then Share = Saldo

                            ' Check Number Of Line OR for ORSurplus
                            If ORLimit <> 0 And Not ReAllocF Then
                                If Share > (rs.fields("QAmount") + rs.fields("QSRamount")) * (rsR.fields("Limit") / ORLimit) Then
                                    Share = (rs.fields("QAmount") + rs.fields("QSRamount")) * (rsR.fields("Limit") / ORLimit)
                                End If
                            End If
                            If Share <> 0 Then
                                Treaty_Hold_Risk_Cession(rsR.fields("RID"), ANO, Holdf, Message)
                            End If
                        Else
                            rs.fields("SP3ID") = tostr(rsR.fields("RID"))
                            Share = rs.fields("SP3Amount")
                            If Share > Saldo Then Share = Saldo
                        End If
                        rs.fields("SP3SHARE") = Share / OurShare * 100
                        rs.fields("SP3AMOUNT") = Share
                        SPRAmount = SPRAmount + Share * (100 - toval(rsR.fields("RShare"))) / 100
                        Saldo = Saldo - Share
                    Else
                        rs.fields("SP3ID") = ""
                        rs.fields("SP3SHARE") = 0
                        rs.fields("SP3AMOUNT") = 0
                    End If
                Else
                    rs.fields("SP1ID") = ""
                    rs.fields("SP1SHARE") = 0
                    rs.fields("SP1AMOUNT") = 0
                    rs.fields("SP2ID") = ""
                    rs.fields("SP2SHARE") = 0
                    rs.fields("SP2AMOUNT") = 0
                    rs.fields("SP3ID") = ""
                    rs.fields("SP3SHARE") = 0
                    rs.fields("SP3AMOUNT") = 0
                End If

                ' Get the Auto Fac
                rsR = db.OpenQueryDef("QReinsurance_Cession", adOpenForwardonly, ANO, RDate, "A", TSI, tostr(rs.fields("AID")), 0, Gross)
                If Not rsR.Eof Then
                    AssessmentExInwardF = toval(rsR.fields("AssessmentExInwardF"))
                    If Not ManualF AndAlso MShare <> 100 Then
                        PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                        If (ISType <> "R" And ISType <> "T") Or Not toval(rsR.fields("DirectF")) Then
                            ' Direct Business
                            rs.fields("AID") = tostr(rsR.fields("RID"))

                            ' Risk Limit by Reinsurance Type
                            RCLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1)
                            TLimit = RCLimit
                            If Not ConjunctionF And ReLimitRTypeF And Saldo <> 0 Then
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    RRLimit = RiskAssLimit(ANO, "A", Holdf, Message, RShare, PLimit, PShare)
                                    TLimit = RCLimit * RRLimit
                                    If RRLimit > 0 AndAlso rs.fields("Limit") > RRLimit Then rs.fields("Limit") = RRLimit
                                End If
                            Else
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    RRLimit = RLimit
                                    TLimit = RCLimit * RRLimit
                                    If RRLimit > 0 AndAlso rs.fields("Limit") > RRLimit Then rs.fields("Limit") = RRLimit
                                End If
                            End If

                        Else
                            ' In-Direct Business
                            rs.fields("AID") = ""
                            RCLimit = 0
                            TLimit = 0
                        End If

                        If ProformaF OrElse NoRiskAccumulationF Then
                            Share = rsR.fields("Limit") * TLimit
                        Else
                            Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "A", RYear) + PrevAccRegAmount(ANO, "A")
                        End If

                        Share = IIf(Share < 0, 0, Share)

                        ' Policy Cession Limit Applicable
                        If PLimit <> 0 Then
                            If toval(rsR.fields("PLimit")) <> 0 Then
                                If Share > PLimit * RCLimit * toval(rsR.fields("PLimit")) Then
                                    Share = PLimit * RCLimit * toval(rsR.fields("PLimit"))
                                End If
                            End If
                        End If

                        If Not (Not ConjunctionF And ReLimitRTypeF And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF)) Then
                            PShare = toval(rsR.fields("PShare"))
                        End If

                        If IIf(PShare = 0, 100, PShare) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount")) < Share Then
                            Share = IIf(PShare = 0, 100, PShare) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount"))
                        End If

                        If Share > Saldo Then Share = Saldo

                        If Share <> 0 Then
                            Treaty_Hold_Risk_Cession(rsR.fields("RID"), ANO, Holdf, Message)
                        End If
                    Else
                        rs.fields("AID") = tostr(rsR.fields("RID"))
                        Share = rs.fields("AAMOUNT") + rs.fields("AFRAmount")
                        If Share > Saldo Then Share = Saldo
                    End If

                    If Not (Not ConjunctionF And ReLimitRTypeF And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF)) Then
                        RShare = toval(rsR.fields("Share"))
                    End If
                    rs.fields("ASHARE") = Share / OurShare * 100 * RShare / 100
                    rs.fields("AAMOUNT") = Share * RShare / 100
                    rs.fields("AFRet") = (100 - RShare)
                    rs.fields("AFRAmount") = Share * (100 - RShare) / 100
                    Saldo = Saldo - Share
                Else
                    rs.fields("AID") = ""
                    rs.fields("ASHARE") = 0
                    rs.fields("AAMOUNT") = 0
                    rs.fields("AFRet") = 0
                    rs.fields("AFRAmount") = 0
                End If

                ' Set the Retention
                rs.fields("RAmount") = Saldo - (FAmount - PreCedeFAmount) - toval(rs.fields("SAmount"))

                If -rs.fields("RAmount") <= rs.fields("SAmount") AndAlso rs.fields("RAmount") < 0 Then
                    rs.fields("SAmount") = rs.fields("SAmount") + rs.fields("RAmount")
                    rs.fields("RAmount") = 0
                End If

                If ShortFallF OrElse (ShortFallLimit <> 0 AndAlso rs.fields("SAmount") + rs.fields("RAmount") <= ShortFallLimit) Then
                    rs.fields("SAmount") = rs.fields("SAmount") + rs.fields("RAmount")
                    rs.fields("RAmount") = 0
                End If

                rs.fields("Retention") = rs.fields("RAmount") / OurShare * 100
                rs.fields("ShortFall") = rs.fields("SAmount") / OurShare * 100
                rs.fields("TAmount") = OurShare
                rs.fields("TShare") = 100
                rs.fields("PCTShare") = PctShare
                rs.fields("MShare") = MShare
                rs.fields("PCTLOSS") = PCTLOSS
                rs.fields("MAmount") = MAmount
                rs.fields("FShare") = FShare
                rs.fields("FAmount") = FAmount
                rs.fields("CLimit") = CLimit
                rs.fields("ManualF") = ManualF
                If CleanCutF Then
                    rs.fields("PDate") = R_PDate
                    rs.fields("PPDate") = R_PPDate
                Else
                    rs.fields("PDate") = rs.fields("RDate")
                    rs.fields("PPDate") = rs.fields("NRDate")
                End If
                rs.fields("QSSFShare") = QSSFAmount / OurShare * 100
                rs.fields("QSSFAmount") = QSSFAmount
                rs.fields("SPRShare") = SPRAmount / OurShare * 100
                rs.fields("SPRAmount") = SPRAmount

                If (toval(rs.fields("QAmount")) + toval(rs.fields("QSRAmount"))) = 0 AndAlso TOCORCessionF AndAlso Not db.GetPrivileges("ALLOWNOORCESSION") Then
                    Holdf = True
                    If Message <> "" Then Message = Message & vbCrLf
                    Message = Message & "Check Policy Risk Arrangement for " & GetTreatyDescription(tostr(rs.fields("QID"))) & ", No Amount Ceded. "
                End If

                If Holdf Then
                    rs.fields("HoldF") = Holdf
                    If rs.fields("Message") = "" Then
                        rs.fields("Message") = Message
                    Else
                        rs.fields("Message") = rs.fields("Message") & vbCrLf & Message
                    End If
                Else
                    rs.fields("HoldF") = False
                    rs.fields("Message") = ""
                End If

                If Not rs.Update Then Throw New Exception(db.ErrDesc)

                ' Adjust Facultative Amount
                If Not db.Execute("Update RArrDet Set Amount=RArrDet.Share/100*Case When RArrDet.Limit<>0 then RArrDet.Limit else RArrHeader.TAmount end from RArrDet, RArrHeader Where RArrHeader.ANO=" & ANO & " and RArrHeader.TAmount<>0 and RArrDet.ANO=RArrHeader.ANO and round(RArrDet.Amount,2)<>round(RArrDet.Share/100*Case When RArrDet.Limit<>0 then RArrDet.Limit else RArrHeader.TAmount end,2)") Then Throw New Exception(db.ErrDesc)
            End If

            ' Check if Renewed Policy already Closed
            If AType = "N" And RANO <> -1 Then
                rs = db.OpenRemoteSet("Select AStatus from Acceptance Where ANO=" & RANO)
                If rs.fields("AStatus") <> "C" Then
                    Reinsurance_Cession = True
                    Exit Function
                End If
            End If

            'Immediately Booked The Accumulation
            Return True

        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Sub GetFacCessionShare(ByVal ANO As Long, ByRef FShare As Double, ByRef PrecedeFShare As Double)
        Dim rs As RemoteSet
        rs = db.OpenQueryDef("QFacCessionShare", adOpenForwardonly, ANO)
        FShare = toval(rs.fields("FShare"))
        PrecedeFShare = toval(rs.fields("PrecedeFShare"))
    End Sub
    Private Function ReleaseAccRegAmount(ByVal ANO As Long, ByVal PreviousF As Boolean) As Boolean
        Dim rs As RemoteSet
        Dim Amount As Double
        Dim TAmount As Double
        Dim REGID As String
        Dim FLDID As String
        Dim VALUEID As String
        Dim AType As String
        Dim AStatus As String
        Dim pANO As Long
        Dim RegNo As Long
        Dim RYear As Integer

        On Error GoTo errmsg
        Dim NoRiskAccumulationF As Boolean

        rs = db.OpenQueryDef("QACCREG", adOpenForwardonly, ANO)
        REGID = tostr(rs.fields("REGID"))
        FLDID = tostr(rs.fields("FLDID"))
        VALUEID = tostr(rs.fields("ValueID"))
        AType = tostr(rs.fields("AType"))
        AStatus = tostr(rs.fields("AStatus"))
        pANO = toval(rs.fields("pANO"))
        RYear = toval(rs.fields("RYEAR"))

        NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
        rs.CloseRemoteSet()

        If (AStatus = "W" Or AStatus = "T") And pANO <> -1 And PreviousF Then
            If Not UnReleaseAccRegAmount(pANO, False) Then GoTo errmsg
        End If

        If Not NoRiskAccumulationF Then
            Dim PctShare As Double
            Dim MShare As Double
            Dim PCTLOSS As Double

            rs = db.OpenQueryDef("QRARRHEADER", adOpenKeyset, ANO)
            If tostr(rs.fields("Status")) = "R" And AType <> "C" And AType <> "A" Then
                PctShare = rs.fields("PCTShare")
                MShare = rs.fields("MShare")
                PCTLOSS = rs.fields("PCTLOSS")
                rs.Edit()
                If FLDID <> "" And VALUEID <> "" AndAlso MShare <> 100 Then
                    TAmount = toval(rs.fields("TAmount"))

                    ' Compulsory
                    Amount = toval(rs.fields("CAMOUNT") - toval(rs.fields("CCAMOUNT")))
                    If tostr(rs.fields("CID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "C", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("CRegNo") = RegNo
                    End If

                    ' Excess Priority/MaiPark
                    Amount = toval(rs.fields("XPAMOUNT")) - toval(rs.fields("CXPAMOUNT"))
                    If tostr(rs.fields("XPID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "XP", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("XPRegNo") = RegNo
                    End If

                    ' Decree
                    Amount = toval(rs.fields("DAMOUNT") - toval(rs.fields("CDAMOUNT")))
                    If tostr(rs.fields("DID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "D", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("DRegNo") = RegNo
                    End If

                    ' Quota Share
                    Amount = toval(rs.fields("QAMOUNT") + toval(rs.fields("QSRAMOUNT")) - toval(rs.fields("CQAMOUNT")))
                    If rs.fields("QID") <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "Q", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("QRegNo") = RegNo
                    End If

                    ' 1st Surplus
                    Amount = toval(rs.fields("SP1AMOUNT")) - toval(rs.fields("CSP1AMOUNT"))
                    If tostr(rs.fields("SP1ID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "S1", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("SP1RegNo") = RegNo
                    End If

                    ' 2nd Surplus
                    Amount = toval(rs.fields("SP2AMOUNT")) - toval(rs.fields("CSP2AMOUNT"))
                    If tostr(rs.fields("SP2ID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "S2", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("SP2RegNo") = RegNo
                    End If

                    ' 3rd Surplus
                    Amount = toval(rs.fields("SP3AMOUNT")) - toval(rs.fields("CSP3AMOUNT"))
                    If tostr(rs.fields("SP3ID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "S3", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("SP3RegNo") = RegNo
                    End If

                    ' Auto Facultative
                    Amount = toval(rs.fields("AAMOUNT") + toval(rs.fields("AFRAMOUNT")) - toval(rs.fields("CAAMOUNT")))
                    If tostr(rs.fields("AID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "A", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("ARegNo") = RegNo
                    End If
                End If

                rs.fields("Status") = "A"
                If Not rs.Update Then GoTo errmsg

                rs.CloseRemoteSet()

                ' Also Update Cover Limit
                'Set rs = db.OpenRemoteSet("select Cover.*, PCalc.Rate from Cover, Acceptance, PCALC where Cover.CNO=Acceptance.CNO and PCALC.ANO=Acceptance.ANO and Acceptance.ANO=" & ANO)
                'If Not rs.EOF Then
                '   TAmount = TAmount / toval(rs.fields("Rate"))
                'End If
            End If
        End If

        ReleaseAccRegAmount = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        ReleaseAccRegAmount = False
    End Function

