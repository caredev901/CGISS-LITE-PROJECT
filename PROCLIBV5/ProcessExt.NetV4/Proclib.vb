                        Dim j As Integer
                        rs = db.OpenQueryDef("QTOI", adOpenForwardonly, TOI)
                        rss = db.OpenRemoteSet("Select * from AINFO A Left join AINFO_Ext A_Ext on (A_Ext.ANO=A.ANO) Where A.ANO=" & ANO)
                        rsd = db.OpenRemoteSet("Select * from IInfo Where 1<>1")
                        rsd.AddNew()
                        rsd.fields("INO") = INO
                        For i = 1 To 15
                            rsd.fields("FLDID" & i) = ""
                            rsd.fields("VALUEID" & i) = ""
                            rsd.fields("VALUEDESC" & i) = ""
                            If rs.fields("FLDID" & i) <> "" Then
                                rsd.fields("FLDID" & i) = rs.fields("FLDID" & i)
                                For j = 1 To 15
                                    If rss.fields("FLDID" & j) <> "" Then
                                        If rs.fields("FLDID" & i) = rss.fields("FLDID" & j) Then
                                            rsd.fields("VALUEID" & i) = rss.fields("VALUEID" & j)
                                            rsd.fields("VALUEDESC" & i) = rss.fields("VALUEDESC" & j)
                                        End If
                                    Else
                                        Exit For
                                    End If
                                Next j

                            Else
                                Exit For
                            End If
                        Next i
                        If Not rsd.Update Then GoTo errmsg
                    End If
                End If

                If tostr(rs.fields("TOPRO")) <> "" Then
                    Dim tParam(10) As Object

                    tParam(0) = tostr(rs.fields("TOPRO"))
                    tParam(1) = tostr(rs.fields("TOC"))
                    tParam(2) = ANO
                    tParam(3) = tostr(rs.fields("Currency"))
                    tParam(4) = toval(rs.fields("TSI"))
                    tParam(5) = toval(rs.fields("ATSI"))
                    tParam(6) = True
                    tParam(7) = True
                    tParam(8) = True
                    tParam(9) = True
                    tParam(10) = toval(rs.fields("Premium"))
                    TOP_Process(tParam)
                End If

                'If Not Create_AccDA_from_Service(ANO, SNO) Then GoTo errmsg
                'If Not Create_AccCA_from_Service(ANO, SNO) Then GoTo errmsg
                'If Not Create_Payor_from_Service(ANO, SNO) Then GoTo errmsg
                'If Not Create_AccPic_from_Service(ANO, OSNO) Then GoTo errmsg
                'If Not Create_Uinfo_from_Service(CNO, SNO) Then GoTo errmsg
                'If Not Create_Facultative_from_Service(ANO, SNO) Then GoTo errmsg
                'If Not Create_Coinsurance_from_Service(CNO, SNO) Then GoTo errmsg

                ' Reset Service No.
                SNO = -1
            End If
        End If

        ' Any Change to Master Refno Also Change to Detail RefNo
        If SType = "M" And (PRefNo <> RefNo Or pBranch <> Branch Or PSDate <> SDate Or PEDate <> EDate Or pCT <> CT) Then
            If Not db.Execute("Update Acceptance Set AID=Case When Acceptance.AID='" & pAID & "' then '" & AID & "' Else Acceptance.AID End, RefNo='" & RefNo & "', Branch='" & Branch & "', CT='" & CT & "', PStatus=Case When (RArrHeader.RDate='" & Format(PSDate, "MM/DD/YYYY") & "' and RArrHeader.RDate<>'" & Format(RDATE, "MM/DD/YYYY") & "') or (RArrHeader.NRDate='" & Format(PEDate, "MM/DD/YYYY") & "' and RArrHeader.NRDate<>'" & Format(NRDATE, "MM/DD/YYYY") & "') or (Acceptance.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' and Acceptance.SDate<>'" & Format(SDate, "MM/DD/YYYY") & "') or (Acceptance.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' and Acceptance.EDate<>'" & Format(EDate, "MM/DD/YYYY") & "') Then 'I' Else Acceptance.PStatus end, NCDate=Case When Acceptance.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(SDate, "MM/DD/YYYY") & "' Else Acceptance.NCDate End, SDate=Case When Acceptance.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(SDate, "MM/DD/YYYY") & "' Else Acceptance.SDate End, EDate=Case When Acceptance.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' Then '" & Format(EDate, "MM/DD/YYYY") & "' Else Acceptance.EDate End, PDate=Case When Acceptance.PDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(SDate, "MM/DD/YYYY") & "' Else Acceptance.PDate End, PPDate=Case When Acceptance.PPDate='" & Format(PEDate, "MM/DD/YYYY") & "' Then '" & Format(EDate, "MM/DD/YYYY") & "' Else Acceptance.PPDate End from Acceptance Inner Join RArrHeader on (RArrHeader.ANO=Acceptance.ANO) Where Acceptance.AStatus='W' and Acceptance.AType<>'C' and Acceptance.LANO<>Acceptance.ANO and Acceptance.LANO=" & ANO) Then GoTo errmsg
            If PSDate <> SDate Or PEDate <> EDate Then
                If Not db.Execute("Update RArrHeader Set NCDate=Case When RArrHeader.NCDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(RDATE, "MM/DD/YYYY") & "' Else RArrHeader.NCDate End, RDate=Case When RArrHeader.RDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(RDATE, "MM/DD/YYYY") & "' Else RArrHeader.RDate End, NRDate=Case When RArrHeader.NRDate='" & Format(PEDate, "MM/DD/YYYY") & "' Then '" & Format(NRDATE, "MM/DD/YYYY") & "' Else RArrHeader.NRDate End from RArrHeader, Acceptance Where Acceptance.ANO=RArrHeader.ANO and Acceptance.pStatus='I' and Acceptance.AStatus='W' and Acceptance.AType<>'C' and Acceptance.LANO<>Acceptance.ANO and Acceptance.LANO=" & ANO) Then GoTo errmsg
                rs = db.OpenRemoteSet("Select ANO from Acceptance Where Acceptance.pStatus='I' and Acceptance.SDate='" & Format(SDate, "MM/DD/YYYY") & "' and Acceptance.EDate='" & Format(EDate, "MM/DD/YYYY") & "' and Acceptance.AStatus='W' and Acceptance.AType<>'C' and Acceptance.LANO<>Acceptance.ANO and Acceptance.LANO=" & ANO)
                Do While Not rs.Eof
                    If Not Adjust_RCover(rs.fields("ANO"), PSDate, PEDate, SDate, EDate, Voyage, PTerm, TOC) Then GoTo errmsg
                    If Not Adjust_ICover(rs.fields("ANO"), SDate, EDate) Then GoTo errmsg
                    If Not Adjust_Deductible(rs.fields("ANO"), SDate, EDate) Then GoTo errmsg
                    If AdjustFacultativePeriodF Then
                        If Not db.Execute("Update RArrDet Set SDate='" & Format(SDate, "MM/DD/YYYY") & "', EDate='" & Format(EDate, "MM/DD/YYYY") & "' Where RArrDet.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' and RArrDet.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' and RArrDet.ANO=" & rs.fields("ANO")) Then GoTo errmsg
                    Else
                        If Not db.Execute("Update RArrDet Set SDate='" & Format(SDate, "MM/DD/YYYY") & "', EDate='" & Format(EDate, "MM/DD/YYYY") & "' Where RArrDet.RType not in ('F','QS','QP','S1','S2','S3','AF') and RArrDet.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' and RArrDet.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' and RArrDet.ANO=" & rs.fields("ANO")) Then GoTo errmsg
                    End If
                    rs.MoveNext()
                Loop
            End If
        End If

        Save_Policy_Data = ANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Policy_Data = 0
    End Function
    Private Function Save_Certificate_Data(ByVal Param As Object, ByVal findex() As String, ByVal fbuffer() As String) As String
        Dim CertNum As Long
        Dim rs As RemoteSet
        Dim EditMode As Integer
        Dim Branch As String
        Dim CT As String
        Dim PSDate As Date
        Dim PEDate As Date
        Dim SDate As Date
        Dim EDate As Date
        Dim PDate As Date
        Dim AType As String
        Dim ASource As String
        Dim MO As String
        Dim AName As String
        Dim RefDate As Date
        Dim RefNo As String
        Dim AID As String
        Dim PolicyNo As String
        Dim CertificateNo As String
        Dim MSCode As String
        Dim M_RegNo As String
        Dim LOLBased As String
        Dim TOC As String
        Dim OldCANO As Long = -1

        On Error GoTo errmsg

        ' InParam Variable
        Dim CNO As Long = Param(0)
        Dim ANO As Long = Param(1)
        Dim CANO As Long = Param(2)
        Dim LANO As Long = Param(3)
        Dim RenewableF As Boolean = Param(4)
        Dim Voyage As Boolean = Param(5)
        Dim OpenFlag As Boolean = Param(6)
        Dim M_SDate As Date = Param(7)
        Dim M_EDate As Date = Param(8)
        Dim M_PDate As Date = Param(9)
        Dim OverWriteCAF As Boolean = Param(10)
        Dim RegID As String = Param(11)
        Dim FLDID As String = Param(12)
        Dim ValueID As String = Param(13)
        Dim ValueDesc As String = Param(14)
        Dim NotApplyMasterFacultativeF As Boolean = toval(getInParamValue(Param, 15))
        Dim TANO As Long = toval(getInParamValue(Param, 16))
        Dim AdjustFacultativePeriodF As Boolean = toval(getInParamValue(Param, 17))
        Dim KeepExistingF As Boolean = toval(getInParamValue(Param, 18))
        Dim NotApplyMasterDataF As Boolean = toval(getInParamValue(Param, 19))
        Dim NotStandAloneProcessF As Boolean = toval(getInParamValue(Param, 20))
        Dim NotApplyConjunctPolicyDataF As Boolean = toval(getInParamValue(Param, 21))

        ' Trim Space and CRLF
        If ValueID = ValueDesc Then
            ValueID = Trim(Replace(ValueID, vbCrLf, ""))
            ValueDesc = Trim(Replace(ValueDesc, vbCrLf, ""))
        Else
            ValueID = Trim(Replace(ValueID, vbCrLf, ""))
        End If

        Branch = GetFieldValue(fbuffer(GetFieldIndex("Branch", findex)))
        CT = GetFieldValue(fbuffer(GetFieldIndex("CT", findex)))
        SDate = GetFieldValue(fbuffer(GetFieldIndex("SDate", findex)))
        EDate = GetFieldValue(fbuffer(GetFieldIndex("EDate", findex)))
        PDate = GetFieldValue(fbuffer(GetFieldIndex("PDate", findex)))
        AType = GetFieldValue(fbuffer(GetFieldIndex("AType", findex)))
        MO = GetFieldValue(fbuffer(GetFieldIndex("MO", findex)))
        AName = GetFieldValue(fbuffer(GetFieldIndex("AName", findex)))
        RefDate = GetFieldValue(fbuffer(GetFieldIndex("RefDate", findex)))
        RefNo = GetFieldValue(fbuffer(GetFieldIndex("RefNo", findex)))
        AID = GetFieldValue(fbuffer(GetFieldIndex("AID", findex)))
        PolicyNo = GetFieldValue(fbuffer(GetFieldIndex("PolicyNo", findex)))
        CertificateNo = GetFieldValue(fbuffer(GetFieldIndex("CertificateNo", findex)))
        TOC = GetFieldValue(fbuffer(GetFieldIndex("TOC", findex)))

        Dim Segment As String
        Dim CoverNo As String
        Dim PolicyType As String
        Dim ISType As String
        rs = db.OpenRemoteSet("Select ASource, Segment, CoverNo, PolicyType, ISType from Cover Where CNO=" & CNO)
        ASource = rs.fields("ASource")
        Segment = rs.fields("Segment")
        CoverNo = rs.fields("CoverNo")
        PolicyType = rs.fields("PolicyType")
        ISType = rs.fields("ISType")

        Dim PTerm As Integer
        Dim NoRiskAccumulationF As Boolean
        Dim AnnualTreatyF As Boolean
        Dim STime As String
        Dim ETime As String
        Dim M_PSDate As Date
        Dim M_PEDate As Date

        rs = db.OpenRemoteSet("Select PTerm, DefSTime, DefETime, NoRiskAccumulationF, AnnualTreatyF from TOC Where TOC='" & TOC & "'")
        PTerm = rs.fields("PTerm")
        STime = rs.fields("DefSTime")
        ETime = rs.fields("DefETime")
        If PTerm = 0 Then PTerm = 12
        NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
        AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))

        'Commented as Performance Issue (see also below db.ReleaseLockedObject)
        'If Not db.GetLockedObject("Policy" & LANO) Then
        '    StrMsg = db.ErrDesc
        '    GoTo errmsg
        'End If

        rs = db.OpenRemoteSet("Select Top 1 A1.RegNo as M_RegNo, A1.MSCode, R.LOLBased, pA1.SDate as M_PSDate, pA1.EDate as M_PEDate from Acceptance A1 Left Join Acceptance pA1 on (pA1.ANO=A1.pANO) Left Join Acceptance A2 on (A2.LANO=A1.ANO and A2.ANO<>A2.LANO and A2.AStatus in ('W','T','I')) Left Join RArrHeader R on (R.ANO=A2.ANO) Where A1.ANO=" & LANO)
        If rs.Eof Then
            StrMsg = "Master Policy can not be found !"
            GoTo errmsg
        End If
        MSCode = tostr(rs.fields("MSCode"))
        LOLBased = toval(rs.fields("LOLBased"))
        M_PSDate = todate(rs.fields("M_PSDate"))
        M_PEDate = todate(rs.fields("M_PEDate"))
        ' RegNo Certificate Follows Master
        M_RegNo = tostr(rs.fields("M_RegNo"))

        rs = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
        If rs.Eof Then
            EditMode = AdEditAdd
            If CertificateNo = "" Then
                'Set Auto Numbering Here
                CertNum = GetCertificateNo(CNO, , Not NotStandAloneProcessF)
                If CertNum = 0 Then
                    StrMsg = "Can't Get Certificate No ! " & StrMsg
                    GoTo errmsg
                End If
                ' Certificate Number
                CertificateNo = GetCertificateNumber(CertNum)
            Else
                ' Adjust Certificate Numbering
                CertNum = toval(CertificateNo)
                If CertNum > 0 Then
                    CertNum = GetCertificateNo(CNO, CertNum, Not NotStandAloneProcessF)
                    If CertNum = 0 Then
                        StrMsg = "Can't Get Certificate No ! " & StrMsg
                        GoTo errmsg
                    End If
                    ' Certificate Number
                    CertificateNo = GetCertificateNumber(CertNum)
                End If
            End If

            'Create Acceptance
            If RefNo = "" Then
                If CBool(toval(GetAppSetting("GenerateRefNoF"))) Then
                    RefNo = GetDocumentNumbering("REF", PolicyType, ISType, Today.Date, Branch, TOC, CT)
                    If RefNo = "" Then
                        StrMsg = "Generate Reference No. Failed !"
                        GoTo errmsg
                    End If
                End If
            End If

            rs = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
            rs.AddNew()
            rs.fields("PolicyNo") = PolicyNo
            rs.fields("CertificateNo") = CertificateNo
            rs.fields("CNO") = CNO
            rs.fields("AType") = "N"    ' New Policy
            rs.fields("AStatus") = "W"  ' Waiting
            rs.fields("RANO") = -1      ' Renewal Acceptance
            rs.fields("pANO") = -1     ' Previous ANO
            rs.fields("LANO") = LANO ' Master Link ANO
            rs.fields("UserID") = db_user
            rs.fields("CDate") = Today.Date
            rs.fields("CTime") = Time()
            ANO = db.GetIdentity("Acceptance") + 1
            rs.fields("ANO") = ANO
            rs.fields("OANO") = ANO
            rs.fields("Source") = AID
            rs.fields("SDate") = SDate
            rs.fields("EDate") = EDate
        Else
            EditMode = AdEditInProgress
            rs = db.OpenRemoteSet("Select Status from RArrHeader Where ANO=" & ANO)
            If tostr(rs.fields("Status")) = "A" Then
                If Not UnReleaseAccRegAmount(ANO, True) Then GoTo errmsg
            End If

            'Create Acceptance
            rs = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
            rs.Edit()
        End If
        If rs.fields("AStatus") <> "W" Then
            StrMsg = "Certificate Already Processed !"
            GoTo errmsg
        End If
        PSDate = todate(rs.fields("SDate"))
        PEDate = todate(rs.fields("EDate"))
        rs.fields("AID") = AID
        rs.fields("AName") = AName
        rs.fields("Branch") = Branch
        rs.fields("CT") = CT
        rs.fields("TOC") = TOC
        rs.fields("ASource") = GetFieldValue(fbuffer(GetFieldIndex("ASource", findex)))
        rs.fields("Location") = GetFieldValue(fbuffer(GetFieldIndex("Location", findex)))
        rs.fields("Remarks") = GetFieldValue(fbuffer(GetFieldIndex("Remarks", findex)))
        rs.fields("RegNo") = M_RegNo
        rs.fields("SDate") = SDate
        rs.fields("EDate") = EDate
        rs.fields("STime") = GetFieldValue(fbuffer(GetFieldIndex("STime", findex)))
        rs.fields("ETime") = GetFieldValue(fbuffer(GetFieldIndex("ETime", findex)))
        rs.fields("ADate") = GetFieldValue(fbuffer(GetFieldIndex("ADate", findex)))
        rs.fields("PDate") = PDate
        rs.fields("CPolicyNo") = GetFieldValue(fbuffer(GetFieldIndex("CPolicyNo", findex)))
        rs.fields("ConjunctionF") = GetFieldValue(fbuffer(GetFieldIndex("ConjunctionF", findex)))
        rs.fields("ExclusiveF") = GetFieldValue(fbuffer(GetFieldIndex("ExclusiveF", findex)))
        rs.fields("ExtPeriod") = GetFieldValue(fbuffer(GetFieldIndex("ExtPeriod", findex)))
        rs.fields("EXTPERIODINDAYSF") = GetFieldValue(fbuffer(GetFieldIndex("EXTPERIODINDAYSF", findex)))
        rs.fields("TOPRO") = GetFieldValue(fbuffer(GetFieldIndex("TOPRO", findex)))
        rs.fields("BankersID") = GetFieldValue(fbuffer(GetFieldIndex("BankersID", findex)))
        rs.fields("BankersClause") = GetFieldValue(fbuffer(GetFieldIndex("BankersClause", findex)))
        rs.fields("RefNo") = IIf(RefNo <> "", RefNo, rs.fields("RefNo"))
        rs.fields("RefDate") = RefDate
        rs.fields("Discount") = GetFieldValue(fbuffer(GetFieldIndex("Discount", findex)))
        rs.fields("Qty") = GetFieldValue(fbuffer(GetFieldIndex("Qty", findex)))
        rs.fields("Ujroh") = GetFieldValue(fbuffer(GetFieldIndex("Ujroh", findex)))
        rs.fields("WeightedAvgUjrohF") = GetFieldValue(fbuffer(GetFieldIndex("WeightedAvgUjrohF", findex)))
        rs.fields("BatchNo") = GetFieldValue(fbuffer(GetFieldIndex("BatchNo", findex)))
        rs.fields("BID") = GetFieldValue(fbuffer(GetFieldIndex("BID", findex)))
        rs.fields("BANO") = -1
        OldCANO = toval(rs.fields("CANO"))
        rs.fields("CANO") = CANO
        rs.fields("LUserID") = db_user
        rs.fields("LDate") = Today.Date
        rs.fields("LTime") = Time()
        rs.fields("PStatus") = "I"
        rs.fields("RenewableF") = RenewableF
        If EditMode = AdEditAdd Then
            rs.fields("NoRiskAccumulationF") = NoRiskAccumulationF
            rs.fields("AnnualTreatyF") = AnnualTreatyF
        End If
        rs.fields("PWordingID") = GetFieldValue(fbuffer(GetFieldIndex("PWordingID", findex)))
        rs.fields("BizmapID") = GetFieldValue(fbuffer(GetFieldIndex("BizmapID", findex)))
        rs.fields("MSCode") = GetFieldValue(fbuffer(GetFieldIndex("MSCode", findex)))
        ' Get Default from Master Policy
        If rs.fields("MSCode") = "" Then rs.fields("MSCode") = MSCode

        If AType = "N" Then
            rs.fields("RegDate") = Today.Date
        End If
        rs.fields("PolicyDate") = SDate
        rs.fields("PPDate") = EDate

        If EditMode = AdEditAdd Then
            If IsDate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex)))) AndAlso DateDiff(DateInterval.Day, SDate, todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))) >= 0 Then
                rs.fields("NCDate") = todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))
            Else
                rs.fields("NCDate") = SDate
            End If
        Else
            If DateDiff(DateInterval.Day, todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex)))), rs.fields("NCDate")) <> 0 Then
                If DateDiff(DateInterval.Day, SDate, todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))) >= 0 Then
                    rs.fields("NCDate") = todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))
                Else
                    rs.fields("NCDate") = SDate
                End If
            Else
                If DateDiff(DateInterval.Day, PSDate, rs.fields("NCDate")) = 0 OrElse DateDiff(DateInterval.Day, SDate, todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))) < 0 Then
                    rs.fields("NCDate") = SDate
                End If
            End If
        End If

        If rs.fields("STime") = "" Then rs.fields("STime") = STime
        If rs.fields("ETime") = "" Then rs.fields("ETime") = ETime

        If rs.fields("STime") = "" Then
            If rs.fields("ExclusiveF") Then
                rs.fields("STime") = "00:00"
            Else
                rs.fields("STime") = "12:00"
            End If
        End If
        If rs.fields("ETime") = "" Then
            If rs.fields("ExclusiveF") Then
                rs.fields("ETime") = "24:00"
            Else
                rs.fields("ETime") = "12:00"
            End If
        End If

        ' Update the Accumulation Register
        rs.fields("RegID") = RegID
        rs.fields("FLDID") = FLDID
        rs.fields("ValueID") = ValueID
        rs.fields("ValueDesc") = ValueDesc

        If Not rs.Update Then GoTo errmsg

        'If Not db.ReleaseLockedObject("Policy" & LANO) Then
        '    StrMsg = db.ErrDesc
        '    GoTo errmsg
        'End If

        Dim RDATE As Date
        Dim NRDATE As Date

        Dim PolicyTreatyF As Boolean
        ' Add for Default Risk Arrangement
        rs = db.OpenRemoteSet("Select * from RArrHeader Where ANO=" & ANO)
        If Not rs.Eof Then
            rs.Edit()
        Else
            rs.AddNew()
            rs.fields("LOLBased") = LOLBased
            rs.fields("ANO") = ANO
            rs.fields("LDate") = Today.Date
            rs.fields("LUserID") = db_user
        End If
        PolicyTreatyF = toval(rs.fields("PolicyTreatyF"))

        If rs.editmode = AdEditAdd Then
            If AnnualTreatyF Then
                If OpenFlag And Not PolicyTreatyF Then
                    RDATE = SDate
                    NRDATE = EDate
                Else
                    RDATE = M_SDate
                    NRDATE = M_EDate
                End If
            Else
                If OpenFlag And Not PolicyTreatyF Then
                    RDATE = SDate
                    NRDATE = EDate
                Else
                    RDATE = M_SDate
                    NRDATE = IIf(M_EDate <= EDate, EDate, M_EDate)
                End If
            End If
        Else
            RDATE = rs.fields("RDATE")
            NRDATE = rs.fields("NRDATE")
        End If
        If AnnualTreatyF Then
            If OpenFlag And Not PolicyTreatyF Then
                ' Check for Leap Year
                If Month(DateSerial(Year(PDate), Month(SDate), Day(SDate))) <> Month(SDate) Then
                    RDATE = DateAdd(DateInterval.Day, -1, DateSerial(Year(PDate), Month(SDate), Day(SDate)))
                Else
                    RDATE = DateSerial(Year(PDate), Month(SDate), Day(SDate))
                End If
                If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)
                If DateDiff(DateInterval.Day, PDate, RDATE) < 0 Then RDATE = DateAdd(DateInterval.Month, 12, RDATE)
                If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)

                If DateDiff(DateInterval.Day, SDate, RDATE) < 0 Then RDATE = SDate
                NRDATE = DateAdd(DateInterval.Month, 12, RDATE)
                If DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
            Else
                ' Check for Leap Year
                If Month(DateSerial(Year(PDate), Month(M_SDate), Day(M_SDate))) <> Month(M_SDate) Then
                    RDATE = DateAdd(DateInterval.Day, -1, DateSerial(Year(PDate), Month(M_SDate), Day(M_SDate)))
                Else
                    RDATE = DateSerial(Year(PDate), Month(M_SDate), Day(M_SDate))
                End If
                If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)
                If DateDiff(DateInterval.Day, PDate, RDATE) < 0 Then RDATE = DateAdd(DateInterval.Month, 12, RDATE)
                If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)

                If DateDiff(DateInterval.Day, M_SDate, RDATE) < 0 Then RDATE = M_SDate
                NRDATE = DateAdd(DateInterval.Month, 12, RDATE)
                If DateDiff(DateInterval.Day, M_EDate, NRDATE) > 0 Then NRDATE = M_EDate
            End If
        Else
            If OpenFlag And Not PolicyTreatyF Then
                If AType = "N" OrElse DateDiff(DateInterval.Day, PSDate, RDATE) = 0 OrElse DateDiff(DateInterval.Day, SDate, RDATE) < 0 Then RDATE = SDate
                If DateDiff(DateInterval.Day, EDate, RDATE) > 0 Then RDATE = EDate

                If DateDiff(DateInterval.Day, SDate, NRDATE) < 0 Then NRDATE = SDate
                If DateDiff(DateInterval.Day, PEDate, NRDATE) = 0 OrElse DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
                If DateDiff(DateInterval.Day, RDATE, NRDATE) <= 0 Then
                    RDATE = SDate
                    NRDATE = EDate
                End If
            Else
                If AType = "N" OrElse DateDiff(DateInterval.Day, M_PSDate, RDATE) = 0 OrElse DateDiff(DateInterval.Day, M_SDate, RDATE) < 0 Then RDATE = M_SDate
                If DateDiff(DateInterval.Day, M_EDate, RDATE) > 0 Then RDATE = M_EDate

                If DateDiff(DateInterval.Day, SDate, NRDATE) < 0 Then NRDATE = SDate
                If DateDiff(DateInterval.Day, PEDate, NRDATE) = 0 OrElse DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
                If DateDiff(DateInterval.Day, RDATE, NRDATE) <= 0 Then
                    RDATE = SDate
                    NRDATE = EDate
                End If
            End If
        End If

        If AType = "N" Then
            rs.fields("PDate") = RDATE
            rs.fields("PPDate") = NRDATE
        Else
            ' Clean Cut
            If Not (DateDiff(DateInterval.Day, rs.fields("PDate"), rs.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rs.fields("PPDate"), rs.fields("NRDate")) = 0) Then
                If OpenFlag And Not PolicyTreatyF Then
                    If DateDiff(DateInterval.Day, rs.fields("PPDate"), PDate) >= 0 Then
                        RDATE = rs.fields("PPDate")
                    End If
                Else
                    If DateDiff(DateInterval.Day, rs.fields("PPDate"), M_PDate) >= 0 Then
                        RDATE = rs.fields("PPDate")
                    End If
                End If

                If DateDiff(DateInterval.Day, RDATE, rs.fields("PDate")) >= 0 Then
                    RDATE = rs.fields("PDate")
                End If
            Else
                rs.fields("PDate") = RDATE
                rs.fields("PPDate") = NRDATE
            End If
        End If

        rs.fields("NCDate") = RDATE
        rs.fields("RDate") = RDATE
        rs.fields("NRDate") = NRDATE

        rs.fields("Status") = "R"
        rs.fields("TreatyF") = True
        rs.fields("HoldF") = False
        rs.fields("Message") = ""
        If Not rs.Update Then GoTo errmsg
        rs.CloseRemoteSet()

        If Not Save_Object_Info(ANO, findex, fbuffer, SDate, TOC, Segment) Then GoTo errmsg

        If EditMode = AdEditAdd Then
            If TANO > 0 Then
                ' Copy from Template Policy
                If Not CopyAccDetail("RCover", TANO, ANO) Then GoTo errmsg
                If Not CopyInterest(TANO, ANO, , True) Then GoTo errmsg
                'If Not CopyAccDetail("ICoverPOL", TANO, ANO) Then GoTo errmsg
                If Not CopyAccDetail("AccDed", TANO, ANO) Then GoTo errmsg
                'If Not CopyAccDetail("AINFO_EXT", TANO, ANO) Then GoTo errmsg
             
                If Not Copy_Facultative_Master(TANO, ANO) Then GoTo errmsg
            Else
                If CANO <> -1 AndAlso Not NotApplyConjunctPolicyDataF Then
                    Dim Conj_COB As String
                    Dim COB As String
                    rs = db.OpenRemoteSet("Select T1.COB as Conj_COB, T2.COB as COB from Acceptance A, TOC T1, TOC T2 Where T1.TOC=A.TOC and A.ANO=" & CANO & " and T2.TOC='" & TOC & "'")
                    Conj_COB = tostr(rs.fields("Conj_COB"))
                    COB = tostr(rs.fields("COB"))

                    If Not CopyAccDetail("RCover", LANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccDed", LANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AAccBS", CANO, ANO) Then GoTo errmsg

                 
                Else
                    If Not NotApplyMasterDataF Then
                        If Not CopyAccDetail("RCover", LANO, ANO) Then GoTo errmsg
                        If Not CopyInterest(LANO, ANO, , True) Then GoTo errmsg
                        If Not CopyAccDetail("AccDed", LANO, ANO) Then GoTo errmsg

                        If Not CopyAccDetail("AACCBS", LANO, ANO, "(Select Distinct ACCBS.* from AccBS, (Select ANO, ID, BSTYPE, CODE, 0 as PERIOD, FEE, FEEAMOUNT, DISCOUNT, INCEPTIONF from ACCBSDET Where ANO=" & LANO & " and InceptionF=1 and Period=cast(datediff(Month,'" & Format(M_SDate, "MM/DD/YYYY") & "', '" & Format(SDate, "MM/DD/YYYY") & "') as integer) / 12 + 1) ACCBSDET Where ACCBS.ANO=" & LANO & " and ACCBS.ANO=ACCBSDET.ANO and ACCBS.ID=ACCBSDET.ID and ACCBS.BSTYPE=ACCBSDET.BSTYPE)") Then GoTo errmsg
                        
                    End If
                End If
                If Not NotApplyMasterDataF Then

                    If OpenFlag AndAlso Not CopyAccDetail("AccFD", LANO, ANO, "(Select A.* from AccFD A, FDTAB F Where F.FDID=A.FDID AND LEFT(F.FDTYPE,1)='O' AND A.AMOUNT=0 AND A.ANO=" & LANO & ")") Then GoTo errmsg

                    ' Copy Default Facultative
                    If AType = "N" AndAlso Not NotApplyMasterFacultativeF Then
                        rs = db.OpenRemoteSet("Select top 1 ANO from RArrDet Where ANO=" & ANO)
                        If rs.Eof Then Copy_Facultative_Master(LANO, ANO)
                    End If
                End If

              
            End If
        Else
           
        End If

        If EditMode = AdEditAdd Or PSDate <> SDate Or PEDate <> EDate Or TANO > 0 Then
            If Not Adjust_RCover(ANO, PSDate, PEDate, SDate, EDate, Voyage, PTerm, TOC) Then GoTo errmsg
            If Not Adjust_ICover(ANO, SDate, EDate) Then GoTo errmsg
            If Not Adjust_Deductible(ANO, SDate, EDate) Then GoTo errmsg

        End If


        If EditMode = AdEditAdd AndAlso Voyage Then
            ' Set Default Vessel Name in Risk Cover
            Dim Vessel As String = ""
            Dim AValueID As Object
            Dim AValueDesc As Object
            AValueID = Convert_FLDID_Into_Array(ValueID)
            AValueDesc = Convert_FLDID_Into_Array(ValueDesc)

            For i = 0 To UBound(AValueID)
                If AValueID(i) <> AValueDesc(i) Then
                    Vessel = AValueDesc(i)
                    Exit For
                End If
            Next
            If Vessel = "" Then Vessel = "-"
            If Vessel <> "" Then
                If Not db.Execute("Update RCover Set Vessel='" & Vessel & "' Where ANO=" & ANO) Then GoTo errmsg
            End If
        End If

        If OpenFlag Then
            If Not Create_AccCA(ANO, AID, OverWriteCAF) Then GoTo errmsg
        End If

        Save_Certificate_Data = ANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Certificate_Data = 0
    End Function
    Private Function Save_Quotation_Data(ByVal Param As Object, ByVal findex() As String, ByVal fbuffer() As String) As String
        Dim rs As RemoteSet
        Dim rss As RemoteSet
        Dim rsd As RemoteSet
        Dim i As Integer
        Dim PSDate As Date
        Dim PEDate As Date
        Dim SDate As Date
        Dim EDate As Date
        Dim PDate As Date
        Dim PHolder As String
        Dim PayorID As String
        Dim PPHolder As String
        Dim PRefNo As String
        Dim RefNo As String
        Dim pBranch As String
        Dim Branch As String
        Dim CT As String
        Dim pCT As String
        Dim pAID As String
        Dim OldCANO As Long = -1

        On Error GoTo errmsg

        ' InParam Variable
        Dim CNO As Long = Param(0)
        Dim ANO As Long = Param(1)
        Dim CANO As Long = Param(2)
        Dim LANO As Long = Param(3)
        Dim SNO As Long = Param(4)
        Dim PolicyType As String = Param(5)
        Dim TOC As String = Param(6)
        Dim Voyage As Boolean = Param(7)
        Dim ISType As String = Param(8)
        Dim ReinstatementF As Boolean = Param(9)
        Dim SType As String = Param(10)
        Dim ProformaF As Boolean = Param(11)
        Dim Basis As Integer = Param(12)
        Dim RenewableF As Boolean = Param(13)
        Dim WPC As Integer = Param(14)
        Dim OverWritePayorF As Boolean = Param(15)
        Dim OverWriteDAF As Boolean = Param(16)
        Dim OverWriteCAF As Boolean = Param(17)
        Dim RegID As String = Param(18)
        Dim FLDID As String = Param(19)
        Dim ValueID As String = Param(20)
        Dim ValueDesc As String = Param(21)
        Dim TANO As Long = toval(getInParamValue(Param, 22))
        Dim AdjustFacultativePeriodF As Boolean = toval(getInParamValue(Param, 23))
        Dim Grace As Integer = toval(getInParamValue(Param, 24))
        Dim KeepExistingF As Boolean = toval(getInParamValue(Param, 25))
        Dim NotApplyConjunctPolicyDataF As Boolean = toval(getInParamValue(Param, 26))

        Dim CoverNo As String = ""
        Dim AType As String
        Dim ASource As String
        Dim MO As String
        Dim AID As String
        Dim AName As String
        Dim RefDate As Date
        Dim RegNo As String
        Dim EditMode As Integer
        Dim Prorata As Integer
        Dim Segment As String

        ' Trim Space and CRLF
        If ValueID = ValueDesc Then
            ValueID = Trim(Replace(ValueID, vbCrLf, ""))
            ValueDesc = Trim(Replace(ValueDesc, vbCrLf, ""))
        Else
            ValueID = Trim(Replace(ValueID, vbCrLf, ""))
        End If

        Branch = GetFieldValue(fbuffer(GetFieldIndex("Branch", findex)))
        CT = GetFieldValue(fbuffer(GetFieldIndex("CT", findex)))
        SDate = GetFieldValue(fbuffer(GetFieldIndex("SDate", findex)))
        EDate = GetFieldValue(fbuffer(GetFieldIndex("EDate", findex)))
        AID = GetFieldValue(fbuffer(GetFieldIndex("AID", findex)))
        MO = GetFieldValue(fbuffer(GetFieldIndex("MO", findex)))
        AName = GetFieldValue(fbuffer(GetFieldIndex("AName", findex)))
        RefDate = GetFieldValue(fbuffer(GetFieldIndex("RefDate", findex)))
        RefNo = GetFieldValue(fbuffer(GetFieldIndex("RefNo", findex)))
        PHolder = GetFieldValue(fbuffer(GetFieldIndex("PHolder", findex)))
        PayorID = GetFieldValue(fbuffer(GetFieldIndex("PayorID", findex)))
        If PayorID = "" Then PayorID = PHolder
        Prorata = GetFieldValue(fbuffer(GetFieldIndex("Prorata", findex)))
        Segment = GetFieldValue(fbuffer(GetFieldIndex("Segment", findex)))
        RegNo = GetFieldValue(fbuffer(GetFieldIndex("RegNo", findex)))

        AType = "N"

        Dim PTerm As Integer
        Dim NoRiskAccumulationF As Boolean
        Dim AnnualTreatyF As Boolean
        Dim STime As String
        Dim ETime As String
        rs = db.OpenRemoteSet("Select PTerm, DefSTime, DefETime, NoRiskAccumulationF, AnnualTreatyF from TOC Where TOC='" & TOC & "'")
        PTerm = rs.fields("PTerm")
        STime = rs.fields("DefSTime")
        ETime = rs.fields("DefETime")
        If PTerm = 0 Then PTerm = 12
        NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
        AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))

        'Creating Cover
        rs = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        If rs.Eof Then
            'Set Auto Numbering Here
            CoverNo = GetDocumentNumbering("COV", PolicyType, ISType, SDate, Branch, TOC, CT)
            If CoverNo = "" Then
                StrMsg = "Generate Cover No./Quotation No. Failed !"
                GoTo errmsg
            End If

            rs = db.OpenRemoteSet("Select * from Cover Where 1<>1")
            rs.AddNew()
            rs.fields("CoverNo") = CoverNo
            rs.fields("Voyage") = Voyage
            rs.fields("ISType") = ISType
            rs.fields("TOC") = TOC
            rs.fields("PolicyType") = PolicyType
            rs.fields("ReinstatementF") = toval(ReinstatementF)
            If SType = "O" Then
                rs.fields("OpenFlag") = 1
            Else
                rs.fields("OpenFlag") = 0
            End If

            rs.fields("CStatus") = "R"  ' Request Status
            rs.fields("UserID") = db_user
            rs.fields("CDate") = Today.Date
            rs.fields("CTime") = Time()

            ASource = "MKT"
            rs.fields("ASource") = ASource   ' Marketing Application Source

            ' Default for Days Basis
            rs.fields("PCNO") = -1
            rs.fields("ANO") = -1
            rs.fields("ProformaF") = ProformaF
            rs.fields("OCNO") = -1
            CNO = db.GetIdentity("Cover") + 1
            rs.fields("CNO") = CNO
            rs.fields("OCNO") = CNO
        Else
            rs.Edit()
            ASource = rs.fields("ASource")
        End If
        If rs.fields("CStatus") <> "R" Then
            StrMsg = "Quotation Already Processed !"
            GoTo errmsg
        End If

        ' Keep Previous Policy Holder
        PPHolder = tostr(rs.fields("PHolder"))

        rs.fields("Prorata") = Prorata
        rs.fields("MO") = MO
        rs.fields("Remarks") = GetFieldValue(fbuffer(GetFieldIndex("Remarks", findex)))
        rs.fields("Segment") = Segment
        rs.fields("Validation") = GetFieldValue(fbuffer(GetFieldIndex("Validation", findex)))
        rs.fields("RefNo") = GetFieldValue(fbuffer(GetFieldIndex("CRefNo", findex)))
        rs.fields("PHolder") = PHolder

        rs.fields("BCNO") = -1
        rs.fields("PPeriod") = Basis ' Calculation Basis
        rs.fields("LUserID") = db_user
        rs.fields("LDate") = Today.Date
        rs.fields("LTime") = Time()

        If AType = "N" Then
            rs.fields("Insured") = AName
            rs.fields("RefDate") = RefDate
        End If
        rs.fields("CoverDate") = SDate
        rs.fields("ExpDate") = EDate
        rs.fields("TBAF") = GetFieldValue(fbuffer(GetFieldIndex("TBAF", findex)))
        If Not rs.Update Then GoTo errmsg
        rs.CloseRemoteSet()

        'Create Acceptance
        rs = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
        If rs.Eof Then
            EditMode = AdEditAdd
            'Set Auto Numbering Here

            If RefNo = "" Then
                If Not CBool(toval(GetAppSetting("GenerateRefNoF"))) Then
                    RefNo = CoverNo
                Else
                    RefNo = GetDocumentNumbering("REF", PolicyType, ISType, Today.Date, Branch, TOC, CT)
                End If
            End If
            If RefNo = "" Then
                StrMsg = "Generate Reference No. Failed !"
                GoTo errmsg
            End If
            rs = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
            rs.AddNew()
            rs.fields("TOC") = TOC
            rs.fields("RegNo") = RegNo
            rs.fields("RegDate") = Today.Date
            rs.fields("CNO") = CNO
            rs.fields("AType") = "N"    ' New Policy
            rs.fields("AStatus") = "W"  ' Waiting
            rs.fields("PolicyNo") = ""
            rs.fields("CertificateNo") = ""
            rs.fields("RANO") = -1      ' Renewal Acceptance
            rs.fields("pANO") = -1      ' Previous ANO
            rs.fields("lANO") = -1      ' Master Link ANO
            rs.fields("AdjustableF") = False
            rs.fields("UserID") = db_user
            rs.fields("CDate") = Today.Date
            rs.fields("CTime") = Time()
            ANO = db.GetIdentity("Acceptance") + 1
            rs.fields("ANO") = ANO
            If SType <> "S" Then    ' Master or Open Cover
                rs.fields("LANO") = ANO
            End If
            rs.fields("OANO") = ANO
            rs.fields("Source") = PayorID
            rs.fields("SDate") = SDate
            rs.fields("EDate") = EDate
        Else
            EditMode = AdEditInProgress
            rs = db.OpenRemoteSet("Select Status from RArrHeader Where ANO=" & ANO)
            If tostr(rs.fields("Status")) = "A" Then
                If Not UnReleaseAccRegAmount(ANO, True) Then GoTo errmsg
            End If

            rs = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
            rs.Edit()
        End If

        PSDate = todate(rs.fields("SDate"))
        PEDate = todate(rs.fields("EDate"))
        PRefNo = tostr(rs.fields("RefNo"))
        pBranch = tostr(rs.fields("Branch"))
        pCT = tostr(rs.fields("CT"))
        pAID = tostr(rs.fields("AID"))

        rs.fields("RefNo") = IIf(RefNo <> "", RefNo, rs.fields("RefNo"))
        rs.fields("RefDate") = RefDate
        rs.fields("Branch") = Branch
        rs.fields("CT") = CT
        rs.fields("ASource") = GetFieldValue(fbuffer(GetFieldIndex("ASource", findex)))
        rs.fields("Location") = GetFieldValue(fbuffer(GetFieldIndex("Location", findex)))
        rs.fields("CPolicyNo") = GetFieldValue(fbuffer(GetFieldIndex("CPolicyNo", findex)))
        rs.fields("ConjunctionF") = GetFieldValue(fbuffer(GetFieldIndex("ConjunctionF", findex)))
        rs.fields("ExclusiveF") = GetFieldValue(fbuffer(GetFieldIndex("ExclusiveF", findex)))
        rs.fields("ExtPeriod") = GetFieldValue(fbuffer(GetFieldIndex("ExtPeriod", findex)))
        rs.fields("EXTPERIODINDAYSF") = GetFieldValue(fbuffer(GetFieldIndex("EXTPERIODINDAYSF", findex)))
        rs.fields("TOPRO") = GetFieldValue(fbuffer(GetFieldIndex("TOPRO", findex)))
        rs.fields("BankersID") = GetFieldValue(fbuffer(GetFieldIndex("BankersID", findex)))
        rs.fields("BankersClause") = GetFieldValue(fbuffer(GetFieldIndex("BankersClause", findex)))
        rs.fields("AID") = AID
        rs.fields("AName") = AName
        rs.fields("SDate") = SDate
        rs.fields("EDate") = EDate
        rs.fields("STime") = GetFieldValue(fbuffer(GetFieldIndex("STime", findex)))
        rs.fields("ETime") = GetFieldValue(fbuffer(GetFieldIndex("ETime", findex)))
        rs.fields("Business") = GetFieldValue(fbuffer(GetFieldIndex("Business", findex)))
        rs.fields("Ujroh") = GetFieldValue(fbuffer(GetFieldIndex("Ujroh", findex)))
        rs.fields("WeightedAvgUjrohF") = GetFieldValue(fbuffer(GetFieldIndex("WeightedAvgUjrohF", findex)))
        rs.fields("BatchNo") = GetFieldValue(fbuffer(GetFieldIndex("BatchNo", findex)))
        rs.fields("BID") = GetFieldValue(fbuffer(GetFieldIndex("BID", findex)))

        OldCANO = toval(rs.fields("CANO"))
        rs.fields("CANO") = CANO

        rs.fields("SNO") = SNO
        rs.fields("BANO") = -1
        rs.fields("LUserID") = db_user
        rs.fields("LDate") = Today.Date
        rs.fields("LTime") = Time()
        rs.fields("PStatus") = "I"
        rs.fields("RenewableF") = RenewableF
        If EditMode = AdEditAdd Then
            rs.fields("NoRiskAccumulationF") = NoRiskAccumulationF
            rs.fields("AnnualTreatyF") = AnnualTreatyF
        End If
        rs.fields("PWordingID") = GetFieldValue(fbuffer(GetFieldIndex("PWordingID", findex)))
        rs.fields("BizmapID") = GetFieldValue(fbuffer(GetFieldIndex("BizmapID", findex)))
        rs.fields("MSCode") = GetFieldValue(fbuffer(GetFieldIndex("MSCode", findex)))

        If AType = "N" Then
            rs.fields("RegDate") = Today.Date
            rs.fields("PDate") = SDate
        End If
        rs.fields("PolicyDate") = SDate
        rs.fields("ADate") = SDate
        rs.fields("PPDate") = EDate

        If EditMode = AdEditAdd Then
            If IsDate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex)))) AndAlso DateDiff(DateInterval.Day, SDate, todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))) >= 0 Then
                rs.fields("NCDate") = todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))
            Else
                rs.fields("NCDate") = SDate
            End If
        Else
            If DateDiff(DateInterval.Day, todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex)))), rs.fields("NCDate")) <> 0 Then
                If DateDiff(DateInterval.Day, SDate, todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))) >= 0 Then
                    rs.fields("NCDate") = todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))
                Else
                    rs.fields("NCDate") = SDate
                End If
            Else
                If DateDiff(DateInterval.Day, PSDate, rs.fields("NCDate")) = 0 OrElse DateDiff(DateInterval.Day, SDate, todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex))))) < 0 Then
                    rs.fields("NCDate") = SDate
                End If
            End If
        End If

        If AType = "N" Or ASource = "MKT" Then
            rs.fields("MSCode") = Get_MSCode(rs.fields("MSCode"), Branch, MO, SDate, EDate)
        End If
        RefNo = rs.fields("RefNo")
        Branch = rs.fields("Branch")

        If rs.fields("STime") = "" Then rs.fields("STime") = STime
        If rs.fields("ETime") = "" Then rs.fields("ETime") = ETime

        If rs.fields("STime") = "" Then
            If rs.fields("ExclusiveF") Then
                rs.fields("STime") = "00:00"
            Else
                rs.fields("STime") = "12:00"
            End If
        End If
        If rs.fields("ETime") = "" Then
            If rs.fields("ExclusiveF") Then
                rs.fields("ETime") = "24:00"
            Else
                rs.fields("ETime") = "12:00"
            End If
        End If
        ' Update the Accumulation Register
        rs.fields("RegID") = RegID
        rs.fields("FLDID") = FLDID
        rs.fields("ValueID") = ValueID
        rs.fields("ValueDesc") = ValueDesc

        If Not rs.Update Then GoTo errmsg
        ANO = toval(rs.fields("ANO"))
        LANO = toval(rs.fields("LANO"))
        PDate = todate(rs.fields("PDate"))

        Dim RDATE As Date = SDate
        Dim NRDATE As Date = EDate

        If SType = "S" Then
            ' Add for Default Risk Arrangement
            rs = db.OpenRemoteSet("Select * from RArrHeader Where ANO=" & ANO)
            If Not rs.Eof Then
                rs.Edit()
            Else
                rs.AddNew()
                rs.fields("ANO") = ANO
                rs.fields("LDate") = Today.Date
                rs.fields("LUserID") = db_user
            End If

            If rs.editmode = AdEditAdd Then
                RDATE = SDate
                NRDATE = EDate
            Else
                RDATE = rs.fields("RDATE")
                NRDATE = rs.fields("NRDATE")
            End If
            If AnnualTreatyF Then
                ' Check for Leap Year
                If Month(DateSerial(Year(PDate), Month(SDate), Day(SDate))) <> Month(SDate) Then
                    RDATE = DateAdd(DateInterval.Day, -1, DateSerial(Year(PDate), Month(SDate), Day(SDate)))
                Else
                    RDATE = DateSerial(Year(PDate), Month(SDate), Day(SDate))
                End If
                If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)
                If DateDiff(DateInterval.Day, PDate, RDATE) < 0 Then RDATE = DateAdd(DateInterval.Month, 12, RDATE)
                If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)

                If DateDiff(DateInterval.Day, SDate, RDATE) < 0 Then RDATE = SDate
                NRDATE = DateAdd(DateInterval.Month, 12, RDATE)
                If DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
            Else
                If AType = "N" OrElse DateDiff(DateInterval.Day, PSDate, RDATE) = 0 OrElse DateDiff(DateInterval.Day, SDate, RDATE) < 0 Then RDATE = SDate
                If DateDiff(DateInterval.Day, EDate, RDATE) > 0 Then RDATE = EDate
                If DateDiff(DateInterval.Day, SDate, NRDATE) < 0 Then NRDATE = SDate
                If DateDiff(DateInterval.Day, PEDate, NRDATE) = 0 OrElse DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
                If DateDiff(DateInterval.Day, RDATE, NRDATE) <= 0 Then
                    RDATE = SDate
                    NRDATE = EDate
                End If
            End If

            If AType = "N" Then
                rs.fields("PDate") = RDATE
                rs.fields("PPDate") = NRDATE
            Else
                ' Clean Cut
                If Not (DateDiff(DateInterval.Day, rs.fields("PDate"), rs.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rs.fields("PPDate"), rs.fields("NRDate")) = 0) Then
                    If DateDiff(DateInterval.Day, rs.fields("PPDate"), PDate) >= 0 Then
                        RDATE = rs.fields("PPDate")
                    End If

                    If DateDiff(DateInterval.Day, RDATE, rs.fields("PDate")) >= 0 Then
                        RDATE = rs.fields("PDate")
                    End If
                Else
                    rs.fields("PDate") = RDATE
                    rs.fields("PPDate") = NRDATE
                End If
            End If

            rs.fields("NCDate") = RDATE
            rs.fields("RDate") = RDATE
            rs.fields("NRDate") = NRDATE
            rs.fields("Status") = "R"
            rs.fields("TreatyF") = True
            rs.fields("HoldF") = False
            rs.fields("Message") = ""
            If Not rs.Update Then GoTo errmsg
            rs.CloseRemoteSet()
        Else
            ' Update BizMap
            If Not db.Execute("Update Acceptance Set BizMapID='" & Get_BizMap(ANO) & "' Where ANO=" & ANO) Then GoTo errmsg
        End If

        If Not Save_Object_Info(ANO, findex, fbuffer, SDate, TOC, Segment) Then GoTo errmsg

        ' Only for New Records
        If EditMode = AdEditAdd Then

            ' Creating Underwriting Info
            'rsd = db.OpenRemoteSet("Select * from UINFO Where 1<>1")
            'rss = db.OpenQueryDef("QCOB_BY_TOC", adOpenKeyset, TOC)
            'rsd.AddNew()
            'rsd.fields("CNO") = CNO
            'For i = 1 To 15
            '    rsd.fields("FLDID" & i) = tostr(rss.fields("FLDID" & i))
            'Next i
            'If Not rsd.Update Then GoTo errmsg
            'rsd.CloseRemoteSet()
            'rss.CloseRemoteSet()

            If CANO <> -1 AndAlso Not NotApplyConjunctPolicyDataF Then
                Dim CCNO As Long
                Dim Conj_COB As String
                Dim COB As String
                rs = db.OpenRemoteSet("Select A.CNO, T1.COB as Conj_COB, T2.COB as COB from Acceptance A, TOC T1, TOC T2 Where T1.TOC=A.TOC and A.ANO=" & CANO & " and T2.TOC='" & TOC & "'")
                CCNO = toval(rs.fields("CNO"))
                Conj_COB = tostr(rs.fields("Conj_COB"))
                COB = tostr(rs.fields("COB"))

                ' If Conjunction Get Info from Conjunct Policy
                If Not CopyAccDetail("Payor", CANO, ANO) Then GoTo errmsg

                If Not CopyAccDetail("AccDA", CANO, ANO) Then GoTo errmsg
                If Not CopyAccDetail("AccCA", CANO, ANO) Then GoTo errmsg
                If Not CopyAccDetail("AccBS", CANO, ANO) Then GoTo errmsg


                If Conj_COB.ToUpper = COB.ToUpper Then
                    If Not CopyInterest(CANO, ANO, , True, , True) Then GoTo errmsg
                    If Not CopyAccDetail("AccSection", CANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccCla", CANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccEx", CANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccCon", CANO, ANO) Then GoTo errmsg
                    If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & ANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

                    If CBool(toval(GetAppSetting("CopyFacultativeFromMainPolicyF"))) Then
                        If Not Copy_Facultative_Master(CANO, ANO) Then GoTo errmsg
                    End If

                    If CBool(toval(GetAppSetting("CopyFeeDutyFromMainPolicyF"))) Then
                        If Not CopyAccDetail("ACCFD", CANO, ANO) Then GoTo errmsg
                    End If
                End If

                If ISType = "C" Or ISType = "R" Or ISType = "L" Then
                    CCNO = toval(rs.fields("CNO"))
                    Select Case ISType
                        Case "L"    ' Coinsurance Leader
                            If Not CopyCovDetail("Coinsurance", CCNO, CNO) Then GoTo errmsg
                        Case "C"    ' Coinsurance Member
                            If Not CopyCovDetail("Coinsurance", CCNO, CNO) Then GoTo errmsg
                            If Not CopyCovDetail("ISource", CCNO, CNO) Then GoTo errmsg
                        Case "R"    ' Inward Reinsurance
                            If Not CopyCovDetail("ISource", CCNO, CNO) Then GoTo errmsg
                    End Select
                End If
                If Not Create_Payor(ANO, PayorID, WPC, Grace, False) Then GoTo errmsg
                If Not Create_AccDA(ANO, PHolder, False) Then GoTo errmsg
                If Not Create_AccCA(ANO, PHolder, False) Then GoTo errmsg
            Else
                If TANO > 0 Then
                    If Not CopyAccDetail("RCover", TANO, ANO) Then GoTo errmsg
                    If Not CopyInterest(TANO, ANO, , True) Then GoTo errmsg
                    If Not CopyAccDetail("AccDed", TANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccSection", TANO, ANO) Then GoTo errmsg

                    If Not CopyAccDetail("AccCla", TANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccEx", TANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccCon", TANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccBS", TANO, ANO) Then GoTo errmsg
                    If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & ANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

                    ' Copy from Template Policy
                    rs = db.OpenRemoteSet("Select SIScheduleF from Payor Where ANO=" & TANO)
                    If Not rs.Eof AndAlso toval(rs.fields("SIScheduleF")) Then
                        If Not CopyAccDetail("Payor", TANO, ANO) Then GoTo errmsg

                    End If

                    If Not Copy_Facultative_Master(TANO, ANO) Then GoTo errmsg
                End If
                If Not Create_Payor(ANO, PayorID, WPC, Grace, OverWritePayorF) Then GoTo errmsg
                If Not Create_AccDA(ANO, PHolder, OverWriteDAF) Then GoTo errmsg
                If Not Create_AccCA(ANO, PHolder, OverWriteCAF) Then GoTo errmsg
                If Not Create_AccSgn(ANO, PHolder, Branch) Then GoTo errmsg
            End If

            ' Creating Default Section
            rss = db.OpenRemoteSet("Select * from Section Where TOC='" & TOC & "' and DefaultF=1")
            If Not rss.Eof Then
                rsd = db.OpenRemoteSet("Select * from AccSection Where ANO=" & ANO)
                If rsd.Eof Then
                    Do While Not rss.Eof
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("Section") = tostr(rss.fields("Section"))
                        rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                        rsd.fields("Description") = tostr(rss.fields("Description"))
                        If Not rsd.Update Then GoTo errmsg
                        rss.MoveNext()
                    Loop
                End If
            End If

            ' Creating Default Clauses
            rss = db.OpenRemoteSet("Select * from DefCLA Where TOC='" & TOC & "'")
            If Not rss.Eof Then
                rsd = db.OpenRemoteSet("Select * from AccCLA Where ANO=" & ANO)
                If rsd.Eof Then
                    Do While Not rss.Eof
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("Section") = tostr(rss.fields("Section"))
                        rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                        rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                        rsd.fields("Description") = tostr(rss.fields("Description"))
                        rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                        rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                        If Not rsd.Update Then GoTo errmsg
                        rss.MoveNext()
                    Loop
                End If

                ' Insert into Section Table
                Dim SQL As String
                SQL = "Insert into AccSection(ANO, Section, ShortDesc, Description)"
                SQL = SQL & " Select DISTINCT A2.ANO, A2.Section, S.ShortDesc, CAST(S.Description AS VARCHAR(MAX))"
                SQL = SQL & " from Acceptance A1 "
                SQL = SQL & " Inner Join AccCla A2 on (A2.ANO=A1.ANO)"
                SQL = SQL & " Inner join Section S on (S.TOC=A1.TOC and S.Section=A2.Section)"
                SQL = SQL & " Left join AccSection A3 on (A3.ANO=A1.ANO and A3.Section=S.section)"
                SQL = SQL & " Where A1.ANO=" & ANO & " and A3.Section Is null"
                If Not db.Execute(SQL) Then GoTo errmsg
            End If

            ' Creating Default Conditions
            rss = db.OpenRemoteSet("Select * from DefCON Where TOC='" & TOC & "'")
            If Not rss.Eof Then
                rsd = db.OpenRemoteSet("Select * from AccCON Where ANO=" & ANO)
                If rsd.Eof Then
                    Do While Not rss.Eof
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("Section") = tostr(rss.fields("Section"))
                        rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                        rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                        rsd.fields("Description") = tostr(rss.fields("Description"))
                        rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                        rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                        If Not rsd.Update Then GoTo errmsg
                        rss.MoveNext()
                    Loop
                End If
            End If

            ' Creating Default Exclusions
            rss = db.OpenRemoteSet("Select * from DefEX Where TOC='" & TOC & "'")
            If Not rss.Eof Then
                rsd = db.OpenRemoteSet("Select * from AccEx Where ANO=" & ANO)
                If rsd.Eof Then
                    Do While Not rss.Eof
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("Section") = tostr(rss.fields("Section"))
                        rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                        rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                        rsd.fields("Description") = tostr(rss.fields("Description"))
                        rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                        rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                        If Not rsd.Update Then GoTo errmsg
                        rss.MoveNext()
                    Loop
                End If
            End If
        Else
            If CANO <> -1 AndAlso Not NotApplyConjunctPolicyDataF AndAlso (Not KeepExistingF Or OldCANO <> CANO) Then
                Dim CCNO As Long
                Dim Conj_COB As String
                Dim COB As String
                rs = db.OpenRemoteSet("Select A.CNO, T1.COB as Conj_COB, T2.COB as COB from Acceptance A, TOC T1, TOC T2 Where T1.TOC=A.TOC and A.ANO=" & CANO & " and T2.TOC='" & TOC & "'")
                CCNO = toval(rs.fields("CNO"))
                Conj_COB = tostr(rs.fields("Conj_COB"))
                COB = tostr(rs.fields("COB"))

                If Not db.Execute("Delete from Payor Where ANO=" & ANO) Then GoTo errmsg

                If Not db.Execute("Delete from AccDA Where ANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Delete from AccCA Where ANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Delete from AccBS Where ANO=" & ANO) Then GoTo errmsg


                ' If Conjunction Get Info from Conjunct Policy
                If Not CopyAccDetail("Payor", CANO, ANO) Then GoTo errmsg

                If Not CopyAccDetail("AccDA", CANO, ANO) Then GoTo errmsg
                If Not CopyAccDetail("AccCA", CANO, ANO) Then GoTo errmsg
                If Not CopyAccDetail("AccBS", CANO, ANO) Then GoTo errmsg


                If Conj_COB.ToUpper = COB.ToUpper Then
                    If Not db.Execute("Delete from ICover Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccSection Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccCla Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccEx Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccCon Where ANO=" & ANO) Then GoTo errmsg

                    If Not CopyInterest(CANO, ANO, , True, , True) Then GoTo errmsg
                    If Not CopyAccDetail("AccSection", CANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccCla", CANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccEx", CANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccCon", CANO, ANO) Then GoTo errmsg
                    If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & ANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

                    If CBool(toval(GetAppSetting("CopyFacultativeFromMainPolicyF"))) Then
                        If Not Copy_Facultative_Master(CANO, ANO) Then GoTo errmsg
                    End If

                    If CBool(toval(GetAppSetting("CopyFeeDutyFromMainPolicyF"))) Then
                        If Not db.Execute("Delete from ACCFD Where ANO=" & ANO) Then GoTo errmsg
                        If Not CopyAccDetail("ACCFD", CANO, ANO) Then GoTo errmsg
                    End If
                End If

                If ISType = "C" Or ISType = "R" Or ISType = "L" Then
                    CCNO = toval(rs.fields("CNO"))
                    Select Case ISType
                        Case "L"    ' Coinsurance Leader
                            If Not db.Execute("Delete from Coinsurance Where CNO=" & CNO) Then GoTo errmsg
                            If Not CopyCovDetail("Coinsurance", CCNO, CNO) Then GoTo errmsg
                        Case "C"    ' Coinsurance Member
                            If Not db.Execute("Delete from Coinsurance Where CNO=" & CNO) Then GoTo errmsg
                            If Not db.Execute("Delete from ISource Where CNO=" & CNO) Then GoTo errmsg
                            If Not CopyCovDetail("Coinsurance", CCNO, CNO) Then GoTo errmsg
                            If Not CopyCovDetail("ISource", CCNO, CNO) Then GoTo errmsg
                        Case "R"    ' Inward Reinsurance
                            If Not db.Execute("Delete from ISource Where CNO=" & CNO) Then GoTo errmsg
                            If Not CopyCovDetail("ISource", CCNO, CNO) Then GoTo errmsg
                    End Select
                End If

                If Not Create_Payor(ANO, PayorID, WPC, Grace, False) Then GoTo errmsg
                If Not Create_AccDA(ANO, PHolder, False) Then GoTo errmsg
                If Not Create_AccCA(ANO, PHolder, False) Then GoTo errmsg
            Else
                If Not (ISType = "C" Or ISType = "R") Then
                    If Not Create_Payor(ANO, PayorID, WPC, Grace, OverWritePayorF) Then GoTo errmsg
                    If Not Create_AccDA(ANO, PHolder, OverWriteDAF) Then GoTo errmsg
                    If Not Create_AccCA(ANO, PHolder, OverWriteCAF) Then GoTo errmsg
                End If

                If TANO > 0 Then
                    ' Copy from Template Policy
                    If Not db.Execute("Delete from RCover Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from ICover Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccDed Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccSection Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccCla Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccEx Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccCon Where ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Delete from AccBS Where ANO=" & ANO) Then GoTo errmsg
                    ' Copy from Template Policy
                    If Not CopyAccDetail("RCover", TANO, ANO) Then GoTo errmsg
                    If Not CopyInterest(TANO, ANO, , True) Then GoTo errmsg
                    If Not CopyAccDetail("AccDed", TANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccSection", TANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccCla", TANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccEx", TANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccCon", TANO, ANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccBS", TANO, ANO) Then GoTo errmsg
                    If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & ANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg
                    If Not Copy_Facultative_Master(TANO, ANO) Then GoTo errmsg
                End If
            End If

        End If

        If EditMode = AdEditAdd Or PSDate <> SDate Or PEDate <> EDate Or TANO > 0 Then
            If Not Adjust_RCover(ANO, PSDate, PEDate, SDate, EDate, Voyage, PTerm, TOC) Then GoTo errmsg
            If Not Adjust_ICover(ANO, SDate, EDate) Then GoTo errmsg
            If Not Adjust_Deductible(ANO, SDate, EDate) Then GoTo errmsg
            If AdjustFacultativePeriodF Then
                If Not db.Execute("Update RArrDet Set SDate='" & Format(SDate, "MM/DD/YYYY") & "', EDate='" & Format(EDate, "MM/DD/YYYY") & "' Where RArrDet.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' and RArrDet.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' and RArrDet.ANO=" & ANO) Then GoTo errmsg
            Else
                If Not db.Execute("Update RArrDet Set SDate='" & Format(SDate, "MM/DD/YYYY") & "', EDate='" & Format(EDate, "MM/DD/YYYY") & "' Where RArrDet.RType not in ('F','QS','QP','S1','S2','S3','AF') and RArrDet.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' and RArrDet.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' and RArrDet.ANO=" & ANO) Then GoTo errmsg
            End If
        End If

        If Not Save_Interest_Info_from_Object_Info(ANO, findex, fbuffer, SDate, TOC, Segment) Then GoTo errmsg

        ' Default Treaty Excluded Clauses
        If EditMode = AdEditAdd Then
            rss = db.OpenRemoteSet("Select * from RexCla Where TOC='" & TOC & "' and RYear=" & Year(SDate), adOpenForwardonly)
            Do While Not rss.Eof
                rsd = db.OpenRemoteSet("Select * from AccCLa Where ANO=" & ANO & " and OrderNo='" & rss.fields("OrderNo") & "'")
                If rsd.Eof Then
                    rsd.AddNew()
                    rsd.fields("ANO") = ANO
                    rsd.fields("Section") = ""
                    rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                    rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                    rsd.fields("Description") = tostr(rss.fields("Description"))
                    rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                    rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                    If Not rsd.Update Then GoTo errmsg
                End If
                rss.MoveNext()
            Loop
        End If

        If SNO <> -1 Then
            Dim OSNO As Long
            rs = db.OpenQueryDef("QService", adOpenKeyset, SNO)
            If rs.Eof Or tostr(rs.fields("SStatus")) <> "P" Then GoTo errmsg
            OSNO = rs.fields("OSNO")
            rs.Edit()
            rs.fields("ANO") = ANO
            rs.fields("CNO") = CNO
            rs.fields("LANO") = LANO
            If Not rs.Update Then GoTo errmsg

            ' Default from Servicing
            If EditMode = AdEditAdd Then
                If rs.fields("CedingID") <> "" AndAlso InStr("CRT", ISType) <> 0 Then
                    rsd = db.OpenRemoteSet("Select * from ISource Where CNO=" & CNO)
                    If rsd.Eof Then
                        rsd.AddNew()
                        rsd.fields("CNO") = CNO
                    Else
                        rsd.Edit()
                    End If
                    rsd.fields("ID") = rs.fields("CedingID")
                    rsd.fields("CedingID") = rs.fields("CedingID")
                    rsd.fields("Share") = rs.fields("CedingShare")
                    If Not rsd.Update Then GoTo errmsg
                End If
                If rs.fields("BSID") <> "" Then
                    Dim rsProfile As RemoteSet
                    rsProfile = db.OpenRemoteSet("select Profile.Comm, TaxType.MTaxType, Profile.NetCommF from Profile Left Join TaxType on (TaxType.TaxType=Profile.TaxType) Where ID='" & rs.fields("BSID") & "'")
                    rsd = db.OpenRemoteSet("Select * from AccBS Where ANO=" & ANO & " and ID='" & rs.fields("BSID") & "' and BSType='" & IIf(rsProfile.fields("MTaxType") = "PASAL21", "A", "B") & "'")
                    If rsd.Eof Then
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("ID") = rs.fields("BSID")
                        rsd.fields("Fee") = rsProfile.fields("Comm")
                        rsd.fields("NetF") = rsProfile.fields("NetCommF")
                        rsd.fields("BSType") = IIf(rsProfile.fields("MTaxType") = "PASAL21", "A", "B")
                        If rsd.fields("OBSType") = "" Then rsd.fields("OBSType") = rsd.fields("BSType")
                        If Not rsd.Update Then GoTo errmsg
                    End If
                End If

                Dim Scaling As Double
                rss = db.OpenQueryDef("QRateCode", adOpenForwardonly, ANO, rs.fields("Code"))
                If Not rss.Eof Then
                    rsd = db.OpenRemoteSet("Select * from RCover Where ANO=" & ANO & " and Code='" & tostr(rss.fields("Code")) & "' and SDate='" & Format(SDate, "MM/DD/YYYY") & "'")
                    If rsd.Eof Then
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("Code") = tostr(rss.fields("Code"))
                        rsd.fields("Rate") = tostr(rss.fields("Rate"))
                        rsd.fields("Unit") = tostr(rss.fields("Unit"))
                        rsd.fields("Category") = tostr(rss.fields("Category"))
                        rsd.fields("Portion") = toval(rss.fields("Portion"))
                        rsd.fields("Remark") = tostr(rs.fields("Coverage"))
                        rsd.fields("PCTLoss") = 100
                        rsd.fields("PADDITION") = 0
                        rsd.fields("Discount") = 0
                        rsd.fields("Loading") = toval(rss.fields("Loading"))
                        rsd.fields("TExcess") = toval(rss.fields("TExcess"))
                        rsd.fields("PCalc") = "F"
                        rsd.fields("SDate") = SDate
                        rsd.fields("EDate") = EDate
                        Select Case DateDiff(DateInterval.Month, SDate, EDate)
                            Case Is < PTerm
                                Scaling = Short_Period_Calc(TOC, SDate, EDate, EDate)
                                If Scaling <> 0 And Scaling <> 100 Then
                                    rsd.fields("PCalc") = "S"
                                    rsd.fields("PProrata") = Scaling
                                Else
                                    rsd.fields("PCalc") = "P"
                                End If
                            Case PTerm
                                If DateAdd(DateInterval.Month, PTerm, SDate) <> EDate Then
                                    rsd.fields("PCalc") = "P"
                                Else
                                    rsd.fields("PCalc") = "F"
                                End If
                            Case Is > PTerm
                                rsd.fields("PCalc") = "P"
                        End Select
                        If Not rsd.Update Then GoTo errmsg
                    End If
                End If

                Dim INO As Long
                Dim TOI As String
                rss = db.OpenQueryDef("QTOI_1", adOpenForwardonly, ANO, "%")
                If Not rss.Eof Then
                    rsd = db.OpenRemoteSet("Select * from ICover Where ANO=" & ANO & " and TOI='" & tostr(rss.fields("TOI")) & "' and Currency='" & tostr(rs.fields("Currency")) & "'")
                    If rsd.Eof Then
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        TOI = tostr(rss.fields("TOI"))
                        rsd.fields("TOI") = TOI
                        rsd.fields("Remark") = tostr(rss.fields("Description"))
                        rsd.fields("Adjustable") = toval(rss.fields("Adjustable"))
                        rsd.fields("Category") = tostr(rss.fields("Category"))
                        rsd.fields("Currency") = tostr(rs.fields("Currency"))
                        rsd.fields("Amount") = rs.fields("TSI")
                        rsd.fields("Amount_AOE") = rs.fields("TSI")
                        rsd.fields("SI") = rs.fields("TSI")
                        rsd.fields("Total") = 0

                        rsd.fields("Currency_OC") = rsd.fields("Currency")
                        rsd.fields("Rate_OC") = 1
                        rsd.fields("Amount_OC") = toval(rsd.fields("Amount")) / toval(rsd.fields("Rate_OC"))
                        rsd.fields("Amount_AOE_OC") = toval(rsd.fields("Amount_AOE")) / toval(rsd.fields("Rate_OC"))
                        rsd.fields("SI_OC") = toval(rsd.fields("SI")) / toval(rsd.fields("Rate_OC"))
                        rsd.fields("EML_OC") = toval(rsd.fields("EML")) / toval(rsd.fields("Rate_OC"))

                        INO = db.GetIdentity("ICover") + 1
                        rsd.fields("INO") = INO
                        If Not rsd.Update Then GoTo errmsg

                        Dim j As Integer
                        rs = db.OpenQueryDef("QTOI", adOpenForwardonly, TOI)
                        rss = db.OpenRemoteSet("Select * from AINFO A Left join AINFO_Ext A_Ext on (A_Ext.ANO=A.ANO) Where A.ANO=" & ANO)
                        rsd = db.OpenRemoteSet("Select * from IInfo Where 1<>1")
                        rsd.AddNew()
                        rsd.fields("INO") = INO
                        For i = 1 To 15
                            rsd.fields("FLDID" & i) = ""
                            rsd.fields("VALUEID" & i) = ""
                            rsd.fields("VALUEDESC" & i) = ""
                            If rs.fields("FLDID" & i) <> "" Then
                                rsd.fields("FLDID" & i) = rs.fields("FLDID" & i)
                                For j = 1 To 15
                                    If rss.fields("FLDID" & j) <> "" Then
                                        If rs.fields("FLDID" & i) = rss.fields("FLDID" & j) Then
                                            rsd.fields("VALUEID" & i) = rss.fields("VALUEID" & j)
                                            rsd.fields("VALUEDESC" & i) = rss.fields("VALUEDESC" & j)
                                        End If
                                    Else
                                        Exit For
                                    End If
                                Next j

                            Else
                                Exit For
                            End If
                        Next i
                        If Not rsd.Update Then GoTo errmsg
                    End If
                End If

                If tostr(rs.fields("TOPRO")) <> "" Then
                    Dim tParam(10) As Object

                    tParam(0) = tostr(rs.fields("TOPRO"))
                    tParam(1) = tostr(rs.fields("TOC"))
                    tParam(2) = ANO
                    tParam(3) = tostr(rs.fields("Currency"))
                    tParam(4) = toval(rs.fields("TSI"))
                    tParam(5) = toval(rs.fields("ATSI"))
                    tParam(6) = True
                    tParam(7) = True
                    tParam(8) = True
                    tParam(9) = True
                    tParam(10) = toval(rs.fields("Premium"))
                    TOP_Process(tParam)
                End If

                If Not Create_AccDA_from_Service(ANO, SNO) Then GoTo errmsg
                If Not Create_AccCA_from_Service(ANO, SNO) Then GoTo errmsg
                If Not Create_Payor_from_Service(ANO, SNO) Then GoTo errmsg
                If Not Create_AccPic_from_Service(ANO, OSNO) Then GoTo errmsg
                If Not Create_Uinfo_from_Service(CNO, SNO) Then GoTo errmsg
                If Not Create_Facultative_from_Service(ANO, SNO) Then GoTo errmsg
                If Not Create_Coinsurance_from_Service(CNO, SNO) Then GoTo errmsg

                ' Reset Service No
                SNO = -1
            End If
        End If

        ' Any Change to Master Refno Also Change to Detail RefNo
        If SType = "M" And (PRefNo <> RefNo Or pBranch <> Branch Or PSDate <> SDate Or PEDate <> EDate Or pCT <> CT) Then
            If Not db.Execute("Update Acceptance Set AID=Case When Acceptance.AID='" & pAID & "' then '" & AID & "' Else Acceptance.AID End, RefNo='" & RefNo & "', Branch='" & Branch & "', CT='" & CT & "', PStatus=Case When (RArrHeader.RDate='" & Format(PSDate, "MM/DD/YYYY") & "' and RArrHeader.RDate<>'" & Format(RDATE, "MM/DD/YYYY") & "') or (RArrHeader.NRDate='" & Format(PEDate, "MM/DD/YYYY") & "' and RArrHeader.NRDate<>'" & Format(NRDATE, "MM/DD/YYYY") & "') or (Acceptance.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' and Acceptance.SDate<>'" & Format(SDate, "MM/DD/YYYY") & "') or (Acceptance.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' and Acceptance.EDate<>'" & Format(EDate, "MM/DD/YYYY") & "') Then 'I' Else Acceptance.PStatus end, NCDate=Case When Acceptance.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(SDate, "MM/DD/YYYY") & "' Else Acceptance.NCDate End, SDate=Case When Acceptance.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(SDate, "MM/DD/YYYY") & "' Else Acceptance.SDate End, EDate=Case When Acceptance.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' Then '" & Format(EDate, "MM/DD/YYYY") & "' Else Acceptance.EDate End, PDate=Case When Acceptance.PDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(SDate, "MM/DD/YYYY") & "' Else Acceptance.PDate End, PPDate=Case When Acceptance.PPDate='" & Format(PEDate, "MM/DD/YYYY") & "' Then '" & Format(EDate, "MM/DD/YYYY") & "' Else Acceptance.PPDate End from Acceptance Inner Join RArrHeader on (RArrHeader.ANO=Acceptance.ANO) Where Acceptance.AStatus='W' and Acceptance.AType<>'C' and Acceptance.LANO<>Acceptance.ANO and Acceptance.LANO=" & ANO) Then GoTo errmsg
            If PSDate <> SDate Or PEDate <> EDate Then
                If Not db.Execute("Update RArrHeader Set NCDate=Case When RArrHeader.NCDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(RDATE, "MM/DD/YYYY") & "' Else RArrHeader.NCDate End, RDate=Case When RArrHeader.RDate='" & Format(PSDate, "MM/DD/YYYY") & "' Then '" & Format(RDATE, "MM/DD/YYYY") & "' Else RArrHeader.RDate End, NRDate=Case When RArrHeader.NRDate='" & Format(PEDate, "MM/DD/YYYY") & "' Then '" & Format(NRDATE, "MM/DD/YYYY") & "' Else RArrHeader.NRDate End from RArrHeader, Acceptance Where Acceptance.ANO=RArrHeader.ANO and Acceptance.pStatus='I' and Acceptance.AStatus='W' and Acceptance.AType<>'C' and Acceptance.LANO<>Acceptance.ANO and Acceptance.LANO=" & ANO) Then GoTo errmsg
                rs = db.OpenRemoteSet("Select ANO from Acceptance Where Acceptance.pStatus='I' and Acceptance.SDate='" & Format(SDate, "MM/DD/YYYY") & "' and Acceptance.EDate='" & Format(EDate, "MM/DD/YYYY") & "' and Acceptance.AStatus='W' and Acceptance.AType<>'C' and Acceptance.LANO<>Acceptance.ANO and Acceptance.LANO=" & ANO)
                Do While Not rs.Eof
                    If Not Adjust_RCover(rs.fields("ANO"), PSDate, PEDate, SDate, EDate, Voyage, PTerm, TOC) Then GoTo errmsg
                    If Not Adjust_ICover(rs.fields("ANO"), SDate, EDate) Then GoTo errmsg
                    If Not Adjust_Deductible(rs.fields("ANO"), SDate, EDate) Then GoTo errmsg
                    If AdjustFacultativePeriodF Then
                        If Not db.Execute("Update RArrDet Set SDate='" & Format(SDate, "MM/DD/YYYY") & "', EDate='" & Format(EDate, "MM/DD/YYYY") & "' Where RArrDet.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' and RArrDet.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' and RArrDet.ANO=" & rs.fields("ANO")) Then GoTo errmsg
                    Else
                        If Not db.Execute("Update RArrDet Set SDate='" & Format(SDate, "MM/DD/YYYY") & "', EDate='" & Format(EDate, "MM/DD/YYYY") & "' Where RArrDet.RType not in ('F','QS','QP','S1','S2','S3','AF') and RArrDet.SDate='" & Format(PSDate, "MM/DD/YYYY") & "' and RArrDet.EDate='" & Format(PEDate, "MM/DD/YYYY") & "' and RArrDet.ANO=" & rs.fields("ANO")) Then GoTo errmsg
                    End If
                    rs.MoveNext()
                Loop
            End If
        End If

        Save_Quotation_Data = ANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Quotation_Data = 0
    End Function

    Private Function Calc_Prorata(ByVal PTerm As Integer, ByVal SDate As Date, ByVal EDate As Date) As Double
        If PTerm = 0 Then
            Calc_Prorata = DateDiff(DateInterval.Day, SDate, DateAdd(DateInterval.Month, 12, SDate))
        Else
            Calc_Prorata = DateDiff(DateInterval.Day, SDate, DateAdd(DateInterval.Month, PTerm, SDate))
        End If
    End Function

