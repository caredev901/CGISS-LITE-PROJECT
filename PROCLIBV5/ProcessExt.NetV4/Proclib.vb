    Private Function EndorseTreaty(ByVal ADate As Date, ByVal REGID As String, ByVal FLDID As String, ByVal ValueID As String, ByVal NewValueID As String, ByVal RYear As Integer) As Boolean
        Dim rsAcc As RemoteSet
        Dim RegNo As String
        Dim rs As RemoteSet
        Dim Branch As String
        Dim TOC As String
        Dim OpenFlag As Boolean
        Dim LANO As Long
        Dim NewLANO As Long
        Dim ANO As Long
        Dim AStatus As String
        Dim PDate As Date
        Dim NEWANO As Long
        Dim RefNo As String

        On Error GoTo errmsg

        rsAcc = db.OpenRemoteSet("Select A.RefNo, A.Branch, A.PDate, A.ANO, A.LANO, A.AStatus, A.AType, A.TOC, A.OpenFlag from QAccumulation_Detail('" & REGID & "','" & FLDID & "','" & ValueID & "'," & RYear & ") A Where A.ManualF=0")
        Do While Not rsAcc.Eof
            LANO = toval(rsAcc.fields("LANO"))
            ANO = toval(rsAcc.fields("ANO"))
            AStatus = tostr(rsAcc.fields("AStatus"))
            Branch = tostr(rsAcc.fields("Branch"))
            TOC = tostr(rsAcc.fields("TOC"))
            OpenFlag = toval(rsAcc.fields("OpenFlag"))
            RefNo = tostr(rsAcc.fields("RefNo"))
            PDate = todate(rsAcc.fields("PDate"))

            If AStatus = "I" Then
                Dim param(16) As Object
                RegNo = ""
                If LANO <> -1 And Not OpenFlag Then ' Fleet
                    rs = db.OpenRemoteSet("Select A1.ANO, A1.PDate, A1.RefNo from Acceptance A1 where A1.AStatus='I' and A1.ANO=" & LANO & " and Not Exists (Select A2.PANO from Acceptance A2 where A2.PANO=A1.ANO)", adOpenForwardonly)
                    If Not rs.Eof Then
                        If Not db.GetLockedObject("Policy" & LANO) Then
                            StrMsg = db.ErrDesc
                            GoTo errmsg
                        End If
                        param(0) = RegNo
                        param(1) = ADate
                        param(2) = rs.fields("PDate")   'Keep at the beginning of effective Date
                        param(3) = "T"
                        param(4) = LANO
                        param(5) = ""
                        param(6) = ""
                        param(7) = ""
                        param(8) = False
                        param(9) = rs.fields("RefNo")
                        param(10) = ADate
                        param(11) = 4   ' Add/Refund for Re Only
                        param(12) = ""
                        param(13) = False
                        param(14) = "UW"
                        param(15) = ""
                        param(16) = ""
                        NewLANO = EndorseMaster(LANO, param)
                        If NewLANO = 0 Then GoTo errmsg

                        If Not db.ReleaseLockedObject("Policy" & LANO) Then
                            StrMsg = db.ErrDesc
                            GoTo errmsg
                        End If

                        ' Refresh Master Information
                        rs = db.OpenRemoteSet("Select A1.PolicyNo, A1.LANO, A1.RegNo from Acceptance A1 Where A1.AStatus='W' and ANO=" & NewLANO)
                        If rs.Eof Then
                            StrMsg = "Process : 'Master Policy (" & rs.fields("PolicyNo") & ")' is not Found !"
                            GoTo errmsg
                        End If
                        LANO = rs.fields("LANO")
                        RegNo = rs.fields("RegNo")
                    Else
                        rs = db.OpenRemoteSet("Select A1.LANO, A1.ANO, A1.RegNo, A1.AStatus, A1.PolicyNo, A1.CertificateNo from Acceptance A1 where A1.AStatus='W' and A1.AType not in ('A','C') and A1.PANO=" & LANO, adOpenForwardonly)
                        If rs.Eof Then
                            StrMsg = "Process : 'Master Policy (" & rs.fields("PolicyNo") & ")' is not Found !"
                            GoTo errmsg
                        End If
                        LANO = rs.fields("LANO")
                        RegNo = rs.fields("RegNo")
                    End If

                    If Not db.GetLockedObject("Policy" & ANO) Then
                        StrMsg = db.ErrDesc
                        GoTo errmsg
                    End If

                    rs = db.OpenRemoteSet("Select A1.ANO, A1.PolicyNo, A1.CertificateNo from Acceptance A1 where A1.PANO=" & ANO, adOpenForwardonly)
                    If Not rs.Eof Then
                        StrMsg = "Please Check the Policy Data " & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & " Already Endorsed/Cancelled !"
                        GoTo errmsg
                    End If
                    param(0) = RegNo
                    param(1) = ADate
                    param(2) = PDate
                    param(3) = "T"
                    param(4) = LANO
                    param(5) = ""
                    param(6) = ""
                    param(7) = ""
                    param(8) = False
                    param(9) = RefNo
                    param(10) = ADate
                    param(11) = 4   ' Add/Refund for Re Only
                    param(12) = ""
                    param(13) = False
                    param(14) = "UW"
                    param(15) = ""
                    param(16) = ""
                    NEWANO = Endorsement(ANO, param)
                    If NEWANO = 0 Then GoTo errmsg

                    If Not db.ReleaseLockedObject("Policy" & ANO) Then
                        StrMsg = db.ErrDesc
                        GoTo errmsg
                    End If

                Else
                    If LANO <> -1 Then
                        ' Refresh Master Information
                        rs = db.OpenRemoteSet("Select A1.PolicyNo, A1.LANO, A1.RegNo from Acceptance A1 Where A1.AStatus='I' and ANO=" & LANO)
                        If rs.Eof Then
                            StrMsg = "Process : 'Master Policy (" & rs.fields("PolicyNo") & ")' is not Found !"
                            GoTo errmsg
                        End If
                        RegNo = rs.fields("RegNo")
                    End If

                    If Not db.GetLockedObject("Policy" & ANO) Then
                        StrMsg = db.ErrDesc
                        GoTo errmsg
                    End If


                    rs = db.OpenRemoteSet("Select A1.ANO, A1.PolicyNo, A1.CertificateNo from Acceptance A1 where A1.PANO=" & ANO, adOpenForwardonly)
                    If Not rs.Eof Then
                        StrMsg = "Please Check the Policy Data " & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & " Already Endorsed/Cancelled !"
                        GoTo errmsg
                    End If
                    param(0) = RegNo
                    param(1) = ADate
                    param(2) = PDate
                    param(3) = "T"
                    param(4) = LANO
                    param(5) = ""
                    param(6) = ""
                    param(7) = ""
                    param(8) = False
                    param(9) = RefNo
                    param(10) = ADate
                    param(11) = 4   ' Add/Refund for Re Only
                    param(12) = ""
                    param(13) = False
                    param(14) = "UW"
                    param(15) = ""
                    param(16) = ""
                    NEWANO = Endorsement(ANO, param)
                    If NEWANO = 0 Then GoTo errmsg

                    If Not db.ReleaseLockedObject("Policy" & ANO) Then
                        StrMsg = db.ErrDesc
                        GoTo errmsg
                    End If
                End If
            Else
                NEWANO = ANO
            End If
           

            rsAcc.MoveNext()
        Loop
        rsAcc.CloseRemoteSet()

        EndorseTreaty = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        EndorseTreaty = False
    End Function

    Private Function Change_Accumulation_Register(ByVal ANO As Long, ByVal TOC As String, ByVal FLDID As String, ByVal NewValueID As String) As Boolean
        On Error GoTo errmsg
        Dim rs As RemoteSet

        rs = db.OpenRemoteSet("Select Status from RArrHeader Where ANO=" & ANO)
        If tostr(rs.fields("Status")) = "A" Then
            If Not UnReleaseAccRegAmount(ANO, True) Then GoTo errmsg
        End If
        If Not db.Execute("Update Acceptance Set ValueID='" & NewValueID & "' Where AStatus='W' and ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg
        If Not Update_Accumulation_AInfo(ANO, TOC, FLDID, NewValueID) Then GoTo errmsg
        If Not ReleaseAccRegAmount(ANO, True) Then GoTo errmsg
        Change_Accumulation_Register = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Change_Accumulation_Register = False
    End Function


    ' Return New ANO
    Private Function Endorsement(ByVal ANO As Long, ByVal Param As Object) As String
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim NEWANO As Long
        Dim RegNo As String
        Dim ADate As Date
        Dim PDate As Date
        Dim EMethod As String
        Dim LANO As Long
        Dim Remarks As String
        Dim CPercentage As Double
        Dim Description As String
        Dim EEndorseF As Boolean
        Dim RefNo As String
        Dim RefDate As Date
        Dim Branch As String
        Dim TOC As String
        Dim CT As String
        Dim NoRefundF As Integer
        Dim WordingID As String
        Dim ASource As String
        Dim Reason As String
        Dim CNO As Long
        Dim PolicyType As String
        Dim ISType As String
        Dim rs As RemoteSet
        Dim NewCNO As Long
        Dim OpenFlag As Boolean
        Dim AdjustCoveragePeriodF As Boolean
        Dim AdjustFacultativePeriodF as boolean
        Dim RefundType As String

        On Error GoTo errmsg

        RegNo = tostr(getInParamValue(Param, 0))
        ADate = todate(getInParamValue(Param, 1))
        PDate = todate(getInParamValue(Param, 2))
        EMethod = tostr(getInParamValue(Param, 3))
        LANO = toval(getInParamValue(Param, 4))
        Remarks = tostr(getInParamValue(Param, 5))
        CPercentage = toval(getInParamValue(Param, 6))
        Description = tostr(getInParamValue(Param, 7))
        EEndorseF = toval(getInParamValue(Param, 8))
        RefNo = tostr(getInParamValue(Param, 9))
        RefDate = todate(getInParamValue(Param, 10))
        NoRefundF = toval(getInParamValue(Param, 11))
        WordingID = tostr(getInParamValue(Param, 12))
        ASource = tostr(getInParamValue(Param, 14))
        AdjustCoveragePeriodF = toval(getInParamValue(Param, 15))
        Reason = tostr(getInParamValue(Param, 16))
        AdjustFacultativePeriodF = toval(getInParamValue(Param, 17))
        RefundType = tostr(getInParamValue(Param, 18))

        If LANO <> -1 Then
            rs = db.OpenRemoteSet("Select Cover.CNO, Acceptance.TOC, Cover.OpenFlag, Acceptance.RegNo, Acceptance.Branch, Acceptance.CT, Cover.PolicyType, Cover.ISType from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & LANO)
            ' RegNo Certificate Follows Master
            RegNo = rs.fields("RegNo")
        Else
            rs = db.OpenRemoteSet("Select Cover.CNO, Acceptance.TOC, Cover.OpenFlag, Acceptance.RegNo, Acceptance.Branch, Acceptance.CT, Cover.PolicyType, Cover.ISType from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        End If

        If rs.Eof Then
            StrMsg = "No Policy Data !"
            GoTo errmsg
        End If
        CNO = toval(rs.fields("CNO"))
        TOC = tostr(rs.fields("TOC"))
        PolicyType = tostr(rs.fields("PolicyType"))
        ISType = tostr(rs.fields("ISType"))
        Branch = tostr(rs.fields("Branch"))
        CT = tostr(rs.fields("CT"))
        OpenFlag = toval(rs.fields("OpenFlag"))

        If (ANO = LANO Or LANO = -1) And ASource = "MKT" Then
            rsSrc = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
            rsDst = db.OpenRemoteSet("Select * from Cover Where 1<>1")
            Dim NewCoverNo As String
            NewCoverNo = GetDocumentNumbering("COV", PolicyType, ISType, rsSrc.fields("CoverDate"), Branch, TOC, CT)
            If NewCoverNo = "" Then
                StrMsg = "Generate Cover No./Quotation No. Failed !"
                GoTo errmsg
            End If

            'Copy Cover & Related Information
            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("CoverNo") = NewCoverNo
            rsDst.fields("ASource") = ASource       ' Application Source
            rsDst.fields("CStatus") = "P"           ' Request Status
            rsDst.fields("UserID") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("CTime") = Time()
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("VSeqNo") = toval(rsSrc.fields("VSeqNo")) + 1
            rsDst.fields("ANO") = -1
            rsDst.fields("pCNO") = CNO
            rsDst.fields("FOLLOWUP") = ""

            rsDst.fields("PUserID") = db_user
            rsDst.fields("PUSerDate") = Today.Date
            rsDst.fields("PUserTime") = Time()

            rsDst.fields("CUserID") = ""
            rsDst.fields("CLoseDate") = ""
            rsDst.fields("CLoseTime") = ""
            rsDst.fields("AUserID") = ""
            rsDst.fields("AUSerDate") = ""
            rsDst.fields("AUserTime") = ""
            NewCNO = db.GetIdentity("Cover") + 1
            rsDst.fields("CNO") = NewCNO
            If Not rsDst.Update Then GoTo errmsg
            If Not CopyCover(CNO, NewCNO, rsDst.fields("ISType")) Then GoTo errmsg
            rsSrc.CloseRemoteSet()
            rsDst.CloseRemoteSet()
        Else
            NewCNO = CNO
        End If

        rsSrc = db.OpenQueryDef("QAcceptance", adOpenForwardonly, ANO)
        If Not rsSrc.Eof Then
            If Not (rsSrc.fields("AStatus") = "I") Then
                StrMsg = "Please Check Policy Data Status !"
                GoTo errmsg
            End If

            If Not (rsSrc.fields("AType") = "C" And rsSrc.fields("EMethod") = "A") Then
                ' Check The Effective Date
                If DateDiff(DateInterval.Day, rsSrc.fields("PDate"), PDate) <= 0 Then
                    PDate = todate(rsSrc.fields("PDate"))
                End If

                ' If Earlier Than Inception Date
                If DateDiff(DateInterval.Day, todate(rsSrc.fields("SDate")), PDate) <= 0 Then
                    PDate = todate(rsSrc.fields("SDate"))
                End If

                ' If Greater Than Expiry Date
                If DateDiff(DateInterval.Day, todate(rsSrc.fields("EDate")), PDate) >= 0 Then
                    PDate = todate(rsSrc.fields("EDate"))
                End If
            Else
                ' Endorse over Cancellation All
                If Not AdjustCoveragePeriodF Then
                    rs = db.OpenRemoteSet("Select Top 1 SDate, EDate from acceptance Where OANO=" & rsSrc.fields("OANO") & " and SDate>='" & Format(PDate, "MM/DD/YYYY") & "' Order By SDate")
                    If Not rs.Eof Then
                        ' If Earlier Than Inception Date
                        If DateDiff(DateInterval.Day, todate(rs.fields("SDate")), PDate) <= 0 Then
                            PDate = todate(rs.fields("SDate"))
                        End If

                        ' If Greater Than Expiry Date
                        If DateDiff(DateInterval.Day, todate(rs.fields("EDate")), PDate) >= 0 Then
                            PDate = todate(rs.fields("EDate"))
                        End If
                    End If
                End If
            End If

            rsDst = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            If ASource <> "MKT" Then
                If RegNo = "" Then RegNo = GetDocumentNumbering("REG", PolicyType, ISType, ADate, Branch, TOC, CT)
                If RegNo = "" Then
                    StrMsg = "Generate Register No./Closing Instruction No. Failed !"
                    GoTo errmsg
                End If
                Param(0) = RegNo
            End If
            Dim pStatus As String = IIf(EMethod = "R" Or EMethod = "S", "I", "C")  ' Except for Endorse Reinstatement or Restructuring set to consistent
            rsDst.fields("RegNo") = RegNo
            rsDst.fields("RegDate") = ADate
            rsDst.fields("ADate") = ADate
            rsDst.fields("PDate") = PDate
            rsDst.fields("PPDate") = todate(rsSrc.fields("EDate"))
            rsDst.fields("CNO") = NewCNO
            rsDst.fields("LANO") = LANO
            rsDst.fields("pANO") = ANO      ' Previous ANO
            rsDst.fields("AType") = "E"     ' Endorsement
            rsDst.fields("AStatus") = "W"   ' Waiting
            rsDst.fields("pAStatus") = ""           ' Previous Acceptance Status (AStatus)
            rsDst.fields("EMethod") = EMethod
            rsDst.fields("PStatus") = pStatus
            rsDst.fields("Reason") = Reason
            rsDst.fields("Remarks") = Remarks
            rsDst.fields("Memo") = Description
            rsDst.fields("Comment") = ""
            rsDst.fields("BSyncF") = False
            rsDst.fields("ESeqNo") = toval(rsDst.fields("ESeqNo")) + 1
            rsDst.fields("RefNo") = tostr(RefNo)
            rsDst.fields("RefDate") = todate(RefDate)
            rsDst.fields("UserID") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("CTime") = Time()
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("CPCT") = CPercentage
            rsDst.fields("RefundType") = RefundType
            rsDst.fields("NoRefundF") = NoRefundF
            rsDst.fields("WordingID") = WordingID
            rsDst.fields("BackDatedF") = 0
            rsDst.fields("RequestF") = False
            rsDst.fields("RequestMessage") = ""
            rsDst.fields("RequestName") = ""
            rsDst.fields("CUserID") = ""
            rsDst.fields("CLoseDate") = ""
            rsDst.fields("CloseTime") = ""
            rsDst.fields("RUserID") = ""
            rsDst.fields("RUSerDate") = ""
            rsDst.fields("RUSerTime") = ""
            rsDst.fields("AUserID") = ""
            rsDst.fields("AUSerDate") = ""
            rsDst.fields("AUSerTime") = ""
            If EEndorseF Then
                rsDst.fields("EESeqNo") = toval(rsDst.fields("EESeqNo")) + 1
                rsDst.fields("EEndorseF") = 1
            Else
                rsDst.fields("EEndorseF") = 0
            End If
            If EMethod = "S" Then
                rsDst.fields("ERSeqNo") = toval(rsDst.fields("ERSeqNo")) + 1
            End If
            NEWANO = db.GetIdentity("Acceptance") + 1
            rsDst.fields("SplitDNCNF") = False
            rsDst.fields("ANO") = NEWANO
            rsDst.fields("BatchNo") = ""
            rsDst.fields("BID") = 0
            rsDst.fields("ASource") = ""
            If Not rsDst.Update Then GoTo errmsg

            If pStatus = "I" OrElse EMethod = "T" Then ' Already inconsistent or Endorse Treaty (Following Reinsurance Cession)
                If Not CopyAcceptance(ANO, NEWANO, "E", False, EMethod, AdjustFacultativePeriodF) Then GoTo errmsg
            Else
                If Not CopyAcceptance(ANO, NEWANO, "E", False, EMethod, AdjustFacultativePeriodF, pStatus) Then GoTo errmsg
                If pStatus = "I" Then
                    If Not db.Execute("Update Acceptance Set pStatus='" & pStatus & "' Where ANO=" & NEWANO) Then GoTo errmsg
                End If
            End If

            ' Update Servicing
            rs = db.OpenRemoteSet("Select * from Service Where ANO=-1 and SType='ENDORSEMENT' and SStatus='P' and PANO=" & ANO)
            Do While Not rs.Eof
                rs.Edit()
                rs.fields("ANO") = NEWANO
                rs.fields("CNO") = rsDst.fields("CNO")
                rs.fields("LANO") = LANO
                If Not rs.Update Then GoTo errmsg

                If Not Create_AccDA_from_Service(NEWANO, rs.fields("SNO")) Then GoTo errmsg
                If Not Create_AccCA_from_Service(NEWANO, rs.fields("SNO")) Then GoTo errmsg
                If LANO = -1 Then
                    If Not Create_Payor_from_Service(NEWANO, rs.fields("SNO")) Then GoTo errmsg
                Else
                    If Not Create_APayor_from_Service(NEWANO, rs.fields("SNO")) Then GoTo errmsg
                End If
                rs.MoveNext()
            Loop

            ' Update Parameters from Reason Code
            Dim CompSheetF As Boolean
            Dim FDID As String
            rs = db.OpenRemoteSet("Select CompSheetF, FDID from Reason Where Reason='" & Reason & "'")
            CompSheetF = toval(rs.fields("CompSheetF"))
            FDID = tostr(rs.fields("FDID"))

            If CompSheetF Then
                If Not db.Execute("Update AccCompSheetH Set Status='R' Where ANO=" & rsSrc.fields("OANO")) Then GoTo errmsg
            End If

            If FDID <> "" And (LANO = -1 Or OpenFlag) Then
                rs = db.OpenQueryDef("QFDTAB", adOpenForwardonly, FDID)
                If Not rs.Eof Then
                    Dim rsFD As RemoteSet
                    rsFD = db.OpenRemoteSet("Select * from AccFD Where 1<>1")

                    rsFD.AddNew()
                    rsFD.fields("ANO") = NEWANO
                    rsFD.fields("ID") = "<Payor>"
                    rsFD.fields("FDID") = tostr(rs.fields("FDID"))
                    rsFD.fields("REMARK") = tostr(rs.fields("Description"))
                    rsFD.fields("Currency") = tostr(rs.fields("Currency"))
                    rsFD.fields("PolicyYear") = 0
                    rsFD.fields("Amount") = toval(rs.fields("Amount"))
                    rsFD.fields("LUserID") = db_user
                    rsFD.fields("LDate") = Today.Date
                    rsFD.fields("AutoGeneratedF") = False
                    If Not rsFD.Update Then GoTo errmsg

                    rsFD.CloseRemoteSet()
                End If
            End If

            If Not ReleaseAccRegAmount(NEWANO, True) Then GoTo errmsg
        Else
            GoTo errmsg
        End If

        rsDst.CloseRemoteSet()
        rsSrc.CloseRemoteSet()
        Endorsement = NEWANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Endorsement = 0
    End Function
    Private Function RevisionDetail(ByVal ANO As Long, ByVal NewLANO As Long, ByVal NewCNO As Long, Optional ByVal pStatus As String = "C") As Boolean
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
