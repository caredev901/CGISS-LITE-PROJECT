        End If

        If OCNO = CNO Then
            If Not db.Execute("Update Service Set ANO=-1, LANO=-1, CNO=-1 from Service Where CNO=" & CNO) Then GoTo errmsg
        Else
            If Not UnCloseQuotation(PCNO) Then GoTo errmsg
            rs = db.OpenRemoteSet("Select ANO, LANO from Acceptance Where (ANO=LANO or LANO=-1) and CNO=" & PCNO)
            If Not db.Execute("Update Service Set ANO=" & rs.fields("ANO") & ", LANO=" & rs.fields("LANO") & ", CNO=" & PCNO & " from Service Where CNO=" & CNO) Then GoTo errmsg
        End If
        If Not db.Execute("Update SysRequest Set Status='P',LUserID='" & db_user & "', LUserDate='" & Format(Today.Date, "MM/DD/YYYY") & "',LUserTime='" & Time() & "' from SysRequest Where Status<>'P' and Param1='SEND' and Param2 in ('UND','UND-MW','IT','MAR') and Param3=" & ANO) Then GoTo errmsg

        DropQuotation = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        DropQuotation = False
    End Function
    Private Function DropQuotationMaster(ByVal CNO As Long, ByVal ANO As Long) As Boolean
        Dim rs As RemoteSet
        Dim PANO As Long

        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select PANO from Acceptance Where ANO=LANO and ANO=" & ANO)
        PANO = rs.fields("PANO")

        rs = db.OpenRemoteSet("Select ANO, PANO from Acceptance Where ANO<>LANO and LANO=" & ANO)
        Do While Not rs.Eof
            If Not DropAcceptanceDetail(toval(rs.fields("ANO"))) Then GoTo errmsg
            rs.MoveNext()
        Loop
        If Not DropQuotation(CNO, ANO) Then GoTo errmsg

        If PANO <> -1 Then
            rs = db.OpenRemoteSet("Select Max(CNO) as CNO, Max(CertificateNo) as CertNum from Acceptance Where ANO<>LANO and LANO=" & PANO)
            If Not db.Execute("Update Cover Set CertNum=" & toval(rs.fields("CertNum")) & " Where CNO=" & toval(rs.fields("CNO"))) Then GoTo errmsg
            ' Here
        End If
        DropQuotationMaster = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        DropQuotationMaster = False
    End Function

    Private Function DropMaster(ByVal CNO As Long, ByVal ANO As Long) As Boolean
        Dim rs As RemoteSet
