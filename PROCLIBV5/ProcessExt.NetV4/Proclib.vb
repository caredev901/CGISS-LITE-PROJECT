    Private Function Save_Declaration(ByVal INO As Long, ByVal SDate As Date, ByVal EDate As Date) As Boolean
        Dim i As Long
        Dim j As Long
        Dim rsI As RemoteSet
        Dim rs As RemoteSet
        Dim Amount As Double
        Dim Limit As Double
        Dim ANO As Long
        Dim MaxAmount As Double
        Dim Method As String

        On Error GoTo errmsg

        rs = db.OpenQueryDef("QICover", adOpenForwardonly, INO)
        MaxAmount = toval(rs.fields("Amount"))
        ANO = toval(rs.fields("ANO"))

        rs = db.OpenRemoteSet("Select AdjMethod from TOI Where TOI='" & rs.fields("TOI") & "'")
        Method = tostr(rs.fields("AdjMethod"))

        If Method = "OVERLIMIT" Then
            Limit = MaxAmount
        Else
            Limit = 0
        End If

        Amount = 0
        j = DateDiff(DateInterval.Month, SDate, EDate)
        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Month, j, SDate), EDate) > 0 Then
            j = j + 1
        End If
        For i = 1 To j
            rs = db.OpenQueryDef("QICoverDet", adOpenForwardonly, INO, i)
            If Not rs.Eof Then
                Do While Not rs.Eof
                    If toval(rs.fields("UValue")) > Limit Then
                        Amount = Amount + (toval(rs.fields("UValue")) - Limit) * toval(rs.fields("Qty"))
                    End If
                    rs.MoveNext()
                Loop
            Else
                If Method = "TOTAL" Then
                    Amount = Amount + toval(MaxAmount) / j
                ElseIf Method = "AVERAGE" Then
                    Amount = Amount + toval(MaxAmount)
                Else    ' Overlimit
                    ' Nothing
                End If
            End If
        Next i

        rsI = db.OpenQueryDef("QICover", adOpenKeyset, INO)
        If rsI.Eof Then GoTo errmsg
        rsI.Edit()
        If Method = "TOTAL" Then
            rsI.fields("SI") = Amount
        ElseIf Method = "AVERAGE" Then
            rsI.fields("SI") = Amount / j
        Else    ' OverLimit
            rs = db.OpenQueryDef("QICoverExt", adOpenForwardonly, INO)
            If tostr(rs.fields("FLDTAG1")) = "Maximum Carrying" Then
                rsI.fields("SI") = Limit * toval(rs.fields("FLDVALUE1")) + Amount
            Else
                rsI.fields("SI") = Limit + Amount
            End If
        End If
        If Not rsI.Update Then GoTo errmsg
        'Set acceptance status to inconsistent
        If Not db.Execute("Update Acceptance set PStatus='I' Where ANO=" & ANO) Then GoTo errmsg

        Save_Declaration = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Declaration = False
    End Function
    Private Function CopyInterest(ByVal ANO As Long, ByVal NEWANO As Long, Optional ByVal RenewalF As Boolean = False, Optional ByVal NewPolicyF As Boolean = False, Optional ByVal ApplyDecrSIF As Boolean = False, Optional ByVal ResetTOPRO_F As Boolean = False) As Boolean
        Dim rsSrc1 As RemoteSet
        Dim rsDst1 As RemoteSet
        Dim rsSrc2 As RemoteSet
        Dim rsDst2 As RemoteSet
        Dim NewINO As Long

        ' Copy ICOVER & ICOVERDET & ICALC & IINFO
        rsDst1 = db.OpenRemoteSet("Select * from ICover Where 1<>1")
        rsSrc1 = db.OpenRemoteSet("Select * from ICover Where ANO=" & ANO)
        Do While Not rsSrc1.Eof
            rsDst1.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
            rsDst1.fields("ANO") = NEWANO
            NewINO = db.GetIdentity("ICover") + 1
            rsDst1.fields("INO") = NewINO
            If NewPolicyF Then
                rsDst1.fields("Indemnity") = 0
                rsDst1.fields("Estimate") = 0
            End If
            If RenewalF Then rsDst1.fields("RINO") = NewINO
            If ResetTOPRO_F Then rsDst1.fields("TOPROF") = False
            If ApplyDecrSIF Then
                Dim rs As RemoteSet
                rs = db.OpenRemoteSet("Select min(Case When ICover.NOTDECRF=1 Then 100 else ICalc.PCTLOSS end) as PCTLOSS from ICover, ICalc Where ICover.INO=" & rsSrc1.fields("INO") & " and ICalc.INO=ICover.INO  and ICalc.EDate=(Select Max(I.EDate) from ICalc I Where I.INO=ICover.INO)")
                If Not rs.Eof AndAlso toval(rs.fields("PCTLOSS")) <> 0 AndAlso toval(rs.fields("PCTLOSS")) <> 100 Then
                    If rsDst1.fields("Amount") = rsDst1.fields("Amount_AOE") Then
                        rsDst1.fields("Amount_AOE") = rsDst1.fields("Amount_AOE") * toval(rs.fields("PCTLOSS")) / 100
                    End If
                    If rsDst1.fields("Amount") = rsDst1.fields("SI") Then
                        rsDst1.fields("SI") = rsDst1.fields("SI") * toval(rs.fields("PCTLOSS")) / 100
                    End If
                    If rsDst1.fields("Amount") = rsDst1.fields("TOTAL") Then
                        rsDst1.fields("Total") = rsDst1.fields("Total") * toval(rs.fields("PCTLOSS")) / 100
                    End If
                    rsDst1.fields("Amount") = rsDst1.fields("Amount") * toval(rs.fields("PCTLOSS")) / 100

                    If rsDst1.fields("Currency_OC") <> "" And toval(rsDst1.fields("Rate_OC")) <> 0 Then
                        rsDst1.fields("Amount_OC") = toval(rsDst1.fields("Amount")) / toval(rsDst1.fields("Rate_OC"))
                        rsDst1.fields("Amount_AOE_OC") = toval(rsDst1.fields("Amount_AOE")) / toval(rsDst1.fields("Rate_OC"))
                        rsDst1.fields("SI_OC") = toval(rsDst1.fields("SI")) / toval(rsDst1.fields("Rate_OC"))
                        rsDst1.fields("EML_OC") = toval(rsDst1.fields("EML")) / toval(rsDst1.fields("Rate_OC"))
                    End If
                End If

            End If
            If Not rsDst1.Update Then GoTo errmsg

            rsDst2 = db.OpenRemoteSet("Select * from IINFO Where 1<>1")
            rsSrc2 = db.OpenQueryDef("QIINFO", adOpenForwardonly, toval(rsSrc1.fields("INO")))
            If Not rsSrc2.Eof Then
                rsDst2.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst2.PutRecord(rsSrc2.GetRecord()) Then GoTo errmsg
                rsDst2.fields("INO") = toval(NewINO)
                If Not rsDst2.Update Then GoTo errmsg
            End If
            rsDst2.CloseRemoteSet()
            rsSrc2.CloseRemoteSet()

            If Not RenewalF Then
                rsDst2 = db.OpenRemoteSet("Select * from ICALC Where 1<>1")
                rsSrc2 = db.OpenQueryDef("QICALC", adOpenForwardonly, toval(rsSrc1.fields("INO")))
                Do While Not rsSrc2.Eof
                    rsDst2.AddNew()
                    ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                    If Not rsDst2.PutRecord(rsSrc2.GetRecord()) Then GoTo errmsg
                    rsDst2.fields("ANO") = NEWANO
                    rsDst2.fields("INO") = toval(NewINO)
                    If Not rsDst2.Update Then GoTo errmsg
                    rsSrc2.MoveNext()
                Loop
                rsDst2.CloseRemoteSet()
                rsSrc2.CloseRemoteSet()
            End If

            rsDst2 = db.OpenRemoteSet("Select * from ICOVERDET Where 1<>1")
            rsSrc2 = db.OpenQueryDef("QICOVERDET_1", adOpenForwardonly, toval(rsSrc1.fields("INO")))
            Do While Not rsSrc2.Eof
                rsDst2.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst2.PutRecord(rsSrc2.GetRecord()) Then GoTo errmsg
                rsDst2.fields("ANO") = NEWANO
                rsDst2.fields("INO") = toval(NewINO)
                If Not rsDst2.Update Then GoTo errmsg
                rsSrc2.MoveNext()
            Loop
            rsDst2.CloseRemoteSet()
            rsSrc2.CloseRemoteSet()

            rsDst2 = db.OpenRemoteSet("Select * from ICOVERNOC Where 1<>1")
            rsSrc2 = db.OpenQueryDef("QICOVERNOC_1", adOpenForwardonly, toval(rsSrc1.fields("INO")))
            Do While Not rsSrc2.Eof
                rsDst2.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst2.PutRecord(rsSrc2.GetRecord()) Then GoTo errmsg
                rsDst2.fields("ANO") = NEWANO
                rsDst2.fields("INO") = toval(NewINO)
                If NewPolicyF Then
                    rsDst2.fields("Indemnity") = 0
                    rsDst2.fields("Estimate") = 0
                End If
                If Not rsDst2.Update Then GoTo errmsg
                rsSrc2.MoveNext()
            Loop
            rsDst2.CloseRemoteSet()
            rsSrc2.CloseRemoteSet()

            rsDst2 = db.OpenRemoteSet("Select * from ICoverExt Where 1<>1")
            rsSrc2 = db.OpenQueryDef("QICoverExt", adOpenForwardonly, toval(rsSrc1.fields("INO")))
            Do While Not rsSrc2.Eof
                rsDst2.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst2.PutRecord(rsSrc2.GetRecord()) Then GoTo errmsg
                rsDst2.fields("INO") = toval(NewINO)
                If Not rsDst2.Update Then GoTo errmsg
                rsSrc2.MoveNext()
            Loop
            rsDst2.CloseRemoteSet()
            rsSrc2.CloseRemoteSet()

            rsDst2 = db.OpenRemoteSet("Select * from AccInvoice Where 1<>1")
            rsSrc2 = db.OpenQueryDef("QAccInvoice", adOpenForwardonly, toval(rsSrc1.fields("INO")))
            Do While Not rsSrc2.Eof
                rsDst2.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst2.PutRecord(rsSrc2.GetRecord()) Then GoTo errmsg
                rsDst2.fields("ANO") = NEWANO
                rsDst2.fields("INO") = toval(NewINO)
                If Not rsDst2.Update Then GoTo errmsg
                rsSrc2.MoveNext()
            Loop
            rsDst2.CloseRemoteSet()
            rsSrc2.CloseRemoteSet()

            rsSrc1.MoveNext()
        Loop
        rsDst1.CloseRemoteSet()
        rsSrc1.CloseRemoteSet()

        CopyInterest = True

        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyInterest = False
    End Function

    Private Function CopyAccDetail(ByVal TName As String, ByVal ANO As Long, ByVal NEWANO As Long, Optional ByVal TNameNew As String = "") As Boolean
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet

        rsDst = db.OpenRemoteSet("Select * from " & TName & " T Where 1<>1")
        If TNameNew = "" Then
            rsSrc = db.OpenRemoteSet("Select * from " & TName & " T Where ANO=" & ANO, adOpenForwardonly)
        Else
            rsSrc = db.OpenRemoteSet("Select * from " & TNameNew & " T Where ANO=" & ANO, adOpenForwardonly)
        End If
        Do While Not rsSrc.Eof
            rsDst.AddNew()
            If TNameNew = "" Then
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            Else
                db.backup_record(rsSrc, rsDst)
            End If
            rsDst.fields("ANO") = NEWANO
            If Not rsDst.UpdateRow Then GoTo errmsg
            rsSrc.MoveNext()
        Loop
        If Not rsDst.Eof Then
            If Not rsDst.Update Then GoTo errmsg
        End If
        rsDst.CloseRemoteSet()
        rsSrc.CloseRemoteSet()
        CopyAccDetail = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyAccDetail = False
    End Function

    Private Function CopyAcceptance(ByVal ANO As Long, ByVal NEWANO As Long, ByVal AType As String, ByVal MasterF As Boolean, Optional ByVal EMethod As String = "", Optional ByVal AdjustFacultativePeriodF As Boolean = False, Optional ByRef pStatus As String = "C") As Boolean

        If Not CopyInterest(ANO, NEWANO) Then GoTo errmsg

        If Not CopyAccDetail("RCover", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("RCoverDet", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("AccDed", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("AccDA", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("AccCA", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("RArrHeader", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("RArrDet", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("FPart", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("FPartDet", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("FSecurity", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("FDeductible", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("FacCLA", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("FacCON", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("FacEX", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("FInfo", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("PCalc", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("BusinessResult", ANO, NEWANO) Then GoTo errmsg

        If Not CopyAccDetail("RCalc", ANO, NEWANO) Then GoTo errmsg
        If AType <> "C" Then
            If Not db.Execute("Update RCalc Set SANO=ANO Where ANO=" & NEWANO) Then GoTo errmsg
            If Not db.Execute("Update ICalc Set SANO=ANO Where ANO=" & NEWANO) Then GoTo errmsg
        End If

        If Not CopyAccDetail("AccSection", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("AInfo", ANO, NEWANO) Then GoTo errmsg

        If Not CopyAccDetail("AccCla", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("AccCon", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("AccEx", ANO, NEWANO) Then GoTo errmsg
        If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & NEWANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

        If Not CopyAccDetail("AccBS", ANO, NEWANO, "(Select ANO,ID,BSTYPE,Fee,FeeAmount,FeeRate,Discount,NetF,NetGroupF,MemberF,GrossF,MemberFeeF,PreferredF,NotMinimumPremiumF,GrossUpF,CommPoolF,UpFee,UpFeeAmount,UpFeeRate,LUserID,LDate,NetFee,NetUpF,TreatyOverridingF,CommAfterMinPremiumF,NoRefundF,BSID,GrossBLF,AgentType,NoProrataF,UseCurrTypeF, BSType as OBSType, Installment, PICName, PICPhone, PICMobile, PICEmail from ACCBS Where ANO=" & ANO & ")") Then GoTo errmsg

        If Not CopyAccDetail("AAccBS", ANO, NEWANO, "(Select ANO,ID,BSTYPE,Fee,FeeAmount,FeeRate,Discount,NetF,NetGroupF,MemberF,GrossF,MemberFeeF,PreferredF,NotMinimumPremiumF,GrossUpF,CommPoolF,UpFee,UpFeeAmount,UpFeeRate,LUserID,LDate,NetFee,NetUpF,TreatyOverridingF,CommAfterMinPremiumF,NoRefundF,BSID,GrossBLF,AgentType,NoProrataF,UseCurrTypeF, BSType as OBSType, Installment, PICName, PICPhone, PICMobile, PICEmail from AAccBS Where ANO=" & ANO & ")") Then GoTo errmsg

        If Not CopyAccDetail("AccSearch", ANO, NEWANO) Then GoTo errmsg
        If Not CopyAccDetail("Payor", ANO, NEWANO) Then GoTo errmsg

        If Not CopyAccDetail("APayor", ANO, NEWANO) Then GoTo errmsg


        If AType = "N" Then
            If Not CopyAccDetail("ACCCOMPSHEETH", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("ACCCOMPSHEETD", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("ACCPIC", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("ACCDOCLIST", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("ACCDOCLISTPIC", ANO, NEWANO) Then GoTo errmsg
            If EMethod = "Q" Then   ' Quotation

                If Not CopyAccDetail("ACCFD", ANO, NEWANO) Then GoTo errmsg

            End If
        End If

        If AType <> "A" Then
            If EMethod <> "Q" Then
                If Not db.Execute("Update RArrHeader Set Status='R', HoldF=0, Message='' Where Status='A' and ANO=" & NEWANO) Then GoTo errmsg
            End If
            If AType <> "N" Then
                If Not db.Execute("Update RArrDet set Status='R', ESeqNo=ESeqNo+1, AType='" & AType & "' Where Status='A' and ANO=" & NEWANO) Then GoTo errmsg
            End If
        ElseIf AType = "A" Then
            ' Only Set Sequence and Type
            If Not db.Execute("Update RArrDet set ESeqNo=ESeqNo+1, AType='" & AType & "' Where Status='A' and ANO=" & NEWANO) Then GoTo errmsg
        End If

        If AType = "E" And Not MasterF Then
            Dim rs As RemoteSet

            ' Adjust Treaty Period
            Dim SDate As Date
            Dim PDate As Date
            Dim EDate As Date
            Dim AnnualTreatyF As Boolean
            Dim M_SDate As Date
            Dim M_PDate As Date
            Dim M_EDate As Date
            Dim OpenFlag As Boolean
            Dim TPrecedeFacCessionF As Boolean
            Dim LANO As Long

            rs = db.OpenRemoteSet("Select A.LANO, A.CNO, A.SDate, A.PDate, A.EDate, A.AnnualTreatyF, C.OpenFlag, mA.SDate as M_SDate, mA.PDate as M_PDate, mA.EDate as M_EDate, TOC.PrecedeFacCessionF from Acceptance A Inner Join TOC on (TOC.TOC=A.TOC) Inner Join Cover C on (C.CNO=A.CNO) Left Join Acceptance mA on (mA.ANO=A.LANO) Where A.ANO=" & NEWANO, adOpenForwardonly)
            SDate = rs.fields("SDate")
            PDate = rs.fields("PDate")
            EDate = rs.fields("EDate")
            M_SDate = todate(rs.fields("M_SDate"))
            M_PDate = todate(rs.fields("M_PDate"))
            M_EDate = todate(rs.fields("M_EDate"))
            LANO = rs.fields("LANO")
            OpenFlag = toval(rs.fields("OpenFlag"))
            AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))
            TPrecedeFacCessionF = toval(rs.fields("PrecedeFacCessionF"))

            rs = db.OpenRemoteSet("Select * from RArrHeader Where ANO=" & NEWANO)
            Dim RDATE As Date
            Dim NRDATE As Date
            Dim PolicyTreatyF As Boolean
            RDATE = todate(rs.fields("RDate"))
            NRDATE = todate(rs.fields("NRDate"))
            PolicyTreatyF = toval(rs.fields("PolicyTreatyF"))

            If AnnualTreatyF Then
                If LANO = -1 Or (OpenFlag And Not PolicyTreatyF) Then
                    ' Check for Leap Year
                    If Month(DateSerial(Year(PDate), Month(SDate), Day(SDate))) <> Month(SDate) Then
                        RDATE = DateAdd(DateInterval.Day, -1, DateSerial(Year(PDate), Month(SDate), Day(SDate)))
                    Else
                        RDATE = DateSerial(Year(PDate), Month(SDate), Day(SDate))
                    End If
                    If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)
                    If DateDiff(DateInterval.Day, PDate, RDATE) < 0 Then RDATE = DateAdd(DateInterval.Month, 12, RDATE)
                    If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)

                    If DateDiff(DateInterval.Day, SDate, RDATE) < 0 Then RDATE = SDate
                    NRDATE = DateAdd(DateInterval.Month, 12, RDATE)
                    If DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
                Else
                    ' Check for Leap Year
                    If Month(DateSerial(Year(PDate), Month(M_SDate), Day(M_SDate))) <> Month(M_SDate) Then
                        RDATE = DateAdd(DateInterval.Day, -1, DateSerial(Year(PDate), Month(M_SDate), Day(M_SDate)))
                    Else
                        RDATE = DateSerial(Year(PDate), Month(M_SDate), Day(M_SDate))
                    End If
                    If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)
                    If DateDiff(DateInterval.Day, PDate, RDATE) < 0 Then RDATE = DateAdd(DateInterval.Month, 12, RDATE)
                    If DateDiff(DateInterval.Day, PDate, RDATE) > 0 Then RDATE = DateAdd(DateInterval.Month, -12, RDATE)

                    If DateDiff(DateInterval.Day, M_SDate, RDATE) < 0 Then RDATE = M_SDate
                    NRDATE = DateAdd(DateInterval.Month, 12, RDATE)
                    If DateDiff(DateInterval.Day, M_EDate, NRDATE) > 0 Then NRDATE = M_EDate
                End If
            Else
                If LANO = -1 Or (OpenFlag And Not PolicyTreatyF) Then
                    If DateDiff(DateInterval.Day, SDate, RDATE) < 0 Then RDATE = SDate
                    If DateDiff(DateInterval.Day, EDate, RDATE) > 0 Then RDATE = EDate

                    If DateDiff(DateInterval.Day, SDate, NRDATE) < 0 Then NRDATE = SDate
                    If DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
                    If DateDiff(DateInterval.Day, RDATE, NRDATE) <= 0 Then
                        RDATE = SDate
                        NRDATE = EDate
                    End If
                Else
                    If DateDiff(DateInterval.Day, M_SDate, RDATE) < 0 Then RDATE = M_SDate
                    If DateDiff(DateInterval.Day, M_EDate, RDATE) > 0 Then RDATE = M_EDate

                    If DateDiff(DateInterval.Day, SDate, NRDATE) < 0 Then NRDATE = SDate
                    If DateDiff(DateInterval.Day, EDate, NRDATE) > 0 Then NRDATE = EDate
                    If DateDiff(DateInterval.Day, RDATE, NRDATE) <= 0 Then
                        RDATE = SDate
                        NRDATE = EDate
                    End If

                End If
            End If

            rs.Edit()
            rs.fields("LDate") = Today.Date
            rs.fields("LUserID") = db_user

            If AType = "N" Then
                rs.fields("PDate") = RDATE
                rs.fields("PPDate") = NRDATE
            Else
                ' Clean Cut
                If Not (DateDiff(DateInterval.Day, rs.fields("PDate"), rs.fields("RDate")) = 0 And DateDiff(DateInterval.Day, rs.fields("PPDate"), rs.fields("NRDate")) = 0) Then

                    If EMethod = "T" Then
                        RDATE = rs.fields("PPDate")
                    End If

                    If LANO = -1 Or (OpenFlag And Not PolicyTreatyF) Then
                        If DateDiff(DateInterval.Day, rs.fields("PPDate"), PDate) >= 0 Then
                            RDATE = rs.fields("PPDate")
                        End If
                    Else
                        If DateDiff(DateInterval.Day, rs.fields("PPDate"), M_PDate) >= 0 Then
                            RDATE = rs.fields("PPDate")
                        End If
                    End If

                    If DateDiff(DateInterval.Day, RDATE, rs.fields("PDate")) >= 0 Then
                        RDATE = rs.fields("PDate")
                    End If
                Else
                    rs.fields("PDate") = RDATE
                    rs.fields("PPDate") = NRDATE
                End If
            End If
            rs.fields("NCDate") = RDATE
            If rs.fields("RDate") <> RDATE OrElse rs.fields("NRDate") <> NRDATE Then
                pStatus = "I"
            End If
            rs.fields("RDate") = RDATE
            rs.fields("NRDate") = NRDATE
            If Not rs.Update Then GoTo errmsg

            rs = db.OpenQueryDef("QFacOut", adOpenForwardonly, NEWANO)
            If Not rs.Eof Then
                Dim FORCEUNCONFIRMFACULTATIVE As Boolean = db.GetPrivileges("FORCEUNCONFIRMFACULTATIVE")
                ' Un-Confirmed The Facultative Placement
                Do While Not rs.Eof
                    Dim PrecedeFacCessionF As Boolean = toval(rs.fields("PrecedeFacCessionF")) Or TPrecedeFacCessionF
                    If tostr(rs.fields("Status")) = "R" AndAlso ((EMethod <> "T" And ((FORCEUNCONFIRMFACULTATIVE And db.GetUserType <> "SUPERVISOR") Or (Not AdjustFacultativePeriodF And Not PrecedeFacCessionF))) Or DateDiff(DateInterval.Day, rs.fields("EDate"), PDate) >= 0) Then
                        If Not UnConfirmed_Facultative(NEWANO, tostr(rs.fields("FID"))) Then GoTo errmsg
                    End If
                    rs.MoveNext()
                Loop
            End If
            rs.CloseRemoteSet()
        End If

        If AType <> "A" Then
            If Not db.Execute("Update Acceptance Set CANO=" & NEWANO & ",ConjunctionF=1 Where CANO=" & ANO) Then GoTo errmsg
        End If

        CopyAcceptance = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyAcceptance = False
    End Function
    Private Function Confirmed_Facultative(ByVal ANO As Long, ByVal FID As String) As Boolean
        Try

            Dim rs As RemoteSet
            Dim LANO As Long
            Dim SDate As Date
            Dim EDate As Date

            Dim FullCoverF As Boolean
            Dim Share As Double
            Dim Amount As Double
            Dim OurShare As Double
            Dim rsArr As RemoteSet
            Dim rsFac As RemoteSet
            Dim ErrMsg As String = ""

            rs = db.OpenRemoteSet("Select LANO, AStatus, SDate, EDate from Acceptance Where ANO=" & ANO)
            If rs.fields("AStatus") <> "W" Then
                ErrMsg = "Please Check Policy Data Status !"
                Throw New Exception(Errmsg)
            End If

            LANO = toval(rs.fields("LANO"))
            SDate = todate(rs.fields("SDate"))
            EDate = todate(rs.fields("EDate"))

            Dim SQL As String
            SQL = "Select FPart.ANO, FPart.FID, cast(coalesce(Max(Cast(LOB.SecuritiesF as Int)),0) as Bit) as SecuritiesF, coalesce(sum(FSecurity.Share),100) as TShare,sum(Case When coalesce(FSecurity.ANO,0)<>0 Then 1 else 0 end) as NumSecurities"
            SQL = SQL & " from FPart Left Join Profile on (Profile.ID=FPart.ID) Left Join LOB on (LOB.LOB=Profile.LOB) Left Join FSecurity on (FSecurity.ANO=FPart.ANO and FSecurity.FID=FPart.FID)"
            SQL = SQL & " Where FPart.ANO=" & ANO & " and FPart.FID='" & FID & "'"
            SQL = SQL & " Group By FPart.ANO, FPart.FID"
            rs = db.OpenRemoteSet(SQL)

            If toval(rs.fields("SecuritiesF")) AndAlso toval(rs.fields("NumSecurities")) = 0 Then
                ErrMsg = "Please Check Facultative Security !"
                Throw New Exception(ErrMsg)
            ElseIf toval(rs.fields("TShare")) <> 100 Then
                ErrMsg = "Please Check Total Security's Share (Should be 100%) !"
                Throw New Exception(ErrMsg)
            End If

            If ANO <> LANO Then
                rsArr = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
                If rsArr.Eof Then
                    ErrMsg = "Please Check Risk Arrangement Data !"
                    Throw New Exception(ErrMsg)
                End If
                OurShare = toval(rsArr.fields("TAmount"))
            Else
                OurShare = 0
            End If

            rsFac = db.OpenRemoteSet("Select * From RArrDet Where ANO=" & ANO & " and FID='" & FID & "'")
            If rsFac.Eof Then
                ErrMsg = "No Facultative Data !"
                Throw New Exception(ErrMsg)
            End If
            If rsFac.fields("Status") <> "O" And rsFac.fields("AType") <> "C" Then
                ErrMsg = "Facultative Already Processed !"
                Throw New Exception(ErrMsg)
            End If
            If DateDiff(DateInterval.Day, rsFac.fields("SDate"), SDate) > 0 Or DateDiff(DateInterval.Day, rsFac.fields("EDate"), EDate) < 0 Then
                ErrMsg = "Facultative Period Must Within Insurance Period !"
                Throw New Exception(ErrMsg)
            End If

            Dim CurrencyL As String
            Dim RateL As Double
            CurrencyL = rsFac.fields("CurrencyL")

            rs = db.OpenRemoteSet("Select SysTab.Currency, PCalc.Rate from SysTab Left join PCalc on (PCalc.ANO=" & ANO & " and PCalc.Currency='" & CurrencyL & "')")
            If CurrencyL = "" Then CurrencyL = rs.fields("Currency")
            RateL = toval(rs.fields("Rate"))
            If RateL = 0 Then RateL = 1

            Share = toval(rsFac.fields("Share")) - toval(rsFac.fields("JPShare"))
            FullCoverF = rsFac.fields("FullCoverF")
            If toval(rsFac.fields("Limit")) <> 0 Then
                Amount = Share / 100 * toval(rsFac.fields("Limit"))
            ElseIf OurShare <> 0 Then
                Amount = Share / 100 * (OurShare / RateL)
            Else
                Amount = toval(rsFac.fields("Amount"))
            End If
            rsFac.Edit()
            rsFac.fields("Status") = "R"
            rsFac.fields("CurrencyL") = CurrencyL
            rsFac.fields("RateL") = RateL
            rsFac.fields("Amount") = Amount
            rsFac.fields("AUserID") = db_user
            rsFac.fields("AUserDate") = Today.Date
            If Not rsFac.Update Then Throw New Exception(db.ErrDesc)

            Dim FShare As Double
            If toval(rsFac.fields("Limit")) <> 0 And OurShare <> 0 Then
                FShare = (toval(rsFac.fields("Limit"))) / (OurShare / RateL) * 100 * Share / 100
            Else
                FShare = Share
            End If

            Dim RShare As Double = 0
            rsFac = db.OpenRemoteSet("Select * from FPart Where ANO=" & ANO & " and FID='" & FID & "'")
            Do While Not rsFac.Eof
                If tostr(rsFac.fields("Code")) <> "" And tostr(rsFac.fields("Comm")) = 0 And tostr(rsFac.fields("NetRate")) = 0 Then
                    rsFac.Edit()
                    rsFac.fields("NetRate") = Get_RateCon(ANO, rsFac.fields("Code"), Amount, rsFac.fields("Unit"))
                    If rsFac.fields("Unit") = "" Then rsFac.fields("Unit") = "C"
                    If Not rsFac.Update Then Throw New Exception(db.ErrDesc)
                End If
                RShare = RShare + rsFac.fields("Share")
                rsFac.MoveNext()
            Loop

            FShare = FShare * RShare / 100

            If Not FullCoverF Then
                rsFac = db.OpenRemoteSet("Select * from FPartDet Where ANO=" & ANO & " and FID='" & FID & "'")
                Do While Not rsFac.Eof
                    If tostr(rsFac.fields("Code")) <> "" And tostr(rsFac.fields("Comm")) = 0 And tostr(rsFac.fields("NetRate")) = 0 Then
                        rsFac.Edit()
                        rsFac.fields("NetRate") = Get_RateCon(ANO, rsFac.fields("Code"), Amount, rsFac.fields("Unit"))
                        If rsFac.fields("Unit") = "" Then rsFac.fields("Unit") = "C"
                        If Not rsFac.Update Then Throw New Exception(db.ErrDesc)
                    End If
                    rsFac.MoveNext()
                Loop
                FullCoverF = Check_Facultative_Main_Coverage(ANO, FID)
            End If

            If FullCoverF AndAlso ANO <> LANO Then
                If Round(FShare, 13, MidpointRounding.AwayFromZero) - Round((100 - toval(rsArr.fields("MShare")) - toval(rsArr.fields("FShare"))), 13, MidpointRounding.AwayFromZero) > 0 Then
                    ErrMsg = "Facultative Placement exceeds sum insured amount !"
                    Throw New Exception(ErrMsg)
                End If

                rsArr.Edit()
                rsArr.fields("FShare") = toval(rsArr.fields("FShare")) + FShare
                rsArr.fields("FAmount") = Decimal.Add(toval(rsArr.fields("FAmount")), FShare * OurShare / 100)
                rsArr.fields("Retention") = toval(rsArr.fields("Retention")) - FShare
                rsArr.fields("RAmount") = Decimal.Add(toval(rsArr.fields("RAmount")), -FShare * OurShare / 100)
                If Not rsArr.Update Then Throw New Exception(db.ErrDesc)
            End If

            ' Update Security Amount if Limit=0
            Dim rsSec As RemoteSet
            rsSec = db.OpenRemoteSet("Select ANO, FID, ID, Share, Amount from FSecurity Where Limit=0 and ANO=" & ANO & " and FID='" & FID & "'")
            Do While Not rsSec.Eof
                rsSec.Edit()
                rsSec.fields("Amount") = Amount * toval(rsSec.fields("Share")) / 100
                If Not rsSec.Update Then Throw New Exception(rsSec.ErrDesc)
                rsSec.MoveNext()
            Loop

            If Not db.Execute("Update Acceptance Set AStatus='W', LDate='" & Format(Today.Date, "MM/DD/YYYY") & "', LTime='" & Time() & "' Where AStatus='W' and ANO=" & ANO) Then Throw New Exception(db.ErrDesc)
            If db.RecordsAffected = 0 Then
                ErrMsg = "Policy Already Processed !"
                Throw New Exception(ErrMsg)
            End If

            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function UnConfirmed_Facultative(ByVal ANO As Long, ByVal FID As String) As Boolean
        Try
            Dim FullCoverF As Boolean
            Dim Share As Double
            Dim Amount As Double
            Dim OurShare As Double
            Dim rsArr As RemoteSet
            Dim rsFac As RemoteSet
            Dim rs As RemoteSet
            Dim ErrMsg As String = ""

            rs = db.OpenRemoteSet("Select LANO, AStatus from Acceptance Where ANO=" & ANO)
            If rs.fields("AStatus") <> "W" Then
                ErrMsg = "Please Check Policy Data Status !"
                Throw New Exception(ErrMsg)
            End If

            Dim LANO As Long = toval(rs.fields("LANO"))
            If ANO <> LANO Then
                rsArr = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
                If rsArr.Eof Then
                    ErrMsg = "Please Check Risk Arrangement Data !"
                    Throw New Exception(ErrMsg)
                End If
                OurShare = toval(rsArr.fields("TAmount"))
            Else
                OurShare = 0
            End If

            rsFac = db.OpenRemoteSet("Select * from RArrDet Where Status='R' and ANO=" & ANO & " and FID='" & FID & "'")
            If rsFac.Eof Then
                ErrMsg = "No Facultative Data !"
                Throw New Exception(ErrMsg)
            End If
            FullCoverF = rsFac.fields("FullCoverF")
            Share = toval(rsFac.fields("Share")) - toval(rsFac.fields("JPShare"))
            Amount = rsFac.fields("Amount")
            rsFac.Edit()
            rsFac.fields("Status") = "O"
            rsFac.fields("AUserID") = ""
            rsFac.fields("AUserDate") = Today.Date
            If Not rsFac.Update Then Throw New Exception(rsFac.ErrDesc)

            Dim RateL As Double = toval(rsFac.fields("RateL"))

            Dim FShare As Double
            If toval(rsFac.fields("Limit")) <> 0 And OurShare <> 0 Then
                FShare = (toval(rsFac.fields("Limit"))) / (OurShare / RateL) * 100 * Share / 100
            Else
                FShare = Share
            End If

            Dim RShare As Double = 0
            rsFac = db.OpenRemoteSet("Select sum(Share) as RShare from FPart Where ANO=" & ANO & " and FID='" & FID & "'")
            RShare = rsFac.fields("RShare")

            FShare = FShare * RShare / 100

            If Not FullCoverF Then
                FullCoverF = Check_Facultative_Main_Coverage(ANO, FID)
            End If

            If FullCoverF AndAlso ANO <> LANO Then
                rsArr.Edit()
                rsArr.fields("FShare") = rsArr.fields("FShare") - FShare
                rsArr.fields("FAmount") = Decimal.Add(toval(rsArr.fields("FAmount")), -FShare * OurShare / 100)
                rsArr.fields("Retention") = rsArr.fields("Retention") + FShare
                rsArr.fields("RAmount") = Decimal.Add(toval(rsArr.fields("RAmount")), FShare * OurShare / 100)
                If Not rsArr.Update Then Throw New Exception(rsArr.ErrDesc)
            End If

            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function Check_Facultative_Main_Coverage(ByVal ANO As Long, ByVal FID As String) As Boolean
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select RCover.ANO from FPartDet, RCover Where RCover.ANO=FPartDet.ANO and RCover.Code=FPartDet.Code and RCover.Category='M' and FPartDet.ANO=" & ANO & " and FPartDet.FID='" & FID & "'", adOpenForwardonly)
        Check_Facultative_Main_Coverage = (Not rs.Eof())
    End Function
    Private Function GetRenewalConjunction(ByVal CANO As Long, ByRef CPolicyNo As String) As Long
        If CANO <> -1 Then
            Dim rs As RemoteSet
            rs = db.OpenRemoteSet("Select ANO, PolicyNo from Acceptance Where RANO=" & CANO)
            If Not rs.Eof Then
                GetRenewalConjunction = rs.fields("ANO")
                CPolicyNo = rs.fields("PolicyNo")
            Else
                GetRenewalConjunction = CANO
            End If
        Else
            GetRenewalConjunction = CANO
        End If
    End Function
    Private Function GetPremiumRate(ByVal InParam() As Object, ByRef OutParam() As Object, ByRef ErrMsg As String) As Boolean
        Try
            ' Get Input Parameter
            Dim ANO As Long
            Dim Code As String
            Dim Unit As String
            Dim SDate As Date
            Dim PCTLoss As Double

            ANO = getInParamValue(InParam, 0)
            Code = getInParamValue(InParam, 1)
            Unit = getInParamValue(InParam, 2)
            SDate = getInParamValue(InParam, 3)
            PCTLoss = toval(getInParamValue(InParam, 4))
            If PCTLoss = 0 Then PCTLoss = 100

            Dim SQL As String
            Dim SIBasedID As Integer
            Dim SI As Double
            Dim Rate As Double
            Dim Loading As Double
            Dim TExcess As Double
            Dim SRate As Double
            Dim PCALC As String = ""
            Dim RateConF As Boolean = True
            Dim ScalePCT As Double

            Dim rs As RemoteSet
            rs = db.OpenRemoteSet("Select SIBasedID from RateTab Where Code='" & Code & "'")
            SIBasedID = toval(rs.fields("SIBasedID"))

            SQL = "Select I.ANO, I.Currency, Max(A.TOC) as TOC, Max(A.SDate) as PSDate, Max(C.PHolder) as PHolder, sum(I.Amount) as Amount, sum(I.SI) as SI "
            SQL = SQL & " From ICover I, Acceptance A, Cover C"
            SQL = SQL & " Where A.ANO=I.ANO and C.CNO=A.CNO and I.ANO=" & ANO & " and Exists (Select P.TOI from RateCov R, PClass P Where R.Code='" & Code & "' and P.TOR=R.TOR and P.TOI=I.TOI)"
            SQL = SQL & " Group by I.ANO, I.Currency"
            rs = db.OpenRemoteSet(SQL)
            SI = 0
            Do While Not rs.Eof
                If SIBasedID = 0 Then
                    SI = SI + toval(rs.fields("SI")) * PCTLoss / 100 * GetReinsuranceRate(rs.fields("TOC"), rs.fields("Currency"), rs.fields("PSDate"), rs.fields("PHolder"))
                Else
                    SI = SI + toval(rs.fields("Amount")) * PCTLoss / 100 * GetReinsuranceRate(rs.fields("TOC"), rs.fields("Currency"), rs.fields("PSDate"), rs.fields("PHolder"))
                End If
                rs.MoveNext()
            Loop
            Rate = Get_RateCon(ANO, Code, SI, Unit, Loading, TExcess, PCTLoss, PCALC, , , SDate, , SRate, RateConF, ScalePCT)

            If Not RateConF Then
                Throw New Exception("No Rate Condition !")
            End If

            ' Set Output Parameter
            ReDim OutParam(6)
            OutParam(0) = Rate
            OutParam(1) = Loading
            OutParam(2) = PCTLoss
            OutParam(3) = SRate
            OutParam(4) = TExcess
            OutParam(5) = PCALC
            OutParam(6) = ScalePCT
            Return True
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function Renewal(ByVal CNO As Long, ByVal ANO As Long, ByVal Param As Object) As String
        Dim rs As RemoteSet
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim Interval As Integer
        Dim Voyage As Boolean
        Dim NewCNO As Long
        Dim NEWANO As Long
        Dim NEWLANO As Long
        Dim NEWCANO As Long
        Dim NewCoverNo As String
        Dim NewRegNo As String
        Dim NewPolicyNo As String
        Dim NewCoverDate As Date
        Dim NewExpiryDate As Date
        Dim NewRefNo As String
        Dim SType As String
        Dim Remarks As String
        Dim Description As String
        Dim Branch As String
        Dim TOC As String
        Dim CT As String
        Dim ASource As String
        Dim DefaultTCF As Boolean
        Dim ApplyDecrSIF As Boolean
        Dim WithDetailF As Boolean
        Dim Segment As String
        Dim ApplyOriginalFDF As Boolean
        Dim DefaultPeriodTermF As Boolean
        Dim ApplyObjectValuationF As Boolean
        Dim ApplyWOBusinessSourceF As Boolean
        Dim ApplyRateTableF As Boolean
        Dim SkipDetailWithTotalLossF As Boolean
        Dim InforceF As Boolean
        Dim AutoInforceF As Boolean
        Dim AutoPrintF As Boolean
        Dim AutoPrintVersion As String
        Dim BlankCopyOnlyF As Boolean

        On Error GoTo errmsg
        NewCoverNo = tostr(getInParamValue(Param, 0))
        NewRegNo = tostr(getInParamValue(Param, 1))
        NewPolicyNo = tostr(getInParamValue(Param, 2))
        NewCoverDate = todate(getInParamValue(Param, 3))
        NewExpiryDate = todate(getInParamValue(Param, 4))
        SType = tostr(getInParamValue(Param, 5))
        Remarks = tostr(getInParamValue(Param, 6))
        Description = tostr(getInParamValue(Param, 7))
        NewRefNo = tostr(getInParamValue(Param, 9))
        Branch = tostr(getInParamValue(Param, 11))
        TOC = tostr(getInParamValue(Param, 12))
        ASource = tostr(getInParamValue(Param, 13))
        DefaultTCF = toval(getInParamValue(Param, 14))
        ApplyDecrSIF = toval(getInParamValue(Param, 15))
        WithDetailF = toval(getInParamValue(Param, 16))
        ApplyOriginalFDF = toval(getInParamValue(Param, 17))
        DefaultPeriodTermF = toval(getInParamValue(Param, 18))
        ApplyObjectValuationF = toval(getInParamValue(Param, 19))
        InforceF = toval(getInParamValue(Param, 20))
        AutoInforceF = toval(getInParamValue(Param, 21))
        AutoPrintF = toval(getInParamValue(Param, 22))
        AutoPrintVersion = tostr(getInParamValue(Param, 23))
        'CertificateNo = tostr(getInParamValue(Param, 24))
        ApplyWOBusinessSourceF = toval(getInParamValue(Param, 25))
        ApplyRateTableF = toval(getInParamValue(Param, 26))
        SkipDetailWithTotalLossF = toval(getInParamValue(Param, 27))
        BlankCopyOnlyF = toval(getInParamValue(Param, 28))

        Dim PolicyType As String
        Dim ISType As String
        Dim OpenFlag As Boolean
        Dim AID As String
        Dim AName As String
        Dim AStatus As String
        Dim PHolder As String
        Dim Insured As String
        Dim CoverNo As String
        Dim PTerm As Integer
        Dim DtInterval As DateInterval
        Dim MTOC As String

        rs = db.OpenRemoteSet("Select CT, AID, AName, AStatus, TOC from Acceptance Where ANO=" & ANO)
        CT = rs.fields("CT")
        AID = rs.fields("AID")
        AName = rs.fields("AName")
        AStatus = rs.fields("AStatus")
        MTOC = rs.fields("TOC")
        If TOC = "" Then TOC = rs.fields("TOC")
        If Not (AStatus = "I" Or AStatus = "C") Then
            StrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        Dim NoRiskAccumulationF As Boolean
        Dim AnnualTreatyF As Boolean
        Dim Ujroh As Double
        Dim WeightedAvgUjrohF As Boolean
        rs = db.OpenRemoteSet("Select PTerm, NoRiskAccumulationF, AnnualTreatyF, Ujroh, WeightedAvgUjrohF from TOC Where TOC='" & TOC & "'")
        PTerm = rs.fields("PTerm")
        If PTerm = 0 Then PTerm = 12
        NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
        AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))
        Ujroh = toval(rs.fields("Ujroh"))
        WeightedAvgUjrohF = toval(rs.fields("WeightedAvgUjrohF"))

        rsSrc = db.OpenQueryDef("QCover", adOpenForwardonly, CNO)
        PolicyType = rsSrc.fields("PolicyType")
        ISType = rsSrc.fields("ISType")
        Voyage = rsSrc.fields("Voyage")
        CoverNo = rsSrc.fields("CoverNo")
        OpenFlag = rsSrc.fields("OpenFlag")
        PHolder = rsSrc.fields("PHolder")
        Insured = rsSrc.fields("Insured")
        Segment = rsSrc.fields("Segment")

        If OpenFlag = True And SType = "S" Then
            rs = db.OpenRemoteSet("Select P1.PolicyType from PolicyType P1, PTClass P2, TOC Where P1.PolicyType=P2.PolicyType and P1.SType='S' and P2.COB=TOC.COB and (P2.TOC='<All>' or P2.TOC=TOC.TOC) and TOC.TOC='" & TOC & "'")
            PolicyType = tostr(rs.fields("PolicyType"))
            If PolicyType = "" Then
                StrMsg = "Individual Policy Type Not Found for Sub-Class : " & TOC & " !"
                GoTo errmsg
            End If
            OpenFlag = False
            PHolder = AID
            Insured = AName
        End If

        rsDst = db.OpenRemoteSet("Select * from Cover Where 1<>1")
        If Not rsSrc.Eof Then
            NewCoverNo = GetDocumentNumbering("COV", PolicyType, ISType, NewCoverDate, Branch, TOC, CT)
            If NewCoverNo = "" Then
                StrMsg = "Generate Cover No./Quotation No. Failed !"
                GoTo errmsg
            End If

            If Not DefaultPeriodTermF Then
                If Day(rsSrc.fields("CoverDate")) <> Day(NewCoverDate) Then
                    DtInterval = DateInterval.Day
                Else
                    DtInterval = DateInterval.Month
                End If
            Else
                DtInterval = DateInterval.Month
                NewExpiryDate = DateAdd(DtInterval, PTerm, NewCoverDate)
            End If

            'Copy Cover & Related Information
            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("CoverNo") = NewCoverNo
            rsDst.fields("CoverDate") = NewCoverDate
            rsDst.fields("ExpDate") = NewExpiryDate
            rsDst.fields("ASource") = ASource
            rsDst.fields("OpenFlag") = OpenFlag
            rsDst.fields("PolicyType") = PolicyType
            rsDst.fields("PHolder") = PHolder
            rsDst.fields("Insured") = Insured
            If ASource = "UW" Or ASource = "RI" Then
                rsDst.fields("CStatus") = "A"   ' Confirm / Approve Status
            Else
                rsDst.fields("CStatus") = "R"   ' Request Status
                rs.fields("PUserID") = ""
                rs.fields("PUSerDate") = ""
                rs.fields("PUserTime") = ""
                rs.fields("AUserID") = ""
                rs.fields("AUserDate") = ""
                rs.fields("AUserTime") = ""
                rs.fields("CloseDate") = ""
                rs.fields("CUserID") = ""
                rs.fields("CloseTime") = ""
            End If
            rsDst.fields("CloseDate") = todate(rsDst.fields("ExpDate"))
            rsDst.fields("VSeqNo") = 0
            rsDst.fields("UserID") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("CTime") = Time()
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("ANO") = -1
            rsDst.fields("pCNO") = CNO
            rsDst.fields("CertNum") = 0
            rsDst.fields("TOC") = TOC
            rsDst.fields("FollowUp") = ""
            rsDst.fields("Memo") = ""
            rsDst.fields("Comment") = ""
            NewCNO = db.GetIdentity("Cover") + 1
            rsDst.fields("CNO") = NewCNO
            rsDst.fields("OCNO") = NewCNO
            ' Default for Days Basis
            rsDst.fields("Prorata") = Calc_Prorata(PTerm, NewCoverDate, NewExpiryDate)
            If Not rsDst.Update Then GoTo errmsg

            If Not CopyCover(rsSrc.fields("CNO"), NewCNO) Then GoTo errmsg
            rsSrc.CloseRemoteSet()
            rsDst.CloseRemoteSet()
        Else
            GoTo errmsg
        End If

        'Copy Acceptance & Related Information
        rsDst = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
        rsSrc = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
        If Not rsSrc.Eof Then
            Dim CoverDate As Date = rsSrc.fields("SDate")
            Dim ExpiryDate As Date = rsSrc.fields("EDate")

            If ASource = "UW" Or ASource = "RI" Then
                NewRegNo = GetDocumentNumbering("REG", PolicyType, ISType, NewCoverDate, Branch, TOC, CT)
                If NewRegNo = "" Then
                    StrMsg = "Generate Register No./Closing Instruction No. Failed !"
                    GoTo errmsg
                End If
            End If
            Interval = DateDiff(DtInterval, rsSrc.fields("SDate"), NewCoverDate)

            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            If rsDst.fields("RefNo") = CoverNo Then
                NewRefNo = NewCoverNo
                rsDst.fields("RefNo") = NewRefNo
            Else
                If rsDst.fields("RefNo") = "" Then
                    If Not CBool(toval(GetAppSetting("GenerateRefNoF"))) Then
                        NewRefNo = NewCoverNo
                        rsDst.fields("RefNo") = NewRefNo
                    Else
                        NewRefNo = GetDocumentNumbering("REF", PolicyType, ISType, Today.Date, Branch, TOC, CT)
                        rsDst.fields("RefNo") = NewRefNo
                    End If
                Else
                    NewRefNo = rsDst.fields("RefNo")
                End If
            End If
            rsDst.fields("RegNo") = NewRegNo
            rsDst.fields("RegDate") = Today.Date
            rsDst.fields("PolicyNo") = NewPolicyNo
            rsDst.fields("CertificateNo") = ""
            rsDst.fields("ADate") = NewCoverDate
            rsDst.fields("PolicyDate") = NewCoverDate
            rsDst.fields("pDate") = NewCoverDate
            rsDst.fields("SDate") = NewCoverDate
            rsDst.fields("EDate") = NewExpiryDate
            rsDst.fields("NCDate") = NewCoverDate
            rsDst.fields("PPDate") = todate(rsDst.fields("EDate"))
            rsDst.fields("Remarks") = tostr(Remarks)
            rsDst.fields("Memo") = tostr(Description)
            rsDst.fields("Comment") = ""
            rsDst.fields("AType") = "N"
            rsDst.fields("AStatus") = "W"
            rsDst.fields("pAStatus") = ""           ' Previous Acceptance Status (AStatus)
            rsDst.fields("PStatus") = "I"
            rsDst.fields("EMethod") = ""
            rsDst.fields("CNO") = NewCNO
            rsDst.fields("UserID") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("CTime") = Time()
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("PANO") = -1
            rsDst.fields("ESeqNo") = 0
            rsDst.fields("EESeqNo") = 0
            rsDst.fields("ERSeqNo") = 0
            rsDst.fields("CPCT") = 0
            rsDst.fields("RenewableF") = 1
            rsDst.fields("BackDatedF") = 0
            rsDst.fields("RequestF") = False
            rsDst.fields("RequestMessage") = ""
            rsDst.fields("RequestName") = ""
            rsDst.fields("Reason") = ""
            rsDst.fields("Matters") = ""
            rsDst.fields("Notes") = ""
            rsDst.fields("CUserID") = ""
            rsDst.fields("CLoseDate") = ""
            rsDst.fields("CloseTime") = ""
            rsDst.fields("RUserID") = ""
            rsDst.fields("RUSerDate") = ""
            rsDst.fields("RUSerTime") = ""
            rsDst.fields("AUserID") = ""
            rsDst.fields("AUSerDate") = ""
            rsDst.fields("AUSerTime") = ""
            rsDst.fields("Renewal") = toval(rsSrc.fields("Renewal")) + 1
            NEWANO = db.GetIdentity("Acceptance") + 1
            rsDst.fields("SplitDNCNF") = False
            rsDst.fields("ANO") = NEWANO
            rsDst.fields("BatchNo") = ""
            rsDst.fields("BID") = 0
            rsDst.fields("ASource") = ""
            rsDst.fields("OANO") = NEWANO
            rsDst.fields("RANO") = ANO
            Select Case SType
                Case "S"
                    NEWLANO = -1
                Case "M"
                    NEWLANO = NEWANO
                Case "O"
                    ' Scheme Master
                    If toval(rsSrc.fields("ANO")) = toval(rsSrc.fields("LANO")) Then
                        NEWLANO = NEWANO
                    Else    ' Individual Policy
                        NEWLANO = -1
                    End If
            End Select
            Dim NewCPolicyNo As String = rsSrc.fields("CPolicyNo")
            Dim CANO As Long = rsSrc.fields("CANO")
            NEWCANO = GetRenewalConjunction(rsSrc.fields("CANO"), NewCPolicyNo)
            rsDst.fields("CANO") = NEWCANO
            rsDst.fields("SNO") = -1                ' Servicing Reference No
            rsDst.fields("CPolicyNo") = NewCPolicyNo

            rsDst.fields("LANO") = NEWLANO
            rsDst.fields("NoRefundF") = 0
            rsDst.fields("WordingID") = ""
            rsDst.fields("NoRiskAccumulationF") = NoRiskAccumulationF
            rsDst.fields("AnnualTreatyF") = AnnualTreatyF
            rsDst.fields("TOC") = TOC
            rsDst.fields("SecurityNo") = ""
            rsDst.fields("Ujroh") = Ujroh
            rsDst.fields("WeightedAvgUjrohF") = WeightedAvgUjrohF
            rsDst.fields("BVATPCT") = 0
            rsDst.fields("TVATPCT") = 0
            rsDst.fields("COCNO") = ""
            rsDst.fields("SysuserID") = ""
            If Not rsDst.Update Then GoTo errmsg

            'update renewal status of previous acceptance
            rsSrc.Edit()
            rsSrc.fields("RenewableF") = 0
            If Not rsSrc.Update Then GoTo errmsg

            If Not CopyRenewal(ANO, toval(rsSrc.fields("LANO")), NEWANO, NEWLANO, NewCoverDate, TOC, Segment, OpenFlag, DefaultTCF, ApplyDecrSIF, CANO, NEWCANO, ApplyOriginalFDF, ApplyWOBusinessSourceF, BlankCopyOnlyF) Then GoTo errmsg

            ' Adjust Instalment Period
            Dim i As Integer
            rs = db.OpenRemoteSet("Select * from Payor Where ANO=" & NEWANO & " and Installment<>0")
            If Not rs.Eof Then
                rs.Edit()
                For i = 1 To rs.fields("Installment")
                    rs.fields("IDate_" & i) = DateAdd(DtInterval, Interval, rs.fields("IDate_" & i))
                Next
                If Not rs.Update Then GoTo errmsg
            End If

            ' Adjust Instalment Period
            rs = db.OpenRemoteSet("Select * from APayor Where ANO=" & NEWANO & " and Installment<>0")
            If Not rs.Eof Then
                rs.Edit()
                For i = 1 To rs.fields("Installment")
                    rs.fields("IDate_" & i) = DateAdd(DtInterval, Interval, rs.fields("IDate_" & i))
                Next
                If Not rs.Update Then GoTo errmsg
            End If

            ' Adjust Periode
            If Not Adjust_RCover(NEWANO, CoverDate, ExpiryDate, NewCoverDate, NewExpiryDate, Voyage, PTerm, TOC) Then GoTo errmsg
            If Not Adjust_ICover(NEWANO, NewCoverDate, NewExpiryDate) Then GoTo errmsg
            If Not Adjust_Deductible(NEWANO, NewCoverDate, NewExpiryDate) Then GoTo errmsg

            ' Adjust Risk Arrangement

            Dim RDate As Date
            Dim NRDate As Date
            RDate = NewCoverDate
            NRDate = IIf(AnnualTreatyF, DateAdd(DateInterval.Month, 12, NewCoverDate), NewExpiryDate)
            If DateDiff(DateInterval.Day, NewExpiryDate, NRDate) > 0 Then NRDate = NewExpiryDate

            ' Add for Default Risk Arrangement
            If NEWANO <> NEWLANO Then
                rs = db.OpenRemoteSet("Select * from RArrHeader Where ANO=" & NEWANO)
                If Not rs.Eof Then
                    rs.Edit()
                Else
                    rs.AddNew()
                End If
                rs.fields("ANO") = NEWANO
                rs.fields("PDate") = RDate
                rs.fields("PPDate") = NRDate
                rs.fields("LDate") = Today.Date
                rs.fields("LUserID") = db_user
                rs.fields("NCDate") = RDate
                rs.fields("RDate") = RDate
                rs.fields("NRDate") = NRDate
                rs.fields("Status") = "R"
                rs.fields("TreatyF") = True
                rs.fields("HoldF") = False
                rs.fields("Message") = ""
                If Not rs.Update Then GoTo errmsg
            End If

            If Not db.Execute("Delete from RArrDet Where ANO=" & NEWANO & " and Status<>'A'") Then GoTo errmsg
            ' Adjust Facultative
            rs = db.OpenRemoteSet("Select * from RArrDet Where ANO=" & NEWANO)
            Do While Not rs.Eof
                rs.Edit()
                If todate(rs.fields("Sdate")) = todate(rsSrc.fields("SDate")) Then
                    rs.fields("SDate") = NewCoverDate
                Else
                    rs.fields("SDate") = DateAdd(DtInterval, Interval, rs.fields("Sdate"))
                End If
                If todate(rs.fields("EDate")) = todate(rsSrc.fields("EDate")) Then
                    rs.fields("EDate") = NewExpiryDate
                Else
                    rs.fields("EDate") = DateAdd(DtInterval, Interval, rs.fields("Edate"))
                End If
                rs.fields("Status") = "O"
                rs.fields("AType") = "N"
                rs.fields("ESeqNo") = 0
                rs.fields("UserID") = db_user
                rs.fields("CDate") = Today.Date
                rs.fields("LUserID") = db_user
                rs.fields("LDate") = Today.Date
                If Not rs.Update Then GoTo errmsg
                rs.MoveNext()
            Loop

            ' Adjust Faculative Instalment Period
            rs = db.OpenRemoteSet("Select * from FPart Where ANO=" & NEWANO & " and Installment<>0")
            If Not rs.Eof Then
                rs.Edit()
                For i = 1 To rs.fields("Installment")
                    rs.fields("IDate_" & i) = DateAdd(DtInterval, Interval, rs.fields("IDate_" & i))
                Next
                If Not rs.Update Then GoTo errmsg
            End If

            If SType = "M" And WithDetailF Then
                Param(0) = NewCoverNo
                Param(1) = NewRegNo
                Param(2) = NewPolicyNo
                Param(3) = NewCoverDate
                Param(4) = NewExpiryDate
                Param(6) = ""       ' Remarks
                Param(7) = ""       ' Description
                Param(9) = NewRefNo

                Dim SQL As String
                SQL = "Select ANO, TOC from Acceptance Where AStatus in ('I','C') and AType<>'C' and AType<>'A' and RenewableF=1 and ANO<>LANO and LANO=" & ANO & " "
                SQL = SQL & " and Not Exists (Select ANO from Renewal Where Renewal.ANO=Acceptance.ANO and ((Renewal.RenewalF=0 and Renewal.Action=0) or Renewal.Action=3)) "
                If SkipDetailWithTotalLossF Then
                    SQL = SQL & " and Not Exists (Select Top 1 A.OANO from Acceptance A Inner Join Claim C1 on (C1.ANO=A.ANO) Inner Join CLLOSS C2 on (C2.CNO=C1.CNO) Where A.OANO=Acceptance.OANO and C1.CType<>'C' and (C1.CSTATUS IN ('P','T','A') OR C1.PCSTATUS IN ('A')) and not exists (Select pCNO from Claim Where Claim.pCNO=C1.CNO and Claim.CStatus<>'R') and C2.CTLF=1)"
                End If
                SQL = SQL & " Order By CertificateNo "
                rs = db.OpenRemoteSet(SQL)
                Do While Not rs.Eof
                    Param(12) = IIf(UCase(rs.fields("TOC")) = UCase(MTOC), TOC, rs.fields("TOC"))
                    If RenewalDetail(rs.fields("ANO"), NewCNO, NEWANO, Param) = 0 Then GoTo errmsg
                    rs.MoveNext()
                Loop
            End If

            Dim Amount_1 As Double = 0
            ' Object Valuation (Only for Main Interest)
            Dim SI As Double
            rs = db.OpenRemoteSet("Select * from ICover Where Category='M' and ANO=" & NEWANO)
            Do While Not rs.Eof
                SI = rs.fields("SI")
                If ApplyObjectValuationF Then
                    If Not Get_Object_Valuation(rs.fields("INO"), SI, NewCoverDate) Then GoTo errmsg
                    rs.Edit()
                    rs.fields("Amount") = SI
                    rs.fields("SI") = SI
                    rs.fields("Amount_AOE") = SI

                    If rs.fields("Currency_OC") <> "" And toval(rs.fields("Rate_OC")) <> 0 Then
                        rs.fields("Amount_OC") = toval(rs.fields("Amount")) / toval(rs.fields("Rate_OC"))
                        rs.fields("Amount_AOE_OC") = toval(rs.fields("Amount_AOE")) / toval(rs.fields("Rate_OC"))
                        rs.fields("SI_OC") = toval(rs.fields("SI")) / toval(rs.fields("Rate_OC"))
                        rs.fields("EML_OC") = toval(rs.fields("EML")) / toval(rs.fields("Rate_OC"))
                    End If
                    If Not rs.Update Then GoTo errmsg
                End If
                Amount_1 = Amount_1 + SI
                rs.MoveNext()
            Loop

            ' Apply Renewal Right
            rs = db.OpenQueryDef("QRenewalRight", adOpenForwardonly, ANO)
            If Not rs.Eof Then
                If tostr(rs.fields("TOPRO")) <> "" Then
                    Dim tParam(10) As Object

                    tParam(0) = tostr(rs.fields("TOPRO"))
                    tParam(1) = tostr(rs.fields("TOC"))
                    tParam(2) = NEWANO
                    tParam(3) = tostr(rs.fields("Currency"))
                    tParam(4) = Amount_1
                    tParam(5) = toval(rs.fields("ATSI"))
                    tParam(6) = True
                    tParam(7) = True
                    tParam(8) = True
                    tParam(9) = True
                    tParam(10) = 0
                    TOP_Process(tParam, True)
                End If
                If Not Set_Deductible_Loading(NEWANO, toval(rs.fields("DLoading")), toval(rs.fields("Deductible"))) Then GoTo errmsg
                If Not Set_Payor_Discount(NEWANO, toval(rs.fields("Discount")) + toval(rs.fields("Loyalty"))) Then GoTo errmsg
                If Not Set_Risk_Cover(NEWANO, tostr(rs.fields("Code")), toval(rs.fields("Rate")), tostr(rs.fields("UNIT")), toval(rs.fields("Loading")), toval(rs.fields("RDiscount"))) Then GoTo errmsg
            End If
            rs.CloseRemoteSet()

            If SType <> "M" AndAlso ApplyRateTableF Then
                rs = db.OpenRemoteSet("Select * from RCover Where ANO=" & NEWANO)
                Do While Not rs.Eof
                    Dim InParam() As Object = {NEWANO, rs.fields("Code"), rs.fields("Unit"), rs.fields("SDate"), rs.fields("PCTLOSS")}
                    Dim OutParam As Object = Nothing
                    If GetPremiumRate(InParam, OutParam, StrMsg) Then
                        Dim BRate As Double = OutParam(0)
                        Dim Loading As Double = OutParam(1)
                        Dim PCTLOSS As Double = OutParam(2)
                        Dim SRate As Double = OutParam(3)
                        Dim TExcess As Double = OutParam(4)
                        Dim PCALC As String = OutParam(5)
                        Dim PremiumRate As Double = BRate + SRate

                        If PremiumRate <> 0 Then
                            rs.Edit()
                            rs.fields("BRate") = BRate
                            rs.fields("SRate") = SRate
                            rs.fields("Rate") = PremiumRate
                            If PCALC <> "" Then
                                rs.fields("PCALC") = PCALC
                            End If
                            rs.fields("Loading") = Loading
                            rs.fields("TExcess") = TExcess
                            If rs.fields("PCTLOSS") = 100 AndAlso PCTLOSS <> 100 Then
                                rs.fields("PCTLOSS") = PCTLOSS
                            End If
                            If Not rs.Update Then GoTo errmsg
                        End If
                    End If
                    rs.MoveNext()
                Loop
            End If

            If Not db.Execute("Update Renewal Set Status='R', NewANO=" & NEWANO & ", ASource='" & ASource & "' Where ANO=" & ANO) Then GoTo errmsg

            ' Update Servicing
            Dim BSID As String = ""
            Dim MO As String = ""
            rs = db.OpenRemoteSet("Select * from Service Where ANO=-1 and SType='RENEWAL' and SStatus='P' and PANO=" & ANO)
            If Not rs.Eof Then
                Do While Not rs.Eof
                    rs.Edit()
                    rs.fields("ANO") = NEWANO
                    rs.fields("CNO") = NewCNO
                    rs.fields("LANO") = rsDst.fields("LANO")
                    If Not rs.Update Then GoTo errmsg
                    BSID = tostr(rs.fields("BSID"))
                    MO = tostr(rs.fields("MO"))
                    rs.MoveNext()
                Loop
                If MO <> "" Then
                    If Not db.Execute("Update Cover Set MO='" & MO & "' Where CNO=" & NewCNO) Then GoTo errmsg
                End If
                If BSID <> "" Then
                    Dim rsProfile As RemoteSet
                    rsProfile = db.OpenRemoteSet("select Profile.Comm, TaxType.MTaxType, Profile.NetCommF from Profile Left Join TaxType on (TaxType.TaxType=Profile.TaxType) Where ID='" & BSID & "'")

                    If Not db.Execute("Delete from ACCBS Where not (ID='" & BSID & "' and BSType='" & IIf(rsProfile.fields("MTaxType") = "PASAL21", "A", "B") & "') and ANO=" & NEWANO) Then GoTo errmsg
                    rs = db.OpenRemoteSet("Select * from AccBS Where ID='" & BSID & "' and BSType='" & IIf(rsProfile.fields("MTaxType") = "PASAL21", "A", "B") & "' and ANO=" & NEWANO)
                    If rs.Eof Then
                        rs.AddNew()
                        rs.fields("ANO") = NEWANO
                        rs.fields("ID") = BSID
                        rs.fields("Fee") = rsProfile.fields("Comm")
                        rs.fields("NetF") = rsProfile.fields("NetCommF")
                        rs.fields("BSType") = IIf(rsProfile.fields("MTaxType") = "PASAL21", "A", "B")
                        If rs.fields("OBSType") = "" Then rs.fields("OBSType") = rs.fields("BSType")
                        If Not rs.Update Then GoTo errmsg
                    End If
                End If
            End If
        Else
            GoTo errmsg
        End If

        rsSrc.CloseRemoteSet()
        rsDst.CloseRemoteSet()

        ' Premium Calculation 
        If NEWANO <> NEWLANO Then
            Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "Premium_Calc", NEWANO)
        ElseIf SType = "M" And WithDetailF Then
            ' Match previous db.begintrans from Calling Function
            db.Committrans()
            Me.Direct_Call_Ext_Process("Process.NetV3.Proclib", "Premium_Calc_All", NEWANO)
            db.Begintrans()
        End If

        If InforceF Then
            StrMsg = ""
            If PreInforceConditionsOk(NEWANO, Today.Date, "", False, False, False, False, StrMsg) Then
                If NEWLANO = -1 Or OpenFlag Then
                    If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "INFORCE", NEWANO, db_user, False, Today.Date) Then
                        StrMsg = Me.ErrDesc
                    End If
                Else
                    If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "INFORCEMASTER", NEWLANO, db_user, False, Today.Date) Then
                        StrMsg = Me.ErrDesc
                    End If
                End If
            End If

            If StrMsg <> "" Then
                StrMsg = "Can't Inforce : " & StrMsg & vbCrLf
                GoTo errmsg
            End If
        ElseIf AutoInforceF Then
            rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & NewRegNo & "' and CertificateNo=''")

            If rs.Eof Then
                rs.AddNew()
            Else
                rs.Edit()
            End If

            rs.fields("RegNo") = NewRegNo
            rs.fields("CertificateNo") = ""
            rs.fields("BatchNo") = ""
            rs.fields("Status") = "R"
            rs.fields("Last_Opr") = db_user
            rs.fields("Last_Update") = Today.Date
            If Not rs.Update Then
                StrMsg = db.ErrDesc & vbCrLf
                GoTo errmsg
            End If
        End If

        ' Auto Print
        If AutoPrintF Then
            Insert_Policy_Auto_Print(NEWANO, AutoPrintVersion)
        End If

        Renewal = NEWANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Renewal = 0
    End Function
    Private Function Insert_Policy_Auto_Print(ByVal ANO As Long, Optional ByVal Version As String = "") As Boolean
        Try
            Dim rs As RemoteSet
            Dim rsA As RemoteSet
            rsA = db.OpenRemoteSet("Select Top 1 * from APDBucket Where AppID=" & ANO & " and AppType='POLICY' and Status in ('R','P','T')")
            If rsA.Eof Then
                rs = db.OpenRemoteSet("Select * from Get_Policy_APRule(" & ANO & ") R Where R.Version Like '" & Version & "%'")
                Do While Not rs.Eof
                    rsA.AddNew()
                    rsA.fields("AppID") = ANO
                    rsA.fields("AppType") = "POLICY"   ' Policy
                    rsA.fields("RuleID") = rs.fields("RuleID")
                    rsA.fields("Class") = rs.fields("Class")
                    rsA.fields("RepName") = rs.fields("RepName")
                    rsA.fields("ExeName") = rs.fields("ExeName")
                    rsA.fields("Version") = IIf(Version = "", rs.fields("Version"), Version)
                    rsA.fields("eStampDutyF") = toval(rs.fields("ApplyeStampDutyF"))
                    rsA.fields("NeedEmailF") = toval(rs.fields("NeedEmailF"))
                    rsA.fields("NeedPrintF") = toval(rs.fields("NeedPrintF"))
                    rsA.fields("NeedeStampDutyF") = toval(rs.fields("NeedeStampDutyF"))
                    rsA.fields("PrintLogoF") = toval(rs.fields("PrintLogoF"))
                    rsA.fields("EMailTo") = tostr(rs.fields("EMailTo"))
                    rsA.fields("NeedeStampDutyF") = toval(rs.fields("NeedeStampDutyF"))
                    rsA.fields("ShowPremiumCalcF") = toval(rs.fields("ShowPremiumCalcF"))
                    rsA.fields("ShowDiscountF") = toval(rs.fields("ShowDiscountF"))
                    rsA.fields("NeedESignF") = toval(rs.fields("NeedESignF"))
                    rsA.fields("Last_Opr") = db_user
                    rsA.fields("Last_Update") = Today.Date
                    rsA.fields("Status") = "R"
                    If Not rsA.UpdateRow Then Throw New Exception(db.ErrDesc)
                    rs.MoveNext()
                Loop
                If Not rsA.Eof Then
                    If Not rsA.Update Then Throw New Exception(db.ErrDesc)
                End If
                Insert_Policy_Auto_Print = True
            End If
        Catch ex As Exception
            StrMsg = ex.Message
            Insert_Policy_Auto_Print = False
        End Try
    End Function
    Private Function Get_Object_Valuation(ByVal INO As Long, ByRef SI As Double, Optional ByVal VDate As Object = Nothing) As Boolean
        Dim rs As RemoteSet
        Dim Value As Double
        Dim ValuePCT As Double
        On Error GoTo errmsg

        If IsDate(VDate) Then
            rs = db.OpenQueryDef("QObjectValuation", adOpenForwardonly, INO, VDate, SI)
        Else
            rs = db.OpenQueryDef("QObjectValuation", adOpenForwardonly, INO, Today.Date, SI)
        End If
        If toval(rs.fields("SI")) <> 0 Then
            SI = toval(rs.fields("SI"))
        End If
        Get_Object_Valuation = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Get_Object_Valuation = False
    End Function
    Private Function Set_Payor_Discount(ByVal ANO As Long, ByVal Discount As Double) As Boolean
        Dim rs As RemoteSet

        On Error GoTo errmsg
        If Discount <> 0 Then
            rs = db.OpenRemoteSet("Select * from Payor Where ANO=" & ANO)
            Do While Not rs.Eof
                rs.Edit()
                rs.fields("Discount") = Discount
                If Not rs.Update Then GoTo errmsg
                rs.MoveNext()
            Loop
        End If
        Set_Payor_Discount = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Set_Payor_Discount = False
    End Function
    Private Function Create_Payor(ByVal ANO As Long, ByVal ID As String, Optional ByVal WPC As Integer = 0, Optional ByVal Grace As Integer = 0, Optional ByVal OverWriteF As Boolean = True) As Boolean
        Try
            Dim rs As RemoteSet
            Dim rsProfile As RemoteSet

            rsProfile = db.OpenRemoteSet("Select ID, Address_1, Address_2, Address_3, Disc, WPC, Grace from Profile Where ID='" & ID & "'")
            If rsProfile.Eof Then
                Throw New Exception("No Profile Found (" & ID & ") !")
            End If

            rs = db.OpenQueryDef("QPayor", adOpenKeyset, ANO)
            If Not rs.Eof Then
                rs.Edit()
            Else
                rs.AddNew()
                rs.fields("ANO") = ANO
                rs.fields("DefaultPayorF") = True
            End If
            If toval(rs.fields("DefaultPayorF")) Then
                ' Only Apply for new payor or DefaultPayorF=1
                rs.fields("Discount") = toval(rsProfile.fields("Disc"))
                rs.fields("WPC") = IIf(WPC = 0, toval(rsProfile.fields("WPC")), WPC)
                rs.fields("Grace") = IIf(Grace = 0, toval(rsProfile.fields("Grace")), Grace)
                rs.fields("Period") = 1 ' Monthly
            End If

            If rs.editmode = AdEditAdd Or OverWriteF Then
                rs.fields("ID") = tostr(rsProfile.fields("ID"))
                rs.fields("Address_1") = tostr(rsProfile.fields("Address_1"))
                rs.fields("Address_2") = tostr(rsProfile.fields("Address_2"))
                rs.fields("Address_3") = tostr(rsProfile.fields("Address_3"))
            End If
            If Not rs.Update Then Throw New Exception(rs.ErrDesc)
            Create_Payor = True
        Catch ex As Exception
            StrMsg = ex.Message
            Create_Payor = False
        End Try
    End Function

    Private Function Set_Risk_Cover(ByVal ANO As Long, ByVal PCode As String, ByVal PRate As Double, ByVal PUnit As String, ByVal Loading As Double, ByVal RDiscount As Double) As Boolean
        Dim rs As RemoteSet
        On Error GoTo errmsg

        ' Only for Main Rate Coverage (Category='M')
        rs = db.OpenRemoteSet("Select * from RCover Where ANO=" & ANO & " and Category='M'")
        Do While Not rs.Eof
            rs.Edit()
            If Loading <> 0 Then rs.fields("Loading") = Loading
            If PCode <> "" And PCode <> rs.fields("Code") And rs.RecordCount = 1 Then
                Dim rsRateTab As RemoteSet
                rsRateTab = db.OpenRemoteSet("Select Description from RateTab Where Code='" & PCode & "'")
                If Not rsRateTab.Eof Then
                    rs.fields("Code") = PCode
                    rs.fields("Remark") = rsRateTab.fields("Description")
                End If
            End If
            If PRate <> 0 Then rs.fields("Rate") = PRate
            If PUnit <> "" Then rs.fields("Unit") = PUnit
            If RDiscount <> 0 Then
                ' Rate Discount in (%)
                rs.fields("Discount") = RDiscount
                rs.fields("DiscUnit") = "C"
            End If

            If Not rs.Update Then GoTo errmsg
            rs.MoveNext()
        Loop
        Set_Risk_Cover = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Set_Risk_Cover = False
    End Function

    Private Function RenewalDetail(ByVal ANO As Long, ByVal NewCNO As Long, ByVal NewLANO As Long, ByVal Param As Object) As String
        Dim rs As RemoteSet
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim NEWANO As Long
        Dim NEWCANO As Long
        Dim CertNum As Long
        Dim Interval As Integer
        Dim NewCoverNo As String
        Dim NewRegNO As String
        Dim NewPolicyNo As String
        Dim NewCoverDate As Date
        Dim NewExpiryDate As Date
        Dim NewRefNo As String
        Dim SType As String
        Dim Remarks As String
        Dim Description As String
        Dim DtInterval As DateInterval
        Dim TOC As String
        Dim DefaultTCF As Boolean
        Dim ApplyDecrSIF As Boolean
        Dim WithDetailF As Boolean
        Dim Segment As String
        Dim OpenFlag As Boolean
        Dim Voyage As Boolean
        Dim ApplyOriginalFDF As Boolean
        Dim ApplyObjectValuationF As Boolean
        Dim CertificateNo As String
        Dim ApplyWOBusinessSourceF As Boolean
        Dim ApplyRateTableF As Boolean
        Dim BlankCopyOnlyF As Boolean

        On Error GoTo errmsg
        NewCoverNo = tostr(getInParamValue(Param, 0))
        NewRegNO = tostr(getInParamValue(Param, 1))
        NewPolicyNo = tostr(getInParamValue(Param, 2))
        NewCoverDate = todate(getInParamValue(Param, 3))
        NewExpiryDate = todate(getInParamValue(Param, 4))
        SType = tostr(getInParamValue(Param, 5))
        Remarks = tostr(getInParamValue(Param, 6))
        Description = tostr(getInParamValue(Param, 7))
        NewRefNo = tostr(getInParamValue(Param, 9))
        TOC = tostr(getInParamValue(Param, 12))
        DefaultTCF = toval(getInParamValue(Param, 14))
        ApplyDecrSIF = toval(getInParamValue(Param, 15))
        WithDetailF = toval(getInParamValue(Param, 16))
        ApplyOriginalFDF = toval(getInParamValue(Param, 17))
        ApplyObjectValuationF = toval(getInParamValue(Param, 19))
        CertificateNo = tostr(getInParamValue(Param, 24))
        ApplyWOBusinessSourceF = toval(getInParamValue(Param, 25))
        ApplyRateTableF = toval(getInParamValue(Param, 26))
        BlankCopyOnlyF = toval(getInParamValue(Param, 28))

        rsSrc = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
        If TOC = "" Then TOC = rsSrc.fields("TOC")

        Dim PTerm As Integer
        Dim NoRiskAccumulationF As Boolean
        Dim AnnualTreatyF As Boolean
        Dim Ujroh As Double
        Dim WeightedAvgUjrohF As Boolean
        rs = db.OpenRemoteSet("Select PTerm, NoRiskAccumulationF, AnnualTreatyF, Ujroh, WeightedAvgUjrohF from TOC Where TOC='" & TOC & "'")
        PTerm = rs.fields("PTerm")
        If PTerm = 0 Then PTerm = 12
        NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
        AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))
        Ujroh = toval(rs.fields("Ujroh"))
        WeightedAvgUjrohF = toval(rs.fields("WeightedAvgUjrohF"))

        rs = db.OpenRemoteSet("Select Segment, OpenFlag, Voyage from Cover Where CNO=" & NewCNO)
        Segment = rs.fields("Segment")
        OpenFlag = rs.fields("OpenFlag")
        Voyage = rs.fields("Voyage")

        'Copy Acceptance & Related Information
        rsDst = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
        If Not rsSrc.Eof Then
            Dim CoverDate As Date = rsSrc.fields("SDate")
            Dim ExpiryDate As Date = rsSrc.fields("EDate")
            If Not (rsSrc.fields("AStatus") = "I" Or rsSrc.fields("AStatus") = "C") Then
                StrMsg = "Please Check Policy Data Status !"
                GoTo errmsg
            End If

            If Day(NewCoverDate) <> Day(NewExpiryDate) Then
                DtInterval = DateInterval.Day
            Else
                DtInterval = DateInterval.Month
            End If
            Interval = DateDiff(DtInterval, rsSrc.fields("SDate"), NewCoverDate)

            If CertificateNo = "" Then
                'Set Auto Numbering Here
                CertNum = GetCertificateNo(NewCNO, , IIf(WithDetailF, False, True))
                If CertNum = 0 Then
                    StrMsg = "Can't Get Certificate No ! " & StrMsg
                    GoTo errmsg
                End If
                ' Certificate Number
                CertificateNo = GetCertificateNumber(CertNum)
            Else
                If rsSrc.fields("CertificateNo") <> CertificateNo Or Not OpenFlag Then
                    ' Adjust Certificate Numbering
                    CertNum = toval(CertificateNo)
                    If CertNum > 0 Then
                        CertNum = GetCertificateNo(NewCNO, CertNum, IIf(WithDetailF, False, True))
                        If CertNum = 0 Then
                            StrMsg = "Can't Get Certificate No ! " & StrMsg
                            GoTo errmsg
                        End If
                        ' Certificate Number
                        CertificateNo = GetCertificateNumber(CertNum)
                    End If
                End If
            End If

            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("RegNo") = NewRegNO
            rsDst.fields("RegDate") = Today.Date
            rsDst.fields("PolicyNo") = NewPolicyNo
            rsDst.fields("CertificateNo") = CertificateNo
            If NewRefNo <> "" Then
                rsDst.fields("RefNo") = NewRefNo
            End If
            rsDst.fields("Adate") = NewCoverDate
            rsDst.fields("PolicyDate") = NewCoverDate
            rsDst.fields("pDate") = NewCoverDate
            rsDst.fields("SDate") = NewCoverDate
            rsDst.fields("EDate") = NewExpiryDate
            rsDst.fields("NCDate") = NewCoverDate
            rsDst.fields("PPDate") = rsDst.fields("EDate")
            rsDst.fields("Remarks") = tostr(Remarks)
            rsDst.fields("Memo") = tostr(Description)
            rsDst.fields("Comment") = ""
            rsDst.fields("Atype") = "N"
            rsDst.fields("AStatus") = "W"
            rsDst.fields("pAStatus") = ""           ' Previous Acceptance Status (AStatus)
            rsDst.fields("PStatus") = "I"
            rsDst.fields("EMethod") = ""
            rsDst.fields("CNO") = NewCNO
            rsDst.fields("UserID") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("CTime") = Time()
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("PANO") = -1
            rsDst.fields("ESeqNo") = 0
            rsDst.fields("EESeqNo") = 0
            rsDst.fields("ERSeqNo") = 0
            rsDst.fields("CPCT") = 0
            rsDst.fields("LANO") = NewLANO
            rsDst.fields("RenewableF") = 1
            rsDst.fields("BackDatedF") = 0
            rsDst.fields("RequestF") = False
            rsDst.fields("RequestMessage") = ""
            rsDst.fields("RequestName") = ""
            rsDst.fields("Reason") = ""
            rsDst.fields("Matters") = ""
            rsDst.fields("Notes") = ""
            rsDst.fields("CUserID") = ""
            rsDst.fields("CLoseDate") = ""
            rsDst.fields("CloseTime") = ""
            rsDst.fields("RUserID") = ""
            rsDst.fields("RUSerDate") = ""
            rsDst.fields("RUSerTime") = ""
            rsDst.fields("AUserID") = ""
            rsDst.fields("AUSerDate") = ""
            rsDst.fields("AUSerTime") = ""
            rsDst.fields("Renewal") = toval(rsSrc.fields("Renewal")) + 1
            NEWANO = db.GetIdentity("Acceptance") + 1
            rsDst.fields("SplitDNCNF") = False
            rsDst.fields("ANO") = NEWANO
            rsDst.fields("BatchNo") = ""
            rsDst.fields("BID") = 0
            rsDst.fields("ASource") = ""
            rsDst.fields("OANO") = NEWANO
            rsDst.fields("RANO") = ANO

            Dim NewCPolicyNo As String = rsSrc.fields("CPolicyNo")
            Dim CANO As Long = rsSrc.fields("CANO")
            NEWCANO = GetRenewalConjunction(rsSrc.fields("CANO"), NewCPolicyNo)
            rsDst.fields("CANO") = NEWCANO
            rsDst.fields("SNO") = -1                ' Servicing Reference No
            rsDst.fields("CPolicyNo") = NewCPolicyNo

            rsDst.fields("NoRefundF") = 0
            rsDst.fields("WordingID") = ""
            rsDst.fields("NoRiskAccumulationF") = NoRiskAccumulationF
            rsDst.fields("AnnualTreatyF") = AnnualTreatyF
            rsDst.fields("TOC") = TOC
            rsDst.fields("SecurityNo") = ""
            rsDst.fields("Ujroh") = Ujroh
            rsDst.fields("WeightedAvgUjrohF") = WeightedAvgUjrohF
            rsDst.fields("BVATPCT") = 0
            rsDst.fields("TVATPCT") = 0
            rsDst.fields("COCNO") = ""
            rsDst.fields("SysuserID") = ""
            If Not rsDst.Update Then GoTo errmsg

            ' Update renewal status of previous acceptance
            rsSrc.Edit()
            rsSrc.fields("RenewableF") = 0
            If Not rsSrc.Update Then GoTo errmsg

            If Not CopyRenewal(ANO, toval(rsSrc.fields("LANO")), NEWANO, NewLANO, NewCoverDate, TOC, Segment, OpenFlag, DefaultTCF, ApplyDecrSIF, CANO, NEWCANO, ApplyOriginalFDF, ApplyWOBusinessSourceF, BlankCopyOnlyF) Then GoTo errmsg

            ' Adjust Instalment Period
            Dim i As Integer
            rs = db.OpenRemoteSet("Select * from Payor Where ANO=" & NEWANO & " and Installment<>0")
            If Not rs.Eof Then
                rs.Edit()
                For i = 1 To rs.fields("Installment")
                    rs.fields("IDate_" & i) = DateAdd(DtInterval, Interval, rs.fields("IDate_" & i))
                Next
                If Not rs.Update Then GoTo errmsg
            End If

            ' Adjust Instalment Period
            rs = db.OpenRemoteSet("Select * from APayor Where ANO=" & NEWANO & " and Installment<>0")
            If Not rs.Eof Then
                rs.Edit()
                For i = 1 To rs.fields("Installment")
                    rs.fields("IDate_" & i) = DateAdd(DtInterval, Interval, rs.fields("IDate_" & i))
                Next
                If Not rs.Update Then GoTo errmsg
            End If           

            ' Adjust Period
            If Not Adjust_RCover(NEWANO, CoverDate, ExpiryDate, NewCoverDate, NewExpiryDate, Voyage, PTerm, TOC) Then GoTo errmsg
            If Not Adjust_ICover(NEWANO, NewCoverDate, NewExpiryDate) Then GoTo errmsg
            If Not Adjust_Deductible(NEWANO, NewCoverDate, NewExpiryDate) Then GoTo errmsg

            Dim RDate As Date
            Dim NRDate As Date
            RDate = NewCoverDate
            NRDate = IIf(AnnualTreatyF, DateAdd(DateInterval.Month, 12, NewCoverDate), NewExpiryDate)
            If DateDiff(DateInterval.Day, NewExpiryDate, NRDate) > 0 Then NRDate = NewExpiryDate

            ' Add for Default Risk Arrangement
            rs = db.OpenRemoteSet("Select * from RArrHeader Where ANO=" & NEWANO)
            If Not rs.Eof Then
                rs.Edit()
            Else
                rs.AddNew()
            End If
            rs.fields("ANO") = NEWANO
            rs.fields("PDate") = RDate
            rs.fields("PPDate") = NRDate
            rs.fields("LDate") = Today.Date
            rs.fields("LUserID") = db_user
            rs.fields("NCDate") = RDate
            rs.fields("RDate") = RDate
            rs.fields("NRDate") = NRDate
            rs.fields("Status") = "R"
            rs.fields("TreatyF") = True
            rs.fields("HoldF") = False
            rs.fields("Message") = ""
            If Not rs.Update Then GoTo errmsg

            If Not db.Execute("Delete from RArrDet Where ANO=" & NEWANO & " and Status<>'A'") Then GoTo errmsg
            ' Adjust Facultative
            rs = db.OpenRemoteSet("Select * from RArrDet Where ANO=" & NEWANO)
            Do While Not rs.Eof
                rs.Edit()
                If todate(rs.fields("Sdate")) = todate(rsSrc.fields("SDate")) Then
                    rs.fields("SDate") = NewCoverDate
                Else
                    rs.fields("SDate") = DateAdd(DtInterval, Interval, rs.fields("Sdate"))
                End If
                If todate(rs.fields("EDate")) = todate(rsSrc.fields("EDate")) Then
                    rs.fields("EDate") = NewExpiryDate
                Else
                    rs.fields("EDate") = DateAdd(DtInterval, Interval, rs.fields("Edate"))
                End If
                rs.fields("Status") = "O"
                rs.fields("AType") = "N"
                rs.fields("ESeqNo") = 0
                rs.fields("UserID") = db_user
                rs.fields("CDate") = Today.Date
                rs.fields("LUserID") = db_user
                rs.fields("LDate") = Today.Date
                If Not rs.Update Then GoTo errmsg
                rs.MoveNext()
            Loop

            ' Adjust Faculative Instalment Period
            rs = db.OpenRemoteSet("Select * from FPart Where ANO=" & NEWANO & " and Installment<>0")
            If Not rs.Eof Then
                rs.Edit()
                For i = 1 To rs.fields("Installment")
                    rs.fields("IDate_" & i) = DateAdd(DtInterval, Interval, rs.fields("IDate_" & i))
                Next
                If Not rs.Update Then GoTo errmsg
            End If

            Dim Amount_1 As Double = 0
            ' Object Valuation (Only for Main Interest)
            Dim SI As Double
            rs = db.OpenRemoteSet("Select * from ICover Where Category='M' and ANO=" & NEWANO)
            Do While Not rs.Eof
                SI = rs.fields("SI")
                If ApplyObjectValuationF Then
                    If Not Get_Object_Valuation(rs.fields("INO"), SI, NewCoverDate) Then GoTo errmsg
                    rs.Edit()
                    rs.fields("Amount") = SI
                    rs.fields("SI") = SI
                    rs.fields("Amount_AOE") = SI

                    If rs.fields("Currency_OC") <> "" And toval(rs.fields("Rate_OC")) <> 0 Then
                        rs.fields("Amount_OC") = toval(rs.fields("Amount")) / toval(rs.fields("Rate_OC"))
                        rs.fields("Amount_AOE_OC") = toval(rs.fields("Amount_AOE")) / toval(rs.fields("Rate_OC"))
                        rs.fields("SI_OC") = toval(rs.fields("SI")) / toval(rs.fields("Rate_OC"))
                        rs.fields("EML_OC") = toval(rs.fields("EML")) / toval(rs.fields("Rate_OC"))
                    End If

                    If Not rs.Update Then GoTo errmsg
                End If
                Amount_1 = Amount_1 + SI
                rs.MoveNext()
            Loop

            ' Apply Renewal Right
            rs = db.OpenQueryDef("QRenewalRight", adOpenForwardonly, ANO)
            If Not rs.Eof Then
                If tostr(rs.fields("TOPRO")) <> "" Then
                    Dim tParam(10) As Object

                    tParam(0) = tostr(rs.fields("TOPRO"))
                    tParam(1) = tostr(rs.fields("TOC"))
                    tParam(2) = NEWANO
                    tParam(3) = tostr(rs.fields("Currency"))
                    tParam(4) = Amount_1
                    tParam(5) = toval(rs.fields("ATSI"))
                    tParam(6) = True
                    tParam(7) = True
                    tParam(8) = True
                    tParam(9) = True
                    tParam(10) = 0
                    TOP_Process(tParam, True)
                End If
                If Not Set_Deductible_Loading(NEWANO, toval(rs.fields("DLoading")), toval(rs.fields("Deductible"))) Then GoTo errmsg
                If Not Set_Payor_Discount(NEWANO, toval(rs.fields("Discount")) + toval(rs.fields("Loyalty"))) Then GoTo errmsg
                If Not Set_Risk_Cover(NEWANO, tostr(rs.fields("Code")), toval(rs.fields("Rate")), tostr(rs.fields("UNIT")), toval(rs.fields("Loading")), toval(rs.fields("RDiscount"))) Then GoTo errmsg
            End If
            rs.CloseRemoteSet()

            If ApplyRateTableF Then
                rs = db.OpenRemoteSet("Select * from RCover Where ANO=" & NEWANO)
                Do While Not rs.Eof
                    Dim InParam() As Object = {NEWANO, rs.fields("Code"), rs.fields("Unit"), rs.fields("SDate"), rs.fields("PCTLOSS")}
                    Dim OutParam As Object = Nothing
                    If GetPremiumRate(InParam, OutParam, StrMsg) Then
                        Dim BRate As Double = OutParam(0)
                        Dim Loading As Double = OutParam(1)
                        Dim PCTLOSS As Double = OutParam(2)
                        Dim SRate As Double = OutParam(3)
                        Dim TExcess As Double = OutParam(4)
                        Dim PCALC As String = OutParam(5)
                        Dim PremiumRate As Double = BRate + SRate

                        If PremiumRate <> 0 Then
                            rs.Edit()
                            rs.fields("BRate") = BRate
                            rs.fields("SRate") = SRate
                            rs.fields("Rate") = PremiumRate
                            If PCALC <> "" Then
                                rs.fields("PCALC") = PCALC
                            End If
                            rs.fields("Loading") = Loading
                            rs.fields("TExcess") = TExcess
                            If rs.fields("PCTLOSS") = 100 AndAlso PCTLOSS <> 100 Then
                                rs.fields("PCTLOSS") = PCTLOSS
                            End If
                            If Not rs.Update Then GoTo errmsg
                        End If
                    End If
                    rs.MoveNext()
                Loop
            End If

            ' Update Renewal Status
            If Not db.Execute("Update Renewal Set Status='R', NewANO=" & NEWANO & " Where ANO=" & ANO) Then GoTo errmsg

            ' Update Servicing
            rs = db.OpenRemoteSet("Select * from Service Where ANO=-1 and SType='RENEWAL' and SStatus='P' and PANO=" & ANO)
            If Not rs.Eof Then
                Do While Not rs.Eof
                    rs.Edit()
                    rs.fields("ANO") = NEWANO
                    rs.fields("CNO") = NewCNO
                    rs.fields("LANO") = NewLANO
                    If Not rs.Update Then GoTo errmsg
                    rs.MoveNext()
                Loop
            End If
        Else
            GoTo errmsg
        End If
        rsSrc.CloseRemoteSet()
        rsDst.CloseRemoteSet()

        If SType <> "M" Then
            Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "Premium_Calc", NEWANO)
        End If

        RenewalDetail = NEWANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        RenewalDetail = 0
    End Function
    Private Function GetMainANO(ByVal ANO As Long) As Long
        Dim rs As RemoteSet

        rs = db.OpenRemoteSet("Select LANO from Acceptance Where ANO=" & ANO)
        If toval(rs.fields("LANO")) > 0 Then
            GetMainANO = toval(rs.fields("LANO"))
        Else
            GetMainANO = ANO
        End If
    End Function
    Private Function CopyRenewal(ByVal ANO As Long, ByVal LANO As Long, ByVal NEWANO As Long, ByVal NewLANO As Long, ByVal NewCoverDate As Date, ByVal TOC As String, ByVal Segment As String, ByVal OpenFlag As Boolean, Optional ByVal DefaultTCF As Boolean = False, Optional ByVal ApplyDecrSIF As Boolean = False, Optional ByVal CANO As Long = -1, Optional ByVal NewCANO As Long = -1, Optional ByVal ApplyOriginalFDF As Boolean = False, Optional ByVal ApplyWOBusinessSourceF As Boolean = False, Optional ByVal BlankCopyOnlyF As Boolean = False) As Boolean
        If Not BlankCopyOnlyF Then
            If Not CopyInterest(ANO, NEWANO, True, True, ApplyDecrSIF) Then GoTo errmsg

            If Not CopyAccDetail("RCover", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("RCoverDet", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("AccDed", ANO, NEWANO) Then GoTo errmsg
        End If


        If Not CopyAccDetail("AInfo", ANO, NEWANO) Then GoTo errmsg



        If Not DefaultTCF AndAlso Not BlankCopyOnlyF Then
            If Not CopyAccDetail("AccSection", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("AccCla", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("AccCon", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("AccEx", ANO, NEWANO) Then GoTo errmsg
            If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & NEWANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg
        Else    ' Default TC
            If ANO = LANO Or LANO = -1 Or OpenFlag Then
                If NewCANO <> -1 And CANO <> NewCANO Then
                    If Not CopyAccDetail("AccSection", NewCANO, NEWANO, "(Select A1.* from AccSection A1, Acceptance A, TOC T1, TOC T2 Where A1.ANO=" & NewCANO & " and A.ANO=A1.ANO and T1.TOC=A.TOC and T2.TOC='" & TOC & "' and T1.COB=T2.COB)") Then GoTo errmsg
                    If Not CopyAccDetail("AccCla", NewCANO, NEWANO, "(Select A1.* from AccCla A1, Acceptance A, TOC T1, TOC T2 Where A1.ANO=" & NewCANO & " and A.ANO=A1.ANO and T1.TOC=A.TOC and T2.TOC='" & TOC & "' and T1.COB=T2.COB)") Then GoTo errmsg
                    If Not CopyAccDetail("AccEx", NewCANO, NEWANO, "(Select A1.* from AccEx A1, Acceptance A, TOC T1, TOC T2 Where A1.ANO=" & NewCANO & " and A.ANO=A1.ANO and T1.TOC=A.TOC and T2.TOC='" & TOC & "' and T1.COB=T2.COB)") Then GoTo errmsg
                    If Not CopyAccDetail("AccCon", NewCANO, NEWANO, "(Select A1.* from AccCon A1, Acceptance A, TOC T1, TOC T2 Where A1.ANO=" & NewCANO & " and A.ANO=A1.ANO and T1.TOC=A.TOC and T2.TOC='" & TOC & "' and T1.COB=T2.COB)") Then GoTo errmsg
                    If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & NEWANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg
                End If
                Dim rsS As RemoteSet
                Dim rsD As RemoteSet
                ' Creating Default Clauses
                rsS = db.OpenRemoteSet("Select * from DefCLA Where TOC='" & TOC & "'")
                If Not rsS.Eof Then
                    rsD = db.OpenRemoteSet("Select * from AccCLA Where ANO=" & NEWANO)
                    If rsD.Eof Then
                        Do While Not rsS.Eof
                            rsD.AddNew()
                            rsD.fields("ANO") = NEWANO
                            rsD.fields("Section") = tostr(rsS.fields("Section"))
                            rsD.fields("OrderNo") = tostr(rsS.fields("OrderNo"))
                            rsD.fields("ShortDesc") = tostr(rsS.fields("ShortDesc"))
                            rsD.fields("Description") = tostr(rsS.fields("Description"))
                            rsD.fields("ShortDesc_1") = tostr(rsS.fields("ShortDesc_1"))
                            rsD.fields("Description_1") = tostr(rsS.fields("Description_1"))
                            If Not rsD.Update Then GoTo errmsg
                            rsS.MoveNext()
                        Loop
                    End If
                    ' Insert into Section Table
                    Dim SQL As String
                    SQL = "Insert into AccSection(ANO, Section, ShortDesc, Description)"
                    SQL = SQL & " Select DISTINCT A2.ANO, A2.Section, S.ShortDesc, CAST(S.Description AS VARCHAR(MAX))"
                    SQL = SQL & " from Acceptance A1 "
                    SQL = SQL & " Inner Join AccCla A2 on (A2.ANO=A1.ANO)"
                    SQL = SQL & " Inner join Section S on (S.TOC=A1.TOC and S.Section=A2.Section)"
                    SQL = SQL & " Left join AccSection A3 on (A3.ANO=A1.ANO and A3.Section=S.section)"
                    SQL = SQL & " Where A1.ANO=" & NEWANO & " and A3.Section Is null"
                    If Not db.Execute(SQL) Then GoTo errmsg
                End If

                ' Creating Default Conditions
                rsS = db.OpenRemoteSet("Select * from DefCON Where TOC='" & TOC & "'")
                If Not rsS.Eof Then
                    rsD = db.OpenRemoteSet("Select * from AccCON Where ANO=" & NEWANO)
                    If rsD.Eof Then
                        Do While Not rsS.Eof
                            rsD.AddNew()
                            rsD.fields("ANO") = NEWANO
                            rsD.fields("Section") = tostr(rsS.fields("Section"))
                            rsD.fields("OrderNo") = tostr(rsS.fields("OrderNo"))
                            rsD.fields("ShortDesc") = tostr(rsS.fields("ShortDesc"))
                            rsD.fields("Description") = tostr(rsS.fields("Description"))
                            rsD.fields("ShortDesc_1") = tostr(rsS.fields("ShortDesc_1"))
                            rsD.fields("Description_1") = tostr(rsS.fields("Description_1"))
                            If Not rsD.Update Then GoTo errmsg
                            rsS.MoveNext()
                        Loop
                    End If
                End If

                ' Creating Default Exclusions
                rsS = db.OpenRemoteSet("Select * from DefEX Where TOC='" & TOC & "'")
                If Not rsS.Eof Then
                    rsD = db.OpenRemoteSet("Select * from AccEx Where ANO=" & NEWANO)
                    If rsD.Eof Then
                        Do While Not rsS.Eof
                            rsD.AddNew()
                            rsD.fields("ANO") = NEWANO
                            rsD.fields("Section") = tostr(rsS.fields("Section"))
                            rsD.fields("OrderNo") = tostr(rsS.fields("OrderNo"))
                            rsD.fields("ShortDesc") = tostr(rsS.fields("ShortDesc"))
                            rsD.fields("Description") = tostr(rsS.fields("Description"))
                            rsD.fields("ShortDesc_1") = tostr(rsS.fields("ShortDesc_1"))
                            rsD.fields("Description_1") = tostr(rsS.fields("Description_1"))
                            If Not rsD.Update Then GoTo errmsg
                            rsS.MoveNext()
                        Loop
                    End If
                End If
            End If
        End If

        If Not CopyAccDetail("AccSearch", ANO, NEWANO) Then GoTo errmsg

        If NewCANO <> -1 And CANO <> NewCANO Then
            If ANO = LANO Or LANO = -1 Then
                NewCANO = GetMainANO(NewCANO)
                ' If Conjunction Get Info from Conjunct Policy
                If Not CopyAccDetail("Payor", NewCANO, NEWANO) Then GoTo errmsg

                If Not db.Execute("Update Payor Set Grace=0, WPC=0 Where ANO=" & NEWANO) Then GoTo errmsg
                If Not ApplyWOBusinessSourceF AndAlso Not BlankCopyOnlyF AndAlso Not CopyAccDetail("AccBS", NewCANO, NEWANO) Then GoTo errmsg

                If Not CopyAccDetail("AccDA", NewCANO, NEWANO) Then GoTo errmsg
                If Not CopyAccDetail("AccCA", NewCANO, NEWANO) Then GoTo errmsg
            Else
                If NewLANO <> -1 Then
                    If Not CopyAccDetail("APayor", NewCANO, NEWANO) Then GoTo errmsg

                    If Not db.Execute("Update APayor Set Grace=0, WPC=0 Where ANO=" & NEWANO) Then GoTo errmsg
                    If Not ApplyWOBusinessSourceF AndAlso Not CopyAccDetail("AAccBS", NewCANO, NEWANO) Then GoTo errmsg

                    If OpenFlag AndAlso Not CopyAccDetail("AccCA", NewCANO, NEWANO) Then GoTo errmsg
                Else
                    ' Detail to Individual
                    If Not CopyAccDetail("Payor", LANO, NEWANO) Then GoTo errmsg

                    If Not db.Execute("Update Payor Set Grace=0, WPC=0 Where ANO=" & NEWANO) Then GoTo errmsg
                    If Not ApplyWOBusinessSourceF AndAlso Not BlankCopyOnlyF AndAlso Not CopyAccDetail("AccBS", LANO, NEWANO) Then GoTo errmsg

                    If Not CopyAccDetail("AccDA", ANO, NEWANO) Then GoTo errmsg
                    If Not CopyAccDetail("AccCA", ANO, NEWANO) Then GoTo errmsg
                End If
            End If
        Else
            If ANO = LANO Or LANO = -1 Then
                If Not CopyAccDetail("Payor", ANO, NEWANO) Then GoTo errmsg

                If Not db.Execute("Update Payor Set Grace=0, WPC=0 Where ANO=" & NEWANO) Then GoTo errmsg
                If Not ApplyWOBusinessSourceF AndAlso Not BlankCopyOnlyF AndAlso Not CopyAccDetail("AccBS", ANO, NEWANO) Then GoTo errmsg
            Else    ' LANO<>-1
                If NewLANO <> -1 Then
                    If Not CopyAccDetail("APayor", ANO, NEWANO) Then GoTo errmsg

                    If Not db.Execute("Update APayor Set Grace=0, WPC=0 Where ANO=" & NEWANO) Then GoTo errmsg
                    If Not ApplyWOBusinessSourceF AndAlso Not BlankCopyOnlyF AndAlso Not CopyAccDetail("AAccBS", ANO, NEWANO) Then GoTo errmsg

                Else
                    ' Detail to Individual
                    If Not CopyAccDetail("Payor", LANO, NEWANO) Then GoTo errmsg

                    If Not db.Execute("Update Payor Set Grace=0, WPC=0 Where ANO=" & NEWANO) Then GoTo errmsg
                    If Not ApplyWOBusinessSourceF AndAlso Not BlankCopyOnlyF AndAlso Not CopyAccDetail("AccBS", LANO, NEWANO) Then GoTo errmsg

                End If
            End If
            If Not CopyAccDetail("AccDA", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("AccCA", ANO, NEWANO) Then GoTo errmsg
        End If

        'If Not CopyAccDetail("RArrHeader", ANO, NEWANO) Then GoTo errmsg
        If Not BlankCopyOnlyF Then
            If Not CopyAccDetail("RArrDet", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("FPart", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("FPartDet", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("FSecurity", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("FDeductible", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("FacCLA", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("FacCON", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("FacEX", ANO, NEWANO) Then GoTo errmsg
            If Not CopyAccDetail("FInfo", ANO, NEWANO) Then GoTo errmsg
        End If

        ' Update Formula Field in AINFO
        Dim rs As RemoteSet
        Dim rsTab As RemoteSet
        Dim i As Integer
        rs = db.OpenQueryDef("QAInfo", adOpenKeyset, NEWANO)
        If Not rs.Eof Then
            rs.Edit()
            For i = 1 To 15
                If rs.fields("FLDID" & i) <> "" Then
                    rsTab = db.OpenRemoteSet("Select FLDTAB, FLDSEARCH from genhtab Where FLDID='" & rs.fields("FLDID" & i) & "'")
                    If Not toval(rsTab.fields("FLDTAB")) Then
                        rs.fields("ValueID" & i) = Get_ValueID(rs.fields("FLDID" & i), rs.fields("ValueDesc" & i), NewCoverDate, TOC, Segment)
                        ' Setting Acceptance Search Field
                        If toval(rsTab.fields("FLDSEARCH")) And tostr(rs.fields("FLDID" & i)) <> "" And tostr(rs.fields("ValueID" & i)) <> "" Then
                            If Not Set_AccSearch(NEWANO, rs.fields("FLDID" & i), rs.fields("ValueID" & i)) Then GoTo ErrMsg
                        End If
                    End If
                Else
                    Exit For
                End If
            Next i
            If Not rs.Update Then GoTo errmsg
        End If

        If ApplyOriginalFDF AndAlso Not BlankCopyOnlyF Then
            If Not CopyAccDetail("ACCFD", ANO, NEWANO, "(Select A1.ANO, A3.ID, A3.FDID, A3.POLICYYEAR, A3.REMARK, A3.CURRENCY, A3.ContributionF, A3.Amount, A3.AMOUNTPCT, A3.AMOUNTPCTBASED from Acceptance A1, Acceptance A2, AccFD A3, FDTAB Where left(FDTAB.FDTYPE,1) in ('F','D','O') And FDTAB.FDID=A3.FDID and A3.ANO=A2.ANO and A2.AType='N' and A2.OANO=A1.OANO AND A1.ANO=" & ANO & ")") Then GoTo errmsg
        End If

        CopyRenewal = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyRenewal = False
    End Function

    Private Function Set_Deductible_Loading(ByVal ANO As Long, ByVal DLoading As Double, ByVal Deductible As Double) As Boolean
        Dim rs As RemoteSet

        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select * from AccDed Where Exists (Select ANO from RCover, RateCov Where RateCov.Code=RCover.Code and RCover.ANO=AccDed.ANO and RCover.Category='M' and RateCov.TOR=AccDed.TOR) and AccDed.ANO=" & ANO)
        Do While Not rs.Eof
            If DLoading <> 0 Or Deductible <> 0 Then
                rs.Edit()
                If DLoading <> 0 Then
                    rs.fields("PCTTSI") = toval(rs.fields("PCTTSI")) * DLoading
                    rs.fields("PCTCL") = toval(rs.fields("PCTCL")) * DLoading
                    rs.fields("FIXEDMIN") = toval(rs.fields("FIXEDMIN")) * DLoading
                    rs.fields("FIXEDMAX") = toval(rs.fields("FIXEDMAX")) * DLoading
                    rs.fields("FIXEDMIN_AOE") = toval(rs.fields("FIXEDMIN_AOE")) * DLoading
                    rs.fields("FIXEDMAX_AOE") = toval(rs.fields("FIXEDMAX_AOE")) * DLoading
                End If

                If Deductible <> 0 Then
                    If rs.fields("FixedMin") <> 0 And rs.fields("FixedMax") = 0 Then
                        rs.fields("FixedMin") = Deductible
                    ElseIf rs.fields("FixedMax") <> 0 And rs.fields("FixedMin") = 0 Then
                        rs.fields("FixedMax") = Deductible
                    Else
                        If Deductible > rs.fields("FixedMin") Then
                            rs.fields("FIXEDMAX") = Deductible
                        Else
                            rs.fields("FixedMin") = Deductible
                        End If
                    End If
                End If

                rs.fields("Remarks") = ConstructDeductibleRemarks(rs, rs.fields("Remarks"), "E")
                rs.fields("Remarks_1") = ConstructDeductibleRemarks(rs, rs.fields("Remarks_1"), "I")
                If Not rs.Update Then GoTo errmsg

            End If
            rs.MoveNext()
        Loop
        Set_Deductible_Loading = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Set_Deductible_Loading = False
    End Function
    Private Function Translate(ByVal Unit As String, ByVal Language As String) As String
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select * from IUnit Where Unit='" & Unit & "'")
        If Not rs.Eof Then
            Translate = IIf(Language = "E", rs.fields("Description"), rs.fields("Description_1"))
        Else
            Translate = Unit
        End If
        rs.CloseRemoteSet()
    End Function
    Private Function ConstructDeductibleRemarks(ByVal rs As RemoteSet, ByVal Remarks As String, ByVal language As String) As String
        Dim Template As String = ""
        Dim Tmp1 As String
        Dim Tmp2 As String
        Dim Unit As String

        If language = "E" Then
            Unit = Translate(rs.fields("IUnit"), language)
            Tmp1 = ""
            Tmp2 = ""

            If toval(rs.fields("PCTTSI")) <> 0 Then
                If toval(rs.fields("PCTCL")) <> 0 Then
                    Template = tostr(rs.fields("PCTTSI")) & "% of " & rs.fields("STRTSI") & " or " & tostr(rs.fields("PCTCL")) & "% of approved claim"
                Else
                    Template = tostr(rs.fields("PCTTSI")) & "% of " & rs.fields("STRTSI")
                End If
            Else
                If toval(rs.fields("PCTCL")) <> 0 Then
                    Template = tostr(rs.fields("PCTCL")) & "% of approved claim"
                Else
                    Template = ""
                End If
            End If

            If toval(rs.fields("FixedMin")) <> 0 Then
                If Trim(Template) = "" And toval(rs.fields("FixedMax")) = 0 Then
                    Tmp1 = rs.fields("Currency") & " " & Format(rs.fields("FixedMin"), "###,###,###,##0.00")
                Else
                    Tmp1 = "minimum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMin"), "###,###,###,##0.00")
                End If
            End If

            If toval(rs.fields("FixedMax")) <> 0 Then
                If Trim(Template) = "" And toval(rs.fields("FixedMin")) = 0 Then
                    Tmp1 = rs.fields("Currency") & " " & Format(rs.fields("FixedMax"), "###,###,###,##0.00")
                Else
                    If Tmp1 <> "" Then
                        Tmp1 = Tmp1 & " " & "maximum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMax"), "###,###,###,##0.00")
                    Else
                        Tmp1 = "maximum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMax"), "###,###,###,##0.00")
                    End If
                End If
            End If

            If (toval(rs.fields("PCTTSI")) <> 0 Or toval(rs.fields("PCTCL")) <> 0 Or toval(rs.fields("FixedMin")) <> 0 Or toval(rs.fields("FixedMax")) <> 0) And Trim(Unit) <> "" Then
                Tmp1 = Tmp1 & " for " & Unit
            End If

            If toval(rs.fields("FixedMin_AOE")) <> 0 Then
                If Trim(Template) = "" And toval(rs.fields("FixedMax_AOE")) = 0 Then
                    Tmp2 = rs.fields("Currency") & " " & Format(rs.fields("FixedMin_AOE"), "###,###,###,##0.00")
                Else
                    Tmp2 = "minimum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMin_AOE"), "###,###,###,##0.00")
                End If
            End If

            If toval(rs.fields("FixedMax_AOE")) <> 0 Then
                If Trim(Template) = "" And toval(rs.fields("FixedMin_AOE")) = 0 Then
                    Tmp2 = rs.fields("Currency") & " " & Format(rs.fields("FixedMax_AOE"), "###,###,###,##0.00")
                Else
                    If Tmp2 <> "" Then
                        Tmp2 = Tmp2 & " " & "maximum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMax_AOE"), "###,###,###,##0.00")
                    Else
                        Tmp2 = "maximum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMax_AOE"), "###,###,###,##0.00")
                    End If
                End If
            End If

            If toval(rs.fields("FixedMin_AOE")) <> 0 Or toval(rs.fields("FixedMax_AOE")) <> 0 Then
                Tmp2 = Tmp2 & " any one event"
            End If

            If Tmp1 <> "" Then
                If Template <> "" Then
                    Template = Template + ", " + Tmp1
                Else
                    Template = Tmp1
                End If
            End If

            If Tmp2 <> "" Then
                If Template <> "" Then
                    Template = Template + ", " + Tmp2
                Else
                    Template = Tmp2
                End If
            End If
        Else
            ' Indonesia
            Unit = Translate(rs.fields("IUnit"), language)
            Tmp1 = ""
            Tmp2 = ""

            If toval(rs.fields("PCTTSI")) <> 0 Then
                If toval(rs.fields("PCTCL")) <> 0 Then
                    Template = tostr(rs.fields("PCTTSI")) & "% dari " & rs.fields("STRTSI") & " atau " & tostr(rs.fields("PCTCL")) & "% dari nilai klaim yang disetujui"
                Else
                    Template = tostr(rs.fields("PCTTSI")) & "% dari " & rs.fields("STRTSI")
                End If
            Else
                If toval(rs.fields("PCTCL")) <> 0 Then
                    Template = tostr(rs.fields("PCTCL")) & "% dari nilai klaim yang disetujui"
                Else
                    Template = ""
                End If
            End If

            If toval(rs.fields("FixedMin")) <> 0 Then
                If Trim(Template) = "" And toval(rs.fields("FixedMax")) = 0 Then
                    Tmp1 = rs.fields("Currency") & " " & Format(rs.fields("FixedMin"), "###,###,###,##0.00")
                Else
                    Tmp1 = "minimum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMin"), "###,###,###,##0.00")
                End If
            End If

            If toval(rs.fields("FixedMax")) <> 0 Then
                If Trim(Template) = "" And toval(rs.fields("FixedMin")) = 0 Then
                    Tmp1 = rs.fields("Currency") & " " & Format(rs.fields("FixedMax"), "###,###,###,##0.00")
                Else
                    If Tmp1 <> "" Then
                        Tmp1 = Tmp1 & " " & "maksimum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMax"), "###,###,###,##0.00")
                    Else
                        Tmp1 = "maksimum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMax"), "###,###,###,##0.00")
                    End If
                End If
            End If

            If (toval(rs.fields("PCTTSI")) <> 0 Or toval(rs.fields("PCTCL")) <> 0 Or toval(rs.fields("FixedMin")) <> 0 Or toval(rs.fields("FixedMax")) <> 0) And Trim(Unit) <> "" Then
                Tmp1 = Tmp1 & " untuk " & Unit
            End If

            If toval(rs.fields("FixedMin_AOE")) <> 0 Then
                If Trim(Template) = "" And toval(rs.fields("FixedMax_AOE")) = 0 Then
                    Tmp2 = rs.fields("Currency") & " " & Format(rs.fields("FixedMin_AOE"), "###,###,###,##0.00")
                Else
                    Tmp2 = "minimum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMin_AOE"), "###,###,###,##0.00")
                End If
            End If

            If toval(rs.fields("FixedMax_AOE")) <> 0 Then
                If Trim(Template) = "" And toval(rs.fields("FixedMin_AOE")) = 0 Then
                    Tmp2 = rs.fields("Currency") & " " & Format(rs.fields("FixedMax_AOE"), "###,###,###,##0.00")
                Else
                    If Tmp2 <> "" Then
                        Tmp2 = Tmp2 & " " & "maksimum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMax_AOE"), "###,###,###,##0.00")
                    Else
                        Tmp2 = "maksimum " & rs.fields("Currency") & " " & Format(rs.fields("FixedMax_AOE"), "###,###,###,##0.00")
                    End If
                End If
            End If

            If toval(rs.fields("FixedMin_AOE")) <> 0 Or toval(rs.fields("FixedMax_AOE")) <> 0 Then
                Tmp2 = Tmp2 & " untuk setiap peristiwa"
            End If

            If Tmp1 <> "" Then
                If Template <> "" Then
                    Template = Template + ", " + Tmp1
                Else
                    Template = Tmp1
                End If
            End If

            If Tmp2 <> "" Then
                If Template <> "" Then
                    Template = Template + ", " + Tmp2
                Else
                    Template = Tmp2
                End If
            End If
        End If
        If Template = "" Then Template = "NIL"
        If Template <> "" Then
            If InStr(Remarks, ":") <> 0 Then
                Remarks = Trim(Left(Remarks, InStr(Remarks, ":") - 1))
                Template = Remarks & " : " & Template
            Else
                rs = db.OpenRemoteSet("Select Description From TOR Where TOR Like '" & rs.fields("TOR") & "'")
                If TypeName(rs) <> "Nothing" Then
                    Template = rs.fields("Description") & " : " & Template
                End If
            End If
        End If
        ConstructDeductibleRemarks = Template
    End Function
