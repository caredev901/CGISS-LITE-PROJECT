        Dim SI3LABEL As String = tostr(getInParamValue(Param, 21))
        Dim SI4LABEL As String = tostr(getInParamValue(Param, 22))
        Dim SI5LABEL As String = tostr(getInParamValue(Param, 23))
        Dim SI6LABEL As String = tostr(getInParamValue(Param, 24))
        Dim SI7LABEL As String = tostr(getInParamValue(Param, 25))
        Dim SI8LABEL As String = tostr(getInParamValue(Param, 26))
        Dim SI9LABEL As String = tostr(getInParamValue(Param, 27))
        Dim SI10LABEL As String = tostr(getInParamValue(Param, 28))
        Dim sFilterCode As String = getInParamValue(Param, 29)
        Dim PCTLOSS_1 As Double = toval(getInParamValue(Param, 30))
        Dim PCTLOSS_2 As Double = toval(getInParamValue(Param, 31))
        Dim PCTLOSS_3 As Double = toval(getInParamValue(Param, 32))
        Dim PCTLOSS_4 As Double = toval(getInParamValue(Param, 33))
        Dim PCTLOSS_5 As Double = toval(getInParamValue(Param, 34))
        Dim NotApplyRateLoadingF As Boolean = toval(getInParamValue(Param, 35))
        Dim Rate_OC As Double = toval(getInParamValue(Param, 36))
        Dim STRRATE As String = tostr(getInParamValue(Param, 37))
        Dim ARate() As String = STRRATE.Split("|")
        Dim iFilterCode As String = getInParamValue(Param, 38)

        Dim STRDEDUCTIBLE As String

        STRDEDUCTIBLE = tostr(getInParamValue(Param, 39))
        Dim ADeductible() As String = STRDEDUCTIBLE.Split("|")

        STRDEDUCTIBLE = tostr(getInParamValue(Param, 40))
        Dim APCTTSI() As String = STRDEDUCTIBLE.Split("|")

        STRDEDUCTIBLE = tostr(getInParamValue(Param, 41))
        Dim APCTCL() As String = STRDEDUCTIBLE.Split("|")

        Dim cFilterCode As String = getInParamValue(Param, 42)

        Dim PCTLOSS_6 As Double = toval(getInParamValue(Param, 43))
        Dim PCTLOSS_7 As Double = toval(getInParamValue(Param, 44))
        Dim PCTLOSS_8 As Double = toval(getInParamValue(Param, 45))
        Dim PCTLOSS_9 As Double = toval(getInParamValue(Param, 46))
        Dim PCTLOSS_10 As Double = toval(getInParamValue(Param, 47))

        Dim strRateDisc As String = tostr(getInParamValue(Param, 48))
        Dim ARateDisc() As String = strRateDisc.Split("|")

        Dim strPCTIndemnity As String = tostr(getInParamValue(Param, 49))
        Dim APCTIndemnity() As String = strPCTIndemnity.Split("|")

        Dim SIBasedID As Integer
        Dim FLDID As String
        Dim ValueID As String
        Dim ValueDesc As String
        Dim SType As String
        Dim pHolder As String
        Dim EMethod As String
        Dim OpenFlag As Boolean
        Dim CANO As Long

        rs = db.OpenRemoteSet("Select A.CANO, A.EMethod, A.ExclusiveF, A.SDate, A.EDate, A.STime, A.ETime, A.PDate, A.LANO, A.AType, A.TOC, A.FLDID, A.ValueID, A.ValueDesc, TOC.PTerm, coalesce(R.RDate, A.SDate) as RDate, C.OpenFlag, C.Voyage, C.ISType, C.PHolder, PolicyType.SType from Acceptance A Inner Join TOC on (TOC.TOC=A.TOC) Left Join RArrHeader R on (R.ANO=A.ANO) Inner Join Cover C on (C.CNO=A.CNO) Inner join PolicyType on (PolicyType.PolicyType=C.PolicyType) Where A.ANO=" & ANO)
        CANO = toval(rs.fields("CANO"))
        SDate = todate(rs.fields("SDate"))
        EDate = todate(rs.fields("EDate"))
        STime = tostr(rs.fields("STime"))
        ETime = tostr(rs.fields("ETime"))
        ExclusiveF = toval(rs.fields("ExclusiveF"))
        PDate = todate(rs.fields("PDate"))
        LANO = toval(rs.fields("LANO"))
        AType = tostr(rs.fields("AType"))
        TOC = tostr(rs.fields("TOC"))
        FLDID = tostr(rs.fields("FLDID"))
        ValueID = tostr(rs.fields("ValueID"))
        ValueDesc = tostr(rs.fields("ValueDesc"))
        OpenFlag = toval(rs.fields("OpenFlag"))
        Voyage = toval(rs.fields("Voyage"))
        ISType = tostr(rs.fields("ISType"))
        pHolder = tostr(rs.fields("PHolder"))
        SType = tostr(rs.fields("SType"))
        RDATE = todate(rs.fields("RDate"))
        PTerm = toval(rs.fields("PTerm"))
        If PTerm = 0 Then PTerm = 12
        EMethod = tostr(rs.fields("EMethod"))

        Dim Rate As Double = GetReinsuranceRate(TOC, CCY, RDATE, pHolder)
        Dim TRate As Double

        Dim Scaling As Double
        Dim Discount As Double

        rs = db.OpenRemoteSet("Select Expiry, ApplyLimitLiabilityForMasterF, ApplyMaxLiabilityForMasterF, ApplyTotalSumInsuredForMasterF, ApplyAggregateForMasterF from TOPRO Where TOPRO='" & TOPRO & "'")
        If rs.Eof Then
            StrMsg = StrMsg & "Check Type Of Product ('" & TOPRO & "') ==> Not Found"
            GoTo errmsg
        Else
            If DateDiff(DateInterval.Day, todate(rs.fields("Expiry")), PDate) > 0 Then
                StrMsg = StrMsg & "Check Type Of Product ('" & TOPRO & "') ==> Already Expired on " & Format(todate(rs.fields("Expiry")), "dd mmm yyyy")
                GoTo errmsg
            End If
        End If
        Dim ApplyLimitLiabilityForMasterF As Boolean = toval(rs.fields("ApplyLimitLiabilityForMasterF"))
        Dim ApplyMaxLiabilityForMasterF As Boolean = toval(rs.fields("ApplyMaxLiabilityForMasterF"))
        Dim ApplyTotalSumInsuredForMasterF As Boolean = toval(rs.fields("ApplyTotalSumInsuredForMasterF"))
        Dim ApplyAggregateForMasterF As Boolean = toval(rs.fields("ApplyAggregateForMasterF"))

        SQL = "Select T.TOPRO, T.Code, T.PolicyYear, Max(TOPRO.Discount) as Discount, Max(T.PCALC) as PCALC, Max(T.NCPeriod) as NCPeriod, Cast(Max(Cast(T.NCPERIODINDAYSF as Int)) as Bit) AS NCPERIODINDAYSF, Cast(Max(Cast(T.RestructureF as Int)) as Bit) AS RestructureF, Max(T.PCTLOSS) as PCTLOSS, Max(T.PAddition) as PAddition, Max(T.PCTEscalation) as PCTEscalation, Max(T.RATE_SOURCE) as RATE_SOURCE, Max(T.PCTLOSS_SOURCE) as PCTLOSS_SOURCE, Max(T.PCTINDEMNITY_SOURCE) as PCTINDEMNITY_SOURCE, cast(Max(cast(T.NOREFUNDF as Int)) as Bit) as NOREFUNDF, cast(Max(cast(T.RETROACTIVEF as Int)) as Bit) as RETROACTIVEF, Max(Cast(T.Remark as varchar(512))) as Remark, Max(R.Code) as RCode, Max(R.SIBasedID) as SIBasedID, Max(R.PRATEPCT) as PRATEPCT, Max(T.Rate) as Rate, Max(T.Unit) as Unit, Max(T.Category) as Category, Max(T.Portion) as Portion, Max(T.CPREFUND) as CPREFUND, Max(T.CPFORMULA) as CPFORMULA, "
        SQL = SQL & " CoShare=(Select top 1 AInfoDet.COShare from AInfoDet Where AInfoDet.ANO=" & LANO & " and AInfoDet.FLDID='" & FLDID & "' and AInfoDet.ValueID='" & ValueID & "' and AInfoDet.Status='A')"
        SQL = SQL & " Into #TOP_RATE"
        SQL = SQL & " from TOPRO, TOP_Rate T, RateTab R"
        SQL = SQL & " Where TOPRO.TOPRO='" & TOPRO & "' and T.TOPRO=TOPRO.TOPRO and (R.PCode=T.Code or R.Code=T.Code) and R.effective<='" & Format(PDate, "MM/DD/YYYY") & "'"
        SQL = SQL & " and R.effective = coalesce((Select Top 1 Effective from RateTab Where (RateTab.PCode=T.Code or RateTab.Code=T.Code) and RateTab.effective<='" & Format(PDate, "MM/DD/YYYY") & "' Order by RateTab.Effective),'01/01/1900')"
        SQL = SQL & " and Exists (Select Top 1 R1.Code from RateCov R1, RClass R2 Where R1.Code=R.Code and R2.TOR=R1.TOR and R2.TOC='" & TOC & "')"
        If EDate > DateAdd(DateInterval.Year, DateDiff(DateInterval.Year, SDate, EDate), SDate) Then
            SQL = SQL & " and T.PolicyYear<=" & DateDiff(DateInterval.Year, SDate, EDate) + 1
        Else
            SQL = SQL & " and T.PolicyYear<=" & DateDiff(DateInterval.Year, SDate, EDate)
        End If
        If sFilterCode <> "" Then
            SQL = SQL & " and (T.FilterCode in " & sFilterCode & ")"
        Else
            If Not Coverage_A Then
                SQL = SQL & " and T.Category='M'"
            End If
        End If

        If EMethod = "S" Then ' if Restucturing 
            ' Get Rate Code for Restucturing
            SQL = SQL & " and T.RestructureF=1"
        End If

        SQL = SQL & " Group by T.TOPRO, T.Code, T.PolicyYear;"
        SQL = SQL & " Select * from #TOP_RATE T1 Where (T1.PolicyYear=0 or not exists(Select T2.Code from #TOP_RATE T2 Where T2.TOPRO=T1.TOPRO and T2.Code=T1.Code and T2.PolicyYear=0));"

        ' Coverage
        rs = db.OpenRemoteSet(SQL)

        db.Execute("Drop Table #TOP_RATE")

        rsd = db.OpenRemoteSet("Select top 1 * from RCover Where ANO=" & ANO)

        If rs.Eof Then
            If rsd.Eof Or ResetF Then
                StrMsg = StrMsg & "Check Type Of Product ('" & TOPRO & "') ==> No Rate Table Effective on " & Format(PDate, "dd mmm yyyy")
                GoTo errmsg
            End If
        End If

        SIBasedID = toval(rs.fields("SIBasedID"))
        Discount = toval(rs.fields("Discount"))

        Dim AddF As Boolean
        Dim RSDate As Date
        Dim REDate As Date

        If (Not rs.Eof And rsd.Eof) Or ResetF Or AdjustRiskF Then
            If Not rsd.Eof Then
                If AdjustRiskF Then
                    If EMethod = "S" Then ' if Restucturing 
                        If Not Delete_Records("Delete R from RCover R Left Join TOP_RATE T1 on (T1.TOPRO='" & TOPRO & "' and T1.Code=R.Code and T1.RestructureF=1) Where R.ANO=" & ANO & " and (R.TOPROF=1 or coalesce(T1.Code,'')<>'')") Then GoTo errmsg
                    Else
                        If Not Delete_Records("Delete R from RCover R Left Join TOP_RATE T1 on (T1.TOPRO='" & TOPRO & "' and T1.Code=R.Code) Where R.ANO=" & ANO & " and (R.TOPROF=1 or coalesce(T1.Code,'')<>'')") Then GoTo errmsg
                    End If
                Else
                    If Not Delete_Records("Delete R from RCover R Where R.ANO=" & ANO) Then GoTo errmsg
                End If
            End If
            If rsd.Eof OrElse ResetF Then
                AddF = True
            Else
                AddF = False
            End If
            Do While Not rs.Eof
                If toval(rs.fields("PolicyYear")) = 0 Then
                    RSDate = SDate
                    REDate = EDate
                Else
