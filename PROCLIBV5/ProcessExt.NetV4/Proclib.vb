    Private Function ConfirmQuotation(ByVal ANO As Long, ByVal Param As Object, Optional ByVal NoQuotationF As Boolean = False) As String
        Dim rs As RemoteSet
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim NewCNO As Long
        Dim NewANO As Long

        On Error GoTo errmsg

        Dim CNO As Long
        Dim PDate As Date
        Dim Validation As Integer
        Dim Comment As String
        Dim RegNo As String
        Dim AType As String
        Dim IAccReg As Long

        CNO = Param(0)
        PDate = Param(1)  ' Confirm Date
        Validation = Param(2) ' Days Validation
        Comment = Param(3) ' Comment

        rs = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        If Not (rs.fields("CStatus") = "P") Then
            StrMsg = "Please Check Quotation Status !"
            GoTo errmsg
        End If
        rs.Edit()
        rs.fields("CStatus") = "A"
        rs.fields("AUserID") = db_user
        rs.fields("AUserDate") = PDate
        rs.fields("AUserTime") = Time()
        rs.fields("Validation") = Validation
        rs.fields("Comment") = Comment
        If NoQuotationF Then
            rs.fields("ASource") = "UW"
        End If
        If Not rs.Update Then GoTo errmsg

        rs = db.OpenRemoteSet("Select Cover.OpenFlag, Cover.PolicyType, Cover.ISType, Acceptance.Branch, Acceptance.CT, Acceptance.TOC, Acceptance.AType, TOC.IAccReg from Acceptance Inner Join Cover on (Cover.CNO=Acceptance.CNO) Inner Join TOC on (TOC.TOC=Acceptance.TOC) where Acceptance.ANO=" & ANO, adOpenKeyset)
        RegNo = GetDocumentNumbering("REG", tostr(rs.fields("PolicyType")), tostr(rs.fields("ISType")), PDate, tostr(rs.fields("Branch")), tostr(rs.fields("TOC")), tostr(rs.fields("CT")))
        If RegNo = "" Then
            StrMsg = "Generate Register Number Failed !"
            GoTo errmsg
        End If
        AType = rs.fields("AType")
        IAccReg = toval(rs.fields("IAccReg"))

        ' Update Acceptance (Include Detail Acceptance)
        If Not db.Execute("Update Acceptance Set RegNo='" & RegNo & "', RegDate='" & Format(PDate, "MM/DD/YYYY") & "' Where CNO=" & CNO) Then GoTo errmsg

        ' Adjust Risk Cover
        If Not db.Execute("Update RCover Set RCover.SDate=Acceptance.SDate from RCover, Acceptance Where RCover.ANO=Acceptance.ANO and RCover.SDate<Acceptance.SDate and Acceptance.CNO=" & CNO) Then GoTo errmsg
        If Not db.Execute("Update RCover Set RCover.EDate=Acceptance.EDate from RCover, Acceptance Where RCover.ANO=Acceptance.ANO and RCover.EDate>Acceptance.EDate and Acceptance.CNO=" & CNO) Then GoTo errmsg

        If AType = "N" And Not NoQuotationF Then
            rsSrc = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
            rsDst = db.OpenRemoteSet("Select * from Cover Where 1<>1")
            'Copy Cover & Related Information
            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("CDate") = PDate
            rsDst.fields("CTime") = Time()
            rsDst.fields("UserId") = db_user
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("pCNO") = CNO
            NewCNO = db.GetIdentity("Cover") + 1
            rsDst.fields("CNO") = NewCNO
            rsDst.fields("ASource") = "UW"
            If Not rsDst.Update Then GoTo errmsg
            If Not CopyCover(rsSrc.fields("CNO"), NewCNO) Then GoTo errmsg

            rsSrc.CloseRemoteSet()
            rsDst.CloseRemoteSet()

            'Copy Acceptance & Related Information
            rsDst = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
            rsSrc = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
            If Not rsSrc.Eof Then
                rsDst.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
                NewANO = db.GetIdentity("Acceptance") + 1
                rsDst.fields("CNO") = NewCNO
                rsDst.fields("UserID") = db_user
                rsDst.fields("CDate") = Today.Date
                rsDst.fields("CTime") = Time()
                rsDst.fields("LUserID") = db_user
                rsDst.fields("LDate") = Today.Date
                rsDst.fields("LTime") = Time()
                rsDst.fields("ANO") = NewANO
                rsDst.fields("OANO") = NewANO
                If rsSrc.fields("LANO") = rsSrc.fields("ANO") Then
                    rsDst.fields("LANO") = NewANO
                Else
                    rsDst.fields("LANO") = -1
                End If
                rsDst.fields("RequestF") = False
                rsDst.fields("RequestMessage") = ""
                rsDst.fields("RequestName") = ""
                rsDst.fields("BatchNo") = ""
                rsDst.fields("BID") = 0
                rsDst.fields("ASource") = ""

                If IAccReg <> 0 AndAlso (rsSrc.fields("RegID") = "" Or rsSrc.fields("FLDID") = "" Or rsSrc.fields("ValueID") = "") Then
                    rsDst.fields("pStatus") = "I"
                Else
                    rsDst.fields("pStatus") = rsSrc.fields("pStatus")
                End If
                If Not rsDst.Update Then GoTo errmsg

                If rsSrc.fields("LANO") = rsSrc.fields("ANO") Then
                    If Not CopyAcceptance(ANO, NewANO, "N", True, "Q") Then GoTo errmsg

                    If Not db.Execute("Update Acceptance set AdjustableF=0, RenewableF=0, AStatus='C', CloseDate='" & Format(PDate, "MM/DD/YYYY") & "', CUserID='" & db_user & "' Where ANO=" & ANO) Then GoTo errmsg

                    'any Detail
                    rs = db.OpenRemoteSet("Select A.ANO, A.RegID, A.FLDID, A.VALUEID, A.pStatus, TOC.IAccReg from Acceptance A Inner Join TOC on (TOC.TOC=A.TOC) Where A.AType<>'C' and A.ANO<>A.LANO and A.LANO=" & ANO)
                    Do While Not rs.Eof
                        If toval(rs.fields("IAccReg")) <> 0 AndAlso (rs.fields("RegID") = "" Or rs.fields("FLDID") = "" Or rs.fields("ValueID") = "") Then
                            If Not RevisionDetail(rs.fields("ANO"), NewANO, NewCNO, "I") Then GoTo errmsg
                        Else
                            If Not RevisionDetail(rs.fields("ANO"), NewANO, NewCNO, rs.fields("pStatus")) Then GoTo errmsg
                        End If
                        If Not db.Execute("Update RArrHeader Set Status='R' Where Status='A' and ANO=" & toval(rs.fields("ANO"))) Then GoTo errmsg
                        If Not db.Execute("Update Acceptance set AdjustableF=0, RenewableF=0, AStatus='C', CloseDate='" & Format(PDate, "MM/DD/YYYY") & "', CUserID='" & db_user & "' Where ANO=" & toval(rs.fields("ANO"))) Then GoTo errmsg
                        rs.MoveNext()
                    Loop
                    rs.CloseRemoteSet()
                Else
                    If Not CopyAcceptance(ANO, NewANO, "N", False, "Q") Then GoTo errmsg
                    If Not db.Execute("Update RArrHeader Set Status='R' Where Status='A' and ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Update Acceptance set AdjustableF=0, RenewableF=0, AStatus='C', CloseDate='" & Format(PDate, "MM/DD/YYYY") & "', CUserID='" & db_user & "' Where ANO=" & ANO) Then GoTo errmsg
                End If

            End If
            rsSrc.CloseRemoteSet()
            rsDst.CloseRemoteSet()

            ' Update Servicing Data
            If Not db.Execute("Update Service Set CNO=" & NewCNO & ", LANO=" & NewANO & ", ANO=" & NewANO & " Where ANO=" & ANO) Then GoTo errmsg

            ' Update Renewal Data
            If Not db.Execute("Update Renewal Set NewANO=" & NewANO & " Where NewANO=" & ANO) Then GoTo errmsg
        Else
            NewANO = ANO
        End If

        ConfirmQuotation = NewANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        ConfirmQuotation = 0
    End Function

    Private Function Update_Accumulation_AInfo(ByVal ANO As Long, ByVal TOC As String, ByVal FLDID As String, ByVal ValueID As String) As Boolean
        On Error GoTo errmsg
        Dim rsA As RemoteSet
        Dim i As Integer
        Dim j As Integer

        Dim AFLDID As Object
        Dim AValueID As Object
        AFLDID = Convert_FLDID_Into_Array(FLDID)
        AValueID = Convert_FLDID_Into_Array(ValueID)
        j = 0
        rsA = db.OpenQueryDef("QAInfo", adOpenKeyset, ANO)
        rsA.Edit()
        For i = 0 To UBound(AValueID)
            Do While j <= 15
                If UCase(rsA.fields("FLDID" & j)) = UCase(AFLDID(i)) Then
                    If rsA.fields("ValueID" & j) = "" Then
                        rsA.fields("ValueDesc" & j) = AValueID(i)
                    Else
                        rsA.fields("ValueID" & j) = AValueID(i)
                    End If
                    j = j + 1
                    Exit Do
                Else
                    j = j + 1
                End If
            Loop
        Next
        If Not rsA.Update Then GoTo errmsg

        Update_Accumulation_AInfo = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Update_Accumulation_AInfo = False
    End Function
    Private Function Convert_FLDID_Into_Array(ByVal FLDID As String) As String()
        Dim SFLDID() As String
        Dim Separator As String

        If InStr(FLDID, "|") <> 0 Then
            Separator = "|"
        ElseIf InStr(FLDID, "/") <> 0 Then
            Separator = "/"
        Else
            Separator = ""
        End If
        Dim i As Integer
        i = 0
        Do While Separator <> ""
            ReDim Preserve SFLDID(i)

            SFLDID(i) = Trim(Mid(FLDID, 1, InStr(FLDID, Separator) - 1))

            FLDID = Mid(FLDID, InStr(FLDID, Separator) + 1, Len(FLDID))
            If InStr(FLDID, "|") <> 0 Then
                Separator = "|"
            ElseIf InStr(FLDID, "/") <> 0 Then
                Separator = "/"
            Else
                Separator = ""
            End If
            i = i + 1
        Loop
        ReDim Preserve SFLDID(i)
        SFLDID(i) = FLDID
        Convert_FLDID_Into_Array = SFLDID
    End Function

    Private Function AccRegisterFlag(ByVal IAccReg As Long, ByVal i As Integer) As Boolean
        AccRegisterFlag = (IAccReg And 2 ^ i) = 2 ^ i
    End Function
    Private Function EndorseMaster(ByVal ANO As Long, ByVal Param As Object) As String
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim NEWANO As Long
        Dim RegNo As String
        Dim ADate As Date
        Dim PDate As Date
        Dim EMethod As String
        Dim LANO As Long
        Dim Remarks As String
        Dim Description As String
        Dim EEndorseF As Boolean
        Dim RefNo As String
        Dim RefDate As Date
        Dim Branch As String
        Dim TOC As String
        Dim CT As String
        Dim NoRefundF As Integer
        Dim WordingID As String
        Dim AllF As Boolean
        Dim CPercentage As Double
        Dim ASource As String
        Dim Reason As String
        Dim CNO As Long
        Dim PolicyType As String
        Dim ISType As String
        Dim rs As RemoteSet
        Dim NewCNO As Long
        Dim AdjustCoveragePeriodF As Boolean
        Dim AdjustFacultativePeriodF As Boolean
        Dim RefundType As String

        Dim AStatus As String
        Dim OpenFlag As Boolean
        Dim pANO As Long

        On Error GoTo errmsg
        RegNo = tostr(getInParamValue(Param, 0))
        ADate = todate(getInParamValue(Param, 1))
        PDate = todate(getInParamValue(Param, 2))
        EMethod = tostr(getInParamValue(Param, 3))
        LANO = toval(getInParamValue(Param, 4))
        Remarks = tostr(getInParamValue(Param, 5))
        CPercentage = toval(getInParamValue(Param, 6))
        Description = tostr(getInParamValue(Param, 7))
        EEndorseF = toval(getInParamValue(Param, 8))
        RefNo = tostr(getInParamValue(Param, 9))
        RefDate = todate(getInParamValue(Param, 10))
        NoRefundF = toval(getInParamValue(Param, 11))
        WordingID = tostr(getInParamValue(Param, 12))
        AllF = toval(getInParamValue(Param, 13))
        ASource = tostr(getInParamValue(Param, 14))
        AdjustCoveragePeriodF = toval(getInParamValue(Param, 15))
        Reason = tostr(getInParamValue(Param, 16))
        AdjustFacultativePeriodF = toval(getInParamValue(Param, 17))
        RefundType = tostr(getInParamValue(Param, 18))

        rs = db.OpenRemoteSet("Select Cover.CNO, Cover.OpenFlag, Acceptance.TOC, Acceptance.Branch, Acceptance.CT, Acceptance.pANO, Acceptance.AStatus, Cover.PolicyType, Cover.ISType from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        If rs.Eof Then
            StrMsg = "No Policy Data !"
            GoTo errmsg
        End If
        CNO = toval(rs.fields("CNO"))
        TOC = tostr(rs.fields("TOC"))
        PolicyType = tostr(rs.fields("PolicyType"))
        ISType = tostr(rs.fields("ISType"))
        Branch = tostr(rs.fields("Branch"))
        CT = tostr(rs.fields("CT"))
        AStatus = tostr(rs.fields("AStatus"))
        OpenFlag = toval(rs.fields("OpenFlag"))
        pANO = toval(rs.fields("pANO"))

        If AStatus = "I" Then
            If (ANO = LANO Or LANO = -1) And ASource = "MKT" Then
                rsSrc = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
                rsDst = db.OpenRemoteSet("Select * from Cover Where 1<>1")
                Dim NewCoverNo As String
                NewCoverNo = GetDocumentNumbering("COV", PolicyType, ISType, rsSrc.fields("CoverDate"), Branch, TOC, CT)
                If NewCoverNo = "" Then
                    StrMsg = "Generate Cover No./Quotation No. Failed !"
                    GoTo errmsg
                End If

                'Copy Cover & Related Information
                rsDst.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
                rsDst.fields("CoverNo") = NewCoverNo
                rsDst.fields("ASource") = ASource       ' Application Source
                rsDst.fields("CStatus") = "P"           ' Request Status
                rsDst.fields("UserID") = db_user
                rsDst.fields("CDate") = Today.Date
                rsDst.fields("CTime") = Time()
                rsDst.fields("LUserID") = db_user
                rsDst.fields("LDate") = Today.Date
                rsDst.fields("LTime") = Time()
                rsDst.fields("VSeqNo") = toval(rsSrc.fields("VSeqNo")) + 1
                rsDst.fields("ANO") = -1
                rsDst.fields("pCNO") = CNO
                rsDst.fields("FOLLOWUP") = ""

                rsDst.fields("PUserID") = db_user
                rsDst.fields("PUSerDate") = Today.Date
                rsDst.fields("PUserTime") = Time()

                rsDst.fields("CUserID") = ""
                rsDst.fields("CLoseDate") = ""
                rsDst.fields("CTime") = ""
                rsDst.fields("AUserID") = ""
                rsDst.fields("AUSerDate") = ""
                rsDst.fields("AUserTime") = ""
                NewCNO = db.GetIdentity("Cover") + 1
                rsDst.fields("CNO") = NewCNO
                If Not rsDst.Update Then GoTo errmsg
                If Not CopyCover(CNO, NewCNO, rsDst.fields("ISType")) Then GoTo errmsg
                rsSrc.CloseRemoteSet()
                rsDst.CloseRemoteSet()
            Else
                NewCNO = CNO
            End If

            rsSrc = db.OpenQueryDef("QAcceptance", adOpenForwardonly, ANO)
            If Not rsSrc.Eof Then
                If Not (AStatus = "I") Then
                    StrMsg = "Please Check Policy Data Status !"
                    GoTo errmsg
                End If

                If (rsSrc.fields("AType") = "C" And rsSrc.fields("EMethod") = "A") Then
                    ' Endorse over Cancellation All
                    If Not AdjustCoveragePeriodF Then
                        rs = db.OpenRemoteSet("Select Top 1 SDate, EDate from acceptance Where OANO=" & rsSrc.fields("OANO") & " and SDate>='" & Format(PDate, "MM/DD/YYYY") & "' Order By SDate")
                        If Not rs.Eof Then
                            ' If Earlier Than Inception Date
                            If DateDiff(DateInterval.Day, todate(rs.fields("SDate")), PDate) <= 0 Then
                                PDate = todate(rs.fields("SDate"))
                            End If
                        End If
                    End If
                End If

                ' If Greater Than Expiry Date
                If DateDiff(DateInterval.Day, todate(rsSrc.fields("EDate")), PDate) >= 0 Then
                    PDate = todate(rsSrc.fields("EDate"))
                End If

                rsDst = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
                rsDst.AddNew()
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg

                If ASource <> "MKT" Then
                    If RegNo = "" Then RegNo = GetDocumentNumbering("REG", PolicyType, ISType, ADate, Branch, TOC, CT)
                    If RegNo = "" Then
                        StrMsg = "Generate Register No./Closing Instruction No. Failed !"
                        GoTo errmsg
                    End If
                    Param(0) = RegNo
                End If
                rsDst.fields("RegNo") = RegNo
                rsDst.fields("RegDate") = ADate
                rsDst.fields("ADate") = ADate
                rsDst.fields("PDate") = PDate
                rsDst.fields("PPDate") = todate(rsSrc.fields("EDate"))
                rsDst.fields("pANO") = ANO
                rsDst.fields("Reason") = Reason
                rsDst.fields("Remarks") = Remarks
                rsDst.fields("Memo") = Description
                rsDst.fields("Comment") = ""
                rsDst.fields("AType") = "E"     ' Endorsement
                rsDst.fields("AStatus") = "W"   ' Waiting
                rsDst.fields("pAStatus") = ""           ' Previous Acceptance Status (AStatus)
                rsDst.fields("BSyncF") = False
                rsDst.fields("EMethod") = EMethod ' Endorse Underwriting
                rsDst.fields("ESeqNo") = toval(rsDst.fields("ESeqNo")) + 1
                rsDst.fields("RefNo") = tostr(RefNo)
                rsDst.fields("RefDate") = todate(RefDate)
                rsDst.fields("UserID") = db_user
                rsDst.fields("CDate") = Today.Date
                rsDst.fields("CTime") = Time()
                rsDst.fields("LUserID") = db_user
                rsDst.fields("LDate") = Today.Date
                rsDst.fields("LTime") = Time()                
                rsDst.fields("RefundType") = RefundType
                rsDst.fields("NoRefundF") = NoRefundF
                rsDst.fields("WordingID") = WordingID
                rsDst.fields("BackDatedF") = 0
                rsDst.fields("RequestF") = False
                rsDst.fields("RequestMessage") = ""
                rsDst.fields("RequestName") = ""
                rsDst.fields("CUserID") = ""
                rsDst.fields("CLoseDate") = ""
                rsDst.fields("CloseTime") = ""
                rsDst.fields("RUserID") = ""
                rsDst.fields("RUSerDate") = ""
                rsDst.fields("RUSerTime") = ""
                rsDst.fields("AUserID") = ""
                rsDst.fields("AUSerDate") = ""
                rsDst.fields("AUSerTime") = ""
                If EEndorseF Then
                    rsDst.fields("EESeqNo") = toval(rsDst.fields("EESeqNo")) + 1
                    rsDst.fields("EEndorseF") = 1
                Else
                    rsDst.fields("EEndorseF") = 0
                End If
                If EMethod = "S" Then
                    rsDst.fields("ERSeqNo") = toval(rsDst.fields("ERSeqNo")) + 1
                End If
                rsDst.fields("CPCT") = CPercentage
                NEWANO = db.GetIdentity("Acceptance") + 1
                rsDst.fields("SplitDNCNF") = False
                rsDst.fields("CNO") = NewCNO
                rsDst.fields("ANO") = NEWANO
                rsDst.fields("BatchNo") = ""
                rsDst.fields("BID") = 0
                rsDst.fields("ASource") = ""
                rsDst.fields("LANO") = NEWANO
                If Not rsDst.Update Then GoTo errmsg

                If Not CopyAcceptance(ANO, NEWANO, "E", True, AdjustFacultativePeriodF) Then GoTo errmsg

                ' Update Servicing
                rs = db.OpenRemoteSet("Select * from Service Where ANO=-1 and SType='ENDORSEMENT' and SStatus='P' and PANO=" & ANO)
                Do While Not rs.Eof
                    rs.Edit()
                    rs.fields("ANO") = NEWANO
                    rs.fields("CNO") = NewCNO
                    rs.fields("LANO") = NEWANO
                    If Not rs.Update Then GoTo errmsg
                    If Not Create_AccDA_from_Service(NEWANO, rs.fields("SNO")) Then GoTo errmsg
                    If Not Create_AccCA_from_Service(NEWANO, rs.fields("SNO")) Then GoTo errmsg
                    If Not Create_Payor_from_Service(NEWANO, rs.fields("SNO")) Then GoTo errmsg
                    rs.MoveNext()
                Loop

                ' Update Parameters from Reason Code
                Dim CompSheetF As Boolean
                Dim FDID As String
                rs = db.OpenRemoteSet("Select CompSheetF, FDID from Reason Where Reason='" & Reason & "'")
                CompSheetF = toval(rs.fields("CompSheetF"))
                FDID = tostr(rs.fields("FDID"))

                If CompSheetF Then
                    If Not db.Execute("Update AccCompSheetH Set Status='R' Where ANO=" & rsDst.fields("OANO")) Then GoTo errmsg
                End If

                If FDID <> "" Then
                    rs = db.OpenQueryDef("QFDTAB", adOpenForwardonly, FDID)
                    If Not rs.Eof Then
                        Dim rsFD As RemoteSet
                        rsFD = db.OpenRemoteSet("Select * from AccFD Where 1<>1")

                        rsFD.AddNew()
                        rsFD.fields("ANO") = NEWANO
                        rsFD.fields("ID") = "<Payor>"
                        rsFD.fields("FDID") = tostr(rs.fields("FDID"))
                        rsFD.fields("REMARK") = tostr(rs.fields("Description"))
                        rsFD.fields("Currency") = tostr(rs.fields("Currency"))
                        rsFD.fields("PolicyYear") = 0
                        rsFD.fields("Amount") = toval(rs.fields("Amount"))
                        rsFD.fields("LUserID") = db_user
                        rsFD.fields("LDate") = Today.Date
                        rsFD.fields("AutoGeneratedF") = False
                        If Not rsFD.Update Then GoTo errmsg

                        rsFD.CloseRemoteSet()
                    End If
                End If
                AStatus = "W"
            Else
                GoTo errmsg
            End If
            rsDst.CloseRemoteSet()
            rsSrc.CloseRemoteSet()
        Else
            NewCNO = CNO
            NEWANO = ANO
            ANO = pANO
        End If

        If AStatus = "W" AndAlso Not OpenFlag AndAlso AllF Then
            Param(4) = NEWANO
            ' Endorse All only for Inforced and not total loss
            Dim SQL As String = ""
            SQL = SQL & " Declare @P_LANO as Int"
            SQL = SQL & " Declare @P_PDate as smalldatetime"

            SQL = SQL & " Select @P_LANO=" & ANO
            SQL = SQL & " Select @P_PDate='" & Format(PDate, "MM/DD/YYYY") & "'"

            SQL = SQL & " Select A.RefNo, A.ANO "
            SQL = SQL & " from Acceptance A "
            SQL = SQL & " Left Join Acceptance pA on (pA.pANO=A.ANO) "
            SQL = SQL & " Where coalesce(pA.AStatus,'')='' and A.AType in ('N','E','C') "
            SQL = SQL & " and A.AStatus='I' "
            SQL = SQL & " and A.ANO<>A.LANO "
            SQL = SQL & " and A.PPDate>=@P_PDATE"
            SQL = SQL & " and A.LANO<>-1 "
            SQL = SQL & " and A.LANO=@P_LANO"
            SQL = SQL & " and not exists ("
            SQL = SQL & "   Select Top 1 A1.ANO"
            SQL = SQL & "   from Acceptance A1 "
            SQL = SQL & "   Inner Join Claim C1 on (C1.ANO=A1.ANO)"
            SQL = SQL & "   Inner Join CLLoss C2 on (C2.CNO=C1.CNO)"
            SQL = SQL & "   Inner Join ICover I on (I.INO=C2.INO)"
            SQL = SQL & "   Where A1.OANO = A.OANO"
            SQL = SQL & "   and C1.CType<>'C' and (C1.CSTATUS IN ('P','T','A') OR C1.PCSTATUS IN ('A')) "
            SQL = SQL & "   and not exists (Select pCNO from Claim Where Claim.pCNO=C1.CNO and Claim.CStatus<>'R')"
            SQL = SQL & "   and (C2.CTLF=1 and I.Category='M')"
            SQL = SQL & " )"

            rs = db.OpenRemoteSet(SQL)
            If Not rs.Eof Then
                db.Committrans()
                Do While Not rs.Eof
                    Param(2) = PDate
                    Param(9) = rs.fields("RefNo")
                    db.Begintrans()
                    If Endorsement(toval(rs.fields("ANO")), Param) = 0 Then GoTo errmsg
                    db.Committrans()
                    rs.MoveNext()
                Loop
                db.Begintrans()
            End If
        End If

        EndorseMaster = NEWANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        EndorseMaster = 0
    End Function
    Private Function ClosePolicy(ByVal ANO As Long, ByVal Param As Object, Optional ByVal EMethod As String = "") As Boolean
        Dim rs As RemoteSet
        Dim CNO As Long
        Dim LANO As Long
        Dim TDate As Date
        Dim Remarks As String
        Dim Validation As Integer
        Dim Reason As String

        On Error GoTo errmsg

        TDate = todate(getInParamValue(Param, 0))
        Remarks = tostr(getInParamValue(Param, 1))
        Validation = toval(getInParamValue(Param, 2))
        Reason = tostr(getInParamValue(Param, 3))


        rs = db.OpenQueryDef("QAcceptance", adOpenKeyset, ANO)
        If Not (tostr(rs.fields("AType")) = "N" And tostr(rs.fields("AStatus")) = "W") Then
            StrMsg = "Please Check Policy/Certificate Data Status !"
            GoTo errmsg
        End If
        CNO = toval(rs.fields("CNO"))
        LANO = toval(rs.fields("LANO"))
        rs.Edit()
        rs.fields("Reason") = Reason
        rs.fields("pAStatus") = rs.fields("AStatus")
        rs.fields("AStatus") = "C"
        rs.fields("Remarks") = Remarks
        rs.fields("CloseDate") = TDate
        rs.fields("CUserID") = db_user
        rs.fields("CloseTime") = Time()
        If Not rs.Update Then GoTo errmsg

        If ANO = LANO Or LANO = -1 Then
            rs = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
            rs.Edit()
            rs.fields("CloseDate") = TDate
            rs.fields("CUserID") = db_user
            rs.fields("CloseTime") = Time()
            rs.fields("FollowUp") = Remarks
            rs.fields("CStatus") = "C"
            rs.fields("Validation") = Validation
            If Not rs.Update Then GoTo errmsg
        End If

        If ANO = LANO Then
            rs = db.OpenQueryDef("QDetailAcceptance", adOpenKeyset, ANO)
            Do While Not rs.Eof
                If tostr(rs.fields("AType")) = "N" And tostr(rs.fields("AStatus")) = "W" Then
                    rs.Edit()
                    rs.fields("Reason") = Reason
                    rs.fields("pAStatus") = rs.fields("AStatus")
                    rs.fields("AStatus") = "C"
                    rs.fields("CloseDate") = TDate
                    rs.fields("CUserID") = db_user
                    rs.fields("CloseTime") = Time()
                    If Not rs.Update Then GoTo errmsg

                    If EMethod = "Q" Then ' Quotation Revision
                        If Not db.Execute("Update RArrHeader Set Status='R' Where Status='A' and ANO=" & toval(rs.fields("ANO"))) Then GoTo errmsg
                    Else
                        If Not UnReleaseAccRegAmount(toval(rs.fields("ANO")), True) Then GoTo errmsg
                    End If
                End If
                rs.MoveNext()
            Loop
        Else
            If EMethod = "Q" Then ' Quotation Revision
                If Not db.Execute("Update RArrHeader Set Status='R' Where Status='A' and ANO=" & ANO) Then GoTo errmsg
            Else
                If Not UnReleaseAccRegAmount(ANO, True) Then GoTo errmsg
            End If
        End If
        If Not db.Execute("Update Service Set SStatus='C' Where SType<>'Claim' and SStatus in ('P') and ANO=" & ANO) Then GoTo errmsg
        ClosePolicy = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        ClosePolicy = False
    End Function
    Private Function UnCloseQuotation(ByVal CNO As Long) As Boolean
        Dim rs As RemoteSet

        On Error GoTo errmsg

        rs = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        If Not (tostr(rs.fields("CStatus")) = "C") Then
            StrMsg = "Please Check Quotation Status !"
            GoTo errmsg
        End If
        rs.Edit()
        rs.fields("CStatus") = "P"
        rs.fields("CUserID") = ""
        rs.fields("CLoseDate") = ""
        rs.fields("CLoseTime") = ""
        If Not rs.Update Then GoTo errmsg

        rs = db.OpenRemoteSet("Select * from Acceptance Where CNO=" & CNO)
        Do While Not rs.Eof
            rs.Edit()
            rs.fields("AStatus") = "W"
            rs.fields("pAStatus") = ""
            rs.fields("CUserID") = ""
            rs.fields("CLoseDate") = ""
            rs.fields("CLoseTime") = ""
            If Not rs.Update Then GoTo errmsg
            If rs.fields("ANO") <> rs.fields("LANO") Then
                If Not ReleaseAccRegAmount(toval(rs.fields("ANO")), True) Then GoTo errmsg
            End If
            rs.MoveNext()
        Loop

        UnCloseQuotation = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UnCloseQuotation = False
    End Function

    Private Function Cancellation(ByVal ANO As Long, ByVal Param As Object) As String
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim NEWANO As Long
        Dim RegNo As String
        Dim ADate As Date
        Dim PDate As Date
        Dim OpenFlag As Boolean
        Dim LANO As Long
        Dim Remarks As String
        Dim CPercentage As Double
        Dim Description As String
        Dim EEndorseF As Boolean
        Dim RefNo As String
        Dim RefDate As Date
        Dim Branch As String
        Dim TOC As String
        Dim NoRefundF As Integer
        Dim WordingID As String
        Dim EMethod As String
        Dim Reason As String
        Dim CNO As Long
        Dim PolicyType As String
        Dim ISType As String
        Dim RefundType As String

        On Error GoTo errmsg

        RegNo = tostr(getInParamValue(Param, 0))
        ADate = todate(getInParamValue(Param, 1))
        PDate = todate(getInParamValue(Param, 2))
        OpenFlag = toval(getInParamValue(Param, 3))
        LANO = toval(getInParamValue(Param, 4))
        Remarks = tostr(getInParamValue(Param, 5))
        CPercentage = toval(getInParamValue(Param, 6))
        Description = tostr(getInParamValue(Param, 7))
        EEndorseF = toval(getInParamValue(Param, 8))
        RefNo = tostr(getInParamValue(Param, 9))
        RefDate = todate(getInParamValue(Param, 10))
        Branch = tostr(getInParamValue(Param, 11))
        TOC = tostr(getInParamValue(Param, 12))
        NoRefundF = toval(getInParamValue(Param, 13))
        WordingID = tostr(getInParamValue(Param, 14))
        EMethod = tostr(getInParamValue(Param, 15))
        Reason = tostr(getInParamValue(Param, 16))
        RefundType = tostr(getInParamValue(Param, 17))

        If LANO <> -1 Then
            rsSrc = db.OpenRemoteSet("Select Cover.CNO, Cover.PolicyType, Cover.ISType, Acceptance.RegNo from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & LANO)
            ' RegNo Certificate Follows Master
            RegNo = rsSrc.fields("RegNo")
        Else
            rsSrc = db.OpenRemoteSet("Select Cover.CNO, Cover.PolicyType, Cover.ISType, Acceptance.RegNo from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        End If

        If rsSrc.Eof Then
            StrMsg = "No Policy Data !"
            GoTo errmsg
        End If

        CNO = toval(rsSrc.fields("CNO"))
        PolicyType = tostr(rsSrc.fields("PolicyType"))
        ISType = tostr(rsSrc.fields("ISType"))

        'Copy Acceptance & Related Information
        rsSrc = db.OpenQueryDef("QAcceptance", adOpenForwardonly, ANO)
        If Not rsSrc.Eof Then

            If Not (rsSrc.fields("AStatus") = "I" And rsSrc.fields("AType") <> "C") Then
                StrMsg = "Please Check Policy Data Status !"
                GoTo errmsg
            End If
            rsDst = db.OpenRemoteSet("Select * from Acceptance Where 1<>1")
            ' Check The Effective Date

            If EMethod <> "A" Then
                ' If Earlier than Current Effective Date and Not Cancellation from Beginning
                If DateDiff(DateInterval.Day, todate(rsSrc.fields("PDate")), PDate) <= 0 Then
                    PDate = todate(rsSrc.fields("PDate"))
                End If

                ' If Earlier Than Inception Date
                If DateDiff(DateInterval.Day, todate(rsSrc.fields("SDate")), PDate) <= 0 Then
                    PDate = todate(rsSrc.fields("SDate"))
                End If
            End If

            ' If Greater Than Expiry Date
            If DateDiff(DateInterval.Day, todate(rsSrc.fields("EDate")), PDate) >= 0 Then
                PDate = todate(rsSrc.fields("EDate"))
            End If

            rsDst.AddNew()
            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            If RegNo = "" Then RegNo = GetDocumentNumbering("REG", PolicyType, ISType, ADate, Branch, TOC, tostr(rsSrc.fields("CT")))
            If RegNo = "" Then
                StrMsg = "Generate Register No./Closing Instruction No. Failed !"
                GoTo errmsg
            End If
            rsDst.fields("RegNo") = RegNo
            rsDst.fields("RegDate") = ADate
            rsDst.fields("ADate") = ADate
            rsDst.fields("PDate") = PDate
            rsDst.fields("PPDate") = PDate
            rsDst.fields("Remarks") = tostr(Remarks)
            rsDst.fields("Memo") = tostr(Description)
            rsDst.fields("Comment") = ""
            rsDst.fields("AType") = "C"
            rsDst.fields("AStatus") = "W"
            rsDst.fields("pAStatus") = ""           ' Previous Acceptance Status (AStatus)
            rsDst.fields("PANO") = ANO
            rsDst.fields("LANO") = LANO
            rsDst.fields("BSyncF") = 0
            rsDst.fields("RefNo") = tostr(RefNo)
            rsDst.fields("RefDate") = todate(RefDate)
            rsDst.fields("UserID") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("CTime") = Time()
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date
            rsDst.fields("LTime") = Time()
            rsDst.fields("ESeqNo") = toval(rsDst.fields("ESeqNo")) + 1
            If EEndorseF Then
                rsDst.fields("EESeqNo") = toval(rsDst.fields("EESeqNo")) + 1
                rsDst.fields("EEndorseF") = 1
            Else
                rsDst.fields("EEndorseF") = 0
            End If
            rsDst.fields("EMethod") = EMethod
            rsDst.fields("NoRefundF") = NoRefundF
            rsDst.fields("RefundType") = RefundType
            rsDst.fields("WordingID") = WordingID
            rsDst.fields("BackDatedF") = 0
            rsDst.fields("RequestF") = False
            rsDst.fields("RequestMessage") = ""
            rsDst.fields("RequestName") = ""
            rsDst.fields("Reason") = Reason
            rsDst.fields("CPCT") = CPercentage
            rsDst.fields("CUserID") = ""
            rsDst.fields("CLoseDate") = ""
            rsDst.fields("CloseTime") = ""
            rsDst.fields("RUserID") = ""
            rsDst.fields("RUSerDate") = ""
            rsDst.fields("RUSerTime") = ""
            rsDst.fields("AUserID") = ""
            rsDst.fields("AUSerDate") = ""
            rsDst.fields("AUSerTime") = ""
            NEWANO = db.GetIdentity("Acceptance") + 1
            rsDst.fields("SplitDNCNF") = False
            rsDst.fields("ANO") = NEWANO
            rsDst.fields("BatchNo") = ""
            rsDst.fields("BID") = 0
            rsDst.fields("ASource") = ""
            rsDst.fields("CNO") = CNO
            If Not rsDst.Update Then GoTo errmsg

            ' Update Servicing
            Dim rs As RemoteSet
            rs = db.OpenRemoteSet("Select * from Service Where ANO=-1 and SType='CANCELLATION' and SStatus='P' and PANO=" & ANO)
            Do While Not rs.Eof
                rs.Edit()
                rs.fields("ANO") = NEWANO
                rs.fields("CNO") = rsDst.fields("CNO")
                rs.fields("LANO") = LANO
                If Not rs.Update Then GoTo errmsg
                rs.MoveNext()
            Loop

            If Not CopyAcceptance(ANO, NEWANO, "C", False) Then GoTo errmsg

            ' Update Parameters from Reason Code
            Dim FDID As String
            rs = db.OpenRemoteSet("Select FDID from Reason Where Reason='" & Reason & "'")
            FDID = tostr(rs.fields("FDID"))

            If FDID <> "" And (LANO = -1 Or OpenFlag) Then
                rs = db.OpenQueryDef("QFDTAB", adOpenForwardonly, FDID)
                If Not rs.Eof Then
                    Dim rsFD As RemoteSet
                    rsFD = db.OpenRemoteSet("Select * from AccFD Where 1<>1")

                    rsFD.AddNew()
                    rsFD.fields("ANO") = NEWANO
                    rsFD.fields("ID") = "<Payor>"
                    rsFD.fields("FDID") = tostr(rs.fields("FDID"))
                    rsFD.fields("REMARK") = tostr(rs.fields("Description"))
                    rsFD.fields("Currency") = tostr(rs.fields("Currency"))
                    rsFD.fields("PolicyYear") = 0
                    rsFD.fields("Amount") = toval(rs.fields("Amount"))
                    rsFD.fields("LUserID") = db_user
                    rsFD.fields("LDate") = Today.Date
                    rsFD.fields("AutoGeneratedF") = False
                    If Not rsFD.Update Then GoTo errmsg

                    rsFD.CloseRemoteSet()
                End If
            End If

            ' Hold Cession for Cancellation
            Dim Message As String = ""

            ' Any Facultative Placement
            If db.GetPrivileges("FORCEHOLDCANCELLATIONWITHFACULTATIVE") And db.GetUserType <> "SUPERVISOR" Then
                ' with or without Precede Facultative
                rs = db.OpenRemoteSet("Select Top 1 RArrDet.FID from RArrDet Where RArrDet.RType in ('F','AF') and RArrDet.Status='R' and RArrDet.ANO=" & NEWANO)
            Else
                ' Only for not Precede Facultative
                rs = db.OpenRemoteSet("Select Top 1 RArrDet.FID from RArrDet Where RArrDet.PrecedeFacCessionF=0 and RArrDet.RType in ('F','AF') and RArrDet.Status='R' and RArrDet.ANO=" & NEWANO)
            End If
            If Not rs.Eof Then
                If Message <> "" Then Message = Message & Chr(13) & Chr(10)
                Message = Message & "Please Check Facultative Cession ! "
            End If

            ' Mortgage Policies
            rs = db.OpenRemoteSet("Select Top 1 I.ID from Inparty I, Acceptance A Where I.CNO=A.CNO and I.IType='MORTGAGE' and A.ANO=" & NEWANO)
            If Not rs.Eof Then
                If Message <> "" Then Message = Message & Chr(13) & Chr(10)
                Message = Message & "Please Check Mortgage Policy !"
            End If

            If Message <> "" Then
                rs = db.OpenRemoteSet("Select * from RArrHeader Where ANO=" & NEWANO)
                rs.Edit()
                rs.fields("HoldF") = True
                rs.fields("Message") = Message
                If Not rs.Update Then GoTo errmsg
            End If
        Else
            GoTo errmsg
        End If

        rsSrc.CloseRemoteSet()
        rsDst.CloseRemoteSet()

        Cancellation = NEWANO
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Cancellation = 0
    End Function
    Private Function CancelMaster(ByVal ANO As Long, ByVal Param As Object) As String
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim NEWANO As Long
        Dim RegNo As String
        Dim ADate As Date
        Dim PDate As Date
        Dim OpenFlag As Boolean
        Dim LANO As Long
        Dim Remarks As String
        Dim CPercentage As Double
        Dim Description As String
        Dim EEndorseF As Boolean
        Dim RefNo As String
        Dim RefDate As Date
        Dim Branch As String
        Dim TOC As String
        Dim NoRefundF As Integer
        Dim WordingID As String
        Dim EMethod As String
        Dim Reason As String
        Dim RefundType As String

        On Error GoTo errmsg
        RegNo = tostr(getInParamValue(Param, 0))
        ADate = todate(getInParamValue(Param, 1))
        PDate = todate(getInParamValue(Param, 2))
        OpenFlag = toval(getInParamValue(Param, 3))
        LANO = toval(getInParamValue(Param, 4))
        Remarks = tostr(getInParamValue(Param, 5))
        CPercentage = toval(getInParamValue(Param, 6))
        Description = tostr(getInParamValue(Param, 7))
        EEndorseF = toval(getInParamValue(Param, 8))
        RefNo = tostr(getInParamValue(Param, 9))
        RefDate = todate(getInParamValue(Param, 10))
        Branch = tostr(getInParamValue(Param, 11))
        TOC = tostr(getInParamValue(Param, 12))
        NoRefundF = toval(getInParamValue(Param, 13))
        WordingID = tostr(getInParamValue(Param, 14))
        EMethod = tostr(getInParamValue(Param, 15))
        Reason = tostr(getInParamValue(Param, 16))
        RefundType = tostr(getInParamValue(Param, 17))

        'Copy Acceptance & Related Information

        rsSrc = db.OpenQueryDef("QAcceptance", adOpenForwardonly, ANO)
        If Not rsSrc.Eof Then
