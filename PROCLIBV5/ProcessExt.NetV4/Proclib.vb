    Private Function Adjust_RCover(ByVal ANO As Long, ByVal pSDate As Date, ByVal pEDate As Date, ByVal SDate As Date, ByVal EDate As Date, ByVal VOYAGE As Boolean, ByVal PTerm As Integer, ByVal TOC As String, Optional ByVal sFilterCode As String = "") As Boolean
        Dim rs As RemoteSet
        Dim rsD As RemoteSet
        Dim rsR As RemoteSet
        Dim RSDate As Date
        Dim REDate As Date
        Dim NCDate As Date
        Dim Code As String

        On Error GoTo errmsg
        ' Adjust Risk Cover
        If sFilterCode <> "" Then
            rs = db.OpenRemoteSet("Select * from RCover Where ANO=" & ANO & " and Code in " & sFilterCode & " Order by ANO, Code, SDate")
            If Not db.Execute("Select * into #RCoverDet from RCoverDet Where ANO=" & ANO & " and Code in " & sFilterCode) Then GoTo errmsg
            If Not db.Execute("Delete from RCover Where ANO=" & ANO & " and Code in " & sFilterCode) Then GoTo errmsg
        Else
            rs = db.OpenRemoteSet("Select * from RCover Where ANO=" & ANO & " Order by ANO, Code, SDate")
            If Not db.Execute("Select * into #RCoverDet from RCoverDet Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from RCover Where ANO=" & ANO) Then GoTo errmsg
        End If
        Do While Not rs.Eof
            Code = rs.fields("Code")
            RSDate = rs.fields("SDate")
            REDate = rs.fields("EDate")
            NCDate = rs.fields("NCDate")

            If VOYAGE Then
                If NCDate = RSDate Then NCDate = SDate
                RSDate = SDate
                REDate = EDate

                If DateDiff(DateInterval.Day, NCDate, RSDate) > 0 Then
                    NCDate = RSDate
                End If
            Else
                If (Day(SDate) = Day(EDate) And Day(RSDate) = Day(REDate) And DateDiff(DateInterval.Month, SDate, EDate) = DateDiff(DateInterval.Month, RSDate, REDate)) Or (DateDiff(DateInterval.Day, SDate, EDate) = DateDiff(DateInterval.Day, RSDate, REDate)) Or (RSDate = pSDate And REDate = pEDate) Then
                    If NCDate = RSDate Then NCDate = SDate
                    RSDate = SDate
                    REDate = EDate
                ElseIf (Day(SDate) = Day(EDate) And Day(RSDate) = Day(REDate) And Day(pSDate) = Day(pEDate) And Day(RSDate) = Day(pSDate) And DateDiff(DateInterval.Month, SDate, EDate) = DateDiff(DateInterval.Month, pSDate, pEDate)) Then
                    ' Split Risk
                    Dim NumMonthR As Integer
                    Dim NumMonthP As Integer
                    NumMonthR = DateDiff(DateInterval.Month, RSDate, REDate)
                    NumMonthP = DateDiff(DateInterval.Month, pSDate, SDate)
                    If NCDate = RSDate Then
                        NCDate = DateSerial(Year(RSDate), Month(RSDate), Day(SDate))
                        NCDate = DateAdd(DateInterval.Month, NumMonthP, NCDate)
                    End If
                    RSDate = DateSerial(Year(RSDate), Month(RSDate), Day(SDate))
                    RSDate = DateAdd(DateInterval.Month, NumMonthP, RSDate)
                    REDate = DateAdd(DateInterval.Month, NumMonthR, RSDate)
                End If

                If DateDiff(DateInterval.Day, RSDate, SDate) > 0 Then
                    If NCDate = RSDate Then NCDate = SDate
                    RSDate = SDate
                End If

                If DateDiff(DateInterval.Day, REDate, EDate) < 0 Then
                    REDate = EDate
                End If

                If DateDiff(DateInterval.Day, RSDate, REDate) <= 0 Then
                    REDate = RSDate
                End If

                If DateDiff(DateInterval.Day, NCDate, RSDate) > 0 Then
                    NCDate = RSDate
                End If
            End If
            If RSDate <> REDate Then
                rsR = db.OpenRemoteSet("Select * from RCover Where ANO=" & ANO & " and Code='" & Code & "' and SDate='" & Format(RSDate, "MM/DD/YYYY") & "'")
                If rsR.Eof Then
                    rsR.AddNew()
                    If Not rsR.PutRecord(rs.GetRecord()) Then GoTo errmsg

                    If DateDiff(DateInterval.Day, rsR.fields("SDate"), RSDate) <> 0 Then
                        rsR.fields("SDate") = RSDate
                        rsR.fields("PProrata") = 0
                    End If

                    If DateDiff(DateInterval.Day, rsR.fields("EDate"), REDate) <> 0 Then
                        rsR.fields("EDate") = REDate
                        rsR.fields("PProrata") = 0
                    End If

                    rsR.fields("NCDate") = NCDate
                    If VOYAGE Then
                        rsR.fields("DepartDate") = RSDate
                        rsR.fields("TransDate") = RSDate
                        rsR.fields("ArrivalDate") = REDate
                    End If
                    If VOYAGE Then ' Voyage
                        rsR.fields("PCalc") = "F"
                        rsR.fields("PProrata") = 0
                    Else
                        If rsR.fields("PCALC") = "" Or (rsR.fields("PCALC") = "S" AndAlso toval(rsR.fields("PProrata")) = 0) Then
                            Select Case DateDiff(DateInterval.Month, RSDate, REDate)
                                Case Is < PTerm
                                    Dim Scaling As Double
                                    Scaling = Short_Period_Calc(TOC, RSDate, REDate, REDate)
                                    If Scaling <> 0 And Scaling <> 100 Then
                                        rsR.fields("PCalc") = "S"
                                        rsR.fields("PProrata") = Scaling
                                    Else
                                        rsR.fields("PCalc") = "P"
                                        rsR.fields("PProrata") = 0
                                    End If
                                Case PTerm
                                    If DateAdd(DateInterval.Month, PTerm, RSDate) <> REDate Then
                                        rsR.fields("PCalc") = "P"
                                        rsR.fields("PProrata") = 0
                                    Else
                                        rsR.fields("PCalc") = "F"
                                        rsR.fields("PProrata") = 0
                                    End If
                                Case Is > PTerm
                                    rsR.fields("PCalc") = "P"
                                    rsR.fields("PProrata") = 0
                            End Select
                        ElseIf rsR.fields("PCALC") = "P" Then
                            Select Case DateDiff(DateInterval.Month, RSDate, REDate)
                                Case Is < PTerm
                                    rsR.fields("PCalc") = "P"
                                    rsR.fields("PProrata") = 0
                                Case PTerm
                                    If DateAdd(DateInterval.Month, PTerm, RSDate) <> REDate Then
                                        rsR.fields("PCalc") = "P"
                                        rsR.fields("PProrata") = 0
                                    Else
                                        rsR.fields("PCalc") = "F"
                                        rsR.fields("PProrata") = 0
                                    End If
                                Case Is > PTerm
                                    rsR.fields("PCalc") = "P"
                                    rsR.fields("PProrata") = 0
                            End Select
                        End If
                    End If
                    If toval(rsR.fields("Rate")) = 0 Then
                        Dim InParam() As Object = {ANO, rsR.fields("Code"), rsR.fields("Unit"), rsR.fields("SDate"), rsR.fields("PCTLOSS")}
                        Dim OutParam As Object = Nothing
                        If GetPremiumRate(InParam, OutParam, StrMsg) Then
                            Dim BRate As Double = OutParam(0)
                            Dim Loading As Double = OutParam(1)
                            Dim PCTLOSS As Double = OutParam(2)
                            Dim SRate As Double = OutParam(3)
                            Dim TExcess As Double = OutParam(4)
                            Dim PCALC As String = OutParam(5)
                            Dim PremiumRate As Double = BRate + SRate

                            If PremiumRate <> 0 Then
                                rsR.fields("BRate") = BRate
                                rsR.fields("SRate") = SRate
                                rsR.fields("Rate") = PremiumRate
                                If PCALC <> "" Then
                                    rsR.fields("PCALC") = PCALC
                                End If
                                rsR.fields("Loading") = Loading
                                rsR.fields("TExcess") = TExcess
                                If rsR.fields("PCTLOSS") = 100 AndAlso PCTLOSS <> 100 Then
                                    rsR.fields("PCTLOSS") = PCTLOSS
                                End If
                            End If
                        End If
                    Else
                        rsR.fields("Loading") = Get_RateLoading(ANO, rsR.fields("Code"), SDate)
                    End If
                    If Not rsR.Update Then GoTo errmsg
                End If
                ' Risk Cover Detail
                rsD = db.OpenRemoteSet("Select * from #RCoverDet Where ANO=" & ANO & " and Code='" & Code & "' and SDate='" & Format(rs.fields("SDate"), "MM/DD/YYYY") & "'")
                If Not rsD.Eof Then
                    rsR = db.OpenRemoteSet("Select * from RCoverDet Where 1<>1")
                    Do While Not rsD.Eof
                        rsR.AddNew()
                        If Not rsR.PutRecord(rsD.GetRecord()) Then GoTo errmsg
                        rsR.fields("SDate") = RSDate
                        If Not rsR.Update Then GoTo errmsg
                        rsD.MoveNext()
                    Loop
                End If
            End If
            rs.MoveNext()
        Loop
        db.Execute("Drop Table #RCoverDet")
        Adjust_RCover = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        db.Execute("Drop Table #RCoverDet")
        Adjust_RCover = False
    End Function
    Private Function Adjust_Deductible(ByVal ANO As Long, ByVal sdate As Date, ByVal eDate As Date) As Boolean
        Dim rs As RemoteSet

        On Error GoTo errmsg
        ' Adjust Deductible
        rs = db.OpenRemoteSet("Select * from AccDed Where ANO=" & ANO)
        Do While Not rs.Eof
            rs.Edit()
            If toval(rs.fields("PolicyYear")) = 0 Then
                rs.fields("SDate") = sdate
                rs.fields("EDate") = eDate
            Else
                rs.fields("SDate") = DateAdd(DateInterval.Month, 12 * (toval(rs.fields("PolicyYear")) - 1), sdate)
                rs.fields("EDate") = DateAdd(DateInterval.Month, 12 * (toval(rs.fields("PolicyYear"))), sdate)
            End If
            If Not rs.Update Then GoTo errmsg
            rs.MoveNext()
        Loop
        Adjust_Deductible = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Adjust_Deductible = False
    End Function
