    Private Function Create_Facultative_from_Service(ByVal ANO As Long, ByVal SNO As Long) As Boolean
        Dim rsSrc As RemoteSet
        Dim rs As RemoteSet

        Dim FID As String
        Dim SlipNo As String
        Dim DocNo As String
        Dim JPSlipNo As String
        Dim AType As String
        On Error GoTo errmsg
        rsSrc = db.OpenRemoteSet("Select SRArrDet.*, SFPart.ID, SFPart.Share, SFPart.SlipNo, SFPart.WPC, SFPart.Grace, SFPart.Currency, SFPart.CommAmount, SFPart.Unit, SFPart.Comm, SFPart.NetRate, SFPart.Remarks from SRArrDet, SFPart Where SFPart.SNO=SRArrDet.SNO and SFPart.FID=SRArrDet.FID and SRArrDet.SNO=" & SNO)
        Do While Not rsSrc.Eof
            FID = rsSrc.fields("FID")
            SlipNo = rsSrc.fields("SlipNo")
            DocNo = rsSrc.fields("DocNo")
            JPSlipNo = rsSrc.fields("JPSlipNo")
            rs = db.OpenRemoteSet("Select * from RArrDet Where ANO=" & ANO & " and FID = '" & rsSrc.fields("FID") & "'")
            If rs.Eof Then
                rs = db.OpenRemoteSet("Select Acceptance.OANO, Acceptance.TOC, Cover.PolicyType, Cover.ISType, Acceptance.Branch, Acceptance.CT from Cover,Acceptance where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
                If Not rs.Eof Then
                    If FID = "" Then
                        FID = GetDocumentNumbering("FS", tostr(rs.fields("PolicyType")), tostr(rs.fields("ISType")), Today.Date, tostr(rs.fields("Branch")), tostr(rs.fields("TOC")), tostr(rs.fields("CT")))
                        If FID = "" Then
                            StrMsg = "Generate Facultative ID Failed !"
                            GoTo errmsg
                        End If
                    End If

                    If SlipNo = "" Then
                        If DocNo <> "" Then
                            SlipNo = DocNo & "-" & Format(db.GetIdentity(Format(rs.fields("OANO"), "0000000000") + "-" + DocNo) + 1, "000")
                        Else
                            SlipNo = FID
                        End If
                    End If
                    If JPSlipNo = "" Then JPSlipNo = SlipNo
                End If
                rs = db.OpenRemoteSet("Select * from RArrDet Where 1<>1")
                rs.AddNew()
                rs.fields("ANO") = ANO
                rs.fields("FID") = FID
                rs.fields("AType") = "N"
                rs.fields("UserID") = db_user
                rs.fields("CDate") = Today.Date
            Else
                rs.Edit()
            End If

            AType = tostr(rs.fields("AType"))
            FID = tostr(rs.fields("FID"))
            rs.fields("Status") = "O"
            rs.fields("SDate") = todate(rsSrc.fields("SDate"))
            rs.fields("EDate") = todate(rsSrc.fields("EDate"))
            rs.fields("RType") = rsSrc.fields("RType")
            rs.fields("Share") = rsSrc.fields("Share")
            rs.fields("FLPCT") = toval(rsSrc.fields("FLPCT"))
            rs.fields("CurrencyL") = rsSrc.fields("CurrencyL")
            rs.fields("RateL") = toval(rsSrc.fields("RateL"))
            rs.fields("Amount") = toval(rsSrc.fields("Amount"))
            rs.fields("Limit") = toval(rsSrc.fields("Limit"))
            rs.fields("Excess") = toval(rsSrc.fields("Excess"))
            rs.fields("Retention") = toval(rsSrc.fields("Retention"))
            rs.fields("PCalc") = rsSrc.fields("PCalc")
            rs.fields("CPCT") = toval(rsSrc.fields("CPCT"))
            rs.fields("CPRefund") = toval(rsSrc.fields("CPRefund"))
            rs.fields("FullCoverF") = toval(rsSrc.fields("FullCoverF"))
            rs.fields("OriginalF") = True
            rs.fields("OnGrossAfterCommF") = toval(rsSrc.fields("OnGrossAfterCommF"))
            rs.fields("OnNetRateF") = toval(rsSrc.fields("OnNetRateF"))
            rs.fields("UJROHREINS") = toval(rsSrc.fields("UJROHREINS"))
            rs.fields("UJROHCEDANT") = toval(rsSrc.fields("UJROHCEDANT"))
            rs.fields("Memo") = rsSrc.fields("Memo")
            rs.fields("AcceptedBy") = rsSrc.fields("AcceptedBy")
            rs.fields("AcceptedDate") = todate(rsSrc.fields("AcceptedDate"))
            rs.fields("ClaimCoop") = toval(rsSrc.fields("ClaimCoop"))
            rs.fields("PrecedeFacCessionF") = toval(rsSrc.fields("PrecedeFacCessionF"))
            rs.fields("NoRefundF") = toval(rsSrc.fields("NoRefundF"))
            rs.fields("LUserID") = db_user
            rs.fields("LDate") = Today.Date
            rs.fields("JPSlipNo") = JPSlipNo
            rs.fields("JPShare") = toval(rsSrc.fields("JPShare"))
            rs.fields("JPComm") = toval(rsSrc.fields("JPComm"))
            rs.fields("SysUserID") = rsSrc.fields("SysUserID")
            rs.fields("NotApplyDiscountCFF") = toval(rsSrc.fields("NotApplyDiscountCFF"))
            If Not rs.Update Then GoTo errmsg


            rs = db.OpenRemoteSet("Select * from FPart Where ANO=" & ANO & " and FID='" & FID & "'")
            If rs.Eof Then
                rs.AddNew()
