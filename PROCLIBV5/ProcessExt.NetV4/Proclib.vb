        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select PANO from Acceptance Where ANO=LANO and ANO=" & ANO)
        PANO = rs.fields("PANO")

        rs = db.OpenRemoteSet("Select ANO, PANO from Acceptance Where ANO<>LANO and LANO=" & ANO)
        Do While Not rs.Eof
            If Not DropAcceptanceDetail(toval(rs.fields("ANO"))) Then GoTo errmsg
            rs.MoveNext()
        Loop
        If Not DropAcceptance(CNO, ANO) Then GoTo errmsg

        If PANO <> -1 Then
            rs = db.OpenRemoteSet("Select Max(CNO) as CNO, Max(CertificateNo) as CertNum from Acceptance Where ANO<>LANO and LANO=" & PANO)
            If Not db.Execute("Update Cover Set CertNum=" & toval(rs.fields("CertNum")) & " Where CNO=" & toval(rs.fields("CNO"))) Then GoTo errmsg
            ' Here
        End If

        DropMaster = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        DropMaster = False
    End Function
    Private Function DropAcceptanceDetail(ByVal ANO As Long) As Boolean
        Dim rs As RemoteSet
        Dim AType As String
        Dim EMethod As String
        Dim FLDID As String
        Dim ValueID As String
        Dim CNO As Long
        Dim CertificateNo As String
        Dim CertNum As Long
        Dim pANO As Long
        Dim LANO As Long
        Dim AStatus As String

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select AType, AStatus, EMethod, FLDID, VALUEID, CNO, PANO, LANO, RANO, Renewal, RegNo, PolicyNo, CertificateNo from Acceptance Where ANO=" & ANO)
        AType = tostr(rs.fields("AType"))
        AStatus = tostr(rs.fields("AStatus"))
        EMethod = tostr(rs.fields("EMethod"))
        FLDID = tostr(rs.fields("FLDID"))
        ValueID = tostr(rs.fields("VALUEID"))
        CNO = toval(rs.fields("CNO"))
        CertificateNo = tostr(rs.fields("CertificateNo"))
        CertNum = toval(rs.fields("CertificateNo"))
        pANO = toval(rs.fields("pANO"))
        LANO = toval(rs.fields("LANO"))
        If Not (AStatus = "W") Then
            StrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        'Create Log Object
        If Not Save_Log_Object("Acceptance", "ANO", ANO, "RegNo", rs.fields("RegNo"), "PolicyNo", rs.fields("PolicyNo"), "CertificateNo", rs.fields("CertificateNo"), "", "", "", "Delete") Then GoTo errmsg

        If AType = "N" And toval(rs.fields("Renewal")) > 0 Then
            If Not db.Execute("Update Acceptance Set RenewableF=1 Where ANO=" & toval(rs.fields("RANO"))) Then GoTo errmsg
            If Not db.Execute("Update Renewal Set Status='O',NEWANO=-1 Where ANO=" & toval(rs.fields("RANO"))) Then GoTo errmsg
        End If
        rs.CloseRemoteSet()

        If AType <> "A" Then
            If Not UnReleaseAccRegAmount(ANO, True) Then GoTo errmsg

            If pANO <> -1 Then
                If Not db.Execute("Update Acceptance Set CANO=" & pANO & ", ConjunctionF=1 Where CANO=" & ANO) Then GoTo errmsg

                ' Set Master Acceptance ANO Reference for Previous Acceptance When Master Policy Already Inforced
                If Not db.Execute("Update Acceptance Set LANO=" & LANO & " from Acceptance, Acceptance mAcceptance Where Acceptance.LANO<>mAcceptance.ANO and mAcceptance.AStatus='I' and mAcceptance.ANO=" & LANO & " and Acceptance.ANO=" & pANO) Then GoTo errmsg
            Else
                If Not db.Execute("Update Acceptance Set CANO=" & pANO & ", ConjunctionF=0 Where CANO=" & ANO) Then GoTo errmsg
            End If
        End If

        If AType = "N" Then
            ' Update Cover CertNum into Last CertificateNo
            If Not db.Execute("Update C Set CertNum=coalesce(A.CertNum,0) from Cover C Outer Apply (Select Max(cast(A.CertificateNo as Int)) as CertNum from Cover OC Inner Join Acceptance A on (A.CNO=Oc.CNO and A.LANO<>-1 and A.ANO<>A.LANO and A.ANO<>" & ANO & " and isnumeric(A.CertificateNo)=1) Where Oc.OCNO=C.OCNO) A Where C.CNO=" & CNO) Then GoTo errmsg
        End If

        If Not db.Execute("Drop_Acceptance_Link " & ANO) Then GoTo errmsg
        If Not db.Execute("Delete From Acceptance Where AStatus='W' and Acceptance.ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg

        ' Undo Verify Scheme Transaction
        If Not db.Execute("Update S Set ANO=-1, Status='O', Premium=0, FDAMOUNT_1=0, FDAMOUNT_2=0 from Scheme_Transaction S Where S.ANO=" & ANO) Then GoTo errmsg

        ' Check if The Data Already Referred by Claim
        rs = db.OpenRemoteSet("Select ANO from Claim Where ANO=" & ANO, adOpenForwardonly)
        If Not rs.Eof Then GoTo errmsg

        If EMethod = "T" AndAlso FLDID <> "" AndAlso ValueID <> "" Then
            ' Set to In-Consistent for others with the same accumulation register
            If Not db.Execute("Update Acceptance Set pStatus='I' where Acceptance.FLDID='" & FLDID & "' and Acceptance.ValueID='" & ValueID & "' and Acceptance.AStatus='W'") Then GoTo errmsg
        End If

        If Not db.Execute("Update Service Set ANO=-1, LANO=-1, CNO=-1 from Service Where ANO=" & ANO) Then GoTo errmsg
        If Not db.Execute("Update SysRequest Set Status='P',LUserID='" & db_user & "', LUserDate='" & Format(Today.Date, "MM/DD/YYYY") & "',LUserTime='" & Time() & "' from SysRequest Where Status<>'P' and Param1='SEND' and Param2 in ('UND','UND-MW','IT','MAR') and Param3=" & ANO) Then GoTo errmsg
        DropAcceptanceDetail = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        DropAcceptanceDetail = False
    End Function
    Private Function Check_RateCon(ByVal ANO As Long) As Boolean
        Try
            Dim HoldF As Boolean = False
            Dim HoldMessage As String = ""
            Dim CID As String = ""

            Dim rs As RemoteSet
            Dim SQL As String
            SQL = " Select A.TOC, R1.Code, R1.SDate, "
            SQL = SQL & " MAX(A.REGID) as REGID, "
            SQL = SQL & " MAX(A.FLDID) as FLDID, "
            SQL = SQL & " MAX(A.VALUEID) as VALUEID,"
            SQL = SQL & " MAX(C.PHOLDER) as PHOLDER,"
            SQL = SQL & " MAX(A.AID) as AID,"
            SQL = SQL & " Max(TOPRO.TOPRO) as TOPRO,"
            SQL = SQL & " Max(TOPRO.CheckRateConSIBy) as CheckRateConSIBy, "
            SQL = SQL & " Max(A.SDate) as Inception, "
            SQL = SQL & " Max(AINFODET.TERMOFPMT) as TERMOFPMT, "
            SQL = SQL & " Max(TERMOFPMTTYPE.TERMOFPMTTYPE) as TERMOFPMTTYPE, "
            SQL = SQL & " Max(TERMOFPMTTYPE.DOCLEVEL) as TERMOFPMTTYPEDOCLEVEL, "
            SQL = SQL & " Max(AINFODET.TERMOFPMT_EXT) as TERMOFPMT_EXT, "
            SQL = SQL & " Max(TERMOFPMTTYPE_EXT.TERMOFPMTTYPE) as TERMOFPMTTYPE_EXT, "
            SQL = SQL & " Max(TERMOFPMTTYPE_EXT.DOCLEVEL) as TERMOFPMTTYPEDOCLEVEL_EXT, "
            SQL = SQL & " Max(A.OANO) as OANO, "
            SQL = SQL & " Max(R1.TSI*CASE WHEN R2.PCTLOSS=0 THEN 100 ELSE R2.PCTLOSS END/(CASE WHEN R2.PCTLOSS+R2.PAddition=0 THEN 100 ELSE R2.PCTLOSS+R2.PAddition END)*P.Rate) as TSI"
            SQL = SQL & " from Acceptance A"
            SQL = SQL & " Inner Join TOC on (TOC.TOC=A.TOC and TOC.NOINPUTF=0)"
            SQL = SQL & " Inner Join Cover C on (C.CNO=A.CNO)"
            SQL = SQL & " Inner Join PCalc P on (P.ANO=A.ANO)"
            SQL = SQL & " Inner Join RCalc R1 on (R1.ANO=P.ANO and R1.Currency=P.Currency)"
            SQL = SQL & " Inner Join RCover R2 on (R2.ANO=R1.ANO and R2.Code=R1.Code and R2.SDate=R1.SDate and R2.Category='M')"
            SQL = SQL & " Left Join TOPRO on (TOPRO.TOPRO=A.TOPRO)"
            SQL = SQL & " Left Join AInfoDet on (AInfoDet.ANO=A.LANO and AInfoDet.FLDID=A.FLDID and AInfoDet.ValueID=A.ValueID and AInfoDet.Status='A')"
            SQL = SQL & " LEFT JOIN TERMOFPMTTYPE ON (TERMOFPMTTYPE.TERMOFPMTTYPE=AINFODET.TERMOFPMTTYPE)"
            SQL = SQL & " LEFT JOIN TERMOFPMTTYPE TERMOFPMTTYPE_EXT ON (TERMOFPMTTYPE_EXT.TERMOFPMTTYPE=AINFODET.TERMOFPMTTYPE_EXT)"
            SQL = SQL & " Where A.ANO=" & ANO
            SQL = SQL & " Group By A.TOC, R1.Code, R1.SDate"
            rs = db.OpenRemoteSet(SQL)
            If Not rs.Eof Then
                Dim TOC As String = rs.fields("TOC")
                Dim OANO As Long = rs.fields("OANO")
                Dim ValueParam As Object
                Dim MultiplySalary As Double
                Dim Salary As Double
                Dim AggregateLimit As Double
                Dim AggregateTSI As Double

                Dim TermOfPayment As Integer
                Dim TermOfPaymentType As Integer
                Dim CheckRateConSIBy As Integer = toval(rs.fields("CheckRateConSIBy"))


                ValueParam = Search_FLDMAP_In_ObjInfo(ANO, TOC, "MultiplySalary", "Salary", "ContractDate", "TermOfPayment", "TermOfPaymentType")
                MultiplySalary = toval(ValueParam(0))
                Salary = toval(ValueParam(1))
                AggregateLimit = MultiplySalary * Salary

                Dim LockedKey As String = ""
                Select Case CheckRateConSIBy
                    Case 1
                        LockedKey = rs.fields("TOPRO") & "_" & rs.fields("RegID") & "_" & rs.fields("FLDID") & "_" & rs.fields("VALUEID")
                    Case 2
                        LockedKey = rs.fields("PHOLDER") & "_" & rs.fields("RegID") & "_" & rs.fields("FLDID") & "_" & rs.fields("VALUEID")
                    Case 3
                        LockedKey = rs.fields("RegID") & "_" & rs.fields("FLDID") & "_" & rs.fields("VALUEID")
                    Case 4
                        LockedKey = rs.fields("TOPRO") & "_" & rs.fields("PHOLDER")
                    Case 5
                        LockedKey = rs.fields("TOPRO") & "_" & rs.fields("AID")
                End Select
                If LockedKey <> "" Then
                    If Not db.GetLockedObject(LockedKey) Then Throw New Exception(db.ErrDesc)
                End If
                Get_RateLoading(ANO, rs.fields("Code"), todate(rs.fields("SDate")), toval(rs.fields("TSI")), HoldF, HoldMessage, CID, AggregateTSI)
                If LockedKey <> "" Then
                    If Not db.ReleaseLockedObject(LockedKey) Then Throw New Exception(db.ErrDesc)
                End If

                If AggregateLimit <> 0 AndAlso AggregateTSI > AggregateLimit Then
                    HoldF = True
                    HoldMessage = HoldMessage & "Exceeding Aggregate Limit for (Salary x Multiply Salary) !" & vbCrLf
                End If

                If tostr(ValueParam(2)) <> "" And IsDate(ValueParam(2)) Then
                    Dim ContractDate = todate(ValueParam(2))
                    If DateDiff(DateInterval.Day, rs.fields("Inception"), ContractDate) > 0 Then
                        HoldF = True
                        HoldMessage = HoldMessage & "The Inception Date must not precede The Contract Date !" & vbCrLf
                    End If
                End If

                TermOfPayment = toval(ValueParam(3))
                TermOfPaymentType = toval(ValueParam(4))

                Dim TERMOFPMT As Integer
                Dim TERMOFPMTTYPEDOCLEVEL As Integer
                Dim TERMOFPMTTYPE As String

                Dim TERMOFPMT_EXT As Integer
                Dim TERMOFPMTTYPEDOCLEVEL_EXT As Integer
                Dim TERMOFPMTTYPE_EXT As String

                If tostr(rs.fields("TERMOFPMTTYPE")) <> "" Then
                    TERMOFPMT = toval(rs.fields("TERMOFPMT"))
                    TERMOFPMTTYPEDOCLEVEL = toval(rs.fields("TERMOFPMTTYPEDOCLEVEL"))
                    TERMOFPMTTYPE = tostr(rs.fields("TERMOFPMTTYPE"))

                    TERMOFPMT_EXT = toval(rs.fields("TERMOFPMT_EXT"))
                    TERMOFPMTTYPEDOCLEVEL_EXT = toval(rs.fields("TERMOFPMTTYPEDOCLEVEL_EXT"))
                    TERMOFPMTTYPE_EXT = tostr(rs.fields("TERMOFPMTTYPE_EXT"))
                Else
                    TERMOFPMT = toval(rs.fields("TERMOFPMT_EXT"))
                    TERMOFPMTTYPEDOCLEVEL = toval(rs.fields("TERMOFPMTTYPEDOCLEVEL_EXT"))
                    TERMOFPMTTYPE = tostr(rs.fields("TERMOFPMTTYPE_EXT"))

                    TERMOFPMT_EXT = 0
                    TERMOFPMTTYPEDOCLEVEL_EXT = 0
                    TERMOFPMTTYPE_EXT = ""
                End If

                If TERMOFPMTTYPE_EXT = "" Then
                    If TERMOFPMT <> 0 AndAlso TERMOFPMT < TermOfPayment Then
                        HoldF = True
                        HoldMessage = HoldMessage & "The Term of Payment Can't be Greater Than " & TERMOFPMT & " days !" & vbCrLf
                    End If

                    If TERMOFPMTTYPEDOCLEVEL <> 0 AndAlso TERMOFPMTTYPEDOCLEVEL > TermOfPaymentType Then
                        HoldF = True
                        HoldMessage = HoldMessage & "The Term of Payment Type is " & TERMOFPMTTYPE & " !" & vbCrLf
                    End If
                Else
                    If TERMOFPMTTYPEDOCLEVEL = TermOfPaymentType Then
                        If TERMOFPMT <> 0 AndAlso TERMOFPMT < TermOfPayment Then
                            HoldF = True
                            HoldMessage = HoldMessage & "The Term of Payment Can't be Greater Than " & TERMOFPMT & " days !" & vbCrLf
                        End If
                    ElseIf TERMOFPMTTYPEDOCLEVEL_EXT = TermOfPaymentType Then
                        If TERMOFPMT_EXT <> 0 AndAlso TERMOFPMT_EXT < TermOfPayment Then
                            HoldF = True
                            HoldMessage = HoldMessage & "The Term of Payment Can't be Greater Than " & TERMOFPMT_EXT & " days !" & vbCrLf
                        End If
                    Else
                        HoldF = True
                        HoldMessage = HoldMessage & "The Term of Payment Type is either " & TERMOFPMTTYPE & " or " & TERMOFPMTTYPE_EXT & " !" & vbCrLf
                    End If
                End If

                If HoldF Then
                    rs = db.OpenRemoteSet("Select ANO, HoldF, Message from RArrHeader Where ANO=" & ANO)
                    rs.Edit()
                    rs.fields("HoldF") = HoldF
                    If rs.fields("Message") = "" Then
                        rs.fields("Message") = HoldMessage
                    Else
                        rs.fields("Message") = rs.fields("Message") & vbCrLf & HoldMessage
                    End If
                    If Not rs.Update Then Throw New Exception("Update Hold Message Error !")
                End If

               
            End If

            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try

    End Function
    Private Function Treaty_Adjustment(ByVal Param As Object) As Boolean
        Dim rs As RemoteSet
        Dim rsAcc As RemoteSet
        Dim rsReg As RemoteSet
        Dim TSI As Double
        Dim YAmount As Double
        Dim Amount As Double
        Dim Limit As Double
        Dim YLimit As Double
        Dim RType As String() = New String() {"C", "XP", "D", "Q", "S1", "S2", "S3", "A"}
        Dim RYear As Integer
        Dim i As Integer
        Dim RLimit As Double = 0
        Dim CLimit As Double = 0
        Dim RegAmount As Double = 0
        Dim ReAllocF As Boolean = False
        Dim ATSI As Double = 0

        Dim ADate As Date
        Dim REGID As String
        Dim FLDID As String
        Dim VALUEID As String
        Dim NewValueID As String
        Dim AutoInforceF As Boolean
        Dim pRYear As Integer

        On Error GoTo ErrMsg

        ADate = todate(getInParamValue(Param, 0))
        REGID = tostr(getInParamValue(Param, 1))
        FLDID = tostr(getInParamValue(Param, 2))
        VALUEID = tostr(getInParamValue(Param, 3))
        NewValueID = tostr(getInParamValue(Param, 4))
        AutoInforceF = toval(getInParamValue(Param, 5))
        pRYear = toval(getInParamValue(Param, 6))

        '' for each acceptance endorse first
        If Not EndorseTreaty(ADate, REGID, FLDID, VALUEID, NewValueID, pRYear) Then GoTo ErrMsg
        ' Reinitialize Accumulation Register and Recalculate Cession before Adjustment

        If Not db.Execute("Select A.ANO into #A from QAccumulation_Detail('" & REGID & "','" & FLDID & "','" & NewValueID & "'," & pRYear & ") A ") Then GoTo ErrMsg
        If Not db.Execute("Update R Set Status='R' from RArrHeader R, #A Where #A.ANO=R.ANO") Then GoTo ErrMsg
        If pRYear = 0 Then
            If Not db.Execute("Delete from AccRegDet Where RegID='" & REGID & "' and FLDID='" & FLDID & "' and ValueID='" & NewValueID & "'") Then GoTo ErrMsg
        Else
            If Not db.Execute("Delete from AccRegDet Where RegID='" & REGID & "' and FLDID='" & FLDID & "' and ValueID='" & NewValueID & "' and RYear=" & pRYear) Then GoTo ErrMsg
        End If

        rs = db.OpenRemoteSet("Select A.ANO, A.AStatus, A.PStatus, R.TAmount-R.MAmount as TAmount from Acceptance A, #A, RArrHeader R Where R.ANO=A.ANO and #A.ANO=A.ANO Order By R.RDate, A.ANO")
        Do While Not rs.Eof
            If rs.fields("AStatus") <> "W" Then
                If Not ReleaseAccRegAmount(rs.fields("ANO"), True) Then GoTo ErrMsg
                ' Still Need Realloc
                ReAllocF = True
            ElseIf rs.fields("PStatus") = "I" Then
                If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "Premium_Calc", rs.fields("ANO")) Then GoTo ErrMsg
            End If
            ' Get Total Risk Accumulation Amount
            ATSI = ATSI + toval(rs.fields("TAmount"))
            rs.MoveNext()
        Loop

        rs = db.OpenRemoteSet("Select A.ANO from Acceptance A, #A, RArrHeader R Where A.AStatus='W' and R.ANO=A.ANO and #A.ANO=A.ANO Order By R.RDate, A.ANO")
        Do While Not rs.Eof
            If Not Reinsurance_Cession(rs.fields("ANO"), , , True, ATSI) Then GoTo ErrMsg
            If Not Check_RateCon(rs.fields("ANO")) Then GoTo errmsg
            rs.MoveNext()
        Loop

        Dim LimitOR() As Double
        Dim YLimitOR() As Double

        ReDim LimitOR(0)
        ReDim YLimitOR(0)

        Dim MaxRYear As Integer
        Dim YTSI As Double
        rs = db.OpenQueryDef("Treaty_Adjustment_Limit", adOpenForwardonly, REGID, FLDID, NewValueID, pRYear)
        RLimit = toval(rs.fields("Limit"))
        MaxRYear = toval(rs.fields("RYear"))

        For i = LBound(RType) To UBound(RType)
            Select Case RType(i)
                Case "C"
                    rs = db.OpenQueryDef("Treaty_Adjustment_C", adOpenForwardonly, ADate, REGID, FLDID, NewValueID, pRYear)
                Case "D"
                    rs = db.OpenQueryDef("Treaty_Adjustment_D", adOpenForwardonly, ADate, REGID, FLDID, NewValueID, pRYear)
                Case "Q"
                    rs = db.OpenQueryDef("Treaty_Adjustment_Q", adOpenForwardonly, ADate, REGID, FLDID, NewValueID, pRYear)
                Case "XP"
                    rs = db.OpenQueryDef("Treaty_Adjustment_XP", adOpenForwardonly, ADate, REGID, FLDID, NewValueID, pRYear)
                Case "S1"
                    rs = db.OpenQueryDef("Treaty_Adjustment_S1", adOpenForwardonly, ADate, REGID, FLDID, NewValueID, pRYear)
                Case "S2"
                    rs = db.OpenQueryDef("Treaty_Adjustment_S2", adOpenForwardonly, ADate, REGID, FLDID, NewValueID, pRYear)
                Case "S3"
                    rs = db.OpenQueryDef("Treaty_Adjustment_S3", adOpenForwardonly, ADate, REGID, FLDID, NewValueID, pRYear)
                Case "A"
                    rs = db.OpenQueryDef("Treaty_Adjustment_A", adOpenForwardonly, ADate, REGID, FLDID, NewValueID, pRYear)
            End Select

            If Not rs.Eof Then
                TSI = 0
                Do While Not rs.Eof
                    TSI = TSI + rs.fields("SI")
                    RegAmount = RegAmount + rs.fields("Amount")
                    rs.MoveNext()
                Loop

                ' The Highest limit in years
                rs.MoveFirst()
                If rs.fields("RLimit") = 1 Then
                    Limit = rs.fields("Limit") * RLimit
                Else
                    Limit = rs.fields("Limit")
                End If
                Do While Not rs.Eof And TSI <> 0
                    YAmount = 0
                    RYear = rs.fields("RYear")
                    YTSI = rs.fields("SI")

                    If rs.fields("RLimit") = 1 Then
                        YLimit = rs.fields("Limit") * RLimit
                    Else
                        YLimit = rs.fields("Limit")
                    End If

                    If UBound(YLimitOR) < (MaxRYear - RYear) Then
                        ReDim Preserve YLimitOR(MaxRYear - RYear)
                        ReDim Preserve LimitOR(MaxRYear - RYear)
                    End If

                    Select Case RType(i)
                        Case "Q"
                            YLimitOR(MaxRYear - RYear) = rs.fields("Limit")
                    End Select

                    Select Case RType(i)
                        Case "Q"
                            LimitOR(MaxRYear - RYear) = 0
                        Case "S1", "S2", "S3"
                            If YLimitOR(MaxRYear - RYear) <> 0 AndAlso Limit > LimitOR(MaxRYear - RYear) * rs.fields("Limit") / YLimitOR(MaxRYear - RYear) Then
                                Limit = LimitOR(MaxRYear - RYear) * rs.fields("Limit") / YLimitOR(MaxRYear - RYear)
                            End If
                    End Select

                    ' Conditions
                    If Limit > YLimit Then Limit = YLimit
                    If Limit > RegAmount Then Limit = RegAmount

                    ' for each acceptance
                    rsAcc = db.OpenQueryDef("Treaty_Adjustment_Detail", adOpenForwardonly, ADate, REGID, FLDID, NewValueID, RYear)
                    Do While Not rsAcc.Eof
                        CLimit = rs.fields("CLimit")
                        'If DateDiff(DateInterval.Day, todate(rsAcc.fields("ADate")), ADate) <> 0 Or tostr(rsAcc.fields("Astatus")) <> "W" Then GoTo ErrMsg
                        Select Case RType(i)
                            Case "C"
                                Amount = CArrangement(toval(rsAcc.fields("ANO")), TSI, Limit, CLimit, toval(rs.fields("PLimit")))
                            Case "D"
                                Amount = DArrangement(toval(rsAcc.fields("ANO")), TSI, Limit, CLimit, toval(rs.fields("PLimit")))
                            Case "Q"
                                Amount = QSArrangement(toval(rsAcc.fields("ANO")), TSI, Limit, CLimit, toval(rs.fields("PLimit")))
                            Case "XP"
                                Amount = XPArrangement(toval(rsAcc.fields("ANO")), TSI, Limit, CLimit, toval(rs.fields("PLimit")))
                            Case "S1"
                                Amount = SP1Arrangement(toval(rsAcc.fields("ANO")), YTSI, Limit, CLimit, toval(rs.fields("PLimit")), toval(rs.fields("RShare")))
                            Case "S2"
                                Amount = SP2Arrangement(toval(rsAcc.fields("ANO")), YTSI, Limit, CLimit, toval(rs.fields("PLimit")), toval(rs.fields("RShare")))
                            Case "S3"
                                Amount = SP3Arrangement(toval(rsAcc.fields("ANO")), YTSI, Limit, CLimit, toval(rs.fields("PLimit")), toval(rs.fields("RShare")))
                            Case "A"
                                Amount = AArrangement(toval(rsAcc.fields("ANO")), TSI, Limit, CLimit, toval(rs.fields("PLimit")))
                        End Select
                        YAmount = YAmount + Amount
                        If CLimit <> 0 Then
                            Amount = Amount / CLimit
                        End If
                        RegAmount = RegAmount - Amount
                        Select Case RType(i)
                            Case "Q"
                                LimitOR(MaxRYear - RYear) = LimitOR(MaxRYear - RYear) + Amount
                        End Select
                        rsAcc.MoveNext()
                    Loop
                    rsAcc.CloseRemoteSet()
                    rsReg = db.OpenQueryDef("QACCREGDET", adOpenKeyset, REGID, FLDID, NewValueID, RYear, tostr(RType(i)))
                    If Not rsReg.Eof Then
                        rsReg.Edit()
                        rsReg.fields("Amount") = rsReg.fields("Amount") - rs.fields("RegAmount") + YAmount
                        rsReg.fields("ReAllocF") = ReAllocF
                        If Not rsReg.Update Then GoTo ErrMsg
                    End If

                    If RegAmount < 0 Then RegAmount = 0
                    Limit = RegAmount
                    TSI = TSI - rs.fields("SI")

                    rs.MoveNext()
                Loop
            End If
            rs.CloseRemoteSet()
            If RegAmount < 0 Then
                RegAmount = 0
            End If

        Next

        'rs = db.OpenRemoteSet("Select A.* from Acceptance A, #A Where #A.ANO=A.ANO Order By A.ANO")
        'Do While Not rs.Eof
        '    If (rs.fields("AType") = "N" Or rs.fields("AType") = "E") And rs.fields("AStatus") = "W" Then
        '        If Not Reinsurance_Cession(rs.fields("ANO"), RLimit) Then GoTo ErrMsg
        '    End If
        '    rs.MoveNext()
        'Loop

        If AutoInforceF Then
            Dim SQL As String
            SQL = "Select Distinct coalesce(mA.RegNo, A.RegNo) as RegNo, coalesce(mA.CertificateNo, A.CertificateNo) as CertificateNo"
            SQL = SQL & " from #A "
            SQL = SQL & " Inner Join Acceptance A on (A.ANO=#A.ANO) "
            SQL = SQL & " inner join Cover C on (C.CNO=A.CNO)"
            SQL = SQL & " Left Join Acceptance mA on (mA.ANO=mA.LANO and mA.ANO=A.LANO and C.OpenFlag=0) "
            SQL = SQL & " Where A.AStatus='W' and coalesce(mA.AStatus,'W')='W' and A.EMethod='T'"

            rs = db.OpenRemoteSet(SQL)
            Do While Not rs.Eof
                If Not Insert_Policy_Auto_Inforce(rs.fields("RegNo"), rs.fields("CertificateNo")) Then GoTo ErrMsg
                rs.MoveNext()
            Loop
        End If


        If Not db.Execute("Drop Table #A") Then GoTo ErrMsg

        Treaty_Adjustment = True
        Exit Function
ErrMsg:
        StrMsg = StrError(StrMsg)
        Treaty_Adjustment = False
    End Function
    Private Function Insert_Policy_Auto_Inforce(ByVal RegNo As String, ByVal CertificateNo As String) As Boolean
        Try
            Dim rs As RemoteSet

            rs = db.OpenRemoteSet("Select * from AIBucket Where Status='R' and RegNo='" & RegNo & "' and CertificateNo='" & CertificateNo & "'")
            If rs.Eof Then
                rs.AddNew()
            Else
                rs.Edit()
            End If
            rs.fields("RegNo") = RegNo
            rs.fields("CertificateNo") = CertificateNo
            rs.fields("BatchNo") = ""
            rs.fields("Status") = "R"
            rs.fields("Last_Opr") = db_user
            rs.fields("Last_Update") = Today.Date
            If Not rs.Update Then Throw New Exception(rs.ErrDesc)

            Insert_Policy_Auto_Inforce = True
        Catch ex As Exception
            StrMsg = ex.Message
            Insert_Policy_Auto_Inforce = False
        End Try
    End Function

    Private Function CArrangement(ByVal ANO As Long, ByVal TSI As Double, ByVal Limit As Double, ByRef CLimit As Double, Optional ByVal PLimit As Double = 0) As Double
        Dim rs As RemoteSet
        Dim OurShare As Double
        Dim Share As Double
        Dim Amount As Double
        Dim RAmount As Double
        Dim FAmount As Double
        Dim MAmount As Double
        Dim PCTShare As Double
        Dim MShare As Double
        Dim PCTLOSS As Double

        Amount = 0
        rs = db.OpenQueryDef("QRARRHEADER", adOpenKeyset, ANO)
        If Not rs.Eof Then
            If tostr(rs.fields("CID")) <> "" AndAlso toval(rs.fields("MShare")) <> 100 Then
                OurShare = rs.fields("TAmount")
                FAmount = rs.fields("FAmount")
                MAmount = rs.fields("MAmount")
                PCTShare = rs.fields("PCTShare")
                MShare = rs.fields("MShare")
                PCTLOSS = rs.fields("PCTLOSS")
                Share = 100

                Amount = ((OurShare - FAmount) / (PCTShare / 100 * PCTLOSS / 100)) / TSI * Limit

                Amount = Amount * (PCTShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100)

                RAmount = (OurShare - FAmount) - MAmount
                If RAmount < Amount Then Amount = RAmount

                ' Policy Cession Limit Applicable
                If PLimit <> 0 AndAlso Amount > PLimit Then
                    Amount = PLimit
                End If

                rs.Edit()
                rs.fields("CAmount") = Amount
                rs.fields("CShare") = Amount / OurShare * 100

                ' Retention 
                RAmount = RAmount - Amount - rs.fields("SAmount")
                rs.fields("RAmount") = RAmount
                rs.fields("Retention") = RAmount / OurShare * 100
                If Not rs.Update() Then GoTo errmsg
                Amount = Amount / (PCTShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100)
            End If
        End If
        rs.CloseRemoteSet()
        CArrangement = Amount
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CArrangement = 0
    End Function

