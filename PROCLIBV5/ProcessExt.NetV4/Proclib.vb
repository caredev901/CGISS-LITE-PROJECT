    Private Function Save_Deductible(ByVal Param As Object, ByVal findex() As String, ByVal fbuffer() As String) As Boolean
        Dim i As Integer
        Dim rs As RemoteSet

        On Error GoTo errmsg

        Dim ANO As Long = Param(0)
