        Dim Voyage As Boolean = Param(7)
        Dim ISType As String = Param(8)
        Dim ReinstatementF As Boolean = Param(9)
        Dim SType As String = Param(10)
        Dim ProformaF As Boolean = Param(11)
        Dim Basis As Integer = Param(12)
        Dim RenewableF As Boolean = Param(13)
        Dim WPC As Integer = Param(14)
        Dim OverWritePayorF As Boolean = Param(15)
        Dim OverWriteDAF As Boolean = Param(16)
        Dim OverWriteCAF As Boolean = Param(17)
        Dim RegID As String = Param(18)
        Dim FLDID As String = Param(19)
        Dim ValueID As String = Param(20)
        Dim ValueDesc As String = Param(21)
