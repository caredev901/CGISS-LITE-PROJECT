                                End If
                            Else
                                rs = db.OpenRemoteSet("select A1.OrderNo, A1.ShortDesc, A1.ShortDesc_1, A1.Description, A1.Description_1, A1.Section, D.CompulsoryF from FacCon A1 inner Join Acceptance A2 On (A2.ANO=A1.ANO) inner join Cover C1 on (C1.CNO=A2.CNO) Left Join DefCon D On (D.TOC=A2.TOC and D.OrderNo=A1.OrderNo and D.Section=A1.Section) where A1.Section='" & Section & "' and A1.ANO=" & ANO & " and A1.FID='" & FID & "' and A1.OrderNo='" & OrderNo & "' Order by A1.OrderNo", adOpenForwardonly)
                            End If
                            If rs.Eof Then
                                rs = db.OpenRemoteSet("select G.OrderNo, G.ShortDesc, G.ShortDesc_1, G.Description, G.Description_1 from GenCon G, Acceptance, Cover, TOC where TOC.TOC=Acceptance.TOC and Cover.CNO=Acceptance.CNO and G.COB=TOC.COB and Acceptance.ANO=" & ANO & " and G.OrderNo='" & OrderNo & "' Order by G.OrderNo", adOpenForwardonly)
                            End If
                        Case 2
                            If OriginalF Then
                                If TOPRO = "" Then
                                    rs = db.OpenRemoteSet("select A1.OrderNo, A1.ShortDesc, A1.ShortDesc_1, A1.Description, A1.Description_1, A1.Section, D.CompulsoryF from AccEx A1 inner Join Acceptance A2 On (A2.ANO=A1.ANO) inner join Cover C1 on (C1.CNO=A2.CNO) Left Join DefEx D On (D.TOC=A2.TOC and D.OrderNo=A1.OrderNo and D.Section=A1.Section) where A1.Section='" & Section & "' and A1.ANO=" & ANO & " and A1.OrderNo='" & OrderNo & "' Order by A1.OrderNo", adOpenForwardonly)
                                Else
                                    rs = db.OpenRemoteSet("select A1.OrderNo, A1.ShortDesc, A1.ShortDesc_1, A1.Description, A1.Description_1, A1.Section, D.CompulsoryF from AccEx A1 inner Join Acceptance A2 On (A2.ANO=A1.ANO) inner join Cover C1 on (C1.CNO=A2.CNO) Left Join TOP_EX D On (D.TOPRO='" & TOPRO & "' and D.OrderNo=A1.OrderNo and D.Section=A1.Section) where A1.Section='" & Section & "' and A1.ANO=" & ANO & " and A1.OrderNo='" & OrderNo & "' Order by A1.OrderNo", adOpenForwardonly)
                                End If
                            Else
                                rs = db.OpenRemoteSet("select A1.OrderNo, A1.ShortDesc, A1.ShortDesc_1, A1.Description, A1.Description_1, A1.Section, D.CompulsoryF from FacEx A1 inner Join Acceptance A2 On (A2.ANO=A1.ANO) inner join Cover C1 on (C1.CNO=A2.CNO) Left Join DefEx D On (D.TOC=A2.TOC and D.OrderNo=A1.OrderNo and D.Section=A1.Section) where A1.Section='" & Section & "' and A1.ANO=" & ANO & " and A1.FID='" & FID & "' and A1.OrderNo='" & OrderNo & "' Order by A1.OrderNo", adOpenForwardonly)
                            End If
                            If rs.Eof Then
                                rs = db.OpenRemoteSet("select G.OrderNo, G.ShortDesc, G.ShortDesc_1, G.Description, G.Description_1 from GenEx G, Acceptance, Cover, TOC where TOC.TOC=Acceptance.TOC and Cover.CNO=Acceptance.CNO and G.COB=TOC.COB and Acceptance.ANO=" & ANO & " and G.OrderNo='" & OrderNo & "' Order by G.OrderNo", adOpenForwardonly)
                            End If
                    End Select
                    bufferdata(i, 2) = tostr(rs.fields("Description"))
                    bufferdata(i, 4) = tostr(rs.fields("Description_1"))
                    bufferdata(i, 5) = True
                End If
            Next

            Select Case index
                Case 0
                    If Not db.Execute("Delete from FacCla where ANO=" & ANO & " and FID='" & FID & "' and Section='" & Section & "'") Then GoTo errmsg
                    rs = db.OpenRemoteSet("Select * from FacCla Where 1<>1")
                Case 1
                    If Not db.Execute("Delete from FacCon where ANO=" & ANO & " and FID='" & FID & "' and Section='" & Section & "'") Then GoTo errmsg
                    rs = db.OpenRemoteSet("Select * from FacCon Where 1<>1")
                Case 2
                    If Not db.Execute("Delete from FacEx  where ANO=" & ANO & " and FID='" & FID & "' and Section='" & Section & "'") Then GoTo errmsg
                    rs = db.OpenRemoteSet("Select * from FacEx Where 1<>1")
            End Select

            For i = 0 To MaxRows - 1
                If tostr(bufferdata(i, 0)) <> "" Then
                    rs.AddNew()
                    rs.fields("ANO") = ANO
                    rs.fields("FID") = FID
                    rs.fields("OrderNo") = tostr(bufferdata(i, 0))
                    rs.fields("ShortDesc") = tostr(bufferdata(i, 1))
                    rs.fields("Description") = tostr(bufferdata(i, 2))
                    rs.fields("Section") = Section
                    rs.fields("ShortDesc_1") = tostr(bufferdata(i, 3))
                    rs.fields("Description_1") = tostr(bufferdata(i, 4))
                    If Not rs.UpdateRow Then GoTo errmsg
                End If
            Next
            If Not rs.Eof Then
                If Not rs.Update Then GoTo errmsg
            End If

        Next

        Save_Facultative_TC_Data = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Facultative_TC_Data = False
    End Function
    Private Function Validate_ObjectInfo(ByVal ANO As Long, ByVal TOC As String, ByVal Segment As String, ByVal ISType As String, ByVal QuotationF As Boolean) As String
        Dim i As Integer
        Dim rsTOC As RemoteSet
        Dim rsInfo As RemoteSet
        Dim rs As RemoteSet
        Dim FLDID As String
        Dim FLDTAG As String
        Dim ValueID As String
        Dim ValueDesc As String
        Dim Validate As String = ""
        Dim strFLDCOM As String = ""

        If QuotationF Then
            strFLDCOM = "FLDCOMA"
        Else
            strFLDCOM = "FLDCOM"
        End If

        rsTOC = db.OpenQueryDef("QTOC_GENHTAB", adOpenForwardonly, TOC, Segment)
        rsInfo = db.OpenRemoteSet("Select * from AInfo where ANO=" & ANO)
        For i = 1 To 15
            FLDID = rsTOC.fields("FLDID" & i)
            If FLDID <> "" Then
                FLDTAG = rsTOC.fields("FLDTAG" & i)
                ValueID = rsInfo.fields("VALUEID" & i)
                ValueDesc = rsInfo.fields("VALUEDESC" & i)
                If toval(rsTOC.fields(strFLDCOM & i)) Then
                    If ValueID = "" And ValueDesc = "" Then
                        Validate = Validate & "Check Compulsory Field : '" & FLDTAG & "'" & vbCrLf
                    ElseIf toval(rsTOC.fields("FLDTAB" & i)) Then
                        rs = db.OpenRemoteSet("Select AllowedF from fn_gendTab('" & FLDID & "','" & TOC & "','" & Segment & "','" & ISType & "') GenDTab Where FLDID='" & FLDID & "' and ValueID='" & ValueID & "'")
                        If toval(rs.fields("AllowedF")) = 0 Then
                            Validate = Validate & "Check in Table Reference Field : '" & FLDTAG & "'" & vbCrLf
                        End If
                    ElseIf tostr(rsTOC.fields("FLDFUNC" & i)) <> "" Then
                        rs = db.OpenRemoteSet("Select dbo." & tostr(rsTOC.fields("FLDFUNC" & i)) & "('" & ValueDesc & "')")
                        If Not toval(rs.fields(0)) Then
                            Validate = Validate & "Please Check Object Info for Function Validation (" & FLDTAG & ") for Value " & "(" & ValueDesc & ")"
                        End If
                    End If
                End If
            Else
                Exit For
            End If
        Next
        Validate_ObjectInfo = Validate
    End Function
