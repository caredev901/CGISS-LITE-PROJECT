    Private Function TreatyReAllocation(ByVal InParam As Object, ByRef dsFailed As String) As Boolean
        Dim rsAcc As RemoteSet
        Dim RegNo As String
        Dim rs As RemoteSet
        Dim OpenFlag As Boolean
        Dim LANO As Long = 0
        Dim ANO As Long = 0
        Dim RANO As Long
        Dim AStatus As String
        Dim NEWANO As Long
        Dim NEWLANO As Long
        Dim SQL As String
        Dim EMethod As String
        Dim BackDatedF As Boolean
        Dim pADate As Date
        Dim PolicyNo As String
        Dim CertificateNo As String
        Dim ErrMsg As String
        Dim PDate As Date
        Dim ADate As Date
        Dim AUserID As String
        Dim Category As String
        Dim InforceF As Boolean
        Dim TOC As String
        Dim Branch As String
        Dim pBranch As String = ""
        Dim pEMethod As String
        Dim MaxRecords As Long
        Dim ShowResult As String
        Dim Param() As Object

        PDate = todate(getInParamValue(InParam, 0))
        ADate = todate(getInParamValue(InParam, 1))
        Category = tostr(getInParamValue(InParam, 2))
        InforceF = toval(getInParamValue(InParam, 3))
        TOC = tostr(getInParamValue(InParam, 4))
        Branch = tostr(getInParamValue(InParam, 5))
        MaxRecords = toval(getInParamValue(InParam, 6))
        ShowResult = tostr(getInParamValue(InParam, 7))

        On Error GoTo errmsg
        db.Committrans()

        Select Case Category.ToUpper
            Case "ANNUAL REALLOCATION"               
                rsAcc = db.OpenQueryDef("TreatyReallocation_Process", adOpenKeyset, db_user, ADate, PDate, TOC, Branch)
                EMethod = "T"
            Case "TREATY_REALLOCATION (TABLES)"
                rsAcc = db.OpenRemoteSet("Select Acceptance.EMethod, Acceptance.AUserID, Acceptance.PolicyNo, Acceptance.CertificateNo, Acceptance.Branch, 0 as BackDatedF, Acceptance.TOC, Cover.OpenFlag, Acceptance.RANO, Acceptance.ANO, Acceptance.LANO, Acceptance.AStatus, Acceptance.AType, Acceptance.PDate, Acceptance.RefNo, Acceptance.RefDate, Acceptance.ADate from Acceptance, Cover, Treaty_Reallocation T where Cover.CNO=Acceptance.CNO and Acceptance.LANO<>Acceptance.ANO and Acceptance.AType<>'A' and Acceptance.AStatus in ('I','W') and Acceptance.ANO=T.ANO Order By Acceptance.Branch, Acceptance.LANO, Acceptance.ANO", adOpenForwardonly, , , MaxRecords)
                EMethod = "T"
            Case Else
                rsAcc = db.OpenRemoteSet("Select Acceptance.EMethod, Acceptance.AUserID, Acceptance.PolicyNo, Acceptance.CertificateNo, Acceptance.Branch, Acceptance.BackDatedF, Acceptance.TOC, Cover.OpenFlag, Acceptance.RANO, Acceptance.ANO, Acceptance.LANO, Acceptance.AStatus, Acceptance.AType, Acceptance.PDate, Acceptance.RefNo, Acceptance.RefDate, Acceptance.ADate from Acceptance, Cover, Treaty_Reallocation T where Cover.CNO=Acceptance.CNO and Acceptance.LANO<>Acceptance.ANO and Acceptance.AType<>'A' and Acceptance.AStatus in ('I','W') and Acceptance.ANO=T.ANO Order By Acceptance.Branch, Acceptance.LANO, Acceptance.ANO", adOpenForwardonly, , , MaxRecords)
                EMethod = "T"
        End Select

        Dim ds As DataSet = rsAcc.GetDataSet

        If ds.Tables(0).Columns("Message") Is Nothing Then
            Dim dc As System.Data.DataColumn
            dc = New DataColumn
            dc.ColumnName = "Message"
            dc.DataType = Type.GetType("System.String")
            dc.DefaultValue = ""
            ds.Tables(0).Columns.Add(dc)
            ds.Tables(0).Columns(dc.ColumnName).SetOrdinal(0)
        End If

        Dim i As Integer = 0

        Dim BackDatedDate As Date
        Dim EndDate As Date
        Dim LockedDate As Date
        Do While i < ds.Tables(0).Rows.Count
            ErrMsg = ""
            pEMethod = tostr(GetItemValue(ds, i, "EMethod"))
            ANO = toval(GetItemValue(ds, i, "ANO"))
            RANO = toval(GetItemValue(ds, i, "RANO"))
            AStatus = tostr(GetItemValue(ds, i, "AStatus"))
            Branch = tostr(GetItemValue(ds, i, "Branch"))
            TOC = tostr(GetItemValue(ds, i, "TOC"))
            OpenFlag = toval(GetItemValue(ds, i, "OpenFlag"))
            PDate = todate(GetItemValue(ds, i, "PDate"))
            BackDatedF = toval(GetItemValue(ds, i, "BackDatedF"))
            PolicyNo = tostr(GetItemValue(ds, i, "PolicyNo"))
            CertificateNo = tostr(GetItemValue(ds, i, "CertificateNo"))
            AUserID = tostr(GetItemValue(ds, i, "AUserID"))

            If AUserID = "" Then AUserID = db_user

            pADate = todate(GetItemValue(ds, i, "ADate"))
            If DateDiff(DateInterval.Day, pADate, ADate) > 0 Then
                pADate = ADate
            End If

            If pBranch <> Branch Then
                pBranch = Branch
                BackDatedDate = GetBackDatedDate(Branch)
                EndDate = GetEndDate(Branch)
                LockedDate = GetLockedDate(Branch)
            End If

            If InforceF Then
                If BackDatedF Then
                    If DateDiff(DateInterval.Day, BackDatedDate, pADate) > 0 Then
                        pADate = BackDatedDate
                    End If
                Else
                    If DateDiff(DateInterval.Day, EndDate, pADate) <= 0 Then
                        pADate = DateAdd(DateInterval.Day, 1, EndDate)
                    End If

                    If DateDiff(DateInterval.Day, LockedDate, pADate) <= 0 Then
                        pADate = DateAdd(DateInterval.Day, 1, LockedDate)
                    End If
                End If
            End If

            If LANO <> toval(GetItemValue(ds, i, "LANO")) Or LANO = -1 Or OpenFlag Then
                LANO = toval(GetItemValue(ds, i, "LANO"))
                db.Begintrans()
            End If

            If AStatus = "I" Then
                ReDim param(16)
                RegNo = ""
                If LANO <> -1 And Not OpenFlag Then ' Fleet
                    rs = db.OpenRemoteSet("Select A1.ANO, A1.PDate, A1.RefNo, A1.RefDate from Acceptance A1 where A1.AStatus='I' and A1.ANO=" & LANO & " and Not Exists (Select A2.PANO from Acceptance A2 where A2.PANO=A1.ANO)", adOpenForwardonly)
                    If Not rs.Eof Then
                        If Not db.GetLockedObject("Policy" & LANO) Then
                            ErrMsg = db.ErrDesc
                            GoTo ErrRollback
                        End If

                        Param(0) = RegNo
                        Param(1) = pADate
                        If Category.ToUpper = "ANNUAL REALLOCATION" Then
                            Param(2) = PDate
                        Else
                            Param(2) = rs.fields("PDate")
                        End If
                        Param(3) = EMethod
                        Param(4) = LANO
                        Param(5) = "Treaty Re-Allocation"
                        Param(6) = ""
                        Param(7) = ""
                        Param(8) = False
                        Param(9) = rs.fields("RefNo")
                        Param(10) = rs.fields("RefDate")
                        Param(11) = IIf(Category.ToUpper = "TREATY_REALLOCATION (TABLES) - DATA CORRECTION", 0, 4)   ' 0 : Default, 4 : Add/Refund for Re Only
                        Param(12) = ""
                        Param(13) = False
                        Param(14) = "UW"
                        Param(15) = ""
                        Param(16) = ""
                        NEWLANO = EndorseMaster(LANO, Param)
                        If NEWLANO = 0 Then
                            ErrMsg = "Process : 'EndorseMaster Master Policy (" & PolicyNo & ")' failed !"
                            GoTo ErrRollback
                        End If
                        ' Refresh Master Information
                        rs = db.OpenRemoteSet("Select A1.PolicyNo, A1.LANO, A1.RegNo from Acceptance A1 Where A1.AStatus='W' and ANO=" & NEWLANO)
                        If rs.Eof Then
                            ErrMsg = "Process : 'Master Policy (" & PolicyNo & ")' is not Found !"
                            GoTo ErrRollback
                        End If
                        RegNo = rs.fields("RegNo")

                        If Not db.ReleaseLockedObject("Policy" & LANO) Then
                            ErrMsg = db.ErrDesc
                            GoTo ErrRollback
                        End If
                    Else
                        rs = db.OpenRemoteSet("Select A1.LANO, A1.ANO, A1.RegNo, A1.AStatus, A1.PolicyNo, A1.CertificateNo from Acceptance A1 where A1.AStatus='W' and A1.AType not in ('A','C') and A1.PANO=" & LANO, adOpenForwardonly)
                        If rs.Eof Then
                            ErrMsg = "Process : 'Master Policy (" & PolicyNo & ")' is not Found !"
                            GoTo ErrRollback
                        End If
                        NEWLANO = rs.fields("LANO")
                        RegNo = rs.fields("RegNo")
                    End If
                    If Not db.GetLockedObject("Policy" & ANO) Then
                        ErrMsg = db.ErrDesc
                        GoTo ErrRollback
                    End If
                    rs = db.OpenRemoteSet("Select A1.ANO, A1.PolicyNo, A1.CertificateNo from Acceptance A1 where A1.PANO=" & ANO, adOpenForwardonly)
                    If Not rs.Eof Then
                        ErrMsg = "Please Check the Policy Data " & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & " Already Endorsed/Cancelled !"
                        GoTo ErrRollback
                    End If
                    param(0) = RegNo
                    param(1) = pADate
                    param(2) = PDate
                    param(3) = EMethod
                    param(4) = NEWLANO
                    param(5) = "Treaty Re-Allocation"
                    param(6) = ""
                    param(7) = ""
                    param(8) = False
                    param(9) = GetItemValue(ds, i, "RefNo")
                    param(10) = GetItemValue(ds, i, "RefDate")
                    param(11) = IIf(Category.ToUpper = "TREATY_REALLOCATION (TABLES) - DATA CORRECTION", 0, 4)   ' 0 : Default, 4 : Add/Refund for Re Only
                    param(12) = ""
                    param(13) = False
                    param(14) = "UW"
                    param(15) = ""
                    param(16) = ""
                    NEWANO = Endorsement(ANO, param)
                    If NEWANO = 0 Then
                        ErrMsg = "Process : 'Endorsement Policy/CertificateNo (" & PolicyNo & IIf(CertificateNo <> "", "-", "") & CertificateNo & ")' failed !"
                        GoTo ErrRollback
                    End If
                    If Not db.ReleaseLockedObject("Policy" & ANO) Then
                        ErrMsg = db.ErrDesc
                        GoTo ErrRollback
                    End If
                Else
                    NEWLANO = LANO
                    If NEWLANO <> -1 Then
                        ' Refresh Master Information
                        rs = db.OpenRemoteSet("Select A1.PolicyNo, A1.LANO, A1.RegNo from Acceptance A1 Where A1.AStatus='I' and ANO=" & NEWLANO)
                        If rs.Eof Then
                            ErrMsg = "Process : 'Master Policy (" & PolicyNo & ")' is not Found !"
                            GoTo ErrRollback
                        End If
                        RegNo = rs.fields("RegNo")
                    End If
                    If Not db.GetLockedObject("Policy" & ANO) Then
                        ErrMsg = db.ErrDesc
                        GoTo ErrRollback
                    End If
                    rs = db.OpenRemoteSet("Select A1.ANO, A1.PolicyNo, A1.CertificateNo from Acceptance A1 where A1.PANO=" & ANO, adOpenForwardonly)
                    If Not rs.Eof Then
                        ErrMsg = "Please Check the Policy Data " & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & " Already Endorsed/Cancelled !"
                        GoTo ErrRollback
                    End If
                    param(0) = RegNo
                    param(1) = pADate
                    param(2) = PDate
                    param(3) = EMethod
                    param(4) = NEWLANO
                    param(5) = "Treaty Re-Allocation"
                    param(6) = ""
                    param(7) = ""
                    param(8) = False
                    param(9) = GetItemValue(ds, i, "RefNo")
                    param(10) = GetItemValue(ds, i, "RefDate")
                    param(11) = IIf(Category.ToUpper = "TREATY_REALLOCATION (TABLES) - DATA CORRECTION", 0, 4)   ' 0 : Default, 4 : Add/Refund for Re Only
                    param(12) = ""
                    param(13) = False
                    param(14) = "UW"
                    param(15) = ""
                    param(16) = ""
                    NEWANO = Endorsement(ANO, param)
                    If NEWANO = 0 Then
                        ErrMsg = "Process : 'Endorsement Policy/CertificateNo (" & PolicyNo & IIf(CertificateNo <> "", "-", "") & CertificateNo & ")' failed !"
                        GoTo ErrRollback
                    End If
                    If Not db.ReleaseLockedObject("Policy" & ANO) Then
                        ErrMsg = db.ErrDesc
                        GoTo ErrRollback
                    End If
                End If
                Select Case Category.ToUpper
                    Case "ANNUAL REALLOCATION", "TREATY_REALLOCATION (TABLES)"
                        If Not Reinsurance_Cession(NEWANO) Then GoTo errmsg
                        If Not Check_RateCon(NEWANO) Then GoTo errmsg
                    Case "TREATY_REALLOCATION (TABLES) - DATA CORRECTION"
                        If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "PREMIUM_CALC", NEWANO, , True, , , ) Then
                            ErrMsg = Me.ErrDesc
                            GoTo ErrRollback
                        End If
                    Case Else '"TREATY_REALLOCATION (TABLES) - ENDORSE ONLY"
                        ' Do Nothing
                End Select
            Else    ' AStatus<>'I'
                NEWLANO = LANO
                NEWANO = ANO
                Select Case Category.ToUpper
                    Case "ANNUAL REALLOCATION", "TREATY_REALLOCATION (TABLES)"
                        If Not Reinsurance_Cession(NEWANO) Then GoTo errmsg
                        If Not Check_RateCon(NEWANO) Then GoTo errmsg
                        If pEMethod <> "T" Then
                            If Not db.Execute("Update Acceptance Set EMethod='T' from Acceptance Where ANO=" & NEWANO) Then
                                ErrMsg = db.ErrDesc
                                GoTo ErrRollback
                            End If
                        End If
                    Case "TREATY_REALLOCATION (TABLES) - DATA CORRECTION"
                        If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "PREMIUM_CALC", NEWANO, , True, , , ) Then
                            ErrMsg = Me.ErrDesc
                            GoTo ErrRollback
                        End If
                        If pEMethod <> "T" Then
                            If Not db.Execute("Update Acceptance Set EMethod='T' from Acceptance Where ANO=" & NEWANO) Then
                                ErrMsg = db.ErrDesc
                                GoTo ErrRollback
                            End If
                        End If
                    Case Else '"TREATY_REALLOCATION (TABLES) - ENDORSE ONLY"
                        ' Do Nothing
                End Select
            End If

ErrRollback:
            i = i + 1
            If ErrMsg <> "" Then   ' Any Error
                ds.Tables(0).Rows(i - 1)("Message") = ErrMsg
                StrMsg = StrMsg & ErrMsg & vbCrLf
                Do While Not (LANO <> toval(GetItemValue(ds, i, "LANO")) Or LANO = -1 Or OpenFlag)
                    i = i + 1
                    ds.Tables(0).Rows(i - 1)("Message") = ErrMsg
                Loop
                db.RollBack()
            Else
                If LANO <> toval(GetItemValue(ds, i, "LANO")) Or LANO = -1 Or OpenFlag Then
                    ErrMsg = StrMsg
                    StrMsg = ""
                    If InforceF Then
                        If LANO = -1 Or OpenFlag Then
                            If PreInforceConditionsOk(NEWANO) Then
                                If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "INFORCE", NEWANO, AUserID, BackDatedF, pADate) Then
                                    StrMsg = Me.ErrDesc
                                End If
                            End If
                        Else
                            rs = db.OpenRemoteSet("Select ANO from Acceptance Where AStatus='W' and ANO<>LANO and LANO=" & NEWLANO)
                            Do While Not rs.Eof
                                If Not PreInforceConditionsOk(rs.fields("ANO")) Then Exit Do
                                rs.MoveNext()
                            Loop
                            If rs.Eof Then  ' All Check
                                If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "INFORCEMASTER", NEWLANO, AUserID, BackDatedF, pADate) Then
                                    StrMsg = Me.ErrDesc
                                End If
                            End If
                        End If
                    End If
                    If StrMsg <> "" Then
                        StrMsg = ErrMsg & StrMsg & vbCrLf
                        ds.Tables(0).Rows(i - 1)("Message") = StrMsg
                        db.RollBack()
                    Else
                        StrMsg = ErrMsg
                        db.Committrans()
                    End If
                End If
            End If
        Loop

        Dim dv As DataView
        dv = New DataView(ds.Tables(0))
        Select Case ShowResult
            Case "0"
                dv.RowFilter = "Message<>''"
            Case "1"
                dv.RowFilter = "Message=''"
        End Select

        Dim serializer As New XmlSerializer(GetType(DataSet))
        Dim Writer As New StringWriter
        serializer.Serialize(Writer, DataViewToDataSet(dv))
        dsFailed = Writer.GetStringBuilder.ToString

        TreatyReAllocation = True
        db.Begintrans()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        TreatyReAllocation = False
    End Function
    Private Function PreInforceConditionsOk(ByVal ANO As Long) As Boolean
        Dim rs As RemoteSet

        On Error GoTo errmsg

        'Check Rarrheader
        rs = db.OpenRemoteSet("Select A.PolicyNo, A.CertificateNo, A.AType, A.AStatus, A.PStatus, R.TShare, R.RAmount, R.SAmount, R.Shortfall, R.HoldF, R.Message, R.ManualF, R.CID, R.CAmount, R.XPID, R.XPAmount, R.QID, R.QAmount, R.QSRAmount, R.SP1Amount, R.SP2Amount, R.SP3Amount from RArrHeader R, Acceptance A Where R.ANO=A.ANO and A.ANO=" & ANO)
        If Not rs.Eof Then
            If UCase(tostr(rs.fields("PStatus"))) = "I" Then
                If StrMsg <> "" Then StrMsg = StrMsg & vbCrLf
                StrMsg = StrMsg & "Inconsistent Data !"
            End If
            If (UCase(tostr(rs.fields("AStatus"))) <> "W" And UCase(tostr(rs.fields("AStatus"))) <> "T") Then
                If StrMsg <> "" Then StrMsg = StrMsg & vbCrLf
                StrMsg = StrMsg & "Already Processed !"
            End If

            If toval(rs.fields("TShare"), 0) <> 100 Or toval(rs.fields("RAmount"), 0) <> 0 Or toval(rs.fields("SAmount"), 0) < 0 Or toval(rs.fields("Shortfall")) > 100 Then
                StrMsg = StrMsg & "Incomplete Cession !" & vbCrLf
            End If

            If Not db.GetPrivileges("ALLOWPASSHOLDCESSION") Then
                If rs.fields("HoldF") Then
                    StrMsg = StrMsg & "Hold Cession ! " & vbCrLf
                    StrMsg = StrMsg & "=> " & tostr(rs.fields("Message")) & " <=" & vbCrLf
                End If
            End If

            'If Round(rs.fields("FShare") * rs.fields("TAmount") / 100, 2) <> Round(rs.fields("FAmount"), 2) Then
            '    StrMsg = StrMsg & "Check Sum Insured Facultative Placement !" & vbCrLf
            'End If

            If toval(rs.fields("ManualF")) = 0 Then
                If (toval(rs.fields("QAmount")) + toval(rs.fields("QSRAmount"))) = 0 AndAlso Not db.GetPrivileges("ALLOWNOQSCESSION") Then
                    If (toval(rs.fields("SP1Amount")) + toval(rs.fields("SP2Amount")) + toval(rs.fields("SP3Amount"))) > 0 Then
                        StrMsg = StrMsg & "Check Policy Risk Arrangement for " & GetTreatyDescription(tostr(rs.fields("QID"))) & ", No Amount Ceded. " & vbCrLf
                    ElseIf tostr(rs.fields("QID")) <> "" Then
                        StrMsg = StrMsg & "Check Policy Risk Arrangement for " & GetTreatyDescription(tostr(rs.fields("QID"))) & ", No Amount Ceded. " & vbCrLf
                    End If
                End If
            Else
                ' Move to Reinsurance Cession
                'If (toval(rs.fields("QAmount")) + toval(rs.fields("QSRAmount"))) = 0 AndAlso TOCORCessionF AndAlso Not db.GetPrivileges("ALLOWNOORCESSION") Then
                '    StrMsg = StrMsg & "Check Policy Risk Arrangement for " & GetTreatyDescription(tostr(rs.fields("QID"))) & ", No Amount Ceded. " & vbCrLf
                'End If
            End If

           

        End If

        If StrMsg <> "" Then
            StrMsg = "Please Check the Policy Data " & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & " " & StrMsg
            GoTo errmsg
        End If

        rs.CloseRemoteSet()

        PreInforceConditionsOk = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        PreInforceConditionsOk = False
    End Function
    Private Function GetLockedDate(ByVal Branch As String) As Date
        Dim LockedDate As Date
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select LockedDate from SysTab", adOpenForwardonly)
        LockedDate = todate(rs.fields("LockedDate"))
        rs = db.OpenRemoteSet("Select LockedDate from Branch Where Branch='" & Branch & "' and LockedDate>'" & Format(LockedDate, "MM/DD/YYYY") & "'")
        If Not rs.Eof Then
            LockedDate = todate(rs.fields("LockedDate"))
        End If
        GetLockedDate = LockedDate
    End Function

