        Dim AdjustFacultativePeriodF As Boolean = toval(getInParamValue(Param, 23))
        Dim Grace As Integer = toval(getInParamValue(Param, 24))
        Dim KeepExistingF As Boolean = toval(getInParamValue(Param, 25))
        Dim NotApplyConjunctPolicyDataF As Boolean = toval(getInParamValue(Param, 26))

        Dim CoverNo As String = ""
        Dim AType As String
        Dim ASource As String
        Dim MO As String
        Dim AID As String
        Dim AName As String
        Dim RefDate As Date
        Dim RegNo As String
        Dim EditMode As Integer
        Dim Prorata As Integer
        Dim Segment As String

        ' Trim Space and CRLF
        If ValueID = ValueDesc Then
            ValueID = Trim(Replace(ValueID, vbCrLf, ""))
            ValueDesc = Trim(Replace(ValueDesc, vbCrLf, ""))
        Else
            ValueID = Trim(Replace(ValueID, vbCrLf, ""))
        End If

        Branch = GetFieldValue(fbuffer(GetFieldIndex("Branch", findex)))
        CT = GetFieldValue(fbuffer(GetFieldIndex("CT", findex)))
        SDate = GetFieldValue(fbuffer(GetFieldIndex("SDate", findex)))
        EDate = GetFieldValue(fbuffer(GetFieldIndex("EDate", findex)))
        AType = GetFieldValue(fbuffer(GetFieldIndex("AType", findex)))
        AID = GetFieldValue(fbuffer(GetFieldIndex("AID", findex)))
        MO = GetFieldValue(fbuffer(GetFieldIndex("MO", findex)))
        AName = GetFieldValue(fbuffer(GetFieldIndex("AName", findex)))
        RefDate = GetFieldValue(fbuffer(GetFieldIndex("RefDate", findex)))
        RefNo = GetFieldValue(fbuffer(GetFieldIndex("RefNo", findex)))
        PHolder = GetFieldValue(fbuffer(GetFieldIndex("PHolder", findex)))
        PayorID = GetFieldValue(fbuffer(GetFieldIndex("PayorID", findex)))
        If PayorID = "" Then PayorID = PHolder
        Prorata = GetFieldValue(fbuffer(GetFieldIndex("Prorata", findex)))
        Segment = GetFieldValue(fbuffer(GetFieldIndex("Segment", findex)))
        RegNo = GetFieldValue(fbuffer(GetFieldIndex("RegNo", findex)))

        Dim PTerm As Integer
        Dim NoRiskAccumulationF As Boolean
        Dim AnnualTreatyF As Boolean
        Dim STime As String
        Dim ETime As String
        rs = db.OpenRemoteSet("Select PTerm, DefSTime, DefETime, NoRiskAccumulationF, AnnualTreatyF from TOC Where TOC='" & TOC & "'")
        PTerm = rs.fields("PTerm")
        STime = rs.fields("DefSTime")
        ETime = rs.fields("DefETime")
        If PTerm = 0 Then PTerm = 12
        NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
        AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))

        'Creating Cover
        rs = db.OpenQueryDef("QCover", adOpenKeyset, CNO)
        If rs.Eof Then
            'Set Auto Numbering Here
            CoverNo = GetDocumentNumbering("COV", PolicyType, ISType, SDate, Branch, TOC, CT)
            If CoverNo = "" Then
                StrMsg = "Generate Cover No./Quotation No. Failed !"
                GoTo errmsg
            End If

            rs = db.OpenRemoteSet("Select * from Cover Where 1<>1")
            rs.AddNew()
            rs.fields("CoverNo") = CoverNo
            rs.fields("Voyage") = Voyage
            rs.fields("ISType") = ISType
