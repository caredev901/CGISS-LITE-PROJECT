    Private Function isTheSameDataRecord(ByVal rs1 As RemoteSet, ByVal rs2 As RemoteSet) As Boolean
        Try
            isTheSameDataRecord = True
            If rs1.fields_Count <> rs2.fields_Count Then
                isTheSameDataRecord = False
            Else
                For i = 0 To rs1.fields_Count - 1
                    If rs1.fields(i) <> rs2.fields(i) Then
                        isTheSameDataRecord = False
                        Exit For
                    End If
                Next
            End If
        Catch ex As Exception
            isTheSameDataRecord = False
        End Try
    End Function

    Private Function isTheSameData(ByVal rs1 As RemoteSet, ByVal rs2 As RemoteSet) As Boolean
        Try
            isTheSameData = True
            If rs1.RecordCount <> rs2.RecordCount Then
                isTheSameData = False
            Else
                Do While Not rs1.Eof
                    If Not isTheSameDataRecord(rs1, rs2) Then
                        isTheSameData = False
                        Exit Do
                    End If
                    rs1.MoveNext()
                    rs2.MoveNext()
                Loop
            End If
        Catch ex As Exception
            isTheSameData = False
        End Try
    End Function
    Private Function isAnyPolicyChanges(ByVal pANO As Long, ByVal ANO As Long) As Boolean
        Try
            Dim rs1 As RemoteSet
            Dim rs2 As RemoteSet
            Dim SQL As String

            isAnyPolicyChanges = False

            ' Check Premium Calculation Details
            SQL = "Select I1.Currency, I1.Code, I2.TOI, I2.Remark, I1.TOR, I1.SDate, I1.EDate, I1.Rate, I1.Prorata, I1.PCTLoss, I1.PCTADJ, I1.TSI, I1.GROSS, I1.DISCOUNT, I1.DDISCOUNT, I1.LOADING, I1.LMFACTOR"
            SQL = SQL & " from ICalc I1 Inner Join ICover I2 on (I2.INO=I1.INO)"
            SQL = SQL & " Where I1.ANO=" & pANO
            SQL = SQL & " Order by I1.Currency, I1.Code, I2.TOI, I2.Remark, I1.TOR, I1.SDate, I1.EDate"
            rs1 = db.OpenRemoteSet(SQL)

            SQL = "Select I1.Currency, I1.Code, I2.TOI, I2.Remark, I1.TOR, I1.SDate, I1.EDate, I1.Rate, I1.Prorata, I1.PCTLoss, I1.PCTADJ, I1.TSI, I1.GROSS, I1.DISCOUNT, I1.DDISCOUNT, I1.LOADING, I1.LMFACTOR"
            SQL = SQL & " from ICalc I1 Inner Join ICover I2 on (I2.INO=I1.INO)"
            SQL = SQL & " Where I1.ANO=" & ANO
            SQL = SQL & " Order by I1.Currency, I1.Code, I2.TOI, I2.Remark, I1.TOR, I1.SDate, I1.EDate"
            rs2 = db.OpenRemoteSet(SQL)

            isAnyPolicyChanges = (Not isTheSameData(rs1, rs2))
            If isAnyPolicyChanges Then Exit Function

            ' Deductibles
            SQL = "Select TOR, DCODE, SECTION, PCTTSI, PCTCL, FIXEDMIN, FIXEDMAX, CURRENCY, FIXEDMIN_AOE, FIXEDMAX_AOE, POLICYYEAR, SDATE, EDATE, STRTSI, DDISCOUNT"
            SQL = SQL & " from ACCDED"
            SQL = SQL & " Where ACCDED.ANO=" & pANO
            SQL = SQL & " Order by ANO, TOR, DCODE, SECTION, PolicyYear"
            rs1 = db.OpenRemoteSet(SQL)

            SQL = "Select TOR, DCODE, SECTION, PCTTSI, PCTCL, FIXEDMIN, FIXEDMAX, CURRENCY, FIXEDMIN_AOE, FIXEDMAX_AOE, POLICYYEAR, SDATE, EDATE, STRTSI, DDISCOUNT"
            SQL = SQL & " from ACCDED"
            SQL = SQL & " Where ACCDED.ANO=" & ANO
            SQL = SQL & " Order by ANO, TOR, DCODE, SECTION, PolicyYear"
            rs2 = db.OpenRemoteSet(SQL)

            isAnyPolicyChanges = (Not isTheSameData(rs1, rs2))
            If isAnyPolicyChanges Then Exit Function

            ' Risk Arrangement
            SQL = "Select pR.PCTSHARE, pR.MSHARE, pR.MAMOUNT, pR.RETENTION, pR.RAMOUNT, pR.SHORTFALL, "
            SQL = SQL & " case When pR.CShare=0 and R.CShare=0 Then R.CID Else pR.CID end CID, pR.CSHARE, "
            SQL = SQL & " case When pR.DShare=0 and R.DShare=0 Then R.DID Else pR.DID end DID, pR.DSHARE, "
            SQL = SQL & " case When pR.QShare=0 and R.QShare=0 Then R.QID Else pR.QID end QID, pR.QSHARE, "
            SQL = SQL & " case When pR.XPShare=0 and R.XPShare=0 Then R.XPID Else pR.XPID end XPID, pR.XPSHARE,"
            SQL = SQL & " case When pR.SP1SHARE=0 and R.SP1SHARE=0 Then R.SP1ID Else pR.SP1ID end SP1ID, pR.SP1SHARE,"
            SQL = SQL & " case When pR.SP2SHARE=0 and R.SP2SHARE=0 Then R.SP2ID Else pR.SP2ID end SP2ID, pR.SP2SHARE,"
            SQL = SQL & " case When pR.SP3SHARE=0 and R.SP3SHARE=0 Then R.SP3ID Else pR.SP3ID end SP3ID, pR.SP3SHARE,"
            SQL = SQL & " case When pR.ASHARE=0 and R.ASHARE=0 Then R.AID Else pR.AID end AID, pR.ASHARE, pR.FSHARE, pR.FAMOUNT, pR.EXOLF"
            SQL = SQL & " from Acceptance A"
            SQL = SQL & " Inner join RArrHeader R on (R.ANO=A.ANO)"
            SQL = SQL & " Inner Join RArrHeader pR on (pR.ANO=A.pANO)"
            SQL = SQL & " Where A.ANO=" & ANO
            rs1 = db.OpenRemoteSet(SQL)

            SQL = "Select PCTSHARE, MSHARE, MAMOUNT, RETENTION, RAMOUNT, SHORTFALL, CID, CSHARE, DID, DSHARE, QID, QSHARE, XPID, XPSHARE, SP1ID, SP1SHARE, SP2ID, SP2SHARE, SP3ID, SP3SHARE, AID, ASHARE, FSHARE, FAMOUNT, EXOLF"
            SQL = SQL & " from RArrHeader"
            SQL = SQL & " Where RArrHeader.ANO=" & ANO
            rs2 = db.OpenRemoteSet(SQL)

            isAnyPolicyChanges = (Not isTheSameData(rs1, rs2))
            If isAnyPolicyChanges Then Exit Function


        Catch ex As Exception
            isAnyPolicyChanges = True
        End Try

    End Function
    Private Function CheckPolicyMandatoryDocument(ByVal ANO As Long, ByRef ErrMsg As String) As Boolean
        Try
            Dim rsC As RemoteSet

            ErrMsg = ""

            rsC = db.OpenQueryDef("QACCDOCLIST", adOpenKeyset, ANO)
            If Not rsC.Eof Then
                Dim ForceCheckAttachmentF As Boolean = False
                Dim CheckOnlyWithAttachmentF As Boolean = False
                ForceCheckAttachmentF = (db.GetPrivileges("FORCECHECKDOCAVAILABILITYYWITHATTACHMENT") And db.GetUserType <> "SUPERVISOR")
                If Not ForceCheckAttachmentF Then
                    CheckOnlyWithAttachmentF = (db.GetPrivileges("CHECKDOCAVAILABILITYYONLYWITHATTACHMENT"))
                End If
                Do While Not rsC.Eof
                    If (toval(rsC.fields("MandatoryF")) Or toval(rsC.fields("RequiredF"))) Then
                        If Not toval(rsC.fields("ProcessFlag")) AndAlso Not (CheckOnlyWithAttachmentF And rsC.fields("CountImage") <> 0) Then
                            ErrMsg = ErrMsg & "Please Check The Availability of Mandatory/Required Document (" & rsC.fields("DocType") & " - " & rsC.fields("Description") & ")" & vbCrLf
                        Else
                            If ForceCheckAttachmentF AndAlso rsC.fields("CountImage") = 0 Then
                                ErrMsg = ErrMsg & "Please Check The Attachment of Mandatory/Required Document (" & rsC.fields("DocType") & " - " & rsC.fields("Description") & ")" & vbCrLf
                            End If
                        End If
                    End If
                    rsC.MoveNext()
                Loop
            End If
            If ErrMsg <> "" Then
                Return False
            Else
                Return True
            End If
        Catch ex As Exception
            ErrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function Reinsurance_Rate(ByVal ANO As Long, ByRef CCY As String) As Double
        Dim rs As RemoteSet
        Dim CCYTo As String
        Dim BaseCCY As String
        Dim Rate As Double
        Rate = 1
        rs = db.OpenRemoteSet("Select Currency from SysTab", adOpenForwardonly)
        BaseCCY = rs.fields("Currency")
        If CCY = "" Then CCY = BaseCCY
        If CCY.ToUpper <> BaseCCY.ToUpper Then
            CCYTo = CCY
            Do
                CCY = CCYTo
                rs = db.OpenQueryDef("QReinsurance_Rate", adOpenForwardonly, ANO, CCY)
                CCYTo = tostr(rs.fields("CCYTO"))
                Rate = Rate * toval(rs.fields("Rate"))
            Loop While CCYTo.ToUpper <> CCY.ToUpper And CCYTo.ToUpper <> "" And CCYTo.ToUpper <> BaseCCY.ToUpper
        End If
        Reinsurance_Rate = Rate
    End Function
    Private Function Compare_DueDate_Payor_and_Facultative(ByVal ANO As Long, ByVal LANO As Long, ByVal MinLapseFacDue As Integer, ByVal BookingDate As Date, ByVal Effective As Date, Optional ByVal FID As String = "", Optional ByRef ErrMsg As String = "") As Boolean
        Dim rsP As RemoteSet
        Dim rsF As RemoteSet
        Dim PDueDate As Date
        Dim FDueDate As Date
        Dim FacDueByEffectiveF As Boolean
        Dim DueByEffectiveF As Boolean
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select FacDueByEffectiveF, DueByEffectiveF from SysTab")
        FacDueByEffectiveF = toval(rs.fields("FacDueByEffectiveF"))
        DueByEffectiveF = toval(rs.fields("DueByEffectiveF"))

        ErrMsg = ""
        If ANO <> LANO And LANO <> -1 Then
            rsP = db.OpenRemoteSet("Select wpc, grace, installment, idate_1, idate_2, idate_3, idate_4, idate_5, idate_6, idate_7, idate_8, idate_9, idate_10, idate_11, idate_12, idate_13, idate_14, idate_15, idate_16, idate_17, idate_18, idate_19, idate_20, idate_21, idate_22, idate_23, idate_24 from APayor Where ANO=" & ANO)
            If rsP.Eof Then
                rsP = db.OpenRemoteSet("Select wpc, grace, installment, idate_1, idate_2, idate_3, idate_4, idate_5, idate_6, idate_7, idate_8, idate_9, idate_10, idate_11, idate_12, idate_13, idate_14, idate_15, idate_16, idate_17, idate_18, idate_19, idate_20, idate_21, idate_22, idate_23, idate_24 from Payor Where ANO=" & LANO)
            End If
        Else
            rsP = db.OpenRemoteSet("Select wpc, grace, installment, idate_1, idate_2, idate_3, idate_4, idate_5, idate_6, idate_7, idate_8, idate_9, idate_10, idate_11, idate_12, idate_13, idate_14, idate_15, idate_16, idate_17, idate_18, idate_19, idate_20, idate_21, idate_22, idate_23, idate_24 from Payor Where ANO=" & ANO)
        End If
        If FID <> "" Then
            rsF = db.OpenRemoteSet("Select wpc, grace, installment, idate_1, idate_2, idate_3, idate_4, idate_5, idate_6, idate_7, idate_8, idate_9, idate_10, idate_11, idate_12, idate_13, idate_14, idate_15, idate_16, idate_17, idate_18, idate_19, idate_20, idate_21, idate_22, idate_23, idate_24, R.SDate from RArrDet R, FPart F Where F.ANO=R.ANO and F.FID=R.FID and R.AType<>'C' and R.Status<>'O' and R.ANO=" & ANO & " and R.FID='" & FID & "'")
        Else
            rsF = db.OpenRemoteSet("Select wpc, grace, installment, idate_1, idate_2, idate_3, idate_4, idate_5, idate_6, idate_7, idate_8, idate_9, idate_10, idate_11, idate_12, idate_13, idate_14, idate_15, idate_16, idate_17, idate_18, idate_19, idate_20, idate_21, idate_22, idate_23, idate_24, R.SDate from RArrDet R, FPart F Where F.ANO=R.ANO and F.FID=R.FID and R.AType<>'C' and R.Status<>'O' and R.ANO=" & ANO & "")
        End If
        Dim i As Integer
        Dim fInstallment As Integer
        Dim pInstallment As Integer
        Dim Installment As Integer
        Dim fPCT As Integer = 0
        Dim pPCT As Integer = 0
        Dim FacDueDate As Date
        Dim PolDueDate As Date
        Do While Not rsF.Eof
            If FacDueByEffectiveF Then
                FacDueDate = IIf(todate(rsF.fields("SDate")) < Effective, Effective, todate(rsF.fields("SDate")))
            Else
                If DueByEffectiveF Then
                    FacDueDate = Effective
                Else
                    FacDueDate = BookingDate
                End If
            End If

            If DueByEffectiveF Then
                PolDueDate = Effective
            Else
                PolDueDate = BookingDate
            End If

            fInstallment = rsF.fields("Installment")
            pInstallment = rsP.fields("Installment")

            If fInstallment <> pInstallment AndAlso Not db.GetPrivileges("ALLOWFACINSTDIFFERSWITHPAYORINST") Then
                ErrMsg = "Facultative installment differs with payor installment (Fac Slip No. " & rsF.fields("SlipNO") & ") !"
                Return False
            End If

            If pInstallment <> 0 Then
                If fInstallment <> 0 Then
                    If pInstallment <> fInstallment Then
                        ' Get First Installment
                        PDueDate = rsP.fields("IDate_" & 1)
                        FDueDate = rsF.fields("IDate_" & 1)
                        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), FDueDate) < 0 Then
                            If MinLapseFacDue = 0 Then
                                ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Payor Due on " & Format(PDueDate, "dd-mmm-yy") & " !"
                            Else
                                ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Date on " & Format(DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), "dd-mmm-yy") & " !"
                            End If
                            Return False
                        End If
                        ' Get Last Installment
                        PDueDate = rsP.fields("IDate_" & pInstallment)
                        FDueDate = rsF.fields("IDate_" & fInstallment)
                        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), FDueDate) < 0 Then
                            If MinLapseFacDue = 0 Then
                                ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Payor Due on " & Format(PDueDate, "dd-mmm-yy") & " !"
                            Else
                                ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Date on " & Format(DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), "dd-mmm-yy") & " !"
                            End If
                            Return False
                        End If
                    Else
                        Installment = fInstallment
                        For i = 1 To Installment
                            'Loop for Each Installment
                            PDueDate = rsP.fields("IDate_" & i)
                            FDueDate = rsF.fields("IDate_" & i)
                            If DateDiff(DateInterval.Day, DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), FDueDate) < 0 Then
                                If MinLapseFacDue = 0 Then
                                    ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Payor Due on " & Format(PDueDate, "dd-mmm-yy") & " !"
                                Else
                                    ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Date on " & Format(DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), "dd-mmm-yy") & " !"
                                End If
                                Return False
                            End If
                        Next
                    End If
                Else
                    ' Get Last Installment
                    PDueDate = rsP.fields("IDate_" & pInstallment)
                    FDueDate = DateAdd(DateInterval.Day, rsF.fields("Grace") + rsF.fields("WPC"), FacDueDate)

                    If DateDiff(DateInterval.Day, DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), FDueDate) < 0 Then
                        If MinLapseFacDue = 0 Then
                            ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Payor Due on " & Format(PDueDate, "dd-mmm-yy") & " !"
                        Else
                            ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Date on " & Format(DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), "dd-mmm-yy") & " !"
                        End If
                        Return False
                    End If
                End If
            Else
                If fInstallment <> 0 Then
                    PDueDate = DateAdd(DateInterval.Day, rsP.fields("Grace") + rsP.fields("WPC"), PolDueDate)
                    ' Get First Installment
                    FDueDate = rsF.fields("IDate_" & 1)
                    If DateDiff(DateInterval.Day, DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), FDueDate) < 0 Then
                        If MinLapseFacDue = 0 Then
                            ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Payor Due on " & Format(PDueDate, "dd-mmm-yy") & " !"
                        Else
                            ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Date on " & Format(DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), "dd-mmm-yy") & " !"
                        End If
                        Return False
                    End If
                Else
                    PDueDate = DateAdd(DateInterval.Day, rsP.fields("Grace") + rsP.fields("WPC"), PolDueDate)
                    FDueDate = DateAdd(DateInterval.Day, rsF.fields("Grace") + rsF.fields("WPC"), FacDueDate)

                    If DateDiff(DateInterval.Day, DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), FDueDate) < 0 Then
                        If MinLapseFacDue = 0 Then
                            ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Payor Due on " & Format(PDueDate, "dd-mmm-yy") & " !"
                        Else
                            ErrMsg = "Incorrect Payment Due To Reinsurer (Fac Slip No. " & rsF.fields("SlipNO") & ") on " & Format(FDueDate, "dd-mmm-yy") & ", must be greater than or equal to Date on " & Format(DateAdd(DateInterval.Day, MinLapseFacDue, PDueDate), "dd-mmm-yy") & " !"
                        End If
                        Return False
                    End If
                End If
            End If

            rsF.MoveNext()
        Loop
        Return True
    End Function
    Private Function Check_Overall_FacultativeRate_GreaterThan_GrossRate(ByVal ANO As Long) As Boolean
        Dim rsP As RemoteSet
        Dim rs As RemoteSet
        Dim Rate As Double = 0
        Dim Unit As String
        Dim NetRate As Double
        Dim OurShare As Double = 0
        Dim FacRate As Double = 0
        Dim TotalPremium As Double = 0
        Dim TotalFacPremium As Double = 0

        Check_Overall_FacultativeRate_GreaterThan_GrossRate = False

        Dim SQL As String = ""

        If CBool(toval(GetAppSetting("CheckFacPremiumInclPolicyConjunctionF"))) Then
            SQL = SQL & " Declare @P_ANO int"
            SQL = SQL & " Select @P_ANO=" & ANO

            SQL = SQL & " Select A.ANO, P.Gross, P.TSI"
            SQL = SQL & " from"
            SQL = SQL & " ("

            SQL = SQL & " Select A1.ANO"
            SQL = SQL & " from acceptance a1 "
            SQL = SQL & " Where (a1.ANO=@P_ANO or a1.CANO=@P_ANO) and a1.AType in ('N','E')"
            SQL = SQL & " and not exists (Select Top 1 pANO from acceptance nA1 Where nA1.pANO=A1.ANO and nA1.AType in ('N','E','C'))"
            SQL = SQL & " "
            SQL = SQL & " Union All"
            SQL = SQL & " "
            SQL = SQL & " Select A2.ANO"
            SQL = SQL & " from acceptance a1 "
            SQL = SQL & " inner join acceptance A2 on (A2.ANO=A1.CANO or A2.CANO=A1.CANO)"
            SQL = SQL & " Where A2.AType in ('N','E') and A1.ANO=@P_ANO and A1.CANO<>-1 and not (a2.ANO=@P_ANO or a2.CANO=@P_ANO)"
            SQL = SQL & " and not exists (Select Top 1 pANO from acceptance nA2 Where nA2.pANO=A2.ANO and nA2.AType in ('N','E','C'))"
            SQL = SQL & " ) A"
            SQL = SQL & " Cross Apply ("
            SQL = SQL & " Select Gross, TSI from fn_Icalc(A.ANO)"
            SQL = SQL & " ) P"
        Else
            SQL = SQL & " Declare @P_ANO int"
            SQL = SQL & " Select @P_ANO=" & ANO

            SQL = SQL & " Select A.ANO, P.Gross, P.TSI"
            SQL = SQL & " from"
            SQL = SQL & " ("
            SQL = SQL & " Select A1.ANO"
            SQL = SQL & " from acceptance a1 "
            SQL = SQL & " Where a1.ANO=@P_ANO"
            SQL = SQL & " ) A"
            SQL = SQL & " Cross Apply ("
            SQL = SQL & " Select Gross, TSI from fn_Icalc(A.ANO)"
            SQL = SQL & " ) P"
        End If


        rsP = db.OpenRemoteSet(SQL)
        If Not rsP.Eof Then
            Do While Not rsP.Eof
                OurShare = toval(rsP.fields("TSI"))
                Rate = toval(rsP.fields("Gross")) / OurShare * 100
                FacRate = 0
                rs = db.OpenQueryDef("QFacOut", adOpenForwardonly, rsP.fields("ANO"))
                Do While Not rs.Eof
                    ' Check only for Net Rate and Not Cancellation
                    If tostr(rs.fields("Status")) <> "O" AndAlso tostr(rs.fields("AType")) <> "C" Then
                        If toval(rs.fields("NetRate")) <> 0 Then
                            NetRate = 0
                            If Not toval(rs.fields("FullCoverF")) Then
                                Dim rsDet As RemoteSet
                                rsDet = db.OpenRemoteSet("Select Unit, NetRate from FPartDet Where ANO=" & rsP.fields("ANO") & " and FID='" & tostr(rs.fields("FID")) & "'")
                                Do While Not rsDet.Eof
                                    Unit = tostr(rsDet.fields("Unit"))

                                    Select Case Unit
                                        Case "", "C"
                                            NetRate = NetRate + toval(rsDet.fields("NetRate"))
                                        Case "M"
                                            NetRate = NetRate + toval(rsDet.fields("NetRate")) / 10
                                        Case "F"
                                            NetRate = NetRate + toval(rsDet.fields("NetRate")) * Reinsurance_Rate(rsP.fields("ANO"), tostr(rs.fields("Currency"))) / (toval(rs.fields("Amount")) * toval(rs.fields("RShare")) / 100) * 100
                                    End Select

                                    rsDet.MoveNext()
                                Loop
                            Else
                                Unit = tostr(rs.fields("Unit"))
                                Select Case Unit
                                    Case "", "C"
                                        NetRate = NetRate + toval(rs.fields("NetRate"))
                                    Case "M"
                                        NetRate = NetRate + toval(rs.fields("NetRate")) / 10
                                    Case "F"
                                        NetRate = NetRate + toval(rs.fields("NetRate")) * Reinsurance_Rate(rsP.fields("ANO"), tostr(rs.fields("Currency"))) / (toval(rs.fields("Amount")) * toval(rs.fields("RShare")) / 100) * 100
                                End Select
                            End If
                            If toval(rs.fields("Limit")) <> 0 Then
                                FacRate = FacRate + NetRate * toval(rs.fields("Share")) / 100 * toval(rs.fields("RShare")) / 100 * toval(rs.fields("Limit")) / OurShare
                            Else
                                FacRate = FacRate + NetRate * toval(rs.fields("Share")) / 100 * toval(rs.fields("RShare")) / 100
                            End If
                        Else
                            FacRate = FacRate + Rate * toval(rs.fields("Share")) / 100 * toval(rs.fields("RShare")) / 100
                        End If
                    End If
                    
                    rs.MoveNext()
                Loop
                TotalPremium = TotalPremium + Rate / 100 * OurShare
                TotalFacPremium = TotalFacPremium + FacRate / 100 * OurShare

                rsP.MoveNext()
            Loop

            If Math.Round(TotalPremium, 2, MidpointRounding.AwayFromZero) < Math.Round(TotalFacPremium, 2, MidpointRounding.AwayFromZero) Then
                Check_Overall_FacultativeRate_GreaterThan_GrossRate = True
            End If

        End If
    End Function

    Private Function Check_Facultative_Commission_LessThan_OutGo(ByVal ANO As Long, ByRef ErrMsg As String) As Boolean
        Dim rsF As RemoteSet
        Dim rs As RemoteSet

        ErrMsg = ""
        rs = db.OpenRemoteSet("Select F.FID, F.SlipNo from RArrDet R, FPart F Where F.ANO=R.ANO and F.FID=R.FID and R.AType<>'C' and R.Status<>'O' and R.ANO=" & ANO)
        Do While Not rs.Eof
            rsF = db.OpenQueryDef("QCheckFacCommission", adOpenForwardonly, ANO, rs.fields("FID"))
            If toval(rsF.fields("FComm")) < toval(rsF.fields("OutGo")) Then
                ErrMsg = ErrMsg & "Incorrect Commission from Reinsurer (Fac Slip No. " & rs.fields("SlipNO") & ", Rate Code-" & rsF.fields("Code") & "), Commission is Less than Out Go !" & vbCrLf
            End If
            rs.MoveNext()
        Loop

        If ErrMsg <> "" Then
            Check_Facultative_Commission_LessThan_OutGo = True
        Else
            Check_Facultative_Commission_LessThan_OutGo = False
        End If
    End Function

