                    rsd = db.OpenRemoteSet("Select * from AccDed Where 1<>1")
                Else
                    rsd = db.OpenRemoteSet("Select * from AccDed Where ANO=" & ANO & " and DCode='" & tostr(rs.fields("DCode")) & "'")
                End If
                If rsd.Eof OrElse AddF Then
                    Dim Remarks As String = tostr(rs.fields("Remarks"))
                    Dim Remarks_1 As String = tostr(rs.fields("Remarks_1"))
                    Dim PCTTSI As Double = toval(rs.fields("PCTTSI"))
                    Dim PCTCL As Double = toval(rs.fields("PCTCL"))
                    Dim FixedMin As Double = toval(rs.fields("FixedMin"))

                    Dim OPCTTSI As Double = PCTTSI
                    Dim OPCTCL As Double = PCTCL
                    Dim OFixedMin As Double = FixedMin

                    If toval(Replace(rs.fields("DED_AMOUNTSOURCE"), "DEDUCTIBLE_", "")) - 1 >= LBound(ADeductible) And toval(Replace(rs.fields("DED_AMOUNTSOURCE"), "DEDUCTIBLE_", "")) - 1 <= UBound(ADeductible) Then
                        FixedMin = toval(ADeductible(toval(Replace(rs.fields("DED_AMOUNTSOURCE"), "DEDUCTIBLE_", "")) - 1))
                    End If

                    If toval(Replace(rs.fields("DED_PCTTSISOURCE"), "DEDPCTTSI_", "")) - 1 >= LBound(APCTTSI) And toval(Replace(rs.fields("DED_PCTTSISOURCE"), "DEDPCTTSI_", "")) - 1 <= UBound(APCTTSI) Then
                        PCTTSI = toval(APCTTSI(toval(Replace(rs.fields("DED_PCTTSISOURCE"), "DEDPCTTSI_", "")) - 1))
                    End If

                    If toval(Replace(rs.fields("DED_PCTCLSOURCE"), "DEDPCTCL_", "")) - 1 >= LBound(APCTCL) And toval(Replace(rs.fields("DED_PCTCLSOURCE"), "DEDPCTCL_", "")) - 1 <= UBound(APCTCL) Then
                        PCTCL = toval(APCTCL(toval(Replace(rs.fields("DED_PCTCLSOURCE"), "DEDPCTCL_", "")) - 1))
                    End If

                    If FixedMin >= 0 AndAlso PCTTSI >= 0 AndAlso PCTCL >= 0 Then
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("DCode") = tostr(rs.fields("DCode"))
                        rsd.fields("TOR") = tostr(rs.fields("TOR"))
                        rsd.fields("SECTION") = tostr(rs.fields("SECTION"))
                        rsd.fields("PCTTSI") = PCTTSI
                        rsd.fields("PCTCL") = PCTCL
                        rsd.fields("FIXEDMIN") = FixedMin
                        rsd.fields("CURRENCY") = tostr(rs.fields("CURRENCY"))
                        rsd.fields("IUNIT") = tostr(rs.fields("IUNIT"))
                        rsd.fields("METHOD") = tostr(rs.fields("METHOD"))
                        rsd.fields("FIXEDMIN_AOE") = toval(rs.fields("FIXEDMIN_AOE"))
                        rsd.fields("FIXEDMAX_AOE") = toval(rs.fields("FIXEDMAX_AOE"))
                        rsd.fields("STRTSI") = toval(rs.fields("STRTSI"))
                        rsd.fields("POLICYYEAR") = 0
                        rsd.fields("SDATE") = SDate
                        rsd.fields("EDATE") = EDate
                        If OPCTTSI <> PCTTSI Or OPCTCL <> PCTCL Or OFixedMin <> FixedMin Then
                            Remarks = ConstructDeductibleRemarks(rsd, Remarks, "E")
                            Remarks_1 = ConstructDeductibleRemarks(rsd, Remarks_1, "I")
                            rsd.fields("Remarks") = Remarks
                            rsd.fields("Remarks_1") = Remarks_1
                        Else
                            rsd.fields("Remarks") = rs.fields("Remarks")
                            rsd.fields("Remarks_1") = rs.fields("Remarks_1")
                        End If
                        If Not rsd.Update Then GoTo errmsg
                    End If

                End If
                rs.MoveNext()
            Loop
        End If

        ' Cleansing Risk Coverage
        If Not db.Execute("Delete RCover FROM RCover WHERE RCover.ANO=" & ANO & " and Not Exists (Select RateCov.Code from RateCov, ICover, PClass Where RateCov.Code=RCover.Code and PClass.TOI=ICover.TOI and PClass.TOR=RateCov.TOR and RCover.ANO=ICover.ANO)") Then
            StrMsg = StrMsg & "Cleansing Risk Coverage Failed ! " & vbCrLf
            StrMsg = StrMsg & db.ErrDesc & vbCrLf
            GoTo errmsg
        End If

        If db.RecordsAffected <> 0 Then
            ' Cleansing Deductible
            If Not db.Execute("Delete AccDed from AccDed Where AccDed.ANO=" & ANO & " and Not Exists (Select R1.TOR from RateCov R1, RCover R2 where R1.TOR=AccDed.TOR and R1.Code=R2.Code and R2.ANO=AccDed.ANO)") Then
                StrMsg = StrMsg & "Cleansing Deductible Failed ! " & vbCrLf
                StrMsg = StrMsg & db.ErrDesc & vbCrLf
                GoTo errmsg
            End If
        End If

        ' Apply for Master Policy/Individual Policy/Certificate Open Cover
        If LANO = ANO OrElse LANO = -1 OrElse (OpenFlag) Then
            
        End If

        

        

        ' Fee & Duty
        If AType = "N" Or AType = "E" Then
            If ((SType = "M" And ANO = LANO) Or (SType = "O") Or (SType = "S")) And (ISType = "I" Or ISType = "L") Then
                If Not (CANO <> -1 AndAlso CBool(toval(GetAppSetting("CopyFeeDutyFromMainPolicyF")))) Then
                    rs = db.OpenRemoteSet("Select TOP_FD.* from TOP_FD, FDTAB Where FDTAB.FDID=TOP_FD.FDID and FDTAB.ATYPE='" & AType & "' and TOP_FD.TOPRO='" & TOPRO & "' and TOP_FD.Currency='" & CCY & "'")
                    rsd = db.OpenRemoteSet("Select top 1 * from AccFD Where ANO=" & ANO)
                    If (Not rs.Eof And rsd.Eof) Or ResetF Then
                        If Not rsd.Eof Then
                            If Not Delete_Records("Delete from AccFD Where ANO=" & ANO) Then GoTo errmsg
                            rsd = db.OpenRemoteSet("Select * from AccFD Where 1<>1")
                        End If
                        Do While Not rs.Eof
                            rsd.AddNew()
                            rsd.fields("ANO") = ANO
                            rsd.fields("ID") = "<Payor>"
                            rsd.fields("FDID") = tostr(rs.fields("FDID"))
                            rsd.fields("Remark") = tostr(rs.fields("Remark"))
                            rsd.fields("Currency") = tostr(rs.fields("Currency"))
                            rsd.fields("Amount") = IIf(SType = "S", toval(rs.fields("Amount_I")), IIf(SType = "M", toval(rs.fields("Amount_G")), toval(rs.fields("Amount_O"))))
                            rsd.fields("AmountPCT") = toval(rs.fields("AmountPCT"))
                            rsd.fields("AMOUNTPCTBASED") = toval(rs.fields("AMOUNTPCTBASED"))
                            rsd.fields("LUserID") = db_user
                            rsd.fields("LDate") = Today.Date
                            rsd.fields("AutoGeneratedF") = False
                            If Not rsd.Update Then GoTo errmsg
                            rs.MoveNext()
                        Loop
                    End If
                End If
            End If
        End If

        If Discount <> 0 Then
            If LANO <> ANO And LANO <> -1 Then
                rsd = db.OpenRemoteSet("Select * from APayor Where ANO=" & ANO)
                If rsd.Eof Then
                    rss = db.OpenRemoteSet("Select * from Payor Where ANO=" & LANO)
                    If Not rss.Eof Then
                        rsd.AddNew()
                        If Not db.backup_record(rss, rsd) Then GoTo errmsg
                        rsd.fields("ANO") = ANO
                        rsd.fields("Discount") = Discount
                        If Not rsd.Update Then GoTo errmsg
                    End If
                End If
            Else
                rsd = db.OpenRemoteSet("Select * from Payor Where ANO=" & ANO)
                If toval(rsd.fields("DefaultPayorF")) AndAlso toval(rsd.fields("Discount")) = 0 Then
                    rsd.Edit()
                    rsd.fields("Discount") = Discount
                    If Not rsd.Update Then GoTo errmsg
                End If
            End If
        End If

        ' Update Acceptance

        If Not db.Execute("Update Acceptance Set TOPRO='" & TOPRO & "', PStatus='I' from Acceptance Where ANO=" & ANO) Then GoTo errmsg
        TOP_Process = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        TOP_Process = False
    End Function
    Private Function Save_Coverage(ByVal Param As Object, ByVal findex() As String, ByVal fbuffer() As String, ByVal bufferdata As Object) As Boolean
        Dim i As Integer
        Dim rs As RemoteSet

        On Error GoTo errmsg

        Dim ANO As Long = Param(0)
        Dim Code As String = Param(1)
        Dim SDate As Date = Param(2)
        Dim Portion As Double = Param(3)
        Dim PCode As String
        Dim PSDate As Date
        Dim EditMode As Integer

        Dim MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1

        ' Get Previous Value
        PCode = tostr(GetFieldValue(fbuffer(GetFieldIndex("Code", findex))))
        PSDate = todate(GetFieldValue(fbuffer(GetFieldIndex("SDate", findex))))

        If tostr(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex)))) = "" OrElse DateDiff(DateInterval.Day, todate(GetFieldValue(fbuffer(GetFieldIndex("NCDate", findex)))), SDate) > 0 Then
            fbuffer(GetFieldIndex("NCDate", findex)) = SetFieldValue(SDate)
        End If

        If Not db.Execute("Delete from RCoverDet Where ANO=" & ANO & " and Code='" & PCode & "' and SDate='" & Format(PSDate, "MM/DD/YYYY") & "'") Then GoTo errmsg
        rs = db.OpenQueryDef("QRCover", adOpenKeyset, ANO, PCode, PSDate)
        If rs.Eof Then
            rs.AddNew()
        Else
            rs.Edit()
        End If
        EditMode = rs.editmode

        ' Save All Fields
        For i = 0 To UBound(findex) - 1
            rs.fields(findex(i)) = GetFieldValue(fbuffer(i))
        Next i

        rs.fields("Code") = Code
        rs.fields("SDate") = SDate
        rs.fields("Portion") = Portion
        rs.fields("ANO") = ANO
        rs.fields("TRANSHIPMENT") = IIf(rs.fields("Category") = "M", rs.fields("TRANSHIPMENT"), False)
        If Not toval(rs.fields("TRANSHIPMENT")) Then
            rs.fields("ATANDFROM") = ""
            rs.fields("TransTo") = ""
            rs.fields("CONVEYANCE") = ""
        End If
        rs.fields("LUserID") = db_user
        rs.fields("LDate") = Today.Date
        If Not rs.Update Then GoTo errmsg

        If rs.fields("Category") = "M" Then
            rs = db.OpenRemoteSet("Select * from RCoverDet Where 1<>1")
            For i = 0 To MaxRows - 1
                If Trim(bufferdata(i, 0)) <> "" And Trim(bufferdata(i, 1)) <> "" And Trim(bufferdata(i, 2)) <> "" Then
                    rs.AddNew()
                    rs.fields("ANO") = ANO
                    rs.fields("Code") = Code
                    rs.fields("SDate") = SDate
                    rs.fields("TransDate") = todate(bufferdata(i, 0))
                    rs.fields("Voyage") = tostr(bufferdata(i, 1))
                    rs.fields("Vessel") = tostr(bufferdata(i, 2))
                    rs.fields("Conveyance") = tostr(bufferdata(i, 3))
                    rs.fields("AtAndFrom") = tostr(bufferdata(i, 4))
                    rs.fields("TransTo") = tostr(bufferdata(i, 5))
                    If Not rs.Update Then GoTo errmsg
                End If
            Next i
            rs.CloseRemoteSet()
        End If

        If EditMode = AdEditAdd OrElse Code <> PCode Then
            ' Delete First
            If Not db.Execute("Delete A from RateTabCla R, AccCla A Where A.OrderNo=R.OrderNo and A.ANO=" & ANO & " and R.Code='" & PCode & "'") Then GoTo errmsg
            If Not db.Execute("Delete A from RateTabCon R, AccCon A Where A.OrderNo=R.OrderNo and A.ANO=" & ANO & " and R.Code='" & PCode & "'") Then GoTo errmsg
            If Not db.Execute("Delete A from RateTabEx R, AccEx A Where A.OrderNo=R.OrderNo and A.ANO=" & ANO & " and R.Code='" & PCode & "'") Then GoTo errmsg

            Dim rss As RemoteSet
            Dim rsd As RemoteSet
            ' Creating Default Clauses
            rss = db.OpenRemoteSet("Select * from RateTabCla Where Code='" & Code & "'")
            If Not rss.Eof Then
                Do While Not rss.Eof
                    rsd = db.OpenRemoteSet("Select * from AccCLA Where ANO=" & ANO & " and OrderNo='" & tostr(rss.fields("OrderNo")) & "'")
                    If rsd.Eof Then
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("Section") = tostr(rss.fields("Section"))
                        rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                    Else
                        rsd.Edit()
                    End If
                    rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                    rsd.fields("Description") = tostr(rss.fields("Description"))
                    rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                    rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                    If Not rsd.Update Then GoTo errmsg
                    rss.MoveNext()
                Loop

                ' Insert into Section Table
                Dim SQL As String
                SQL = "Insert into AccSection(ANO, Section, ShortDesc, Description)"
                SQL = SQL & " Select DISTINCT A2.ANO, A2.Section, S.ShortDesc, CAST(S.Description AS VARCHAR(MAX))"
                SQL = SQL & " from Acceptance A1 "
                SQL = SQL & " Inner Join AccCla A2 on (A2.ANO=A1.ANO)"
                SQL = SQL & " Inner join Section S on (S.TOC=A1.TOC and S.Section=A2.Section)"
                SQL = SQL & " Left join AccSection A3 on (A3.ANO=A1.ANO and A3.Section=S.section)"
                SQL = SQL & " Where A1.ANO=" & ANO & " and A3.Section Is null"
                If Not db.Execute(SQL) Then GoTo errmsg
            End If

            ' Creating Default Conditions
            rss = db.OpenRemoteSet("Select * from RateTabCon Where Code='" & Code & "'")
            Do While Not rss.Eof
                rsd = db.OpenRemoteSet("Select * from AccCON Where ANO=" & ANO & " and OrderNo='" & tostr(rss.fields("OrderNo")) & "'")
                If rsd.Eof Then
                    rsd.AddNew()
                    rsd.fields("ANO") = ANO
                    rsd.fields("Section") = tostr(rss.fields("Section"))
                    rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                Else
                    rsd.Edit()
                End If
                rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                rsd.fields("Description") = tostr(rss.fields("Description"))
                rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                If Not rsd.Update Then GoTo errmsg
                rss.MoveNext()
            Loop

            ' Creating Default Exclusions
            rss = db.OpenRemoteSet("Select * from RateTabEx Where Code='" & Code & "'")
            Do While Not rss.Eof
                rsd = db.OpenRemoteSet("Select * from AccEx Where ANO=" & ANO & " and OrderNo='" & tostr(rss.fields("OrderNo")) & "'")
                If rsd.Eof Then
                    rsd.AddNew()
                    rsd.fields("ANO") = ANO
                    rsd.fields("Section") = tostr(rss.fields("Section"))
                    rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                Else
                    rsd.Edit()
                End If
                rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                rsd.fields("Description") = tostr(rss.fields("Description"))
                rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                If Not rsd.Update Then GoTo errmsg
                rss.MoveNext()
            Loop
        End If


        'Set acceptance status to inconsistent
        If Not db.Execute("Update Acceptance set PStatus='I' Where AStatus='W' and ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then
            StrMsg = "Policy Already Processed !"
            GoTo errmsg
        End If
        Save_Coverage = True
        Exit Function

errmsg:
        StrMsg = StrError(StrMsg)
        Save_Coverage = False
    End Function
    Private Function Save_Multiple_Interest(ByVal Param As Object, ByVal DataSet As DataSet) As Boolean
        Try
            Dim rs As RemoteSet
            Dim rsI As RemoteSet
            Dim rsTOI As RemoteSet
            Dim rsInfo As RemoteSet

            Dim ANO As Long = getInParamValue(Param, 0)
            Dim Mode As Integer = toval(getInParamValue(Param, 1))   ' Mode : 0 (Reset All), 1 (Add), 2(Update)
            Dim INO As Long

            Dim TOI As String = ""

            If Mode = 0 Then
                If Not db.Execute("Delete from ICover Where ANO=" & ANO) Then Throw New Exception(db.ErrDesc)
            End If
            If Mode = 0 Or Mode = 1 Then
                rsI = db.OpenRemoteSet("Select * from ICover Where 1<>1")
                rsInfo = db.OpenRemoteSet("Select * from IInfo Where 1<>1")
            End If
            For RecNo = 0 To DataSet.Tables(0).Rows.Count - 1
                Dim DataRow As DataRow = DataSet.Tables(0).Rows(RecNo)

                Dim RefNo As String = tostr(GetItemValue(DataRow, "RefNo"))
                If tostr(GetItemValue(DataRow, "TOI")) <> "" And tostr(GetItemValue(DataRow, "Remark")) <> "" Then
                    If TOI <> tostr(GetItemValue(DataRow, "TOI")) Then
                        TOI = tostr(GetItemValue(DataRow, "TOI"))
                        rsTOI = db.OpenQueryDef("QTOI_GENHTAB", adOpenForwardonly, TOI)
                    End If

                    If Mode = 2 Then
                        rsI = db.OpenRemoteSet("Select * from ICover Where ANO=" & ANO & " and TOI='" & TOI & "' and RefNo='" & RefNo & "'")
                        If rsI.Eof Then
                            rsInfo = db.OpenRemoteSet("Select * from IInfo Where 1<>1")
                            rsI.AddNew()
                            rsInfo.AddNew()
                        Else
                            rsI.Edit()
                            rsInfo = db.OpenRemoteSet("Select * from IInfo Where INO=" & rsI.fields("INO"))
                            If rsInfo.Eof Then
                                rsInfo.AddNew()
                            Else
                                rsInfo.Edit()
                            End If
                        End If
                    Else
                        rsI.AddNew()
                        rsInfo.AddNew()
                    End If

                    If rsI.editmode = AdEditAdd Then
                        INO = db.GetIdentity("ICover") + 1
                    Else
                        INO = rsI.fields("INO")
                    End If

                    rsI.fields("ANO") = ANO
                    rsI.fields("INO") = INO
                    rsI.fields("RINO") = INO
                    rsI.fields("TOI") = TOI
                    rsI.fields("Remark") = tostr(GetItemValue(DataRow, "Remark"))
                    rsI.fields("Category") = tostr(GetItemValue(DataRow, "Category"))
                    rsI.fields("PCTADJ") = toval(GetItemValue(DataRow, "PCTADJ"))
                    If rsI.fields("PCTADJ") = 0 Or rsI.fields("PCTADJ") = 100 Then
                        rsI.fields("Adjustable") = False
                    Else
                        rsI.fields("Adjustable") = True
                    End If
                    rsI.fields("Currency") = tostr(GetItemValue(DataRow, "Currency"))
                    rsI.fields("AMOUNT") = toval(GetItemValue(DataRow, "Amount"))
                    rsI.fields("AMOUNT_AOE") = toval(GetItemValue(DataRow, "Amount_AOE"))
                    rsI.fields("SI") = toval(GetItemValue(DataRow, "SI"))

                    rsI.fields("Currency_OC") = rsI.fields("Currency")
                    rsI.fields("Rate_OC") = 1
                    rsI.fields("Amount_OC") = toval(rsI.fields("Amount")) / toval(rsI.fields("Rate_OC"))
                    rsI.fields("Amount_AOE_OC") = toval(rsI.fields("Amount_AOE")) / toval(rsI.fields("Rate_OC"))
                    rsI.fields("SI_OC") = toval(rsI.fields("SI")) / toval(rsI.fields("Rate_OC"))
                    rsI.fields("EML_OC") = toval(rsI.fields("EML")) / toval(rsI.fields("Rate_OC"))
                    rsI.fields("TOPROF") = toval(GetItemValue(DataRow, "TOPROF"))
                    rsI.fields("RefNo") = tostr(GetItemValue(DataRow, "RefNo"))
                    rsI.fields("RefDate") = todate(GetItemValue(DataRow, "RefDate"))
                    rsI.fields("DocNo") = tostr(GetItemValue(DataRow, "DocNo"))
                    rsI.fields("DocDate") = todate(GetItemValue(DataRow, "DocDate"))
                    rsI.fields("RefDueDate") = todate(GetItemValue(DataRow, "RefDueDate"))
                    rsI.fields("LUserID") = db_user
                    rsI.fields("LDate") = Today.Date
                    If Mode = 0 Or Mode = 1 Then
                        If Not rsI.UpdateRow Then Throw New Exception(rsI.ErrDesc)
                    Else
                        If Not rsI.Update Then Throw New Exception(rsI.ErrDesc)
                    End If

                    Dim FLDID As String
                    Dim ValueID As String
                    Dim ValueDesc As String
                    Dim pFLDID As String = ""
                    Dim pValueID As String = ""
                    Dim rsAinfo As RemoteSet = Nothing

                    rsInfo.fields("INO") = INO
                    For j = 1 To 15
                        FLDID = tostr(rsTOI.fields("FLDID" & j))
                        ValueID = tostr(GetItemValue(DataRow, "OBJ_INFO_" & Format(j, "00")))
                        ValueDesc = tostr(GetItemValue(DataRow, "DESCRIPTION" & j))

                        If ValueDesc = "" Then ValueDesc = ValueID

                        If FLDID <> "" Then
                            If toval(rsTOI.fields("FLDTAB" & j)) Then
                                If (ValueID <> "" Or ValueDesc <> "") Then
                                    If j > 1 AndAlso toval(rsTOI.fields("SUBLINKF" & j)) Then
                                        rs = db.OpenRemoteSet("select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and (fldid" & j - 1 & "<>'" & pFLDID & "' or valueid" & j - 1 & "='' or valueid" & j - 1 & "='" & pValueID & "') and fldid='" & FLDID & "' and (ValueID='" & ValueID & "' or Description like '" & ValueDesc & "%') Order By Case When GenDTab.ValueID='" & ValueID & "' Then 1 else 0 end desc, difference('" & ValueDesc & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                                    Else
                                        rs = db.OpenRemoteSet("Select Top 1 VALUEID, DESCRIPTION from GenDTab where AllowedF=1 and fldid='" & FLDID & "' and (ValueID='" & ValueID & "' or Description like '" & ValueDesc & "%') Order By Case When GenDTab.ValueID='" & ValueID & "' Then 1 else 0 end desc, difference('" & ValueDesc & "',GenDTab.Description) Desc, len(GenDTab.Description) asc")
                                    End If
                                    If Not rs.Eof Then
                                        If ValueID = ValueDesc Then ValueDesc = tostr(rs.fields("DESCRIPTION"))
                                        ValueID = tostr(rs.fields("ValueID"))
                                    Else
                                        ValueID = ""
                                        ValueDesc=""
                                    End If
                                End If
                            Else
                                If ValueID = "" And ValueDesc <> "" Then
                                    ValueID = Get_ValueID(FLDID, ValueDesc, Today.Date, "", "")
                                End If
                            End If

                            ' Get Default from Object Information
                            If ValueID = "" AndAlso ValueDesc = "" Then
                                If rsAinfo Is Nothing Then
                                    rsAinfo = db.OpenRemoteSet("Select * from AInfo Where ANO=" & ANO)
                                End If
                                If Not rsAinfo.Eof Then
                                    For i = 1 To 15
                                        If rsAinfo.fields("FLDID" & i) <> "" Then
                                            If UCase(FLDID) = UCase(rsAinfo.fields("FLDID" & i)) Then
                                                ValueID = rsAinfo.fields("VALUEID" & i)
                                                ValueDesc = rsAinfo.fields("VALUEDESC" & i)
                                                Exit For
                                            End If
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If

                            pFLDID = FLDID
                            pValueID = ValueID

                            rsInfo.fields("FLDID" & j) = FLDID
                            rsInfo.fields("VALUEID" & j) = ValueID
                            rsInfo.fields("VALUEDESC" & j) = ValueDesc
                        Else
                            rsInfo.fields("FLDID" & j) = ""
                            rsInfo.fields("VALUEID" & j) = ""
                            rsInfo.fields("VALUEDESC" & j) = ""
                        End If
                    Next

                    For j = 1 To 15
                        If rsTOI.fields("FLDID" & j) <> "" Then
                            ' Spread Info
                            If toval(rsTOI.fields("SpreadInfoF" & j)) AndAlso toval(rsTOI.fields("FLDTAB" & j)) AndAlso rsTOI.fields("FLDID" & j) <> "" AndAlso rsInfo.fields("VALUEID" & j) <> "" Then
                                rs = db.OpenQueryDef("QSpreadInfo", adOpenForwardonly, rsTOI.fields("FLDID" & j), rsInfo.fields("VALUEID" & j))
                                If Not rs.Eof Then
                                    For i = j + 1 To 15
                                        If rsTOI.fields("FLDID" & i) <> "" Then
                                            If rsInfo.fields("VALUEID" & i) = "" Then
                                                For k = 1 To 15
                                                    If rs.fields("FLDID" & k) <> "" Then
                                                        If rsTOI.fields("FLDID" & i) = rs.fields("FLDID" & k) Then
                                                            rsInfo.fields("VALUEID" & i) = rs.fields("VALUEID" & k)
                                                            If rsInfo.fields("VALUEDESC" & i) = "" Then
                                                                rsInfo.fields("VALUEDESC" & i) = rs.fields("VALUEDESC" & k)
                                                            End If
                                                            Exit For
                                                        End If
                                                    Else
                                                        Exit For
                                                    End If
                                                Next
                                            End If
                                        Else
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                        Else
                            Exit For
                        End If
                    Next
                    If Mode = 0 Or Mode = 1 Then
                        If Not rsInfo.UpdateRow Then Throw New Exception(rsInfo.ErrDesc)
                    Else
                        If Not rsInfo.Update Then Throw New Exception(rsInfo.ErrDesc)
                    End If
                End If
            Next

            If Mode = 0 Or Mode = 1 Then
                If Not rsI.Eof Then
                    If Not rsI.Update Then Throw New Exception(rsI.ErrDesc)
                End If

                If Not rsInfo.Eof Then
                    If Not rsInfo.Update Then Throw New Exception(rsI.ErrDesc)
                End If
            End If

            'Set acceptance status to inconsistent
            If Not db.Execute("Update Acceptance set PStatus='I' Where AStatus='W' and ANO=" & ANO) Then Throw New Exception(db.ErrDesc)
            If db.RecordsAffected = 0 Then
                StrMsg = "Policy Already Processed !"
                Throw New Exception(StrMsg)
            End If

            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return True
        End Try
    End Function
    Private Function Save_Multiple_Coverage(ByVal Param As Object, ByVal bufferdata As Object) As Boolean
        Dim i As Integer
        Dim rs As RemoteSet

        On Error GoTo errmsg

        Dim ANO As Long = toval(getInParamValue(Param, 0))
        Dim PSDate As Date = todate(getInParamValue(Param, 1))
        Dim PEDate As Date = todate(getInParamValue(Param, 2))
        Dim Voyage As Boolean = toval(getInParamValue(Param, 3))
        Dim pTerm As Integer = toval(getInParamValue(Param, 4))
        Dim TOC As String = tostr(getInParamValue(Param, 5))
        If pTerm = 0 Then pTerm = 12

        Dim MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1
        Dim MaxCols = CType(bufferdata, Object(,)).GetUpperBound(1) + 1

        ' Delete First
        If Not db.Execute("Delete A from RateTabCla R, AccCla A, RCover Where RCover.ANO=A.ANO and A.OrderNo=R.OrderNo and A.ANO=" & ANO & " and R.Code=RCover.Code") Then GoTo errmsg
        If Not db.Execute("Delete A from RateTabCon R, AccCon A, RCover Where RCover.ANO=A.ANO and A.OrderNo=R.OrderNo and A.ANO=" & ANO & " and R.Code=RCover.Code") Then GoTo errmsg
        If Not db.Execute("Delete A from RateTabEx R, AccEx A, RCover Where RCover.ANO=A.ANO and A.OrderNo=R.OrderNo and A.ANO=" & ANO & " and R.Code=RCover.Code") Then GoTo errmsg

        If Not db.Execute("Delete from RCover Where ANO=" & ANO) Then GoTo errmsg
        rs = db.OpenRemoteSet("Select * from RCover Where 1<>1", adOpenKeyset)
        For i = 0 To MaxRows - 1
            If Trim(bufferdata(i, 0)) <> "" And Trim(bufferdata(i, 1)) <> "" Then
                rs.AddNew()
                rs.fields("ANO") = ANO
                If toval(bufferdata(i, 0)) > 0 Then
                    rs.fields("SDate") = DateAdd(DateInterval.Year, toval(bufferdata(i, 0)) - 1, PSDate)
                    rs.fields("EDate") = DateAdd(DateInterval.Year, 1, rs.fields("SDate"))
                Else
                    rs.fields("SDate") = PSDate
                    rs.fields("EDate") = PEDate
                End If
                If tostr(bufferdata(i, 13)) = "" OrElse DateDiff(DateInterval.Day, todate(bufferdata(i, 13)), rs.fields("SDate")) > 0 Then
                    rs.fields("NCDate") = rs.fields("SDate")
                Else
                    rs.fields("NCDate") = todate(bufferdata(i, 13))
                End If
                If DateDiff(DateInterval.Day, PEDate, rs.fields("EDate")) > 0 Then
                    rs.fields("EDate") = PEDate
                End If
                rs.fields("Code") = tostr(bufferdata(i, 1))
                rs.fields("Remark") = tostr(bufferdata(i, 2))
                rs.fields("Rate") = toval(bufferdata(i, 3))
                rs.fields("Unit") = tostr(bufferdata(i, 4))
                rs.fields("Discount") = toval(bufferdata(i, 5))
                rs.fields("PCTLoss") = IIf(toval(bufferdata(i, 6)) = 0, 100, toval(bufferdata(i, 6)))
                rs.fields("Category") = tostr(bufferdata(i, 7))
                rs.fields("PML") = toval(bufferdata(i, 8))
                rs.fields("PAddition") = toval(bufferdata(i, 9))
                rs.fields("PCALC") = tostr(bufferdata(i, 10))
                rs.fields("Loading") = toval(bufferdata(i, 11))
                rs.fields("PPRORATA") = toval(bufferdata(i, 15))

                If Voyage Then ' Voyage
                    rs.fields("PCalc") = "F"
                    rs.fields("PProrata") = 0
                Else
                    If rs.fields("PCALC") = "" Or (rs.fields("PCALC") = "S" AndAlso toval(rs.fields("PPRORATA")) = 0) Then
                        Select Case DateDiff(DateInterval.Month, rs.fields("SDate"), rs.fields("EDate"))
                            Case Is < pTerm
                                Dim Scaling As Double
                                Scaling = Short_Period_Calc(TOC, rs.fields("SDate"), rs.fields("EDate"), rs.fields("EDate"))
                                If Scaling <> 0 And Scaling <> 100 Then
                                    rs.fields("PCalc") = "S"
                                    rs.fields("PProrata") = Scaling
                                Else
                                    rs.fields("PCalc") = "P"
                                    rs.fields("PProrata") = 0
                                End If
                            Case pTerm
                                If DateAdd(DateInterval.Month, pTerm, rs.fields("SDate")) <> rs.fields("EDate") Then
                                    rs.fields("PCalc") = "P"
                                    rs.fields("PProrata") = 0
                                Else
                                    rs.fields("PCalc") = "F"
                                    rs.fields("PProrata") = 0
                                End If
                            Case Is > pTerm
                                rs.fields("PCalc") = "P"
                                rs.fields("PProrata") = 0
                        End Select
                    ElseIf rs.fields("PCALC") = "F" Then
                        rs.fields("PProrata") = 0
                    End If
                End If
                rs.fields("Portion") = 100
                rs.fields("TOPROF") = toval(bufferdata(i, 12))
                rs.fields("PRATEPCT") = toval(bufferdata(i, 14))
                rs.fields("LUserID") = db_user
                rs.fields("LDate") = Today.Date
                If Not rs.Update Then GoTo ErrMsg


                Dim rss As RemoteSet
                Dim rsd As RemoteSet
                ' Creating Default Clauses
                rss = db.OpenRemoteSet("Select * from RateTabCla Where Code='" & tostr(bufferdata(i, 1)) & "' and Section=''")
                If Not rss.Eof Then
                    Do While Not rss.Eof
                        rsd = db.OpenRemoteSet("Select * from AccCLA Where ANO=" & ANO & " and OrderNo='" & tostr(rss.fields("OrderNo")) & "'")
                        If rsd.Eof Then
                            rsd.AddNew()
                            rsd.fields("ANO") = ANO
                            rsd.fields("Section") = tostr(rss.fields("Section"))
                            rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                        Else
                            rsd.Edit()
                        End If
                        rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                        rsd.fields("Description") = tostr(rss.fields("Description"))
                        rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                        rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                        If Not rsd.Update Then GoTo errmsg
                        rss.MoveNext()
                    Loop

                    ' Insert into Section Table
                    Dim SQL As String
                    SQL = "Insert into AccSection(ANO, Section, ShortDesc, Description)"
                    SQL = SQL & " Select DISTINCT A2.ANO, A2.Section, S.ShortDesc, CAST(S.Description AS VARCHAR(MAX))"
                    SQL = SQL & " from Acceptance A1 "
                    SQL = SQL & " Inner Join AccCla A2 on (A2.ANO=A1.ANO)"
                    SQL = SQL & " Inner join Section S on (S.TOC=A1.TOC and S.Section=A2.Section)"
                    SQL = SQL & " Left join AccSection A3 on (A3.ANO=A1.ANO and A3.Section=S.section)"
                    SQL = SQL & " Where A1.ANO=" & ANO & " and A3.Section Is null"
                    If Not db.Execute(SQL) Then GoTo errmsg
                End If

                ' Creating Default Conditions
                rss = db.OpenRemoteSet("Select * from RateTabCon Where Code='" & tostr(bufferdata(i, 1)) & "' and Section=''")
                Do While Not rss.Eof
                    rsd = db.OpenRemoteSet("Select * from AccCON Where ANO=" & ANO & " and OrderNo='" & tostr(rss.fields("OrderNo")) & "'")
                    If rsd.Eof Then
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("Section") = tostr(rss.fields("Section"))
                        rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                    Else
                        rsd.Edit()
                    End If
                    rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                    rsd.fields("Description") = tostr(rss.fields("Description"))
                    rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                    rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                    If Not rsd.Update Then GoTo errmsg
                    rss.MoveNext()
                Loop

                ' Creating Default Exclusions
                rss = db.OpenRemoteSet("Select * from RateTabEx Where Code='" & tostr(bufferdata(i, 1)) & "' and Section=''")
                Do While Not rss.Eof
                    rsd = db.OpenRemoteSet("Select * from AccEx Where ANO=" & ANO & " and OrderNo='" & tostr(rss.fields("OrderNo")) & "'")
                    If rsd.Eof Then
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("Section") = tostr(rss.fields("Section"))
                        rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                    Else
                        rsd.Edit()
                    End If
                    rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                    rsd.fields("Description") = tostr(rss.fields("Description"))
                    rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                    rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                    If Not rsd.Update Then GoTo errmsg
                    rss.MoveNext()
                Loop
            End If
        Next i
        rs.CloseRemoteSet()
        'Set acceptance status to inconsistent
        If Not db.Execute("Update Acceptance set PStatus='I' Where AStatus='W' and ANO=" & ANO) Then GoTo ErrMsg
        If db.RecordsAffected = 0 Then
            StrMsg = "Policy Already Processed !"
            GoTo errmsg
        End If

        Save_Multiple_Coverage = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Multiple_Coverage = False
    End Function
    Private Function Save_Multiple_Facultative(ByVal Param As Object, ByVal bufferdata As Object) As Boolean
        Dim i As Integer
        Dim rsF As RemoteSet
        Dim rsR As RemoteSet
        Dim FID As String
        Dim Share As Double
        Dim AType As String
        Dim Branch As String
        Dim CT As String
        Dim TAmount As Double
        Dim OANO As Long
        Dim TOC As String
        Dim PolicyType As String
        Dim ISType As String

        Dim LANO As Long = Param(0)
        Dim ANO As Long = Param(1)
        Dim SlipNo As String = Param(2)
        Dim ID As String = Param(3)
        Dim OneSlipF As Boolean = Param(4)

        Dim MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1

        Dim rs As RemoteSet


        On Error GoTo errmsg

        Dim Currency As String
        Dim Unit As String
        Dim RType As String
        Dim RShare As Double
        Dim DocNo As String
        Dim Limit As Double
        Dim Excess As Double
        Dim UserID As String
        Dim CurrencyL As String
        Dim RateL As Double
        Dim AcceptedBy As String
        Dim AcceptedDate As Date
        Dim SysUserID As String


        If LANO = ANO Then
            If SlipNo <> "<All>" Then
                If ID <> "<All>" Then
                    If Not db.Execute("Delete RArrDet from RArrDet, FPart, Acceptance Where Acceptance.AStatus='W' and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.ANO=Acceptance.ANO and Acceptance.LANO=" & LANO & " and RArrDet.AType='N' and RArrDet.Status='O' and FPart.SlipNo='" & SlipNo & "' and FPart.ID='" & ID & "'") Then GoTo errmsg
                Else
                    If Not db.Execute("Delete RArrDet from RArrDet, FPart, Acceptance Where Acceptance.AStatus='W' and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.ANO=Acceptance.ANO and Acceptance.LANO=" & LANO & " and RArrDet.AType='N' and RArrDet.Status='O' and FPart.SlipNo='" & SlipNo & "'") Then GoTo errmsg
                End If
            Else
                If ID <> "<All>" Then
                    If Not db.Execute("Delete RArrDet from RArrDet, FPart, Acceptance Where Acceptance.AStatus='W' and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.ANO=Acceptance.ANO and Acceptance.LANO=" & LANO & " and RArrDet.AType='N' and RArrDet.Status='O' and FPart.ID='" & ID & "'") Then GoTo errmsg
                Else
                    If Not db.Execute("Delete RArrDet from RArrDet, FPart, Acceptance Where Acceptance.AStatus='W' and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.ANO=Acceptance.ANO and Acceptance.LANO=" & LANO & " and RArrDet.AType='N' and RArrDet.Status='O'") Then GoTo errmsg
                End If
            End If
        Else
            If SlipNo <> "<All>" Then
                If ID <> "<All>" Then
                    If Not db.Execute("Delete RArrDet from RArrDet, FPart, Acceptance Where Acceptance.AStatus='W' and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.ANO=Acceptance.ANO and Acceptance.ANO=" & ANO & " and RArrDet.AType='N' and RArrDet.Status='O' and FPart.SlipNo='" & SlipNo & "' and FPart.ID='" & ID & "'") Then GoTo errmsg
                Else
                    If Not db.Execute("Delete RArrDet from RArrDet, FPart, Acceptance Where Acceptance.AStatus='W' and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.ANO=Acceptance.ANO and Acceptance.ANO=" & ANO & " and RArrDet.AType='N' and RArrDet.Status='O' and FPart.SlipNo='" & SlipNo & "'") Then GoTo errmsg
                End If
            Else
                If ID <> "<All>" Then
                    If Not db.Execute("Delete RArrDet from RArrDet, FPart, Acceptance Where Acceptance.AStatus='W' and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.ANO=Acceptance.ANO and Acceptance.ANO=" & ANO & " and RArrDet.AType='N' and RArrDet.Status='O' and FPart.ID='" & ID & "'") Then GoTo errmsg
                Else
                    If Not db.Execute("Delete RArrDet from RArrDet, FPart, Acceptance Where Acceptance.AStatus='W' and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.ANO=Acceptance.ANO and Acceptance.ANO=" & ANO & " and RArrDet.AType='N' and RArrDet.Status='O'") Then GoTo errmsg
                End If
            End If
        End If

        SlipNo = ""
        rs = db.OpenRemoteSet("Select Acceptance.OANO, Cover.PolicyType, Cover.ISType, Acceptance.CT, RArrHeader.TAmount from Cover, Acceptance, RArrHeader Where RArrHeader.ANO=Acceptance.ANO And Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        PolicyType = tostr(rs.fields("PolicyType"))
        ISType = tostr(rs.fields("ISType"))
        CT = tostr(rs.fields("CT"))
        TAmount = toval(rs.fields("TAmount"))
        OANO = toval(rs.fields("OANO"))
        For i = 0 To MaxRows - 1
            If Not OneSlipF Then
                SlipNo = tostr(bufferdata(i, 1))
            End If
            Share = toval(bufferdata(i, 6))
            ANO = toval(bufferdata(i, 11))
            FID = tostr(bufferdata(i, 12))
            AType = tostr(bufferdata(i, 13))
            Branch = tostr(bufferdata(i, 14))
            TOC = tostr(bufferdata(i, 15))
            Currency = tostr(bufferdata(i, 16))
            Unit = tostr(bufferdata(i, 17))
            RType = tostr(bufferdata(i, 18))
            RShare = toval(bufferdata(i, 19))
            DocNo = tostr(bufferdata(i, 20))
            Limit = toval(bufferdata(i, 21))
            Excess = toval(bufferdata(i, 22))
            UserID = tostr(bufferdata(i, 23))
            CurrencyL = tostr(bufferdata(i, 25))
            RateL = toval(bufferdata(i, 26))
            AcceptedBy = tostr(bufferdata(i, 27))
            AcceptedDate = todate(bufferdata(i, 28))
            SysUserID = tostr(bufferdata(i, 29))

            If (bufferdata(i, 10) = "O" Or bufferdata(i, 10) = "") Then
                If Trim(bufferdata(i, 0)) <> "" And Trim(bufferdata(i, 2)) <> "" And Trim(bufferdata(i, 3)) <> "" And Trim(bufferdata(i, 4)) <> "" Then

                    If FID = "" Then FID = GetDocumentNumbering("FS", PolicyType, ISType, Today.Date, Branch, TOC, CT)
                    If FID = "" Then
                        StrMsg = "Generate Facultative ID Failed !"
                        GoTo errmsg
                    End If

                    If SlipNo = "" Then
                        If DocNo <> "" Then
                            SlipNo = DocNo & "-" & Format(db.GetIdentity(Format(OANO, "0000000000") + "-" + DocNo) + 1, "000")
                        Else
                            SlipNo = FID
                        End If
                    End If

                    rsR = db.OpenRemoteSet("Select * from RArrDet Where ANO=" & ANO & " and FID='" & FID & "'")
                    If rsR.Eof Then
                        rsR.AddNew()
                        rsR.fields("FullCoverF") = 1
                        rsR.fields("OriginalF") = 1
                        rsR.fields("RType") = RType
                        rsR.fields("PCalc") = "F"
                        rsR.fields("Status") = "O"
                        rsR.fields("ANO") = ANO
                        rsR.fields("FID") = FID
                        If AType = "" Then AType = "N"
                        rsR.fields("AType") = AType
                        rsR.fields("UserID") = IIf(UserID = "", db_user, UserID)
                        rsR.fields("CDate") = todate(bufferdata(i, 24))
                    Else
                        rsR.Edit()
                    End If
                    If tostr(rsR.fields("Status")) = "O" Then
                        rsR.fields("SDate") = bufferdata(i, 2)
                        rsR.fields("EDate") = bufferdata(i, 3)
                        rsR.fields("Share") = Share

                        Dim rsCurrency As RemoteSet
                        rsCurrency = db.OpenRemoteSet("Select SysTab.Currency, PCalc.Rate from SysTab Left join PCalc on (PCalc.ANO=" & ANO & " and PCalc.Currency='" & CurrencyL & "')")
                        If CurrencyL = "" Then CurrencyL = rsCurrency.fields("Currency")
                        RateL = toval(rsCurrency.fields("RateL"))
                        If RateL = 0 Then RateL = 1

                        rsR.fields("CurrencyL") = CurrencyL
                        rsR.fields("RateL") = RateL
                        rsR.fields("Limit") = Limit
                        If Limit <> 0 Then
                            rsR.fields("Amount") = Limit * Share / 100
                        Else
                            rsR.fields("Amount") = (TAmount / RateL) * Share / 100
                        End If
                        rsR.fields("Excess") = Excess

                        rsR.fields("AcceptedBy") = AcceptedBy
                        rsR.fields("AcceptedDate") = AcceptedDate
                        rsR.fields("SysUserID") = SysUserID

                        rsR.fields("LUserID") = db_user
                        rsR.fields("LDate") = Today.Date
                        If Not rsR.Update Then GoTo errmsg

                        rsF = db.OpenRemoteSet("Select * from FPart Where ANO=" & ANO & " and FID='" & FID & "'")
                        If rsF.Eof Then
                            rsF.AddNew()
                            rsF.fields("ANO") = ANO
                            rsF.fields("FID") = FID
                        Else
                            rsF.Edit()
                        End If
                        rsF.fields("ID") = bufferdata(i, 4)
                        rsF.fields("Comm") = bufferdata(i, 7)
                        rsF.fields("SlipNo") = SlipNo
                        rsF.fields("DocNo") = DocNo
                        rsF.fields("Currency") = Currency
                        rsF.fields("Unit") = Unit
                        rsF.fields("NetRate") = bufferdata(i, 8)
                        rsF.fields("WPC") = bufferdata(i, 9)
                        rsF.fields("Share") = RShare
                        If toval(rsF.fields("Share")) = 0 Then rsF.fields("Share") = 100
                        If Not rsF.Update Then GoTo errmsg
                    End If
                End If
            End If
        Next i

        Save_Multiple_Facultative = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Multiple_Facultative = False
    End Function

    Private Function Save_Multiple_RArrangement(ByVal Param As Object, ByVal bufferdata As Object) As Boolean
        Dim i As Integer
        Dim rsR As RemoteSet
        Dim ANO As Long

        Dim TAmount As Double
        Dim MAmount As Double
        Dim Amount As Double
        Dim RAmount As Double
        Dim LANO As Long = Param(0)
        Dim LOLBased As Integer
        Dim ChangeF As Boolean
        Dim ManualF As Boolean
        Dim HoldF As Boolean

        Dim MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1

        On Error GoTo errmsg

        For i = 0 To MaxRows - 1
            ManualF = toval(bufferdata(i, 34))
            HoldF = toval(bufferdata(i, 35))
            ChangeF = toval(bufferdata(i, 36))
            ANO = toval(bufferdata(i, 37))

            If ANO <> 0 And ChangeF Then
                rsR = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
                If Not rsR.Eof And (ManualF Or ManualF <> rsR.fields("ManualF")) Then
                    If rsR.fields("Status") = "A" Then
                        If Not UnReleaseAccRegAmount(ANO, True) Then GoTo errmsg
                        're-open
                        rsR = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
                    End If

                    rsR.Edit()
                    LOLBased = toval(rsR.fields("LOLBased"))
                    TAmount = toval(rsR.fields("TAmount"))
                    MAmount = toval(rsR.fields("MAmount"))
                    RAmount = TAmount - MAmount

                    rsR.fields("LOLBased") = toval(Param(1))
                    Amount = toval(bufferdata(i, 6))
                    rsR.fields("CShare") = Amount / TAmount * 100
                    rsR.fields("CAmount") = Amount
                    RAmount = RAmount - Amount

                    Amount = toval(bufferdata(i, 9))
                    rsR.fields("DShare") = Amount / TAmount * 100
                    rsR.fields("DAmount") = Amount
                    RAmount = RAmount - Amount

                    Amount = toval(bufferdata(i, 12))
                    rsR.fields("XPShare") = Amount / TAmount * 100
                    rsR.fields("XPAmount") = Amount
                    RAmount = RAmount - Amount

                    Amount = toval(bufferdata(i, 15))
                    rsR.fields("QShare") = Amount * (100 - toval(rsR.fields("QSRet"))) / 100 / TAmount * 100
                    rsR.fields("QAmount") = Amount * (100 - toval(rsR.fields("QSRet"))) / 100
                    rsR.fields("QSRAmount") = Amount * toval(rsR.fields("QSRet")) / 100
                    RAmount = RAmount - Amount

                    Amount = toval(bufferdata(i, 18))
                    rsR.fields("SP1Share") = Amount / TAmount * 100
                    rsR.fields("SP1Amount") = Amount
                    RAmount = RAmount - Amount

                    Amount = toval(bufferdata(i, 21))
                    rsR.fields("SP2Share") = Amount / TAmount * 100
                    rsR.fields("SP2Amount") = Amount
                    RAmount = RAmount - Amount

                    Amount = toval(bufferdata(i, 24))
                    rsR.fields("SP3Share") = Amount / TAmount * 100
                    rsR.fields("SP3Amount") = Amount
                    RAmount = RAmount - Amount

                    Amount = toval(bufferdata(i, 27))
                    rsR.fields("AShare") = Amount * (100 - toval(rsR.fields("AFRet"))) / 100 / TAmount * 100
                    rsR.fields("AAmount") = Amount * (100 - toval(rsR.fields("AFRet"))) / 100
                    rsR.fields("AFRAmount") = Amount * toval(rsR.fields("AFRet")) / 100
                    RAmount = RAmount - Amount

                    Amount = toval(bufferdata(i, 29))
                    RAmount = RAmount - Amount

                    Amount = toval(bufferdata(i, 31))
                    rsR.fields("ShortFall") = Amount / TAmount * 100
                    rsR.fields("SAmount") = Amount
                    RAmount = RAmount - Amount

                    rsR.fields("Retention") = RAmount / TAmount * 100
                    rsR.fields("Ramount") = RAmount

                    rsR.fields("ManualF") = ManualF
                    rsR.fields("HoldF") = HoldF
                    If Not HoldF Then rsR.fields("Message") = ""

                    Amount = toval(bufferdata(i, 39))
                    rsR.fields("SPRShare") = Amount / TAmount * 100
                    rsR.fields("SPRAmount") = Amount

                    Amount = toval(bufferdata(i, 41))
                    rsR.fields("QSSFShare") = Amount / TAmount * 100
                    rsR.fields("QSSFAmount") = Amount

                    rsR.fields("LUserID") = db_user
                    rsR.fields("LDate") = Today.Date
                    If Not rsR.Update Then GoTo errmsg

                    'Book current Accumulation Register
                   If Not ManualF Or LOLBased <> toval(rsR.fields("LOLBased")) Then
                        If Not db.Execute("Update Acceptance Set PStatus='I' Where AStatus='W' and ANO=" & ANO) Then GoTo errmsg
                        If db.RecordsAffected = 0 Then
                            StrMsg = "Certificate Already Processed !"
                            GoTo errmsg
                        End If
                        If Not Me.Direct_Call_Process_Execute("Process.NetV3.Proclib", "Premium_Calc", ANO) Then GoTo ErrMsg
                    Else
                        If Not db.Execute("Update Acceptance Set AStatus='W', LDate='" & Format(Today.Date, "MM/DD/YYYY") & "', LTime='" & Time() & "' Where AStatus='W' and ANO=" & ANO) Then GoTo errmsg
                        If db.RecordsAffected = 0 Then
                            StrMsg = "Certificate Already Processed !"
                            GoTo errmsg
                        End If
                    End If
                End If
            End If
        Next i
        Save_Multiple_RArrangement = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Multiple_RArrangement = False
    End Function
    Private Function Search_FLDMAP_In_ObjInfo(ByVal ANO As Long, ByVal TOC As String, ByVal ParamArray FLDMAP() As String) As Object
        Dim i As Integer
        Dim j As Integer
        Dim rsTOC As RemoteSet
        Dim rsInfo As RemoteSet
        Dim FLDID As String

        Dim NItem As Integer = FLDMAP.GetUpperBound(0) + 1
        Dim NFound As Integer = 0
        Dim Value(NItem - 1) As Object

        rsTOC = db.OpenQueryDef("QTOC_GENHTAB", adOpenForwardonly, TOC)
        rsInfo = db.OpenRemoteSet("Select * from AInfo where ANO=" & ANO)
        For i = 1 To 15
            FLDID = rsTOC.fields("FLDID" & i)
            If FLDID <> "" Then
                For j = 0 To NItem - 1
                    If UCase(rsTOC.fields("FLDMAP" & i)) = UCase(FLDMAP(j)) AndAlso tostr(Value(j)) = "" Then
                        Value(j) = rsInfo.fields("VALUEID" & i)
                        If tostr(Value(j)) = "" Then
                            Value(j) = rsInfo.fields("VALUEDESC" & i)
                        End If
                        NFound = NFound + 1
                    End If
                Next
                If NFound = NItem Then Exit For
            Else
                Exit For
            End If
        Next



        Search_FLDMAP_In_ObjInfo = Value
    End Function
    Private Function Save_Interest(ByVal Param As Object, ByVal findex() As String, ByVal fbuffer() As String, ByVal bufferdata As Object, ByVal bufferdata_2 As Object) As String
        Try

            Dim i As Integer
            Dim rs As RemoteSet
            Dim TOI As String


            Dim INO As Long = Param(0)
            Dim ANO As Long = Param(1)
            Dim ICoverDetF As Boolean = Param(2)
            Dim ICoverExtF As Boolean = Param(3)

            Dim MaxRows As Integer
            Dim MaxCols As Integer

            TOI = GetFieldValue(fbuffer(GetFieldIndex("TOI", findex)))

            Dim SDate As Date
            Dim EDate As Date
            Dim TOC As String
            Dim DispModel As String
            rs = db.OpenRemoteSet("Select SDate, EDate, TOC from Acceptance Where ANO=" & ANO)
            SDate = rs.fields("SDate")
            EDate = rs.fields("EDate")
            TOC = rs.fields("TOC")

            rs = db.OpenRemoteSet("Select DispModel from TOI Where TOI='" & TOI & "'")
            DispModel = rs.fields("DispModel")

            Dim rsICover As RemoteSet
            rsICover = db.OpenQueryDef("QICover", adOpenKeyset, INO)
            If rsICover.Eof Then
                rsICover.AddNew()
                INO = db.GetIdentity("ICover") + 1
            Else
                rsICover.Edit()
            End If
            ' Save All Fields
            For i = 0 To UBound(findex) - 1
                rsICover.fields(findex(i)) = GetFieldValue(fbuffer(i))
            Next i
            If rsICover.editmode = AdEditAdd Then
                rsICover.fields("INO") = INO
                rsICover.fields("RINO") = INO
                rsICover.fields("ANO") = ANO
            End If
            rsICover.fields("LUserID") = db_user
            rsICover.fields("LDate") = Today.Date
            If Not rsICover.Update Then Throw New Exception(db.ErrDesc)


            If ICoverDetF Then
                MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1
                If Not db.Execute("Delete from ICoverDet Where INO=" & INO & " and DPeriod=0") Then Throw New Exception(db.ErrDesc)
                rs = db.OpenRemoteSet("Select * from ICoverDet Where 1<>1")
                For i = 0 To MaxRows - 1
                    If Trim(bufferdata(i, 0)) <> "" Then
                        rs.AddNew()
                        rs.fields("INO") = INO
                        rs.fields("ANO") = ANO
                        rs.fields("DPeriod") = 0
                        rs.fields("OrderNo") = i
                        rs.fields("Description") = bufferdata(i, 0)
                        rs.fields("Qty") = toval(bufferdata(i, 1))
                        rs.fields("Unit") = tostr(bufferdata(i, 2))
                        rs.fields("UValue") = toval(bufferdata(i, 3))
                        rs.fields("Amount") = toval(bufferdata(i, 4))
                        rs.fields("Memo") = tostr(bufferdata(i, 5))
                        If Not rs.Update Then Throw New Exception(db.ErrDesc)
                    End If
                Next i
                rs.CloseRemoteSet()
            End If

            If Not bufferdata_2 Is Nothing Then
                Dim PolicyYear As Integer
                MaxRows = CType(bufferdata_2, Object(,)).GetUpperBound(0) + 1
                MaxCols = CType(bufferdata_2, Object(,)).GetUpperBound(1) + 1
                If Not db.Execute("Delete from ICoverNOC Where INO=" & INO) Then Throw New Exception(db.ErrDesc)
                rs = db.OpenRemoteSet("Select * from ICoverNOC Where 1<>1")
                For i = 0 To MaxRows - 1
                    If tostr(bufferdata_2(i, 0)) <> "" Then
                        rs.AddNew()
                        rs.fields("INO") = INO
                        rs.fields("ANO") = ANO
                        rs.fields("NOC") = tostr(bufferdata_2(i, 0))
                        rs.fields("Description") = tostr(bufferdata_2(i, 1))
                        rs.fields("MaxFreq") = toval(bufferdata_2(i, 2))
                        rs.fields("MaxQty") = toval(bufferdata_2(i, 3))
                        rs.fields("Currency") = tostr(bufferdata_2(i, 4))
                        rs.fields("PCT") = toval(bufferdata_2(i, 5))
                        rs.fields("Amount") = toval(bufferdata_2(i, 6))
                        rs.fields("Limit") = toval(bufferdata_2(i, 7))
                        PolicyYear = toval(bufferdata_2(i, 8))
                        rs.fields("PolicyYear") = PolicyYear
                        If PolicyYear <= 0 Then
                            rs.fields("SDate") = SDate
                            rs.fields("EDate") = EDate
                        Else
                            rs.fields("SDate") = DateAdd(DateInterval.Month, 12 * (PolicyYear - 1), SDate)
                            rs.fields("EDate") = IIf(DateAdd(DateInterval.Month, 12 * PolicyYear, SDate) > EDate, EDate, DateAdd(DateInterval.Month, 12 * PolicyYear, SDate))
                        End If
                        rs.fields("OrderNo") = i
                        If Not rs.Update Then Throw New Exception(db.ErrDesc)
                    End If
                Next i
            End If

            If Not Save_Interest_Info(INO, findex, fbuffer) Then Throw New Exception(StrMsg)

            If ICoverExtF Then
                rs = db.OpenRemoteSet("Select * from ICoverExt Where INO=" & INO)
                If rs.Eof Then
                    rs.AddNew()
                    rs.fields("INO") = INO
                Else
                    rs.Edit()
                End If
                rs.fields("FLDVALUEF") = GetFieldValue(fbuffer(GetFieldIndex("FLDVALUEF", findex)))
                rs.fields("FLDVALUEL") = GetFieldValue(fbuffer(GetFieldIndex("FLDVALUEL", findex)))
                For i = 1 To 6
                    rs.fields("FLDTAG" & i) = GetFieldValue(fbuffer(GetFieldIndex("FLDTAG" & i, findex)))
                    rs.fields("FLDVALUE" & i) = GetFieldValue(fbuffer(GetFieldIndex("FLDVALUE" & i, findex)))
                    rs.fields("FLDOP" & i) = GetFieldValue(fbuffer(GetFieldIndex("FLDOP" & i, findex)))
                Next
                If Not rs.Update Then Throw New Exception(db.ErrDesc)
            ElseIf DispModel = "PD" Then
                Dim ValueParam As Object = Nothing

                ValueParam = Search_FLDMAP_In_ObjInfo(ANO, TOC, "NumberOfDriver", "NumberOfPassenger")
                Dim NumberOfDriver As Integer = toval(ValueParam(0))
                Dim NumberOfPassenger As Integer = toval(ValueParam(1))

                If NumberOfDriver <> 0 Or NumberOfPassenger <> 0 Then
                    rs = db.OpenRemoteSet("Select * from ICoverExt Where INO=" & INO)
                    If rs.Eof Then
                        rs.AddNew()
                        rs.fields("INO") = INO
                    Else
                        rs.Edit()
                    End If

                    rs.fields("FLDTAG1") = "NUMBER OF DRIVER"
                    rs.fields("FLDOP1") = "+"
                    rs.fields("FLDVALUE1") = NumberOfDriver
                    rs.fields("FLDTAG2") = "NUMBER OF PASSENGER"
                    rs.fields("FLDOP2") = "+"
                    rs.fields("FLDVALUE2") = NumberOfPassenger
                    rs.fields("FLDTAG3") = "LIMIT OF LIABILITY"
                    rs.fields("FLDOP3") = "x"
                    rs.fields("FLDVALUE3") = toval(rsICover.fields("Amount"))
                    rs.fields("FLDVALUEL") = (NumberOfDriver + NumberOfPassenger) * toval(rsICover.fields("Amount"))
                    If Not rs.Update Then Throw New Exception(db.ErrDesc)

                    rsICover.Edit()
                    rsICover.fields("SI") = toval(rs.fields("FLDVALUEL"))
                    rsICover.fields("Amount_AOE") = toval(rs.fields("FLDVALUEL"))
                    If Not rsICover.Update Then Throw New Exception(db.ErrDesc)
                End If

            End If

            'Set acceptance status to inconsistent
            If Not db.Execute("Update Acceptance set PStatus='I' Where AStatus='W' and ANO=" & ANO) Then Throw New Exception(db.ErrDesc)
            If db.RecordsAffected = 0 Then
                Throw New Exception("Policy Already Processed !")
            End If

            Save_Interest = INO
        Catch ex As Exception
            StrMsg = ex.Message
            Save_Interest = 0
        End Try
    End Function
