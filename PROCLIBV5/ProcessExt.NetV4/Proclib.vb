        Scheme_Undo_Verify = False
    End Function
    Private Function Save_Compliance_Sheet(ByVal Param As Object, ByVal bufferdata As Object) As Boolean
        Dim rsH As RemoteSet
        Dim rs As RemoteSet
        Dim ANO As Long = toval(getInParamValue(Param, 0))
        Dim CID As String = tostr(getInParamValue(Param, 1))
        Dim Comment As String = tostr(getInParamValue(Param, 2))

        Dim MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1

        On Error GoTo errmsg

        rsH = db.OpenRemoteSet("Select * from AccCompSheetH Where ANO=" & ANO & " and CID='" & CID & "'")
        If rsH.Eof Then
            StrMsg = "No Compliance Sheet Data !"
            GoTo errmsg
        ElseIf rsH.fields("Status") <> "R" Then
            StrMsg = "Compliance Sheet Already Processed !"
            GoTo errmsg
        End If

        Dim PassGrade As Integer
        Dim IPassGradeF As Boolean
        rs = db.OpenRemoteSet("Select IPassGradeF, PassGrade from Compliance C Where C.CID='" & CID & "'")
        IPassGradeF = toval(rs.fields("IPassGradeF"))
        If IPassGradeF Then
            PassGrade = toval(rs.fields("PassGrade"))
        Else
            PassGrade = toval(rs.fields("PassGrade"))
        End If

        If Not db.Execute("Delete from AccCompSheetD Where ANO=" & ANO & " and CID='" & CID & "'") Then GoTo errmsg

        Dim i As Integer
        Dim Score As Integer = 0
        rs = db.OpenRemoteSet("Select * from AccCompSheetD Where 1<>1")
        For i = 0 To MaxRows - 1
            If tostr(bufferdata(i, 0)) <> "" AndAlso tostr(bufferdata(i, 1)) <> "" AndAlso tostr(bufferdata(i, 3)) <> "" Then
                rs.AddNew()
                rs.fields("ANO") = ANO
                rs.fields("CID") = tostr(bufferdata(i, 0))
                rs.fields("RISKNO") = tostr(bufferdata(i, 1))
                rs.fields("RISKDESC") = tostr(bufferdata(i, 2))
                rs.fields("SID") = tostr(bufferdata(i, 3))
                rs.fields("SIDDesc") = tostr(bufferdata(i, 4))
                rs.fields("Remarks") = tostr(bufferdata(i, 5))
                rs.fields("Description") = tostr(bufferdata(i, 6))
                rs.fields("Value") = tostr(bufferdata(i, 7))
                If Not rs.UpdateRow Then GoTo errmsg
                Score = Score + toval(rs.fields("Value"))
                If toval(bufferdata(i, 9)) Then ' if Optional add passGrade
                    PassGrade = PassGrade + toval(bufferdata(i, 8))
                End If
            End If
        Next i
        If Not rs.Eof Then
            If Not rs.Update Then GoTo errmsg
        End If

        rs = db.OpenRemoteSet("Select Top 1 Indicator from ComplianceI C Where C.CID='" & CID & "' and " & tovalSF(Score) & " between C.SLower and C.SUpper Order by C.SLower")
        rsH.Edit()
        rsH.fields("Score") = Score
        rsH.fields("PassGrade") = PassGrade
        rsH.fields("Indicator") = IIf(tostr(rs.fields("Indicator")) <> "", tostr(rs.fields("Indicator")), "N/A")
        rsH.fields("Comment") = Comment
        rsH.fields("LDate") = Today.Date
        rsH.fields("LUserID") = db_user
        If Not rsH.Update Then GoTo errmsg
        Save_Compliance_Sheet = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Compliance_Sheet = False
    End Function
    Private Function Save_Employee_Contribution(ByVal Param As Object, ByVal bufferdata As Object) As Boolean
        Dim rsH As RemoteSet
        Dim rs As RemoteSet
        Dim ANO As Long = Param(0)
        Dim Remarks As String = Param(1)

        Dim MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1

        On Error GoTo errmsg

        rsH = db.OpenRemoteSet("Select * from ACCEMPCONTH Where ANO=" & ANO)
        If rsH.Eof Then
            StrMsg = "No Employee Contribution Data !"
            GoTo errmsg
        ElseIf rsH.fields("Status") <> "R" Then
            StrMsg = "Employee Contribution Already Processed !"
            GoTo errmsg
        End If

        If Not db.Execute("Delete from ACCEMPCONTD Where ANO=" & ANO) Then GoTo errmsg

        Dim i As Integer
        Dim TotalPCT As Integer = 0
        rs = db.OpenRemoteSet("Select * from ACCEMPCONTD Where 1<>1")
        For i = 0 To MaxRows - 1
            If tostr(bufferdata(i, 0)) <> "" Then
                rs.AddNew()
                rs.fields("ANO") = ANO
                rs.fields("ID") = tostr(bufferdata(i, 0))
                rs.fields("Remarks") = tostr(bufferdata(i, 1))
                rs.fields("PCT") = toval(bufferdata(i, 2))
                rs.fields("ECUTYPE") = tostr(bufferdata(i, 3))
                If Not rs.UpdateRow Then GoTo errmsg
                TotalPCT = TotalPCT + toval(rs.fields("PCT"))
            End If
        Next i
        If Not rs.Eof Then
            If Not rs.Update Then GoTo errmsg
        End If
        rsH.Edit()
        rsH.fields("Remarks") = Remarks
        rsH.fields("TotalPCT") = TotalPCT
        rsH.fields("LDate") = Today.Date
        rsH.fields("LUserID") = db_user
        If Not rsH.Update Then GoTo errmsg
        Save_Employee_Contribution = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Employee_Contribution = False
    End Function

    Private Function Save_Employee_Contribution_Quotation(ByVal Param As Object, ByVal bufferdata As Object) As Boolean
        Dim rsH As RemoteSet
        Dim rs As RemoteSet
        Dim CNO As Long = Param(0)
        Dim Remarks As String = Param(1)

        Dim MaxRows = CType(bufferdata, Object(,)).GetUpperBound(0) + 1

        On Error GoTo errmsg

        rsH = db.OpenRemoteSet("Select * from COVEMPCONTH Where CNO=" & CNO)
        If rsH.Eof Then
            StrMsg = "No Employee Contribution Data !"
            GoTo errmsg
        ElseIf rsH.fields("Status") <> "R" Then
            StrMsg = "Employee Contribution Already Processed !"
            GoTo errmsg
        End If

        If Not db.Execute("Delete from COVEMPCONTD Where CNO=" & CNO) Then GoTo errmsg

        Dim i As Integer
        Dim TotalPCT As Integer = 0
        rs = db.OpenRemoteSet("Select * from COVEMPCONTD Where 1<>1")
        For i = 0 To MaxRows - 1
            If tostr(bufferdata(i, 0)) <> "" Then
                rs.AddNew()
                rs.fields("CNO") = CNO
                rs.fields("ID") = tostr(bufferdata(i, 0))
                rs.fields("Remarks") = tostr(bufferdata(i, 1))
                rs.fields("PCT") = toval(bufferdata(i, 2))
                If Not rs.UpdateRow Then GoTo errmsg
                TotalPCT = TotalPCT + toval(rs.fields("PCT"))
            End If
        Next i
        If Not rs.Eof Then
            If Not rs.Update Then GoTo errmsg
        End If
        rsH.Edit()
        rsH.fields("Remarks") = Remarks
        rsH.fields("TotalPCT") = TotalPCT
        rsH.fields("LDate") = Today.Date
        rsH.fields("LUserID") = db_user
        If Not rsH.Update Then GoTo errmsg
        Save_Employee_Contribution_Quotation = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Save_Employee_Contribution_Quotation = False
    End Function

