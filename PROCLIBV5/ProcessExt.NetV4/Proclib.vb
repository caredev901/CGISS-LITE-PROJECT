    Private Function CopyQuotationAcceptance(ByVal ANO As Long, ByVal NewANO As Long, ByVal MasterF As Boolean) As Boolean
        Dim rs As RemoteSet

        If Not CopyInterest(ANO, NewANO, , True) Then GoTo errmsg

        If Not CopyAccDetail("RCover", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("RCoverDet", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccDed", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccDA", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccCA", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("RArrHeader", ANO, NewANO) Then GoTo errmsg

        If Not CopyAccDetail("PCalc", ANO, NewANO) Then GoTo errmsg

        If Not CopyAccDetail("RCalc", ANO, NewANO) Then GoTo errmsg
        If Not db.Execute("Update RCalc Set SANO=ANO Where ANO=" & NewANO) Then GoTo errmsg

        If Not CopyAccDetail("AccSection", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AInfo", ANO, NewANO) Then GoTo errmsg


        If Not CopyAccDetail("AccCla", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccCon", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("AccEx", ANO, NewANO) Then GoTo errmsg
        If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & NewANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

        If Not CopyAccDetail("AccBS", ANO, NewANO, "(Select ANO,ID,BSTYPE,Fee,FeeAmount,FeeRate,Discount,NetF,NetGroupF,MemberF,GrossF,MemberFeeF,PreferredF,NotMinimumPremiumF,GrossUpF,CommPoolF,UpFee,UpFeeAmount,UpFeeRate,LUserID,LDate,NetFee,NetUpF,TreatyOverridingF,CommAfterMinPremiumF,NoRefundF,BSID,GrossBLF,AgentType,NoProrataF,UseCurrTypeF, BSType as OBSType, Installment, PICName, PICPhone, PICMobile, PICEmail from ACCBS Where ANO=" & ANO & ")") Then GoTo errmsg

        If Not CopyAccDetail("AAccBS", ANO, NewANO, "(Select ANO,ID,BSTYPE,Fee,FeeAmount,FeeRate,Discount,NetF,NetGroupF,MemberF,GrossF,MemberFeeF,PreferredF,NotMinimumPremiumF,GrossUpF,CommPoolF,UpFee,UpFeeAmount,UpFeeRate,LUserID,LDate,NetFee,NetUpF,TreatyOverridingF,CommAfterMinPremiumF,NoRefundF,BSID,GrossBLF,AgentType,NoProrataF,UseCurrTypeF, BSType as OBSType, Installment, PICName, PICPhone, PICMobile, PICEmail from AAccBS Where ANO=" & ANO & ")") Then GoTo errmsg

        If Not CopyAccDetail("AccSearch", ANO, NewANO) Then GoTo errmsg
        If Not CopyAccDetail("Payor", ANO, NewANO) Then GoTo errmsg

        If Not CopyAccDetail("APayor", ANO, NewANO) Then GoTo errmsg

        If Not CopyAccDetail("AccFD", ANO, NewANO) Then GoTo errmsg


        ' Set Payor to Default only if SysTab.DefaultPayorF=1
        If Not db.Execute("Update Payor Set DefaultPayorF=1, Grace=0, WPC=0 from Payor Inner Join SysTab on (1=1) Where Systab.DefaultPayorF=1 and Payor.ANO=" & NewANO) Then GoTo errmsg
        If Not MasterF Then
            If Not db.Execute("Update APayor Set Grace=0, WPC=0 Where ANO=" & NewANO) Then GoTo errmsg
        End If
        If Not MasterF Then
            Dim AnnualTreatyF As Boolean

            Dim SDate As Date
            Dim EDate As Date

            Dim M_SDate As Date
            Dim M_EDate As Date
            Dim OpenFlag As Boolean

            rs = db.OpenRemoteSet("Select C.OpenFlag, A.SDate, A.EDate, coalesce(mA.SDate,A.SDate) as M_SDate, coalesce(mA.EDate,A.EDate) as M_EDate, A.AnnualTreatyF from Acceptance A Left Join Acceptance mA on (mA.ANO=A.LANO) inner Join Cover C on (C.CNO=A.CNO) Where A.ANO=" & NewANO)
            OpenFlag = toval(rs.fields("OpenFlag"))
            SDate = todate(rs.fields("SDate"))
            EDate = todate(rs.fields("EDate"))
            M_SDate = todate(rs.fields("M_SDate"))
            M_EDate = todate(rs.fields("M_EDate"))
            AnnualTreatyF = toval(rs.fields("AnnualTreatyF"))

            rs = db.OpenQueryDef("QRArrHeader", adOpenKeyset, NewANO)
            Dim PolicyTreatyF As Boolean = toval(rs.fields("PolicyTreatyF"))
            Dim RDate As Date
            Dim NRDate As Date

            If AnnualTreatyF Then
                If OpenFlag And Not PolicyTreatyF Then
                    RDate = SDate
                    NRDate = DateAdd(DateInterval.Month, 12, RDate)
                    If DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate
                Else
                    RDate = M_SDate
                    NRDate = DateAdd(DateInterval.Month, 12, RDate)
                    If DateDiff(DateInterval.Day, M_EDate, NRDate) > 0 Then NRDate = M_EDate
                End If
            Else
                If OpenFlag And Not PolicyTreatyF Then
                    RDate = SDate
                    NRDate = EDate
                Else
                    RDate = M_SDate
                    NRDate = IIf(M_EDate <= EDate, EDate, M_EDate)
                End If
            End If

            rs.Edit()
            rs.fields("ManualF") = False
            rs.fields("Status") = "R"
            rs.fields("PDate") = RDate
            rs.fields("PPDate") = NRDate
            rs.fields("LDate") = Today.Date
            rs.fields("LUserID") = db_user
            rs.fields("NCDate") = RDate
            rs.fields("RDate") = RDate
            rs.fields("NRDate") = NRDate
            rs.fields("RAmount") = rs.fields("RAmount") + rs.fields("FAmount")
            rs.fields("Retention") = rs.fields("Retention") + rs.fields("FShare")
            rs.fields("FAmount") = 0
            rs.fields("FShare") = 0
            If Not rs.Update Then GoTo errmsg
        End If

        rs = db.OpenRemoteSet("Select * from RArrDet Where ANO=" & ANO)
        Do While Not rs.Eof
            If Copy_Facultative(ANO, NewANO, rs.fields("FID")) = "" Then GoTo errmsg
            rs.MoveNext()
        Loop

        CopyQuotationAcceptance = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyQuotationAcceptance = False
    End Function
