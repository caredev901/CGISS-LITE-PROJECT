        PDCode = tostr(GetFieldValue(fbuffer(GetFieldIndex("DCode", findex))))
        PSection = tostr(GetFieldValue(fbuffer(GetFieldIndex("Section", findex))))
        PPolicyYear = toval(GetFieldValue(fbuffer(GetFieldIndex("PolicyYear", findex))))

        rs = db.OpenQueryDef("QAccDed", adOpenKeyset, ANO, PTOR, PDCode, PSection, PPolicyYear)
        If rs.Eof Then
            rs.AddNew()
        Else
            rs.Edit()
        End If

        ' Save All Fields
        For i = 0 To UBound(findex) - 1
            rs.fields(findex(i)) = GetFieldValue(fbuffer(i))
        Next i
        rs.fields("ANO") = ANO
        rs.fields("TOR") = TOR
        rs.fields("DCode") = DCode
        rs.fields("Section") = Section
        rs.fields("PolicyYear") = PolicyYear

        If PolicyYear <= 0 Then
            rs.fields("SDate") = SDate
            rs.fields("EDate") = EDate
        Else
            rs.fields("SDate") = DateAdd(DateInterval.Month, 12 * (PolicyYear - 1), SDate)
            rs.fields("EDate") = IIf(DateAdd(DateInterval.Month, 12 * PolicyYear, SDate) > EDate, EDate, DateAdd(DateInterval.Month, 12 * PolicyYear, SDate))
